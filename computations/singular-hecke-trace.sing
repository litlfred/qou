// Compute Gröbner-reduced Hecke element and Markov trace for N(p,n).
//
// Usage:
//   Singular -c "int PP=6; int NN=8;" computations/singular-hecke-trace.sing
//
// Or edit PP and NN below, then:
//   Singular computations/singular-hecke-trace.sing
//
// Input: PP = number of protons, NN = number of neutrons
// Output: Gröbner-reduced normal form, Markov trace, Q-value

LIB "freegb.lib";

// ── Input ───────────────────────────────────────────────────────
// Set these, or pass via -c flag
if (!defined(PP)) { int PP = 1; }
if (!defined(NN)) { int NN = 2; }

int AA = PP + NN;
int ngens = AA - 1;
int degbd = AA + 1;

"";
"========================================";
"N(" + string(PP) + "," + string(NN) + "), A=" + string(AA);
"ngens=" + string(ngens) + ", degbound=" + string(degbd);
"========================================";

// ── Ring ────────────────────────────────────────────────────────
ring r0 = (0,q), (x(1..ngens)), dp;
def R = makeLetterplaceRing(degbd);
setring R;

poly ha = q - 1/q;

// ── Gröbner basis ───────────────────────────────────────────────
ideal I;
int idx = 0;
int ii;
int jj;

// Hecke
for (ii = 1; ii <= ngens; ii++)
{
    idx++;
    I[idx] = var(ii) * var(ngens + ii) - ha * var(ii) - 1;
}
// Yang-Baxter
for (ii = 1; ii <= ngens - 1; ii++)
{
    idx++;
    I[idx] = var(ii) * var(ngens + ii + 1) * var(2*ngens + ii)
           - var(ii + 1) * var(ngens + ii) * var(2*ngens + ii + 1);
}
// Far commutativity
for (ii = 1; ii <= ngens; ii++)
{
    for (jj = ii + 2; jj <= ngens; jj++)
    {
        idx++;
        I[idx] = var(ii) * var(ngens + jj) - var(jj) * var(ngens + ii);
    }
}

"Relations: " + string(idx);
ideal G = twostd(I);
"Gröbner basis: " + string(size(G)) + " elements";

// ── Build braid word ────────────────────────────────────────────
// Strategy: maintain (a, b) where current element = a*sigma_i + b
// at each generator i. Process crossings one by one.
// After all crossings at generator i, the traced volume is z*a + b.
// The total Markov trace = product of (z*a_i + b_i).
//
// This is the FACTORED TRACE (proven exact).
// No lpMult needed — we work generator by generator.

// Nucleon types: 1..PP are protons, PP+1..AA are neutrons
// Generator sigma_i (i=1..ngens) handles crossings from nucleon i.
// Nucleon i crosses nucleons j = i+1, ..., AA.

"";
"Building factored trace...";

// We'll compute (a_i, b_i) for each generator and multiply the
// traced volumes V_i = z*a_i + b_i.

// z = 1/(q^{1/2} + q^{-1/2})
// We can't compute sqrt in Q(q), so we'll track symbolically
// and evaluate numerically at the end.

// For NUMERICAL evaluation: q = 1.110
number qnum = 1110/1000;
number qinv_n = 1000/1110;
number ha_n = qnum - qinv_n;
number skein_n = 0;  // can't do sqrt in Q, will handle separately

// For each generator, compute a_i and b_i numerically
ring Rnum = 0, (dummy), dp;

number qn = 1110/1000;
number qi = 1000/1110;
number han = qn - qi;
// For sqrt: use rational approximation
// q^{1/2} ≈ 1053/1000 (since 1.053^2 = 1.1088 ≈ 1.110)
number qhalf = 1053/1000;
number qhalfi = 1000/1053;
number zn = 1/(qhalf + qhalfi);
number skeinn = qhalf - qhalfi;

"q = " + string(qn);
"z = " + string(zn);
"ha = " + string(han);

int i;
int j;
number log_trace = 0;
number trace_product = 1;

"";
"Generator volumes:";

for (i = 1; i <= AA - 1; i++)
{
    number ai = 0;
    number bi = 1;

    for (j = i + 1; j <= AA; j++)
    {
        number cc;
        number dd;

        // Crossing type
        if (i <= PP && j <= PP)
        {
            // p-p: sigma_i → (1, 0)
            cc = 1;
            dd = 0;
        }
        else
        {
            if (i > PP && j > PP)
            {
                // n-n: sigma_i^{-1} = sigma_i - ha → (1, -ha)
                // Actually T^{-1} = T - ha, so crossing = (1, -han)
                cc = 1;
                dd = -han;
            }
            else
            {
                // mixed: (T + T^{-1})/2 = T - ha/2 → (1, -ha/2)
                cc = 1;
                dd = -han/2;
            }
        }

        // Multiply (ai*sigma + bi) * (cc*sigma + dd)
        // = ai*cc*sigma^2 + (ai*dd + bi*cc)*sigma + bi*dd
        // sigma^2 = ha*sigma + 1
        // = ai*cc*(ha*sigma + 1) + (ai*dd + bi*cc)*sigma + bi*dd
        // = (ai*cc*ha + ai*dd + bi*cc)*sigma + (ai*cc + bi*dd)
        number new_ai = ai*cc*han + ai*dd + bi*cc;
        number new_bi = ai*cc + bi*dd;
        ai = new_ai;
        bi = new_bi;

        kill cc; kill dd; kill new_ai; kill new_bi;
    }

    // Traced volume: V_i = z*a_i + b_i
    number vi = zn * ai + bi;
    trace_product = trace_product * vi;

    "  sigma_" + string(i) + ": a=" + string(ai) + ", b=" + string(bi) + ", V=" + string(vi);

    kill ai; kill bi; kill vi;
}

"";
"Markov trace (product of V_i): " + string(trace_product);

// ── Daughter trace ──────────────────────────────────────────────
"";
"Daughter N(" + string(PP+1) + "," + string(NN-1) + "):";

number trace_dau = 1;
for (i = 1; i <= AA - 1; i++)
{
    number ai = 0;
    number bi = 1;

    for (j = i + 1; j <= AA; j++)
    {
        number cc;
        number dd;

        // Daughter: nucleon PP+1 is now a proton
        int is_p_i = (i <= PP + 1);
        int is_p_j = (j <= PP + 1);

        if (is_p_i && is_p_j)
        {
            cc = 1; dd = 0;
        }
        else
        {
            if (!is_p_i && !is_p_j)
            {
                cc = 1; dd = -han;
            }
            else
            {
                cc = 1; dd = -han/2;
            }
        }

        number new_ai = ai*cc*han + ai*dd + bi*cc;
        number new_bi = ai*cc + bi*dd;
        ai = new_ai;
        bi = new_bi;

        kill cc; kill dd; kill new_ai; kill new_bi;
        kill is_p_i; kill is_p_j;
    }

    number vi = zn * ai + bi;
    trace_dau = trace_dau * vi;
    kill ai; kill bi; kill vi;
}

"Daughter trace: " + string(trace_dau);

// ── Q-value ─────────────────────────────────────────────────────
"";
"=== Q-VALUE ===";
"Parent trace:   " + string(trace_product);
"Daughter trace: " + string(trace_dau);

// Fractional ideal volume at converting generator (generator PP)
// Need to recompute V_PP for parent and daughter separately

number a_par = 0;
number b_par = 1;
for (j = PP + 1; j <= AA; j++)
{
    number cc; number dd;
    if (PP <= PP && j <= PP) { cc = 1; dd = 0; }
    else { if (PP > PP && j > PP) { cc = 1; dd = -han; } else { cc = 1; dd = -han/2; } }
    number na = a_par*cc*han + a_par*dd + b_par*cc;
    number nb = a_par*cc + b_par*dd;
    a_par = na; b_par = nb;
    kill cc; kill dd; kill na; kill nb;
}
number V_par = zn * a_par + b_par;

number a_dau = 0;
number b_dau = 1;
for (j = PP + 1; j <= AA; j++)
{
    number cc; number dd;
    int is_p_j = (j <= PP + 1);
    if (1 && is_p_j) { cc = 1; dd = 0; }
    else { if (0 && !is_p_j) { cc = 1; dd = -han; } else { cc = 1; dd = -han/2; } }
    // Converting generator PP: parent has nucleon PP as proton,
    // crossings with j > PP.
    // In parent: nucleon PP is proton (i=PP ≤ PP, so proton)
    //   j ≤ PP: p-p (but j > PP, so j > PP always)
    //   j > PP: p-n mixed (j = PP+1..AA, all neutrons in parent)
    // In daughter: nucleon PP is still proton, but nucleon PP+1 is now proton
    //   j = PP+1: p-p (was p-n in parent)
    //   j > PP+1: p-n mixed
    // REDO this properly:
    kill cc; kill dd; kill is_p_j;
}
kill a_dau; kill b_dau;

// Redo converting generator properly
number a_dau = 0;
number b_dau = 1;
for (j = PP + 1; j <= AA; j++)
{
    number cc; number dd;
    // Parent: nucleon PP is proton. Nucleon j (j>PP) is neutron.
    // → all crossings at gen PP in parent are p-n mixed.
    // Daughter: nucleon PP+1 becomes proton.
    //   j = PP+1: proton-proton → (1, 0)
    //   j > PP+1: proton-neutron → (1, -ha/2)
    if (j == PP + 1)
    {
        cc = 1; dd = 0;
    }
    else
    {
        cc = 1; dd = -han/2;
    }
    number na = a_dau*cc*han + a_dau*dd + b_dau*cc;
    number nb = a_dau*cc + b_dau*dd;
    a_dau = na; b_dau = nb;
    kill cc; kill dd; kill na; kill nb;
}
number V_dau = zn * a_dau + b_dau;

"";
"Converting generator sigma_" + string(PP) + ":";
"  V_par = " + string(V_par);
"  V_dau = " + string(V_dau);

number fiv = 0;
if (V_par != 0) { fiv = (V_par - V_dau) / V_par; }
if (fiv < 0) { fiv = -fiv; }

"  e(I)/e(R) = |V_par - V_dau| / |V_par| = " + string(fiv);
"";
"Q_exp should match e(I)/e(R) for 14C (0.156).";

kill a_par; kill b_par; kill a_dau; kill b_dau;
kill V_par; kill V_dau; kill fiv;

exit;
