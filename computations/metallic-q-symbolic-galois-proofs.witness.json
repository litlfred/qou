        "equation": "t_1(q) = t_2(q)",
        "all_solutions": [
          "1 + sqrt(2)"
        ],
        "expected": "δ_silver = 1 + √2",
        "expected_in_solutions": true,
        "proof_step_1": "t_1 = t_2  ⇔  2(q+q⁻¹) = (q+q⁻¹)(q−q⁻¹)",
