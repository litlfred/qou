{
  "computation": "brng-multiplicity-channel-bound",
  "description": "The multiplicity channel of a trace-sum binding law is sub-extensive. A signed sum over the partitions of 3A is bounded by p(3A) times its largest summand, so multiplicity contributes at most log p(3A) to the log-amplitude. Exact partition counts and AME2020 binding energies; the headline (R5) is scale-free and does not use E_0. Scope-(b) structural exclusion of the multiplicity channel ALONE -- the dominant summand's own log-weight is untouched and is the live remainder. Nothing wired, nothing fitted.",
  "assertions": [
    {
      "name": "hardy_ramanujan_bound_holds_A_2_to_400",
      "computed": true,
      "expected": true,
      "passed": true,
      "note": "log p(3A) <= pi sqrt(2) sqrt(A) verified with exact p(n) for every A in 2..400; this is the hypothesis carried by hardyRamanujan_gives_sqrt_law"
    },
    {
      "name": "exact_counts_below_asymptotic_bound_everywhere",
      "computed": true,
      "expected": true,
      "passed": true,
      "note": "using exact p(n) rather than the asymptotic form makes the exclusion stronger, not weaker"
    },
    {
      "name": "cap_below_binding_for_every_nuclide_A_at_least_12",
      "computed": true,
      "expected": true,
      "passed": true,
      "note": "the multiplicity channel cannot supply the measured binding at any A >= 12 even if it were the ONLY contribution"
    },
    {
      "name": "cap_share_decreasing_from_12C_to_238U",
      "computed": true,
      "expected": true,
      "passed": true,
      "note": "share falls with A -- the signature of a sub-extensive channel"
    },
    {
      "name": "deuteron_is_a_genuine_exception_cap_exceeds_its_binding",
      "computed": true,
      "expected": true,
      "passed": true,
      "note": "At A=2 the cap EXCEEDS the measured binding, so the multiplicity channel is NOT excluded there. This is not a defect in the argument: sub-extensive and extensive are indistinguishable at the smallest A, which is exactly what the Lean's explicit threshold A > (c/a)^2 says. With exact counts the crossing happens between A=2 and A=4, so the exclusion bites from 4He upward and strengthens monotonically."
    },
    {
      "name": "required_summand_count_exceeds_p_3A_for_every_nuclide_A_at_least_12",
      "computed": true,
      "expected": true,
      "passed": true,
      "note": "card_ge_exp_of_linear_le_log_card, evaluated"
    },
    {
      "name": "shape_mismatch_above_one_for_every_heavier_nuclide",
      "computed": true,
      "expected": true,
      "passed": true,
      "note": "E_0 cancels from both ratios; the multiplicity channel grows strictly slower than the measured binding, so no choice of scale can make it the extensive term"
    },
    {
      "name": "mismatch_grows_with_mass",
      "computed": true,
      "expected": true,
      "passed": true,
      "note": "a constant mismatch would be a scale error; a growing one is a shape error, and a shape error is not repairable by E_0"
    },
    {
      "name": "sqrt_law_shortfall_identity_holds_to_working_precision",
      "computed": true,
      "expected": true,
      "passed": true,
      "note": "QOU.Mass.MultiplicityNotExtensive.sqrt_law_shortfall"
    }
  ],
