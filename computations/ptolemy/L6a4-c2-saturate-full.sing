LIB "elim.lib";
ring r = 0, (c_0012_3,c_0012_6,c_0102_2,c_0102_3,c_0111_2,c_0111_4,c_0111_5,c_0201_1,c_1002_1,c_1002_3,c_1002_5,c_1011_0,c_1011_1,c_1011_3,c_1011_4,c_1011_6,c_1011_7,c_1101_0,c_1101_1,c_1101_2,c_1101_3,c_1101_4,c_1101_6,c_2001_1,c_2001_3,c_2001_5,u), dp;
ideal I = 1 - c_1011_0 + c_1101_0,
 - c_1002_1 + c_1011_0 + c_1101_4,
 c_0201_1 * c_1101_0 + c_1002_3 * u - c_1101_4,
 c_1011_0 * c_2001_3 * u^2 - c_1101_0 * c_2001_1 + c_1101_4,
 - c_1002_1 - c_1011_1 + c_1101_1,
 c_1002_5 + c_1011_1 + c_1101_6,
 - c_0201_1 * c_1101_6 - c_1002_3 + c_1101_1,
 c_1011_1 * c_2001_3 - c_1101_1 * c_2001_5 + c_1101_6 * c_2001_1,
 c_0102_2 * c_1011_0 + c_0111_2 * c_1002_1 + c_1101_2,
 - c_0012_6 * c_1011_0 - c_0111_2 - c_1011_4,
 c_0012_3 * c_1101_2 * u + c_0102_3 * c_1011_4 + c_0111_2 * c_1002_1,
 - c_1011_0 * c_2001_1 - c_1011_4 * c_2001_1 - c_1101_2,
 c_0012_3 * c_1101_3 - c_0102_3 * c_1011_3 - c_0111_2 * c_1002_3 * u^2,
 c_0012_6 * c_1101_0 * u^2 + c_0111_2 * u^2 + c_1011_3 * u,
 - c_0102_2 * c_1101_0 * u - c_0111_2 * c_1002_3 * u^2 + c_1101_3 * u^2,
 c_1011_3 * c_2001_3 + c_1101_0 * c_2001_3 * u - c_1101_3,
 c_0012_3 * c_1101_4 * u + c_0111_4 * c_1002_1 - c_1011_4,
 - c_0012_6 * c_1011_3 * u^2 + c_0012_6 * c_1011_4 - c_0111_4,
 c_0012_3 * c_1101_4 * u + c_0111_4 * c_1002_3 * u + c_0201_1 * c_1011_3 * u^2,
 - c_1011_3 * c_2001_1 * u^2 + c_1011_4 * c_2001_3 * u^2 - c_1101_4,
 c_0012_6 * c_1011_1 + c_0111_5 * c_1002_5 + c_1011_7,
 - c_0102_2 * c_1011_1 - c_0111_5 * c_1002_1 + c_1101_2,
 - c_0012_3 * c_1101_2 * u + c_0102_3 * c_1011_7 + c_0111_5 * c_1002_1,
 - c_1011_1 * c_2001_1 - c_1011_7 * c_2001_1 + c_1101_2 * c_2001_5,
 c_0012_6 * c_1101_6 - c_0111_5 * c_1002_5 - c_1011_6,
 c_0012_3 * c_1101_3 * u + c_0102_3 * c_1011_6 + c_0111_5 * c_1002_3,
 c_0102_2 * c_1101_6 - c_0111_5 * c_1002_3 - c_1101_3,
 c_1011_6 * c_2001_3 + c_1101_3 * c_2001_5 - c_1101_6 * c_2001_3,
 c_0012_6 * c_1011_6 - c_0012_6 * c_1011_7 - c_0111_4 * c_1002_5,
 c_0012_3 * c_1101_1 * u + c_0111_4 * c_1002_1 + c_1011_7,
 - c_0012_3 * c_1101_1 * u - c_0111_4 * c_1002_3 + c_0201_1 * c_1011_6,
 - c_1011_6 * c_2001_1 + c_1011_7 * c_2001_3 + c_1101_1 * c_2001_5,
 1 + u + u^2;
int t0 = timer;
I = sat(I, c_0012_3)[1];
I = sat(I, c_0012_6)[1];
I = sat(I, c_0102_2)[1];
I = sat(I, c_0102_3)[1];
I = sat(I, c_0111_2)[1];
I = sat(I, c_0111_4)[1];
I = sat(I, c_0111_5)[1];
I = sat(I, c_0201_1)[1];
I = sat(I, c_1002_1)[1];
I = sat(I, c_1002_3)[1];
I = sat(I, c_1002_5)[1];
I = sat(I, c_1011_0)[1];
I = sat(I, c_1011_1)[1];
I = sat(I, c_1011_3)[1];
I = sat(I, c_1011_4)[1];
I = sat(I, c_1011_6)[1];
I = sat(I, c_1011_7)[1];
I = sat(I, c_1101_0)[1];
I = sat(I, c_1101_1)[1];
I = sat(I, c_1101_2)[1];
I = sat(I, c_1101_3)[1];
I = sat(I, c_1101_4)[1];
I = sat(I, c_1101_6)[1];
I = sat(I, c_2001_1)[1];
I = sat(I, c_2001_3)[1];
I = sat(I, c_2001_5)[1];
I = sat(I, u)[1];
ideal G = std(I);
printf("saturated by all %s vars in %s sec | GB size %s | dim %s",
        27, timer-t0, size(G), dim(G));
if (size(G)==1 && G[1]==1) {
  printf("EMPTY after saturation -> class 2 has NO genuine points");
} else {
  printf("NON-EMPTY after saturation -> genuine points EXIST in class 2");
}
quit;
