// Full Markov trace for all 6 nuclei — parent AND daughter.
// Run: Singular folio-assistant/computations/singular-full-traces.sing
//
// The Markov trace is ORDERING-INDEPENDENT (link invariant).
// tr(N̄) = Π_i (z·a_i + b_i) — proven exact.
// Q should come from tr(parent) - tr(daughter), not from e(I)/e(R).
//
// Uses ground-state ordering (alternating + extra n at end).
// The trace value is the SAME regardless of ordering (theorem).

LIB "freegb.lib";

ring R = 0, (dummy), dp;

number qn = 111/100;
number qi = 100/111;
number han = qn - qi;
number zn = 4993/10000;

int i; int j;

// ── Macro: compute trace for a given ordering ───────────────────
// Inline — no procs to avoid ring scoping.
// Input: intvec ntype, int aa
// Output: number tr (product of traced volumes)

// ── 3H ──────────────────────────────────────────────────────────
"========== 3H: N(1,2) → N(2,1) ==========";
intvec ntype = 1,0,0;
int aa = 3;

number tr = 1;
for (i = 1; i <= aa-1; i++)
{
    number ai = 0; number bi = 1;
    for (j = i+1; j <= aa; j++)
    {
        number cc; number dd;
        if (ntype[i]==1 && ntype[j]==1) { cc=1; dd=0; }
        else { if (ntype[i]==0 && ntype[j]==0) { cc=1; dd=-han; }
               else { cc=1; dd=-han/2; } }
        number na = ai*cc*han + ai*dd + bi*cc;
        number nb = ai*cc + bi*dd;
        ai=na; bi=nb;
        kill cc; kill dd; kill na; kill nb;
    }
    number vi = zn*ai + bi;
    tr = tr * vi;
    kill ai; kill bi; kill vi;
}
"Parent trace: " + string(tr);
number tr_3h_par = tr;
kill tr; kill ntype;

intvec ntype = 1,1,0;
number tr = 1;
for (i = 1; i <= aa-1; i++)
{
    number ai = 0; number bi = 1;
    for (j = i+1; j <= aa; j++)
    {
        number cc; number dd;
        if (ntype[i]==1 && ntype[j]==1) { cc=1; dd=0; }
        else { if (ntype[i]==0 && ntype[j]==0) { cc=1; dd=-han; }
               else { cc=1; dd=-han/2; } }
        number na = ai*cc*han + ai*dd + bi*cc;
        number nb = ai*cc + bi*dd;
        ai=na; bi=nb;
        kill cc; kill dd; kill na; kill nb;
    }
    number vi = zn*ai + bi;
    tr = tr * vi;
    kill ai; kill bi; kill vi;
}
"Daughter trace: " + string(tr);
number tr_3h_dau = tr;
kill tr; kill ntype;

number delta_3h = tr_3h_par - tr_3h_dau;
"Delta: " + string(delta_3h);
"Q_exp = 0.01861";
"";
kill aa; kill tr_3h_par; kill tr_3h_dau; kill delta_3h;


