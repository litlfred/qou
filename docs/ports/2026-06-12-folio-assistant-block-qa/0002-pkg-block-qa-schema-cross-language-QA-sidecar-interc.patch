index 0000000..8cfad17
--- /dev/null
+++ b/tools/block-qa-schema/schema/block-qa.schema.json
@@ -0,0 +1,166 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://github.com/litlfred/qou/tools/block-qa-schema/schema/block-qa.schema.json",
+  "title": "BlockQaReport",
+  "description": "JSON shape of a per-content-block `<block>.qa.json` QA sidecar. Each content block (a .ts + .md + optional .lean triple) may carry one sidecar recording, per QA criterion, an append-only array of reviewer verdicts pinned to the content hashes they judged. Canonical interchange reference for the QOU block-QA format — readable from any language.",
+  "type": "object",
+  "required": ["$schema", "label", "kind", "paths", "source_hashes", "criteria", "updated_at"],
+  "additionalProperties": true,
+  "properties": {
+    "$schema": {
+      "const": "block-qa/v1",
+      "description": "Schema marker for this sidecar format."
+    },
+    "label": {
+      "type": "string",
+      "description": "Block label, kind-prefixed and stable (e.g. 'def:carbon-valence', 'prop:jet-tower-convergence')."
+    },
+    "kind": {
+      "type": "string",
+      "description": "Block kind — mirror of the .ts manifest's discriminator (definition / theorem / lemma / proposition / corollary / conjecture / example / remark / proof / simulator / prose / equation / diagram / table / algorithm)."
+    },
+    "paths": {
+      "type": "object",
+      "required": ["ts"],
+      "additionalProperties": true,
+      "properties": {
+        "ts": { "type": "string", "description": "Manifest path, relative to repo root." },
+        "md": { "type": "string", "description": "Narrative path, if present." },
+        "lean": { "type": "string", "description": "Formalization path, if present." }
+      },
+      "description": "Paths to the block's source files, relative to repo root."
+    },
+    "source_hashes": {
+      "$ref": "#/$defs/fieldHash",
+      "description": "Hashes of the present source files, refreshed on every write."
+    },
+    "criteria": {
+      "type": "object",
+      "additionalProperties": {
+        "type": "array",
+        "items": { "$ref": "#/$defs/criterionEntry" }
+      },
+      "description": "Per-criterion reviewer entries, keyed by criterion id (e.g. 'voice-status-leak', 'detangler-block-tanglement'). Multiple reviewers (script + agent + human) may co-exist; entries are NOT deduplicated. The criterion's current verdict is the most recent entry whose field_hash matches the present source files; if none matches, the criterion is stale and requires re-audit."
+    },
+    "updated_at": {
+      "type": "string",
+      "description": "Report creation / last-update timestamp (ISO-8601 UTC)."
+    }
+  },
+  "$defs": {
+    "fieldHash": {
+      "type": "object",
+      "additionalProperties": true,
+      "properties": {
+        "md": { "type": "string" },
+        "ts": { "type": "string" },
+        "lean": { "type": "string" }
+      },
+      "description": "12-char SHA-256 prefixes of each source file's UTF-8 bytes. Absent fields mean the audit did not depend on that file (or it did not exist at audit time)."
+    },
+    "reviewer": {
+      "type": "object",
+      "required": ["kind", "id"],
+      "additionalProperties": true,
+      "properties": {
+        "kind": {
+          "type": "string",
+          "enum": ["script", "agent", "human"],
+          "description": "script = deterministic CLI checker (reproducible); agent = LLM-driven reviewer (not deterministic); human = repo owner / collaborator adjudication (final authority)."
+        },
+        "id": {
+          "type": "string",
+          "description": "Stable identifier — script path, agent/skill name, or GitHub login."
+        },
+        "version": { "type": "string", "description": "Optional version pin (script revision, model id)." },
+        "script_hash": {
+          "type": "string",
+          "description": "12-char SHA-256 prefix of the checker's own source file at audit time (kind: script). Mismatch with the current file means the checker logic changed and the entry is stale."
+        },
+        "script_commit_sha": {
+          "type": "string",
+          "description": "Full git SHA of the most recent commit touching the checker's source file at audit time. Audit trail only — staleness is driven by script_hash."
+        },
+        "deps_hash": {
+          "type": "string",
+          "description": "12-char SHA-256 prefix of the concatenated extra inputs the checker consulted beyond the block under audit (e.g. the bibliography database). Mismatch means an input changed and the entry is stale."
+        },
+        "agent_model": { "type": "string", "description": "LLM model identifier (kind: agent), e.g. 'claude-opus-4-7'." },
+        "agent_session": { "type": "string", "description": "Reviewing agent's session id, if available." },
+        "agent_date": { "type": "string", "description": "ISO date of the agent review." },
+        "agent_skill": { "type": "string", "description": "Skill that dispatched the review, e.g. 'local/one-voice-audit'." }
+      },
+      "description": "Identity + provenance of the reviewer that produced an entry."
+    },
+    "score": {
+      "type": "object",
+      "required": ["value", "max"],
+      "additionalProperties": true,
+      "properties": {
+        "value": { "type": "number" },
+        "max": { "type": "number" },
+        "rubric": {
+          "type": "object",
+          "additionalProperties": { "type": "number" },
+          "description": "Optional per-dimension sub-scores."
+        }
+      },
+      "description": "Rubric score for rater-style quality criteria (e.g. proof-rater-*). A quality measure to improve over time, not a pass/fail gate. Convention: value/max >= 0.66 maps to result 'pass', 0.33-0.66 to 'warn', < 0.33 to 'fail'."
+    },
+    "criterionEntry": {
+      "type": "object",
+      "required": ["field_hash", "result", "reviewer", "reviewed_at"],
+      "additionalProperties": true,
+      "properties": {
+        "field_hash": {
+          "$ref": "#/$defs/fieldHash",
+          "description": "Source-file hashes captured at audit time. A verdict whose field_hash no longer matches the present sources is stale and must be re-run."
+        },
+        "result": {
+          "type": "string",
+          "enum": ["pass", "fail", "warn", "n/a"],
+          "description": "pass = satisfied; fail = violated (evidence must cite file:line + verbatim quote); warn = borderline, flagged but not blocking; n/a = criterion does not apply to this block kind."
+        },
+        "severity": {
+          "type": "string",
+          "enum": ["critical", "major", "minor"],
+          "description": "Severity when result is 'fail' or 'warn'."
+        },
+        "score": { "$ref": "#/$defs/score" },
+        "evidence": {
+          "oneOf": [
+            { "type": "string" },
+            {
+              "type": "array",
+              "items": {
+                "type": "object",
+                "additionalProperties": true,
+                "properties": {
+                  "line": { "type": "integer" },
+                  "text": { "type": "string" }
+                }
+              }
+            }
+          ],
+          "description": "Evidence for fail/warn verdicts: either a free-form 'file:line + verbatim quote' string, or a structured list of {line, text} locations (the shape some agent reviewers emit, e.g. on the voice axis)."
+        },
+        "metrics": {
+          "type": "object",
+          "additionalProperties": { "type": ["number", "string"] },
+          "description": "Optional structured numeric/heuristic measures the checker emits alongside its verdict — e.g. the detangler axis records per-block dependency-graph measures (fwd_emitted, tanglement_score, out_degree, in_degree, cone_size, depth, pagerank, edge_span_max, edge_span_mean, graph_energy, worst_target). Descriptive snapshots, not quality scores."
+        },
+        "reviewer": { "$ref": "#/$defs/reviewer" },
+        "reviewed_at": {
+          "type": "string",
+          "description": "When the audit ran. ISO-8601 UTC datetime; legacy agent entries may carry a bare ISO date."
+        },
+        "reviewed_sha": {
+          "type": "string",
+          "description": "Repo HEAD at audit time (full git SHA). Recommended; legacy agent entries (pre-2026-06) may omit it."
+        },
+        "notes": { "type": "string", "description": "Free-form notes." }
+      },
+      "description": "The outcome of one reviewer evaluating one criterion on one block."
+    }
+  }
+}
diff --git a/tools/block-qa-schema/schema/qa-script.schema.json b/tools/block-qa-schema/schema/qa-script.schema.json
new file mode 100644
index 0000000..4e847bd
--- /dev/null
+++ b/tools/block-qa-schema/schema/qa-script.schema.json
@@ -0,0 +1,52 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://github.com/litlfred/qou/tools/block-qa-schema/schema/qa-script.schema.json",
+  "title": "QaScriptSidecar",
+  "description": "JSON shape of a per-criterion `<criterion-id>.script.json` sidecar recording the canonical (script_hash, script_commit_sha, deps_hash) triple captured at the most recent qa-sweep run. Block-level criterion entries snapshot the same triple inline; this sidecar is the single-source-of-truth view of 'is checker X currently stale globally?'. A checker bug fix changes script_hash, which invalidates every verdict that checker ever wrote, corpus-wide.",
+  "type": "object",
+  "required": ["$schema", "criterion_id", "source_file", "script_hash", "script_commit_sha", "last_run_at", "last_run_sha"],
+  "additionalProperties": true,
+  "properties": {
+    "$schema": {
+      "const": "qa-script/v1",
+      "description": "Schema marker for this sidecar format."
+    },
+    "criterion_id": {
+      "type": "string",
+      "description": "Criterion id this sidecar tracks (e.g. 'proof-no-bare-sorries')."
+    },
+    "source_file": {
+      "type": "string",
+      "description": "Path (repo-relative) to the checker's source file."
+    },
+    "script_hash": {
+      "type": "string",
+      "description": "12-char SHA-256 prefix of the checker source file's content."
+    },
+    "script_commit_sha": {
+      "type": "string",
+      "description": "Full git SHA of the most recent commit touching source_file."
+    },
+    "extra_inputs": {
+      "type": "array",
+      "items": { "type": "string" },
+      "description": "Optional repo-relative paths to extra-input files the checker consults (e.g. cached audit witnesses, the bibliography database)."
+    },
+    "deps_hash": {
+      "type": "string",
+      "description": "12-char SHA-256 prefix of the concatenated extra_inputs content (omitted if none)."
+    },
+    "last_run_at": {
+      "type": "string",
+      "description": "ISO-8601 UTC timestamp of the most recent qa-sweep run."
+    },
+    "last_run_sha": {
+      "type": "string",
+      "description": "Repo HEAD at the most recent sweep (full git SHA)."
+    },
+    "engine_version": {
+      "type": "string",
+      "description": "Engine fingerprint, e.g. 'bun-1.3.11+node-22'."
+    }
+  }
+}
