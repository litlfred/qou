 import { defineConfig, devices } from '@playwright/test';
 
+/**
+ * Playwright config for the simulator E2E suite.
+ *
+ * Tuned for headless Chromium inside CI containers, where the simulators'
+ * WebGL/Three.js render loops previously caused OOM / SIGTERM / timeouts.
+ * See docs/audits/2026-06-16-playwright-simulators-flakiness-diagnosis.md
+ * (in the qou repo) for the root-cause analysis behind each setting.
+ */
 export default defineConfig({
   testDir: './tests',
-  timeout: 120000,
-  fullyParallel: true,
-  forbidOnly: !!process.env.CI,
-  retries: 0,
+
+  // One test timeout. The old config set `timeout` twice (120s then 180s); the
+  // second silently won. 120s is ample for a static page + a software-WebGL
+  // warm-up and keeps a hung render loop from stalling the whole run.
+  timeout: 120_000,
+
+  // Serialize. The heavy Three.js pages (quantum_brings_surface ~104 THREE
+  // refs) must not be resident concurrently or peak memory blows the
+  // container. `fullyParallel:true` with `workers:1` (the old setting) was
+  // self-contradictory; make the single-stream intent explicit.
+  fullyParallel: false,
   workers: 1,
-  reporter: 'list',
+
+  forbidOnly: !!process.env.CI,
+  // 0 retries surfaced flakiness as hard failures. Allow a couple of retries
+  // in CI for genuinely transient WebGL warm-up hiccups; none locally so
+  // flakes stay visible during development.
+  retries: process.env.CI ? 2 : 0,
+
+  reporter: process.env.CI
+    ? [['list'], ['junit', { outputFile: 'test-results/junit.xml' }]]
+    : 'list',
+
   use: {
     baseURL: 'http://127.0.0.1:8080',
     headless: true,
     trace: 'on-first-retry',
+    // Bound per-action / per-navigation waits so a stuck page fails fast
+    // (and retries) instead of running out the whole test timeout.
+    actionTimeout: 15_000,
+    navigationTimeout: 30_000,
     launchOptions: {
-      args: ['--no-sandbox', '--disable-setuid-sandbox']
-    }
+      args: [
+        '--no-sandbox',
+        '--disable-setuid-sandbox',
+        // THE container SIGTERM/SIGBUS fix: Chromium puts shared memory in
+        // /dev/shm, which defaults to 64 MB in Docker. Heavy WebGL overflows
+        // it and the renderer/GPU process is killed. Spill to /tmp instead.
+        '--disable-dev-shm-usage',
+        // No hardware GPU in CI: force software WebGL via SwiftShader so
+        // Three.js initializes a real context instead of throwing.
+        '--disable-gpu',
+        '--use-gl=angle',
+        '--use-angle=swiftshader',
+        '--enable-unsafe-swiftshader', // Chrome >=119 gates SwiftShader behind this
+        '--disable-features=Vulkan',
+      ],
+    },
   },
+
   projects: [
     {
       name: 'chromium',
       use: { ...devices['Desktop Chrome'] },
     },
   ],
+
   webServer: {
     command: 'node test-server.cjs',
-    port: 8080,
+    url: 'http://127.0.0.1:8080/simulators/empty.html',
+    timeout: 30_000,
     reuseExistingServer: !process.env.CI,
+    stdout: 'pipe',
+    stderr: 'pipe',
   },
-  timeout: 180000,
+
   expect: {
-    timeout: 10000,
+    timeout: 10_000,
   },
 });
