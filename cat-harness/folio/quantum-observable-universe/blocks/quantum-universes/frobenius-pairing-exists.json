the next section.</p>\n","source":"folio/quantum-observable-universe/quantum-universes/frobenius-pairing-exists.md","heading":"Proposition","number":"3.3.5","page":"b/prop-frobenius-pairing-exists","qa":{"counts":{"pass":90,"fail":0,"warn":3,"na":11,"unknown":0,"stale":80},"milnor":{"total":3,"notPassing":1}},"lean":{"expected":true,"ref":"qou:QOU.FrobeniusHopfData.frobeniusForm_exists","via":"sibling","path":"folio/quantum-observable-universe/quantum-universes/frobenius-pairing-exists.lean","compiles":"unchecked","sorry":false,"sorryBasis":"text"}}
