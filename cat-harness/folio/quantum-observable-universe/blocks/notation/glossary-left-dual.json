{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","folio-assistant-core":"https://litlfred.github.io/folio-assistant-core/v0/ns/"}],"@id":"papers/quantum-observable-universe/blocks/rem-glossary-left-dual","@type":["folio-assistant-core:Remark","doco:Section"],"label":"rem:glossary-left-dual","kind":"remark","title":"Left dual","uses":["papers/quantum-observable-universe/blocks/rem-glossary-exact-pairing"],"tags":["glossary","category-theory","monoidal","duality"],"defines":["left-dual"],"text":"glossary-left-dual.md","provenance":"authored","html":"<a id=\"rem:glossary-left-dual\"></a><p><strong><dfn class=\"defterm\" id=\"term-left-dual\">Left dual</dfn>.</strong> An object <code class=\"language-math math-inline\">Y</code> in a monoidal category has a left dual if there exists an object <code class=\"language-math math-inline\">X</code> and an exact pairing <code class=\"language-math math-inline\">(X, Y)</code>.</p>\n","source":"folio/quantum-observable-universe/notation/glossary-left-dual.md","heading":"Remark","number":"30.2.7","page":"b/rem-glossary-left-dual","qa":{"counts":{"pass":60,"fail":0,"warn":0,"na":17,"unknown":0,"stale":60},"milnor":{"total":2,"notPassing":0}}}
