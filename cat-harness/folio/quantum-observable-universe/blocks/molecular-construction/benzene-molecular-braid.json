{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","folio-assistant-sci":"https://litlfred.github.io/folio-assistant-sci/v0/ns/"}],"@id":"papers/quantum-observable-universe/blocks/def-benzene-molecular-braid","@type":["folio-assistant-sci:Definition","doco:Section"],"label":"def:benzene-molecular-braid","kind":"definition","title":"Benzene $C_6H_6$ as a molecular braid","uses":["papers/quantum-observable-universe/blocks/def-ch4-molecular-braid"],"tags":["benzene","C6H6","aromatic","delocalization","threading-link","molecular-braid"],"leanRef":"qou:QOU.Molecular.BenzeneBraid","text":"benzene-molecular-braid.md","leanSource":"benzene-molecular-braid.lean","provenance":"authored","html":"<a id=\"def:benzene-molecular-braid\"></a><p><strong>Benzene</strong> <code class=\"language-math math-inline\">C_6H_6</code> is the <strong>molecular braid</strong> of six carbon atoms and six hydrogen atoms, assembled iteratively from pre-computed atomic braids, with six C--C <code class=\"language-math math-inline\">\\sigma</code> bonds and six C--H <code class=\"language-math math-inline\">\\sigma</code> bonds (single, one shared pair each) and six <code class=\"language-math math-inline\">\\pi</code> electrons delocalized around the ring.</p>\n","source":"folio/quantum-observable-universe/molecular-construction/benzene-molecular-braid.md","heading":"Definition","number":"18.9.1","page":"b/def-benzene-molecular-braid","qa":{"counts":{"pass":81,"fail":1,"warn":0,"na":10,"unknown":0,"stale":66},"milnor":{"total":3,"notPassing":0}},"lean":{"expected":true,"ref":"qou:QOU.Molecular.BenzeneBraid","via":"sibling","path":"folio/quantum-observable-universe/molecular-construction/benzene-molecular-braid.lean","compiles":"unchecked","sorry":false,"sorryBasis":"text"}}
