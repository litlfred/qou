{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","folio-assistant-sci":"https://litlfred.github.io/folio-assistant-sci/v0/ns/"}],"@id":"papers/quantum-observable-universe/blocks/def-co2-molecular-braid","@type":["folio-assistant-sci:Definition","doco:Section"],"label":"def:co2-molecular-braid","kind":"definition","title":"Carbon dioxide $CO_2$ as a molecular braid","uses":["papers/quantum-observable-universe/blocks/def-co-molecular-braid"],"tags":["carbon-dioxide","CO2","double-bond","linear","triatomic","molecular-braid"],"leanRef":"qou:QOU.Molecular.CO2Braid","text":"co2-molecular-braid.md","leanSource":"co2-molecular-braid.lean","provenance":"authored","html":"<a id=\"def:co2-molecular-braid\"></a><p><strong>Carbon dioxide</strong> <code class=\"language-math math-inline\">CO_2</code> is the molecular braid of one carbon atom <code class=\"language-math math-inline\">C(6, 6)</code> and two oxygen atoms <code class=\"language-math math-inline\">O_1(8, 8)</code>, <code class=\"language-math math-inline\">O_2(8, 8)</code>, with two double bonds (O=C=O), each consisting of one <code class=\"language-math math-inline\">\\sigma</code> pair and one <code class=\"language-math math-inline\">\\pi</code> pair.</p>\n","source":"folio/quantum-observable-universe/molecular-construction/co2-molecular-braid.md","heading":"Definition","number":"18.6.1","page":"b/def-co2-molecular-braid","qa":{"counts":{"pass":82,"fail":0,"warn":0,"na":10,"unknown":0,"stale":66},"milnor":{"total":3,"notPassing":0}},"lean":{"expected":true,"ref":"qou:QOU.Molecular.CO2Braid","via":"sibling","path":"folio/quantum-observable-universe/molecular-construction/co2-molecular-braid.lean","compiles":"unchecked","sorry":false,"sorryBasis":"text"}}
