{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","folio-assistant-core":"https://litlfred.github.io/folio-assistant-core/v0/ns/"}],"@id":"papers/quantum-observable-universe/blocks/tbl-y-lambda-closed-form-wenzl-bridge-table1-data","@type":["folio-assistant-core:Table","doco:Table"],"label":"tbl:y-lambda-closed-form-wenzl-bridge-table1-data","kind":"table","title":"Data table 1 from prop:y-lambda-closed-form-wenzl-bridge","uses":["papers/quantum-observable-universe/blocks/prop-y-lambda-closed-form-wenzl-bridge"],"tags":["extracted-table"],"text":"y-lambda-closed-form-wenzl-bridge-table1-data.md","provenance":"authored","html":"<a id=\"tbl:y-lambda-closed-form-wenzl-bridge-table1-data\"></a><table>\n<thead>\n<tr>\n<th></th>\n<th><code class=\"language-math math-inline\">\\sigma</code>-convention (this paper)</th>\n<th><code class=\"language-math math-inline\">g</code>-convention (Wenzl-Orellana)</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Quadratic</td>\n<td><code class=\"language-math math-inline\">\\sigma_i^2 = (q - q^{-1})\\sigma_i + 1</code></td>\n<td><code class=\"language-math math-inline\">g_i^2 = (Q - 1)g_i + Q</code></td>\n</tr>\n<tr>\n<td>Eigenvalues</td>\n<td><code class=\"language-math math-inline\">q, -q^{-1}</code></td>\n<td><code class=\"language-math math-inline\">Q, -1</code></td>\n</tr>\n<tr>\n<td>Markov param</td>\n<td><code class=\"language-math math-inline\">z = q^3/(q^2+1) = q^2/[2]_q</code></td>\n<td><code class=\"language-math math-inline\">z_{\\mathrm{GL}} = qz = Q^2/(1+Q)</code>, i.e. <code class=\"language-math math-inline\">r = 2</code></td>\n</tr>\n</tbody>\n</table>\n","source":"folio/quantum-observable-universe/mass-theory/y-lambda-closed-form-wenzl-bridge-table1-data.md","heading":"Table","page":"b/tbl-y-lambda-closed-form-wenzl-bridge-table1-data","qa":{"counts":{"pass":42,"fail":2,"warn":1,"na":37,"unknown":0,"stale":17}}}
