{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/","folio-assistant-core":"https://litlfred.github.io/folio-assistant-core/v0/ns/"}],"@id":"papers/quantum-observable-universe/blocks/tbl-six-term-per-derivation-weights-table1-data","@type":["folio-assistant-core:Table","doco:Table"],"label":"tbl:six-term-per-derivation-weights-table1-data","kind":"table","title":"Data table 1 from conj:six-term-per-derivation-weights","uses":["papers/quantum-observable-universe/blocks/conj-six-term-per-derivation-weights"],"tags":["extracted-table"],"text":"six-term-per-derivation-weights-table1-data.md","provenance":"authored","html":"<a id=\"tbl:six-term-per-derivation-weights-table1-data\"></a><table>\n<thead>\n<tr>\n<th>term</th>\n<th>weight</th>\n<th>source</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code class=\"language-math math-inline\">T_1 = \\lvert\\mathrm{tr}_M(T_w)\\rvert</code></td>\n<td><code class=\"language-math math-inline\">E_{0,\\beta} \\approx 0.7823</code> MeV</td>\n<td><a href=\"#prop:categorical-mass-markov\" data-at=\"mass-endomorphism/categorical-mass-eigenspaces\">categorical mass, Markov</a>; free-neutron β-decay <code class=\"language-math math-inline\">Q</code></td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">T_2 = \\sum_i \\Phi(\\lvert\\hat V_i\\rvert)</code></td>\n<td><code class=\"language-math math-inline\">\\alpha = m_e \\cdot 8G \\approx 3.7445</code> MeV</td>\n<td><a href=\"#conj:binding-scale-catalan\" data-at=\"mass-theory/mass-formula-derivation\">binding scale Catalan</a>; <code class=\"language-math math-inline\">\\Phi = -\\mathrm{Li}_2^q(-\\,\\cdot)</code> per <a href=\"#prop:mass-endomorphism-tower\" data-at=\"mass-theory/archimedean-realization-kashaev\">Kashaev limit</a></td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">T_3 = z^2 \\sum_{i&#x3C;j} \\Phi(\\lvert\\hat V_i \\hat V_j\\rvert)</code></td>\n<td><code class=\"language-math math-inline\">\\alpha</code> (same scale)</td>\n<td><a href=\"#thm:markov-trace-factorization\" data-at=\"mass-theory/mass-algebraic-consolidated/mass-algebraic-transfer-skein\">Markov trace factorisation</a></td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">T_4 = \\tau(C_{\\dim_q})</code></td>\n<td><code class=\"language-math math-inline\">m_e \\approx 0.5110</code> MeV</td>\n<td><a href=\"#thm:frobenius-codim-universal\" data-at=\"mass-theory/plancherel-alpha-spectral\">Frobenius universal</a></td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">T_5 = (a_K - 1) \\cdot T_1</code></td>\n<td><code class=\"language-math math-inline\">E_{0,\\beta}</code> (multiplicative on <code class=\"language-math math-inline\">T_1</code>)</td>\n<td><a href=\"#prop:chirality-dual-space-derivation\" data-at=\"mass-theory/six-term-crystal-isospin-chirality\">chirality dual-space</a></td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">T_6 = \\sum_{\\ell \\geq 2} \\mathrm{Res}_{\\zeta_\\ell}/(q_0 - \\zeta_\\ell)</code></td>\n<td><code class=\"language-math math-inline\">1</code> (already MeV)</td>\n<td><a href=\"#prop:full-pole-structure-mass-trace\" data-at=\"mass-theory/phi-q-markov-residue-habiro\">full pole structure</a></td>\n</tr>\n</tbody>\n</table>\n","source":"folio/quantum-observable-universe/mass-theory/six-term-per-derivation-weights-table1-data.md","heading":"Table","page":"b/tbl-six-term-per-derivation-weights-table1-data","qa":{"counts":{"pass":31,"fail":0,"warn":0,"na":27,"unknown":0,"stale":57}}}
