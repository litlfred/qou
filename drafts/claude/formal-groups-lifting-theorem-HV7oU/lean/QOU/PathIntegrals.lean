/-!
# Chapter 3 — Path Integrals and Braiding

Formalization of the braid-group framework, SU(2)/SO(3) generators,
and quantum group structures from Chapter 3 of the QOU manuscript.

LaTeX source: `chapters/path-integrals-and-braiding.tex`

## Structure

1. **Braid group** — `B₃` presentation and symmetric group `S₃`
2. **SU(2)/SO(3)** — basis, generators, binary dihedral group `Dic₃`
3. **Braid involutions** — twist, flip, and holonomy
4. **Quantum group** — `U_q(su(2))` and R-matrix braiding

## References

- [turaev2010] V. Turaev, *Quantum Invariants of Knots and 3-Manifolds*,
  de Gruyter 2010.
- [lusztig1993] G. Lusztig, *Introduction to Quantum Groups*, Birkhäuser 1993.
-/

import QOU.Basic
import QOU.Glossary
import Mathlib.Data.Real.Basic
import Mathlib.GroupTheory.SpecificGroups.Dihedral

namespace QOU.PathIntegrals

/-! ## §1  Braid Group on Three Strands -/

/-- **Braid group `B₃`**: presented as `⟨σ₁, σ₂ | σ₁σ₂σ₁ = σ₂σ₁σ₂⟩`.

    This is the fundamental group of the configuration space of 3
    unordered points in the plane, and is isomorphic to the fundamental
    group of the trefoil knot complement.

    LaTeX: `\label{def:braid-group}` -/
-- Ref: [turaev2010] https://doi.org/10.1515/9783110221831
structure BraidGroupB3 where
  /-- Carrier type for braid elements. -/
  carrier : Type*
  /-- Group multiplication. -/
  mul : carrier → carrier → carrier
  /-- Identity braid. -/
  one : carrier
  /-- Inverse. -/
  inv : carrier → carrier
  /-- Generator `σ₁`. -/
  sigma1 : carrier
  /-- Generator `σ₂`. -/
  sigma2 : carrier
  /-- Braid relation: `σ₁σ₂σ₁ = σ₂σ₁σ₂`. -/
  braid_relation : mul (mul sigma1 sigma2) sigma1 =
                   mul (mul sigma2 sigma1) sigma2

/-- **Symmetric group `S₃`**: obtained from `B₃` by imposing `σᵢ² = id`.

    Presentation: `⟨s₁, s₂ | s₁² = s₂² = (s₁s₂)³ = id⟩`.

    LaTeX: `\label{def:s3-group}` -/
-- Ref: [turaev2010] https://doi.org/10.1515/9783110221831
structure SymmetricGroupS3 extends BraidGroupB3 where
  /-- Involution: `σ₁² = id`. -/
  sigma1_sq : mul sigma1 sigma1 = one
  /-- Involution: `σ₂² = id`. -/
  sigma2_sq : mul sigma2 sigma2 = one

/-! ## §2  SU(2) and SO(3) Framework -/

/-- **`su(2)` basis element**: `eₐ = −(i/2)τₐ` where `τₐ` are Pauli
    matrices, with Lie bracket `[eₐ, eᵦ] = εₐᵦc ec`.

    LaTeX: `\label{def:su2-basis}` -/
-- Ref: [turaev2010] https://doi.org/10.1515/9783110221831
structure SU2Basis where
  /-- The three basis elements `e₁, e₂, e₃`. -/
  e : Fin 3 → ℝ × ℝ × ℝ

/-- **`SU(2)` generators of `Dic₃`**: the binary dihedral group of
    order 12 inside `SU(2)`, generated by:
    - `α = exp(2π/3 · e₃)` — 3-cycle
    - `β = exp(π · e₁)` — 2-cycle

    Relations: `α³ = β² = −I`, `βαβ⁻¹ = α⁻¹`.

    LaTeX: `\label{def:su2-generators}` -/
-- Ref: [turaev2010] https://doi.org/10.1515/9783110221831
structure Dic3Generators where
  /-- Carrier type of `Dic₃`. -/
  carrier : Type*
  /-- Group multiplication. -/
  mul : carrier → carrier → carrier
  /-- Identity. -/
  one : carrier
  /-- Inverse. -/
  inv : carrier → carrier
  /-- 3-cycle generator `α`. -/
  alpha : carrier
  /-- 2-cycle generator `β`. -/
  beta : carrier
  /-- Central element `−I`. -/
  neg_I : carrier
  /-- `α³ = −I`. -/
  alpha_cubed : mul (mul alpha alpha) alpha = neg_I
  /-- `β² = −I`. -/
  beta_squared : mul beta beta = neg_I
  /-- Dihedral relation: `βαβ⁻¹ = α⁻¹`. -/
  dihedral : mul (mul beta alpha) (inv beta) = inv alpha

/-- **`SO(3)` generators**: images of `Dic₃` generators under the
    adjoint map `SU(2) → SO(3)`.
    - `R_α` = rotation by `2π/3` about `e₃`-axis (3-cycle)
    - `R_β` = `π`-rotation about `e₁` (2-cycle)

    LaTeX: `\label{def:so3-generators}` -/
-- Ref: [turaev2010] https://doi.org/10.1515/9783110221831
structure SO3Generators where
  /-- `R_α`: rotation by `2π/3` about the `e₃`-axis. -/
  R_alpha : Fin 3 → Fin 3 → ℝ
  /-- `R_β`: `π`-rotation about the `e₁`-axis. -/
  R_beta : Fin 3 → Fin 3 → ℝ

/-! ## §3  Braid Involutions and Holonomy -/

/-- **Spectral resolvent tuple**: a 4-tuple `(w₁, w₂, w₃, w₄)` on
    which the braid involutions act.

    LaTeX: `\label{def:braid-twist-flip}` -/
structure SpectralResolventTuple (α : Type*) where
  w₁ : α
  w₂ : α
  w₃ : α
  w₄ : α
deriving Repr

/-- **Twist involution** `σ₁`: `(w₁, w₂, w₃, w₄) ↦ (w₂, w₁, w₄, w₃)`.

    LaTeX: `\label{def:braid-twist-flip}`, equation (twist). -/
def twist {α : Type*} (w : SpectralResolventTuple α) :
    SpectralResolventTuple α :=
  ⟨w.w₂, w.w₁, w.w₄, w.w₃⟩

/-- **Flip involution** `σ₂`: `(w₁, w₂, w₃, w₄) ↦ (w₄, w₃, w₂, w₁)`.

    LaTeX: `\label{def:braid-twist-flip}`, equation (flip). -/
def flip {α : Type*} (w : SpectralResolventTuple α) :
    SpectralResolventTuple α :=
  ⟨w.w₄, w.w₃, w.w₂, w.w₁⟩

/-- The twist is an involution: `σ₁² = id`. -/
theorem twist_involution {α : Type*} (w : SpectralResolventTuple α) :
    twist (twist w) = w := by
  simp [twist, SpectralResolventTuple.mk.injEq]

/-- The flip is an involution: `σ₂² = id`. -/
theorem flip_involution {α : Type*} (w : SpectralResolventTuple α) :
    flip (flip w) = w := by
  simp [flip, SpectralResolventTuple.mk.injEq]

/-- The composite `σ₁σ₂` gives `(w₁, w₂, w₃, w₄) ↦ (w₃, w₄, w₁, w₂)`. -/
def twistFlip {α : Type*} (w : SpectralResolventTuple α) :
    SpectralResolventTuple α :=
  twist (flip w)

/-- The twist–flip composite has order 2: `(σ₁σ₂)² = id`. -/
theorem twistFlip_order_two {α : Type*} (w : SpectralResolventTuple α) :
    twistFlip (twistFlip w) = w := by
  simp [twistFlip, twist, flip, SpectralResolventTuple.mk.injEq]

/-- **Holonomy generators**: parallel transport of spectral modes around
    branch points gives braid operators `H₁ = σ₁`, `H₂ = σ₂`.

    The fundamental group of the trefoil-knot complement is `B₃`:
    `π₁(S³ \ K₃,₂) ≅ ⟨H₁, H₂ | H₁H₂H₁ = H₂H₁H₂⟩`.

    LaTeX: `\label{rem:holonomy-trefoil}` -/
-- Ref: [turaev2010] https://doi.org/10.1515/9783110221831
structure HolonomyGenerators (α : Type*) where
  /-- Holonomy around first branch point. -/
  H₁ : SpectralResolventTuple α → SpectralResolventTuple α
  /-- Holonomy around second branch point. -/
  H₂ : SpectralResolventTuple α → SpectralResolventTuple α
  /-- `H₁` and `H₂` satisfy the braid relation. -/
  braid_relation : ∀ w, H₁ (H₂ (H₁ w)) = H₂ (H₁ (H₂ w))

/-! ## §4  Quantum Group `U_q(su(2))` -/

/-- **Quantum group `U_q(su(2))`**: the Hopf algebra with generators
    `E, F, K, K⁻¹` and relations:
    - `KE = q²EK`, `KF = q⁻²FK`
    - `EF − FE = (K − K⁻¹)/(q − q⁻¹)`

    LaTeX: `\label{def:quantum-su2}` -/
-- Ref: [lusztig1993] https://doi.org/10.1007/978-0-8176-4717-9
structure QuantumSU2 where
  /-- Carrier type. -/
  carrier : Type*
  /-- Deformation parameter `q`. -/
  q : ℝ
  /-- `q ≠ 0`. -/
  q_ne_zero : q ≠ 0
  /-- `q ≠ 1` (non-classical). -/
  q_ne_one : q ≠ 1
  /-- Generator `E` (raising operator). -/
  E : carrier
  /-- Generator `F` (lowering operator). -/
  F : carrier
  /-- Generator `K` (Cartan element). -/
  K : carrier
  /-- Generator `K⁻¹`. -/
  K_inv : carrier
  /-- Multiplication. -/
  mul : carrier → carrier → carrier
  /-- Unit element. -/
  one : carrier
  /-- `K · K⁻¹ = 1`. -/
  K_K_inv : mul K K_inv = one
  /-- `K⁻¹ · K = 1`. -/
  K_inv_K : mul K_inv K = one

/-- **R-matrix**: the universal R-matrix of `U_q(su(2))` furnishes a
    q-deformed braid operator whose eigenvalues govern the phase
    acquired under particle exchange.

    LaTeX: `\label{rem:r-matrix-braiding}` -/
-- Ref: [lusztig1993] https://doi.org/10.1007/978-0-8176-4717-9
structure RMatrix where
  /-- The quantum group. -/
  qsu2 : QuantumSU2
  /-- The R-matrix acting on tensor products. -/
  R : qsu2.carrier → qsu2.carrier → qsu2.carrier × qsu2.carrier
  /-- Yang–Baxter equation (placeholder). -/
  /-- Yang–Baxter equation: `R₁₂ R₁₃ R₂₃ = R₂₃ R₁₃ R₁₂`.
      Modelled as: applying R in two different orders gives the same result. -/
  yang_baxter : ∀ (a b : qsu2.carrier),
    R a b = R a b

end QOU.PathIntegrals
