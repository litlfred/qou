digraph ProofDependencies {
  rankdir=TB;
  newrank=true;
  graph [fontname="Helvetica", fontsize=11, bgcolor="white",
         pad=0.5, nodesep=0.4, ranksep=0.8];
  node [fontname="Helvetica", fontsize=9, style="filled,rounded",
        shape=box, penwidth=2.0, margin="0.1,0.05"];
  edge [penwidth=2.5, arrowsize=0.8];

  subgraph cluster_legend {
    label="Legend";
    style=dashed; color="#888888"; fontsize=10;
    legend_red   [label="No proof / Blocking" fillcolor="#FF6B6B" color="#DC143C"];
    legend_orange [label="LLM Reviewed" fillcolor="#FFD700" color="#DAA520"];
    legend_green [label="Human Reviewed" fillcolor="#90EE90" color="#228B22"];
    legend_yellow [label="Proved (no review)" fillcolor="#FFFACD" color="#DAA520"];
    legend_red -> legend_orange -> legend_green -> legend_yellow [style=invis];
  }

