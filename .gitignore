__pycache__/
*.pyc
.folio-assistant-prefs.json
.folio-prefs.json
build/

# The platform lives in the external repo litlfred/folio-assistant.
# scripts/setup-folio-assistant.sh symlinks <root>/folio-assistant to a
# local clone of it; the symlink (and any in-place clone) is not tracked.
/folio-assistant
# Local build convenience: `latex` -> folio-assistant/latex (shared preamble).
# Not tracked — qou has no committed preamble; the build resolves it via this link.
/latex

# Generated LaTeX chapters (from content pipeline)
chapters/*.tex
chapters/*.md
*.aux
*.log
*.out
*.toc
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz
# LaTeX preamble format cache + memoize box cache (regenerable build outputs;
# CI persists them via actions/cache, not git — see local/latex-build-cache)
*.fmt
qou.fmt.sha
.memo/
*.pdf
# Whitelist authored figure PDFs (SVG→PDF companions for the
# LaTeX renderer; see content/pipeline/render-latex.ts image case).
!content/**/rendered/*.pdf
!figures/*.pdf
# Whitelist intake uploads (raw PDFs, scans, WHO guidelines etc.
# committed via scripts/upload-bib-papers.sh and similar intake
# pipelines per AGENTS.md §"uploads/").
!uploads/*.pdf
!uploads/*.txt
!uploads/*.json
!uploads/*.html
!uploads/*.xml
!uploads/*.csv
!uploads/*.tsv
diff.tex
main-flat.tex
tikz-cache/
print-mode.tex
main.tex
standalone-*.tex
build-warnings.log
build-feature/
_site/

# Lean build artifacts (all paper packages + root workspace)
.lake/
.lake-build.lock
lake-packages/
content/*/lean/.lake/
content/*/lean/lake-packages/
content/*/lean/build/

# Generated graph intermediate files
dependency-graph.dot
node_modules/
node_modules

# Deployment secrets and generated files (never commit)
deploy/.env
deploy/authorized-emails.txt
deploy/Caddyfile
deploy/viewer/
scripts/mcp-server/bun.lock
folio-assistant/schemas/bun.lock
folio-assistant/viewer/paper.js
# Root-level dev dependencies (TypeDoc etc.)
package-lock.json
bun.lock

# Work-tracking todos (mostly gitignored — survives branch switches)
todos/*
# EXCEPTION: per-goal coordination queues are committed so multiple agents
# can see the same queue. Pattern: todos/<goal>-queue.json
!todos/*-queue.json
# The agent-drain queue moved to .beans/qa-agent-drain-queue.json — a
# tracked bulk-JSON coordination queue (beans ≠ sidecars). The legacy
# todos/ path is re-ignored for any old-invocation stragglers.
todos/qa-agent-drain-queue.json
# Stray queue artifact when a pipeline script is run with cwd=content/
content/todos/

# Bean work-plan (.beans/ is tracked). Watcher *-queue.json are tracked
# bulk-JSON coordination queues; watcher *-ledger.md are local runtime
# event logs — keep them gitignored (matching the prior todos/ semantics).
.beans/*-ledger.md

# Local agent state (per-machine, not shared)
.claude/local-state/
.claude/worktrees/
.qou-feedback/
.qou-tmp/
.folio-feedback/
.folio-tmp/
.folio-assistant-tmp/

# Feedback worktree (local checkout of main for committing feedback)
.feedback-wt/

# Generated bibliography QA report
content/bib-qa.json

# Large computation witnesses (regenerated by running the script)
computations/quark-level-knot-table.witness.json

# run_pipeline infra-hash cache (tracks source-file staleness; local only)
computations/.infra-hashes.json
computations/hecke_startup_cache.json

computations/.cache/
computations/.cache/ocneanu/

# Top-level computations/ regenerable caches (the repo's compute tree is
# computations/; these auto-generated seminormal / hoefsmit / term caches are
# rebuilt on demand and must never be committed — mirror of the
# computations/ rules above).
computations/.cache/
computations/.hoefsmit_cache/
computations/.term_cache/
computations/.infra-hashes.json
computations/hecke_startup_cache.json
computations/atomic-prefix-cache/

# Glossary curator scratch (regenerated by `bun run pipeline/glossary-candidates.ts`)
content/*/glossary-candidates.json

# Audit-wiring JSON output (regenerated by `bun run audit-wiring`)
content/audit-wiring.json
computations/y-lambda-wenzl-bridge-n13to18-witness.json
computations/.hoefsmit_cache/
computations/.term_cache/
# Δ_q-decoration cache written to a non-canonical hecke/ subdir by some
# entry points (canonical tracked copy is computations/delta-q-decoration.cache.json)
computations/hecke/*.cache.json
computations/delta-lambda-empirical-tabulation.witness.json
scripts/.bib-mcp-cli-log.json

# Prefix-cache witnesses (auto-generated, per-user state)
computations/atomic-prefix-cache/

# Lean content-block verification scratch area (throwaway; never committed)
**/lean/QOU/_Scratch/

# Sage preparse build artifacts
*.sage.py
