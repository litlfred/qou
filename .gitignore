# Work-tracking todos (mostly gitignored — survives branch switches)
todos/*
# EXCEPTION: per-goal coordination queues are committed so multiple agents
# can see the same queue. Pattern: todos/<goal>-queue.json
!todos/*-queue.json
# The agent-drain queue moved to .beans/qa-agent-drain-queue.json — a
# tracked bulk-JSON coordination queue (beans ≠ sidecars). The legacy
# todos/ path is re-ignored for any old-invocation stragglers.
todos/qa-agent-drain-queue.json
# Stray queue artifact when a pipeline script is run with cwd=content/
content/todos/

# Bean work-plan (.beans/ is tracked). Watcher *-queue.json are tracked
# bulk-JSON coordination queues; watcher *-ledger.md are local runtime
# event logs — keep them gitignored (matching the prior todos/ semantics).
.beans/*-ledger.md

# Harness runtime noise under .work/ (the directory itself is tracked). The
# convention-C regeneration journal .work/convention-c-regen.jsonl IS
# committed — it is the resume point for the serial regeneration harness and
# the evidence behind
# docs/audits/2026-08-10-convention-c-witness-regeneration-impact.md.
# Its rotation backup and the stdout logs are not.
.work/*.bak
.work/*.log

