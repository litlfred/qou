# The kept trashcan lives on its own branch, `cat/cat-harness/fsh-guts`, not on
# main (owner, 2026-10-10; bean qou-6u3n). `bun run state:mount` (from
# folio-assistant/) puts it at `fsh-guts/`; a mounted copy committed to main
# would be a second, diverging copy. `/**`, not `/fsh-guts/`, matching the
# platform's rule so branch-store still sees the mount's files.
/fsh-guts/**
# Kept on cat/cat-harness/beans; mounted here by state:mount, never committed to main
/beans/**

# BEGIN state mounts (generated by state:mount from the declared branch subgraphs — do not edit)
/beans/**
/fsh-guts/**
/lean/**
# END state mounts

