{
  "mcpServers": {
    "paper-assistant": {
      "command": "./scripts/start-folio-assistant.sh",
      "args": ["--stdio"]
    },
    "paper-search-mcp": {
      "command": "uvx",
      "args": ["paper-search-mcp"]
    },
    "openalex-paper-search": {
