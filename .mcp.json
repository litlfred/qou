{
  "mcpServers": {
    "paper-assistant": {
      "command": "bash",
      "args": ["scripts/paper-assistant-mcp.sh"]
    },
    "paper-search-mcp": {
      "command": "uvx",
      "args": ["--from", "paper-search-mcp", "python", "-m", "paper_search_mcp.server"]
    },
    "openalex-paper-search": {
      "command": "uvx",
      "args": ["--from", "git+https://github.com/drAbreu/alex-mcp.git@4.1.0", "alex-mcp"]
    },
    "lean-lsp": {
      "command": "uvx",
      "args": ["lean-lsp-mcp"]
    }
  }
}
