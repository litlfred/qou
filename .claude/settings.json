{
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); model=$(echo \"$input\" | jq -r '.model.display_name // \"Claude\"'); cwd=$(echo \"$input\" | jq -r '.workspace.current_dir // .cwd // \"\"'); dir=$(basename \"$cwd\"); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); ctx=\"\"; [ -n \"$used\" ] && ctx=\" | ctx: $(printf '%.0f' \"$used\")%\"; printf \"%s | %s%s\" \"$model\" \"$dir\" \"$ctx\""
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/check-lean.sh"
          },
          {
            "type": "command",
            "command": "./scripts/check-todos.sh"
          },
          {
            "type": "command",
            "command": "./scripts/open-assistant.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/render-on-change.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/greeting-task-selection.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCommit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "./scripts/check-no-lean-artifacts.sh"
          }
        ]
      }
    ]
  }
}
