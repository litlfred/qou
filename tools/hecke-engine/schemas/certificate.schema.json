{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://folio.litlfred.org/schemas/hecke-engine/certificate.schema.json",
  "title": "Hecke-engine witness certificate",
  "description": "Output of tools/hecke-engine/ binaries. Minimal variant carries f64 trace summaries; full variant adds sparse Laurent polynomials in t = q^{1/2}.",
  "type": "object",
  "required": [
    "isotope",
    "engine"
  ],
  "properties": {
    "isotope": {
      "type": "object",
      "required": [
        "z",
        "n",
        "a"
      ],
      "properties": {
        "z": {
          "type": "integer",
          "minimum": 0
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "a": {
          "type": "integer",
          "minimum": 0
        },
        "symbol": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parity": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        }
      }
    },
    "engine": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "binary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "tr_alt": {
      "$ref": "#/$defs/SparsePoly"
    },
    "net": {
      "$ref": "#/$defs/SparsePoly"
    },
    "observable": {
      "$ref": "#/$defs/SparsePoly"
    },
    "color": {
      "$ref": "#/$defs/SparsePoly"
    },
    "pn_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "f_pauli_f64": {
      "type": [
        "number",
        "null"
      ]
    },
    "tr_alt_f64": {
      "type": [
        "number",
        "null"
      ]
    },
    "net_f64": {
      "type": [
        "number",
        "null"
      ]
    },
    "observable_f64": {
      "type": [
        "number",
        "null"
      ]
    },
    "color_f64": {
      "type": [
        "number",
        "null"
      ]
    },
    "strands": {
      "type": "array",
      "items": {
        "type": [
          "object",
          "null"
        ]
      }
    },
    "total_words": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "max_coeff_log10": {
      "type": [
        "number",
        "null"
      ]
    },
    "elapsed_seconds": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "computed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "jets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SparsePoly"
      }
    },
    "generation": {
      "type": "object",
      "description": "How this certificate was generated -- enough to re-run it exactly. Absent on certificates emitted before 2026-08-15; every new one has it. Added because applying the Q_0 muon->proton re-pin to the committed certificates required reading the emitter's source at the commit that produced each one: neither the generator nor its cutoff parameter was recorded per file, and the 51 files came from four different binaries emitting different schemas. (An earlier version of this description said the re-pin 'could not be applied'. That was withdrawn -- the f64 fields are derivable from the exact Laurent terms via tr_alt_f64 = eval(tr_alt) / 2^pn_count, and scripts/reanchor_certificates.py does so.)",
      "required": [
        "binary",
        "argv",
        "reproduce",
        "q0",
        "q0_pin"
      ],
      "properties": {
        "binary": {
          "type": "string",
          "description": "Binary as invoked, file name only."
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Full argument vector. Raw argv rather than modelled per-generator fields, so it cannot silently omit an option the schema does not know about."
        },
        "reproduce": {
          "type": "string",
          "description": "Ready-to-run command reproducing this certificate."
        },
        "q0": {
          "type": "number",
          "description": "Substrate anchor actually used."
        },
        "q0_pin": {
          "type": "string",
          "enum": [
            "proton",
            "muon",
            "truncated-5-digit",
            "other"
          ],
          "description": "Which pin q0 is, bucketed by ppb distance from the proton anchor by classify_pin() in src/provenance.rs. 'truncated-5-digit' is the 1.10998 literal hecke-bigint used until 2026-08-15, 1277 ppb off -- it has its own value because it is a known, fixable cause rather than an unexplained anchor, and lumping it into 'other' hid it. 'other' means neither pin and no known cause: read the emitter."
        },
        "engine_version": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "SparsePoly": {
      "type": "object",
      "description": "Sparse Laurent polynomial in t = q^{1/2}. `terms` is an array of [exponent, coefficient_decimal_string] pairs.",
      "required": [
        "terms"
      ],
      "properties": {
        "terms": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": [
                  "string",
                  "integer",
                  "number"
                ]
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "denominator": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        }
      }
    }
  }
}
