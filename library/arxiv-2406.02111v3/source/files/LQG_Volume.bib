@Article{Walker2012,
  author   = {Walker, Kevin and Wang, Zhenghan},
  journal  = {Front. Phys.},
  title    = {(3+1)-{TQFT}s and topological insulators},
  year     = {2012},
  issn     = {2095-0470},
  month    = {Apr},
  number   = {2},
  pages    = {150-159},
  volume   = {7},
  abstract = {Levin-Wen models are microscopic spin models for topological phases of matter in (2+1)-dimension. We introduce a generalization of such models to (3 + 1)-dimension based on unitary braided fusion categories, also known as unitary premodular categories. We discuss the ground state degeneracy on 3-manifolds and statistics of excitations which include both points and defect loops. Potential connections with recently proposed fractional topological insulators and projective ribbon permutation statistics are described.},
  day      = {01},
  doi      = {10.1007/s11467-011-0194-z},
  url      = {https://doi.org/10.1007/s11467-011-0194-z},
}

@Article{Kadar2010,
  author    = {K{\'a}d{\'a}r, Zolt{\'a}n and Marzuoli, Annalisa and Rasetti, Mario},
  journal   = {Adv. Math. Phys.},
  title     = {Microscopic {D}escription of {2D} {T}opological {P}hases, {D}uality, and {3D} {S}tate {S}ums},
  year      = {2010},
  issn      = {1687-9120},
  month     = {Apr},
  pages     = {671039},
  volume    = {2010},
  abstract  = {Doubled topological phases introduced by Kitaev, Levin, and Wen supported on two-dimensional lattices are Hamiltonian versions of three-dimensional topological quantum field theories described by the Turaev-Viro state sum models. We introduce the latter with an emphasis on obtaining them from theories in the continuum. Equivalence of the previous models in the ground state is shown in case of the honeycomb lattice and the gauge group being a finite group by means of the well-known duality transformation between the group algebra and the spin network basis of lattice gauge theory. An analysis of the ribbon operators describing excitations in both types of models and the three-dimensional geometrical interpretation are given.},
  day       = {11},
  doi       = {10.1155/2010/671039},
  publisher = {Hindawi Publishing Corporation},
  url       = {https://doi.org/10.1155/2010/671039},
}



