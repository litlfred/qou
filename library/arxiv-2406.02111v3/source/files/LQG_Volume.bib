@Article{Beer2018,
  author        = {Beer, Kerstin and Bondarenko, Dmytro and Hahn, Alexander and Kalabakov, Maria and Knust, Nicole and Niermann, Laura and Osborne, Tobias J. and Schridde, Christin and Seckmeyer, Stefan and Stiegemann, Deniz E. and Wolf, Ramona},
