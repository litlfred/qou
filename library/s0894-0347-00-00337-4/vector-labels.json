          "bbox": [
            126.71,
            487.02,
            485.49,
            496.98
          ],
          "intersectsDrawing": false,
          "fonts": [
            "CMR10"
          ],
          "sizes": [
            9.96
          ]
        },
        {
          "text": "mean the study of the behavior of λ1, λ2, and so on.",
