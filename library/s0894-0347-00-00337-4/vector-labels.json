          "sizes": [
            6.97,
            9.96
          ]
        },
        {
          "text": "respectively. A combinatorial proof of the full conjecture was given by one of us in",
          "bbox": [
            126.71,
            439.14,
            485.35,
            449.1
          ],
          "intersectsDrawing": false,
