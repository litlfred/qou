          "bbox": [
            126.71,
            403.38,
            485.42,
            413.34
          ],
          "intersectsDrawing": false,
          "fonts": [
            "CMR10"
          ],
          "sizes": [
            9.96
          ]
        },
        {
          "text": "ian random Hermitian matrix (which form the so-called Airy ensemble; see Section",
          "bbox": [
            126.71,
            415.26,
            485.4,
            425.22
          ],
          "intersectsDrawing": false,
          "fonts": [
            "CMR10"
          ],
          "sizes": [
            9.96
          ]
        },
        {
