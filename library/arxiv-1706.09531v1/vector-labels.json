            540.02,
            309.25
          ],
          "intersectsDrawing": false,
          "fonts": [
            "CMR12"
          ],
          "sizes": [
            11.96
          ]
        },
        {
          "text": "constitutes the missing piece of evidence for grand uniﬁcation is discussed in Sec. 7.",
