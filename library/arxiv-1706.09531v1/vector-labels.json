            532.48,
            399.81,
            564.37,
            417.57
          ],
          "intersectsDrawing": false,
          "fonts": [
            "CMMI8",
            "CMR12"
          ],
          "sizes": [
            7.97,
            11.96
          ]
        },
        {
          "text": "sin2 θW(mZ)) |MS= 0.214±0.004, where as current experimental data show: sin2 θW(mZ)expt",
          "bbox": [
            72.0,
            400.84,
