  "title": "State sum models with defectsbased on spherical fusion categories Catherine Meusburger Department Mathematik Friedrich-Alexander-Universit\u00e4t Erlangen-N\u00fcrnberg",
  "authors_raw": "Cauerstra\u00dfe 11, 91058 Erlangen, Germany",
  "title_lines": [
   "State sum models with defectsbased on spherical fusion categories",
   "Catherine Meusburger",
