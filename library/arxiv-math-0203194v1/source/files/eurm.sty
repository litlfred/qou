  \DeclareFontFamily{U}{eur}{\skewchar\font'177}%
  \DeclareFontShape{U}{eur}{m}{n}{<-6>eurm5<6-8>eurm7<8->eurm10}{}%
  \DeclareFontShape{U}{eur}{b}{n}{<-6>eurb5<6-8>eurb7<8->eurb10}{}%
}
\DeclareOption{matheur}{%
  \providecommand{\matheur}{}\renewcommand{\matheur}{\EuRoman}%
}
\ExecuteOptions{matheur}
\ProcessOptions
