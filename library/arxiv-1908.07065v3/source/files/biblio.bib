@article{blmst,
	Abstract = {We elucidate the relation between Painlev{\'e} equations and four-dimensional rank one {\$}{\$}{\backslash}mathcal {\{}N{\}} = 2{\$}{\$}N=2theories by identifying the connection associated with Painlev{\'e} isomonodromic problems with the oper limit of the flat connection of the Hitchin system associated with gauge theories and by studying the corresponding renormalization group flow. Based on this correspondence, we provide long-distance expansions at various canonical rays for all Painlev{\'e} {\$}{\$}{\backslash}tau {\$}{\$}$\tau$-functions in terms of magnetic and dyonic Nekrasov partition functions for {\$}{\$}{\backslash}mathcal {\{}N{\}} = 2{\$}{\$}N=2SQCD and Argyres--Douglas theories at self-dual Omega background {\$}{\$}{\backslash}epsilon {\_}1 + {\backslash}epsilon {\_}2 = 0{\$}{\$}ϵ1+ϵ2=0or equivalently in terms of {\$}{\$}c=1{\$}{\$}c=1irregular conformal blocks.},
