%
%
% Repeat something many times.
% \mult{5}{<text>}=<text><text><text><text><text>
%
%
\def\mult#1#2{\t@cnt#1\relax\t@mes{#2}}
\def\t@mes#1{\ifnum\t@cnt>0\advance\t@cnt by -1\relax
\def\@tempa{\t@mes{#1}#1}\else\let\@tempa\relax\fi
\@tempa}
\newcount\t@cnt
