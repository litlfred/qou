% \web|http://www.math.toronto.edu/~stoimeno/|
% outputs ~ well, and puts a linebreak after slashes
% but not after 1st slash in '//' (like http://...)
\def\firstch@r#1#2\@nil{#1}
\def\web#1{%
 \bgroup\let \do \@makeother\do \_\do \^%\do \~%
 \catcode`\~=\active\def~{\~{}}
  \gdef\myverb##1#1{%
    \def\@tempx####1/####2\@end{%
      \@ifempty{####2}%
        {{\do \_\do \^\tt ####1}\egroup\let\@tempz\@gobble}%
        {{\do \_\do \^\tt ####1/}%
	 % put a linebreak only if #2 starts with a /
	 \def\@tempq{\@ifnextchar/{\@gobble}{\linebreak[0]\@gobble}}%
	 \ea\@tempq\firstch@r####2\@nil\let\@tempz\@tempx%
	}%
        \@tempz####2\@end%
    }%
    \@tempx##1/\@end%
  }%
 \myverb
}%

% a slightly fancier vers for putting linebreaks after the char
% following directly after the macro
% e.g. \webb.|http://www.math.toronto.edu/~stoimeno/| acts like
% \web|http://www.math.toronto.edu/~stoimeno/| but put linebraks after
% `.' rather than '/'
\def\webb#1#2{%
 \bgroup \let \do \@makeother\do \_\do \^\do \~%
  \gdef\myverb##1#2{%
    \def\@tempx####1#1####2\@end{%
      \@ifempty{####2}%
        {{\tt ####1}\egroup\let\@tempz\@gobble}%
        {{\do \_\do \^\do \~\tt ####1#1}\linebreak[0]\let\@tempz\@tempx%
	}%
        \@tempz####2\@end%
    }%
    \@tempx##1#1\@end%
  }%
 \myverb
}%

