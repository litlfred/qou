\newcount\pic@level
\pic@level0
\def\pic@st{\relax%
%\pss{piclevel ist \the\pic@level}%
\advance\pic@level by 1%
\relax%\pss{piclevel ist \the\pic@level}
\ifnum\pic@level=1{\pss{@picbegin}}\fi}

\def\pic@end{\relax%
%\pss{piclevel_ist \the\pic@level}
\advance\pic@level by -1%
\relax%\pss{piclevel_ist \the\pic@level}
\ifnum\pic@level=0{\pss{@picend}}\fi}

\def\pic@pss#1{\pic@st\pss{#1}\pic@end}

\def\@original#1{\ifnum\pic@level>0{\pic@level0\pss
{@picend}#1\pss{@picbegin}}\else #1\fi}



