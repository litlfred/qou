%here a more convenient macro for placing text
%type \picputtext[dl]{0 0}{text}
%  and the the down-left-corner of the text is placed in (0,0).
%  Valid vaules for the option are : 'u', 'd', 'l', 'r', 'm'(default),
%  'ul', 'ur', 'dl' and 'dr'.

\long\def\@pictext#1#2#3{\pictext{#3}{#2}{#1}}

\def\picputtext{\@ifnextchar [\@pictextopts{\@pictext{-0.5 -0.5}}}
\def\@pictextopts[#1]{\ea\@pictext@udopts\ea{#1}}
\def\@pictext@udopts#1{%
\@ifnextchar u%
 {\def\@tempf{-1}\ea\@pictext@lropts\@gobble}%
 {\@ifnextchar d{\def\@tempf{0}\ea\@pictext@lropts\@gobble}%
		{\def\@tempf{-0.5}\@pictext@lropts}%
 }#1
}
\def\@pictext@lropts{\def\@tempg{\ea\ea\ea\@pictext\ea\ea\ea{\ea\@tempf\ea}\@gobble}%
\@ifnextchar l%
 {\edef\@tempf{0 \@tempf}\@tempg}
 {\@ifnextchar r{\edef\@tempf{-1 \@tempf}\@tempg}
		{\@ifnextchar m{\edef\@tempf{-0.5 \@tempf}\@tempg}
			       {\edef\@tempf{-0.5 \@tempf}\ea\@pictext\ea{\@tempf}%
%\@latexerr{invalid alignment sprecification in
%\noexpand\picputtext -- \char13
%valid vaules are : 'u', 'd', 'l', 'r', 'm', 'ul', 'ur', 'dl' and 'dr'}
%\@eha
			       }
		}
 }%
}
