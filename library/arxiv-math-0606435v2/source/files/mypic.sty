\def\epsfdiag#1#2#3{%
% this puts a graphics in and calls a \diag over it to put text etc.
% args: #1 the epsf inclusion command (sth like "\epsfs{3cm}{pict.eps}")
% #2 the unitlength of the \diag, #3 content of diag; the xy-size of
% \diag is adjusted automatically
  \setbox\@tempboxa=\hbox{#1}%
  \@tempdima=\dp\@tempboxa
  \setbox\@tempboxb=\hbox{\raise\@tempdima \box\@tempboxa}
  \@tempdima=\ht\@tempboxb
  \setbox\@tempboxa=\hbox to \wd\@tempboxb{\vbox to \@tempdima{%
    \vss\diag[b]{#2}{1}{1}{%
    \picputtext[dl]{0 0}{\box\@tempboxb}#3}}\hss}%
  \box\@tempboxa
}
  
