% macros for controlling settings within {}-groups

\def\pic@setup#1#2{%
\def\@lookup##1@#1@##2@##3\@@{##1@#1@#2@##3}%
\edef\pic@lcset{\ea\@lookup\pic@lcset\@@}%
\xdef\pic@glset{\ea\@lookup\pic@glset\@@}%
}

\def\@chkset{\ea\ea\ea\@mforl@@p\ea\@gobble\pic@lcset\@nil\@@}

%\def\@brace{\futurelet\@tempg\@@brace}
%\def\@@brace{\ifx\@tempg\bgroup\let\@tempe\@empty\else\let\@tempe\egroup\bgroup\@tempg}

\def\@mforl@@p #1@#2@#3\@@{\@@@exec{#1}{#2}\ifx#3\@nil\let
\@nextwhile\@gobbletwo\else\let\@nextwhile\@mforl@@p\fi
\@nextwhile #3\@@}

\def\@@@exec#1#2{\def\@tempf ##1@#1@##2@##3\@@{##2}%
\edef\@tempg{\ea\@tempf\pic@glset\@@}%
\def\@temph{#2}%
\ifx\@temph\@tempg\else\@empty \csname pic@#1\endcsname #2,\fi}


