\long\def\@placetext#1#2#3#4#5#6{%
\mbox{{\setbox0=\hbox{#6}%
\my@dim=\ht0\advance\my@dim by #4\advance\my@dim by #5%
\rx{#2}\zker\parbox#1{\wd0}{\rule[-#4]{0pt}{\my@dim}\zker\box0}\zker\rx{#3}}}}

% \diag[t] & \diag[b] call \parbox[t] & \parbox[b] !
\long\def\@diag#1#2#3#4#5{%
\@placetext{#1}{0.1ex}{0.1ex}{0.2ex}{0.2ex}{%
\unitlength#2%
\begin{picture}(#3,#4)%
\picinit
#5%
\pictail
\end{picture}%
}}

\newenvironment{pict}[3]
{\@placetext{[t]}{-0.3ex}{-0.3ex}{0.2ex}{0.2ex}\bgroup
\unitlength#1%
\begin{picture}(#2,#3)%
\picinit}{\pictail%
\end{picture}\egroup}

