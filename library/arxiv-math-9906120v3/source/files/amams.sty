\ifx\this\xsubcase\global\let\go\demostep\else
\ifx\this\xconjecture\global\let\go\demostep\else
\ifx\this\xstep\global\let\go\demostep\else
\global\let\go\demoproof\fi\fi\fi\fi\fi\fi}

