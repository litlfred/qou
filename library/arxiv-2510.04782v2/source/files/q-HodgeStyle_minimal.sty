%%%% clever hyperreferences command %%%%

% The \chref command puts a hyperlink to the exact location of a theorem in an online version of the article.
% Usage: \chref[name of the counter]{number}[alternate text]
% E.g. \chref{1.1}          will link to Definition/Theorem/Lemma 1.1,
%      \chref[section]{1.1} will link to section 1.1,
%      \chref{2.1}[II.1]    will link to DefinitionTheorem/Lemma 2.1, but display II.1

\newcommand{\tempeprinttype}{}

% url is automatically extracted (in this order):
% 1. from the "url" field in the .bib file;
% 2. if the "url" field is empty, from the arXiv number;
% 3. if no arXiv number is provided, the default url will be "Error" 
\newcommand\CurrentCitationURL{%
	\iffieldundef{url}%
	{\iffieldundef{eprint}%
		{}%
		{%
			\ifnum\pdfstrcmp{\thefield{eprinttype}}{arXiv}=0%
			https://arxiv.org/pdf/\thefield{eprint}.pdf%
			\else%
			Error%
			\fi%
		}%
	}%
	{\thefield{url}}%
}

% Since arXiv-Links may or may not in .pdf, we must check which one's the case.
\newcommand{\PDForNot}{}

% The name of the counter is automatically extracted (in this order):
% 1. from the first optional argument of \chref;
% 2. if no optional argument is provided, from the "file" field in the .bib file;
% 3. if the "file" field is empty, "theorem" will be used as a  default counter name
\NewDocumentCommand\chref{O{} m O{#2} }{\IfSubStr*{\CurrentCitationURL}{pdf}{\edef\PDForNot{1}}{\edef\PDForNot{0}}\href{\CurrentCitationURL\ifnum\PDForNot=1\#\fi\ifstrempty{#1}{\iffieldundef{file}{theorem}{\thefield{file}}}{#1}\ifnum\PDForNot=1.\fi#2}{#3}}

%  Automatic hyperlink to a specific page
\NewDocumentCommand\chpageref{O{#2} m}{\href{\CurrentCitationURL\#page=#2}{#1}}

