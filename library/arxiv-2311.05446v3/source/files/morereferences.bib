@article{Livshyts2021,
	abstract = {We show that for any log-concave measure $\mu$ on $\mathbb{R}^n$, any pair of symmetric convex sets $K$ and $L$, and any $\lambda\in [0,1],$ $$\mu((1-\lambda) K+\lambda L)^{c_n}\geq (1-\lambda) \mu(K)^{c_n}+\lambda\mu(L)^{c_n},$$ where $c_n\geq n^{-4-o(1)}.$ This constitutes progress towards the dimensional Brunn-Minkowski conjecture (see Gardner, Zvavitch \cite{GZ}, Colesanti, L, Marsiglietti \cite{CLM}). Moreover, our bound improves for various special classes of log-concave measures.},
	archiveprefix = {arXiv},
	arxivid = {2107.00095},
	author = {Livshyts, Galyna},
	eprint = {2107.00095},
	file = {:Users/liranrotem/Documents/Mendeley/Livshyts/Livshyts - 2021 - A universal bound in the dimensional Brunn-Minkowski inequality for log-concave measures.pdf:pdf},
	journal = {arxiv:2107.00095},
	keywords = {and phrases,brascamp-lieb inequality,brunn-,convex bodies,e inequality,ehrhard inequality,energy minimization,equality case characteriza-,gaussian measure,log-concave measures,minkowski inequality,poincar,symmetry,tion,torsional rigidity},
	month = {jun},
	title = {{A universal bound in the dimensional Brunn-Minkowski inequality for log-concave measures}},
	url = {http://arxiv.org/abs/2107.00095},
	year = {2021},
	bdsk-url-1 = {http://arxiv.org/abs/2107.00095}}

