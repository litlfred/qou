	abstract = {In this paper, we study the conjecture of Gardner and Zvavitch from [22], which suggests that the standard Gaussian measure $\gamma$ enjoys [Formula presented]-concavity with respect to the Minkowski addition of symmetric convex sets. We prove this fact up to a factor of 2: that is, we show that for symmetric convex K and L, and $\lambda$∈[0,1], [Formula presented] More generally, this inequality holds for convex sets containing the origin. Further, we show that under suitable dimension-free uniform bounds on the Hessian of the potential, the log-concavity of even measures can be strengthened to p-concavity, with p>0, with respect to the addition of symmetric convex sets.},
	author = {Kolesnikov, Alexander and Livshyts, Galyna},
	doi = {10.1016/j.aim.2021.107689},
	file = {:Users/liranrotem/Documents/Mendeley/Kolesnikov, Livshyts/Kolesnikov, Livshyts - 2021 - On the Gardner-Zvavitch conjecture Symmetry in inequalities of Brunn-Minkowski type.pdf:pdf},
	issn = {00018708},
	journal = {Adv. Math. (N. Y).},
	keywords = {Brascamp-Lieb inequality,Brunn-Minkowski inequality,Convex bodies,Gaussian measure,log-Minkowski problem,log-concave measures},
	month = {jun},
	pages = {107689},
	publisher = {Elsevier Inc.},
	title = {{On the Gardner-Zvavitch conjecture: Symmetry in inequalities of Brunn-Minkowski type}},
	url = {https://doi.org/10.1016/j.aim.2021.107689 https://linkinghub.elsevier.com/retrieve/pii/S0001870821001274},
	volume = {384},
	year = {2021},
	bdsk-url-1 = {https://doi.org/10.1016/j.aim.2021.107689%20https://linkinghub.elsevier.com/retrieve/pii/S0001870821001274},
	bdsk-url-2 = {https://doi.org/10.1016/j.aim.2021.107689}}

@article{Kolesnikov2022,
	abstract = {The L p L^p -Brunn--Minkowski theory for p ≥ 1 p\geq 1 , proposed by Firey and developed by Lutwak in the 90's, replaces the Minkowski addition of convex sets by its L p L^p counterpart, in which the support functions are added in L p L^p -norm. Recently, B{\"{o}}r{\"{o}}czky, Lutwak, Yang and Zhang have proposed to extend this theory further to encompass the range p ∈ [ 0 , 1 ) p \in [0,1) . In particular, they conjectured an L p L^p -Brunn--Minkowski inequality for origin-symmetric convex bodies in that range, which constitutes a strengthening of the classical Brunn-Minkowski inequality. Our main result confirms this conjecture locally for all (smooth) origin-symmetric convex bodies in R n \mathbb {R}^n and p ∈ [ 1 − c n 3 / 2 , 1 ) p \in [1 - \frac {c}{n^{3/2}},1) . In addition, we confirm the local log-Brunn--Minkowski conjecture (the case p = 0 p=0 ) for small-enough C 2 C^2 -perturbations of the unit-ball of ℓ q n \ell _q^n for q ≥ 2 q \geq 2 , when the dimension n n is sufficiently large, as well as for the cube, which we show is the conjectural extremal case. For unit-balls of ℓ q n \ell _q^n with q ∈ [ 1 , 2 ) q \in [1,2) , we confirm an analogous result for p = c ∈ ( 0 , 1 ) p=c \in (0,1) , a universal constant. It turns out that the local version of these conjectures is equivalent to a minimization problem for a spectral-gap parameter associated with a certain differential operator, introduced by Hilbert (under different normalization) in his proof of the Brunn--Minkowski inequality. As applications, we obtain local uniqueness results in the even L p L^p -Minkowski problem, as well as improved stability estimates in the Brunn--Minkowski and anisotropic isoperimetric inequalities.},
	archiveprefix = {arXiv},
	arxivid = {1711.01089},
	author = {Kolesnikov, Alexander and Milman, Emanuel},
	doi = {10.1090/memo/1360},
	eprint = {1711.01089},
	file = {:Users/liranrotem/Documents/Mendeley/Kolesnikov, Milman/Kolesnikov, Milman - 2022 - Local $Lp$-Brunn--Minkowski inequalities for $p1$(2).pdf:pdf},
	issn = {0065-9266},
	journal = {Mem. Am. Math. Soc.},
	keywords = {aleksandrov body,brunn,convex bodies,e inequality,hilbert,isoperi-,l p -brunn,local uniqueness in l,metric stability estimates,minkowski operator,minkowski theory,p -minkowski problem,poincar},
	month = {may},
	number = {1360},
	title = {{Local $L^p$-Brunn--Minkowski inequalities for $p<1$}},
	url = {https://www.ams.org/memo/1360/},
	volume = {277},
	year = {2022},
	bdsk-url-1 = {https://www.ams.org/memo/1360/},
	bdsk-url-2 = {https://doi.org/10.1090/memo/1360}}

