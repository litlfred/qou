          "intersectsDrawing": false,
          "fonts": [
            "Times-Italic",
            "Times-Roman",
            "rtxmi",
            "rtxr",
            "txsy"
          ],
          "sizes": [
            9.96
          ]
        },
        {
          "text": "interchanging x and y. Algebraically, it is thus enough to consider the case of even",
          "bbox": [
            151.8,
            128.57,
            477.06,
            141.86
          ],
          "intersectsDrawing": false,
          "fonts": [
            "Times-Italic",
            "Times-Roman"
          ],
          "sizes": [
            9.96
          ]
        },
        {
