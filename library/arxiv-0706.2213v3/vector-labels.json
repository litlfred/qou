          "fonts": [
            "Times-Roman"
          ],
          "sizes": [
            6.97
          ]
        },
        {
          "text": "J(2, n), n > 0, is represented by the continued fraction [n, −2] =",
          "bbox": [
            152.28,
            638.09,
            414.34,
            657.99
          ],
