@article{RISKA1970662,
	title = "Tensor force and exchange currents in the triton beta decay",
	journal = "Physics Letters B",
	volume = "32",
	number = "8",
	pages = "662 - 664",
	year = "1970",
	issn = "0370-2693",
	doi = "https://doi.org/10.1016/0370-2693(70)90437-5",
	url = "http://www.sciencedirect.com/science/article/pii/0370269370904375",
	author = "D.O. Riska and G.E. Brown",
	abstract = "We estimate the correction due to exchange currents to the one-body 3H → 3He β-decay amplitude, treating the D-state part of the wavefunction in a simple approximate way. We find the main effect to come from the S-D cross terms."
}

@article{RISKA1989207,
	title = "Exchange currents",
	journal = "Physics Reports",
	volume = "181",
	number = "4",
	pages = "207 - 268",
	year = "1989",
	issn = "0370-1573",
	doi = "https://doi.org/10.1016/0370-1573(89)90129-4",
	url = "http://www.sciencedirect.com/science/article/pii/0370157389901294",
	author = "Dan Olof Riska",
	abstract = "Recent developments in the theory of nuclear exchange current operators are reviewed. The relation between the nuclear interaction and the associated electromagnetic and weak exchange current operators is elaborated. The review is focused on those exchange current operators which appear as consequences of chiral symmetry and gauge invariance and for which there is clear experimental evidence. The exchange current operators are described as they appear both within the conventional meson exchange framework as well as within the compatible, but more fundamental, topological soliton model approach. The latter, which allows a coherent simultaneous treatment of both nucleons and nuclei, leads to many phenomenologically instructive connections between weak, electromagnetic and strong interaction operators. Finally the role of exchange current operators in relativistic treatments of the nuclear transition operators is reviewed."
}

