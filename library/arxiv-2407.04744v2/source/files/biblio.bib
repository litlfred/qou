	issn = "0370-2693",
	doi = "https://doi.org/10.1016/0370-2693(69)90290-1",
	url = "http://www.sciencedirect.com/science/article/pii/0370269369902901",
	author = "M. Chemtob and M. Rho",
	abstract = "We use the low-energy theorem for the axial current to obtain the part of the interaction current contribution to nuclear beta-decay coming from the ‘non-Born terms’. In triton beta-decay this turns out to be quite substantial, but is cancelled mostly by the part of the ‘Born term’ not included in the nuclear wave function. The effect of a repulsive core is also examined."
}

