@Article{Bonelli:2020dcp,
  author        = {Bonelli, Giulio and Del Monte, Fabrizio and Tanzini, Alessandro},
  title         = {{BPS quivers of five-dimensional SCFTs, Topological Strings and q-Painlev\textbackslash{}'e equations}},
  year          = {2020},
  month         = {7},
  archiveprefix = {arXiv},
  comment       = {* Background Consider 5d N=1 supersymmetric gauge theories on R4xS1, which are engineered by M-theory compactified on a non-compact Calabi-Yau threefold. The supersymmetric index of the gauge theory is identified with the topological string partition function. In the large volume region of the Calabi-Yau moduli space, the supersymmetric index can be given by the Nekrasov-Okounkov presentation. Around the conifold point, the supersymmetrix index can be given in terms of a matrix model. In the limit S1 shrinks, we recover a 4d N=2 supersymmetric gauge theory. The BPS states are encoded by quiver diagrams. Nodes in BPS quivers represent elementary BPS objects, and the full BPS spectrum can be recovered by quiver mutaitaon. Recently BPS quivers for 5d N=1 supersymmetry gauge theories on $R^4xS^1$ have been constructed. When the associated CY3 is toric, the quiver can be constructed easily using the corresponding dimer model. * Results Compared to 4d BPS quivers, 5d BPS quivers have extended automorphism group, which plays a very important role. For rank one 5d gauge theories, these automorphism groups are classified and they are connected by degeneration. 1) Show by rank one examples that in 5d N=1 the discrete flows induced by the extended automorphism group on the BPS quiver also generate in a simple way the full BPS spectrum. 2) Show how to reduce from 5d BPS quiver to 4d BPS quiver. This is done by removing two nodes which are invariant under certain symmetry flow. In mathematics this is described by denegeration of automorphism group. In physics, the two removed nodes correspond to monopoles and KK modes 3) The natural language to describe the extended automorphism group is the *cluster algebra*. The \tau variable is identified with supersymmetric index, and it is naturally valued on the symmetry lattice of the dynamic system. 4) The applicaiton of extended quiver symmetries on the relevant cluster algebra variable $\tau$ gives the q-difference equations and bilinear relations. 5) In the rank one cases, the q-difference equations are q-Painleve equations. Show explicitly that the Nekrasov-Okounkov dual partition function solves the q-Painleve equations associated to the dsicrete flows. 6) Derived bilinear relations for many rank one theories. The bilinear relation may be identified with blowup equations.},
  date-added    = {2021-01-12 14:00:52 +0100},
  date-modified = {2021-01-12 14:00:52 +0100},
  eprint        = {2007.11596},
  file          = {:Bonelli_2020dcp - 2007.11596 - _BPS quivers of five-dimensional SCFTs, Topological Strings and q-Painlev_textbackslash__'e equations_.pdf:PDF},
  keywords      = {D5, N=2, BPS-spectrum, cluster-algebra, BPS-quivers, Painleve-equations},
  primaryclass  = {hep-th},
}

