@Article{Bringmann:2016,
  author        = {Bringmann, Kathrin and Rolen, Larry and Zwegers, Sander},
  journal       = {Res. Math. Sci.},
  title         = {{On the Fourier coefficients of negative index meromorphic Jacobi forms}},
  year          = {2016},
  issn          = {2522-0144},
  month         = {1},
  pages         = {Paper No. 5, 9},
  volume        = {3},
  abstract      = {In this paper, we consider the Fourier coefficients of meromorphic Jacobi forms of negative index. This extends recent work of Creutzig and the first two authors for the special case of Kac-Wakimoto characters which occur naturally in Lie theory, and yields, as easy corollaries, many important PDEs arising in combinatorics such as the famous rank-crank PDE of Atkin and Garvan. Moreover, we discuss the relation of our results to partial theta functions and quantum modular forms as introducted by Zagier, which together with previous work on positive index meromorphic Jacobi forms illuminates the general structure of the Fourier coefficients of meromorphic Jacobi forms.},
  archiveprefix = {arXiv},
  bdsk-url-1    = {https://doi.org/10.1186/s40687-016-0056-y},
  comment       = {Meromorphic Jacobi forms with negative index, construction from polar parts},
  date          = {2015-01-19},
  eprint        = {1501.04476},
  eprintclass   = {math.NT},
  eprinttype    = {arXiv},
  file          = {:Bringmann_2015gla - 1501.04476 - _On the Fourier coefficients of negative index meromorphic Jacobi forms_.pdf:PDF},
  fjournal      = {Research in the Mathematical Sciences},
  keywords      = {modular forms, Jacobi-forms},
  mrclass       = {11F30 (11F50)},
  mrnumber      = {3498616},
  mrreviewer    = {Martin Westerholt-Raum},
  primaryclass  = {math.NT},
  url           = {https://doi.org/10.1186/s40687-016-0056-y},
}

@Article{Cheng:2016klu,
  author        = {Cheng, Miranda C. N. and Duncan, John F. R.},
  journal       = {Adv. Math.},
  title         = {{Optimal Mock Jacobi Theta Functions}},
  year          = {2020},
  pages         = {107284},
  volume        = {372},
  abstract      = {We classify the optimal mock Jacobi forms of weight one with rational coefficients. The space they span is thirty-four-dimensional, and admits a distinguished basis parameterized by genus zero groups of isometries of the hyperbolic plane. We show that their Fourier coefficients can be expressed explicitly in terms of singular moduli, and obtain positivity conditions which distinguish the optimal mock Jacobi forms that appear in umbral moonshine. We find that all of Ramanujan's mock theta functions can be expressed simply in terms of the optimal mock Jacobi forms with rational coefficients.},
  archiveprefix = {arXiv},
  date          = {2016-05-14},
  doi           = {10.1016/j.aim.2020.107284},
  eprint        = {1605.04480},
  eprintclass   = {math.NT},
  eprinttype    = {arXiv},
