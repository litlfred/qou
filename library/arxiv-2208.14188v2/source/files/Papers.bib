@Article{Cota:2020zse,
  author        = {Cota, Cesar Fierro and Klemm, Albrecht and Schimannek, Thorsten},
  title         = {{State counting on fibered CY-3 folds and the non-Abelian Weak Gravity Conjecture}},
  year          = {2020},
  month         = {12},
  archiveprefix = {arXiv},
  comment       = {F-theory compactified on a compact elliptic Calabi-Yau threefold which is in addition K3 fibered, is dual to Heterotic theory compactified on K3. The five-dimensional BPS spectrum with charges corresponding to curves in the K3 fiber can be checked against worlsheet supersymmetric indices of the Heterotic string in six or four dimensions. In six dimensions, the invariants are encoded in elliptic genus of Heterotic strings on K3, which is a lattice Jacobi form (Weyl invarint Jacobi forms belong to them). In fact, the base degree one topological string partition function Z_F, with F being the base of K3 fiber and a curve with F^2 = 0 in the elliptic base, is identical to the elliptic genus. Higher base degree partition function Z_{nF} can be obtained by Hecke trasnformation to Z_F. In four dimensions, the invariants are encoded in the New Supersymmetric Index, which is a vector valued modular form. This paper clarifies that both of them contain equivalent information, and they can be translated to each other by certain isomorphism between vector valued modular forms and lattice Jacobi forms. Furthermore, if M exhibits not elliptic but genus one fibration, with no section but a N-seciton, the Heterotic dual is on (K3xT^2)/Z_N, the CHL orbifolds. The New Supersymmetric Index contains not only information of elliptic genus but also twisted twined elliptic genera associated to the K3. The latter are encded in topological string partition function of higher base degree n=1,2, ... N, from which partition function for all base degreen can be constructed. Thirdly, the paper extends the refinement conjecture in compact CY3. Finally, something about proving a certain version of Weak Gravity Conjecture.},
  date-added    = {2021-01-04 17:47:21 +0100},
  date-modified = {2021-01-04 17:47:21 +0100},
  eprint        = {2012.09836},
  file          = {:Cota_2020zse - 2012.09836 - _State counting on fibered CY-3 folds and the non-Abelian Weak Gravity Conjecture_.pdf:PDF},
  primaryclass  = {hep-th},
  reportnumber  = {BONN-TH-2020-12, UWThPh 2020-30},
}

