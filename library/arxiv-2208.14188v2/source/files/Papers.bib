@Article{Kim:2020hhh,
  author        = {Kim, Hee-Cheol and Kim, Minsung and Kim, Sung-Soo and Lee, Ki-Hong},
  title         = {{Bootstrapping BPS spectra of 5d/6d field theories}},
  year          = {2020},
  month         = {12},
  abstract      = {We propose a systematic approach to computing the BPS spectra of any 5d/6d supersymmetric quantum field theory in Coulomb phases, which admits either gauge theory descriptions or geometric descriptions, based on the Nakajima-Yoshioka's blowup equations. We provide a significant generalization of the blowup equation approach in terms of both properly quantized magnetic fluxes on the blowup $\hat{\mathbb{C}}^2$ and the effective prepotential for 5d/6d field theories on the Omega background which is uniquely determined by the Chern-Simons couplings on their Coulomb branches. We employ our method to compute BPS spectra of all rank-1 and rank-2 5d Kaluza-Klein (KK) theories descending from 6d $\mathcal{N}=(1,0)$ superconformal field theories (SCFTs) compactified on a circle with/without twist. We also discuss various 5d SCFTs and KK theories of higher ranks, which include a few exotic cases such as new rank-1 and rank-2 5d SCFTs engineered with frozen singularity as well as the 5d $SU(3)_8$ gauge theory currently having neither a brane web nor a smooth shrinkable geometric description. The results serve as non-trivial checks for a large class of non-trivial dualities among 5d theories and also as independent evidences for the existence of certain exotic theories.},
  archiveprefix = {arXiv},
  comment       = {Note that there exist some 5d/6d gauge theories, for instance the 5d SU(3)_8 gauge theory, which currently have neither ADHM, nor shrinkable geometric description, nor associated 5-brane webs, so that all the current computational methods, including the geometric blowup equations, cannot be used to compute their BPS partition functions. The main aim of this paper is to devise a complete blowup equation formalism that enables one to compute BPS spectra of all supersymmetric field theories having UV completion in five or six dimensions, including quiver gauge theories, twisted circle compactification of 6d theories, and also the extension of geometric blowup based on novel geometric construction of 5d SCFTs/KK theories. The main input is the effective prepotential of a given 5d/6d SQFT evaluated on the Omega-background, as well as consistent magnetic flux. The former includes the usual cubic prepotential, the mixed gauge/gravitational, and the mixed gauge/su(2)_R Chern-Simons levels. The latter is defined so that the solved BPS states support a Coulomb branch. The method of solution is to plug in Gaparkuma-Vafa expression and to expand in terms of exponentiated Kahler moduli. The factor Lambda is fixed along the way. The blowup equations here are justified by the existence of 5d gauge theories. In addition, the focus of the paper is solving partition function from *some* blowup equations. They do not care about exhausting all blowup equations. Furthermore, they do not prove the solvability.},
  date          = {2020-12-31},
  date-added    = {2021-01-05 18:10:18 +0100},
  date-modified = {2021-01-05 18:10:18 +0100},
  eprint        = {2101.00023},
  eprintclass   = {hep-th},
  eprinttype    = {arXiv},
  file          = {:Kim_2020hhh - 2101.00023 - _Bootstrapping BPS spectra of 5d_6d field theories_.pdf:PDF},
  keywords      = {blowup-equations, 5d-SCFTs},
  primaryclass  = {hep-th},
}

