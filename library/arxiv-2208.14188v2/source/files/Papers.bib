  doi           = {10.1007/s00220-014-2238-z},
  eprint        = {1401.5095},
  eprintclass   = {hep-th},
  eprinttype    = {arXiv},
  file          = {:Gu_2014yba - 1401.5095 - _Knot Invariants from Topological Recursion on Augmentation Varieties_ (original).pdf:PDF;:Gu_2014yba - 1401.5095 - _Knot Invariants from Topological Recursion on Augmentation Varieties_ (published).pdf:PDF},
  keywords      = {hep-th, math.GT},
  owner         = {Jie Gu},
  primaryclass  = {hep-th},
  reportnumber  = {BONN-TH-2014-03, BRXTH-674},
  scie          = {10},
