@Article{Closset:2019juk,
  author        = {Closset, Cyril and Del Zotto, Michele},
  title         = {{On 5d SCFTs and their BPS quivers. Part I: B-branes and brane tilings}},
  year          = {2019},
  month         = {12},
  archiveprefix = {arXiv},
  comment       = {This paper studies the BPS spectrum of 5d SCFTs compactified on a circle. The authors identify the BPS category of such the 5d theory on a circle with the derived category of coherent sheaves on a resolution of X. It follows that the BPS spectrum can be studied in terms of 5d BPS quivers. They also study the interplay between 4d and 5d BPS quivers in detail. They in particular focus on examples where X is a toric singularity, in which case the BPS quiver is given in terms of a brane tiling. They present a conjecture about the structure of the BPS spectra of a wide class of models. They also argue that 5d UV dualities can be realised in terms of mutation sequences on the BPS quivers, which are interpreted as autoequivalences of the BPS category.},
  date-added    = {2020-12-07 22:38:54 +0100},
