  doi           = {10.1007/s00220-015-2322-z},
  eprint        = {1407.5643},
  eprintclass   = {hep-th},
  eprinttype    = {arXiv},
  file          = {:Gu_2014nva - 1407.5643 - _A note on colored HOMFLY polynomials for hyperbolic knots from WZW models_ (original).pdf:PDF;:Gu_2014nva - 1407.5643 - _A note on colored HOMFLY polynomials for hyperbolic knots from WZW models_ (published).pdf:PDF},
  journaltitle  = {Commun.Math.Phys. 338 (2015) 393-456},
  keywords      = {hep-th, math.GT},
