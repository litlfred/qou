@article{Zakany:2017txl,
	archiveprefix = {arXiv},
	author = {Zakany, Szabolcs},
	comment = {Construction of wavefunction when hbar/2\pi is rational. Every operator O has a dual operator Otilde following the modular duality. Being simultaneous eigenfunction of O and Otilde fixes the ambiguity of wavefunction. The unique wavefunction is constructed by completing the WKB wavefunction by its modular dual The WKB wavefunction can be resummed over \hbar in large X series. The resummed wavefunction has poles when hbar is real. The poles are cancelled when the modular dual is completed. The complete wave function is resummed over 1/X when hbar is rational (since there is a finite set of difference equations).},
