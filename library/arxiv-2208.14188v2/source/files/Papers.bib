@Article{Gu:2015pda,
  author        = {Gu, Jie and Klemm, Albrecht and Marino, Marcos and Reuter, Jonas},
  journal       = {JHEP},
  title         = {{Exact solutions to quantum spectral curves by topological string theory}},
  year          = {2015},
  pages         = {025},
  volume        = {10},
  abstract      = {We generalize the conjectured connection between quantum spectral problems and topological strings to many local almost del Pezzo surfaces with arbitrary mass parameters. The conjecture uses perturbative information of the topological string in the unrefined and the Nekrasov-Shatashvili limit to solve non-perturbatively the quantum spectral problem. We consider the quantum spectral curves for the local almost del Pezzo surfaces of $\mathbb{F}_2$, $\mathbb{F}_1$, the blowup of $\mathbb{P}^2$ in two points and a mass deformation of the $E_8$ del Pezzo corresponding to different deformations of the three-term operators $\mathsf{O}_{1,1}$, $\mathsf{O}_{1,2}$ and $\mathsf{O}_{2,3}$. To check the conjecture, we compare the predictions for the spectrum of these operators with numerical results for the eigenvalues. We also compute the first few fermionic spectral traces from the conjectural spectral determinant, and we compare them to analytic and numerical results in spectral theory. In all these comparisons, we find that the conjecture is fully validated with high numerical precision. For local $\mathbb{F}_2$ we expand the spectral determinant around the orbifold point and find intriguing relations for Jacobi theta functions. We also give an explicit map between the geometries of $\mathbb{F}_0$ and $\mathbb{F}_2$ as well as a systematic way to derive the operators $\mathsf{O}_{m,n}$ from toric geometries.},
  archiveprefix = {arXiv},
  bdsk-url-1    = {https://doi.org/10.1007/JHEP10(2015)025},
  date          = {2015-06-30},
  date-added    = {2019-12-11 17:42:48 +0100},
  date-modified = {2019-12-11 17:42:48 +0100},
  doi           = {10.1007/JHEP10(2015)025},
  eprint        = {1506.09176},
  eprintclass   = {hep-th},
  eprinttype    = {arXiv},
  file          = {:Gu_2015pda - 1506.09176 - _Exact solutions to quantum spectral curves by topological string theory_ (original).pdf:PDF;:Gu_2015pda - 1506.09176 - _Exact solutions to quantum spectral curves by topological string theory_ (published).pdf:PDF},
  keywords      = {hep-th},
  owner         = {Jie Gu},
  primaryclass  = {hep-th},
  reportnumber  = {BONN-TH-2015-09},
  scie          = {31},
  scieother     = {18},
