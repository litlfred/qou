          ]
        },
        {
          "text": "2.1. Artin’s Presentation",
          "bbox": [
            151.51,
            179.02,
            277.33,
            188.98
          ],
          "intersectsDrawing": false,
          "fonts": [
            "CMBX10"
          ],
          "sizes": [
            9.96
          ]
        },
        {
          "text": "We denote by D2 the unit disk in the complex plane and ﬁx n marked points",
          "bbox": [
            151.51,
            201.06,
            488.88,
            212.52
          ],
          "intersectsDrawing": false,
          "fonts": [
            "CMMI10",
            "CMR10",
            "CMR7"
          ],
          "sizes": [
            6.97,
            9.96
          ]
        },
        {
          "text": "−1 < p1 < p2 < · · · < pn < 1 ∈D2 ∩R.",
          "bbox": [
            236.05,
            221.51,
            407.13,
            235.14
          ],
          "intersectsDrawing": false,
          "fonts": [
            "CMMI10",
