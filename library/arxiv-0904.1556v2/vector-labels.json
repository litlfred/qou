            "CMR7",
            "CMSY10",
            "EUFM10",
            "MSBM10"
          ],
          "sizes": [
            6.97,
            9.96
          ]
        },
        {
          "text": "So, the interaction between pions and nucleons arises naturally from the action of",
          "bbox": [
            126.0,
            164.85,
            486.04,
            174.81
          ],
          "intersectsDrawing": false,
          "fonts": [
            "CMR10"
          ],
          "sizes": [
