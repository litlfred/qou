{
  "image": "ghcr.io/litlfred/qou/paper-assistant",
  "transport": "streamable-http",
  "mcp_internal_port": 8080,
  "viewer_port": 8080,
  "self_update_interval_seconds": 60,
  "healthcheck_path": "/mcp",
  "folio": {
    "domain": "folio.litlfred.org",
    "viewer_dir": "folio-assistant/cat-harness/viewer",
    "clear_cache_on_update": true
  },
  "auth": {
    "google": {
      "whitelist": "deploy/google-viewers.txt",
      "role": "viewer"
    },
    "github": {
      "whitelist": "deploy/github-collaborators.txt",
      "role": "collaborator"
    },
    "owner": "litlfred",
    "session_max_age_hours": 24
  },
  "llm": {
    "provider": "anthropic",
    "providers": {
      "anthropic": {
        "model": "claude-sonnet-4-6",
        "api_base": "https://api.anthropic.com",
        "env_key": "ANTHROPIC_API_KEY"
      },
      "openai": {
        "model": "gpt-4o",
        "api_base": "https://api.openai.com/v1",
        "env_key": "OPENAI_API_KEY"
      },
      "local": {
        "model": "llama3",
        "api_base": "http://localhost:11434/v1",
        "env_key": ""
      }
    }
  },
  "lean": {
    "local_mathlib_path": "../mathlib4",
    "mathlib_git_url": "https://github.com/leanprover-community/mathlib4"
  },
  "hetzner": {
    "server_type": "cx23",
    "location": "nbg1",
    "image": "ubuntu-24.04"
  }
}
