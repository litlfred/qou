{
  "name": "qou-content",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run check-witnesses && bun run render-atlas:write && bun run pipeline/build.ts",
    "check-witnesses": "cd .. && python3 computations/witness_staleness_tracker.py check || (echo '[build] NOTE: stale witnesses detected — see computations/witness-shas.json'; true)",
    "render-atlas": "cd .. && python3 computations/recursive_atom_knot_atlas_render.py 2>/dev/null || (echo '[build] NOTE: atlas render skipped (recursive_atom_knot_atlas_render.py moved to _deprecated/ in 191bd9f54; committed recursive-atom-knot-atlas.rendered.md remains the source of truth)' && true)",
    "render-atlas:write": "cd .. && (python3 computations/recursive_atom_knot_atlas_render.py > computations/recursive-atom-knot-atlas.rendered.md 2>/dev/null || echo '[build] NOTE: atlas render-write skipped (script in _deprecated/); using committed rendered file')",
    "validate": "bun run pipeline/validate.ts",
    "render": "bun run pipeline/render-latex.ts",
    "export-json": "bun run pipeline/export-json.ts",
    "render-tex": "bun run ../scripts/render-tex/render-tex-blocks.ts",
    "export-bibtex": "bun run pipeline/export-bibtex.ts",
    "validate-refs": "bun run pipeline/validate-references.ts",
    "validate-bib": "bun run pipeline/validate-bib.ts",
    "latex-preflight": "bun run pipeline/latex-preflight.ts ../main.tex",
    "latex-preflight:seed": "bun run pipeline/latex-preflight.ts --seed ../main.tex",
    "audit-tex-source": "bun run pipeline/audit-tex-source.ts",
    "audit-tex-source:strict": "bun run pipeline/audit-tex-source.ts --strict",
    "bib-qa": "bun run pipeline/bib-qa.ts",
    "bib-qa:ci": "bun run pipeline/bib-qa.ts --ci",
    "generate-index": "bun run pipeline/generate-index.ts",
    "migrate-lean-refs": "bun run pipeline/migrate-lean-refs.ts --write",
    "migrate-lean-refs:dry": "bun run pipeline/migrate-lean-refs.ts",
    "audit-wiring": "bun run pipeline/audit-wiring.ts",
    "audit-wiring:strict": "bun run pipeline/audit-wiring.ts --strict",
    "qa-sweep": "bun run pipeline/qa-sweep.ts",
    "qa-sweep:ci": "bun run pipeline/qa-sweep.ts quantum-observable-universe --ci",
    "qa-staleness": "bun run pipeline/qa-staleness.ts",
    "qa-staleness:ci": "bun run pipeline/qa-staleness.ts quantum-observable-universe --ci"
  },
  "dependencies": {
    "@unified-latex/unified-latex-util-arguments": "^1.8.0",
    "@unified-latex/unified-latex-util-match": "^1.8.0",
    "@unified-latex/unified-latex-util-parse": "^1.8.0",
    "@unified-latex/unified-latex-util-print-raw": "^1.8.0",
    "@unified-latex/unified-latex-util-visit": "^1.8.0",
    "biblatex-csl-converter": "^3.5.5",
    "csl-json": "^0.1.0",
    "glob": "^11.0.0",
    "remark": "^15.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "tsx": "^4.21.0",
    "unist-util-visit": "^5.1.0",
    "unist-util-visit-parents": "^6.0.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "bun": "^1.3.13",
    "bun-types": "latest",
    "typescript": "^5.9.3"
  }
}
