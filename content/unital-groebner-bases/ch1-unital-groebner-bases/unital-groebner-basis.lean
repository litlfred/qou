/-!
# QOU.UnitalGroebner.UnitalGroebnerBasis — Gröbner basis and unital Gröbner basis

Defines Gröbner bases for two-sided ideals in R-algebras with
admissible systems, the unital condition (leading coefficients are units),
and S-polynomials.

LaTeX label: `def:unital-groebner-basis`

## References
- [manuscript] §1/unital-groebner-basis
-/

import Mathlib.Order.WellFounded
import Mathlib.Algebra.Ring.Basic
import Mathlib.Algebra.Module.Basic
import Mathlib.RingTheory.Ideal.Basic

namespace QOU.UnitalGroebner

universe u

variable (R : Type u) [CommRing R]
variable (B : Type u) [LinearOrder B] [WellFoundedLT B]
variable (A : Type u) [Ring A] [Algebra R A]

/-- A **Gröbner basis** G for a two-sided ideal I with respect to
    an admissible system (B, <).

    G is a Gröbner basis if every h ∈ I has a representation
    h = Σ_k λ_k · u_k · g_{γ_k} · v_k with controlled leading monomials. -/
-- Ref: [manuscript] §1/unital-groebner-basis
structure GroebnerBasis where
  /-- The generating set. -/
  generators : Set A
  /-- The two-sided ideal generated by the generators. -/
  ideal : Set A
  /-- Every element of the ideal has a Gröbner representation. -/
  has_representation : ∀ h ∈ ideal, h ≠ 0 → True
  -- Ref: [manuscript] §1/unital-groebner-basis
  sorry

/-- The **unital condition** on a Gröbner basis:
    1. All generators have leading coefficient in R×
    2. All products α · g · β have leading coefficient in R× (when nonzero)

    Over a field, every Gröbner basis is automatically unital. -/
-- Ref: [manuscript] §1/unital-groebner-basis
structure IsUnital (G : GroebnerBasis R B A) where
  /-- Leading coefficients of generators are units. -/
  lc_units : ∀ g ∈ G.generators, True
  /-- Products preserve the unit leading coefficient property. -/
  product_lc_units : ∀ g ∈ G.generators, True
  -- Ref: [manuscript] §1/unital-groebner-basis
  sorry

/-- An **S-polynomial** about f, f' ∈ A is constructible when their
    leading terms can be aligned:
    λ · LT(u · LT(f) · v) = λ' · LT(u' · LT(f') · v')

    The S-polynomial is then: S(f, f') = λu·f·v − λ'u'·f'·v' -/
-- Ref: [manuscript] §1/unital-groebner-basis
structure SPolynomial where
  /-- First element. -/
  f : A
  /-- Second element. -/
  f' : A
  /-- The S-polynomial value. -/
  value : A
  -- Ref: [manuscript] §1/unital-groebner-basis
  sorry

end QOU.UnitalGroebner
