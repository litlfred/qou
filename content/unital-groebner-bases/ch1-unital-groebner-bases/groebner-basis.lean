/-!
# Fred2005.GroebnerBasis

Gröbner basis, unital condition, and S-polynomials for a
noncommutative R-algebra with admissible system.

A Gröbner basis G for a two-sided ideal I is a generating set such
that every element of I has a standard representation with controlled
leading monomials. A unital Gröbner basis additionally requires all
leading coefficients to be units of R.

Reference: Frédéric (2005), "Unital Gröbner bases for noncommutative
algebras", following Leitner–Pawłoski (2004).

LaTeX label: `def:groebner-basis`
-/

import Mathlib.Data.Real.Basic
import Mathlib.Order.WellFounded

namespace Fred2005

universe u v

/-- A **Gröbner basis** for a two-sided ideal I in a noncommutative
    R-algebra A with admissible system (B, <).

    G = {g_γ | γ ∈ Γ} is a Gröbner basis if every h ∈ I has a
    representation h = Σ λ_k · u_k · g_{γ_k} · v_k with
    LM(u_k · g_{γ_k} · v_k) ≤ LM(h).

    LaTeX: `\label{def:groebner-basis}`
    -- Ref: [leitnerpawloski2004] https://arxiv.org/abs/math/0409565 -/
structure GroebnerBasis (R : Type u) (A : Type v) [CommRing R] [Ring A]
    [Algebra R A] where
  /-- Index set for the Gröbner basis generators. -/
  Γ : Type*
  /-- The basis generators g_γ. -/
  gen : Γ → A
  /-- The set of basis monomials. -/
  basis : Set A
  /-- Leading monomial function. -/
  leadingMonomial : A → A
  /-- Leading coefficient function. -/
  leadingCoefficient : A → R
  /-- Leading term function. -/
  leadingTerm : A → A
  /-- Well-ordering on basis elements. -/
  basisOrder : A → A → Prop
  /-- The two-sided ideal generated by G. -/
  ideal : Set A
  /-- Standard representation property: every h ∈ I has a
      representation with controlled leading monomials. -/
  standard_rep : ∀ h ∈ ideal, ∃ (K : Finset (Γ × A × A × R)),
    h = K.sum (fun ⟨γ, u, v, λ'⟩ => λ' • (u * gen γ * v)) := by
    -- Ref: [leitnerpawloski2004] https://arxiv.org/abs/math/0409565
    sorry

/-- The **unital condition** on a Gröbner basis: all leading
    coefficients of generators (and their two-sided multiples by
    basis elements) are units of R.

    -- Ref: [leitnerpawloski2004] https://arxiv.org/abs/math/0409565 -/
def GroebnerBasis.isUnital {R : Type u} {A : Type v} [CommRing R] [Ring A]
    [Algebra R A] (G : GroebnerBasis R A) : Prop :=
  (∀ γ : G.Γ, IsUnit (G.leadingCoefficient (G.gen γ))) ∧
  (∀ γ : G.Γ, ∀ α β ∈ G.basis,
    α * G.gen γ * β ≠ 0 →
    IsUnit (G.leadingCoefficient (α * G.gen γ * β)))

/-- The **S-polynomial** of two elements f, f' ∈ A. An S-polynomial
    is constructible when there exist u, u', v, v' ∈ B and
    λ, λ' ∈ R* such that λ·LT(u·LT(f)·v) = λ'·LT(u'·LT(f')·v').

    -- Ref: [leitnerpawloski2004] https://arxiv.org/abs/math/0409565 -/
structure SPolynomial (R : Type u) (A : Type v) [CommRing R] [Ring A]
    [Algebra R A] where
  /-- First element. -/
  f : A
  /-- Second element. -/
  f' : A
  /-- Left multiplier for f. -/
  u : A
  /-- Right multiplier for f. -/
  v : A
  /-- Left multiplier for f'. -/
  u' : A
  /-- Right multiplier for f'. -/
  v' : A
  /-- Scalar for f side. -/
  λ_ : R
  /-- Scalar for f' side. -/
  λ'_ : R
  /-- The S-polynomial value: λ·u·f·v − λ'·u'·f'·v'. -/
  val : A := λ_ • (u * f * v) - λ'_ • (u' * f' * v')

end Fred2005
