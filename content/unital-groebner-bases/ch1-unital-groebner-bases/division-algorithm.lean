/-!
# Fred2005.DivisionAlgorithm

The division algorithm for a noncommutative R-algebra with admissible
system: given f ∈ A and a subset I ⊆ A, produce a remainder r ∈ O(I)
and an element f̃ ∈ ⟨I⟩ such that f = r + f̃.

Reference: Frédéric (2005), "Unital Gröbner bases for noncommutative
algebras", following Leitner–Pawłoski (2004).

LaTeX label: `def:division-algorithm`
-/

import Mathlib.Data.Real.Basic
import Mathlib.Order.WellFounded

namespace Fred2005

universe u v

/-- The **division algorithm** for a noncommutative R-algebra A with
    admissible system (B, <). Given an element f ∈ A and a subset
    I ⊆ A, the algorithm produces a decomposition f = r + f̃ where
    r is a remainder in O(I) and f̃ lies in the two-sided ideal
    generated by I.

    The output is not in general unique because the algorithm does
    not specify how to choose h_i, u_i, v_i at each step.

    LaTeX: `\label{def:division-algorithm}`
    -- Ref: [leitnerpawloski2004] https://arxiv.org/abs/math/0409565 -/
structure DivisionAlgorithm (R : Type u) (A : Type v) [CommRing R] [Ring A]
    [Algebra R A] where
  /-- The set of basis monomials. -/
  basis : Set A
  /-- Leading term function. -/
  leadingTerm : A → A
  /-- Well-ordering on basis elements. -/
  basisOrder : A → A → Prop
  /-- The subset I ⊆ A to divide by. -/
  I : Set A
  /-- The remainder function: maps f to its remainder r ∈ O(I). -/
  remainder : A → A
  /-- The quotient part: maps f to f̃ ∈ ⟨I⟩. -/
  quotientPart : A → A
  /-- Decomposition: f = remainder(f) + quotientPart(f). -/
  decomposition : ∀ f : A,
    f = remainder f + quotientPart f := by
    -- Ref: [leitnerpawloski2004] https://arxiv.org/abs/math/0409565
    sorry
  /-- Termination: the algorithm terminates because the well-ordering
      on B is well-founded and leading monomials strictly decrease. -/
  termination : WellFounded basisOrder := by
    -- Ref: [leitnerpawloski2004] https://arxiv.org/abs/math/0409565
    sorry

end Fred2005
