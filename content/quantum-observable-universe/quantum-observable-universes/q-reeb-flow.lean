/-!
# QOU.QReebFlow

Extracted from content/quantum-observable-universe/lean/ for content-block co-location.
Source: content/quantum-observable-universe/lean/QOU/QReebFlow.lean (monolithic)

**Ground ring**: `R_q = ℤ[q, q⁻¹]` (Laurent polynomials over ℤ).
Part of the formal proof chain. The parameter `q` is the canonical
indeterminate of `R_q`. Specialise via `ι : R_q → ℝ, q ↦ q₀` for
numerical evaluation.
-/

open scoped CategoryTheory CategoryTheory.MonoidalCategory

namespace QOU

noncomputable section

/-- Ground ring `R_q = ℤ[q, q⁻¹]` (Laurent polynomials over ℤ).
    See `QOU.Archimedean.GroundRing` for the compiled definition. -/
abbrev R_q := LaurentPolynomial ℤ
def q_param : R_q := LaurentPolynomial.T 1
def q_inv_param : R_q := LaurentPolynomial.T (-1)

universe u v

/-- **q-Deformed Reeb flow**: the one-parameter family of diffeomorphisms
    `φ^q_t : M → M` generated by `ξ_q`, with `φ^q_0 = id_M`.

    **Flow time is `ℝ`, not `R_q`** (bean `qou-u87j`, 2026-08-23). This field
    read `flow : R_q → M → M` and disagreed with the library
    `QOU.QReebFlow` (`lean/QOU/QuantumObservableUniverse/Particles.lean:93`),
    which has always had `ℝ`. The block settles it: `q-reeb-flow.md` opens
    *"In the **archimedean realisation**, the q-deformed Reeb vector field
    `ξ_q` generates a one-parameter family of diffeomorphisms"* and writes the
    generator as the ODE `d/dt φ_t^q = ξ_q ∘ φ_t^q` — real time. The `q` in
    `φ^q_t` deforms the **vector field**, not the time parameter.

    LaTeX: `\label{def:q-reeb-flow}` -/
structure QReebFlow (M : Type*) where
  /-- The flow map at time `t : ℝ`. -/
  flow : ℝ → M → M
  /-- Initial condition: `φ^q_0 = id`. -/
  flow_zero : ∀ (p : M), flow 0 p = p

end

end QOU
