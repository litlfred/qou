import Mathlib.Data.Real.Basic
import Mathlib.Analysis.SpecialFunctions.Pow.Real


/-!
# QOU.Archimedean.shell_structure_eigenvalues

Orbital shells from eigenvalues of the photon-electron transfer matrix.

Shell n = n-th power of T_{γe}. The traced volumes satisfy the
Chebyshev recurrence:
  V̂(n+1) = (q - q⁻¹) · V̂(n) + V̂(n-1)

The eigenvalues λ± = ½[(q-q⁻¹) ± √((q-q⁻¹)²+4)] determine
all shell energies. The Rydberg formula E_n ∝ 1/n² emerges from
λ₊ ≈ 1 + ε at q = 1.1097.

LaTeX label: `prop:shell-structure-eigenvalues`

## References
- [manuscript] §6/shell-structure-eigenvalues

**Ground ring**: `ℝ` (geometric/analytic realisation).
Uses ℝ-specific analysis (trig, norms, real powers).
NOT part of the formal proof chain.
See `GroundRingAnnotations.lean`.
-/

namespace QOU.Archimedean

/-- The Hecke coefficient h = q - q⁻¹. -/
-- Ref: [manuscript] §6/shell-structure-eigenvalues
noncomputable def hecke (q : ℝ) : ℝ := q - 1 / q

/-- The eigenvalues of T_{γe}: λ± = ½[h ± √(h² + 4)]. -/
-- Ref: [manuscript] §6/shell-structure-eigenvalues
noncomputable def eigenvalue_plus (q : ℝ) : ℝ :=
  (hecke q + Real.sqrt (hecke q ^ 2 + 4)) / 2

noncomputable def eigenvalue_minus (q : ℝ) : ℝ :=
  (hecke q - Real.sqrt (hecke q ^ 2 + 4)) / 2

/-- The discriminant h² + 4 is always positive. -/
-- Ref: [manuscript] §6/shell-structure-eigenvalues
theorem discriminant_pos (q : ℝ) : 0 < hecke q ^ 2 + 4 := by
  positivity

/-- λ₊ · λ₋ = det(T_{γe}) = -1. -/
-- Ref: [manuscript] §6/shell-structure-eigenvalues
theorem eigenvalue_product (q : ℝ) :
    eigenvalue_plus q * eigenvalue_minus q = -1 := by
  unfold eigenvalue_plus eigenvalue_minus hecke
  have h := Real.sq_sqrt (le_of_lt (discriminant_pos q))
  nlinarith [h]

/-- λ₊ + λ₋ = tr(T_{γe}) = q - q⁻¹. -/
-- Ref: [manuscript] §6/shell-structure-eigenvalues
theorem eigenvalue_sum (q : ℝ) :
    eigenvalue_plus q + eigenvalue_minus q = hecke q := by
  unfold eigenvalue_plus eigenvalue_minus
  ring

/-- λ₊ > 1 for q > 1. -/
-- Ref: [manuscript] §6/shell-structure-eigenvalues
theorem eigenvalue_plus_gt_one {q : ℝ} (hq : 1 < q) :
    1 < eigenvalue_plus q := by
  unfold eigenvalue_plus hecke
  rw [lt_div_iff (two_pos)]
  -- Need: 2 < (q - 1/q) + sqrt((q - 1/q)^2 + 4)
  -- Equivalently: sqrt((q-1/q)^2 + 4) > 2 - (q - 1/q)
  have hq0 : (0 : ℝ) < q := by linarith
  have hh : 0 < q - 1 / q := by rw [sub_pos, div_lt_one hq0]; nlinarith
  -- Since h > 0, it suffices to show sqrt(h^2+4) > 2 - h.
  -- Case: if h ≥ 2, then 2 - h ≤ 0 < sqrt(...), and h + sqrt(...) > 2.
  -- Case: if h < 2, then square both sides.
  have hdisc : (0 : ℝ) < (q - 1 / q) ^ 2 + 4 := by positivity
  have hsqrt_pos : 0 < Real.sqrt ((q - 1 / q) ^ 2 + 4) := Real.sqrt_pos.mpr hdisc
  nlinarith [Real.sq_sqrt (le_of_lt hdisc), sq_nonneg (q - 1/q), sq_nonneg (Real.sqrt ((q - 1/q)^2 + 4) - (2 - (q - 1/q)))]

/-- The Chebyshev recurrence for traced volumes.
    V̂(n+1) = (q - q⁻¹) · V̂(n) + V̂(n-1)

    This is the three-term recurrence generated by the
    characteristic polynomial λ² - (q-q⁻¹)λ - 1 = 0. -/
-- Ref: [manuscript] §6/shell-structure-eigenvalues
noncomputable def shellVolume (q : ℝ) : ℕ → ℝ
  | 0 => 1
  | 1 => hecke q / (q ^ (1/2 : ℝ) + q ^ (-(1/2 : ℝ))) + 1
  | n + 2 => hecke q * shellVolume q (n + 1) + shellVolume q n

/-- Shell 0 is the ground state: V̂(0) = 1. -/
-- Ref: [manuscript] §6/shell-structure-eigenvalues
theorem shell_zero (q : ℝ) : shellVolume q 0 = 1 := rfl

/-- The Chebyshev recurrence holds by construction. -/
-- Ref: [manuscript] §6/shell-structure-eigenvalues
theorem chebyshev_recurrence (q : ℝ) (n : ℕ) :
    shellVolume q (n + 2) = hecke q * shellVolume q (n + 1) + shellVolume q n := rfl

/-- Transition energy between adjacent shells:
    ΔE(n→n+1) = V̂(n+1) - V̂(n) = (h - 1)·V̂(n) + V̂(n-1)
    where h = q - q⁻¹. -/
-- Ref: [manuscript] §6/shell-structure-eigenvalues
noncomputable def transitionEnergy (q : ℝ) (n : ℕ) : ℝ :=
  shellVolume q (n + 1) - shellVolume q n

/-- Sub-shell capacity: 2(2ℓ+1) for angular momentum ℓ. -/
-- Ref: [manuscript] §6/shell-structure-eigenvalues
def subshellCapacity (ell : ℕ) : ℕ := 2 * (2 * ell + 1)

/-- Shell capacity: Σ_{ℓ=0}^{n-1} 2(2ℓ+1) = 2n². -/
-- Ref: [manuscript] §6/shell-structure-eigenvalues
theorem shell_capacity (n : ℕ) :
    (Finset.range n).sum subshellCapacity = 2 * n ^ 2 := by
  induction n with
  | zero => simp
  | succ k ih =>
    rw [Finset.sum_range_succ, ih]
    unfold subshellCapacity
    ring

/-- At q = 1, the Hecke coefficient vanishes: h = 0.
    The recurrence degenerates: V̂(n+1) = V̂(n-1) (period 2).
    No shell structure in the classical limit. -/
-- Ref: [manuscript] §6/shell-structure-eigenvalues
theorem hecke_classical : hecke 1 = 0 := by
  unfold hecke; norm_num

end QOU.Archimedean


