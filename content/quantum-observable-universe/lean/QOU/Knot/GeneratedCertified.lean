/-
  Machine-generated `SatisfiesEdgeEquations` certifications.  Beans `qou-glhi`, `qou-fr7j`.

  Generated by `scripts/gen-gluing-lean.py` from the template validated by hand in
  `QOU/Knot/SixOneCertified.lean`.  Each manifold's generated cleared identities
  (`QOU/Knot/GeneratedGluing.lean`) are assembled into a `ShapedTriangulation` together
  with its SnapPy exponent matrix, so the identities **certify a structure** rather than
  standing alone.

  ═══ ALL 19 MANIFOLDS, INCLUDING n = 9 — THE OLD CEILING WAS NOT REAL ═══

  This module previously covered **16** of the 19, refusing the two 9-tetrahedron
  manifolds (`9_35`, `o9_00000`) with

      -- 9_35: 9 tetrahedra — no `Fin.prod_univ_9` in Mathlib, so the certification
      -- template does not apply.  Needs iterated `Fin.prod_univ_succ`.

  That is true about Mathlib and false about the difficulty.  `simp` iterates
  `Fin.prod_univ_succ` unaided, so

      simp [Fin.prod_univ_succ, triangulation, gluing]

  unfolds the product at **any** `n`.  `9_35` certified in 95 s, sorry-free on standard
  axioms, first try — none of the `Matrix`-index traps that cost this generator so much
  at n ≥ 5 reappeared.

  The named lemmas `Fin.prod_univ_{two..eight}` are **not** kept as a fast path for the
  smaller manifolds.  One rule for every `n` is fewer things to get wrong, and the `ring`
  normalisation dominates the cost rather than the unfolding.

  ═══ SCOPE ═══

  Stated for an ARBITRARY root of each shape field's minimal polynomial — the identities
  hold at every root, which is what made them provable without exhibiting a root in the
  upper half plane.  Certifies a `ShapedTriangulation` (flat shapes permitted) and says
  nothing about hyperbolicity, which needs `Im z > 0` separately.

  Nothing here says any of these is a triangulation *of* a knot complement.
-/
import QOU.Knot.GluingBridge
import QOU.Knot.GeneratedGluing

namespace QOU.Knot.GeneratedCertified

open QOU.Knot.FlatTet QOU.MathlibExt

/-! ### `4_1` certified -/

namespace Cert41
open QOU.Knot.GeneratedGluing.K41

/-- The 2 `4_1` shapes, at an arbitrary root of the minimal polynomial. -/
noncomputable def triangulation {t : ℂ} (ht : minpoly t = 0) :
    ShapedTriangulation 2 :=
  ⟨![⟨z0 t, z0_ne_zero ht, fun h => one_sub_z0_ne_zero ht (by rw [h]; ring)⟩,
     ⟨z1 t, z1_ne_zero ht, fun h => one_sub_z1_ne_zero ht (by rw [h]; ring)⟩]⟩

/-- `4_1`'s edge exponents, from SnapPy's integer matrix. -/
def gluing : GluingData 2 2 where
  exp := ![![![2,1,0], ![2,1,0]],
           ![![0,1,2], ![0,1,2]]]

private theorem cleared_0 {t : ℂ} (ht : minpoly t = 0) :
    (∏ i, (((triangulation ht).tet i).z ^ gluing.exp 0 i 0
            * (((triangulation ht).tet i).z - 1) ^ gluing.exp 0 i 2))
      = (∏ i, ((1 - ((triangulation ht).tet i).z) ^ gluing.exp 0 i 1
            * ((triangulation ht).tet i).z ^ gluing.exp 0 i 2)) := by
  simp [Fin.prod_univ_succ, triangulation, gluing]
  linear_combination edge_0 ht

private theorem cleared_1 {t : ℂ} (ht : minpoly t = 0) :
    (∏ i, (((triangulation ht).tet i).z ^ gluing.exp 1 i 0
            * (((triangulation ht).tet i).z - 1) ^ gluing.exp 1 i 2))
      = (∏ i, ((1 - ((triangulation ht).tet i).z) ^ gluing.exp 1 i 1
            * ((triangulation ht).tet i).z ^ gluing.exp 1 i 2)) := by
  simp [Fin.prod_univ_succ, triangulation, gluing]
  linear_combination edge_1 ht

/-- **`4_1` satisfies its edge gluing equations**, at every root of the shape
field's minimal polynomial. -/
theorem satisfiesEdgeEquations {t : ℂ} (ht : minpoly t = 0) :
    (triangulation ht).SatisfiesEdgeEquations gluing := by
  refine satisfiesEdgeEquations_of_cleared _ _ ?_
  intro k
  fin_cases k
  exacts [cleared_0 ht, cleared_1 ht]

end Cert41

