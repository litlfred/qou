import Mathlib.Algebra.Field.Basic
import Mathlib.Tactic.Ring
import Mathlib.Tactic.LinearCombination

/-!
# QOU.FluidDynamics.TwoVortexChannelAlgebra — the two-vortex interaction channel algebra

The algebraic content of the soliton reading of two interacting vortex loops (2026-07-03
audit `docs/audits/2026-07-03-parabolic-cylinder-channel-interpolation.md` §5): two
geodesic vortices interact through the braiding `σ` of the 2-strand Hecke algebra
`H_2(q)`, whose commutant is generated by the symmetric/antisymmetric channel projectors
`e₊, e₋` (the Wedderburn pair of `van-der-waals-hopf-channel`). This file works in that
commutative subalgebra, modelled abstractly: a commutative ring `R` carrying elements
`e₊, e₋` (partition of unity, orthogonal), the braiding `σ` with the two channel
eigenvalues `q` and `−u` (where `u` is a ring-level witness of `q⁻¹`, `q·u = 1` — kept
generic per §7c instead of specialising to a field).

Everything is **proved sorry-free** from the class fields:

* `idem_plus`, `idem_minus` — idempotency is *derived* from partition + orthogonality;
* `braiding_sq` — the Hopf-link interaction `σ² = q²·e₊ + u²·e₋`: the two-crossing
  spectral decomposition (needs no invertibility);
* `hecke_relation` — the model satisfies `σ² = (q − u)·σ + 1`, i.e. the abstract channel
  data reproduces the Hecke/skein relation of AGENTS.md §7a with `u` in the `q⁻¹` slot;
* `eigenvalue_ratio` — the per-crossing suppression of the antisymmetric channel:
  `(−q⁻¹)/q = −(q²)⁻¹`, the algebraic decay rate `q⁻²` (at `q₀ > 1`) by which a
  crossing disturbance is damped — the fibre-level content of "the disturbance decays
  fast enough not to disrupt the soliton";
* `trivial_model` — non-vacuity witness.

No archimedean claim is made here: that `q⁻² < 1` requires `q > 1` is an ordering
statement, deliberately left on the archimedean side of the wall (§7c).
-/

namespace QOU.FluidDynamics.TwoVortexChannelAlgebra

variable {R : Type*} [CommRing R]

/-- **Two-vortex channel data, as a class.** `σ` is the braiding of the two-vortex
interaction; `e₊`/`e₋` the symmetric/antisymmetric channel projectors (partition of
unity, orthogonal); `q` and `−u` the two channel eigenvalues, with `u` a ring-level
inverse witness for `q`. The intended model is the commutant of `σ₁` in `H_2(q)` with
`e₊ = (σ + q⁻¹)/(q + q⁻¹)`, `e₋ = (q − σ)/(q + q⁻¹)`. -/
class TwoVortexChannels (σ e₊ e₋ q u : R) : Prop where
  /-- The two channels partition unity: `e₊ + e₋ = 1`. -/
  partition : e₊ + e₋ = 1
  /-- The channels are orthogonal: `e₊·e₋ = 0`. -/
  orthogonal : e₊ * e₋ = 0
  /-- `u` witnesses `q⁻¹` at ring level: `q·u = 1`. -/
  inverse : q * u = 1
  /-- Spectral form of the braiding: `σ = q·e₊ − u·e₋` (eigenvalues `q`, `−q⁻¹`;
  AGENTS.md §7a). -/
  eigen : σ = q * e₊ - u * e₋

variable (σ e₊ e₋ q u : R)

/-- **Idempotency of the symmetric channel is derived**, not assumed:
`e₊² = e₊` follows from partition + orthogonality. -/
theorem idem_plus [inst : TwoVortexChannels σ e₊ e₋ q u] : e₊ * e₊ = e₊ := by
  linear_combination e₊ * inst.partition - inst.orthogonal

/-- **Idempotency of the antisymmetric channel is derived**: `e₋² = e₋`. -/
theorem idem_minus [inst : TwoVortexChannels σ e₊ e₋ q u] : e₋ * e₋ = e₋ := by
  linear_combination e₋ * inst.partition - inst.orthogonal

/-- **The Hopf-link interaction, spectrally.** The square of the braiding (two crossings
— the closure is the Hopf link) decomposes as `σ² = q²·e₊ + u²·e₋`: the symmetric
channel is weighted `q²`, the antisymmetric channel `u² = q⁻²`. Needs only partition +
orthogonality, not invertibility. -/
theorem braiding_sq [inst : TwoVortexChannels σ e₊ e₋ q u] :
    σ ^ 2 = q ^ 2 * e₊ + u ^ 2 * e₋ := by
  have hp := idem_plus σ e₊ e₋ q u
  have hm := idem_minus σ e₊ e₋ q u
  rw [inst.eigen]
  linear_combination q ^ 2 * hp + u ^ 2 * hm - 2 * q * u * inst.orthogonal

/-- **The channel model satisfies the Hecke relation** `σ² = (q − u)·σ + 1` — the
abstract two-channel data reproduces the skein/Hecke relation of AGENTS.md §7a with the
inverse witness `u` in the `q⁻¹` slot. -/
theorem hecke_relation [inst : TwoVortexChannels σ e₊ e₋ q u] :
    σ ^ 2 = (q - u) * σ + 1 := by
  have hp := idem_plus σ e₊ e₋ q u
  have hm := idem_minus σ e₊ e₋ q u
  rw [inst.eigen]
  linear_combination q ^ 2 * hp + u ^ 2 * hm - 2 * q * u * inst.orthogonal +
    q * u * inst.partition + inst.inverse

/-- **Per-crossing suppression ratio.** The ratio of the antisymmetric to the symmetric
channel eigenvalue is `(−q⁻¹)/q = −(q²)⁻¹`: each crossing damps the antisymmetric
disturbance by `q⁻²` relative to the symmetric carrier. (Holds without a `q ≠ 0`
hypothesis under the `GroupWithZero` convention `0⁻¹ = 0`. That the ratio is a *decay* —
`q⁻² < 1` — is the archimedean statement `q > 1`, made only past the wall, §7c.) -/
theorem eigenvalue_ratio {K : Type*} [Field K] (q : K) :
    (-q⁻¹) / q = -(q ^ 2)⁻¹ := by
  rw [div_eq_mul_inv, sq, mul_inv, neg_mul]

/-- **Non-vacuity.** The one-channel degenerate model (`e₊ = 1`, `e₋ = 0`, `σ = q`)
inhabits the class for any invertible `q`, so the axiomatisation is consistent. The
faithful two-channel model lives in the commutant of `σ₁` in `H_2(q)`. -/
theorem trivial_model (q u : R) (h : q * u = 1) :
    TwoVortexChannels q 1 0 q u :=
  ⟨by ring, by ring, h, by ring⟩

end QOU.FluidDynamics.TwoVortexChannelAlgebra
