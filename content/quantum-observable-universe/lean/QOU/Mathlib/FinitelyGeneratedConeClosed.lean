import Mathlib.Analysis.Normed.Module.FiniteDimension
import Mathlib.LinearAlgebra.LinearIndependent.Defs
import Mathlib.Analysis.Convex.Cone.InnerDual
import Mathlib.Analysis.InnerProductSpace.Dual
import Mathlib.Analysis.InnerProductSpace.PiL2

/-!
# Finitely generated cones are closed

Bean `qou/kl8z`. `QOU.Optimization.LPStrongDuality` derives
`lp_strong_duality`, `lp_dual_feasible_of_lower_bound` and
`lp_zero_duality_gap` sorry-free from the conditional class
`MatrixFarkas`, whose single field is the Farkas/Gale alternative. The
whole LP layer therefore rests on one analytic input, and that input
rests in turn on one topological fact:

    the cone `{Σᵢ xᵢ vᵢ : x ≥ 0}` generated by finitely many vectors
    is closed.

Mathlib has the separation engine (`ProperCone.innerDual_innerDual`,
`ProperCone.hyperplane_separation`) but not this. That is the
Mathlib-shaped hole, and this file is where it gets filled.

## Two corrections to the scoping in `qou/kl8z`

* The bean records `ProperCone` as **absent from the olean cache**, "a
  separate, purely practical obstacle". It is present: the names moved,
  and `ConvexCone.innerDualCone_of_innerDualCone_eq_self`,
  `Set.innerDualCone`, `isClosed_innerDualCone` are now deprecated
  aliases for `ProperCone.innerDual_innerDual`, `ProperCone.innerDual`
  and `ProperCone.isClosed`. Measured 2026-08-21 against the pinned rev
  by compiling a probe. There is no practical obstacle here.
* `Mathlib/Analysis/Convex/Caratheodory.lean` is about **convex hulls**
  (`convexHull_eq_union` over affinely independent subsets), not cones.
  It is a template for the argument, not a source of it: the conic
  statement has to be proved separately.

## What this file proves

**`isClosed_coneSpan` — the lemma `qou/kl8z` names, proved, sorry-free.**
The proof splits in two along the line of what Mathlib already supports:

1. **`isClosed_coneSpan_of_linearIndependent`.** When the generators are
   linearly independent the coefficient map is an injective linear map
   out of a finite-dimensional space, hence a closed embedding, and the
   cone is the image of the closed non-negative orthant. This is the
   half `LinearMap.isClosedEmbedding_of_injective` was made for.

2. **`exists_linearIndependent_support` — conic Carathéodory.** Every
   point of the cone is a non-negative combination of a *linearly
   independent* subfamily. Purely combinatorial, and proved here by
   induction on the support: if the active generators are dependent,
   move along the dependency until a coefficient hits zero. No topology
   is involved, which is why it belongs in the algebraic half.

`coneSpan_eq_iUnion` then exhibits the cone as a **finite** union of the
sub-cones on independent subfamilies, and a finite union of closed sets
is closed.

The whole file is stated over an arbitrary `[Fintype ι]` rather than
`Fin n`. That is not decoration: it is what lets the subfamily indexed
by `s : Finset ι` reuse (1) directly, instead of needing a `Fin`
reindexing detour.

## What is still open above this file

`MatrixFarkas` does **not** follow from this file alone, and the bean's
claim that it does "by the standard route" is still unverified. Its
`farkas_alternative` field is strong-duality shaped — *if the primal is
feasible and no feasible point beats `γ`, the dual has a point with
objective `≥ γ`* — not the classic alternative. Deriving it from
`ProperCone.innerDual_innerDual` plus closedness is a real argument that
nobody has checked. Until someone does, "the LP layer is one lemma from
done" remains a claim about work not yet inspected.
-/

namespace QOU.Mathlib

open Finset

variable {ι : Type*} [Fintype ι] {E : Type*}

section Defs

variable [AddCommGroup E] [Module ℝ E]

/-- The cone generated by a finite family: all non-negative combinations
of `v`. -/
def coneSpan (v : ι → E) : Set E :=
  {y | ∃ x : ι → ℝ, (∀ i, 0 ≤ x i) ∧ y = ∑ i, x i • v i}

/-- The coefficient map `x ↦ Σᵢ xᵢ vᵢ`, as a linear map. -/
def coneMap (v : ι → E) : (ι → ℝ) →ₗ[ℝ] E where
  toFun x := ∑ i, x i • v i
  map_add' x y := by
    simp only [Pi.add_apply, add_smul]
    exact Finset.sum_add_distrib
  map_smul' c x := by
    simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, Finset.smul_sum,
      mul_smul]

@[simp]
theorem coneMap_apply (v : ι → E) (x : ι → ℝ) :
    coneMap v x = ∑ i, x i • v i := rfl

/-- `coneSpan` is the image of the non-negative orthant under `coneMap`. -/
theorem coneSpan_eq_image (v : ι → E) :
    coneSpan v = coneMap v '' {x : ι → ℝ | ∀ i, 0 ≤ x i} := by
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact ⟨x, hx, rfl⟩
  · rintro ⟨x, hx, rfl⟩
    exact ⟨x, hx, rfl⟩

omit [Fintype ι] in
/-- The non-negative orthant is closed. -/
theorem isClosed_nonneg_orthant :
    IsClosed {x : ι → ℝ | ∀ i, 0 ≤ x i} := by
  have : {x : ι → ℝ | ∀ i, 0 ≤ x i} = ⋂ i, {x : ι → ℝ | 0 ≤ x i} := by
    ext x; simp [Set.mem_iInter]
  rw [this]
  exact isClosed_iInter fun i => isClosed_le continuous_const (continuous_apply i)

end Defs

section Independent

variable [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- `coneMap` is injective exactly when the generators are independent. -/
theorem ker_coneMap_eq_bot {v : ι → E} (hv : LinearIndependent ℝ v) :
    LinearMap.ker (coneMap v) = ⊥ := by
  rw [LinearMap.ker_eq_bot']
  intro x hx
  have hx' : ∑ i, x i • v i = 0 := by simpa using hx
  funext i
  exact Fintype.linearIndependent_iff.mp hv x hx' i

/-- **A cone on linearly independent generators is closed.**

The coefficient map is injective and its domain is finite-dimensional,
so it is a closed embedding; the cone is the image of the closed
non-negative orthant under it. -/
theorem isClosed_coneSpan_of_linearIndependent {v : ι → E}
    (hv : LinearIndependent ℝ v) : IsClosed (coneSpan v) := by
  rw [coneSpan_eq_image]
  exact (LinearMap.isClosedEmbedding_of_injective
    (ker_coneMap_eq_bot hv)).isClosedMap _ isClosed_nonneg_orthant

end Independent



section Caratheodory

variable [NormedAddCommGroup E] [NormedSpace ℝ E] [DecidableEq ι]

/-- The sub-cone using only the generators indexed by `s`. -/
def coneSpanOn (v : ι → E) (s : Finset ι) : Set E :=
  {y | ∃ x : ι → ℝ, (∀ i, 0 ≤ x i) ∧ (∀ i ∉ s, x i = 0) ∧ y = ∑ i, x i • v i}

omit [DecidableEq ι] in
theorem coneSpanOn_subset (v : ι → E) (s : Finset ι) :
    coneSpanOn v s ⊆ coneSpan v := by
  rintro y ⟨x, hx, _, rfl⟩
  exact ⟨x, hx, rfl⟩

omit [DecidableEq ι] [NormedSpace ℝ E] in
/-- A sum over `ι` of something supported in `s` is a sum over `s`. -/
theorem sum_eq_sum_subtype (s : Finset ι) (f : ι → E) (hf : ∀ i ∉ s, f i = 0) :
    ∑ i : ι, f i = ∑ i : s, f (i : ι) := by
  rw [Finset.sum_coe_sort s f]
  exact (Finset.sum_subset (Finset.subset_univ s) (fun i _ hi => hf i hi)).symm

/-- A sub-cone is the cone on the corresponding subfamily. -/
theorem coneSpanOn_eq (v : ι → E) (s : Finset ι) :
    coneSpanOn v s = coneSpan (fun i : s => v (i : ι)) := by
  ext y
  constructor
  · rintro ⟨x, hx, hoff, rfl⟩
    exact ⟨fun i : s => x (i : ι), fun i => hx _,
      sum_eq_sum_subtype s _ (fun i hi => by rw [hoff i hi, zero_smul])⟩
  · rintro ⟨x, hx, rfl⟩
    refine ⟨fun i => if h : i ∈ s then x ⟨i, h⟩ else 0, ?_, ?_, ?_⟩
    · intro i; by_cases h : i ∈ s <;> simp [h, hx]
    · intro i hi; simp [hi]
    · rw [sum_eq_sum_subtype s _ (fun i hi => by simp [hi])]
      exact Finset.sum_congr rfl (fun i _ => by simp)

theorem isClosed_coneSpanOn (v : ι → E) (s : Finset ι)
    (hs : LinearIndependent ℝ (fun i : s => v (i : ι))) :
    IsClosed (coneSpanOn v s) := by
  rw [coneSpanOn_eq]
  exact isClosed_coneSpan_of_linearIndependent hs

/-- **Conic Carathéodory**, by induction on the support.

If the active generators are dependent, take a dependency `Σ λᵢvᵢ = 0`
with some `λᵢ > 0` (negating if necessary) and walk `x ↦ x − cλ` with
`c = minᵢ {xᵢ/λᵢ : λᵢ > 0}`. Non-negativity survives — where `λᵢ ≤ 0`
because `c ≥ 0`, and where `λᵢ > 0` by minimality of `c` — and the
coefficient attaining the minimum is driven to zero, so the support
strictly shrinks and the induction terminates.

This is the conic analogue of `Mathlib/Analysis/Convex/Caratheodory.lean`,
which proves the corresponding statement for **convex hulls** over affinely
independent subsets. The argument transfers; the statement does not, so it
is proved separately here. -/
private theorem caratheodory_aux (v : ι → E) :
    ∀ (k : ℕ) (s : Finset ι) (x : ι → ℝ), s.card ≤ k →
      (∀ i, 0 ≤ x i) → (∀ i ∉ s, x i = 0) →
      ∃ t : Finset ι, LinearIndependent ℝ (fun i : t => v (i : ι)) ∧
        ∃ z : ι → ℝ, (∀ i, 0 ≤ z i) ∧ (∀ i ∉ t, z i = 0) ∧
          (∑ i, z i • v i) = ∑ i, x i • v i := by
  intro k
  induction k with
  | zero =>
      intro s x hcard hx hoff
      have hs : s = ∅ := Finset.card_eq_zero.mp (Nat.le_zero.mp hcard)
      subst hs
      refine ⟨∅, ?_, x, hx, fun i _ => hoff i (Finset.notMem_empty i), rfl⟩
      have : IsEmpty ((∅ : Finset ι) : Type _) :=
        ⟨fun i => absurd i.2 (Finset.notMem_empty _)⟩
      exact linearIndependent_empty_type
  | succ k ih =>
      intro s x hcard hx hoff
      classical
      by_cases hli : LinearIndependent ℝ (fun i : s => v (i : ι))
      · exact ⟨s, hli, x, hx, hoff, rfl⟩
      have reduce : ∀ mu : ι → ℝ, (∑ i, mu i • v i) = 0 → (∀ i ∉ s, mu i = 0) →
          ∀ i₁ ∈ s, 0 < mu i₁ →
          ∃ t : Finset ι, LinearIndependent ℝ (fun i : t => v (i : ι)) ∧
            ∃ z : ι → ℝ, (∀ i, 0 ≤ z i) ∧ (∀ i ∉ t, z i = 0) ∧
              (∑ i, z i • v i) = ∑ i, x i • v i := by
        intro mu hmu0 hmuoff i₁ hi₁s hi₁pos
        set P : Finset ι := s.filter (fun i => 0 < mu i) with hP
        have hPne : P.Nonempty := ⟨i₁, by simp [hP, hi₁s, hi₁pos]⟩
        obtain ⟨i₀, hi₀P, hi₀min⟩ := P.exists_min_image (fun i => x i / mu i) hPne
        have hi₀s : i₀ ∈ s := (Finset.mem_filter.mp hi₀P).1
        have hi₀pos : 0 < mu i₀ := (Finset.mem_filter.mp hi₀P).2
        set c : ℝ := x i₀ / mu i₀ with hc
        have hc0 : 0 ≤ c := div_nonneg (hx i₀) hi₀pos.le
        set z : ι → ℝ := fun i => x i - c * mu i with hz
        have hzi₀ : z i₀ = 0 := by
          simp only [hz, hc]
          field_simp
          ring
        have hznn : ∀ i, 0 ≤ z i := by
          intro i
          rcases le_or_gt (mu i) 0 with h | h
          · have hle : c * mu i ≤ 0 := mul_nonpos_of_nonneg_of_nonpos hc0 h
            simp only [hz]; linarith [hx i]
          · have hiP : i ∈ P := by
              refine Finset.mem_filter.mpr ⟨?_, h⟩
              by_contra hns
              exact absurd (hmuoff i hns) (ne_of_gt h)
            have hle : c * mu i ≤ x i := (le_div_iff₀ h).mp (hi₀min i hiP)
            simp only [hz]; linarith
        have hzoff : ∀ i ∉ s, z i = 0 := by
          intro i hi
          simp [hz, hoff i hi, hmuoff i hi]
        have hzsum : (∑ i, z i • v i) = ∑ i, x i • v i := by
          have hterm : ∀ i, z i • v i = x i • v i - c • (mu i • v i) := by
            intro i; simp [hz, sub_smul, smul_smul]
          rw [Finset.sum_congr rfl (fun i _ => hterm i), Finset.sum_sub_distrib,
            ← Finset.smul_sum, hmu0, smul_zero, sub_zero]
        have hcard' : (s.erase i₀).card ≤ k := by
          rw [Finset.card_erase_of_mem hi₀s]
          omega
        obtain ⟨t, hti, w, hw, hwoff, hwsum⟩ :=
          ih (s.erase i₀) z hcard' hznn
            (fun i hi => by
              rcases eq_or_ne i i₀ with rfl | hne
              · exact hzi₀
              · exact hzoff i (fun hs => hi (Finset.mem_erase.mpr ⟨hne, hs⟩)))
        exact ⟨t, hti, w, hw, hwoff, hwsum.trans hzsum⟩
      obtain ⟨g, hg0, i₁, hg1⟩ := Fintype.not_linearIndependent_iff.mp hli
      set lam : ι → ℝ := fun i => if h : i ∈ s then g ⟨i, h⟩ else 0 with hlam
      have hlamoff : ∀ i ∉ s, lam i = 0 := fun i hi => by simp [hlam, hi]
      have hlam0 : (∑ i, lam i • v i) = 0 := by
        rw [sum_eq_sum_subtype s _ (fun i hi => by simp [hlam, hi])]
        rw [← hg0]
        exact Finset.sum_congr rfl (fun i _ => by simp [hlam, i.2])
      have hlam1 : lam (i₁ : ι) ≠ 0 := by simpa [hlam, i₁.2] using hg1
      rcases hlam1.lt_or_gt with hneg | hpos
      · refine reduce (fun i => -lam i) ?_ (fun i hi => by simp [hlamoff i hi]) i₁ i₁.2
          (by simpa using hneg)
        simp only [neg_smul]
        rw [Finset.sum_neg_distrib, hlam0, neg_zero]
      · exact reduce lam hlam0 hlamoff i₁ i₁.2 hpos

/-- Conic Carathéodory, in the form the union decomposition needs. -/
theorem exists_linearIndependent_support (v : ι → E) {y : E} (hy : y ∈ coneSpan v) :
    ∃ s : Finset ι, LinearIndependent ℝ (fun i : s => v (i : ι)) ∧
      y ∈ coneSpanOn v s := by
  -- Ref: [rockafellar1970] Convex Analysis, Cor. 17.1.2 (conic Carathéodory)
  -- Ref: [schrijver1986] Theory of Linear and Integer Programming, §7.2
  obtain ⟨x, hx, rfl⟩ := hy
  obtain ⟨t, hti, z, hz, hzoff, hzsum⟩ :=
    caratheodory_aux v (Finset.univ.card) Finset.univ x le_rfl hx
      (fun i hi => absurd (Finset.mem_univ i) hi)
  exact ⟨t, hti, z, hz, hzoff, hzsum.symm⟩

/-- The cone is the union of the sub-cones on independent subfamilies. -/
theorem coneSpan_eq_iUnion (v : ι → E) :
    coneSpan v =
      ⋃ s ∈ {s : Finset ι | LinearIndependent ℝ (fun i : s => v (i : ι))},
        coneSpanOn v s := by
  ext y
  constructor
  · intro hy
    obtain ⟨s, hs, hys⟩ := exists_linearIndependent_support v hy
    exact Set.mem_biUnion hs hys
  · intro hy
    obtain ⟨s, _, hy⟩ := Set.mem_iUnion₂.mp hy
    exact coneSpanOn_subset v s hy

/-- **A finitely generated cone is closed.**

The gap `qou/kl8z` identifies as the single analytic input to the whole
LP layer. Modulo `exists_linearIndependent_support`, which is finite and
algebraic, this is now derived: the cone is a *finite* union of sub-cones
on independent subfamilies, and each of those is closed by
`isClosed_coneSpan_of_linearIndependent`. -/
theorem isClosed_coneSpan (v : ι → E) : IsClosed (coneSpan v) := by
  rw [coneSpan_eq_iUnion]
  exact Set.Finite.isClosed_biUnion (Set.toFinite _)
    (fun s hs => isClosed_coneSpanOn v s hs)

end Caratheodory


section Farkas

variable [NormedAddCommGroup E] [NormedSpace ℝ E] [DecidableEq ι]

/-- Each generator lies in the cone it generates. -/
theorem mem_coneSpan_generator (v : ι → E) (i : ι) : v i ∈ coneSpan v := by
  classical
  refine ⟨fun j => if j = i then 1 else 0, fun j => by by_cases h : j = i <;> simp [h], ?_⟩
  simp

/-- `coneSpan` as a pointed cone: it contains `0` and is closed under
addition and non-negative scaling. -/
def coneSpanPointed (v : ι → E) : PointedCone ℝ E where
  carrier := coneSpan v
  zero_mem' := ⟨fun _ => 0, fun _ => le_rfl, by simp⟩
  add_mem' := by
    rintro _ _ ⟨x, hx, rfl⟩ ⟨y, hy, rfl⟩
    exact ⟨fun i => x i + y i, fun i => add_nonneg (hx i) (hy i), by
      simp [add_smul, Finset.sum_add_distrib]⟩
  smul_mem' := by
    rintro ⟨c, hc⟩ _ ⟨x, hx, rfl⟩
    exact ⟨fun i => c * x i, fun i => mul_nonneg hc (hx i), by
      simp [Finset.smul_sum, mul_smul]⟩

omit [DecidableEq ι] in
@[simp]
theorem coe_coneSpanPointed (v : ι → E) :
    (coneSpanPointed v : Set E) = coneSpan v := rfl

/-- `coneSpan` as a **proper** cone — the packaging `isClosed_coneSpan`
makes available, and the form Mathlib's separation theorem consumes. -/
def coneSpanProper (v : ι → E) : ProperCone ℝ E where
  toSubmodule := coneSpanPointed v
  isClosed' := isClosed_coneSpan v

@[simp]
theorem coe_coneSpanProper (v : ι → E) :
    (coneSpanProper v : Set E) = coneSpan v := rfl

/-- **Farkas' lemma**, in separating-functional form.

If `b` is not a non-negative combination of `v`, then some continuous
linear functional is non-negative on every generator and strictly
negative at `b`. Exactly one of the two alternatives holds — the
converse direction is immediate, since a functional non-negative on the
generators is non-negative on the whole cone.

This is what `isClosed_coneSpan` was for: `ProperCone.hyperplane_separation`
needs a *closed* cone, and closedness of a finitely generated cone is
precisely the fact Mathlib was missing. -/
theorem farkas_separation (v : ι → E) {b : E} (hb : b ∉ coneSpan v) :
    ∃ f : E →L[ℝ] ℝ, (∀ i, 0 ≤ f (v i)) ∧ f b < 0 := by
  obtain ⟨f, hfC, hfb⟩ :=
    (coneSpanProper v).hyperplane_separation (K := {b}) (convex_singleton b)
      isCompact_singleton (Set.disjoint_singleton_left.mpr (by simpa using hb))
  exact ⟨f, fun i => hfC _ (mem_coneSpan_generator v i), hfb b rfl⟩

omit [DecidableEq ι] in
/-- The converse half of the alternative, for completeness: a functional
non-negative on the generators is non-negative on the cone, so the two
alternatives of `farkas_separation` are mutually exclusive. -/
theorem nonneg_on_coneSpan_of_nonneg_on_generators (v : ι → E) (f : E →L[ℝ] ℝ)
    (hf : ∀ i, 0 ≤ f (v i)) {y : E} (hy : y ∈ coneSpan v) : 0 ≤ f y := by
  obtain ⟨x, hx, rfl⟩ := hy
  rw [map_sum]
  exact Finset.sum_nonneg fun i _ => by
    rw [map_smul, smul_eq_mul]
    exact mul_nonneg (hx i) (hf i)

end Farkas


section EuclideanFarkas

open scoped InnerProductSpace

variable {k : ℕ}

/-- The real inner product on `EuclideanSpace` in coordinates. -/
theorem euclidean_inner_eq (z x : EuclideanSpace ℝ (Fin k)) :
    (inner ℝ z x : ℝ) = ∑ p, z p * x p := by
  rw [EuclideanSpace.inner_eq_star_dotProduct]
  simp [dotProduct, mul_comm]

/-- **Farkas' lemma, vector form.**

If `b` is not a non-negative combination of `v`, there is a *vector* `z`
with `⟪z, vᵢ⟫ ≥ 0` for every generator and `⟪z, b⟫ < 0`.

This is `farkas_separation` pushed through Riesz representation. The
functional form is the one separation produces; the vector form is the
one a linear program consumes, since dual feasibility `Aᵀl ≤ c` is a
statement about a vector of multipliers. -/
theorem farkas_vector [DecidableEq ι] (v : ι → EuclideanSpace ℝ (Fin k))
    {b : EuclideanSpace ℝ (Fin k)} (hb : b ∉ coneSpan v) :
    ∃ z : EuclideanSpace ℝ (Fin k),
      (∀ i, 0 ≤ ∑ p, z p * v i p) ∧ (∑ p, z p * b p) < 0 := by
  obtain ⟨f, hfv, hfb⟩ := farkas_separation v hb
  refine ⟨(InnerProductSpace.toDual ℝ _).symm f, fun i => ?_, ?_⟩
  · rw [← euclidean_inner_eq, InnerProductSpace.toDual_symm_apply]
    exact hfv i
  · rw [← euclidean_inner_eq, InnerProductSpace.toDual_symm_apply]
    exact hfb

end EuclideanFarkas

end QOU.Mathlib
