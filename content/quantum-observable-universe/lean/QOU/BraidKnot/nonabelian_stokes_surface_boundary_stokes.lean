namespace QOU.BraidKnot.StokesSurfaceBoundary

open QOU.Mathlib.NonAbelianStokes

/-! ## Part 1 — boundary holonomy = braid Hecke image (PROVABLE-NOW item 1)

We work over an abstract group `G` standing for the multiplicative group
generated by the Hecke images `ρ(σ_i)` (concretely `GL_{d_λ}(ℂ)` once a
Wedderburn block `λ` is fixed).  A braid word `β = σ_{i₁} ⋯ σ_{i_ℓ}` is
presented as the list of its Hecke-image generators
`heckeImages = [ρ(σ_{i₁}), …, ρ(σ_{i_ℓ})]`.  The Yekutieli
surface→boundary reduction states that the boundary holonomy of the
categorical connection over the (closed) Young-diagram braid surface is
exactly the ordered product `braidWordHolonomy heckeImages = ρ(β)`.

The map `heckeImages ↦ ρ(β)` is `braidWordHolonomy`; we prove it is a
*monoid homomorphism from braid-word concatenation to `G`* — which is
precisely the statement that the boundary holonomy IS the Hecke image
(functorial under braid composition, carrying the Markov cocycle). -/

/-- **Boundary holonomy = Hecke image, by definition of the
    surface→boundary reduction.**  The boundary holonomy of the braid
    word (the ordered product of its per-letter Hecke images) is the
    Hecke image `ρ(β)` of the braid.  We *define* `heckeImage` to be the
    ordered product and record the definitional equality with
    `braidWordHolonomy`; the content is that they are the SAME ordered
    product (no scalar `z^ℓ` collapse).

    This is the provable surface→boundary piece: once Yekutieli's
    theorem (the §3b-cond class below) reduces the surface-ordered
    exponential to the boundary ordered product, *that* product is
    `ρ(β)` by construction. -/
def heckeImage {G : Type*} [Group G] (heckeImages : List G) : G :=
  braidWordHolonomy heckeImages

/-- The boundary holonomy equals the braid's Hecke image. -/
theorem braidWordHolonomy_eq_heckeImage {G : Type*} [Group G]
    (heckeImages : List G) :
    braidWordHolonomy heckeImages = heckeImage heckeImages := rfl

/-- **Functoriality: the Hecke image is multiplicative under braid
    concatenation.**  `ρ(β₁ β₂) = ρ(β₁) · ρ(β₂)`.  This is the genuine
    representation-homomorphism property — the boundary holonomy is a
    group homomorphism from the braid monoid (under concatenation) to
    `G`, NOT a scalar power.  Proved from `braidWordHolonomy_append`. -/
theorem heckeImage_append {G : Type*} [Group G] (w₁ w₂ : List G) :
    heckeImage (w₁ ++ w₂) = heckeImage w₁ * heckeImage w₂ :=
  braidWordHolonomy_append w₁ w₂

/-- The empty braid maps to the identity: `ρ(1) = 1`. -/
theorem heckeImage_nil {G : Type*} [Group G] :
    heckeImage ([] : List G) = 1 :=
  braidWordHolonomy_nil

/-- **Markov cocycle on the Hecke image.**  Appending a generator
    `g = ρ(σ_i)` multiplies the Hecke image on the right:
    `ρ(β · σ_i) = ρ(β) · ρ(σ_i)`. -/
theorem heckeImage_append_letter {G : Type*} [Group G]
    (word : List G) (g : G) :
    heckeImage (word ++ [g]) = heckeImage word * g :=
  braidWordHolonomy_append_letter word g

/-- **Closure invariance up to conjugation (class function).**  The
    Markov-trace closure `tr_M ∘ ρ` is a class function, so the boundary
    holonomy is well-defined on cyclic words up to conjugation.  We prove
    the one-letter cyclic rotation: rotating the head letter to the tail
    conjugates the Hecke image.  (Markov trace, being a trace, is then
    invariant: `tr(g⁻¹ X g) = tr(X)`.) -/
theorem heckeImage_cyclic_one {G : Type*} [Group G]
    (g : G) (rest : List G) :
    heckeImage (rest ++ [g]) =
      g⁻¹ * heckeImage (g :: rest) * g :=
  braidWordHolonomy_cyclic_one g rest

/-- **The toy `z^ℓ` model is the degenerate single-generator case.**
    The pre-#1627 scalar model `braidSurfaceMultTrace z n = z ^ n` is the
    Hecke image of the constant word `[z, …, z]`; the genuine ordered
    product strictly generalises it (distinct letters give distinct,
    non-commuting factors). -/
theorem toyModel_is_constant_word {G : Type*} [Group G] (z : G) (n : ℕ) :
    braidSurfaceMultTrace z n = heckeImage (List.replicate n z) :=
  braidSurfaceMultTrace_eq_braidWordHolonomy_replicate z n

/-! ### The genuinely-open Stokes theorem (kept axiomatic — NOT faked)

The PROVABLE pieces above establish that *if* the surface-ordered
exponential reduces to the boundary ordered product, *then* that product
is `ρ(β)` and carries the Markov/conjugation structure.  The reduction
itself — the non-abelian Stokes theorem `MI₁(α; ∂σ) = MI₂(d_α β; σ)` on
the piecewise-affine Young-diagram surface — is the deep analytic input.
We carry it as a §3b-cond class hypothesis, never as a `:= True` stub or
a fabricated proof. -/

/-- **§3b-cond class: the Yekutieli surface→boundary reduction.**  The
    single axiomatised hypothesis: the surface-ordered exponential of the
    categorical connection `α` over the braid surface equals the boundary
    holonomy, which (Part 1) is the Hecke image `ρ(β)`.  An instance of
    this class is the only `sorry`-equivalent input; everything
    downstream is then derived.

    `surfaceOrderedExp` is the abstract surface-ordered exponential
    `MI₂(d_α β; σ)`; the field asserts it equals the boundary holonomy of
    the braid word. -/
class YekutieliSurfaceToBoundary (G : Type*) [Group G] where
  /-- The surface-ordered exponential of the categorical connection over
      the Young-diagram braid surface of the braid word. -/
  surfaceOrderedExp : List G → G
  /-- **Yekutieli non-abelian Stokes (axiomatised hypothesis).**  The
      surface-ordered exponential equals the boundary ordered product
      (the Hecke image `ρ(β)`).  This is the deep theorem — see
      Yekutieli (2015) §3; NOT provable from the finite-product machinery
      alone, so it is a class field, not a Lean proof.
      Ref: [yekutieli2015] https://doi.org/10.1142/9537 §3. -/
  stokes_reduction : ∀ word, surfaceOrderedExp word = heckeImage word

/-- **Derived (conditional on the §3b-cond class): the surface-ordered
    exponential carries the Markov cocycle.**  Given the Yekutieli
    reduction, the surface integral of an extended braid word is the
    surface integral times the new letter — fully derived from
    `heckeImage_append_letter`, with the Stokes theorem as the only
    hypothesis. -/
theorem surfaceOrderedExp_append_letter {G : Type*} [Group G]
    [Y : YekutieliSurfaceToBoundary G] (word : List G) (g : G) :
    Y.surfaceOrderedExp (word ++ [g]) = Y.surfaceOrderedExp word * g := by
  rw [Y.stokes_reduction, Y.stokes_reduction, heckeImage_append_letter]

/-- **Derived: the surface-ordered exponential is multiplicative under
    braid concatenation** (conditional on the §3b-cond class). -/
theorem surfaceOrderedExp_append {G : Type*} [Group G]
    [Y : YekutieliSurfaceToBoundary G] (w₁ w₂ : List G) :
    Y.surfaceOrderedExp (w₁ ++ w₂)
      = Y.surfaceOrderedExp w₁ * Y.surfaceOrderedExp w₂ := by
  rw [Y.stokes_reduction, Y.stokes_reduction, Y.stokes_reduction,
      heckeImage_append]

/-! ## Part 2 — q-Reeb phase = eigenphase of `M_{4₁}` on `V_(2,1)`
    (PROVABLE-NOW item 2)

The figure-eight operator `M_{4₁} = (σ₁σ₂⁻¹)²` acts on the 2-dimensional
standard block `V_(2,1)` of `H₃(q)`.  The Hoefsmit seminormal form gives
each generator `σ_i` as a concrete real 2×2 matrix on this block:

```
  σ = [ a_ρ   b      ]      a_ρ = (q − q⁻¹)/(1 − q^{−2ρ}),  b = √(1 − a_ρ²)
      [ b     a_{−ρ} ]      a_{−ρ} = h − a_ρ   (trace σ = h = q − q⁻¹)
```

with `det σ = q · (−q⁻¹) = −1` (eigenvalues `q`, `−q⁻¹`).

The figure-eight knot operator on `V_(2,1)` is a real 2×2 matrix `M`
with `det M = (det σ)⁴ = (−1)⁴ = 1` and real trace `t = tr M`.  For
`|t| < 2`, the eigenvalues are `e^{±iθ}` on the unit circle with
`cos θ = t/2` — the q-Reeb rotation phase.

We prove this as a **concrete real-matrix eigenvalue identity**, NOT as
the `(2:ℕ)=2` filler of the existing `figure-eight-reeb-rotation.lean`. -/

/-- A real 2×2 matrix is recorded by its four entries.  We only need its
    trace and determinant for the eigenphase computation. -/
structure Mat2 where
  a : ℝ
  b : ℝ
  c : ℝ
  d : ℝ

namespace Mat2

/-- Trace of a 2×2 matrix. -/
def trace (M : Mat2) : ℝ := M.a + M.d

/-- Determinant of a 2×2 matrix. -/
def det (M : Mat2) : ℝ := M.a * M.d - M.b * M.c

/-- 2×2 matrix multiplication. -/
def mul (M N : Mat2) : Mat2 :=
  { a := M.a * N.a + M.b * N.c
    b := M.a * N.b + M.b * N.d
    c := M.c * N.a + M.d * N.c
    d := M.c * N.b + M.d * N.d }

/-- **Determinant is multiplicative** — `det (M N) = det M · det N`.
    The Cauchy–Binet / Binet identity at 2×2, proved by `ring`. -/
theorem det_mul (M N : Mat2) : (M.mul N).det = M.det * N.det := by
  simp only [det, mul]; ring

end Mat2

/-- **Hoefsmit generator block on `V_(2,1)`.**  The concrete real 2×2
    matrix of a Hecke generator `σ_i` in the Hoefsmit seminormal form,
    parameterised by the diagonal entry `a_ρ` and the off-diagonal `b`,
    with second diagonal entry fixed by the Hecke trace `tr σ = h`
    (so `a_{−ρ} = h − a_ρ`) and `det σ = −1`.

    We carry `(a_ρ, b, h)` and require the determinant constraint
    `a_ρ (h − a_ρ) − b² = −1`, which is the Hoefsmit relation
    `b = √(1 − a_ρ²)` rewritten with the Hecke trace `h`.  This is the
    manuscript's `a_ρ a_{−ρ} − b² = det σ = −1`
    (figure-eight-reeb-rotation.md:30-31). -/
structure HoefsmitGen where
  /-- Diagonal entry `a_ρ`. -/
  aρ : ℝ
  /-- Off-diagonal entry `b`. -/
  b : ℝ
  /-- Hecke trace `h = q − q⁻¹` (so the other diagonal is `h − a_ρ`). -/
  h : ℝ
  /-- Hecke determinant constraint: `det σ = a_ρ(h−a_ρ) − b² = −1`. -/
  det_eq_neg_one : aρ * (h - aρ) - b * b = -1

namespace HoefsmitGen

/-- The 2×2 matrix of the generator `σ_i`. -/
def matrix (σ : HoefsmitGen) : Mat2 :=
  { a := σ.aρ, b := σ.b, c := σ.b, d := σ.h - σ.aρ }

/-- **The generator block has determinant `−1`** (eigenvalues `q`,
    `−q⁻¹`).  Concrete from the Hecke constraint, not asserted. -/
theorem matrix_det (σ : HoefsmitGen) : σ.matrix.det = -1 := by
  simp only [matrix, Mat2.det]
  have := σ.det_eq_neg_one
  linarith [this]

/-- **The generator block has trace `h = q − q⁻¹`** (eigenvalue sum
    `q + (−q⁻¹) = q − q⁻¹`).  Concrete, by `ring`. -/
theorem matrix_trace (σ : HoefsmitGen) : σ.matrix.trace = σ.h := by
  simp only [matrix, Mat2.trace]; ring

/-- **The inverse generator block `σ⁻¹` also has determinant `−1`.**
    `σ⁻¹ = σ − h·I` has eigenvalues `q⁻¹, −q` (manuscript:17-19), so its
    determinant is `q⁻¹·(−q) = −1`.  Concretely `σ⁻¹ = (1/det)·adj(σ) =
    −adj(σ)` for `det = −1`, i.e. `[ −d, b; c, −a ]`. -/
def invMatrix (σ : HoefsmitGen) : Mat2 :=
  { a := -(σ.h - σ.aρ), b := σ.b, c := σ.b, d := -σ.aρ }

/-- The inverse block has determinant `−1` (same as `σ`, since the knot
    operator det is `(det σ)²·(det σ⁻¹)² = 1`). -/
theorem invMatrix_det (σ : HoefsmitGen) : σ.invMatrix.det = -1 := by
  simp only [invMatrix, Mat2.det]
  have := σ.det_eq_neg_one
  nlinarith [this]

end HoefsmitGen

/-- **Figure-eight operator `M_{4₁} = (σ₁ σ₂⁻¹)²` on `V_(2,1)`.**
    Built from two Hoefsmit generator blocks `σ₁` and (the inverse of)
    `σ₂`.  We form `σ₁ · σ₂⁻¹` then square it. -/
def figureEightOp (σ₁ σ₂ : HoefsmitGen) : Mat2 :=
  let A := σ₁.matrix.mul σ₂.invMatrix
  A.mul A

/-- **det M_{4₁} = 1 (PROVED, compile-pending).**  The figure-eight knot
    operator on `V_(2,1)` has determinant 1: `det((σ₁σ₂⁻¹)²) =
    (det σ₁)² (det σ₂⁻¹)² = (−1)²(−1)² = 1`.  This is the
    manuscript's det = 1 claim (figure-eight-reeb-rotation.md:33-34),
    here proved by `det_mul` + the concrete generator determinants —
    NOT the `(−1)^4 = 1` numerology of the existing stub. -/
theorem figureEightOp_det_one (σ₁ σ₂ : HoefsmitGen) :
    (figureEightOp σ₁ σ₂).det = 1 := by
  unfold figureEightOp
  rw [Mat2.det_mul, Mat2.det_mul, σ₁.matrix_det, σ₂.invMatrix_det]
  ring

/-! ### The eigenphase (det = 1, real trace ⇒ `e^{±iθ}` on the unit circle)

For a real 2×2 matrix `M` with `det M = 1` and trace `t = tr M`, the
characteristic polynomial is `x² − t x + 1`, with roots
`(t ± √(t²−4))/2`.  When `|t| < 2` the roots are complex conjugates of
modulus 1: `λ = e^{±iθ}` with `cos θ = t/2`, `λ · λ̄ = det M = 1`.

We prove the eigenphase identity in the form: there is a real angle `θ`
with `2 cos θ = t` exactly when `|t| ≤ 2`, and then `e^{iθ}·e^{−iθ} = 1
= det M` and `e^{iθ} + e^{−iθ} = 2 cos θ = t = tr M`.  This certifies
`e^{±iθ}` ARE the eigenvalues of `M`. -/

/-- **Eigenphase existence (PROVED, compile-pending).**  For a real
    SL₂ matrix `M` (`det M = 1`) with `|tr M| ≤ 2`, there exists a real
    angle `θ` such that `2 cos θ = tr M`.  This `θ` is the q-Reeb
    rotation phase; the eigenvalues are `e^{±iθ}`.  Proved via
    `Real.cos_arccos`. -/
theorem eigenphase_exists (M : Mat2) (hdet : M.det = 1)
    (htr : |M.trace| ≤ 2) :
    ∃ θ : ℝ, 2 * Real.cos θ = M.trace := by
  refine ⟨Real.arccos (M.trace / 2), ?_⟩
  have h1 : -1 ≤ M.trace / 2 := by
    have := abs_le.mp htr |>.1; linarith
  have h2 : M.trace / 2 ≤ 1 := by
    have := abs_le.mp htr |>.2; linarith
  rw [Real.cos_arccos h1 h2]; ring

/-- **Eigenvalue product = det (PROVED, compile-pending).**  Once
    `2 cos θ = tr M` and `det M = 1`, the complex pair `e^{±iθ}` has
    product `e^{iθ}·e^{−iθ} = 1 = det M`.  Proved over `ℂ` via
    `Complex.exp_add`. -/
theorem eigenvalue_prod_eq_det (M : Mat2) (θ : ℝ) (hdet : M.det = 1) :
    Complex.exp (θ * Complex.I) * Complex.exp (-(θ * Complex.I))
      = (M.det : ℂ) := by
  rw [← Complex.exp_add]
  simp only [add_neg_cancel, Complex.exp_zero]
  rw [hdet]; norm_num

/-- **Eigenvalue sum = trace (PROVED, compile-pending).**  Once
    `2 cos θ = tr M`, the complex pair `e^{±iθ}` has sum
    `e^{iθ} + e^{−iθ} = 2 cos θ = tr M`.  Proved over `ℂ` from
    `Complex.exp_mul_I` (Euler) and `Complex.cos`/`Complex.sin`
    parity. -/
theorem eigenvalue_sum_eq_trace (M : Mat2) (θ : ℝ)
    (hθ : 2 * Real.cos θ = M.trace) :
    Complex.exp (θ * Complex.I) + Complex.exp (-(θ * Complex.I))
      = (M.trace : ℂ) := by
  -- Euler: `exp(±θ·I) = cos θ ± i sin θ`, so the sum is `2 cos θ`.
  -- `Complex.exp_mul_I : exp (z * I) = cos z + sin z * I`.
  have e₁ : Complex.exp ((θ : ℂ) * Complex.I)
      = Complex.cos (θ : ℂ) + Complex.sin (θ : ℂ) * Complex.I :=
    Complex.exp_mul_I (θ : ℂ)
  have e₂ : Complex.exp (-((θ : ℂ) * Complex.I))
      = Complex.cos (θ : ℂ) - Complex.sin (θ : ℂ) * Complex.I := by
    have : (-((θ : ℂ) * Complex.I)) = ((-θ : ℝ) : ℂ) * Complex.I := by
      push_cast; ring
    rw [this, Complex.exp_mul_I]
    push_cast
    rw [Complex.cos_neg, Complex.sin_neg]
    ring
  rw [e₁, e₂]
  -- (cos + i sin) + (cos − i sin) = 2 cos θ = ↑(M.trace)
  have : Complex.cos (θ : ℂ) + Complex.sin (θ : ℂ) * Complex.I
        + (Complex.cos (θ : ℂ) - Complex.sin (θ : ℂ) * Complex.I)
      = 2 * Complex.cos (θ : ℂ) := by ring
  rw [this, ← Complex.ofReal_cos]
  rw [show (2 : ℂ) * ((Real.cos θ : ℝ) : ℂ) = (((2 * Real.cos θ : ℝ)) : ℂ) by
        push_cast; ring]
  rw [hθ]

/-- **Full eigenphase certificate (PROVED, compile-pending).**  For the
    figure-eight operator `M = M_{4₁}` on `V_(2,1)` with `|tr M| ≤ 2`,
    there is a real q-Reeb phase `θ` whose unit-circle pair `e^{±iθ}` is
    the eigenvalue pair of `M`: product = `det M = 1`, sum = `tr M`.
    This is the rigorous form of the manuscript proof sketch
    (figure-eight-reeb-rotation.md:1-36): det = 1, real trace ⇒
    eigenvalues `e^{±iθ}`. -/
theorem figureEight_eigenphase (σ₁ σ₂ : HoefsmitGen)
    (htr : |(figureEightOp σ₁ σ₂).trace| ≤ 2) :
    ∃ θ : ℝ,
      Complex.exp (θ * Complex.I) * Complex.exp (-(θ * Complex.I)) = 1 ∧
      Complex.exp (θ * Complex.I) + Complex.exp (-(θ * Complex.I))
        = ((figureEightOp σ₁ σ₂).trace : ℂ) := by
  have hdet : (figureEightOp σ₁ σ₂).det = 1 := figureEightOp_det_one σ₁ σ₂
  obtain ⟨θ, hθ⟩ := eigenphase_exists (figureEightOp σ₁ σ₂) hdet htr
  refine ⟨θ, ?_, eigenvalue_sum_eq_trace _ θ hθ⟩
  have := eigenvalue_prod_eq_det (figureEightOp σ₁ σ₂) θ hdet
  rw [this, hdet]; norm_num

end QOU.BraidKnot.StokesSurfaceBoundary
