import QOU.BraidKnot.CompositionIntertwine

/-!
# Mathas' Lemma 3.9, in ideal form — and it comes out sharper than stated

Mathas 3.9: for `μ` a **composition** and `ν` its reordering into a partition, an
`m_{st}` with `s,t` row-standard `μ`-tableaux is an *`R`-combination* of `m_{uv}` with
`u,v` row-standard `ν`-tableaux.

The proof he gives is a conjugation: pick `d` with `S_ν = d S_μ d⁻¹` and `d ∈ D_μ`, so
that `x_ν T_d = T_d x_μ`.  Both halves of that are already in the corpus and sorry-free:
`sortPerm`/`youngOfComp_conj_of_blockMatch` supply the `d`, and
`CompositionIntertwine.Tw_sortPerm_mul_xComp` is the intertwining identity.

What this file adds is the observation that **`T_d` is a unit** whenever `q` is (each
`σ_i` is, by the quadratic relation, and `T_d` is a product of them along a reduced
word).  That makes the conjugation *invertible*, and the conclusion correspondingly
stronger than the statement being formalised:

    a · x_μ · b  =  (a T_d⁻¹) · x_ν · (T_d b)

— **a single `ν`-term, not a combination**, and the same in the other direction.  So the
two-sided ideals generated by `x_μ` and `x_ν` are *equal*, not merely nested.

## Scope — what this is not

This is 3.9's **algebra**, at the level of `x_μ` rather than of `m_{st}`.  Passing to
`m_{st}` means indexing the two sides by row-standard tableaux, which for a *composition*
shape is vocabulary the corpus does not yet carry (`TableauPerm.dOf` is indexed by a
`YoungDiagram`, i.e. a partition).  Recorded so this is not read as the full lemma:
what is proved here is that the `μ`-side and the `ν`-side generate the same ideal, which
is the step 3.9's proof actually performs.

Note also the hypothesis `[Invertible q]`, absent everywhere upstream in this arc.  It is
genuinely needed — at `q = 0` the quadratic relation gives `σ_i² = -σ_i`, `σ_i` is not a
unit, and the conjugation argument has nothing to invert.
-/

namespace QOU.BraidKnot.CompositionIdeal

open QOU.BraidKnot.CompositionYoung QOU.BraidKnot.CompositionMinimal
open QOU.BraidKnot.CompositionMurphy QOU.BraidKnot.HeckeMurphy
open QOU.BraidKnot.CompositionIntertwine
open QOU.Hecke.TwBasis QOU.Hecke.IwahoriHecke Equiv

variable (K : Type*) [Field K] (q : K) {n : ℕ}

section Units

variable [Invertible q]

/-- Folding generator-multiplications onto a unit keeps it a unit. -/
theorem isUnit_foldl (ω : List (Fin n)) (h : QOU.Hecke.IwahoriHecke K q n)
    (hh : IsUnit h) :
    IsUnit (ω.foldl (fun a i => σ K q n i * a) h) := by
  induction ω generalizing h with
  | nil => simpa using hh
  | cons i ω ih => exact ih _ ((isUnit_σ K q n i).mul hh)

/-- **`T_w` is a unit of `H_n(q)`** whenever `q` is invertible.  `T_w` is the product of
the generators along a reduced word, and each generator is a unit by the quadratic
relation (`IwahoriHecke.isUnit_σ`). -/
theorem isUnit_Tw (w : Perm (Fin (n + 1))) : IsUnit (Tw K q n w) :=
  isUnit_foldl K q _ 1 isUnit_one

end Units

variable [Invertible q]

/-- **Mathas' Lemma 3.9, algebra half.**  Every `μ`-term is a *single* `ν`-term — the
conjugating `T_d` being invertible, no `R`-combination is needed. -/
theorem exists_xComp_swap {c c' : Composition (n + 1)} (m : BlockMatch c c')
    [DecidablePred (· ∈ youngOfComp c)] [DecidablePred (· ∈ youngOfComp c')]
    (a b : QOU.Hecke.IwahoriHecke K q n) :
    ∃ a' b' : QOU.Hecke.IwahoriHecke K q n,
      a * xComp K q c * b = a' * xComp K q c' * b' := by
  obtain ⟨u, hu⟩ := isUnit_Tw K q (sortPerm m)
  refine ⟨a * ↑u⁻¹, ↑u * b, ?_⟩
  have hkey : (u : QOU.Hecke.IwahoriHecke K q n) * xComp K q c
      = xComp K q c' * (u : QOU.Hecke.IwahoriHecke K q n) := by
    rw [hu]; exact Tw_sortPerm_mul_xComp K q m
  have hx : xComp K q c
      = (↑u⁻¹ : QOU.Hecke.IwahoriHecke K q n) * xComp K q c' * ↑u := by
    have := congrArg (fun x => (↑u⁻¹ : QOU.Hecke.IwahoriHecke K q n) * x) hkey
    simpa [← mul_assoc, Units.inv_mul] using this
  rw [hx]; noncomm_ring

/-- **The mirror direction**: every `ν`-term is a single `μ`-term. -/
theorem exists_xComp_swap' {c c' : Composition (n + 1)} (m : BlockMatch c c')
    [DecidablePred (· ∈ youngOfComp c)] [DecidablePred (· ∈ youngOfComp c')]
    (a b : QOU.Hecke.IwahoriHecke K q n) :
    ∃ a' b' : QOU.Hecke.IwahoriHecke K q n,
      a * xComp K q c' * b = a' * xComp K q c * b' := by
  obtain ⟨u, hu⟩ := isUnit_Tw K q (sortPerm m)
  refine ⟨a * ↑u, ↑u⁻¹ * b, ?_⟩
  have hkey : (u : QOU.Hecke.IwahoriHecke K q n) * xComp K q c
      = xComp K q c' * (u : QOU.Hecke.IwahoriHecke K q n) := by
    rw [hu]; exact Tw_sortPerm_mul_xComp K q m
  have hx : xComp K q c'
      = (u : QOU.Hecke.IwahoriHecke K q n) * xComp K q c * ↑u⁻¹ := by
    rw [hkey, mul_assoc, Units.mul_inv, mul_one]
  rw [hx]; noncomm_ring

end QOU.BraidKnot.CompositionIdeal
