def hecke_baer_star_generic [ctx : HeckeBaerStarGenericContext] :
    (∀ λ : ctx.PartitionIdx, ctx.mul (ctx.e λ) (ctx.e λ) = ctx.e λ) ∧
    (∀ λ : ctx.PartitionIdx,
      ctx.star (ctx.e λ) = ctx.e (ctx.conj_partition λ)) ∧
