import Mathlib.Algebra.Quaternion
import Mathlib.Geometry.Manifold.Instances.Real
import Mathlib.Geometry.Manifold.Volume
import Mathlib.MeasureTheory.Measure.MeasureSpace

/-!
# Towards the Tetraplectic Geometry of the Bring Cone

This module begins formalizing the 4-real-dimensional affine cone of Bring's curve.
Currently, it establishes the Quaternionic Twist Lie algebra of the Reeb vector fields, 
which is a necessary precursor for defining the S_5-invariant tetraplectic structure.
-/

abbrev BringCone := Quaternion ℝ

-- The SU(2) triad of Reeb vector fields on the link are generated by
-- right-multiplication of the quaternionic basis vectors (i, j, k).
def reeb_M_i (p : BringCone) : BringCone := p * (Quaternion.mk 0 1 0 0)
def reeb_M_j (p : BringCone) : BringCone := p * (Quaternion.mk 0 0 1 0)
def reeb_M_k (p : BringCone) : BringCone := p * (Quaternion.mk 0 0 0 1)

-- The Quaternionic Twist (Commutator) from Foth-Leitner (Section 3)
-- [M_x, M_y] = 2 M_{xy} for x ≠ y

lemma reeb_twist_M_ij (p : BringCone) : 
  reeb_M_j (reeb_M_i p) - reeb_M_i (reeb_M_j p) = 2 • reeb_M_k p := by
  dsimp [reeb_M_i, reeb_M_j, reeb_M_k]
  ext <;> simp <;> ring

lemma reeb_twist_M_jk (p : BringCone) : 
  reeb_M_k (reeb_M_j p) - reeb_M_j (reeb_M_k p) = 2 • reeb_M_i p := by
  dsimp [reeb_M_i, reeb_M_j, reeb_M_k]
  ext <;> simp <;> ring

lemma reeb_twist_M_ki (p : BringCone) : 
  reeb_M_i (reeb_M_k p) - reeb_M_k (reeb_M_i p) = 2 • reeb_M_j p := by
  dsimp [reeb_M_i, reeb_M_j, reeb_M_k]
  ext <;> simp <;> ring
