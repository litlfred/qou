import Mathlib.Algebra.Algebra.Basic
import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.Data.Set.Basic

/-!
# QOU.Torsion.skein_generation — Skein module is generated by torus knots + Hopf link

**Proposition** ([`prop:skein-generation`](../../../quantum-observable-universe/braids-and-knots/skein-generation.md)).

*The Skein module `𝓢_q = 𝓢_q(𝐂)` is generated as an algebra by:*

*(1) The fundamental (mass-zero) knot types `{K_i}_{i ∈ 𝓕}` (torus
knots), and*

*(2) The Hopf link `𝓛_Hopf` (the binding operation).*

*Every hadron admits a terminal Skein resolution into a finite
polynomial in these generators with coefficients in `ℤ[q^±1]`.*

The Lean encoding records the generation claim precisely using Mathlib's
`Algebra.adjoin`, capturing the substantive claim that the fundamental knots
and the Hopf link generate the entire Skein module over the coefficient ring.

-- Ref: [manuscript] quantum-observable-universe/braids-and-knots/skein-generation.md
-/

open Set

namespace QOU.Torsion

/-- Abstract context for the Skein-module generation claim. -/
class SkeinGenerationContext (R Skein FundamentalKnotIndex : Type*)
    [CommRing R] [Ring Skein] [Algebra R Skein] where
  /-- The fundamental knot embeddings `K_i ∈ 𝓢_q`. -/
  fundamentalKnot : FundamentalKnotIndex → Skein
  /-- The Hopf-link generator `𝓛_Hopf`. -/
  hopfLink : Skein
  /-- Generation hypothesis: the fundamental knots and the Hopf link
      generate the entire Skein module algebra over `R`. -/
  generation_top : Algebra.adjoin R (range fundamentalKnot ∪ {hopfLink}) = ⊤

/-- **Skein-module generation** ([`prop:skein-generation`]).

    The Skein module is generated by the fundamental torus knots
    plus the Hopf link: every hadron admits a terminal Skein
    resolution into a finite polynomial in these generators. -/
-- Ref: [manuscript] quantum-observable-universe/braids-and-knots/skein-generation.md
theorem skein_generation {R Skein FundamentalKnotIndex : Type*}
    [CommRing R] [Ring Skein] [Algebra R Skein]
    [ctx : SkeinGenerationContext R Skein FundamentalKnotIndex]
    (h : Skein) :
    h ∈ Algebra.adjoin R (range ctx.fundamentalKnot ∪ {ctx.hopfLink}) := by
  rw [ctx.generation_top]
  exact Algebra.mem_top

end QOU.Torsion
