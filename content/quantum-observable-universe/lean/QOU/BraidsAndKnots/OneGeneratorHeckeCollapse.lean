import Mathlib.Algebra.Ring.Defs
import Mathlib.Algebra.Field.Basic
import Mathlib.Tactic.Ring
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.LinearCombination

/-!
# Any product of linear factors in ONE Hecke generator is linear in that generator

`per_generator_V_hat_3A` accumulates, at a single generator position `i`, a
product of factors `c_k · σ_i + d_k` — one per step of the braid word that
touches that position.  Built naively this is a dense matrix product per step,
and `qou-9ohz` (`23b9c4f5ba`) measured it as the dominant cost of the A ≥ 3
V̂: the braid word's coefficients mix `int` and `mpf`, which promoted the
seminormal matrices to `dtype=object` and ran every `M @ M` as a Python loop —
~6e7 mpf mul+add per word-step sweep over `λ ⊢ 9`.

That commit replaced the matrix product with a **scalar recursion**, on the
stated ground that "every factor at generator i is a polynomial in the SAME
σ_i, so they commute, and σ obeys σ² = (q − q⁻¹)σ + 1".  It verified the
relation numerically against the built matrices (`6.661e-16`, against
`1.992e-01` for the `(q−1)σ + q` alternative) and shipped.

**This file is the proof of the invariant that optimisation assumes.**  A
measured `6.661e-16` says the matrices satisfy the relation at one `q` in one
arithmetic; it does not say the collapse holds.  `prod_eq_linear` says it, for
any list of factors, over any commutative ring.

## Why `CommRing` is the honest setting, and what it scopes out

`H_n(q)` is not commutative.  The subalgebra generated by a **single** `σ_i`
is, and that is precisely why this collapse works — so stating it over a
`CommRing` is not a convenience, it is the content.  It also makes the
limitation exact: nothing here licenses collapsing a product that spans two
generators, because `σ_i σ_j ≠ σ_j σ_i` for `|i − j| = 1`.  Co-location is
forced, the same scoping `AveragedCrossingCollapse` states for its special
case.

## Relation to `AveragedCrossingCollapse`

That file proves the σ-coefficient **vanishes** for the specific averaged
factor `σ + d` at `2d = -h`.  This one is the general statement: the product is
*always* linear, and `collapseStep` says what its coefficients are.  The
averaged case is then the question of when `α` happens to be zero, which is a
property of that coefficient rather than of collapsing.

## What this does NOT establish

It does not say the V̂ so computed is the *right* V̂ — `canonical_tower`'s
SCOPE section flags the per-generator definition as provisional, and that is a
separate question this file does not touch.  It says only that computing the
product by scalar recursion agrees with computing it by matrix multiplication.
-/

namespace QOU.BraidsAndKnots

variable {R : Type*} [CommRing R]

/-- The Hecke quadratic in the form the braid-word accumulator uses:
`σ² = h·σ + 1`, with `h = q - q⁻¹`.  Carried as a hypothesis rather than
built from `q`, so the statement holds for any `h` — including the `q = 1`
degeneration `h = 0`, where `σ² = 1`. -/
def IsHeckeGen (σ h : R) : Prop := σ * σ = h * σ + 1

/-- One step of the accumulator: multiplying `α·σ + β` by `c·σ + d` again
yields something linear in `σ`, with these coefficients.

    (α σ + β)(c σ + d) = α c σ² + (α d + β c) σ + β d
                       = α c (h σ + 1) + (α d + β c) σ + β d
                       = (α (c h + d) + β c) σ + (α c + β d)

This is the whole optimisation: two ring multiplications and an add per step,
independent of the irrep dimension, where the naive route is a `dim × dim`
matrix product. -/
def collapseStep (h : R) (ab : R × R) (cd : R × R) : R × R :=
  (ab.1 * (cd.1 * h + cd.2) + ab.2 * cd.1, ab.1 * cd.1 + ab.2 * cd.2)

/-- `collapseStep` is correct: it computes the product. -/
theorem collapseStep_spec {σ h : R} (hσ : IsHeckeGen σ h) (α β c d : R) :
    (α * σ + β) * (c * σ + d)
      = (collapseStep h (α, β) (c, d)).1 * σ + (collapseStep h (α, β) (c, d)).2 := by
  have hsq : σ * σ = h * σ + 1 := hσ
  simp only [collapseStep]
  calc (α * σ + β) * (c * σ + d)
      = α * c * (σ * σ) + (α * d + β * c) * σ + β * d := by ring
    _ = α * c * (h * σ + 1) + (α * d + β * c) * σ + β * d := by rw [hsq]
    _ = (α * (c * h + d) + β * c) * σ + (α * c + β * d) := by ring

/-- The accumulator over a list of factors, folded from the identity `1 = 0·σ + 1`. -/
def collapseFold (h : R) : List (R × R) → R × R :=
  List.foldl (collapseStep h) (0, 1)

/-- The product of the factors themselves, in the same order. -/
def factorProd (σ : R) : List (R × R) → R :=
  List.foldl (fun acc cd => acc * (cd.1 * σ + cd.2)) 1

/-- **The collapse.**  Any product of linear factors in one Hecke generator is
linear in that generator, with coefficients given by `collapseFold`.

This is the invariant `qou-9ohz`'s O(dim) rewrite of `per_generator_V_hat_3A`
depends on.  Proved by induction on the factor list, generalising over the
accumulator so the fold's running value is available at each step. -/
theorem prod_eq_linear {σ h : R} (hσ : IsHeckeGen σ h) (l : List (R × R)) :
    factorProd σ l = (collapseFold h l).1 * σ + (collapseFold h l).2 := by
  have key : ∀ (l : List (R × R)) (α β : R),
      List.foldl (fun acc cd => acc * (cd.1 * σ + cd.2)) (α * σ + β) l
        = (List.foldl (collapseStep h) (α, β) l).1 * σ
          + (List.foldl (collapseStep h) (α, β) l).2 := by
    intro l
    induction l with
    | nil => intro α β; simp
    | cons cd t ih =>
      intro α β
      simp only [List.foldl_cons]
      rw [collapseStep_spec hσ α β cd.1 cd.2]
      exact ih _ _
  have key0 := key l 0 1
  rw [zero_mul, zero_add] at key0
  simpa only [factorProd, collapseFold] using key0

/-- The empty product is the identity, as the fold's seed states. -/
theorem collapseFold_nil (h : R) : collapseFold h ([] : List (R × R)) = (0, 1) := rfl

/-- A single factor is returned unchanged: `c·σ + d` is already linear, so the
fold must be the identity on it.  A sanity check on `collapseStep`'s direction
— an accumulator that mangled a one-element list would be wrong in a way the
general theorem could still hide, since `prod_eq_linear` proves the fold agrees
with the product without pinning what the fold *is*. -/
theorem collapseFold_singleton (h c d : R) :
    collapseFold h [(c, d)] = (c, d) := by
  simp [collapseFold, collapseStep]

/-! ## The Markov trace of the collapsed element, and the distance to the Φ_q pole

`mass_endomorphism.additive_wedderburn_volumes` runs exactly `collapseStep`
(`a, b = a*c*HA + a*d + b*c, a*c + b*d`) and then takes the Markov trace of the
result, `Vs = z_mark * a + b`, using `tr(σ) = z` and `tr(1) = 1`.  So the whole
V̂ is an **affine function of the Markov parameter `z`**, with slope the
σ-coefficient the collapse produced.

That matters because `Φ_q(V̂) = ∏_k (1 - q^{-k} V̂)^{-1}` has a pole at
`V̂ = q`, and the 2026-08-15 owner ruling moved `z` from convention C
(`√q/(q+1) ≈ 0.4993`) to convention D (`q³/(q²+1) ≈ 0.6127`) — a 22.7 %
increase.  Bean `qou-dchz` records that several Φ_q towers which converged
under C emit `+inf` under D.

`vHat_margin` is why a convention change can do that: the margin to the pole,
measured in `z`, is the margin measured in `V̂` **divided by `α`**.  A large
σ-coefficient means a small change in the convention is a large change in the
distance to the singularity.  It is the conditioning statement, exactly. -/

/-- The Markov trace of a collapsed element `α·σ + β`, with `tr(σ) = z`,
`tr(1) = 1`.  This is `Vs = z_mark * a + b` in `additive_wedderburn_volumes`. -/
def vHat (z : R) (ab : R × R) : R := z * ab.1 + ab.2

/-- `vHat` is affine in the Markov parameter, with slope the σ-coefficient.
Changing convention moves V̂ by `Δz · α` and by nothing else. -/
theorem vHat_sub_vHat (z z' : R) (ab : R × R) :
    vHat z' ab - vHat z ab = (z' - z) * ab.1 := by
  simp only [vHat]; ring

/-- **The conditioning statement.**  The margin from the current Markov
parameter to the one that would put V̂ exactly on the Φ_q pole at `q` is the
V̂-margin divided by the σ-coefficient.

So `α` is the amplification from "how far the convention moved" to "how far the
pole moved": with `α` small the tower is insensitive to the C→D change, and with
`α` large a 22.7 % shift in `z` can cross the singularity. -/
theorem vHat_margin {R : Type*} [Field R] (q b z : R) {α : R} (hα : α ≠ 0) :
    (q - vHat z (α, b)) / α = (q - b) / α - z := by
  simp only [vHat]
  field_simp
  ring

/-- The pole is hit at exactly one Markov parameter, when the element carries a
nonzero σ-coefficient. -/
theorem vHat_eq_iff {R : Type*} [Field R] (q b : R) {α : R} (hα : α ≠ 0) (z : R) :
    vHat z (α, b) = q ↔ z = (q - b) / α := by
  simp only [vHat]
  rw [eq_div_iff hα]
  constructor
  · intro h; linear_combination h
  · intro h; linear_combination h

/-! ## Why the proton's identity coefficient equals the neutron's V̂

Measured (`tower_vhat_markov_parameter_probe`, 60 dps, agreeing to ~50 digits):
at generator 1 of the canonical atom words,

    β(proton)  =  1.088367533397188127779206958658256570732…  =  V̂(neutron).

That is not a coincidence and it is not numerology.  The two words differ in
exactly one factor.  Reading them off `atom_braid_word_3A`, both are built from
`σ + d` with `d ∈ {−h, −h/2}`, and at generator 1

    proton   = (σ − h)³ · (σ − h/2)
    neutron  = (σ − h)³ · (σ − h),

so the question is what changes when the last factor's `d` moves from `−h/2` to
`−h`.  `d = −h/2` is precisely `AveragedCrossingCollapse`'s averaged crossing,
the value `2d = −h` at which the σ-coefficient vanishes.

`identity_coeff_avg_eq_trace_full` answers it in general: **appending the
averaged factor and reading off the identity coefficient is the same operation
as appending the full factor and taking the Markov trace.**  Both compute
`α − β·h/2`.  The measured equality is that identity at `x = (σ − h)³`, and it
holds for every `x`, over any field — nothing about this particular word, this
`q`, or this atom enters. -/

/-- Appending the **averaged** factor `σ − h/2` and taking the identity
coefficient equals appending the **full** factor `σ − h` and taking the Markov
trace at `z = h/2`.

The `h/2` in the trace is not a free choice: it is the Markov parameter forced
by `markov_param_eq_half_h` for any normalised transpose-symmetric weighting,
which is what the production weight scheme is. -/
theorem identity_coeff_avg_eq_trace_full
    {R : Type*} [Field R] (h : R) (two_ne : (2 : R) ≠ 0) (x : R × R) :
    (collapseStep h x (1, -(h / 2))).2
      = vHat (h / 2) (collapseStep h x (1, -h)) := by
  simp only [collapseStep, vHat]
  field_simp
  ring

/-! ## The inter-nucleon generator contributes exactly the colour weighting

`atom_braid_word_3A`'s docstring states its crossing template:
`{0, −h, −h/2, −h(½ − δ/4)}` with `δ = flavor_split_leading(q)`.  The first
three are the ones the intra-nucleon chains use.  The fourth appears **once** in
the whole deuteron word — at the single inter-nucleon generator — and is the
colour-weighted p–n interface (`pn_convention = "bring_color_weighted"`, made
canonical by the owner ruling of 2026-08-15, R3).  Its colour-blind sibling is
`strict_averaged`, i.e. `δ = 0`, which is the averaged crossing `−h/2`.

That generator carries a single factor, so its collapse is the factor itself and
its V̂ is computable in closed form.  `inter_nucleon_vHat` does it: the answer is
`h·δ/4`, and in particular it is **zero** when `δ = 0`.

So under the colour-blind convention the inter-nucleon generator contributes
nothing to the tower at all, and everything it does contribute is the colour
weighting.  Measured at 50 dps: `V̂ = 7.190162809336869…e-5`, which is the
7.19e-5 by which that generator's `d` sits away from `−h/2`. -/

/-- The single-factor inter-nucleon generator's V̂ is exactly `h·δ/4`.

`δ = 0` is the colour-blind `strict_averaged` convention, and there the
contribution vanishes identically — the p–n interface reaches the tower only
through the colour weighting. -/
theorem inter_nucleon_vHat {R : Type*} [Field R] (h δ : R) (four_ne : (4 : R) ≠ 0) :
    vHat (h / 2) (collapseStep h (0, 1) (1, -(h * (1 / 2 - δ / 4))))
      = h * δ / 4 := by
  have two_ne : (2 : R) ≠ 0 := fun hc => four_ne (by rw [show (4:R) = 2*2 by norm_num, hc]; ring)
  simp only [collapseStep, vHat]
  field_simp
  ring

/-! ## The Markov parameter `h/2` averages the two Hecke eigenvalues — and what that
costs the tower

Measured (`tower_vhat_chain_length_pole_margin_probe`): across every atom from
A = 1 to A = 16, `per_generator_V_hat_3A`'s per-generator V̂ takes only **seven**
distinct values, and `max |V̂|` **saturates** — it is `1.0883675333971881278`
(98.05 % of `q`) for every atom containing a neutron, already at A = 1, and
never grows with nucleon count.  (A proton-only system sits strictly further
out, at `1.0551103188317245612`: the neutron's `dd` pair contributes a further
`σ⁻¹` where the proton's `uu` pair contributes a `σ`.)  Reading the seven off,
they are collapses of

    σ⁻⁴,  σ⁻³·avg,  σ⁴·avg·σ²,  σ³·avg²·σ²,  σ⁻¹,  σ,  and the colour-weighted avg

where `σ⁻¹ = σ − h` (the skein relation: `σ(σ − h) = σ² − hσ = 1`, immediate from
`IsHeckeGen`) and `avg = σ − h/2 = (σ + σ⁻¹)/2` is the averaged crossing.  The
maximum is attained at the pure chain `σ⁻⁴`.

`vHat_half_h_eq_avg_evals` is why that chain has a closed form, and is the
conceptual content of `markov_param_eq_half_h` in the other file: at `z = h/2`
with `h = q − q⁻¹`, the Markov trace is exactly the **average of the two Hecke
eigenvalue evaluations** `σ ↦ q` and `σ ↦ −q⁻¹`.  (That is also why
transpose-pairing forced `h/2` there: transposition swaps the two eigenvalues,
so pairing averages them.)

Since `prod_eq_linear` says each evaluation is multiplicative, the chain's value
follows immediately, and `vHat_invChain` records it:

    V̂ₙ  =  ((q⁻¹)ⁿ + (−q)ⁿ) / 2.

**The consequence is sharp and is not comfortable.**  `|(−q)ⁿ|` grows like `qⁿ`,
so `|V̂ₙ| → ∞` and only finitely many chain lengths keep `Φ_q` finite at all.
Measured at the substrate `q`:

    n = 4   |V̂|/q = 0.98053   ← the length the word actually uses
    n = 5   |V̂|/q = 0.49163
    n = 6   |V̂|/q = 1.08331   ← PAST THE POLE

So `n = 4` is the last even chain length for which the tower is defined, and one
further same-sign crossing pair diverges it.  What that does **not** say is that
the 4 is tuned: it is `3 + 1`, three from the `B₃` closure and one from the
quark pair, and both are fixed by the construction upstream of any of this.
What it does say is that the 1.95 % margin is the whole of the headroom, and
that it is a fact about the chain length rather than robustness. -/

/-- Evaluation of a collapsed element `α·σ + β` at a **scalar** root of the same
Hecke quadratic.  `IsHeckeGen s h` is reused deliberately: `q` and `−q⁻¹` satisfy
`s² = h·s + 1` for `h = q − q⁻¹` exactly as the generator does, which is what
makes the evaluations multiplicative. -/
def evalAt (s : R) (ab : R × R) : R := ab.1 * s + ab.2

/-- Both Hecke eigenvalues are roots of the generator's own quadratic. -/
theorem isHeckeGen_q {R : Type*} [Field R] {q : R} (hq : q ≠ 0) :
    IsHeckeGen q (q - q⁻¹) ∧ IsHeckeGen (-q⁻¹) (q - q⁻¹) := by
  constructor <;> · simp only [IsHeckeGen]; field_simp; ring

/-- **The Markov parameter `h/2` is the average of the two eigenvalue
evaluations.**  This is the conceptual content of `markov_param_eq_half_h`:
transposing a shape swaps `q` and `−q⁻¹`, so pairing shapes with their
transposes averages the two, and `h/2` is that average. -/
theorem vHat_half_h_eq_avg_evals {R : Type*} [Field R] {q : R} (hq : q ≠ 0)
    (two_ne : (2 : R) ≠ 0) (ab : R × R) :
    vHat ((q - q⁻¹) / 2) ab = (evalAt q ab + evalAt (-q⁻¹) ab) / 2 := by
  simp only [vHat, evalAt]
  field_simp
  ring

/-- The `σ⁻¹` chain of length `n`: `σ⁻ⁿ`, since `σ − h = σ⁻¹`. -/
def invChain (h : R) (n : ℕ) : R × R :=
  collapseFold h (List.replicate n (1, -h))

/-- `σ(σ − h) = 1` — the skein relation, and the reason `σ − h` is `σ⁻¹`. -/
theorem sigma_mul_sub_h {σ h : R} (hσ : IsHeckeGen σ h) : σ * (σ - h) = 1 := by
  have : σ * σ = h * σ + 1 := hσ
  linear_combination this

/-- A repeated factor evaluates to a power. -/
theorem factorProd_replicate (σ : R) (cd : R × R) (n : ℕ) :
    factorProd σ (List.replicate n cd) = (cd.1 * σ + cd.2) ^ n := by
  have key : ∀ (m : ℕ) (acc : R),
      List.foldl (fun a e => a * (e.1 * σ + e.2)) acc (List.replicate m cd)
        = acc * (cd.1 * σ + cd.2) ^ m := by
    intro m
    induction m with
    | zero => intro acc; simp
    | succ k ih =>
      intro acc
      rw [List.replicate_succ, List.foldl_cons, ih]
      ring
  simpa [factorProd] using key n 1

/-- **The closed form.**  `V̂ₙ = ((q⁻¹)ⁿ + (−q)ⁿ)/2`.

Because `|−q| > 1` at the substrate, this grows without bound: only finitely
many chain lengths leave `|V̂ₙ| < q`, and the production word's `n = 4` is the
last even one.  The 1.95 % margin between `V̂₄` and the `Φ_q` pole is therefore
the whole of the headroom — see the section note above for what this does and
does not say about the choice of 4. -/
theorem vHat_invChain {R : Type*} [Field R] {q : R} (hq : q ≠ 0)
    (two_ne : (2 : R) ≠ 0) (n : ℕ) :
    vHat ((q - q⁻¹) / 2) (invChain (q - q⁻¹) n)
      = ((q⁻¹) ^ n + (-q) ^ n) / 2 := by
  obtain ⟨hgq, hgn⟩ := isHeckeGen_q (R := R) hq
  rw [vHat_half_h_eq_avg_evals hq two_ne]
  have e₁ : evalAt q (invChain (q - q⁻¹) n) = (q⁻¹) ^ n := by
    have := prod_eq_linear hgq (List.replicate n ((1 : R), -(q - q⁻¹)))
    simp only [evalAt, invChain]
    rw [← this, factorProd_replicate]
    congr 1
    field_simp
    ring
  have e₂ : evalAt (-q⁻¹) (invChain (q - q⁻¹) n) = (-q) ^ n := by
    have := prod_eq_linear hgn (List.replicate n ((1 : R), -(q - q⁻¹)))
    simp only [evalAt, invChain]
    rw [← this, factorProd_replicate]
    congr 1
    field_simp
    ring
  rw [e₁, e₂]

end QOU.BraidsAndKnots
