import Mathlib.Algebra.Ring.Defs
import Mathlib.Algebra.Field.Basic
import Mathlib.Tactic.Ring
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.LinearCombination

/-!
# Any product of linear factors in ONE Hecke generator is linear in that generator

`per_generator_V_hat_3A` accumulates, at a single generator position `i`, a
product of factors `c_k · σ_i + d_k` — one per step of the braid word that
touches that position.  Built naively this is a dense matrix product per step,
and `qou-9ohz` (`23b9c4f5ba`) measured it as the dominant cost of the A ≥ 3
V̂: the braid word's coefficients mix `int` and `mpf`, which promoted the
seminormal matrices to `dtype=object` and ran every `M @ M` as a Python loop —
~6e7 mpf mul+add per word-step sweep over `λ ⊢ 9`.

That commit replaced the matrix product with a **scalar recursion**, on the
stated ground that "every factor at generator i is a polynomial in the SAME
σ_i, so they commute, and σ obeys σ² = (q − q⁻¹)σ + 1".  It verified the
relation numerically against the built matrices (`6.661e-16`, against
`1.992e-01` for the `(q−1)σ + q` alternative) and shipped.

**This file is the proof of the invariant that optimisation assumes.**  A
measured `6.661e-16` says the matrices satisfy the relation at one `q` in one
arithmetic; it does not say the collapse holds.  `prod_eq_linear` says it, for
any list of factors, over any commutative ring.

## Why `CommRing` is the honest setting, and what it scopes out

`H_n(q)` is not commutative.  The subalgebra generated by a **single** `σ_i`
is, and that is precisely why this collapse works — so stating it over a
`CommRing` is not a convenience, it is the content.  It also makes the
limitation exact: nothing here licenses collapsing a product that spans two
generators, because `σ_i σ_j ≠ σ_j σ_i` for `|i − j| = 1`.  Co-location is
forced, the same scoping `AveragedCrossingCollapse` states for its special
case.

## Relation to `AveragedCrossingCollapse`

That file proves the σ-coefficient **vanishes** for the specific averaged
factor `σ + d` at `2d = -h`.  This one is the general statement: the product is
*always* linear, and `collapseStep` says what its coefficients are.  The
averaged case is then the question of when `α` happens to be zero, which is a
property of that coefficient rather than of collapsing.

## What this does NOT establish

It does not say the V̂ so computed is the *right* V̂ — `canonical_tower`'s
SCOPE section flags the per-generator definition as provisional, and that is a
separate question this file does not touch.  It says only that computing the
product by scalar recursion agrees with computing it by matrix multiplication.
-/

namespace QOU.BraidsAndKnots

variable {R : Type*} [CommRing R]

/-- The Hecke quadratic in the form the braid-word accumulator uses:
`σ² = h·σ + 1`, with `h = q - q⁻¹`.  Carried as a hypothesis rather than
built from `q`, so the statement holds for any `h` — including the `q = 1`
degeneration `h = 0`, where `σ² = 1`. -/
def IsHeckeGen (σ h : R) : Prop := σ * σ = h * σ + 1

/-- One step of the accumulator: multiplying `α·σ + β` by `c·σ + d` again
yields something linear in `σ`, with these coefficients.

    (α σ + β)(c σ + d) = α c σ² + (α d + β c) σ + β d
                       = α c (h σ + 1) + (α d + β c) σ + β d
                       = (α (c h + d) + β c) σ + (α c + β d)

This is the whole optimisation: two ring multiplications and an add per step,
independent of the irrep dimension, where the naive route is a `dim × dim`
matrix product. -/
def collapseStep (h : R) (ab : R × R) (cd : R × R) : R × R :=
  (ab.1 * (cd.1 * h + cd.2) + ab.2 * cd.1, ab.1 * cd.1 + ab.2 * cd.2)

/-- `collapseStep` is correct: it computes the product. -/
theorem collapseStep_spec {σ h : R} (hσ : IsHeckeGen σ h) (α β c d : R) :
    (α * σ + β) * (c * σ + d)
      = (collapseStep h (α, β) (c, d)).1 * σ + (collapseStep h (α, β) (c, d)).2 := by
  have hsq : σ * σ = h * σ + 1 := hσ
  simp only [collapseStep]
  calc (α * σ + β) * (c * σ + d)
      = α * c * (σ * σ) + (α * d + β * c) * σ + β * d := by ring
    _ = α * c * (h * σ + 1) + (α * d + β * c) * σ + β * d := by rw [hsq]
    _ = (α * (c * h + d) + β * c) * σ + (α * c + β * d) := by ring

/-- The accumulator over a list of factors, folded from the identity `1 = 0·σ + 1`. -/
def collapseFold (h : R) : List (R × R) → R × R :=
  List.foldl (collapseStep h) (0, 1)

/-- The product of the factors themselves, in the same order. -/
def factorProd (σ : R) : List (R × R) → R :=
  List.foldl (fun acc cd => acc * (cd.1 * σ + cd.2)) 1

/-- **The collapse.**  Any product of linear factors in one Hecke generator is
linear in that generator, with coefficients given by `collapseFold`.

This is the invariant `qou-9ohz`'s O(dim) rewrite of `per_generator_V_hat_3A`
depends on.  Proved by induction on the factor list, generalising over the
accumulator so the fold's running value is available at each step. -/
theorem prod_eq_linear {σ h : R} (hσ : IsHeckeGen σ h) (l : List (R × R)) :
    factorProd σ l = (collapseFold h l).1 * σ + (collapseFold h l).2 := by
  have key : ∀ (l : List (R × R)) (α β : R),
      List.foldl (fun acc cd => acc * (cd.1 * σ + cd.2)) (α * σ + β) l
        = (List.foldl (collapseStep h) (α, β) l).1 * σ
          + (List.foldl (collapseStep h) (α, β) l).2 := by
    intro l
    induction l with
    | nil => intro α β; simp
    | cons cd t ih =>
      intro α β
      simp only [List.foldl_cons]
      rw [collapseStep_spec hσ α β cd.1 cd.2]
      exact ih _ _
  have key0 := key l 0 1
  rw [zero_mul, zero_add] at key0
  simpa only [factorProd, collapseFold] using key0

/-- The empty product is the identity, as the fold's seed states. -/
theorem collapseFold_nil (h : R) : collapseFold h ([] : List (R × R)) = (0, 1) := rfl

/-- A single factor is returned unchanged: `c·σ + d` is already linear, so the
fold must be the identity on it.  A sanity check on `collapseStep`'s direction
— an accumulator that mangled a one-element list would be wrong in a way the
general theorem could still hide, since `prod_eq_linear` proves the fold agrees
with the product without pinning what the fold *is*. -/
theorem collapseFold_singleton (h c d : R) :
    collapseFold h [(c, d)] = (c, d) := by
  simp [collapseFold, collapseStep]

/-! ## The Markov trace of the collapsed element, and the distance to the Φ_q pole

`mass_endomorphism.additive_wedderburn_volumes` runs exactly `collapseStep`
(`a, b = a*c*HA + a*d + b*c, a*c + b*d`) and then takes the Markov trace of the
result, `Vs = z_mark * a + b`, using `tr(σ) = z` and `tr(1) = 1`.  So the whole
V̂ is an **affine function of the Markov parameter `z`**, with slope the
σ-coefficient the collapse produced.

That matters because `Φ_q(V̂) = ∏_k (1 - q^{-k} V̂)^{-1}` has a pole at
`V̂ = q`, and the 2026-08-15 owner ruling moved `z` from convention C
(`√q/(q+1) ≈ 0.4993`) to convention D (`q³/(q²+1) ≈ 0.6127`) — a 22.7 %
increase.  Bean `qou-dchz` records that several Φ_q towers which converged
under C emit `+inf` under D.

`vHat_margin` is why a convention change can do that: the margin to the pole,
measured in `z`, is the margin measured in `V̂` **divided by `α`**.  A large
σ-coefficient means a small change in the convention is a large change in the
distance to the singularity.  It is the conditioning statement, exactly. -/

/-- The Markov trace of a collapsed element `α·σ + β`, with `tr(σ) = z`,
`tr(1) = 1`.  This is `Vs = z_mark * a + b` in `additive_wedderburn_volumes`. -/
def vHat (z : R) (ab : R × R) : R := z * ab.1 + ab.2

/-- `vHat` is affine in the Markov parameter, with slope the σ-coefficient.
Changing convention moves V̂ by `Δz · α` and by nothing else. -/
theorem vHat_sub_vHat (z z' : R) (ab : R × R) :
    vHat z' ab - vHat z ab = (z' - z) * ab.1 := by
  simp only [vHat]; ring

/-- **The conditioning statement.**  The margin from the current Markov
parameter to the one that would put V̂ exactly on the Φ_q pole at `q` is the
V̂-margin divided by the σ-coefficient.

So `α` is the amplification from "how far the convention moved" to "how far the
pole moved": with `α` small the tower is insensitive to the C→D change, and with
`α` large a 22.7 % shift in `z` can cross the singularity. -/
theorem vHat_margin {R : Type*} [Field R] (q b z : R) {α : R} (hα : α ≠ 0) :
    (q - vHat z (α, b)) / α = (q - b) / α - z := by
  simp only [vHat]
  field_simp
  ring

/-- The pole is hit at exactly one Markov parameter, when the element carries a
nonzero σ-coefficient. -/
theorem vHat_eq_iff {R : Type*} [Field R] (q b : R) {α : R} (hα : α ≠ 0) (z : R) :
    vHat z (α, b) = q ↔ z = (q - b) / α := by
  simp only [vHat]
  rw [eq_div_iff hα]
  constructor
  · intro h; linear_combination h
  · intro h; linear_combination h

end QOU.BraidsAndKnots
