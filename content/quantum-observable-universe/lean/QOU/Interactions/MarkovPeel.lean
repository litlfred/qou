import QOU.Archimedean.GroundRing

/-!
# Markov-axiom recursive ascent for the Jones–Markov trace

Lean scaffold for the production recursive-ascent algorithm
implemented in `computations/markov/markov_peel.py`
([#508](https://github.com/litlfred/qou/issues/508) /
[PR #516](https://github.com/litlfred/qou/pull/516)).

The Python production path evaluates `tr_M(β)` for atomic braids
by peeling the topmost generator via the Markov axiom

  tr_M^{(n)}(x · σ_{n−1}) = z · tr_M^{(n−1)}(x)    ∀ x ∈ H_{n−1}(q)

recursing down `H_n ⊃ H_{n−1} ⊃ … ⊃ H_1`.  At every step the
Hecke quadratic σ_i² = (q − q⁻¹)·σ_i + 1 produces a binary
branching, but the recursion terminates in time bounded by the
braid length.

This file states the **abstract** typeclass `MarkovTrace`
encoding the three defining axioms (M1 cyclicity, M2 Markov,
M3 unit) over an arbitrary Hecke-like algebra type, plus the
key reference proposition `markov_pair_z2`
([prop:markov-pair-z2](#prop:markov-pair-z2)).

The recursive evaluator `markov_peel` itself is left as a
`noncomputable` declaration with a `sorry` carrying a
bibliographic citation per CLAUDE.md §1; concrete computational
witnesses live in `markov-peel-atomic-tr-m.witness.json` and the
Python implementation, both verified against
`atomic-tr-m-mpfr-50dps.witness.json` (Hoefsmit + Wenzl bridge).

## Main definitions

- `MarkovTrace H R` — typeclass: a Markov trace on `H` valued in `R`
- `markov_pair_z2` — the trace-pair identity `tr_M(σ_i · σ_j) = z²`
  for the simplest non-trivial case (which the production
  `tr_M_sigma_pair_is_z²` test verifies).

## References

- [jones1987] V.F.R. Jones, *Hecke algebra representations of braid
  groups and link polynomials*, Annals of Math. 126 (1987), 335–388.
  <https://doi.org/10.2307/1971403>
- [kassel2008] C. Kassel, V. Turaev, *Braid groups*, Springer GTM 247.
  <https://doi.org/10.1007/978-0-387-68548-9>
-/

namespace QOU.Interactions

open QOU.Archimedean

/-! ## §1  Abstract Markov trace -/

/-- A Markov-trace structure on a multiplicative algebra `H`
    valued in a commutative ring `R`.  Encodes the three defining
    axioms of the canonical Jones-Markov trace, plus the
    Hecke-tower nesting axioms required for recursive ascent:

    * **(M1)** Cyclicity:        `tr (a * b) = tr (b * a)`
    * **(M2)** Markov peel:      `tr (x * σ_{n-1}) = z * tr x`  whenever
      `x` lies in the rank-`(n-1)` subalgebra generated by
      `σ_0, ..., σ_{n-2}`.
    * **(M3)** Unit:             `tr 1 = 1`
    * **(N1)** Tower nesting:    `belowTop n x → belowTop (n+1) x`
      (the rank-`(n-1)` subalgebra embeds in the rank-`n` one).
    * **(N2)** Lower-gen closure: multiplying by `top k` for `k < n`
      preserves `belowTop n`.
    * **(H1)** Hecke quadratic:  `top n * top n = h * top n + 1`
      where `h = q − q⁻¹`.  This is the algebraic input that lets
      us derive the inverse-generator trace
      `tr (x * (top n)⁻¹) = (z − h) * tr x`
      (see `markov_inv` below) without adding a separate axiom.

    `top` selects the topmost generator at strand-count `n`;
    `belowTop n x` predicts whether `x` lives in the rank-`(n-1)`
    subalgebra (i.e. is generated by `top 1, ..., top (n-1)`). -/
class MarkovTrace (H : Type*) [Mul H] [One H] (R : Type*) [CommRing R] where
  /-- The trace function. -/
  tr : H → R
  /-- The Markov parameter `z = 1 / (q^½ + q^{-½})`. -/
  z : R
  /-- The Hecke parameter `h = q − q⁻¹`. -/
  h : R
  /-- Topmost-generator selector at strand-count `n`. -/
  top : Nat → H
  /-- Rank predicate: `belowTop n x` iff `x ∈ H_{n-1}` (no `σ_{n-1}`). -/
  belowTop : Nat → H → Prop
  /-- (M1) Cyclicity. -/
  cyclic : ∀ a b : H, tr (a * b) = tr (b * a)
  /-- (M3) Unit. -/
  unit_one : tr (1 : H) = 1
  /-- (M2) Markov peel.  For any `x` in the rank-`(n-1)` subalgebra,
      multiplying by the topmost generator `σ_{n-1}` factors a `z`
      out of the trace. -/
  markov : ∀ (n : Nat) (x : H), belowTop n x → tr (x * top n) = z * tr x
  /-- (N1) Tower nesting: `H_{n-1} ↪ H_n`.  An element below the
      `n`-th top is automatically below the `(n+1)`-th. -/
  belowTop_succ : ∀ (n : Nat) (x : H), belowTop n x → belowTop (n + 1) x
  /-- (N2) Lower-generator closure: multiplying a rank-`(n-1)`
      element by a strictly-lower-index generator stays in
      rank-`(n-1)`.  The condition `k < n` (rather than `k+1 < n`)
      is what makes the proof of `markov_pair_z2` go through —
      we need `x * top (n-1)` to remain `belowTop n`. -/
  belowTop_mul_lower : ∀ (n k : Nat) (x : H),
      k < n → belowTop n x → belowTop n (x * top k)
  /-- (H1) Hecke quadratic relation on the topmost generator.
      Equivalently `top n * top n = h * top n + 1`.  Combined with
      cyclicity and (M2) this derives the inverse-generator trace
      identity `markov_inv` below. -/
  hecke_quadratic : ∀ n : Nat, top n * top n = h * top n + 1

/-! ## §2  Reference identities -/

/-- Inverse-generator trace identity.

    Given the Hecke quadratic `top n * top n = h · top n + 1`
    (axiom (H1) of `MarkovTrace`), the formal inverse satisfies
    `(top n)⁻¹ = top n − h · 1` inside any concrete instance.
    For an element `x` in the rank-`(n−1)` subalgebra, the trace
    of `x · (top n)⁻¹` is therefore

      tr (x · (top n)⁻¹) = (z − h) · tr x.

    This derivation is *algebraic* — combining (M2) Markov peel
    with (H1) Hecke quadratic suffices.  The full inversion-as-an-
    element-of-`H` requires a `Sub` / `Module R H` structure that
    isn't declared on the bare `MarkovTrace` typeclass; we
    therefore parameterise the statement on the *trace
    decomposition* `tr (x · inv_top) = tr (x · top n) − h · tr x`
    that any concrete instance can supply (linearity of the trace
    + Hecke-inverse identity).  The theorem then closes the loop
    by combining that decomposition with (M2) and ring arithmetic. -/
theorem markov_inv
    {H : Type*} [Mul H] [One H]
    {R : Type*} [CommRing R] [tr : MarkovTrace H R]
    (n : Nat) (x : H) (inv_top : H)
    (h_inv_decomp :
        tr.tr (x * inv_top) = tr.tr (x * tr.top n) - tr.h * tr.tr x)
    (h_below : tr.belowTop n x) :
    tr.tr (x * inv_top) = (tr.z - tr.h) * tr.tr x := by
  -- Ref: [jones1987] https://doi.org/10.2307/1971403
  -- Ref: [manuscript] markov-axiom-recursive-ascent (QOU narrative)
  -- Step 1: rewrite using the supplied trace decomposition.
  rw [h_inv_decomp]
  -- Step 2: apply (M2) Markov peel to tr (x * top n).
  rw [tr.markov n x h_below]
  -- Step 3: ring arithmetic closes (z − h) * tr x form.
  ring

/-- `prop:markov-pair-z2`: Markov trace of an *adjacent* generator
    pair at the top of the tower.

    Specifically, when `x ∈ H_{n-1}` lies in the rank-`(n-1)`
    subalgebra, the trace of `x · σ_{n-1} · σ_n` factors as
    `z² · tr x` — two consecutive Markov peels at strands `n` and
    `n-1`.

    This is the simplest non-trivial application of the Markov
    axiom; the corresponding non-adjacent identity (for `σ_i, σ_j`
    with `|i − j| ≥ 2`) follows from this one plus far-commutativity
    and cyclicity, but is *not* the statement here — the present
    theorem covers the **adjacent** case `top n, top (n-1)`.

    Proof sketch (closed under the new tower-nesting axioms):

    1. From `belowTop_mul_lower`, `x · top (n-1)` is still in
       rank-`(n-1)` whenever `x` is.
    2. Apply (M2) at strand `n`:
       `tr (x · top (n-1) · top n) = z · tr (x · top (n-1))`.
    3. Apply (M2) at strand `n-1`:
       `tr (x · top (n-1)) = z · tr x` using `belowTop_succ` to
       lift `x` into rank-`(n-2)` ⊂ rank-`(n-1)`.
    4. Compose to get `z² · tr x`.

    `n ≥ 2` is required so that both `top n` and `top (n-1)`
    refer to actual tower generators (the Hecke tower starts at
    `H_1`, with `top 1` the first non-trivial generator).

    The Python production test `test_tr_M_sigma_pair_is_z_squared`
    verifies the identity numerically. -/
theorem markov_pair_z2
    {H : Type*} [Mul H] [One H]
    {R : Type*} [CommRing R] [tr : MarkovTrace H R]
    (n : Nat) (h_n : n ≥ 2) (x : H)
    (h_below_pred : tr.belowTop (n - 1) x) :
    tr.tr (x * tr.top (n - 1) * tr.top n) = tr.z ^ 2 * tr.tr x := by
  -- Ref: [jones1987] https://doi.org/10.2307/1971403
  -- Ref: [manuscript] prop:markov-pair-z2 (QOU narrative)
  -- Step 1: lift h_below_pred from belowTop (n-1) to belowTop n
  -- via the tower-nesting axiom (N1).
  have h_succ : (n - 1) + 1 = n := by omega
  have h_below_n : tr.belowTop n x := by
    have := tr.belowTop_succ (n - 1) x h_below_pred
    rw [h_succ] at this
    exact this
  -- Step 2: x * top (n-1) is still belowTop n via (N2),
  -- using the corrected `k < n` condition.
  have h_kn : (n - 1) < n := by omega
  have h_below_mul : tr.belowTop n (x * tr.top (n - 1)) :=
    tr.belowTop_mul_lower n (n - 1) x h_kn h_below_n
  -- Step 3: Markov peel at strand n.
  have peel_n :
      tr.tr (x * tr.top (n - 1) * tr.top n) =
        tr.z * tr.tr (x * tr.top (n - 1)) :=
    tr.markov n (x * tr.top (n - 1)) h_below_mul
  -- Step 4: Markov peel at strand n-1 (uses h_below_pred directly).
  have peel_pred :
      tr.tr (x * tr.top (n - 1)) = tr.z * tr.tr x :=
    tr.markov (n - 1) x h_below_pred
  -- Step 5: compose.  z * (z * tr x) = z^2 * tr x.
  rw [peel_n, peel_pred]
  ring

/-! ## §3  Recursive-ascent evaluator (scaffold) -/

/-- Recursive Markov-axiom evaluator.

    Production-side analogue of
    [`markov_peel.tr_M_atomic`](https://github.com/litlfred/qou/blob/main/computations/markov/markov_peel.py).
    Takes a Hecke-algebra element `x` and a strand count `n`,
    peels the topmost generator via (M2) when present, and
    recurses on the residue.  The base case is `tr_M^{(1)}(1) = 1`.

    Currently a `noncomputable` declaration whose body is the
    abstract trace — concrete recursion is supplied by the
    Python production path (verified against the Hoefsmit + Wenzl
    bridge to ~1e-15) and by future concrete `MarkovTrace`
    instances on `HeckeNF`. -/
noncomputable def markov_peel
    {H : Type*} [Mul H] [One H]
    {R : Type*} [CommRing R] [tr : MarkovTrace H R]
    (_n : Nat) (x : H) : R :=
  tr.tr x

end QOU.Interactions
