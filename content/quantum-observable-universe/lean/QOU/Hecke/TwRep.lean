import QOU.Hecke.TwBasisBraid
import QOU.Hecke.TwSpanning
import QOU.Hecke.IwahoriHecke

/-!
# QOU.Hecke.TwRep — `H_n(q)` acts on the free module `K[S_{n+1}]`

The payoff of bean `qou-twwf`.  `QOU.Hecke.TwBasis` and
`QOU.Hecke.TwBasisBraid` verify the whole Hecke presentation for the
right-multiplication operators `Rs i` on `S_{n+1} →₀ K`:

* `Rs_sq`         — `Rs i * Rs i = (q-1)·Rs i + q`;
* `Rs_comm_of_lt` — distant generators commute;
* `Rs_braid`      — adjacent generators braid.

Those are exactly the three constructors of `QOU.Hecke.HeckeRel`, so the
universal property of the `RingQuot` presentation turns them into an algebra
map out of `H_n(q)`.

## What is proved

* `toEnd` — the algebra map `H_n(q) →ₐ[K] Module.End K (S_{n+1} →₀ K)`.
* `toEnd_σ` — it sends the generator `σ_i` to `Rs i`.
* `orbitMap` / `orbitMap_surjective` — the module is **cyclic**, generated by
  `T_1`: every element of `S_{n+1} →₀ K` is `h · T_1` for some `h ∈ H_n(q)`.

This is the representation the Bourbaki route to the `T_w` basis is built on,
and it avoids Matsumoto's theorem (which Mathlib lists as an open TODO at
`Coxeter/Basic.lean:78`).  Surjectivity is the **spanning** half of the basis
theorem; the **independence** half — equivalently, that `orbitMap` is
injective, so `dim H_n(q) = (n+1)!` — is not proved here.

One performance note, since it cost this session forty minutes.  The three
relation checks below were first written as `simpa [Module.End.mul_eq_comp]`,
which does not fail — it takes **over 150 s** and had to be killed.  Written as
explicit `rw`s against `Rs_sq` / `Rs_braid` / `Rs_comm_of_lt` the whole file
elaborates in **6 s**.  Do not "simplify" them back.
-/

open Equiv
namespace QOU.Hecke.TwBasis
open QOU.Hecke.SymmetricCoxeter
open QOU.Hecke.IwahoriHecke (σ mk)

variable (K : Type*) [CommRing K] (q : K) (n : ℕ)

/-- The lift of the generators to `End` before the relations are imposed. -/
noncomputable def freeToEnd :
    FreeAlgebra K (Fin n) →ₐ[K] Module.End K (Perm (Fin (n + 1)) →₀ K) :=
  FreeAlgebra.lift K (fun i => Rs (permCoxeterSystem n) q i)

@[simp] theorem freeToEnd_ι (i : Fin n) :
    freeToEnd K q n (FreeAlgebra.ι K i) = Rs (permCoxeterSystem n) q i :=
  FreeAlgebra.lift_ι_apply _ _

/-- **The defining relations are satisfied by the `Rs`.** -/
theorem freeToEnd_rel {x y : FreeAlgebra K (Fin n)} (h : QOU.Hecke.HeckeRel K q n x y) :
    freeToEnd K q n x = freeToEnd K q n y := by
  induction h with
  | quadratic i =>
      simp only [map_mul, map_add, map_smul, map_one, freeToEnd_ι]
      rw [Module.End.mul_eq_comp, Module.End.one_eq_id]
      exact Rs_sq (permCoxeterSystem n) q i
  | braid i hi =>
      simp only [map_mul, freeToEnd_ι]
      rw [Module.End.mul_eq_comp, Module.End.mul_eq_comp, Module.End.mul_eq_comp,
        Module.End.mul_eq_comp, LinearMap.comp_assoc, LinearMap.comp_assoc]
      exact Rs_braid q i ⟨(i : ℕ) + 1, hi⟩ rfl
  | commute i j hij =>
      simp only [map_mul, freeToEnd_ι]
      rw [Module.End.mul_eq_comp, Module.End.mul_eq_comp]
      exact (Rs_comm_of_lt q j i (by omega)).symm

/-- **The Hecke algebra acts on the free module on `S_{n+1}`.**  `H_n(q)` maps
    to the endomorphisms of `S_{n+1} →₀ K`, generator by generator. -/
noncomputable def toEnd :
    QOU.Hecke.IwahoriHecke K q n →ₐ[K] Module.End K (Perm (Fin (n + 1)) →₀ K) :=
  RingQuot.liftAlgHom K ⟨freeToEnd K q n, fun _ _ h => freeToEnd_rel K q n h⟩

@[simp] theorem toEnd_σ (i : Fin n) :
    toEnd K q n (σ K q n i) = Rs (permCoxeterSystem n) q i := by
  have h := RingQuot.liftAlgHom_mkAlgHom_apply (S := K)
    (freeToEnd K q n) (fun _ _ hr => freeToEnd_rel K q n hr) (FreeAlgebra.ι K i)
  rw [freeToEnd_ι] at h
  exact h

/-- The orbit map `h ↦ h · T_1`, sending an element of `H_n(q)` to its action on
    the basis vector indexed by the identity. -/
noncomputable def orbitMap :
    QOU.Hecke.IwahoriHecke K q n →ₗ[K] (Perm (Fin (n + 1)) →₀ K) where
  toFun h := toEnd K q n h (Finsupp.single 1 1)
  map_add' a b := by simp
  map_smul' c a := by simp

@[simp] theorem orbitMap_apply (h : QOU.Hecke.IwahoriHecke K q n) :
    orbitMap K q n h = toEnd K q n h (Finsupp.single 1 1) := rfl

/-- Every basis vector `T_w` is in the image of the orbit map. -/
theorem single_mem_range_orbitMap (w : Perm (Fin (n + 1))) :
    Finsupp.single w (1 : K) ∈ LinearMap.range (orbitMap K q n) := by
  refine single_mem_of_closed (permCoxeterSystem n) q
    (LinearMap.mem_range.mpr ⟨1, by simp⟩) ?_ w
  intro i x hx
  obtain ⟨h, rfl⟩ := LinearMap.mem_range.mp hx
  exact LinearMap.mem_range.mpr
    ⟨σ K q n i * h, by simp [map_mul, Module.End.mul_apply]⟩

/-- **`S_{n+1} →₀ K` is a cyclic `H_n(q)`-module, generated by `T_1`.**
    Equivalently, the `T_w` span the module — the first half of the basis
    theorem.  (Their independence is the other half, and is not proved here.) -/
theorem orbitMap_surjective : Function.Surjective (orbitMap K q n) :=
  LinearMap.range_eq_top.mp (eq_top_of_singles (single_mem_range_orbitMap K q n))

end QOU.Hecke.TwBasis
