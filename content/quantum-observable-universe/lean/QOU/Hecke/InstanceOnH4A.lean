/-! ## The instance -/

/-- The generator embedding: `Generator 4` carries `idx : Fin 3`. -/
def embed4 : Generator 4 → H4A K (q - q⁻¹) := fun i =>
  if i.idx.val = 0 then s0 K q else if i.idx.val = 1 then s1 K q else s2 K q

@[simp] theorem embed4_zero : embed4 K q ⟨0⟩ = s0 K q := rfl
@[simp] theorem embed4_one : embed4 K q ⟨1⟩ = s1 K q := rfl
@[simp] theorem embed4_two : embed4 K q ⟨2⟩ = s2 K q := rfl

theorem generator_four_cases (i : Generator 4) : i = ⟨0⟩ ∨ i = ⟨1⟩ ∨ i = ⟨2⟩ := by
  obtain ⟨⟨v, hv⟩⟩ := i
  interval_cases v
  · exact Or.inl rfl
  · exact Or.inr (Or.inl rfl)
  · exact Or.inr (Or.inr rfl)

/-! ### The presentation, as ring equations

Each is the corresponding operator identity of
`QOU.Machinery.HeckeH4StabilizationRung`, transported through `mul_s*`. -/

theorem s0_sq : s0 K q * s0 K q = (q - q⁻¹) • s0 K q + 1 := by
  rw [mul_s0]
  apply H4A.ext
  funext i
  fin_cases i <;> simp [s0, b, e₄, mulσ₀, unitNF₄, Pi.single_apply] <;> ring

theorem s1_sq : s1 K q * s1 K q = (q - q⁻¹) • s1 K q + 1 := by
  rw [mul_s1]
  apply H4A.ext
  funext i
  fin_cases i <;> simp [s1, b, e₄, mulσ₁, unitNF₄, Pi.single_apply] <;> ring

theorem s2_sq : s2 K q * s2 K q = (q - q⁻¹) • s2 K q + 1 := by
  rw [mul_s2]
  apply H4A.ext
  funext i
  fin_cases i <;> simp [s2, b, e₄, mulσ₂, unitNF₄, Pi.single_apply] <;> ring

/-! Each generator is one `mulσ` applied to the unit, which is what lets the
braid relations be quoted verbatim from `HeckeH4StabilizationRung` at `v = γ`. -/

theorem mulσ₀_unit : mulσ₀ (q - q⁻¹) (unitNF₄ : Fin 24 → K) = (s0 K q).v := by
  funext i
  fin_cases i <;> simp [s0, b, e₄, mulσ₀, unitNF₄, Pi.single_apply]

theorem mulσ₁_unit : mulσ₁ (q - q⁻¹) (unitNF₄ : Fin 24 → K) = (s1 K q).v := by
  funext i
  fin_cases i <;> simp [s1, b, e₄, mulσ₁, unitNF₄, Pi.single_apply]

theorem mulσ₂_unit : mulσ₂ (q - q⁻¹) (unitNF₄ : Fin 24 → K) = (s2 K q).v := by
  funext i
  fin_cases i <;> simp [s2, b, e₄, mulσ₂, unitNF₄, Pi.single_apply]

/-- **Braid** `σ₀σ₁σ₀ = σ₁σ₀σ₁`. -/
theorem braid01 : s0 K q * s1 K q * s0 K q = s1 K q * s0 K q * s1 K q := by
  simp only [mul_s0, mul_s1]
  apply H4A.ext
  show mulσ₀ (q - q⁻¹) (mulσ₁ (q - q⁻¹) (s0 K q).v)
      = mulσ₁ (q - q⁻¹) (mulσ₀ (q - q⁻¹) (s1 K q).v)
  rw [← mulσ₀_unit K q, ← mulσ₁_unit K q]
  exact braid_σ₀σ₁ (q - q⁻¹) unitNF₄

/-- **Braid** `σ₁σ₂σ₁ = σ₂σ₁σ₂`. -/
theorem braid12 : s1 K q * s2 K q * s1 K q = s2 K q * s1 K q * s2 K q := by
  simp only [mul_s1, mul_s2]
  apply H4A.ext
  show mulσ₁ (q - q⁻¹) (mulσ₂ (q - q⁻¹) (s1 K q).v)
      = mulσ₂ (q - q⁻¹) (mulσ₁ (q - q⁻¹) (s2 K q).v)
  rw [← mulσ₁_unit K q, ← mulσ₂_unit K q]
  exact braid_σ₁σ₂ (q - q⁻¹) unitNF₄

/-- **Far commutation** `σ₀σ₂ = σ₂σ₀` — the first class field of this shape with
content anywhere, and the reason `n = 4` is the last level worth instantiating. -/
theorem farcomm02 : s0 K q * s2 K q = s2 K q * s0 K q := by
  rw [mul_s2, mul_s0]
  apply H4A.ext
  show mulσ₂ (q - q⁻¹) (s0 K q).v = mulσ₀ (q - q⁻¹) (s2 K q).v
  funext i
  fin_cases i <;> simp [s0, s2, b, e₄, mulσ₀, mulσ₂]

/-! ### Every basis vector lies in the subalgebra generated by `σ₀, σ₁, σ₂` -/

private theorem s0_mem : s0 K q ∈ Algebra.adjoin K (Set.range (embed4 K q)) :=
