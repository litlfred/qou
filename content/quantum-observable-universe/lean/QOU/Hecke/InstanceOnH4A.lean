  funext i
  fin_cases i <;> simp [b, e₄, mulσ₀, Pi.single_apply]

/-- `σ₀σ₁ = σ₀ · σ₁` — basis 1 → 4. -/
theorem b_tree_4 : b K q 1 * s1 K q = b K q 4 := by
