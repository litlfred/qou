/-- **`H₄(q)` — the tree's own one — is a `HeckeAlgebra`**, with all three
relation shapes carrying content: quadratic, both braid relations, and far
commutation. -/
instance instHeckeAlgebraH4A : HeckeAlgebra K 4 q (H4A K (q - q⁻¹)) where
  embed := embed4 K q
  quadratic := by
    intro i
    rcases generator_four_cases i with rfl | rfl | rfl
    · simpa using s0_sq K q
    · simpa using s1_sq K q
    · simpa using s2_sq K q
  braid := by
    intro i j hij
    rcases generator_four_cases i with rfl | rfl | rfl <;>
      rcases generator_four_cases j with rfl | rfl | rfl
    · exact absurd hij (by simp [Generator.adjacent])
    · exact braid01 K q
    · exact absurd hij (by simp [Generator.adjacent])
    · exact (braid01 K q).symm
    · exact absurd hij (by simp [Generator.adjacent])
    · exact braid12 K q
    · exact absurd hij (by simp [Generator.adjacent])
    · exact (braid12 K q).symm
    · exact absurd hij (by simp [Generator.adjacent])
  farCommute := by
    intro i j hij
    obtain ⟨hne, hadj⟩ := hij
    rcases generator_four_cases i with rfl | rfl | rfl <;>
      rcases generator_four_cases j with rfl | rfl | rfl
    · exact absurd rfl hne
    · exact absurd (by simp [Generator.adjacent]) hadj
    · exact farcomm02 K q
    · exact absurd (by simp [Generator.adjacent]) hadj
    · exact absurd rfl hne
    · exact absurd (by simp [Generator.adjacent]) hadj
    · exact (farcomm02 K q).symm
    · exact absurd (by simp [Generator.adjacent]) hadj
    · exact absurd rfl hne
  spans := by
    refine le_antisymm le_top ?_
    rintro x -
    obtain ⟨v⟩ := x
    rw [show (⟨v⟩ : H4A K (q - q⁻¹)) = ∑ j, v j • b K q j from H4A.ext (by
      simpa [b] using basis_decomp₄ (R := K) v)]
    exact Subalgebra.sum_mem _ fun j _ => Subalgebra.smul_mem _ (b_mem K q j) _

end QOU.Hecke.InstanceOnH4A
