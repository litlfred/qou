import QOU.Hecke.FullRankFromWedderburn
import QOU.Machinery.HeckeH4AlgebraLaws

/-!
# `QOU.Hecke.InstanceOnH4A` — the `HeckeAlgebra` class, on the tree's own `H₄(q)`

`QOU.Machinery.HeckeH4AlgebraLaws.H4A` is the tree's four-strand Hecke algebra: a
`Ring` and `Algebra` on the 24-dimensional subscript normal-form module, with the
presentation proved in `QOU.Machinery.HeckeH4StabilizationRung` (`mulσ₀/₁/₂_hecke`,
`braid_σ₀σ₁`, `braid_σ₁σ₂`, `far_commute_σ₀σ₂`) and `mulNF₄_assoc` for
associativity. It never had an instance of the class `QOU.Hecke.HeckeAlgebra`.

This file supplies it. Together with `QOU.Hecke.isHeckeOfFullRank_H4A` (rank
`24 = 4!`) it completes the pair — relations *and* dimension — at the last level
that exercises a new class field: `n = 4` is where `farCommute` first has content.
Companion to `QOU.Hecke.InstanceOnH3A`. Bean qou-ti7p.

## Keeping `spans` cheap: the word tree, one generator at a time

`spans` needs every normal-form basis vector to be a word in the generators, and
the longest is `σ₀σ₁σ₀σ₂σ₁σ₀` — six letters. Expanding six nested `mulσ`s per
basis vector is what made the analogous attempt on `MarkovTraceH4`'s ASCII basis
run to ~8.7 GB (bean qou-awp7).

It is avoidable, because right multiplication by a generator is a **single**
`mulσ`: `mulNF₄_e_right` gives `u · b_j = wordAction j u`, and the generators sit
at basis indices `1`, `2`, `6`, whose word actions are exactly `mulσ₀`, `mulσ₁`,
`mulσ₂`. So each basis vector is its parent times one generator, and every step is
depth 1 on a literal vector:

    b_j = b_{parent j} * σ_{last letter of word j}

The 23 non-unit basis vectors form a tree under that relation — verified, not
assumed: every parent word is itself in the basis list. That is what `b_*_tree`
below record, and they are generated from `wordAction`'s own word list so they
cannot drift from it.

Generated by the script in this commit; the word list is read out of
`QOU.Machinery.HeckeH4AlgebraLaws.wordAction`.
-/

namespace QOU.Hecke.InstanceOnH4A

open QOU.Machinery.H4

universe u

variable (K : Type u) [Field K] (q : K)

/-- The `j`-th normal-form basis vector, as an algebra element. -/
def b (j : Fin 24) : H4A K (q - q⁻¹) := ⟨e₄ j⟩

/-- `σ₀` — basis index 1. -/
def s0 : H4A K (q - q⁻¹) := b K q 1
/-- `σ₁` — basis index 2. -/
def s1 : H4A K (q - q⁻¹) := b K q 2
/-- `σ₂` — basis index 6. -/
def s2 : H4A K (q - q⁻¹) := b K q 6

/-! ## Right multiplication by a generator is one `mulσ`

This is the whole reason the file is cheap: `mulNF₄_e_right` turns a product with
a basis vector into a single word action, and for the three generator indices
that action is a single `mulσ`. -/

theorem mul_s0 (x : H4A K (q - q⁻¹)) : x * s0 K q = ⟨mulσ₀ (q - q⁻¹) x.v⟩ := by
  apply H4A.ext
  show mulNF₄ (q - q⁻¹) x.v (e₄ 1) = _
  rw [mulNF₄_e_right]
  rfl

theorem mul_s1 (x : H4A K (q - q⁻¹)) : x * s1 K q = ⟨mulσ₁ (q - q⁻¹) x.v⟩ := by
  apply H4A.ext
  show mulNF₄ (q - q⁻¹) x.v (e₄ 2) = _
  rw [mulNF₄_e_right]
  rfl

theorem mul_s2 (x : H4A K (q - q⁻¹)) : x * s2 K q = ⟨mulσ₂ (q - q⁻¹) x.v⟩ := by
  apply H4A.ext
  show mulNF₄ (q - q⁻¹) x.v (e₄ 6) = _
  rw [mulNF₄_e_right]
  rfl

/-- `b 0` is the unit. -/
theorem b_zero : b K q 0 = 1 := by
  apply H4A.ext
  funext i
  fin_cases i <;> simp [b, e₄, unitNF₄, Pi.single_apply]

/-! ## The word tree: each basis vector is its parent times one generator -/

/-- `σ₀ = γ · σ₀` — basis 0 → 1. -/
theorem b_tree_1 : b K q 0 * s0 K q = b K q 1 := by
  rw [mul_s0]
  apply H4A.ext
  funext i
  fin_cases i <;> simp [b, e₄, mulσ₀, Pi.single_apply]

/-- `σ₁ = γ · σ₁` — basis 0 → 2. -/
theorem b_tree_2 : b K q 0 * s1 K q = b K q 2 := by
  rw [mul_s1]
  apply H4A.ext
  funext i
  fin_cases i <;> simp [b, e₄, mulσ₁, Pi.single_apply]

/-- `σ₁σ₀ = σ₁ · σ₀` — basis 2 → 3. -/
theorem b_tree_3 : b K q 2 * s0 K q = b K q 3 := by
