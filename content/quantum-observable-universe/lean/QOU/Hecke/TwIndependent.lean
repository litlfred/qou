import QOU.Hecke.TwRep
import Mathlib.LinearAlgebra.Finsupp.VectorSpace

/-!
# QOU.Hecke.TwIndependent — the `T_w` are linearly independent in `H_n(q)`

The independence half of the `T_w` basis (bean `qou-twwf`).
`QOU.Hecke.TwRep` gives the algebra map `toEnd : H_n(q) →ₐ Module.End K (S →₀ K)`
and shows the module is cyclic, generated by `T_1` — the **spanning** half.
This file supplies the other direction.

## The move that avoids Matsumoto

Define `T_w` as the product of the `σ` along **some** reduced word for `w`
(`Classical.choose`).  That is *a priori* not well-defined: two reduced words
for the same `w` might give different elements, and ruling that out is exactly
Matsumoto's theorem, which Mathlib lists as an open TODO
(`Coxeter/Basic.lean:78`).

But independence does not need well-definedness.  `applyWord_single` shows that
along **any** reduced word the operators simply walk the basis, so whichever
word was chosen, `T_w · T_1 = T_w` in the module.  The images of the `T_w` are
therefore the distinct standard basis vectors, and a family whose image under a
linear map is independent is itself independent.

## What is proved

* `applyWord_single` — along a word that is reduced *relative to* `w`, the
  operators send `T_w` to `T_{w·π ω}`.
* `orbitMap_Tw` — `T_w ↦ single w 1`.
* `linearIndependent_Tw` — **the `T_w` are linearly independent**, so
  `dim_K H_n(q) ≥ (n+1)!`.

* `basisTw` — **conditional**: if `orbitMap` is injective the `T_w` are a basis.

The remaining gap is stated exactly by that last hypothesis.  `orbitMap` is
already surjective (`QOU.Hecke.TwRep.orbitMap_surjective`), so injectivity is
equivalent to `dim_K H_n(q) ≤ (n+1)!` — that the `T_w` also **span**.  That is
the one place Matsumoto is genuinely needed, and it is **not** proved here: do
not read `basisTw` as a proof that the `T_w` are a basis.
-/

open Classical
namespace QOU.Hecke.TwBasis

section Abstract

variable {B W : Type*} [Group W] {M : CoxeterMatrix B} (cs : CoxeterSystem M W)
variable {R : Type*} [CommRing R] (q : R)

/-- Apply the operators along a word, first letter first. -/
noncomputable def applyWord (ω : List B) (x : W →₀ R) : W →₀ R :=
  ω.foldl (fun y i => Rs cs q i y) x

@[simp] theorem applyWord_nil (x : W →₀ R) : applyWord cs q [] x = x := rfl

theorem applyWord_cons (i : B) (ω : List B) (x : W →₀ R) :
    applyWord cs q (i :: ω) x = applyWord cs q ω (Rs cs q i x) := rfl

/-- **Along a reduced word the operators just walk the basis.**  No coefficients
    appear, because every step increases the length. -/
theorem applyWord_single (ω : List B) (w : W)
    (h : cs.length (w * cs.wordProd ω) = cs.length w + ω.length) :
    applyWord cs q ω (Finsupp.single w (1 : R))
      = Finsupp.single (w * cs.wordProd ω) (1 : R) := by
  induction ω generalizing w with
  | nil => simp
  | cons i ω ih =>
      rw [cs.wordProd_cons, ← mul_assoc, List.length_cons] at h
      have hle : cs.length (w * cs.simple i * cs.wordProd ω)
          ≤ cs.length (w * cs.simple i) + ω.length :=
        le_trans (cs.length_mul_le _ _)
          (Nat.add_le_add_left (cs.length_wordProd_le ω) _)
      have hup : cs.length (w * cs.simple i) = cs.length w + 1 := by
        rcases cs.length_mul_simple w i with hh | hh <;> omega
      have hstep : Rs cs q i (Finsupp.single w (1 : R))
          = Finsupp.single (w * cs.simple i) (1 : R) := by
        rw [Rs_single]; unfold rsFun; rw [if_pos hup]
      rw [applyWord_cons, hstep, ih (w * cs.simple i) (by omega),
        cs.wordProd_cons, mul_assoc]

/-- The same, started at the identity, for a genuinely reduced word. -/
theorem applyWord_one (ω : List B) (h : cs.IsReduced ω) :
    applyWord cs q ω (Finsupp.single (1 : W) (1 : R))
      = Finsupp.single (cs.wordProd ω) (1 : R) := by
  have := applyWord_single cs q ω 1 (by simpa [CoxeterSystem.IsReduced] using h)
  simpa using this

end Abstract

section Hecke

open QOU.Hecke.SymmetricCoxeter
open QOU.Hecke.IwahoriHecke (σ)

variable (K : Type*) [CommRing K] (q : K) (n : ℕ)

/-- The product of the generators along a word, applied on the left (the side
    the cyclic module's action uses). -/
noncomputable def TwOf (ω : List (Fin n)) : QOU.Hecke.IwahoriHecke K q n :=
  ω.foldl (fun h i => σ K q n i * h) 1

theorem orbitMap_foldl (ω : List (Fin n)) (h : QOU.Hecke.IwahoriHecke K q n) :
    orbitMap K q n (ω.foldl (fun a i => σ K q n i * a) h)
      = applyWord (permCoxeterSystem n) q ω (orbitMap K q n h) := by
  induction ω generalizing h with
  | nil => simp
  | cons i ω ih =>
      have hstep : orbitMap K q n (σ K q n i * h)
          = Rs (permCoxeterSystem n) q i (orbitMap K q n h) := by
        simp [map_mul, Module.End.mul_apply]
      rw [List.foldl_cons, ih, hstep, applyWord_cons]

theorem orbitMap_TwOf (ω : List (Fin n)) (h : (permCoxeterSystem n).IsReduced ω) :
    orbitMap K q n (TwOf K q n ω)
      = Finsupp.single ((permCoxeterSystem n).wordProd ω) (1 : K) := by
  rw [TwOf, orbitMap_foldl]
  simpa using applyWord_one (permCoxeterSystem n) q ω h

/-- A choice of reduced word for each permutation.  Which one is chosen does not
    matter below — that is the point. -/
noncomputable def reducedWord (w : Equiv.Perm (Fin (n + 1))) : List (Fin n) :=
  ((permCoxeterSystem n).exists_reduced_word' w).choose

theorem reducedWord_isReduced (w : Equiv.Perm (Fin (n + 1))) :
    (permCoxeterSystem n).IsReduced (reducedWord n w) :=
  ((permCoxeterSystem n).exists_reduced_word' w).choose_spec.1

theorem wordProd_reducedWord (w : Equiv.Perm (Fin (n + 1))) :
    (permCoxeterSystem n).wordProd (reducedWord n w) = w :=
  (((permCoxeterSystem n).exists_reduced_word' w).choose_spec.2).symm

/-- `T_w ∈ H_n(q)`, built from the chosen reduced word. -/
noncomputable def Tw (w : Equiv.Perm (Fin (n + 1))) : QOU.Hecke.IwahoriHecke K q n :=
  TwOf K q n (reducedWord n w)

@[simp] theorem orbitMap_Tw (w : Equiv.Perm (Fin (n + 1))) :
    orbitMap K q n (Tw K q n w) = Finsupp.single w (1 : K) := by
  rw [Tw, orbitMap_TwOf K q n _ (reducedWord_isReduced n w), wordProd_reducedWord]

/-- **The `T_w` are linearly independent in `H_n(q)`.**  Hence
    `dim_K H_n(q) ≥ (n+1)!`, and no choice of reduced words can collapse them. -/
theorem linearIndependent_Tw : LinearIndependent K (Tw K q n) := by
  refine LinearIndependent.of_comp (orbitMap K q n) ?_
  have hcomp : (orbitMap K q n) ∘ (Tw K q n)
      = fun w : Equiv.Perm (Fin (n + 1)) => Finsupp.single w (1 : K) := by
    funext w; exact orbitMap_Tw K q n w
  rw [hcomp]
  exact Finsupp.linearIndependent_single_one _ _

/-- **What is still missing, stated exactly.**  If the action on `T_1` is
    faithful then the `T_w` are a basis of `H_n(q)` — so the whole basis theorem
    reduces to injectivity of `orbitMap`, equivalently `dim_K H_n(q) ≤ (n+1)!`.

    This is a *conditional* statement and the hypothesis is **not** established
    here: it is the content of Matsumoto's theorem (any two reduced words for
    the same element differ by braid moves), which Mathlib lists as an open TODO
    at `Coxeter/Basic.lean:78`.  Do not read this definition as a proof that the
    `T_w` are a basis. -/
noncomputable def basisTw (hinj : Function.Injective (orbitMap K q n)) :
    Module.Basis (Equiv.Perm (Fin (n + 1))) K (QOU.Hecke.IwahoriHecke K q n) :=
  Finsupp.basisSingleOne.map
    (LinearEquiv.ofBijective (orbitMap K q n)
      ⟨hinj, orbitMap_surjective K q n⟩).symm

@[simp] theorem coe_basisTw (hinj : Function.Injective (orbitMap K q n)) :
    ⇑(basisTw K q n hinj) = Tw K q n := by
  funext w
  rw [basisTw, Module.Basis.map_apply, Finsupp.coe_basisSingleOne,
    LinearEquiv.symm_apply_eq]
  exact (orbitMap_Tw K q n w).symm

end Hecke

end QOU.Hecke.TwBasis
