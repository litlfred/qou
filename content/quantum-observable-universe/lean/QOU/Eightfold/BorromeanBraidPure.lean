import Mathlib.GroupTheory.Perm.Basic
import Mathlib.Data.Fintype.Basic
import Mathlib.Logic.Relation
import Mathlib.Algebra.BigOperators.Group.List.Basic

/-!
# QOU.Eightfold.BorromeanBraidPure — the Borromean braid is pure, and no half-twist is

Bean `qou-xhih` (Front 1 of `qou-icj2`), companion to
`computations/probes/bring_monodromy_full_twist_probe.py` and to PR #6449's
`bring_monodromy_braid_lift_probe.py`.

## What is formalised

Words in the signed Artin generators `σ₁^{±1}, σ₂^{±1}` of `B₃`, and two
`B₃`-invariants of such words:

* `permOfWord` — the image in `S₃ = Equiv.Perm (Fin 3)`; a generator acts
  as the adjacent transposition, **whatever its sign** (a transposition is
  its own inverse, so the sign is invisible in `S₃`).
* `expSum` — the exponent sum, `+1` per positive letter, `−1` per negative.

Both are shown to be invariant under the defining relations of `B₃`
(`BraidStep`: free cancellation `g g⁻¹ → 1` and the braid relation
`σ₁σ₂σ₁ = σ₂σ₁σ₂`, in any context), hence constant on equivalence
classes `Relation.EqvGen BraidStep`. That is exactly what makes a statement
about a *word* a statement about the *braid* it represents.

Then, for the Borromean word `(σ₁ σ₂⁻¹)³`:

* `borromean_perm_eq_one` — its `S₃` image is the identity, so **the
  Borromean braid is pure**: every word equivalent to it has trivial image
  (`borromean_equiv_perm_eq_one`).
* `borromean_expSum` — its exponent sum is `0`, while any conjugate of a
  single generator has exponent sum `±1` (`expSum_conj_gen`); therefore **no
  half-twist (conjugate of a generator) is equivalent to the Borromean word**
  (`borromean_not_halfTwist`). In particular none of the six local
  monodromy lifts of the Bring colour cubic — each a half-twist — is the
  Borromean braid; the Borromean braid arises only as a *product* of them.

## What is NOT formalised

`B₃` itself is not constructed as a group here; the results are about words
modulo the presentation's relations, which is the same information. Nothing
here is about the Bring fibre: the six lifts being half-twists is the probe's
numerical result, consumed by the reader, not proved in Lean. No `sorry`.
-/

namespace QOU.Eightfold.BorromeanBraidPure

/-- A signed Artin generator of `B₃`: `idx = 0` is `σ₁`, `idx = 1` is `σ₂`;
`pos = true` is the generator, `pos = false` its inverse. -/
structure SGen where
  idx : Fin 2
  pos : Bool
  deriving DecidableEq, Repr

/-- Formal inverse of a letter. -/
def SGen.inv (g : SGen) : SGen := ⟨g.idx, !g.pos⟩

/-- Formal inverse of a word. -/
def wordInv (w : List SGen) : List SGen := (w.map SGen.inv).reverse

/-- `σ₁`, `σ₂` and their inverses. -/
def s1 : SGen := ⟨0, true⟩
def s2 : SGen := ⟨1, true⟩
def s1i : SGen := ⟨0, false⟩
def s2i : SGen := ⟨1, false⟩

/-- The `S₃`-image of a letter: the adjacent transposition, sign-blind. -/
def permOf (g : SGen) : Equiv.Perm (Fin 3) :=
  if g.idx = 0 then Equiv.swap 0 1 else Equiv.swap 1 2

/-- The `S₃`-image of a word (product in word order). -/
def permOfWord (w : List SGen) : Equiv.Perm (Fin 3) := (w.map permOf).prod

/-- Exponent sum of a word. -/
def expSum (w : List SGen) : ℤ := (w.map fun g => if g.pos then (1 : ℤ) else -1).sum

/-- The Borromean braid word `(σ₁ σ₂⁻¹)³`. -/
def borromean : List SGen := [s1, s2i, s1, s2i, s1, s2i]

/-- One rewriting step of the `B₃` presentation, in an arbitrary context:
free cancellation of `g g⁻¹`, and the braid relation `σ₁σ₂σ₁ = σ₂σ₁σ₂`. -/
inductive BraidStep : List SGen → List SGen → Prop
  | cancel (l r : List SGen) (g : SGen) :
      BraidStep (l ++ [g, g.inv] ++ r) (l ++ r)
  | braid (l r : List SGen) :
      BraidStep (l ++ [s1, s2, s1] ++ r) (l ++ [s2, s1, s2] ++ r)

/-- Equality in `B₃`: the equivalence relation generated by `BraidStep`. -/
def BraidEq : List SGen → List SGen → Prop := Relation.EqvGen BraidStep

-- ── basic algebra of the two invariants ──────────────────────────

theorem permOfWord_append (u v : List SGen) :
    permOfWord (u ++ v) = permOfWord u * permOfWord v := by
  simp [permOfWord, List.map_append, List.prod_append]

theorem expSum_append (u v : List SGen) :
    expSum (u ++ v) = expSum u + expSum v := by
  simp [expSum, List.map_append, List.sum_append]

theorem permOf_inv (g : SGen) : permOf g.inv = permOf g := by
  simp [permOf, SGen.inv]

theorem expSum_inv_single (g : SGen) : expSum [g.inv] = - expSum [g] := by
  cases g with
  | mk idx pos => cases pos <;> simp [expSum, SGen.inv]

theorem expSum_wordInv (w : List SGen) : expSum (wordInv w) = - expSum w := by
  induction w with
  | nil => simp [wordInv, expSum]
  | cons g w ih =>
    have h1 : wordInv (g :: w) = wordInv w ++ [g.inv] := by
      simp [wordInv]
    have h2 : expSum (g :: w) = expSum [g] + expSum w := by
      simp [expSum]
    rw [h1, expSum_append, ih, expSum_inv_single, h2]
    omega

/-- The braid relation holds in `S₃` — the one non-trivial check. -/
theorem perm_braid_relation :
    permOfWord [s1, s2, s1] = permOfWord [s2, s1, s2] := by
  decide

-- ── invariance under the relations ───────────────────────────────

theorem permOfWord_step {u v : List SGen} (h : BraidStep u v) :
    permOfWord u = permOfWord v := by
  cases h with
  | cancel l r g =>
    rw [permOfWord_append, permOfWord_append, permOfWord_append]
    have : permOfWord [g, g.inv] = 1 := by
      simp [permOfWord, permOf_inv]
      unfold permOf
      split <;> exact Equiv.swap_mul_self _ _
    rw [this, mul_one]
  | braid l r =>
    rw [permOfWord_append, permOfWord_append, permOfWord_append,
        permOfWord_append, perm_braid_relation]

theorem expSum_step {u v : List SGen} (h : BraidStep u v) :
    expSum u = expSum v := by
  cases h with
  | cancel l r g =>
    rw [expSum_append, expSum_append, expSum_append]
    have : expSum [g, g.inv] = 0 := by
      cases g with
      | mk idx pos => cases pos <;> simp [expSum, SGen.inv]
    rw [this, add_zero]
  | braid l r =>
    rw [expSum_append, expSum_append, expSum_append, expSum_append]
    simp [expSum, s1, s2]

theorem permOfWord_braidEq {u v : List SGen} (h : BraidEq u v) :
    permOfWord u = permOfWord v := by
  induction h with
  | rel _ _ h => exact permOfWord_step h
  | refl _ => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂

theorem expSum_braidEq {u v : List SGen} (h : BraidEq u v) :
    expSum u = expSum v := by
  induction h with
  | rel _ _ h => exact expSum_step h
  | refl _ => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂

-- ── the Borromean braid ──────────────────────────────────────────

/-- (i) The `S₃`-image of `(σ₁ σ₂⁻¹)³` is the identity. -/
theorem borromean_perm_eq_one : permOfWord borromean = 1 := by
  decide

/-- Hence every word equal to it in `B₃` has trivial `S₃`-image: the
Borromean braid is pure. -/
theorem borromean_equiv_perm_eq_one {w : List SGen} (h : BraidEq borromean w) :
    permOfWord w = 1 :=
  (permOfWord_braidEq h).symm.trans borromean_perm_eq_one

/-- (ii) The exponent sum of `(σ₁ σ₂⁻¹)³` is `0`. -/
theorem borromean_expSum : expSum borromean = 0 := by
  decide

/-- A single generator has exponent sum `±1`. -/
theorem expSum_single (g : SGen) : expSum [g] = 1 ∨ expSum [g] = -1 := by
  cases g with
  | mk idx pos => cases pos <;> simp [expSum]

/-- A half-twist — any conjugate `c g c⁻¹` of a single letter — has exponent
sum `±1`. -/
theorem expSum_conj_gen (c : List SGen) (g : SGen) :
    expSum (c ++ [g] ++ wordInv c) = 1 ∨ expSum (c ++ [g] ++ wordInv c) = -1 := by
  rw [expSum_append, expSum_append, expSum_wordInv]
  rcases expSum_single g with h | h <;> rw [h] <;> [left; right] <;> omega

/-- No half-twist is equal in `B₃` to the Borromean braid. -/
theorem borromean_not_halfTwist (c : List SGen) (g : SGen) :
    ¬ BraidEq borromean (c ++ [g] ++ wordInv c) := by
  intro h
  have e := expSum_braidEq h
  rw [borromean_expSum] at e
  rcases expSum_conj_gen c g with h1 | h1 <;> rw [h1] at e <;> omega

/-- The two transpositions do not commute, so `permOfWord` is not a
homomorphism to an abelian group and the invariance above is not vacuous. -/
theorem perm_s1_s2_ne : permOfWord [s1, s2] ≠ permOfWord [s2, s1] := by
  decide

end QOU.Eightfold.BorromeanBraidPure
