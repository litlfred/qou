import QOU.MathlibExt.HeckeTowerWitness
import QOU.SchurWeyl.HeckeColimitFaithful

/-!
# The presented tower's filtration grows strictly — the `twH` bridge

`MathlibExt/HeckeTowerWitness` presents the infinite Hecke tower by generators
and relations and proves `twH_zero_lt_one` (`H 0 < H 1`) only.  Its own module
docstring warns not to read `twH_mono` as strict growth: it is `≤`.  This file
closes that gap at the Hecke parameter, for every level.

## Why the rank-2 collapse cannot do it, and why that is not a small obstacle

`collapse : HeckeTower R h →ₐ Hecke2 R h` sends **every** generator to the same
`sigma`, so it cannot separate `twH n` from `twH (n+1)`.  The tempting repair —
map into a *product* of rank-2 algebras and send one generator somewhere else —
**fails for a structural reason worth recording.**  In a commutative target the
braid relation

  `f(m+1) * f(m) * f(m+1) = f(m) * f(m+1) * f(m)`

becomes `f(m+1)² f(m) = f(m)² f(m+1)`; substituting the quadratic on each side
gives `h·f(m)f(m+1) + f(m)` versus `h·f(m)f(m+1) + f(m+1)`, i.e. `f(m) = f(m+1)`.
So the braid relation forces **adjacent generators to be equal in any commutative
target**, hence all of them by chaining.  No commutative algebra — of any rank,
product or not — can separate two stages of this filtration.

## The target that works

The separator has to be genuinely non-commutative, and the corpus has one: the
colimit `HeckeLim ℝ q q⁻¹` of the honest Iwahori–Hecke tower.  All three
relations hold there with **matching indices** — `gLim_quadratic` (with
`q · q⁻¹ = 1`), `gLim_braid`, `gLim_far` — so the presented tower maps into it
generator-for-generator, and the separation is inherited from
`HeckeColimit.H_lt_succ`.

## The two new facts

* `H_le_adjoin_gLim` — level `n+1` of the colimit filtration is generated by the
  colimit generators `g 0 … g n`.  This is `adjoin_range_σ_eq_top` transported
  along `gLim_eq`; it was implicit in `HeckeColimitNotFaithful` and is extracted
  here because it is what turns a dimension count into a statement about a
  *generator*.
* `gLim_notMem_H` — `g n ∉ H n`.  `H_lt_succ` says the inclusion `H n ⊆ H (n+1)`
  is strict but names no witness; with the generation fact it does: if `g n` were
  already in `H n`, then `H (n+1)`, being generated by `g 0 … g n`, would collapse
  into `H n`.

## Scope

`ℝ`, convention D's genericity (`q ≠ 0`, `NotRootOfUnity q`) — inherited from
`finrank_hecke_eq_factorial`, which needs semisimplicity — and the Hecke
parameter `h = q - q⁻¹`.  The generic-`R`, generic-`h` case is **not** settled
here and the commutativity argument above says why it is not merely unproved:
any separator for it must be non-commutative, and `HeckeTowerWitness` has no
non-commutative model at generic `h`.
-/

namespace QOU.SchurWeyl.HeckeTowerWitnessStrict

open QOU.MathlibExt.HeckeTowerWitness
open QOU.SchurWeyl QOU.SchurWeyl.Hecke QOU.SchurWeyl.HeckeInclusion
  QOU.SchurWeyl.HeckeDirectedSystem QOU.SchurWeyl.HeckeColimit

variable {K : Type*} [Field K] [CharZero K] {q : K}

/-! ## Why no commutative target can separate two stages

The obstruction above is stated in the module docstring; this makes it
machine-checked rather than prose. -/

/-- **In a commutative ring the braid relation forces adjacent generators to be
equal.**

`b·a·b = a·b·a` becomes `a·b² = b·a²`; substituting the quadratic on each side
turns it into `h·a·b + a = h·a·b + b`.  So any commutative target of the presented
tower identifies `σ_m` with `σ_{m+1}`, hence all generators by chaining, hence
maps every stage of the filtration onto the same subalgebra.  **No commutative
algebra separates `twH n` from `twH (n+1)`** — of any rank, product or not.  This
is why `collapse` into the rank-2 `Hecke2` cannot be repaired by enlarging the
target, and why the separator below is the non-commutative colimit. -/
theorem eq_of_braid_of_comm {A : Type*} [CommRing A] (h a b : A)
    (ha : a * a = h * a + 1) (hb : b * b = h * b + 1)
    (hbraid : b * a * b = a * b * a) : a = b := by
  linear_combination hbraid - a * hb + b * ha

/-! ## Level `n+1` is generated by the first `n+1` colimit generators -/

omit [CharZero K] in
/-- **The colimit filtration is generated by the colimit generators.** -/
theorem H_le_adjoin_gLim (n : ℕ) :
    H K q q⁻¹ (n + 1) ≤
      Algebra.adjoin K {x : HeckeLim K q q⁻¹ | ∃ m, m ≤ n ∧ x = gLim K q q⁻¹ m} := by
  have key : ∀ y : Hecke K q q⁻¹ (n + 1),
      ofLimₐ K q q⁻¹ (n + 1) y ∈
        Algebra.adjoin K {x : HeckeLim K q q⁻¹ | ∃ m, m ≤ n ∧ x = gLim K q q⁻¹ m} := by
    intro y
    have hz : y ∈ Algebra.adjoin K (Set.range (σ K q q⁻¹ (n + 1))) := by
      rw [adjoin_range_σ_eq_top]; exact Algebra.mem_top
    induction hz using Algebra.adjoin_induction with
    | mem x hx =>
        obtain ⟨i, rfl⟩ := hx
        rw [← gLim_eq K q q⁻¹ i.val (n + 1) i.isLt]
        exact Algebra.subset_adjoin ⟨i.val, Nat.lt_succ_iff.mp i.isLt, rfl⟩
    | algebraMap r => rw [AlgHom.commutes]; exact Subalgebra.algebraMap_mem _ r
    | add x y _ _ hx hy => rw [map_add]; exact Subalgebra.add_mem _ hx hy
    | mul x y _ _ hx hy => rw [map_mul]; exact Subalgebra.mul_mem _ hx hy
  rintro c ⟨y, rfl⟩
  exact key y

/-- **The new generator is genuinely new.**

`H_lt_succ` gives strictness without a witness; with `H_le_adjoin_gLim` the
witness is `g n` itself. -/
theorem gLim_notMem_H (hq0 : q ≠ 0) (hq2 : GenericParameter.NotRootOfUnity q)
    (n : ℕ) : gLim K q q⁻¹ n ∉ H K q q⁻¹ n := by
  intro hmem
  have hle : H K q q⁻¹ (n + 1) ≤ H K q q⁻¹ n := by
    refine le_trans (H_le_adjoin_gLim n) (Algebra.adjoin_le ?_)
    rintro x ⟨m, hmn, rfl⟩
    rcases Nat.lt_or_ge m n with hlt | hge
    · exact H_mono K q q⁻¹ (by omega) (gLim_mem K q q⁻¹ m)
    · have : m = n := le_antisymm hmn hge
      subst this; exact hmem
  exact absurd hle (not_le_of_gt (H_lt_succ hq0 hq2 n))

/-! ## The presented tower maps into the colimit -/

/-- **The presented tower's realisation at the Hecke parameter.**

Generator-for-generator, not collapsed: `twGen m ↦ g m`.  All three presented
relations hold in the colimit with matching indices. -/
noncomputable def towerToColimit (hq0 : q ≠ 0) :
    HeckeTower K (q - q⁻¹) →ₐ[K] HeckeLim K q q⁻¹ :=
  RingQuot.liftAlgHom K
    ⟨FreeAlgebra.lift K (fun m => gLim K q q⁻¹ m), by
      intro x y hxy
      induction hxy with
      | quad m =>
          simp only [fgen, map_mul, FreeAlgebra.lift_ι_apply, map_add, map_smul, map_one]
          have h := gLim_quadratic K q q⁻¹ m
          rwa [mul_inv_cancel₀ hq0, one_smul] at h
      | braid m =>
          simp only [fgen, map_mul, FreeAlgebra.lift_ι_apply]
          exact gLim_braid K q q⁻¹ m
      | far m k hk =>
          simp only [fgen, map_mul, FreeAlgebra.lift_ι_apply]
          exact gLim_far K q q⁻¹ m k hk⟩

omit [CharZero K] in
@[simp] theorem towerToColimit_twGen (hq0 : q ≠ 0) (m : ℕ) :
    towerToColimit hq0 (twGen (q - q⁻¹) m) = gLim K q q⁻¹ m := by
  simp [towerToColimit, twGen, fgen]

/-! ## Strict growth -/

/-- **The presented tower's filtration grows strictly at every level.**

This is what `HeckeTowerWitness`'s module docstring flags as unproved beyond
level 0: `twH_mono` is `≤`, and `twH_zero_lt_one` covers only `H 0 < H 1`. -/
theorem twH_lt_succ (hq0 : q ≠ 0) (hq2 : GenericParameter.NotRootOfUnity q)
    (n : ℕ) : twH (q - q⁻¹) n < twH (q - q⁻¹) (n + 1) := by
  refine lt_of_le_of_ne (twH_mono _ (Nat.le_succ n)) fun heq => ?_
  have hmem : twGen (q - q⁻¹) n ∈ twH (q - q⁻¹) n := heq ▸ twGen_mem (q - q⁻¹) n
  have hpush : ∀ x ∈ twH (q - q⁻¹) n,
      towerToColimit hq0 x ∈ H K q q⁻¹ n := by
    intro x hx
    induction hx using Algebra.adjoin_induction with
    | mem z hz =>
        obtain ⟨m, hm, rfl⟩ := hz
        rw [towerToColimit_twGen]
        exact H_mono K q q⁻¹ (Nat.succ_le_of_lt hm) (gLim_mem K q q⁻¹ m)
    | algebraMap r => rw [AlgHom.commutes]; exact Subalgebra.algebraMap_mem _ r
    | add x y _ _ hx hy => rw [map_add]; exact Subalgebra.add_mem _ hx hy
    | mul x y _ _ hx hy => rw [map_mul]; exact Subalgebra.mul_mem _ hx hy
  have := hpush _ hmem
  rw [towerToColimit_twGen] at this
  exact gLim_notMem_H hq0 hq2 n this

end QOU.SchurWeyl.HeckeTowerWitnessStrict
