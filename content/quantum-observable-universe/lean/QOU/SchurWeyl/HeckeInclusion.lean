import QOU.SchurWeyl.HeckeAlgebra

/-!
# QOU.SchurWeyl.HeckeInclusion — the tower inclusion `H_n(q) ↪ H_{n+1}(q)` (SW-7-gen infra)

The Iwahori–Hecke algebras form a tower `H_1(q) ⊂ H_2(q) ⊂ ⋯`, with `H_n(q)`
sitting inside `H_{n+1}(q)` as the subalgebra generated by the first `n-1`
generators.  Here `H_n(q) = Hecke K q qi n` (`n` generators `σ_0,…,σ_{n-1}`), so
the inclusion `Hecke K q qi n →ₐ[K] Hecke K q qi (n+1)` sends `σ_i ↦ σ_i`
(`i : Fin n ↪ Fin (n+1)` by `Fin.castSucc`).

This is the structural map underlying the coset-decomposition proof of the
Iwahori–Hecke basis theorem `dim H_n(q) = n!` (the general `dim ≤ n!` route,
bean `qou-uoal`): `H_{n+1}(q) = ⊕_{k} H_n(q)·r_k` over the `n+1` coset
representatives `r_k = σ_n σ_{n-1} ⋯ σ_k`, giving the recursion
`dim H_{n+1} ≤ (n+1)·dim H_n`.

The images `σ_i` (`i : Fin n`, embedded) satisfy the same quadratic, braid, and
far-commutation relations they satisfy in `H_{n+1}(q)`, so the inclusion is a
well-defined algebra map by the universal property (`Hecke.lift`).

Base ring: generic `[CommRing K]` (§7c — purely algebraic).

LaTeX label: `def:hecke-tower-inclusion`
-/

namespace QOU.SchurWeyl

open Hecke

namespace HeckeInclusion

variable (K : Type*) [CommRing K] (q qi : K) (n : ℕ)

/-- The generator images: `σ_i ∈ H_{n+1}(q)` for `i : Fin n`, via `Fin.castSucc`. -/
noncomputable def gen (i : Fin n) : Hecke K q qi (n + 1) := σ K q qi (n + 1) i.castSucc

/-- **The tower inclusion** `H_n(q) ↪ H_{n+1}(q)` (`σ_i ↦ σ_i`), as an algebra map.
Well-defined by the universal property: the embedded generators satisfy the same
Hecke relations. -/
noncomputable def heckeIncl : Hecke K q qi n →ₐ[K] Hecke K q qi (n + 1) :=
  Hecke.lift K q qi n (gen K q qi n)
    -- quadratic
    (fun i => σ_quadratic K q qi (n + 1) i.castSucc)
    -- braid
    (fun i hi => by
      have hi' : ((i.castSucc : Fin (n + 1)) : ℕ) + 1 < n + 1 := by
        simpa only [Fin.coe_castSucc] using Nat.lt_succ_of_lt hi
      have hb := σ_braid K q qi (n + 1) i.castSucc hi'
      have hidx : (⟨((i.castSucc : Fin (n + 1)) : ℕ) + 1, hi'⟩ : Fin (n + 1))
          = (⟨(i : ℕ) + 1, hi⟩ : Fin n).castSucc := by
        apply Fin.ext; simp [Fin.coe_castSucc]
      rw [hidx] at hb
      simpa only [gen] using hb)
    -- far commutation
    (fun i j h => by
      have h' : (j.castSucc : Fin (n + 1)).val + 2 ≤ (i.castSucc : Fin (n + 1)).val := by
        simpa only [Fin.coe_castSucc] using h
      simpa only [gen] using σ_commute K q qi (n + 1) i.castSucc j.castSucc h')

/-- The inclusion sends `σ_i` (in `H_n`) to `σ_i` (in `H_{n+1}`, embedded index). -/
@[simp] theorem heckeIncl_σ (i : Fin n) :
    heckeIncl K q qi n (σ K q qi n i) = σ K q qi (n + 1) i.castSucc :=
  Hecke.lift_σ K q qi n (gen K q qi n) _ _ _ i

/-- **The generators generate `H_n(q)` as an algebra** (general `n`):
`Algebra.adjoin K {σ_0, …, σ_{n-1}} = ⊤`.  The general-`n` form of
`HeckeDim3.adjoin_gens_eq_top`; the base step of the coset-decomposition
spanning argument. -/
theorem adjoin_range_σ_eq_top :
    Algebra.adjoin K (Set.range (σ K q qi n)) = ⊤ := by
  rw [eq_top_iff]
  rintro x -
  obtain ⟨f, rfl⟩ := RingQuot.mkAlgHom_surjective K (HeckeRel K q qi n) x
  induction f using FreeAlgebra.induction with
  | grade0 r =>
      have hr : (RingQuot.mkAlgHom K (HeckeRel K q qi n)) (algebraMap K _ r)
          = algebraMap K (Hecke K q qi n) r := (RingQuot.mkAlgHom K _).commutes r
      rw [hr]; exact Subalgebra.algebraMap_mem _ r
  | grade1 i => exact Algebra.subset_adjoin ⟨i, rfl⟩
  | mul a b ha hb => rw [map_mul]; exact mul_mem ha hb
  | add a b ha hb => rw [map_add]; exact add_mem ha hb

end HeckeInclusion

end QOU.SchurWeyl
