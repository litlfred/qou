import QOU.SchurWeyl.SeminormalRep
import QOU.SchurWeyl.QJucysMurphyEigen

/-!
# QOU.SchurWeyl.SeminormalBlockTrace — the structural half of the Markov reduction

`OcneanuWeightMarkovCorner` proves the *arithmetic* core of the general-`n` Markov condition and
records that the **reduction** to it was derived on paper and not formalised.  This file formalises
the structural part of that reduction.

## What the reduction needs

Restricting `V_λ` to the subalgebra generated by `σ_1, …, σ_{k-1}` decomposes it by the cell holding
the largest entry.  The reduction needs exactly two facts about that decomposition:

1. **`σ_k`'s off-diagonal entries cross blocks** — `genMat_eq_zero_of_cellOf_succ_eq`.
2. **Earlier generators preserve blocks** — `cellOf_eq_of_genMat_ne_zero`.

Together they give `trace_mul_genMat`: for any block-preserving `X`,

`tr(X · σ_k) = ∑_T X_{TT} · seminormalParam q (axialDist T k)`,

which is the identity the corner reduction runs on — the step that turns `χ^λ(x·σ_n)` into a sum of
diagonal entries weighted by Hoefsmit parameters.

## Correction to how this was justified

`OcneanuWeightMarkovCorner`'s docstring, and bean `qou-uer7`, justify fact 1 by *"branching is
multiplicity-free, so the commutant of `H_{n-1}` in `End(V_μ)` is the Gelfand–Tsetlin algebra"* —
the Okounkov–Vershik route.  That argument is correct but **far heavier than necessary**, and it is
not the one used here.  `genMat` is defined with exactly two nonzero entries per column — the
diagonal, and the swap partner `swapTableau T k` — so fact 1 is immediate: the swap partner moves
`k+1` to the cell that held `k` (`cellOf_swapTableau_succ`), which is a different cell
(`cellOf_ne`).  Twelve lines, no representation theory.  Fact 2 is the same argument against
`cellOf_swapTableau_of_ne`.

I record this rather than quietly using the shorter route: the heavier justification is what the
earlier docstring and bean claim, and a reader comparing them should see which one the Lean actually
takes.

## What is still NOT proved

`trace_mul_genMat` is about **one** `V_λ`.  The Markov condition is a statement about the weighted
sum over all `λ ⊢ n+1`, and assembling it needs the λ-indexed decomposition of `H_{n+1}` and the
weights — i.e. `heckeWedderburn` plus `ocneanuWeight`, together with the corner identities of
`OcneanuWeightMarkovCorner`.  That assembly is not done here.  So the Markov condition remains open;
what has changed is that its structural half is now Lean, not paper.  Bean `qou-uer7`.

## Base ring (§7c)

`ℝ`, inherited: `genMat` and `seminormalParam` are `ℝ`-valued because `seminormalRep` is
(`OffDiagNonvanishing.sq_geom_lt` is an inequality in an ordered field).  Nothing here adds an
archimedean dependency of its own.

LaTeX label: `thm:seminormal-block-trace`
-/

namespace QOU.SchurWeyl
namespace SeminormalRep

open QOU.Mathlib (StandardYoungTableau)
open QOU.SchurWeyl.TableauCells QOU.SchurWeyl.Seminormal

variable {μ : YoungDiagram}

/-- The seminormal matrix of `σ_k` vanishes off the diagonal between tableaux that agree on the
cell of `k+1`. -/
theorem genMat_eq_zero_of_cellOf_succ_eq (q : ℝ) {k : ℕ} (hk : 1 ≤ k)
    (hkn : k + 1 ≤ μ.cells.card) {T T' : StandardYoungTableau μ} (hne : T' ≠ T)
    (hcell : cellOf T' (k + 1) = cellOf T (k + 1)) :
    genMat q k hk hkn T' T = 0 := by
  classical
  by_cases hadm : SwapAdmissible T k
  · by_cases hsw : T' = swapTableau T k hk hkn hadm
    · exfalso
      rw [hsw, cellOf_swapTableau_succ T hk hkn hadm] at hcell
      exact cellOf_ne T ⟨hk, by omega⟩ ⟨by omega, hkn⟩ hcell
    · exact genMat_apply_of_ne q k hk hkn hne hadm hsw
  · exact genMat_of_not_admissible q k hk hkn hne hadm

/-- An **earlier** generator never moves the cell of `N`: if `σ_l`'s matrix entry between `T'` and
`T` is nonzero and `l + 1 < N`, then `T'` and `T` agree on the cell of `N`.  This is the statement
that `H_{N-1} ⊂ H_N` preserves the block decomposition by `cellOf · N`. -/
theorem cellOf_eq_of_genMat_ne_zero (q : ℝ) {l N : ℕ} (hl : 1 ≤ l)
    (hln : l + 1 ≤ μ.cells.card) (hN : N ∈ Set.Icc 1 μ.cells.card) (hlN : l + 1 < N)
    {T T' : StandardYoungTableau μ} (h : genMat q l hl hln T' T ≠ 0) :
    cellOf T' N = cellOf T N := by
  classical
  by_cases hne : T' = T
  · rw [hne]
  · by_cases hadm : SwapAdmissible T l
    · by_cases hsw : T' = swapTableau T l hl hln hadm
      · rw [hsw, cellOf_swapTableau_of_ne T hl hln hadm hN (by omega) (by omega)]
      · exact absurd (genMat_apply_of_ne q l hl hln hne hadm hsw) h
    · exact absurd (genMat_of_not_admissible q l hl hln hne hadm) h

/-- **The trace identity the Markov reduction runs on.**  For any matrix `X` that preserves the
block decomposition by `cellOf · (k+1)` — in particular the image of any element of the subalgebra
generated by `σ_1, …, σ_{k-1}`, by `cellOf_eq_of_genMat_ne_zero` — the trace of `X · σ_k` picks up
only the diagonal:

`tr(X · σ_k) = ∑_T X_{TT} · seminormalParam q (axialDist T k)`.

Both cross terms die: off-diagonal entries of `σ_k` cross blocks, and `X` is zero across blocks. -/
theorem trace_mul_genMat (q : ℝ) {k : ℕ} (hk : 1 ≤ k) (hkn : k + 1 ≤ μ.cells.card)
    (X : Matrix (StandardYoungTableau μ) (StandardYoungTableau μ) ℝ)
    (hX : ∀ T S, cellOf T (k + 1) ≠ cellOf S (k + 1) → X T S = 0) :
    (X * genMat q k hk hkn).trace
      = ∑ T : StandardYoungTableau μ, X T T * seminormalParam q (axialDist T k) := by
  classical
  rw [Matrix.trace]
  simp only [Matrix.diag_apply, Matrix.mul_apply]
  refine Finset.sum_congr rfl fun T _ => ?_
  have hsingle : (∑ S : StandardYoungTableau μ, X T S * genMat q k hk hkn S T)
      = X T T * genMat q k hk hkn T T := by
    refine Finset.sum_eq_single T ?_ (fun h => absurd (Finset.mem_univ T) h)
    intro S _ hST
    by_cases hc : cellOf S (k + 1) = cellOf T (k + 1)
    · rw [genMat_eq_zero_of_cellOf_succ_eq q hk hkn hST hc, mul_zero]
    · rw [hX T S (Ne.symm hc), zero_mul]
  rw [hsingle, genMat_diag]

end SeminormalRep
end QOU.SchurWeyl
