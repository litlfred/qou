import QOU.SchurWeyl.HeckeAlgebra

/-!
# QOU.SchurWeyl.HeckeDim3 — `H_3(q)` is spanned by the six `T_w` words (SW-7 infra)

`H_3(q) = Hecke K q qi 2` (two generators `σ₀, σ₁`) is spanned as a `K`-module
by the six reduced words

  `1, σ₀, σ₁, σ₀σ₁, σ₁σ₀, σ₀σ₁σ₀`  (= `{T_w : w ∈ S_3}`),

so `dim_K H_3(q) ≤ 6`.  This is the spanning half of the Iwahori–Hecke basis
theorem `dim H_n(q) = n!` at `n = 3` — the missing gate to the Wedderburn
isomorphism (SW-7) and hence to R2-inst.  The matching lower bound
`dim ≥ 6` (linear independence, via the three irreducible representations) is a
separate result.

The proof: the `K`-span `S` of the six words contains `1` and is closed under
left multiplication by each generator (12 explicit reductions using only the
quadratic relation `σ_i² = (q-qi)σ_i + (q·qi)·1` and the braid relation
`σ₀σ₁σ₀ = σ₁σ₀σ₁`), so `S` contains the submonoid generated by `{σ₀,σ₁}`; since
that submonoid's span is `adjoin{σ₀,σ₁} = ⊤`, `S = ⊤`.

Base ring: generic `[CommRing K]` (§7c — purely algebraic; no archimedean input).

LaTeX label: `prop:hecke3-spanned-by-six`
-/

namespace QOU.SchurWeyl

open Hecke

namespace HeckeDim3

variable {K : Type*} [CommRing K] {q qi : K}

/-- Abbreviation for the first generator `σ₀ ∈ H_3(q)`. -/
local notation3 "s₀" => σ K q qi 2 0
/-- Abbreviation for the second generator `σ₁ ∈ H_3(q)`. -/
local notation3 "s₁" => σ K q qi 2 1

/-- The six reduced words `{T_w : w ∈ S_3}` spanning `H_3(q)`. -/
def sixWords : Set (Hecke K q qi 2) :=
  {1, s₀, s₁, s₀ * s₁, s₁ * s₀, s₀ * s₁ * s₀}

theorem one_mem_span : (1 : Hecke K q qi 2) ∈ Submodule.span K (sixWords (q := q) (qi := qi)) :=
  Submodule.subset_span (by simp [sixWords])

theorem s₀_mem : s₀ ∈ Submodule.span K (sixWords (q := q) (qi := qi)) :=
  Submodule.subset_span (by simp [sixWords])

theorem s₁_mem : s₁ ∈ Submodule.span K (sixWords (q := q) (qi := qi)) :=
  Submodule.subset_span (by simp [sixWords])

theorem s₀s₁_mem : s₀ * s₁ ∈ Submodule.span K (sixWords (q := q) (qi := qi)) :=
  Submodule.subset_span (by simp [sixWords])

theorem s₁s₀_mem : s₁ * s₀ ∈ Submodule.span K (sixWords (q := q) (qi := qi)) :=
  Submodule.subset_span (by simp [sixWords])

theorem s₀s₁s₀_mem : s₀ * s₁ * s₀ ∈ Submodule.span K (sixWords (q := q) (qi := qi)) :=
  Submodule.subset_span (by simp [sixWords])

/-- The braid relation in clean form: `σ₀σ₁σ₀ = σ₁σ₀σ₁`. -/
theorem braid3 : s₀ * s₁ * s₀ = s₁ * s₀ * s₁ := by
  have h := σ_braid K q qi 2 0 (by norm_num)
  simpa using h

/-- The generators generate `H_3(q)` as an algebra. -/
theorem adjoin_gens_eq_top :
    Algebra.adjoin K ({s₀, s₁} : Set (Hecke K q qi 2)) = ⊤ := by
  rw [eq_top_iff]
  rintro x -
  obtain ⟨f, rfl⟩ := RingQuot.mkAlgHom_surjective K (HeckeRel K q qi 2) x
  induction f using FreeAlgebra.induction with
  | grade0 r =>
      have : (RingQuot.mkAlgHom K (HeckeRel K q qi 2)) (algebraMap K _ r)
          = algebraMap K (Hecke K q qi 2) r := (RingQuot.mkAlgHom K _).commutes r
      rw [this]; exact Subalgebra.algebraMap_mem _ r
  | grade1 i =>
      fin_cases i
      · exact Algebra.subset_adjoin (Or.inl rfl)
      · exact Algebra.subset_adjoin (Or.inr rfl)
  | mul a b ha hb => rw [map_mul]; exact mul_mem ha hb
  | add a b ha hb => rw [map_add]; exact add_mem ha hb

/-- Left multiplication by a generator preserves the span of the six words:
the 12 explicit quadratic/braid reductions. -/
theorem gen_mul_mem (a : Hecke K q qi 2) (ha : a = s₀ ∨ a = s₁)
    (b : Hecke K q qi 2) (hb : b ∈ Submodule.span K (sixWords (q := q) (qi := qi))) :
    a * b ∈ Submodule.span K (sixWords (q := q) (qi := qi)) := by
  have hq0 := σ_quadratic K q qi 2 0
  have hq1 := σ_quadratic K q qi 2 1
  have hbr := braid3 (q := q) (qi := qi)
  -- Reduce to: `a * w ∈ span` for each of the six generating words `w`.
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hb
  · -- b is one of the six words
    intro w hw
    simp only [sixWords, Set.mem_insert_iff, Set.mem_singleton_iff] at hw
    rcases ha with rfl | rfl <;> rcases hw with rfl | rfl | rfl | rfl | rfl | rfl
    -- 12 cases.
    · -- s₀ * 1
      rw [mul_one]; exact s₀_mem
    · -- s₀ * s₀ = (q-qi)•s₀ + (q*qi)•1
      rw [hq0]
      exact add_mem (Submodule.smul_mem _ _ s₀_mem) (Submodule.smul_mem _ _ one_mem_span)
    · -- s₀ * s₁
      exact s₀s₁_mem
    · -- s₀ * (s₀ * s₁) = (q-qi)•(s₀*s₁) + (q*qi)•s₁
      have : s₀ * (s₀ * s₁) = (q - qi) • (s₀ * s₁) + (q * qi) • s₁ := by
        rw [← mul_assoc, hq0, add_mul, smul_mul_assoc, smul_mul_assoc, one_mul]
      rw [this]
      exact add_mem (Submodule.smul_mem _ _ s₀s₁_mem) (Submodule.smul_mem _ _ s₁_mem)
    · -- s₀ * (s₁ * s₀) = s₀*s₁*s₀
      rw [← mul_assoc]; exact s₀s₁s₀_mem
    · -- s₀ * (s₀ * s₁ * s₀) = (q-qi)•(s₀*s₁*s₀) + (q*qi)•(s₁*s₀)
      have : s₀ * (s₀ * s₁ * s₀) = (q - qi) • (s₀ * s₁ * s₀) + (q * qi) • (s₁ * s₀) := by
        rw [show s₀ * (s₀ * s₁ * s₀) = (s₀ * s₀) * (s₁ * s₀) by noncomm_ring, hq0,
          add_mul, smul_mul_assoc, smul_mul_assoc, one_mul, ← mul_assoc]
      rw [this]
      exact add_mem (Submodule.smul_mem _ _ s₀s₁s₀_mem) (Submodule.smul_mem _ _ s₁s₀_mem)
    · -- s₁ * 1
      rw [mul_one]; exact s₁_mem
    · -- s₁ * s₀
      exact s₁s₀_mem
    · -- s₁ * s₁ = (q-qi)•s₁ + (q*qi)•1
      rw [hq1]
      exact add_mem (Submodule.smul_mem _ _ s₁_mem) (Submodule.smul_mem _ _ one_mem_span)
    · -- s₁ * (s₀ * s₁) = s₁*s₀*s₁ = s₀*s₁*s₀
      rw [← mul_assoc, ← hbr]; exact s₀s₁s₀_mem
    · -- s₁ * (s₁ * s₀) = (q-qi)•(s₁*s₀) + (q*qi)•s₀
      have : s₁ * (s₁ * s₀) = (q - qi) • (s₁ * s₀) + (q * qi) • s₀ := by
        rw [← mul_assoc, hq1, add_mul, smul_mul_assoc, smul_mul_assoc, one_mul]
      rw [this]
      exact add_mem (Submodule.smul_mem _ _ s₁s₀_mem) (Submodule.smul_mem _ _ s₀_mem)
    · -- s₁ * (s₀ * s₁ * s₀) = (s₁*s₀*s₁)*s₀ = (s₀*s₁*s₀)*s₀ = (q-qi)•(s₀*s₁*s₀) + (q*qi)•(s₀*s₁)
      have : s₁ * (s₀ * s₁ * s₀) = (q - qi) • (s₀ * s₁ * s₀) + (q * qi) • (s₀ * s₁) := by
        rw [show s₁ * (s₀ * s₁ * s₀) = (s₁ * s₀ * s₁) * s₀ by noncomm_ring, ← hbr,
          show s₀ * s₁ * s₀ * s₀ = (s₀ * s₁) * (s₀ * s₀) by noncomm_ring, hq0,
          mul_add, mul_smul_comm, mul_smul_comm, mul_one]
      rw [this]
      exact add_mem (Submodule.smul_mem _ _ s₀s₁s₀_mem) (Submodule.smul_mem _ _ s₀s₁_mem)
  · -- 0
    rw [mul_zero]; exact Submodule.zero_mem _
  · -- add
    intro x y _ _ hx hy; rw [mul_add]; exact add_mem hx hy
  · -- smul
    intro c x _ hx; rw [mul_smul_comm]; exact Submodule.smul_mem _ _ hx

/-- **`H_3(q)` is spanned by the six `T_w` words** (`dim_K H_3(q) ≤ 6`). -/
theorem span_sixWords_eq_top :
    Submodule.span K (sixWords (q := q) (qi := qi)) = ⊤ := by
  rw [eq_top_iff]
  rintro x -
  have hx : x ∈ Algebra.adjoin K ({s₀, s₁} : Set (Hecke K q qi 2)) := by
    rw [adjoin_gens_eq_top]; trivial
  have hspan : x ∈ Submodule.span K
      (↑(Submonoid.closure ({s₀, s₁} : Set (Hecke K q qi 2))) : Set (Hecke K q qi 2)) := by
    rw [← Algebra.adjoin_eq_span]; exact hx
  refine Submodule.span_le.mpr ?_ hspan
  intro y hy
  induction hy using Submonoid.closure_induction_left with
  | one => exact one_mem_span
  | mul_left a ha b _ ih =>
      exact gen_mul_mem a
        (by simpa [Set.mem_insert_iff, Set.mem_singleton_iff] using ha) b ih

end HeckeDim3

end QOU.SchurWeyl
