import Mathlib.Algebra.FreeAlgebra
import Mathlib.Algebra.RingQuot
import Mathlib.GroupTheory.Coxeter.Basic

/-!
# The Iwahori–Hecke algebra of a Coxeter matrix

Mathlib-style local infrastructure. Mathlib has a `CoxeterMatrix` and a
`CoxeterSystem`, but **no Hecke algebra of any kind** — measured against the built
`.olean` tree (the source is not present in every container), with `CoxeterSystem` as
a positive control: `CoxeterSystem` occurs in three modules, `Hecke` in one, and that
one is `Mathlib/NumberTheory/FLT/Basic`, where it is a docstring mention of Hecke
*operators* in the modularity story. So this file builds the object from `FreeAlgebra`
and `RingQuot` rather than wrapping something upstream.

## What this is, and what `QOU.IwahoriHecke` is not

`QOU.IwahoriHecke.Quotient.IwahoriHeckeQuot` imposes the **quadratic relation only**;
its braid relations were deferred. That makes it a free product of copies of
`R[x]/((x − q)(x + 1))`, one per generator — a legitimate ring, but not a Hecke
algebra, and every theorem stated about it is a theorem about that free product.

`HeckeAlgebra R q M` below imposes **both** families, so it is the Iwahori–Hecke
algebra of the Coxeter matrix `M` in the Iwahori normalisation

  `(T_i − q)(T_i + 1) = 0`,  `T_i T_j T_i ⋯ = T_j T_i T_j ⋯` (`M i j` factors each side).

## Design notes

* **The relation is an `inductive`**, not a `Set` of ideal generators. `RingQuot`
  quotients by the ring congruence *generated by* an arbitrary relation, so the two
  families can be listed as two constructors and no ideal-membership reasoning is
  needed anywhere downstream.
* **`M` is a bare `B → B → ℕ`**, not a `CoxeterMatrix B`. Nothing in the construction
  or in the universal property needs symmetry, the diagonal condition, or any other
  Coxeter axiom; requiring `CoxeterMatrix` would buy nothing and would couple this
  file to an API that has drifted across Mathlib refactors. A caller holding a
  `CoxeterMatrix B` passes its coercion.
* **Base ring is a generic `[CommRing R]`** (§7c). No ordering, no `ℝ`, no
  archimedean construct appears; `q` is a formal parameter.
-/

namespace QOU.MathlibExt.IwahoriHecke

universe u v w

/-! ## The alternating product -/

/-- The alternating product `a · b · a · b ⋯` with `n` factors.

`altProd a b 0 = 1`, `altProd a b 1 = a`, `altProd a b 2 = a * b`,
`altProd a b 3 = a * b * a`, and so on. This is the shape both sides of a braid
relation take. -/
def altProd {A : Type*} [Monoid A] : A → A → ℕ → A
  | _, _, 0 => 1
  | a, b, (n + 1) => a * altProd b a n

@[simp] theorem altProd_zero {A : Type*} [Monoid A] (a b : A) : altProd a b 0 = 1 := rfl

@[simp] theorem altProd_succ {A : Type*} [Monoid A] (a b : A) (n : ℕ) :
    altProd a b (n + 1) = a * altProd b a n := rfl

theorem altProd_one {A : Type*} [Monoid A] (a b : A) : altProd a b 1 = a := by
  simp [altProd]

theorem altProd_two {A : Type*} [Monoid A] (a b : A) : altProd a b 2 = a * b := by
  simp [altProd]

theorem altProd_three {A : Type*} [Monoid A] (a b : A) : altProd a b 3 = a * (b * a) := by
  simp [altProd]

/-- An alternating product of a single element is just a power. -/
theorem altProd_const {A : Type*} [Monoid A] (a : A) :
    ∀ n : ℕ, altProd a a n = a ^ n := by
  intro n
  induction n with
  | zero => simp
  | succ k ih => rw [altProd_succ, ih, pow_succ']

/-- Any multiplicative map transports an alternating product.

Stated through `MonoidHomClass` rather than for a bare `A →* B`, so that it applies
directly to the `AlgHom`s this file pushes relations along — `AlgHomClass` extends
`RingHomClass` extends `MonoidHomClass`, so no manual `.toMonoidHom` is needed. -/
theorem map_altProd {A : Type*} {C : Type*} [Monoid A] [Monoid C]
    {F : Type*} [FunLike F A C] [MonoidHomClass F A C] (φ : F) :
    ∀ (n : ℕ) (a b : A), φ (altProd a b n) = altProd (φ a) (φ b) n := by
  intro n
  induction n with
  | zero => intro a b; simp
  | succ k ih => intro a b; simp [ih]

/-! ## The defining relation -/

variable (R : Type v) [CommRing R] (q : R) {B : Type u} (M : B → B → ℕ)

/-- The two defining families of the Iwahori–Hecke algebra, as a relation on the free
algebra: the **quadratic** relation for each generator, and the **braid** relation for
each ordered pair.

`RingQuot` closes this up into a ring congruence, so listing the raw relations here is
enough — there is no ideal to generate and no two-sided-span reasoning downstream. -/
inductive Rel : FreeAlgebra R B → FreeAlgebra R B → Prop
  | quadratic (i : B) :
      Rel ((FreeAlgebra.ι R i - algebraMap R (FreeAlgebra R B) q) * (FreeAlgebra.ι R i + 1)) 0
  | braid (i j : B) :
      Rel (altProd (FreeAlgebra.ι R i) (FreeAlgebra.ι R j) (M i j))
          (altProd (FreeAlgebra.ι R j) (FreeAlgebra.ι R i) (M j i))

/-! ## The algebra -/

/-- **The Iwahori–Hecke algebra** of the Coxeter matrix `M` over `R` at parameter `q`,
in the Iwahori normalisation `(T_i − q)(T_i + 1) = 0`. -/
def HeckeAlgebra : Type max u v := RingQuot (Rel R q M)

noncomputable instance : Ring (HeckeAlgebra R q M) :=
  inferInstanceAs (Ring (RingQuot (Rel R q M)))

noncomputable instance : Algebra R (HeckeAlgebra R q M) :=
  inferInstanceAs (Algebra R (RingQuot (Rel R q M)))

/-- The generator `T_i`, the image of the free generator `i` in the quotient. -/
noncomputable def T (i : B) : HeckeAlgebra R q M :=
  RingQuot.mkAlgHom R (Rel R q M) (FreeAlgebra.ι R i)

variable {R q M}

/-- **The quadratic relation holds.** `(T_i − q)(T_i + 1) = 0`. -/
theorem T_quadratic (i : B) :
    (T R q M i - algebraMap R (HeckeAlgebra R q M) q) * (T R q M i + 1) = 0 := by
  have h := RingQuot.mkAlgHom_rel R (Rel.quadratic (R := R) (q := q) (M := M) i)
  simpa [T, map_mul, map_sub, map_add, map_one, AlgHom.commutes] using h

/-- **The braid relation holds.** The alternating product of `M i j` factors starting
with `T_i` equals the alternating product of `M j i` factors starting with `T_j`. -/
theorem T_braid (i j : B) :
    altProd (T R q M i) (T R q M j) (M i j) = altProd (T R q M j) (T R q M i) (M j i) := by
  have h := RingQuot.mkAlgHom_rel R (Rel.braid (R := R) (q := q) (M := M) i j)
  rwa [map_altProd, map_altProd] at h

/-! ### The generators are invertible

This is what makes the Hecke algebra a quotient of the **braid group** algebra rather
than merely of the free algebra, which is how AGENTS.md §7a frames it: `σ_i` is a
positive crossing and `σ_i⁻¹` a negative one, and the skein relation comes from
multiplying the quadratic relation through by `σ_i⁻¹`. That step needs the inverse to
exist, and nothing above supplied it. -/

/-- The quadratic relation, rearranged: `T_i (T_i − (q−1)) = q`.

This is the whole content of invertibility — over any ring in which `q` is a unit it
exhibits `q⁻¹(T_i − (q−1))` as an inverse. The only step beyond expanding is that
`algebraMap` is central. -/
theorem T_mul_sub (i : B) :
    T R q M i * (T R q M i - algebraMap R (HeckeAlgebra R q M) (q - 1))
      = algebraMap R (HeckeAlgebra R q M) q := by
  have h := T_quadratic (R := R) (q := q) (M := M) i
  have hc := Algebra.commutes (A := HeckeAlgebra R q M) q (T R q M i)
  have key : (T R q M i - algebraMap R (HeckeAlgebra R q M) q) * (T R q M i + 1)
      = T R q M i * (T R q M i - algebraMap R (HeckeAlgebra R q M) (q - 1))
        - algebraMap R (HeckeAlgebra R q M) q := by
    simp only [map_sub, map_one, sub_mul, mul_add, mul_sub, mul_one]
    rw [hc]
    abel
  rw [key] at h
  exact sub_eq_zero.mp h

/-- The same product in the other order. -/
theorem sub_mul_T (i : B) :
    (T R q M i - algebraMap R (HeckeAlgebra R q M) (q - 1)) * T R q M i
      = algebraMap R (HeckeAlgebra R q M) q := by
  have h := T_mul_sub (R := R) (q := q) (M := M) i
  have hc := Algebra.commutes (A := HeckeAlgebra R q M) q (T R q M i)
  have key : (T R q M i - algebraMap R (HeckeAlgebra R q M) (q - 1)) * T R q M i
      = T R q M i * (T R q M i - algebraMap R (HeckeAlgebra R q M) (q - 1)) := by
    simp only [map_sub, map_one, sub_mul, mul_sub, one_mul, mul_one]
    rw [hc]
  rw [key]
  exact h

/-- **Each generator is a unit**, whenever the parameter is.

So the presentation really does factor through the braid group: every `T_i` has a
two-sided inverse, and `σ_i⁻¹` in the skein dictionary denotes an actual element. -/
theorem isUnit_T (hq : IsUnit q) (i : B) : IsUnit (T R q M i) := by
  obtain ⟨u, hu⟩ := hq
  have hinv : (↑u⁻¹ : R) * q = 1 := by rw [← hu, Units.inv_mul]
  refine ⟨⟨T R q M i,
      algebraMap R (HeckeAlgebra R q M) (↑u⁻¹ : R)
        * (T R q M i - algebraMap R (HeckeAlgebra R q M) (q - 1)), ?_, ?_⟩, rfl⟩
  · rw [← mul_assoc, ← Algebra.commutes, mul_assoc, T_mul_sub, ← map_mul, hinv, map_one]
  · rw [mul_assoc, sub_mul_T, ← map_mul, hinv, map_one]

/-! ## Universal property -/

variable (R q M)

/-- **Existence.** A family `f : B → A` satisfying both relations induces an
`R`-algebra map out of the Hecke algebra. -/
noncomputable def lift {A : Type w} [Ring A] [Algebra R A] (f : B → A)
    (hq : ∀ i, (f i - algebraMap R A q) * (f i + 1) = 0)
    (hb : ∀ i j, altProd (f i) (f j) (M i j) = altProd (f j) (f i) (M j i)) :
    HeckeAlgebra R q M →ₐ[R] A :=
  RingQuot.liftAlgHom R ⟨FreeAlgebra.lift R f, by
    intro x y h
    induction h with
    | quadratic i =>
        simpa [map_mul, map_sub, map_add, map_one, FreeAlgebra.lift_ι_apply,
          AlgHom.commutes] using hq i
    | braid i j =>
        rw [map_altProd, map_altProd, FreeAlgebra.lift_ι_apply, FreeAlgebra.lift_ι_apply]
        exact hb i j⟩

@[simp] theorem lift_T {A : Type w} [Ring A] [Algebra R A] (f : B → A)
    (hq : ∀ i, (f i - algebraMap R A q) * (f i + 1) = 0)
    (hb : ∀ i j, altProd (f i) (f j) (M i j) = altProd (f j) (f i) (M j i)) (i : B) :
    lift R q M f hq hb (T R q M i) = f i := by
  show RingQuot.liftAlgHom R _ (RingQuot.mkAlgHom R (Rel R q M) (FreeAlgebra.ι R i)) = f i
  rw [RingQuot.liftAlgHom_mkAlgHom_apply]
  simp

/-- **Uniqueness.** Two `R`-algebra maps out of the Hecke algebra agreeing on every
generator are equal.

`RingQuot.mkAlgHom` is surjective, so it suffices that the composites agree; those are
maps out of a *free* algebra, so `FreeAlgebra.hom_ext` reduces that to the generators. -/
theorem hom_ext {A : Type w} [Ring A] [Algebra R A]
    (φ ψ : HeckeAlgebra R q M →ₐ[R] A) (h : ∀ i : B, φ (T R q M i) = ψ (T R q M i)) :
    φ = ψ := by
  have hcomp : φ.comp (RingQuot.mkAlgHom R (Rel R q M))
      = ψ.comp (RingQuot.mkAlgHom R (Rel R q M)) := by
    apply FreeAlgebra.hom_ext
    funext i
    simpa [T] using h i
  apply AlgHom.ext
  intro x
  obtain ⟨y, rfl⟩ := RingQuot.mkAlgHom_surjective R (Rel R q M) x
  exact congrArg (fun (α : FreeAlgebra R B →ₐ[R] A) => α y) hcomp

/-- **The universal property**, as a single `∃!`. -/
theorem exists_unique_lift {A : Type w} [Ring A] [Algebra R A] (f : B → A)
    (hq : ∀ i, (f i - algebraMap R A q) * (f i + 1) = 0)
    (hb : ∀ i j, altProd (f i) (f j) (M i j) = altProd (f j) (f i) (M j i)) :
    ∃! φ : HeckeAlgebra R q M →ₐ[R] A, ∀ i : B, φ (T R q M i) = f i := by
  refine ⟨lift R q M f hq hb, fun i => lift_T R q M f hq hb i, ?_⟩
  intro ψ hψ
  exact hom_ext R q M ψ _ (fun i => by rw [hψ i, lift_T])

/-! ## Non-vacuity

A quotient can collapse. `HeckeAlgebra R q M` is built by imposing relations on a free
algebra, and nothing so far rules out those relations forcing `0 = 1` — in which case
every theorem above would be true and empty. This section rules it out.

The witness is the **index representation** `T_i ↦ q`, the one-dimensional
representation sending every generator to the parameter. It needs `M` symmetric, which
every Coxeter matrix is (and `CoxeterMatrix` carries as a field), but the construction
above never required it, so it is taken as a hypothesis here rather than globally. -/

/-- **The index representation** `T_i ↦ q`.

Both relations are immediate: the quadratic factor `(q − q)` vanishes, and with every
generator sent to the same scalar each side of a braid relation is a power of `q`, so
symmetry of `M` is exactly what makes the two exponents agree. -/
noncomputable def indexRep (hM : ∀ i j, M i j = M j i) : HeckeAlgebra R q M →ₐ[R] R :=
  lift R q M (fun _ => q)
    (fun i => by simp)
    (fun i j => by rw [altProd_const, altProd_const, hM i j])

@[simp] theorem indexRep_T (hM : ∀ i j, M i j = M j i) (i : B) :
    indexRep R q M hM (T R q M i) = q :=
  lift_T R q M _ _ _ i

/-- **The sign representation** `T_i ↦ −1`.

The other one-dimensional representation, and the second extreme cell module. Its
quadratic check is even cheaper than `indexRep`'s: the *second* factor `(T_i + 1)`
vanishes on the nose, so nothing about `q` is used. -/
noncomputable def signRep (hM : ∀ i j, M i j = M j i) : HeckeAlgebra R q M →ₐ[R] R :=
  lift R q M (fun _ => -1)
    (fun i => by simp)
    (fun i j => by rw [altProd_const, altProd_const, hM i j])

@[simp] theorem signRep_T (hM : ∀ i j, M i j = M j i) (i : B) :
    signRep R q M hM (T R q M i) = -1 :=
  lift_T R q M _ _ _ i

/-- **The two extreme cell modules are distinct** whenever `q ≠ −1` and there is at
least one generator.

`indexRep` and `signRep` are the `q`-analogues of the trivial and sign representations
of `S_n`, i.e. the cell modules `S^{(n)}` and `S^{(1ⁿ)}`. At `q = −1` they coincide,
which is the first place the semisimplicity of `H_n(q)` fails. -/
theorem indexRep_ne_signRep [Nontrivial R] (hM : ∀ i j, M i j = M j i) (i : B)
    (hq : q ≠ -1) : indexRep R q M hM ≠ signRep R q M hM := by
  intro h
  apply hq
  have := congrArg (fun φ => φ (T R q M i)) h
  simpa using this

/-- **The Hecke algebra does not collapse.** Over a nontrivial base ring with a
symmetric Coxeter matrix, `0 ≠ 1` in `HeckeAlgebra R q M`.

Without this every theorem in this file would be vacuously true of the zero ring. -/
theorem nontrivial_of_symm [Nontrivial R] (hM : ∀ i j, M i j = M j i) :
    Nontrivial (HeckeAlgebra R q M) := by
  refine ⟨0, 1, fun h => ?_⟩
  have h' := congrArg (indexRep R q M hM) h
  rw [map_zero, map_one] at h'
  exact zero_ne_one h'

end QOU.MathlibExt.IwahoriHecke
