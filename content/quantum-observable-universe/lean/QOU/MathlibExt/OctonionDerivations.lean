      (0 : ℚ), (0 : ℚ), (0 : ℚ), (0 : ℚ), (0 : ℚ), (0 : ℚ), (1 : ℚ), (0 : ℚ)]]

/-- Each `octDerMat i` satisfies the concrete Leibniz rule (machine-checked). -/
theorem octDerMat_isDer (i : Fin 14) (u v : Fin 8 → ℚ) :
    (octDerMat i).mulVec (octMul u v)
      = octMul ((octDerMat i).mulVec u) v + octMul u ((octDerMat i).mulVec v) := by
  funext k
  fin_cases i <;>
    · simp only [octDerMat, octMul, Matrix.mulVec, dotProduct, Fin.sum_univ_eight,
        Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.empty_val', Matrix.cons_val_fin_one, Matrix.cons_val, Pi.add_apply,
        Matrix.head_cons, Matrix.head_fin_const]
      fin_cases k <;> simp <;> ring

/-- The 14 derivations as elements of the derivation space `Der𝕆`. -/
noncomputable def octDer (i : Fin 14) : Der𝕆 :=
  ⟨Matrix.mulVecLin (octDerMat i), mem_Der𝕆_of_isDer (octDerMat_isDer i)⟩
