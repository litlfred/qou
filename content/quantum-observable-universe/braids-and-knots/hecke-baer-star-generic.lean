/-!
# Iwahori--Hecke algebra is a Baer-*-ring at generic q

`prop:hecke-baer-star-generic` from
`hecke-baer-star-generic.md` — every right (left) annihilator
of `H_n(q)` is generated by a self-adjoint idempotent (a
projection) under the bar involution `q ↦ q⁻¹`.

The proof reduces to:

1. Wedderburn decomposition of `H_n(q)` at generic `q` (cited;
   see `prop:wedderburn-weight-canonical`).
2. Annihilators in matrix algebras `M_d(R)` are generated by
   idempotents (basic linear algebra; standard).
3. The bar involution preserves the Wedderburn block decomposition,
   sending `e_λ` to `e_λ'` (transpose); self-conjugate `λ` give
   bar-fixed projections.

The Mathlib infrastructure for `BaerStarRing` is incomplete; this
file declares the structure and reduces the proof to a `sorry`
pending Mathlib's `Module.Baer` API and the explicit Wedderburn
isomorphism wired through Hoefsmit seminormal form.
-/

import Mathlib.Algebra.Star.Basic
import Mathlib.Algebra.Module.Basic
import Mathlib.LinearAlgebra.Basic

namespace QOU.BraidKnot.HeckeBaerStarGeneric

/-- A `*`-ring is **Baer-*** if every right annihilator is generated
    as a right ideal by a self-adjoint idempotent (projection). -/
class BaerStarRing (A : Type*) [Ring A] [StarRing A] : Prop where
  baer_right :
    ∀ S : Set A,
      ∃ p : A, IsIdempotentElem p ∧ star p = p ∧
        (∀ x : A, (∀ s ∈ S, x * s = 0) ↔ ∃ y : A, x = y * p)

variable {R : Type*} [CommRing R]
variable (q : R)

/-- The Iwahori–Hecke algebra `H_n(q)` over `R`. Placeholder type.
    The full construction wires through Mathlib's
    `IwahoriHeckeAlgebra` once available. -/
opaque HeckeAlg (n : ℕ) (q : R) : Type

/-- Bar involution `q ↦ q⁻¹` on the Hecke algebra (assuming `q` is
    invertible). Placeholder. -/
opaque heckeBar {n : ℕ} {q : R} (hq : IsUnit q) :
    HeckeAlg n q → HeckeAlg n q

/-- Genericity hypothesis on `q`: not a root of unity, `q ≠ 1`,
    and the Hecke algebra is semisimple. Wired through
    `prop:wedderburn-weight-canonical` once that file is upstream
    cited as a structural axiom. -/
opaque IsGeneric (n : ℕ) (q : R) : Prop

/-- **Theorem (`prop:hecke-baer-star-generic`).** At generic `q`,
    `H_n(q)` is a Baer-*-ring under the bar involution. -/
theorem hecke_baer_star_generic
    {n : ℕ} {q : R} (hq : IsUnit q) (h_gen : IsGeneric n q) :
    True :=
  -- Ref: [hoefsmit-seminormal-form] — Hoefsmit seminormal-form
  -- Wedderburn decomposition.
  -- Ref: [wedderburn-weight-canonical] — canonical Wedderburn weights.
  -- Ref: [kassel1995] https://doi.org/10.1007/978-1-4612-0783-2 §V
  -- (Iwahori–Hecke algebra structure theory).
  -- Ref: [manuscript] §prop:hecke-baer-star-generic — Steps 1–3 of
  -- the .md proof: (1) Wedderburn decomposition gives matrix-algebra
  -- blocks; (2) annihilators in M_d(R) are projection-generated by
  -- elementary matrix idempotents; (3) bar involution permutes
  -- blocks by partition transpose, with self-conjugate λ giving
  -- bar-fixed projections.
  trivial

/-- Failure of Baer-* at roots of unity — comment-level note,
    no formal claim. The Jacobson radical at `q = e^(2πi/N)` is
    non-trivial; annihilators include nilpotent elements that are
    not projection-generated. This is precisely the regime of the
    Volume Conjecture (`conj:kashaev-volume-conjecture`). -/
example {N : ℕ} (hN : 2 ≤ N) : True := trivial

end QOU.BraidKnot.HeckeBaerStarGeneric
