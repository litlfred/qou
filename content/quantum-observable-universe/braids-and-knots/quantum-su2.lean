import QOU.Basic
import Mathlib.FieldTheory.RatFunc.Basic
import Mathlib.Data.Int.Basic
import Mathlib.Tactic


/-!
# QOU.QuantumSu2

The quantum group 𝒰_q(𝔰𝔲(2)): associative ℂ-algebra generated by
E, F, K, K⁻¹ with relations KEK⁻¹ = q²E, KFK⁻¹ = q⁻²F,
and [E,F] = (K − K⁻¹)/(q − q⁻¹).

LaTeX label: `def:quantum-su2`

## References

- [lusztig1993] https://doi.org/10.1007/978-0-8176-4717-9

**Ground ring**: `R_q = ℚ(q) = RatFunc ℚ` (the field of rational
functions in the indeterminate `q` over ℚ). The quantum-group relation
`[E,F] = (K − K⁻¹)/(q − q⁻¹)` and the `q`-integers
`[n]_q = (qⁿ − 1)/(q − 1)` both divide by elements that are *not*
invertible in `ℤ[q, q⁻¹]` (which is only a `CommRing`); the field of
fractions `ℚ(q)` is the smallest ground ring in which these formal
quotients are literal. Part of the formal proof chain. The parameter
`q` is the canonical indeterminate of `R_q`. Specialise via
`ι : R_q → ℝ, q ↦ q₀` for numerical evaluation.
-/

namespace QOU

-- Ground ring `R_q = ℚ(q) = RatFunc ℚ` (rational functions over ℚ).
-- See `QOU.Archimedean.GroundRing` for the compiled definition.
abbrev R_q := RatFunc ℚ

/-- The canonical indeterminate `q` of `R_q = ℚ(q)`. -/
noncomputable def q_param : R_q := RatFunc.X

/-- The formal inverse `q⁻¹` of the indeterminate in `R_q = ℚ(q)`. -/
noncomputable def q_inv_param : R_q := RatFunc.X⁻¹

/-- **Quantum group 𝒰_q(𝔰𝔲(2))** generator data. -/
-- Ref: [lusztig1993] Lusztig, "Introduction to Quantum Groups," Birkhäuser 1993 (DOI: 10.1007/978-0-8176-4717-9)
structure QuantumSu2 where
  /-- The deformation parameter q > 0, q ≠ 1. -/
  q : R_q
  -- q_pos : 0 < q  -- (archimedean; not meaningful over R_q)
  q_ne_one : q ≠ 1
  /-- The algebra carrier type. -/
  Algebra : Type*
  [instRing : Ring Algebra]
  /-- Generators E, F, K, K⁻¹. -/
  E : Algebra
  F : Algebra
  K : Algebra
  K_inv : Algebra
  /-- K · K⁻¹ = 1. -/
  K_inv_left : K_inv * K = 1
  K_inv_right : K * K_inv = 1

attribute [instance] QuantumSu2.instRing

/-- The q-integer [n]_q = (qⁿ - 1)/(q - 1). -/
-- Ref: [lusztig1993]
noncomputable def QuantumSu2.qInt (qs : QuantumSu2) (n : ℕ) : R_q :=
  (qs.q ^ n - 1) / (qs.q - 1)

/-- [1]_q = 1 for all q ≠ 1. -/
-- Ref: [lusztig1993]
theorem QuantumSu2.qInt_one (qs : QuantumSu2) : qs.qInt 1 = 1 := by
  unfold qInt; simp [pow_one, div_self (sub_ne_zero.mpr qs.q_ne_one)]

/-- [2]_q = q + 1.

    Proved through the *multiplicative relation* `q² − 1 = (q + 1)(q − 1)`
    (`div_eq_iff`) rather than by `field_simp`: the content is a
    division-free identity in `ℤ[q]`, and only the quotient presentation of
    `[n]_q` needs the field.  (§7c R[h] pattern; see the ground-ring note in
    the module header for why `R_q = ℚ(q)` itself is not reducible here.) -/
-- Ref: [lusztig1993]
theorem QuantumSu2.qInt_two (qs : QuantumSu2) : qs.qInt 2 = qs.q + 1 := by
  unfold qInt
  have h : qs.q - 1 ≠ 0 := sub_ne_zero.mpr qs.q_ne_one
  rw [div_eq_iff h]
  ring

end QOU
