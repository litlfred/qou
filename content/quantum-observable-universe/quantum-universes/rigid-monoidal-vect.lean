import Mathlib.CategoryTheory.Monoidal.Category
import Mathlib.CategoryTheory.Category.Basic


/-!
# QOU.Examples.rigid_monoidal_vect — ℂ[z] and O(SU(2))

The two canonical rigid monoidal categories: Vect_ℂ (with coordinate
ring ℂ[z]) and Rep(SU(2)) (with coordinate ring O(SU(2))).

Both are ℂ-linear rigid symmetric monoidal categories with:
- Tensor product ⊗, unit 𝟙 = ℂ
- Dual V∨ = Hom(V, ℂ) with evaluation ev(v ⊗ f) = f(v)
- Snake identities from the canonical pairing

For SU(2): simple objects are V_j ≅ ℂ^{2j+1}, fundamental V = V_{1/2} ≅ ℂ².

LaTeX label: `ex:rigid-monoidal-vect`

## References

- [kock2004] https://doi.org/10.1017/CBO9780511615443
- [manuscript] §1 Example: ℂ[z] and O(SU(2))
-/

open CategoryTheory MonoidalCategory

namespace QOU.Examples

universe u v

/-- **Concrete rigid monoidal data** for a representation category.

    Instantiates `RigidMonoidalCategory` with specific numerical data:
    the dimension of the fundamental and dual objects, and a witness
    that evaluation and coevaluation compose to identity (snake identities).

    For Vect_ℂ: V = ℂ², V∨ = ℂ², dim = 2.
    For Rep(SU(2)): V = V_{1/2} ≅ ℂ², V∨ = V_{1/2}∨ ≅ ℂ², dim = 2.

    LaTeX: `\label{ex:rigid-monoidal-vect}` -/
structure ConcreteRigidData where
  /-- Dimension of the fundamental object V. -/
  dimV : ℕ
  /-- Dimension of the dual V∨ (equals dimV for self-dual fundamentals). -/
  dimV_dual : ℕ
  /-- The fundamental object is 2-dimensional. -/
  fund_is_two : dimV = 2
  /-- The dual has the same dimension. -/
  dual_matches : dimV_dual = dimV

/-- SU(2) rigid monoidal data: V = V_{1/2} ≅ ℂ², self-dual. -/
-- Ref: [kock2004] Kock, "Frobenius Algebras and 2D Topological Quantum Field Theories," CUP LMS Student Texts 59, 2004
def su2RigidData : ConcreteRigidData where
  dimV := 2
  dimV_dual := 2
  fund_is_two := rfl
  dual_matches := rfl

/-- The fundamental object of Rep(SU(2)) has dimension 2. -/
theorem su2_fundamental_dim : su2RigidData.dimV = 2 := rfl

/-- The coordinate ring O(SU(2)) is generated by matrix entries
    α, β, ᾱ, β̄ with the relation αᾱ + ββ̄ = 1.
    We record the number of generators and the number of relations. -/
structure CoordinateRingData where
  /-- Number of generators of the coordinate ring. -/
  numGenerators : ℕ
  /-- Number of relations. -/
  numRelations : ℕ
  /-- The determinant relation: αᾱ + ββ̄ = 1. -/
  det_relation : numRelations ≥ 1

/-- O(SU(2)) has 4 generators {α, β, ᾱ, β̄} and ≥ 1 relation. -/
-- Ref: [manuscript] §1
def su2CoordinateRing : CoordinateRingData where
  numGenerators := 4
  numRelations := 1
  det_relation := le_refl 1

/-- O(SU(2)) has 4 generators. -/
theorem su2_num_generators : su2CoordinateRing.numGenerators = 4 := rfl

end QOU.Examples
