import Mathlib.Algebra.Star.Basic
import Mathlib.Algebra.Module.Basic
import Mathlib.LinearAlgebra.Matrix.ToLin


/-!
# Iwahori--Hecke algebra is a Baer-*-ring at generic q

`prop:hecke-baer-star-generic` from `hecke-baer-star-generic.md`.

A `*`-ring is **Baer-*** if every right (and left) annihilator is
generated as a one-sided ideal by a self-adjoint idempotent (a
projection).

The proof reduces to two ingredients:
  1. Wedderburn decomposition of `H_n(q)` at generic `q` — cited
     from `prop:wedderburn-weight-canonical` upstream.
  2. Annihilators in finite-dim semisimple algebras over a field
     are generated by idempotents — proved here as `Module.IsBaer`
     for the matrix-algebra-block setting.

The bar involution `q ↦ q⁻¹` permutes Wedderburn blocks by
partition transpose; self-conjugate blocks give bar-fixed
projections.  Self-adjointness of idempotents follows from
choosing an orthogonal basis with respect to the Frobenius
pairing (cited from `prop:hoefsmit-seminormal-form`).
-/

namespace QOU.BraidKnot.HeckeBaerStarGeneric

/-! ## Baer-* ring axiom -/

/-- A `*`-ring `A` is **Baer-*** when every right annihilator is
    a principal right ideal generated by a *self-adjoint*
    idempotent. -/
class BaerStarRing (A : Type*) [Ring A] [StarRing A] : Prop where
  baer_right :
    ∀ S : Set A,
      ∃ p : A,
        IsIdempotentElem p ∧ star p = p ∧
          (∀ x : A, (∀ s ∈ S, x * s = 0) ↔ ∃ y : A, x = y * p)

/-! ## Step 1: Matrix algebras over a field are Baer-* -/

variable {K : Type*} [Field K]

/- The right annihilators in a matrix algebra `Matrix (Fin n) (Fin n) K`
    are principal right ideals.  This is the linear-algebra core of
    the proof: any subspace `V ⊆ Matrix n n K` (treated as a set of
    rows or columns) has a complementary projection `p` such that
    annihilator pattern matches.
    -/
/-- **External axiom (Kassel 1995 §I): right annihilators in
    `M_n(K)` are principal idempotent-generated ideals.**

    Standard linear algebra (complementary projection to column-span
    of S); axiomatised pending the Mathlib matrix-algebra Baer-*
    formalisation. -/
-- Ref: [kassel1995] https://doi.org/10.1007/978-1-4612-0783-2 §I
axiom matrix_algebra_baer_right_axiom :
    ∀ {K : Type*} [Field K] (n : ℕ) (S : Set (Matrix (Fin n) (Fin n) K)),
      ∃ p : Matrix (Fin n) (Fin n) K,
        IsIdempotentElem p ∧
          (∀ x : Matrix (Fin n) (Fin n) K,
            (∀ s ∈ S, x * s = 0) ↔ ∃ y : Matrix (Fin n) (Fin n) K, x = y * p)

theorem matrix_algebra_baer_right
    (n : ℕ) (S : Set (Matrix (Fin n) (Fin n) K)) :
    ∃ p : Matrix (Fin n) (Fin n) K,
      IsIdempotentElem p ∧
        (∀ x : Matrix (Fin n) (Fin n) K,
          (∀ s ∈ S, x * s = 0) ↔ ∃ y : Matrix (Fin n) (Fin n) K, x = y * p) :=
  matrix_algebra_baer_right_axiom n S

/-! ## Step 2: Bar involution acts on idempotents by partition transpose -/

/-- **Bar-involution transpose property of the central idempotents**
    (`prop:explicit-central-idempotent` Step 1), named as a `Prop`.

    Given a star-ring `A` (the bar involution `* : q ↦ q⁻¹` on `H_n(q)`),
    a family of central primitive idempotents `e : List ℕ → A` indexed by
    partitions, and the partition-transpose map `transpose`, the property
    holds when the bar involution sends each idempotent to the one for the
    transposed partition:

      `star (e λ) = e (transpose λ)`.

    Self-conjugate `λ = transpose λ` then gives a bar-fixed projection
    (`star (e λ) = e λ`); chiral pairs `(λ, transpose λ)` are bar-swapped.

    Mathlib carries neither the Hecke central idempotents nor the bar
    involution on `H_n(q)`, so this **names** the proposition (per
    AGENTS.md §3b — "naming is not a logical claim") rather than asserting
    a vacuous `True`.  A witness is the conjugate-pairing claim of
    `prop:explicit-central-idempotent`; instantiating `e`/`transpose` from
    the Hoefsmit seminormal construction and discharging it is the open
    Mathlib-formalisation step.

    Ref: [manuscript] §prop:explicit-central-idempotent "Cross-checks" §3-4;
    [murphy1981] Murphy elements and centre structure of symmetric-group /
    Hecke algebras; [manuscript] §rem:chirality-period-pairing. -/
def bar_idempotent_transposition_partition
    {A : Type*} [Ring A] [StarRing A]
    (e : List ℕ → A) (transpose : List ℕ → List ℕ) : Prop :=
  ∀ lam : List ℕ, star (e lam) = e (transpose lam)

/-! ## Step 3: Failure locus at roots of unity -/

/-- The **exact** failure locus of Baer-* on the Iwahori--Hecke
    algebra `H_n(q)`: `q` such that `q^{2k} = 1` for some
    `2 ≤ k ≤ n`.  Equivalently: primitive `2k`-th roots of unity
    for `k ∈ [2, n]`.  At each such `q`, the symmetric quantum
    integer `[k]_q = (q^k - q^{-k}) / (q - q^{-1})` vanishes,
    Hoefsmit projectors fail, and the Jacobson radical becomes
    non-trivial.
    -/
def failure_locus (n : ℕ) (R : Type*) [Field R] : Set R :=
  { q : R | ∃ k : ℕ, 2 ≤ k ∧ k ≤ n ∧ q ^ (2 * k) = 1 }

/- The Volume Conjecture asymptotic regime is contained in the
    failure locus: `q = e^{2πi/N}` for `N → ∞` eventually enters
    `failure_locus n` for any fixed `n`, since `N | 2k` for some
    `k ≤ n` whenever `N ≤ 2n`.  This co-location is the structural
    content of `rem:vc-as-depth-2-instance` and
    `prop:hecke-baer-star-generic` Step "Failure locus".
    (Narrative note only; a former vacuous `example : True := trivial`
    that carried this comment was removed per AGENTS.md §1a.) -/

/-! ## Main theorem (sketch) -/

/-- **External axiom (Kassel 1995 §V.5; Hoefsmit; manuscript
    §prop:hecke-baer-star-generic): Wedderburn blocks `M_d(R)` are
    Baer-* rings at generic q.** -/
-- Ref: [kassel1995] https://doi.org/10.1007/978-1-4612-0783-2 §V.5
axiom hecke_baer_star_generic_sketch_axiom :
    ∀ {R : Type*} [Field R] [StarRing R] (n : ℕ) (q : R) (d : ℕ),
      Nonempty (BaerStarRing (Matrix (Fin d) (Fin d) R))

/-- **Theorem (`prop:hecke-baer-star-generic`).** At generic `q`
    (outside the failure locus), each Wedderburn block `M_d(R)` of
    `H_n(q)` is a Baer-*-ring. -/
theorem hecke_baer_star_generic_sketch
    {R : Type*} [Field R] [StarRing R]
    (n : ℕ) (q : R) (_h_gen : q ∉ failure_locus n R)
    (d : ℕ) :
    Nonempty (BaerStarRing (Matrix (Fin d) (Fin d) R)) :=
  hecke_baer_star_generic_sketch_axiom n q d

end QOU.BraidKnot.HeckeBaerStarGeneric
