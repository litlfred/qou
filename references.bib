@article{bokut2001,
  author  = {Bokut, L. A. and Shiao, L.-S.},
  title   = {{Gr{\"o}bner-Shirshov bases for Coxeter groups}},
  journal = {Communications in Algebra},
  year    = {2001},
  volume  = {29},
  pages   = {4305--4319},
  note    = {NOT READ — metadata only, reconciled from three agreeing bibliographies (see comment above). TWO SCOPE CAVEATS, both established from other documents rather than from this one. (1) COXETER GROUPS, NOT H_n(q): every document that cites it describes it as constructing GS bases for Coxeter groups W = sgp⟨Σ | (ss′)^m = 1⟩ at q = 1; none mentions the Iwahori–Hecke deformation. The q-deformed type-A statement appears to be Kang–Lee–Lee–Oh, J. Algebra 252 (2002) 258-292 §6 (not yet held; bean qou-qspu). (2) NOT GENERAL COXETER: [chenliu2009] Example 3.2 refutes the Bokut–Shiao conjecture that a GS basis of an arbitrary Coxeter group follows from S = {(1),(2),(3′)} with commuting relations; the positive results are for finite Coxeter groups, which does cover type A_{n-1}. It is cited in this folio for the COMPLETION family $\sigma_i\sigma_{i-1}\cdots\sigma_j\sigma_i \to \sigma_{i-1}\sigma_i\sigma_{i-1}\cdots\sigma_j$ that HeckeGS.lean §4e names as missing from `heckeRewritingSystem`; the axiom `hecke_is_gs_basis` that formerly cited 'Bokut \& Shiao 2001, Thm 3.5' was deleted as FALSE for the uncompleted system (NotAGSBasis.hecke_not_gs_basis_four).},
}

@article{chenliu2009,
  author     = {Chen, Yuqun and Liu, Cihua},
  title      = {{Gr{\"o}bner-Shirshov bases for Coxeter groups I}},
  journal    = {arXiv preprint},
  year       = {2009},
  url        = {https://arxiv.org/abs/0910.0096},
  note       = {arXiv:0910.0096v1 [math.GR], 21 pp. No journal venue or DOI is printed on the preprint and none was sought; the title's 'I' promises a sequel that was not located. Read 2026-08-09. Example 3.2 (pp. 4-5) refutes by explicit counterexample — Σ = {s₁<s₂<s₃<s₄}, m₁₂ = m₂₃ = m₂₄ = ∞, m₁₃ = 3, m₁₄ = 2, m₃₄ = 5 — the Bokut–Shiao conjecture that a GS basis of an ARBITRARY Coxeter group is obtainable from S = {(1),(2),(3′)} using only the commuting relations, and exhibits the corrected basis. Its introduction restricts the known positive results to FINITE Coxeter groups, which is why the folio's type A_{n-1} case is unaffected. Thm 3.19 with Example 3.20 give three sufficient families, of which (i) all m_ij ≥ 3 covers the rank-2 case m₁₂ = 3 (W = S₃) but not n ≥ 4. Like [bokut2001] it works with the Coxeter GROUP and never mentions H_n(q).},
  annotation = {[unreviewed]},
}

@article{bokutchen2015pbw,
  author     = {Bokut, L. A. and Chen, Yuqun},
  title      = {{Gr{\"o}bner-Shirshov bases and PBW theorems}},
  journal    = {arXiv preprint},
  year       = {2015},
  url        = {https://arxiv.org/abs/1502.06472},
  note       = {arXiv:1502.06472v1 [math.RA], 13 pp., survey. YEAR CAVEAT: the arXiv banner rendered on p. 1 reads '8 Nov 2014' but the 1502.* identifier is a February 2015 posting; recorded as 2015 with the printed banner date noted here. No DOI or journal line on the preprint; no published version sought. Read 2026-08-09 for §3.7 (p. 6), verified in the PDF: Shirshov 1953 and Cartier 1958 give counterexamples to PBW for Lie algebras over a commutative algebra, and Cohn's 1963 family L_p = Lie_K(x₁,x₂,x₃ | y₃x₃ = y₂x₂ + y₁x₁) over K = k[y₁,y₂,y₃ | yᵢᵖ = 0] is proved not to embed in its universal enveloping algebra for p = 2, 3, 5 (Bokut–Chen–Chen, J. Algebra 337 (2011) 82-102). That paragraph is why cor:pbw / cor:ugb-pbw cannot drop the 'free as an R-module' hypothesis their proofs use (bean qou-pwd4). §3.7 REPORTS those counterexamples and proves none of them — the primaries have not been read and are not in this file, so cite this entry as the collecting source, not as the proof.},
  annotation = {[unreviewed]},
}

@article{kimlee2018,
  author     = {Kim, Sungsoon and Lee, Dong-il},
  title      = {{Gr{\"o}bner-Shirshov bases for Temperley-Lieb algebras}},
  journal    = {Palestine Journal of Mathematics},
  year       = {2018},
  volume     = {7},
  number     = {Special Issue: I},
  pages      = {11--17},
  publisher  = {Palestine Polytechnic University-PPU},
  note       = {No DOI, ISSN or URL is printed on the article; venue read off the title page and running head, no lookup performed. Read in full 2026-08-09. The folio-relevant part is §3, the type A_{n-1} review: T(A_{n-1}) generated by E₁,…,E_{n-1} with E_i² = δE_i, E_iE_j = E_jE_i for i > j+1, E_iE_jE_i = E_i for j = i±1 (δ ∈ ℂ a free parameter, the E_iE_jE_i relation UN-rescaled — the convention this folio adopted, e_i := q − σ_i with e_i² = [2]_q e_i and δ = [2]_q). Prop. 3.1 gives a Gr{\"o}bner–Shirshov basis whose standard monomials number C_n, i.e. dim TL_n = Catalan(n), and note that the basis needs two families BEYOND the defining relations (E_{i,j}E_i − E_{i−2,j}E_i and E_jE_{i,j} − E_jE_{i,j+2}) — the same completion phenomenon that makes def:hecke-normal-form's confluence claim false (bean qou-43co). Prop. 3.1 is QUOTED from Kang–Lee–Lee–Oh, J. Algebra 252 (2002) 258-292, Prop. 6.2, the primary, which is not yet in this file (bean qou-qspu). The paper's own theorem (dim T(B_n) = (n+2)C_n − 1) has no consumer here. A close sibling exists — the same authors' arXiv:1808.05026, 'GS bases for Temperley-Lieb algebras of types B and D', whose §3 is verbatim this same review — deliberately NOT registered separately; see the ledger row for library/arxiv-1808.05026v1/1808.05026v1.pdf.},
  annotation = {[unreviewed]},
}

