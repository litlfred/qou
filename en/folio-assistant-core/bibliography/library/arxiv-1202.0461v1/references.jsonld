      "dcterms:title": "Draft version October 11, 2018 DOUBLE DEGENERATE MERGERS AS PROGENITORS OF HIGH-FIELD MAGNETIC WHITE DWARFS",
      "dcterms:creator": [
        "Garc´ıa–Berro1, Enrique",
        "2",
        "Lorén–Aguilar1, Pablo",
        "2",
        "Aznar–Siguán1, Gabriela",
