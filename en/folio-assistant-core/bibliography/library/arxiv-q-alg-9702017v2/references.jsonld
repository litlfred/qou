      "dcterms:title": "Idempotents of Hecke algebras of type A",
      "dcterms:creator": [
        "Aiston, A.K.",
        "∗, H.R. Morton"
      ],
      "dcterms:issued": "D:20190207",
      "dcterms:identifier": "https://arxiv.org/abs/q-alg/9702017",
      "dcterms:abstract": "We use a skein-theoretic version of the Hecke algebras of type A to present three-dimensional diagrammatic views of Gyoja’s idempotent el- ements, based closely on the corresponding Young diagram λ. In this context we give straightforward calculations for the eigenvalues fλ and mλ of two natural central elements in the Hecke algebras, namely the full curl and the sum of the Murphy operators. We discuss their calculation also in terms of the framing factor associated to the appropriate irreducible representation of the quantum group, SU(N)q.",
      "dcterms:source": "library/arxiv-q-alg-9702017v2/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-q-alg-9702017v2"
    }
  ]
