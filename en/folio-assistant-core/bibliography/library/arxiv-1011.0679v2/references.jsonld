      "dcterms:title": "A FORMULA OF ARTHUR AND AFFINE HECKE ALGEBRAS",
      "dcterms:creator": [
        "OPDAM, ERIC",
        "SOLLEVELD, MAARTEN"
      ],
      "dcterms:issued": "D:20210531",
      "dcterms:identifier": "https://arxiv.org/abs/1011.0679",
      "dcterms:abstract": "Let π, π′ be tempered representations of an aﬃne Hecke algebra with positive parameters. We study their Euler–Poincar´e pairing EP(π, π′), the alter- nating sum of the dimensions of the Ext-groups. We show that EP(π, π′) can be expressed in a simple formula involving an analytic R-group, analogous to a for- mula of Arthur in the setting of reductive p-adic groups. Our proof applies equally well to aﬃne Hecke algebras and to reductive groups over nonarchimedean local ﬁelds of arbitrary characteristic.",
      "dcterms:source": "library/arxiv-1011.0679v2/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-1011.0679v2"
    }
  ]
