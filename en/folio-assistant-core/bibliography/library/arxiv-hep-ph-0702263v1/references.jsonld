      "dcterms:title": "Chiral Low-Energy Constants ∗",
      "dcterms:creator": [
        "Ecker, Gerhard"
      ],
      "dcterms:issued": "D:20211106",
      "dcterms:identifier": "https://arxiv.org/abs/hep-ph/0702263",
      "dcterms:abstract": "The progress in determining the coupling constants of mesonic chi- ral Lagrangians is reviewed, with emphasis on the work performed in three successive European Networks (Eurodaphne I and II, Euridice). Reliable estimates of those constants are essential for making full use of next-to-next-to-leading-order calculations in chiral perturbation the- ory. The precision in the values of the strong coupling constants of O(p4) has been increasing steadily over the years. The situation is less satisfactory in the nonleptonic weak sector where further phe- nomenological input and more theoretical work are needed. A lot of progress has recently been achieved for electromagnetic coupling con- stants occurring in radiative corrections for mesonic processes at low energies. ∗Presented at The Final Euridice Meeting, Kazimierz, Poland, Aug. 2006 Supported in part by EU contract No. MRTN-CT-2006-035482 (FLAVIAnet)",
      "dcterms:source": "library/arxiv-hep-ph-0702263v1/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-hep-ph-0702263v1"
    }
  ]
