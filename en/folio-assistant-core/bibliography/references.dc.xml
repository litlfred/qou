    <dcterms:title>MOD-GAUSSIAN CONVERGENCE AND ITS APPLICATIONS FOR MODELS OF STATISTICAL MECHANICS</dcterms:title>
    <dcterms:creator>MÉLIOT, PIERRE-LOÏC</dcterms:creator>
    <dcterms:creator>NIKEGHBALI, ASHKAN</dcterms:creator>
