    <dcterms:title>Bring's Curve: its Period Matrix and the Vector of Riemann Constants</dcterms:title>
    <dcterms:creator>(2012), SIGMA 8</dcterms:creator>
    <dcterms:creator>065</dcterms:creator>
    <dcterms:creator>pages, 20</dcterms:creator>
