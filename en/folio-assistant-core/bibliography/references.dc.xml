    <dcterms:title>TRACE AS AN ALTERNATIVE DECATEGORIFICATION FUNCTOR</dcterms:title>
    <dcterms:creator>ANNA BELIAKOVA, ZAUR GULIYEV, KAZUO HABIRO</dcterms:creator>
