    <dcterms:title>Pontryagin invariants and integral formulas for Milnor's triple linking number</dcterms:title>
    <dcterms:creator>DETURCK, DENNIS</dcterms:creator>
    <dcterms:creator>GLUCK, HERMAN</dcterms:creator>
