    <dcterms:title>Higher Dimensional Algebra VII: Groupoidiﬁcation</dcterms:title>
    <dcterms:creator>Baez, John C.</dcterms:creator>
    <dcterms:creator>Hoffnung, Alexander E.</dcterms:creator>
    <dcterms:creator>Walker, Christopher D.</dcterms:creator>
