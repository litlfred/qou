      ],
      "dcterms:title": "Angle-dependent pair production in the polarized two-photon Breit-Wheeler process",
      "dcterms:creator": [
        "Qian Zhao, 1 Yan-Xi Wu,1, 2 Mamutjan Ababekri,1 Zhong-Peng Li,1 Liang Tang,3, ∗and Jian-Xing Li1, †"
      ],
      "dcterms:issued": "D:20230411",
