      "bibo:pages": "6073-6105",
      "bibo:doi": "10.1063/1.531236"
    },
    {
      "@id": "references/baez-dolan2001-finite-sets-feynman",
      "@type": [
        "fabio:Work",
        "bibo:Chapter"
      ],
      "dcterms:title": "From Finite Sets to Feynman Diagrams",
      "dcterms:creator": [
        "Baez, John C.",
        "Dolan, James"
      ],
      "dcterms:issued": "2001",
      "dcterms:isPartOf": "Mathematics Unlimited — 2001 and Beyond",
      "dcterms:identifier": "https://arxiv.org/abs/math/0004133"
