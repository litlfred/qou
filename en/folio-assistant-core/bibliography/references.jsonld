    {
      "@id": "references/arxiv-1011.0679v2",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "A FORMULA OF ARTHUR AND AFFINE HECKE ALGEBRAS",
      "dcterms:creator": [
        "OPDAM, ERIC",
        "SOLLEVELD, MAARTEN"
      ],
      "dcterms:issued": "D:20210531",
      "dcterms:identifier": "https://arxiv.org/abs/1011.0679",
      "dcterms:abstract": "Let π, π′ be tempered representations of an aﬃne Hecke algebra with positive parameters. We study their Euler–Poincar´e pairing EP(π, π′), the alter- nating sum of the dimensions of the Ext-groups. We show that EP(π, π′) can be expressed in a simple formula involving an analytic R-group, analogous to a for- mula of Arthur in the setting of reductive p-adic groups. Our proof applies equally well to aﬃne Hecke algebras and to reductive groups over nonarchimedean local ﬁelds of arbitrary characteristic.",
      "dcterms:source": "library/arxiv-1011.0679v2/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-1011.0679v2"
    },
    {
      "@id": "references/1172-5",
      "@type": [
        "fabio:Work",
        "bibo:Document"
      ],
      "dcterms:title": "Optimistic calculations about the Witten-Reshetikhin-Turaev invariants of closed three-manifolds obtained from the figure-eight knot by integral Dehn surgeries",
      "dcterms:issued": "D:20080313",
      "dcterms:abstract": "I calculate optimistically asymptotic behaviors of the WRT $SU(2)$ invariants for the three-manifolds obtained from the ﬁgure-eight knot by p- surgeries with $p=0,1,2,$ $\\ldots,$ $10$ , from which one can extract volumes and the Chern-Simons invariants of these closed manifolds. I conjecture that this also holds for general closed three-manifolds.",
      "dcterms:source": "library/1172-5/manifest.jsonld",
      "dcterms:hasVersion": "library/1172-5"
    },
    {
      "@id": "references/arxiv-math-9806163v1",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "Weights of Markov traces on Hecke algebras",
      "dcterms:creator": [
        "Orellana, R.C."
      ],
      "dcterms:issued": "D:20220305",
      "dcterms:identifier": "https://arxiv.org/abs/math/9806163",
      "dcterms:abstract": "We compute the weights, i.e. the values at the minimal idempotents, for the Markov trace on the Hecke algebra of type Bn and type Dn. In order to prove the weight formula, we deﬁne representations of the Hecke algebra of type B onto a reduced Hecke Algebra of type A. To compute the weights for type D we use the inclusion of the Hecke algebra of type D into the Hecke algebra of type B.",
      "dcterms:source": "library/arxiv-math-9806163v1/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-math-9806163v1"
    },
