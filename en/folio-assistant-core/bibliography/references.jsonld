    {
      "@id": "references/s00209-021-02825-4",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "A representation theoretic explanation of the Borcea–Brändén characterization",
      "dcterms:creator": [
        "Zeitschrift, Mathematische"
      ],
      "dcterms:issued": "D:20210808",
      "bibo:doi": "10.1007/s00209-021-02825-4",
      "dcterms:identifier": "https://doi.org/10.1007/s00209-021-02825-4",
      "dcterms:abstract": "In 2009, Borcea and Brändén characterized all linear operators on multivariate polynomials which preserve the property of being non-vanishing (stable) on products of prescribed open circular regions. We give a representation theoretic interpretation of their ﬁndings, which generalizes and simpliﬁes their result and leads to a conceptual uniﬁcation of many related results in polynomial stability theory. At the heart of this uniﬁcation is a generalized Grace’s theorem which addresses polynomials whose roots are all contained in some real interval or ray. This generalization allows us to extend the Borcea–Brändén result to characterize a certain subclass of the linear operators which preserve such polynomials.",
      "dcterms:source": "library/s00209-021-02825-4/manifest.jsonld",
      "dcterms:hasVersion": "library/s00209-021-02825-4"
    },
    {
      "@id": "references/arxiv-math-ph-0010012v1",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "arXiv:math-ph/0010012v1 10 Oct 2000",
      "dcterms:creator": [
        "Zelditch, Steve"
      ],
      "dcterms:issued": "D:20210619",
      "dcterms:identifier": "https://arxiv.org/abs/math-ph/0010012",
      "dcterms:abstract": "We review some recent results on random polynomials and their generalizations in complex and symplectic geometry. The main theme is the universality of statistics of zeros and critical points of (generalized) polynomials of degree N on length scales of order D √ N (complex case), resp. D N (real case).",
      "dcterms:source": "library/arxiv-math-ph-0010012v1/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-math-ph-0010012v1"
    },
    {
      "@id": "references/zhang1999",
