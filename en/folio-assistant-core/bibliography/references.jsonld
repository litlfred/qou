      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "Ribbon graphs and their invariants derived from quantum groups",
      "dcterms:creator": [
        "Reshetikhin, N. Yu.",
        "Turaev, V. G."
      ],
