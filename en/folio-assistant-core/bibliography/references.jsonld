      "@id": "references/chattopadhyay-dutta-mukherjee-neetu2019",
      "@type": [
        "fabio:Work",
        "bibo:Article"
      ],
      "dcterms:title": "Quantum Mechanics of Plancherel Growth",
      "dcterms:creator": [
        "Chattopadhyay, Arghya",
        "Dutta, Suvankar",
        "Mukherjee, Debangshu",
        "Neetu"
      ],
      "dcterms:issued": "2019",
