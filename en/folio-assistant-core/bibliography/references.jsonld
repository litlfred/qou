        "fabio:Work",
        "bibo:Article"
      ],
      "dcterms:title": "The Character Theory of a Complex Group",
      "dcterms:creator": [
        "Ben-Zvi, David",
        "Nadler, David"
      ],
      "dcterms:issued": "2009",
      "dcterms:identifier": "https://arxiv.org/abs/0904.1247"
    },
    {
      "@id": "references/ben-zvi-nadler2013-nonlinear-traces",
