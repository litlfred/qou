    {
      "@id": "references/arxiv-q-alg-9707006v1",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "Drinfeld twist for quantum su(2) in the adjoint representation",
      "dcterms:creator": [
        "Chryssomalakos∗, Chryssomalis"
      ],
      "dcterms:issued": "D:20210521",
      "dcterms:identifier": "https://arxiv.org/abs/q-alg/9707006",
      "dcterms:abstract": "We give a detailed description of the adjoint representation of Drinfeld’s twist element, as well as of its coproduct, for suq(2). We also discuss, as applications, the computation of the universal R-matrix in this representation and the problem of symmetrization of identical-particle states with quantum su(2) symmetry. ∗e-mail address: chryss@stp.dias.ie",
      "dcterms:source": "library/arxiv-q-alg-9707006v1/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-q-alg-9707006v1"
    },
    {
      "@id": "references/arxiv-1912.13486v2",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "Index for a Model of 3d-3d Correspondence for Plumbed 3-Manifolds",
      "dcterms:creator": [
        "Chung, Hee-Joong"
      ],
      "dcterms:issued": "D:20210323",
      "dcterms:identifier": "https://arxiv.org/abs/1912.13486",
      "dcterms:abstract": "We consider the S2 ×q S1 supersymmetric index of a 3d N = 2 theory T[M3] when M3 is a plumbed 3-manifold. We engineer an eﬀective description of T[M3] from the expression of the homological block for plumbed 3-manifolds as a D2 ×q S1 partition function of a 3d N = 2 theory T[M3] with a boundary condition. We check that the supersymmetric index for such a T[M3] is invariant under the 3d Kirby moves. arXiv:1912.13486v2 [hep-th] 22 Mar 2021",
      "dcterms:source": "library/arxiv-1912.13486v2/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-1912.13486v2"
    },
    {
      "@id": "references/chung2019",
      "@type": [
