      "@id": "references/domagala-lewandowski-2004",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "Black hole entropy from quantum geometry",
      "dcterms:creator": [
        "Domagała, Marcin",
        "Lewandowski, Jerzy"
      ],
      "dcterms:issued": "2004",
      "dcterms:isPartOf": "Classical and Quantum Gravity",
      "bibo:volume": "21",
      "bibo:issue": "22",
      "bibo:pages": "5233-5243",
