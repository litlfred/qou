    {
      "@id": "references/horsley-et-al-2016-qcd-qed",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "Isospin splittings of meson and baryon masses from three-flavor lattice QCD + QED",
      "dcterms:creator": [
        "Horsley, R.",
        "Nakamura, Y.",
        "Perlt, H.",
        "Pleiter, D.",
