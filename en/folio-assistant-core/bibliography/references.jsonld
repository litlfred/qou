    {
      "@id": "references/sagan2001",
      "@type": [
        "fabio:Work",
        "bibo:Book"
      ],
      "dcterms:title": "The Symmetric Group: Representations, Combinatorial Algorithms, and Symmetric Functions",
      "dcterms:creator": [
        "Sagan, Bruce E."
