      ],
      "dcterms:title": "On the geometry of two state models for the colored Jones polynomial",
      "dcterms:creator": [
        "Kaiser, Uwe",
        "Mishra, Rama"
      ],
      "dcterms:issued": "2024",
      "dcterms:isPartOf": "Journal of Knot Theory and Its Ramifications",
      "bibo:doi": "10.1142/S0218216524500020",
