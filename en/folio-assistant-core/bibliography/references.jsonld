      "@id": "references/arxiv-1002.4860v2",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "A STATE-SUM FORMULA FOR THE ALEXANDER POLYNOMIAL",
      "dcterms:creator": [
        "BLACK, SAMSON"
