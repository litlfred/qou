      "@id": "references/arxiv-1104.0755v2",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "A connection formula between the Ramanujan function and the q -Airy function",
      "dcterms:creator": [
