    {
      "@id": "references/arxiv-2512.18642v1",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "A Hidden Quantum Markov model framework for Entanglement and Topological Order in the AKLT Chain",
      "dcterms:creator": [
        "Souissi, Abdessatar"
      ],
      "dcterms:identifier": "https://arxiv.org/abs/2512.18642",
      "dcterms:abstract": "This paper introduces a hidden quantum Markov models (HQMMs) framework to the Af- fleck–Kennedy–Lieb–Tasaki (AKLT) state—a cornerstone example of a symmetry-protected topological (SPT) phase. The model’s observation system is the physical spin-1 chain, which emerges from a hidden spin-½ layer through well-defined quantum emission operation. We show that the underlying Markov dynamics caputure maximal entanglement through the use of significant channels relevant to the AKLT state. We also show that SPT order induces a covariance on the observation decoding channels. This establishes an additional bridge between the quantum Machine learning and many-body physics, with promising implication in topological order and quantum information.",
      "dcterms:source": "library/arxiv-2512.18642v1/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-2512.18642v1"
    },
    {
      "@id": "references/arxiv-2605.09605v2",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "Cocycle Actions on Hidden Quantum Markov Models: Symmetry Protection and Topological Order",
      "dcterms:creator": [
        "Souissi, Abdessatar"
      ],
      "dcterms:identifier": "https://arxiv.org/abs/2605.09605",
      "dcterms:abstract": "We develop a symmetry action framework for hidden quantum Markov models (HQMMs) tailored to one-dimensional quantum spin systems and symmetry-protected topological (SPT) phases. In our setting, a symmetry group G acts projectively on the hidden (virtual) degrees of freedom and linearly on the physical observation space, yielding a global HQMM state that is invariant under the combined action of G for both conventional and causal (input– output) structures. We show that such symmetry actions are naturally classified by a group- cohomology 2-cocycle [ω] ∈H2(G, U(1)), in direct analogy with the standard cohomological classification of one-dimensional bosonic SPT phases via projective edge representations. As an explicit example, we apply this construction to the Affleck–Kennedy–Lieb–Tasaki (AKLT) chain, where the hidden layer carries a nontrivial class [ω] ∈H2(SO(3), U(1)) encoding its SPT order. In this case the HQMM formalism reproduces the known SPT properties of the AKLT state while providing a stochastic, Markovian description of the underlying virtual dynamics. Our results establish HQMMs as a natural bridge between quantum stochas- tic processes, tensor-network descriptions of many-body systems, and symmetry-protected topological order.",
      "dcterms:source": "library/arxiv-2605.09605v2/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-2605.09605v2"
    },
    {
      "@id": "references/arxiv-1811.05376v4",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "Resurgence Analysis of Quantum Invariants of Seifert Fibered Homology Spheres",
      "dcterms:creator": [
        "Spheres, Fibered Homology"
      ],
      "dcterms:issued": "D:20201026",
      "dcterms:identifier": "https://arxiv.org/abs/1811.05376",
      "dcterms:abstract": "For a Seifert ﬁbered homology sphere X we show that the q-series invariant ˆZ0(X; q) introduced by Gukov-Pei-Putrov-Vafa, is a resummation of the Ohtsuki series Z0(X). We show that for every even k ∈N there exists a full asymptotic expansion of ˆZ0(X; q) for q tending to e2πi/k, and in particular that the limit ˆZ0(X; e2πi/k) exists and is equal to the WRT quantum invariant τk(X). We show that the poles of the Borel transform of Z0(X) coincide with the classical complex Chern-Simons values, which we further show classiﬁes the corresponding components of the moduli space of ﬂat SL(2, C)-connections.",
      "dcterms:source": "library/arxiv-1811.05376v4/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-1811.05376v4"
    },
