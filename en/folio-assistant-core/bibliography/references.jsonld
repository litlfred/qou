    {
      "@id": "references/arxiv-2306.13098v2",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "Three generations of colored fermions with S 3 family symmetry from Cayley-Dickson sedenions",
      "dcterms:creator": [
        "Gresnigt1⋆, Niels G.",
        "Gourlay1, Liam",
        "Varma1, Abhinav"
      ],
      "dcterms:issued": "D:20240216",
      "dcterms:identifier": "https://arxiv.org/abs/2306.13098",
      "dcterms:abstract": "An algebraic representation of three generations of fermions with SU(3)C color symmetry based on the Cayley-Dickson algebra of sedenions S is constructed. Recent constructions based on division algebras convincingly describe a single generation of leptons and quarks with Standard Model gauge symmetries. Nonetheless, an algebraic origin for the existence of exactly three generations has proven difficult to sub- stantiate. We motivate S as a natural algebraic candidate to describe three generations with SU(3)C gauge symmetry. We initially represent one generation of leptons and quarks in terms of two minimal left ideals of Cℓ(6), generated from a subset of all left actions of the complex sedenions on themselves. Subsequently we employ the finite group S3, which are automorphisms of S but not of O to generate two additional generations. Given the relative obscurity of sedenions, efforts have been made to present the material in a self-contained manner.",
      "dcterms:source": "library/arxiv-2306.13098v2/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-2306.13098v2"
    },
    {
      "@id": "references/s10052-023-11923-y-a",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "Three generations of colored fermions with S3 family symmetry from Cayley-Dickson sedenions",
      "dcterms:creator": [
        "Gresnigta, Niels"
      ],
      "dcterms:issued": "D:20230823",
      "bibo:doi": "10.1140/epjc/s10052-023-11923-y",
      "dcterms:identifier": "https://doi.org/10.1140/epjc/s10052-023-11923-y",
      "dcterms:abstract": "An algebraic representation of three genera- tions of fermions with SU(3)C color symmetry based on the Cayley–Dickson algebra of sedenions S is constructed. Recent constructions based on division algebras convinc- ingly describe a single generation of leptons and quarks with Standard Model gauge symmetries. Nonetheless, an alge- braic origin for the existence of exactly three generations has proven difﬁcult to substantiate. We motivate S as a nat- ural algebraic candidate to describe three generations with SU(3)C gauge symmetry. We initially represent one genera- tion of leptons and quarks in terms of two minimal left ideals of Cℓ(6), generated from a subset of all left actions of the complex sedenions on themselves. Subsequently we employ the S3 automorphism of order three, which is an automor- phism of S but not of O, to generate two additional genera- tions. Given the relative obscurity of sedenions, efforts have been made to present the material in a self-contained manner.",
      "dcterms:source": "library/s10052-023-11923-y-a/manifest.jsonld",
      "dcterms:hasVersion": "library/s10052-023-11923-y-a"
    },
    {
      "@id": "references/arxiv-2601.15862v1",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "Synthetic Differential Jet Bundles are Reduced",
      "dcterms:creator": [
        "GRIGORIOS GIOTOPOULOS, IGOR KHAVKINE, HISHAM SATI",
        "SCHREIBER, URS"
      ],
      "dcterms:identifier": "https://arxiv.org/abs/2601.15862",
      "dcterms:abstract": "We have previously observed that the theory of solutions of par- tial differential equations, regarded as diffieties inside jet bundles, acquires a powerful comonadic formulation after passage from the category of Fr´echet smooth manifolds to the Cahiers topos of formal smooth sets (a well-adapted model for Synthetic Differential Geometry). However, the tacit assumption that this passage preserves the projective limits that define infinite jet bundles had remained unproven. Here we provide a detailed proof.",
      "dcterms:source": "library/arxiv-2601.15862v1/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-2601.15862v1"
    },
