      ],
      "dcterms:title": "Quasi-conformal mappings in n-space and the rigidity of hyperbolic space forms",
      "dcterms:creator": [
        "Mostow, George D."
      ],
      "dcterms:issued": "1968",
      "dcterms:isPartOf": "Publications mathématiques de l'IHÉS",
      "bibo:volume": "34",
