    {
      "@id": "references/arxiv-2210.09583v1",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "A NEW PRESENTATION OF THE osp(1|2)-POLYNOMIAL LINK INVARIANT",
      "dcterms:creator": [
        "CATEGORIFICATION, AND"
      ],
      "dcterms:issued": "D:20221018",
      "dcterms:identifier": "https://arxiv.org/abs/2210.09583",
      "dcterms:abstract": "There is a known connection between the osp(1|2n) polynomial knot invariant Jn K and the so(2n + 1) knot invariant soJn K studied by Clark [10] and Blumen [4]. In the rank one case, the uncolored Uq(osp(1|2)) link invariant is equal to the Ut−1q(sl2) link invariant where t2 = −1. We deﬁne a skein relation similar to the Kauﬀman bracket, and use that to recover an oriented link invariant which coincides with Clark’s uncolored osp(1|2)-link invariant. This deﬁnition also comes from the representation theory of Uq,π(sl2), but using diﬀerent methods from Clark. We show that our invariant is easily categoriﬁed by a slightly modiﬁed version of Khovanov homology equipped with an extra Z4-grading. We also construct a similarly modiﬁed version of Putyra’s covering Khovanov homology [28]. This suggests that the similarity between the two invariants holds at the categoriﬁed level as well.",
      "dcterms:source": "library/arxiv-2210.09583v1/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-2210.09583v1"
    },
