    },
    {
      "@id": "references/arxiv-0707.2052v1",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "The Mukai pairing, I: a categorical approach",
      "dcterms:creator": [
        "Willerton†, Andrei C˘ald˘araru∗and Simon"
      ],
      "dcterms:issued": "D:20130215",
      "dcterms:identifier": "https://arxiv.org/abs/0707.2052",
      "dcterms:abstract": "We study the Hochschild homology of smooth spaces, emphasizing the importance of a pairing which generalizes Mukai’s pairing on the cohomology of K3 surfaces. We show that integral transforms between derived categories of spaces induce, functorially, linear maps on homol- ogy. Adjoint functors induce adjoint linear maps with respect to the Mukai pairing. We deﬁne a Chern character with values in Hochschild homology, and we discuss analogues of the Hirzebruch-Riemann-Roch theorem and the Cardy Condition from physics. This is done in the context of a 2-category which has spaces as its objects and integral kernels as its 1-morphisms.",
      "dcterms:source": "library/arxiv-0707.2052v1/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-0707.2052v1"
    },
    {
      "@id": "references/arxiv-1808.02836v2",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "On minimal ideal triangulations of cusped hyperbolic 3–manifolds Introduction",
      "dcterms:creator": [
        "William Jaco, Hyam Rubinstein, Jonathan Spreer",
        "Tillmann, Stephan"
      ],
      "dcterms:issued": "D:20190909",
      "dcterms:identifier": "https://arxiv.org/abs/1808.02836",
      "dcterms:abstract": "Previous work of the authors studies minimal triangulations of closed 3–manifolds using a characterisation of low degree edges, embedded layered solid torus subcomplexes and 1–dimensional Z2–cohomology. The underlying blueprint is now used in the study of minimal ideal triangulations. As an application, it is shown that the monodromy ideal triangulations of the hyperbolic once-punctured torus bundles are minimal.",
      "dcterms:source": "library/arxiv-1808.02836v2/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-1808.02836v2"
    },
