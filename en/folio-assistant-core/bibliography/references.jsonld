    {
      "@id": "references/arxiv-1409.4073v1",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "SHEAFIFICATION FUNCTORS AND TANNAKA’S RECONSTRUCTION",
      "dcterms:creator": [
        "TONINI, FABIO"
      ],
      "dcterms:issued": "D:20220531",
      "dcterms:identifier": "https://arxiv.org/abs/1409.4073",
      "dcterms:abstract": "We introduce “sheaﬁﬁcation” functors from categories of (lax monoidal) linear functors to categories of quasi-coherent sheaves (of algebras) of stacks. They generalize the homogeneous sheaﬁﬁcation of graded modules for projective schemes and have applications in the theory of non-abelian Galois covers and of Cox rings and homogeneous sheaﬁﬁcation functors. Moreover, using this theory, we prove a non-neutral form of Tannaka’s reconstruction, extending the classical correspondence between torsors and strong monoidal functors.",
      "dcterms:source": "library/arxiv-1409.4073v1/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-1409.4073v1"
    },
    {
      "@id": "references/arxiv-2010.12445v1",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "STACKS OF FIBER FUNCTORS AND TANNAKA’S RECONSTRUCTION",
      "dcterms:creator": [
        "TONINI, FABIO"
      ],
      "dcterms:issued": "D:20201025",
      "dcterms:identifier": "https://arxiv.org/abs/2010.12445",
      "dcterms:abstract": "Given a quasi-compact category ﬁbered in groupoids X and a monoidal subcat- egory C of its category of locally free sheaves Vect(X), we are going to introduce the stack of ﬁber functors FibX,C with source C, which comes equipped with a map PC : X →FibX,C and a functor G : C →Vect(FibX,C). If C generates QCoh(X) and X is an fpqc stack with quasi-aﬃne diagonal, we show that PC : X →FibX,C is an equivalence, as it happens by Tannaka’s reconstruction when X is an aﬃne gerbe over a ﬁeld. In general, under mild assumption on C, e.g. C = Vect(X), we show that FibX,C is a quasi-compact fpqc stack with aﬃne diagonal and that the image G(C) generates QCoh(FibX,C).",
      "dcterms:source": "library/arxiv-2010.12445v1/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-2010.12445v1"
    },
