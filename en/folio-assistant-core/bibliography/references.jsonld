    },
    {
      "@id": "references/arxiv-physics-0203048v1",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "Towards a third-order topological invariant for magnetic fields",
      "dcterms:creator": [
        "Hornig, Gunnar",
        "Mayer, Christoph"
      ],
      "dcterms:issued": "D:20181106",
      "dcterms:identifier": "https://arxiv.org/abs/physics/0203048",
      "dcterms:abstract": "An expression for a third-order link integral of three magnetic ﬁelds is presented. It is a topological invariant and therefore an invariant of ideal magnetohydrodynamics. The integral generalizes existing expressions for third- order invariants which are obtained from the Massey triple product, where the three ﬁelds are restricted to isolated ﬂux tubes. The derivation and interpretation of the invariant shows a close relationship with the well-known magnetic helicity, which is a second-order topological invariant. Using gauge ﬁelds with an SU(2) symmetry, helicity and the new third-order invariant originate from the same identity, an identity which relates the second Chern class and the Chern-Simons three-form. We present an explicit example of three magnetic ﬁelds with non- disjunct support. These ﬁelds, derived from a vacuum Yang-Mills ﬁeld with a non-vanishing winding number, possess a third-order linkage detected by our invariant.",
      "dcterms:source": "library/arxiv-physics-0203048v1/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-physics-0203048v1"
    },
