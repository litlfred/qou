    {
      "@id": "references/arxiv-1007.2335v1",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "Hopf solitons in the Nicole model",
      "dcterms:creator": [
        "Gillard, Mike",
        "Sutcliffe, Paul"
      ],
      "dcterms:issued": "Tue Apr 21",
      "dcterms:identifier": "https://arxiv.org/abs/1007.2335",
      "dcterms:abstract": "The Nicole model is a conformal ﬁeld theory in three-dimensional space. It has topo- logical soliton solutions classiﬁed by the integer-valued Hopf charge, and all currently known solitons are axially symmetric. A volume-preserving ﬂow is used to numerically construct soliton solutions for all Hopf charges from one to eight. It is found that the known axially symmetric solutions are unstable for Hopf charges greater than two and new lower energy solutions are obtained that include knots and links. A comparison with the Skyrme-Faddeev model suggests many universal features, though there are some diﬀerences in the link types obtained in the two theories. 1",
      "dcterms:source": "library/arxiv-1007.2335v1/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-1007.2335v1"
    },
    {
      "@id": "references/arxiv-2104.04941v2",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "Fock–Goncharov Coordinates for Semisimple Lie Groups",
      "dcterms:creator": [
        "GILLES, S."
      ],
      "dcterms:issued": "D:20220124",
      "dcterms:identifier": "https://arxiv.org/abs/2104.04941",
      "dcterms:abstract": "Fock and Goncharov [FG06b] introduced cluster ensembles, providing a framework for coordi- nates on varieties of surface representations into Lie groups, as well as a complete construction for groups of type An. Later, Zickert [Zic19], Le [Le16b], [Le16a], and Ip [Ip18] described, using diﬀering methods, how to apply this framework for other Lie group types. Zickert also showed that this framework applies to triangulated 3-manifolds. We present a complete, general construction, based on work of Fomin and Zelevinsky. In particular, we complete the picture for the remaining cases: Lie groups of types F4, E6, E7, and E8.",
      "dcterms:source": "library/arxiv-2104.04941v2/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-2104.04941v2"
    },
    {
      "@id": "references/arxiv-1609.08719v1",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "AN EXPERIMENTAL INVESTIGATION OF NEUMANN’S CONJECTURE",
      "dcterms:creator": [
        "GILLES, STEPHEN",
        "HUSTON, PETER"
      ],
      "dcterms:issued": "D:20210712",
      "dcterms:identifier": "https://arxiv.org/abs/1609.08719",
      "dcterms:abstract": "We use a large census of hyperbolic 3-manifolds to experimentally investigate a conjecture of Neumann regarding the Bloch Group. We present an augmented census including, for feasible invariant trace ﬁelds, explicit man- ifolds (associated to that ﬁeld) that appear to generate the Bloch group of that ﬁeld. We also make use of Ptolemy coordinates to compute “exotic volumes” of representations, and attempt to realize these volumes as linear combinations of generator volumes. We thus present a large body of empirical support for Neumann’s conjecture.",
      "dcterms:source": "library/arxiv-1609.08719v1/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-1609.08719v1"
    },
