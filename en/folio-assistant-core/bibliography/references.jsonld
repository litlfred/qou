    {
      "@id": "references/arxiv-0705.1468v1",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "Knots in the Skyrme-Faddeev model",
      "dcterms:creator": [
        "Sutcliffe, Paul"
      ],
      "dcterms:issued": "D:20130215",
      "dcterms:identifier": "https://arxiv.org/abs/0705.1468",
      "dcterms:abstract": "The Skyrme-Faddeev model is a modiﬁed sigma model in three-dimensional space, which has string-like topological solitons classiﬁed by the integer-valued Hopf charge. Numerical simulations are performed to compute soliton solutions for Hopf charges up to sixteen, with initial conditions provided by families of rational maps from the three- sphere into the complex projective line. A large number of new solutions are presented, including a variety of torus knots for a range of Hopf charges. Often these knots are only local energy minima, with the global minimum being a linked solution, but for some values of the Hopf charge they are good candidates for the global minimum energy solution. The computed energies are in agreement with Ward’s conjectured energy bound. 1",
      "dcterms:source": "library/arxiv-0705.1468v1/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-0705.1468v1"
    },
