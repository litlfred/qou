    {
      "@id": "references/arxiv-1301.4504v4",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "Quantum Computation vs. Firewalls",
      "dcterms:creator": [
        "Haydenb, Daniel Harlowa Patrick"
      ],
      "dcterms:issued": "D:20241127",
      "dcterms:identifier": "https://arxiv.org/abs/1301.4504",
      "dcterms:abstract": "In this paper we discuss quantum computational restrictions on the types of thought experiments recently used by Almheiri, Marolf, Polchinski, and Sully to argue against the smoothness of black hole horizons. We argue that the quantum computations required to do these experiments would take a time which is exponential in the entropy of the black hole under study, and we show that for a wide variety of black holes this prevents the experiments from being done. We interpret our results as motivating a broader type of nonlocality than is usually considered in the context of black hole thought experiments, and claim that once this type of nonlocality is allowed there may be no need for ﬁrewalls. Our results do not threaten the unitarity of of black hole evaporation or the ability of advanced civilizations to test it. arXiv:1301.4504v4 [hep-th] 6 Apr 2013",
      "dcterms:source": "library/arxiv-1301.4504v4/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-1301.4504v4"
    },
