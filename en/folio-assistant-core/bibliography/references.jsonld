    {
      "@id": "references/s40879-023-00706-0",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "Bring’s curve: old and new",
      "dcterms:creator": [
        "ARTICLE, RESEARCH"
      ],
      "dcterms:issued": "D:20231216",
      "bibo:doi": "10.1007/s40879-023-00706-0",
      "dcterms:identifier": "https://doi.org/10.1007/s40879-023-00706-0",
      "dcterms:abstract": "Bring’s curve, the unique Riemann surface of genus 4 with automorphism group S5, has many exceptional properties. We review, give new proofs of, and extend a number of these including giving the complete realisation of the automorphism group for a plane curve model, identifying a new elliptic quotient of the curve and the modular curve X0(50), providing a complete description of the orbit decomposition of the theta characteristics, and identifying the unique invariant characteristic with the divisor of the Szeg˝o kernel. In achieving this we have used modern computational tools in Sagemath, Macaulay2, and Maple, for which notebooks demonstrating calculations are provided.",
      "dcterms:source": "library/s40879-023-00706-0/manifest.jsonld",
      "dcterms:hasVersion": "library/s40879-023-00706-0"
    },
    {
      "@id": "references/generalised-markov-traces-and-jucys-murphy-element",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "Glasgow Mathematical Journal (2026), 1–10",
      "dcterms:creator": [
        "ARTICLE, RESEARCH"
      ],
      "dcterms:issued": "D:20260725",
      "bibo:doi": "10.1017/S0017089526101050",
      "dcterms:identifier": "https://doi.org/10.1017/S0017089526101050",
      "dcterms:abstract": "We give a simple construction of Markov traces for Iwahori–Hecke algebras associated with the crystallographic Coxeter groups of types An, Bn and Dn. In types B and D, it is new and generalises a known construction in type A employing symmetric polynomials in multiplicative Jucys–Murphy elements.",
      "dcterms:source": "library/generalised-markov-traces-and-jucys-murphy-element/manifest.jsonld",
      "dcterms:hasVersion": "library/generalised-markov-traces-and-jucys-murphy-element"
    },
    {
      "@id": "references/arxiv-hep-th-9303139v2",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "arXiv:hep-th/9303139v2 5 Apr 1993",
      "dcterms:issued": "D:20241126",
      "dcterms:identifier": "https://arxiv.org/abs/hep-th/9303139",
      "dcterms:abstract": "The theory of matrix models is reviewed from the point of view of its relation to integrable hierarchies. Discrete 1-matrix, 2-matrix, ”conformal” (multicomponent) and Kontsevich models are considered in some detail, to- gether with the Ward identites (”W-constraints”), determinantal formulas and continuum limits, taking one kind of models into another. Subtle points and directions of the future research are also discussed. Lectures presented at the University of Amsterdam and the Dutch Institute for High Energy Physics(NIKHEF) in February-March 1993 1ITEP 117259 Moscow; morozov@vxdesy.desy.de 1",
      "dcterms:source": "library/arxiv-hep-th-9303139v2/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-hep-th-9303139v2"
    },
