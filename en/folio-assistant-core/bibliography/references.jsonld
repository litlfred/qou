    {
      "@id": "references/arxiv-1504.07260v3",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "Fricke S-duality in CHL models",
      "dcterms:issued": "D:20161122",
      "dcterms:identifier": "https://arxiv.org/abs/1504.07260",
      "dcterms:abstract": "We consider four dimensional CHL models with sixteen spacetime supersym- metries obtained from orbifolds of type IIA superstring on K3×T 2 by a ZN symmetry acting (possibly) non-geometrically on K3. We show that most of these models (in particular, for geometric symmetries) are self-dual under a weak-strong duality acting on the heterotic axio-dilaton modulus S by a “Fricke involution” S →−1/NS. This is a novel symmetry of CHL models that lies outside of the standard SL(2, Z)-symmetry of the parent theory, heterotic strings on T 6. For self-dual models this implies that the lattice of purely electric charges is N-modular, i.e. isometric to its dual up to a rescaling of its quadratic form by N. We verify this prediction by determining the lattices of electric and magnetic charges in all relevant examples. We also calculate certain BPS-saturated couplings and verify that they are invariant under the Fricke S-duality. For CHL models that are not self-dual, the strong coupling limit is dual to type IIA compactiﬁed on T 6/ZN, for some ZN-symmetry preserving half of the spacetime supersymmetries. arXiv:1504.07260v3 [hep-th] 21 Nov 2016",
      "dcterms:source": "library/arxiv-1504.07260v3/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-1504.07260v3"
    },
    {
      "@id": "references/arxiv-0905.0591v3",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "A SURVEY OF TWISTED ALEXANDER POLYNOMIALS",
      "dcterms:creator": [
        "FRIEDL, STEFAN",
        "VIDUSSI, STEFANO"
      ],
      "dcterms:issued": "D:20100208",
      "dcterms:identifier": "https://arxiv.org/abs/0905.0591",
      "dcterms:abstract": "We give a short introduction to the theory of twisted Alexander polynomials of a 3–manifold associated to a representation of its fundamental group. We summarize their formal properties and we explain their relationship to twisted Reidemeister torsion. We then give a survey of the many applications of twisted invariants to the study of topological problems. We conclude with a short summary of the theory of higher order Alexander polynomials.",
      "dcterms:source": "library/arxiv-0905.0591v3/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-0905.0591v3"
    },
