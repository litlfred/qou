      "@id": "references/platter2005tjon",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "On the correlation between the binding energies of the triton and the alpha-particle",
      "dcterms:creator": [
        "Platter, L.",
        "Hammer, H.-W.",
        "Meißner, Ulf-G."
      ],
      "dcterms:issued": "2005",
      "dcterms:isPartOf": "Physics Letters B",
      "bibo:volume": "607",
      "bibo:issue": "3-4",
      "bibo:pages": "254-258",
