    {
      "@id": "references/arxiv-nucl-th-0610105v2",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "Universal Properties of the Four-Body System with Large Scattering Length",
      "dcterms:creator": [
        "Hammer∗, H.-W."
      ],
      "dcterms:issued": "D:20190508",
      "dcterms:identifier": "https://arxiv.org/abs/nucl-th/0610105",
      "dcterms:abstract": "Few-body systems with large scattering length have universal properties that do not depend on the details of their interactions at short distances. We study the universal bound state properties of the four-boson system with large scattering length in an eﬀective quantum mechanics approach. We compute the four-body binding energies using the Yakubovsky equations for positive and negative scattering length. Moreover, we study the correlation between three- and four-body energies and present a generalized Eﬁmov plot for the four-body system. These results are useful for understanding the cluster structure of nuclei and for the creation of weakly-bound tetramers with cold atoms close to a Feshbach resonance. PACS numbers: 03.65.Ge, 36.40.-c, 21.45.+v ∗Electronic address: hammer@itkp.uni-bonn.de †Electronic address: lplatter@phy.ohiou.edu",
      "dcterms:source": "library/arxiv-nucl-th-0610105v2/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-nucl-th-0610105v2"
    },
