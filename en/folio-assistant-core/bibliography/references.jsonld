    {
      "@id": "references/qt2pf5d0mn",
      "@type": [
        "fabio:Work",
        "bibo:Document"
      ],
      "dcterms:title": "UC Santa Barbara",
      "dcterms:creator": [
        "Theses, UC Santa Barbara Electronic",
