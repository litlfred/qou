    {
      "@id": "references/arxiv-cond-mat-9811142v1",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "arXiv:cond-mat/9811142v1 [cond-mat.mes-hall] 10 Nov 1998",
      "dcterms:creator": [
        "Forrester†, P.J.",
        "Honner†, T. Nagao∗and G."
      ],
      "dcterms:issued": "D:20220326",
      "dcterms:identifier": "https://arxiv.org/abs/cond-mat/9811142",
      "dcterms:abstract": "For the orthogonal-unitary and symplectic-unitary transitions in random matrix the- ory, the general parameter dependent distribution between two sets of eigenvalues with two diﬀerent parameter values can be expressed as a quaternion determinant. For the parameter dependent Gaussian and Laguerre ensembles the matrix elements of the deter- minant are expressed in terms of corresponding skew-orthogonal polynomials, and their limiting value for inﬁnite matrix dimension are computed in the vicinity of the soft and hard edges respectively. A connection formula relating the distributions at the hard and soft edge is obtained, and a universal asymptotic behaviour of the two point correlation is identiﬁed.",
      "dcterms:source": "library/arxiv-cond-mat-9811142v1/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-cond-mat-9811142v1"
    },
