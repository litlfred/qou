    {
      "@id": "references/arxiv-math-0108215v1",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "arXiv:math/0108215v1 [math.GT] 30 Aug 2001",
      "dcterms:creator": [
        "Department of Mathematics",
        "Science, Computer"
      ],
      "dcterms:issued": "D:20211030",
      "dcterms:identifier": "https://arxiv.org/abs/math/0108215",
      "dcterms:abstract": "The M¨obius energy of a knot is an energy functional for smooth curves based on an idea of self-repelling. If a knot has a thick tubular neighborhood, we would intuitively expect the energy to be low. In this paper, we give explicit bounds for energy in terms of the ropelength of the knot, i.e. the ratio of the length of a thickest tube to its radius.",
      "dcterms:source": "library/arxiv-math-0108215v1/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-math-0108215v1"
    },
    {
      "@id": "references/arxiv-2507.13873v1",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "Probing the singularity at the holographic screen via q-holography",
      "dcterms:creator": [
        "Department of Physics",
        "Astronomy"
      ],
      "dcterms:identifier": "https://arxiv.org/abs/2507.13873",
      "dcterms:abstract": "We study the emergence of q-deformed spacetime in a lower-dimensional gravitational system whose asymptotic region geometrizes the global symmetry of a q-deformed CFT. More precisely, we consider the 2d sinh dilaton gravity model, whose classical metric solutions exhibit a curvature singularity at the holographic boundary. Our aim is to probe this UV near-boundary regime by injecting a small probe into the bulk, and identifying the geometrical features it observes. At the level of the two- point correlator, we see the emergence of q-deformed hyperbolic disk isometries. By formulating DSSYK in terms of the analogous sine dilaton gravity model, we expect this q-deformed holographic duality to persist. July 21, 2025 ∗andreas.belaey@ugent.be †thomas.mertens@ugent.be ‡jacopo.papalini@ugent.be arXiv:2507.13873v1 [hep-th] 18 Jul 2025",
      "dcterms:source": "library/arxiv-2507.13873v1/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-2507.13873v1"
    },
    {
      "@id": "references/arxiv-math-ph-0105039v1",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "Hyperbolic Structure Arising from a Knot Invariant",
      "dcterms:creator": [
        "Department of Physics, Graduate School of Science"
      ],
      "dcterms:issued": "D:20190506",
      "dcterms:identifier": "https://arxiv.org/abs/math-ph/0105039",
      "dcterms:abstract": "We study the knot invariant based on the quantum dilogarithm function. This invariant can be regarded as a non-compact analogue of Kashaev’s invariant, or the colored Jones invariant, and is deﬁned by an integral form. The 3-dimensional picture of our invariant originates from the pentagon identity of the quantum dilogarithm function, and we show that the hyperbolicity consistency conditions in gluing polyhedra arise naturally in the classical limit as the saddle point equation of our invariant.",
      "dcterms:source": "library/arxiv-math-ph-0105039v1/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-math-ph-0105039v1"
    },
