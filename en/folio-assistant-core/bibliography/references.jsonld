    {
      "@id": "references/huang2017",
      "@type": [
        "fabio:Work",
        "bibo:Article"
      ],
      "dcterms:title": "The second largest eigenvalues of some Cayley graphs on alternating groups",
      "dcterms:creator": [
        "Huang, Xueyi",
        "Huang, Qiongxiang"
      ],
      "dcterms:identifier": "https://arxiv.org/abs/1711.08944"
