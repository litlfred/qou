    {
      "@id": "references/arxiv-1202.4698v3",
      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "6j symbols for the modular double, quantum hyperbolic geometry, and supersymmetric gauge theories",
      "dcterms:creator": [
        "Teschner, J.",
        "Vartanov, G. S."
      ],
      "dcterms:issued": "D:20130430",
      "dcterms:identifier": "https://arxiv.org/abs/1202.4698",
      "dcterms:abstract": "We revisit the deﬁnition of the 6j symbols from the modular double of Uq(sl(2, R)), referred to as b-6j symbols. Our new results are (i) the identiﬁcation of particularly natural normal- ization conditions, and (ii) new integral representations for this object. This is used to brieﬂy discuss possible applications to quantum hyperbolic geometry, and to the study of certain supersymmetric gauge theories. We show, in particular, that the b-6j symbol has leading semiclassical asymptotics given by the volume of a non-ideal tetrahedron. We furthermore observe a close relation with the problem to quantize natural Darboux coordinates for moduli spaces of ﬂat connections on Riemann surfaces related to the Fenchel-Nielsen coordinates. Our new integral representations ﬁnally indicate a possible interpretation of the b-6j sym- bols as partition functions of non-abelian three-dimensional N = 2 supersymmetric gauge theories.",
      "dcterms:source": "library/arxiv-1202.4698v3/manifest.jsonld",
      "dcterms:hasVersion": "library/arxiv-1202.4698v3"
    },
