      "@type": [
        "fabio:Work",
        "bibo:AcademicArticle"
      ],
      "dcterms:title": "The Maximum Speed of Dynamical Evolution",
      "dcterms:creator": [
        "Margolus, Norman",
        "Levitin, Lev B."
      ],
      "dcterms:issued": "1998",
      "dcterms:isPartOf": "Physica D: Nonlinear Phenomena",
      "bibo:volume": "120",
