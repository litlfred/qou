{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.MathlibExt.RpowAlgebra","@type":"LeanModule","name":"QOU.MathlibExt.RpowAlgebra","imports":["lean:module:Init","lean:module:Mathlib.Analysis.SpecialFunctions.Pow.Real","lean:module:Mathlib.Analysis.SpecialFunctions.Sqrt"],"declarations":4,"chunks":1},{"@id":"lean:QOU.MathlibExt.RpowAlgebra.rpow_five_half","@type":"LeanDeclaration","name":"QOU.MathlibExt.RpowAlgebra.rpow_five_half","kind":"theorem","line":39,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/RpowAlgebra.lean#L39-L62","doc":"q^{5/2} = (sqrt q)^5 for q ≥ 0.\n\nProof: q^{5/2} = q^{2 + 1/2} = q^2 · q^{1/2} = (sqrt q)^4 · sqrt q\n= (sqrt q)^5.\n","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.RpowAlgebra.sqrt_sq_eq","@type":"LeanDeclaration","name":"QOU.MathlibExt.RpowAlgebra.sqrt_sq_eq","kind":"theorem","line":34,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/RpowAlgebra.lean#L34-L37","doc":"(sqrt q)^2 = q for q ≥ 0. ","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.RpowAlgebra.rpow_neg_half","@type":"LeanDeclaration","name":"QOU.MathlibExt.RpowAlgebra.rpow_neg_half","kind":"theorem","line":28,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/RpowAlgebra.lean#L28-L32","doc":"q^{-1/2} = (sqrt q)⁻¹ for q > 0. ","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.RpowAlgebra.rpow_half","@type":"LeanDeclaration","name":"QOU.MathlibExt.RpowAlgebra.rpow_half","kind":"theorem","line":23,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/RpowAlgebra.lean#L23-L26","doc":"q^{1/2} = sqrt(q) for q ≥ 0. ","signatureChunk":0}]}