edean.RossoJonesGeneral.perExt_periodic","kind":"theorem","line":296,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesTorusLink.lean#L296-L313","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.restr","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.restr","kind":"def","line":292,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesTorusLink.lean#L292-L294","doc":"The first `d` letters. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.perExt","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.perExt","kind":"def","line":288,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesTorusLink.lean#L288-L290","doc":"The periodic extension of a word of length `d`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.rot_fixed_iff_gcd","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.rot_fixed_iff_gcd","kind":"theorem","line":261,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesTorusLink.lean#L261-L286","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.shift_mul","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.shift_mul","kind":"theorem","line":249,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesTorusLink.lean#L249-L259","doc":"`rot^p` fixes `b` iff `rot^s` does, for any `s` with `s ∣ p` and `s ≡ p x (mod n + 1)`;\nfirst the iteration lemma. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.T_wRot_pow","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.T_wRot_pow","kind":"theorem","line":225,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesTorusLink.lean#L225-L245","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.fixSet","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.fixSet","kind":"def","line":221,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesTorusLink.lean#L221-L223","doc":"The weight-`j` states fixed by `rot^p`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.lastOnes_mul","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.lastOnes_mul","kind":"theorem","line":198,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesTorusLink.lean#L198-L217","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.rot_fixed_iff","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.rot_fixed_iff","kind":"theorem","line":194,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesTorusLink.lean#L194-L196","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.nat_nsmul_one_val","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.nat_nsmul_one_val","kind":"theorem","line":191,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesTorusLink.lean#L191-L192","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.nsmul_one_self","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.nsmul_