{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:LiftingAndDescent.VacuumState","@type":"LeanModule","name":"LiftingAndDescent.VacuumState","imports":["lean:module:Init","lean:module:Mathlib.Algebra.Module.LinearMap.Defs","lean:module:Mathlib.Algebra.Module.LinearMap.Basic","lean:module:Mathlib.CategoryTheory.Monoidal.Category"],"declarations":17,"chunks":1},{"@id":"lean:QOU.Torsion.invariant_functional_unique","@type":"LeanDeclaration","name":"QOU.Torsion.invariant_functional_unique","kind":"theorem","line":72,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/vacuum-state.lean#L72-L90","doc":"**Uniqueness**: Any tower-compatible R-linear functional equals the\nFrobenius trace (up to normalisation). ","formalizes":[{"@id":"block:prop:vacuum-state","label":"prop:vacuum-state","md":"quantum-observable-universe/lifting-and-descent/vacuum-state.md"}],"signatureChunk":0},{"@id":"lean:QOU.Torsion.frobenius_trace_invariant","@type":"LeanDeclaration","name":"QOU.Torsion.frobenius_trace_invariant","kind":"theorem","line":62,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/vacuum-state.lean#L62-L70","doc":"**Existence**: The Frobenius trace defines a G_q-invariant functional\non the direct limit algebra. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.VanishingCondition.schur_at_zero","@type":"LeanDeclaration","name":"QOU.Torsion.VanishingCondition.schur_at_zero","kind":"theorem","line":59,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/vacuum-state.lean#L59-L59","doc":"At level 0, any R-linear functional is proportional to the trace. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.VanishingCondition.mk","@type":"LeanDeclaration","name":"QOU.Torsion.VanishingCondition.mk","kind":"ctor","line":56,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/vacuum-state.lean#L56-L56","signatureChunk":0},{"@id":"lean:QOU.Torsion.VanishingCondition","@type":"LeanDeclaration","name":"QOU.Torsion.VanishingCondition","kind":"structure","line":48,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/vacuum-state.lean#L48-L60","doc":"The vanishing condition (Schur form): at level 0, the endomorphism\nalgebra is one-dimensional, so any R-linear functional is proportional\nto the Frobenius trace.\n\nThis follows from the QOU axiom Hom(𝟙, Ad(A)) = 0 together with\nSchur's lemma in the rigid monoidal category 𝒞: the adjoint\nrepresentation has no invariant vectors, forcing End_𝒞(A₀) ≅ R. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.FrobeniusTraceSystem.compatible","@type":"LeanDeclaration","name":"QOU.Torsion.FrobeniusTraceSystem.compatible","kind":"theorem","line":46,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/vacuum-state.lean#L46-L46","doc":"Compatibility: trₙ ∘ 𝔡_{n+1} = tr_{n+1}. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.FrobeniusTraceSystem.trace","@type":"LeanDeclaration","name":"QOU.Torsion.FrobeniusTraceSystem.trace","kind":"def","line":44,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/vacuum-state.lean#L44-L44","doc":"The trace functional at level n: an R-linear map from level n to R. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.FrobeniusTraceSystem.mk","@type":"LeanDeclaration","name":"QOU.Torsion.FrobeniusTraceSystem.mk","kind":"ctor","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/vacuum-state.lean#L42-L42","signatureChunk":0},{"@id":"lean:QOU.Torsion.FrobeniusTraceSystem","@type":"LeanDeclaration","name":"QOU.Torsion.FrobeniusTraceSystem","kind":"structure","line":41,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/vacuum-state.lean#L41-L46","doc":"A Frobenius trace system: compatible traces at each level. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.AlgebraTower.retraction","@type":"LeanDeclaration","name":"QOU.Torsion.AlgebraTower.retraction","kind":"theorem","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/vacuum-state.lean#L36-L36","doc":"Retraction: descent ∘ ascent = id. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.AlgebraTower.descent","@type":"LeanDeclaration","name":"QOU.Torsion.AlgebraTower.descent","kind":"def","line":34,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/vacuum-state.lean#L34-L34","doc":"Descent map 𝔡_{n+1} : level (n+1) → level n. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.AlgebraTower.ascent","@type":"LeanDeclaration","name":"QOU.Torsion.AlgebraTower.ascent","kind":"def","line":32,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/vacuum-state.lean#L32-L32","doc":"Ascent embedding ℓₙ : level n → level (n+1). ","signatureChunk":0},{"@id":"lean:QOU.Torsion.AlgebraTower.module","@type":"LeanDeclaration","name":"QOU.Torsion.AlgebraTower.module","kind":"def","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/vacuum-state.lean#L30-L30","signatureChunk":0},{"@id":"lean:QOU.Torsion.AlgebraTower.addCommGroup","@type":"LeanDeclaration","name":"QOU.Torsion.AlgebraTower.addCommGroup","kind":"def","line":29,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/vacuum-state.lean#L29-L29","doc":"Each level is an R-module. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.AlgebraTower.levelMod","@type":"LeanDeclaration","name":"QOU.Torsion.AlgebraTower.levelMod","kind":"def","line":27,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/vacuum-state.lean#L27-L27","doc":"The R-module at level n. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.AlgebraTower.mk","@type":"LeanDeclaration","name":"QOU.Torsion.AlgebraTower.mk","kind":"ctor","line":25,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/vacuum-state.lean#L25-L25","signatureChunk":0},{"@id":"lean:QOU.Torsion.AlgebraTower","@type":"LeanDeclaration","name":"QOU.Torsion.AlgebraTower","kind":"structure","line":24,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/vacuum-state.lean#L24-L36","doc":"A tower of R-algebras with descent (retraction) maps. ","signatureChunk":0}]}