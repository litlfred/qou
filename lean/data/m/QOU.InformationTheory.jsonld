{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.InformationTheory","@type":"LeanModule","name":"QOU.InformationTheory","imports":["lean:module:Init","lean:module:QOU.Basic","lean:module:QOU.QuantumObservableUniverse","lean:module:Mathlib.Data.Real.Basic"],"declarations":18,"chunks":1},{"@id":"lean:QOU.InformationTheory.classical_regime_no_information","@type":"LeanDeclaration","name":"QOU.InformationTheory.classical_regime_no_information","kind":"theorem","line":105,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/InformationTheory.lean#L105-L108","doc":"At a point in the classical regime, the information rate vanishes. ","signatureChunk":0},{"@id":"lean:QOU.InformationTheory.ClassicalRegime.classical","@type":"LeanDeclaration","name":"QOU.InformationTheory.ClassicalRegime.classical","kind":"theorem","line":103,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/InformationTheory.lean#L103-L103","doc":"`q(p) = 1` at this point (classicality). ","signatureChunk":0},{"@id":"lean:QOU.InformationTheory.ClassicalRegime.point","@type":"LeanDeclaration","name":"QOU.InformationTheory.ClassicalRegime.point","kind":"def","line":101,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/InformationTheory.lean#L101-L101","doc":"The point where the regime holds. ","signatureChunk":0},{"@id":"lean:QOU.InformationTheory.ClassicalRegime.sp","@type":"LeanDeclaration","name":"QOU.InformationTheory.ClassicalRegime.sp","kind":"def","line":99,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/InformationTheory.lean#L99-L99","doc":"The substrate parameter. ","signatureChunk":0},{"@id":"lean:QOU.InformationTheory.ClassicalRegime.mk","@type":"LeanDeclaration","name":"QOU.InformationTheory.ClassicalRegime.mk","kind":"ctor","line":97,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/InformationTheory.lean#L97-L97","signatureChunk":0},{"@id":"lean:QOU.InformationTheory.ClassicalRegime","@type":"LeanDeclaration","name":"QOU.InformationTheory.ClassicalRegime","kind":"structure","line":91,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/InformationTheory.lean#L91-L103","doc":"**Classical regime** at a point: `q(p) = 1`, corresponding to\nvanishing torsion and zero information transfer.  This is the\nregime near a cosmological terminal state (if one exists in the\ngiven affine chart).  Its existence is not assumed globally.\n\nLaTeX: `\\label{sec:big-bang-info}` (contrast) ","signatureChunk":0},{"@id":"lean:QOU.InformationTheory.DeepQuantumRegime.deep_quantum","@type":"LeanDeclaration","name":"QOU.InformationTheory.DeepQuantumRegime.deep_quantum","kind":"theorem","line":89,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/InformationTheory.lean#L89-L89","doc":"`q(p) ≥ Q` at this point: genuinely deep-quantum. ","signatureChunk":0},{"@id":"lean:QOU.InformationTheory.DeepQuantumRegime.threshold_gt_one","@type":"LeanDeclaration","name":"QOU.InformationTheory.DeepQuantumRegime.threshold_gt_one","kind":"theorem","line":87,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/InformationTheory.lean#L87-L87","doc":"The threshold exceeds classicality. ","signatureChunk":0},{"@id":"lean:QOU.InformationTheory.DeepQuantumRegime.threshold","@type":"LeanDeclaration","name":"QOU.InformationTheory.DeepQuantumRegime.threshold","kind":"def","line":85,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/InformationTheory.lean#L85-L85","doc":"The deep-quantum threshold Q > 1 (e.g. Q = φ² ≈ 2.618). ","signatureChunk":0},{"@id":"lean:QOU.InformationTheory.DeepQuantumRegime.point","@type":"LeanDeclaration","name":"QOU.InformationTheory.DeepQuantumRegime.point","kind":"def","line":83,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/InformationTheory.lean#L83-L83","doc":"The point where the regime holds. ","signatureChunk":0},{"@id":"lean:QOU.InformationTheory.DeepQuantumRegime.sp","@type":"LeanDeclaration","name":"QOU.InformationTheory.DeepQuantumRegime.sp","kind":"def","line":81,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/InformationTheory.lean#L81-L81","doc":"The substrate parameter. ","signatureChunk":0},{"@id":"lean:QOU.InformationTheory.DeepQuantumRegime.mk","@type":"LeanDeclaration","name":"QOU.InformationTheory.DeepQuantumRegime.mk","kind":"ctor","line":79,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/InformationTheory.lean#L79-L79","signatureChunk":0},{"@id":"lean:QOU.InformationTheory.DeepQuantumRegime","@type":"LeanDeclaration","name":"QOU.InformationTheory.DeepQuantumRegime","kind":"structure","line":73,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/InformationTheory.lean#L73-L89","doc":"**Deep-quantum regime** at a point: `q(p)` is large, corresponding\nto high torsion pressure and near-maximal information transfer rate\n(`ℏ_q → 1`).  This is the regime near a cosmological initial state\n(if one exists in the given affine chart).\n\nLaTeX: `\\label{sec:big-bang-info}` ","signatureChunk":0},{"@id":"lean:QOU.InformationTheory.informationRate_bounded","@type":"LeanDeclaration","name":"QOU.InformationTheory.informationRate_bounded","kind":"theorem","line":59,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/InformationTheory.lean#L59-L62","doc":"The information rate is bounded in `[0, 1)`. ","signatureChunk":0},{"@id":"lean:QOU.InformationTheory.informationRate","@type":"LeanDeclaration","name":"QOU.InformationTheory.informationRate","kind":"def","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/InformationTheory.lean#L49-L57","doc":"**Information transfer rate**: quantifies the rate of information\npropagation at a point, proportional to `ℏ_q`.  Time slows at\nthe classical regime (`q → 1`, rate → 0) and runs fast in the\ndeep-quantum regime (`q → ∞`, rate → 1).\n\nLaTeX: `\\label{sec:time-info}` ","signatureChunk":0},{"@id":"lean:QOU.InformationTheory.localPlanckLength_classical","@type":"LeanDeclaration","name":"QOU.InformationTheory.localPlanckLength_classical","kind":"theorem","line":41,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/InformationTheory.lean#L41-L45","doc":"The local Planck length vanishes at classicality (`q = 1`). ","signatureChunk":0},{"@id":"lean:QOU.InformationTheory.localPlanckLength_nonneg","@type":"LeanDeclaration","name":"QOU.InformationTheory.localPlanckLength_nonneg","kind":"theorem","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/InformationTheory.lean#L36-L39","doc":"The local Planck length is non-negative. ","signatureChunk":0},{"@id":"lean:QOU.InformationTheory.localPlanckLength","@type":"LeanDeclaration","name":"QOU.InformationTheory.localPlanckLength","kind":"def","line":27,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/InformationTheory.lean#L27-L34","doc":"**Local Planck length**: the minimal quantisable size of an\ninformation unit at a point `p ∈ M`, proportional to the quantum\nPlanck constant `ℏ_q(p)`.\n\nLaTeX: `\\label{sec:planck-info-unit}` ","signatureChunk":0}]}