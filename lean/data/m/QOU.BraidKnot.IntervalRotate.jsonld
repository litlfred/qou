{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.BraidKnot.IntervalRotate","@type":"LeanModule","name":"QOU.BraidKnot.IntervalRotate","imports":["lean:module:Init","lean:module:Mathlib.Logic.Equiv.Defs","lean:module:Mathlib.Tactic"],"declarations":12,"chunks":1},{"@id":"lean:QOU.BraidKnot.IntervalRotate.intervalRotate_zero","@type":"LeanDeclaration","name":"QOU.BraidKnot.IntervalRotate.intervalRotate_zero","kind":"theorem","line":119,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/IntervalRotate.lean#L119-L124","doc":"A zero-width block gives the identity permutation. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.IntervalRotate.intervalRotate_eq_self","@type":"LeanDeclaration","name":"QOU.BraidKnot.IntervalRotate.intervalRotate_eq_self","kind":"theorem","line":114,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/IntervalRotate.lean#L114-L117","doc":"Outside the block, the rotation is the identity. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.IntervalRotate.intervalRotate_apply","@type":"LeanDeclaration","name":"QOU.BraidKnot.IntervalRotate.intervalRotate_apply","kind":"theorem","line":111,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/IntervalRotate.lean#L111-L112","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.IntervalRotate.intervalRotate","@type":"LeanDeclaration","name":"QOU.BraidKnot.IntervalRotate.intervalRotate","kind":"def","line":90,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/IntervalRotate.lean#L90-L109","doc":"**Rotation of the block `[a, a+m)` as a permutation of `Fin n`.** ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.IntervalRotate.add_compl_mod_eq_zero","@type":"LeanDeclaration","name":"QOU.BraidKnot.IntervalRotate.add_compl_mod_eq_zero","kind":"theorem","line":80,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/IntervalRotate.lean#L80-L88","doc":"The complementary shift: `k + (m - k % m)` is a multiple of `m`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.IntervalRotate.rotNat_of_mod_eq_zero","@type":"LeanDeclaration","name":"QOU.BraidKnot.IntervalRotate.rotNat_of_mod_eq_zero","kind":"theorem","line":68,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/IntervalRotate.lean#L68-L78","doc":"A shift that is a multiple of the width does nothing. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.IntervalRotate.rotNat_add","@type":"LeanDeclaration","name":"QOU.BraidKnot.IntervalRotate.rotNat_add","kind":"theorem","line":53,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/IntervalRotate.lean#L53-L66","doc":"**Rotations compose by adding their shifts.**  This is the whole content of\nthe file: both inverse directions fall out of it. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.IntervalRotate.rotNat_zero_width","@type":"LeanDeclaration","name":"QOU.BraidKnot.IntervalRotate.rotNat_zero_width","kind":"theorem","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/IntervalRotate.lean#L49-L51","doc":"A zero-width block rotates to nothing. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.IntervalRotate.rotNat_lt","@type":"LeanDeclaration","name":"QOU.BraidKnot.IntervalRotate.rotNat_lt","kind":"theorem","line":39,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/IntervalRotate.lean#L39-L47","doc":"A rotation maps the block into itself, so it never leaves `[0, n)`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.IntervalRotate.rotNat_of_mem","@type":"LeanDeclaration","name":"QOU.BraidKnot.IntervalRotate.rotNat_of_mem","kind":"theorem","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/IntervalRotate.lean#L36-L37","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.IntervalRotate.rotNat_of_not_mem","@type":"LeanDeclaration","name":"QOU.BraidKnot.IntervalRotate.rotNat_of_not_mem","kind":"theorem","line":33,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/IntervalRotate.lean#L33-L34","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.IntervalRotate.rotNat","@type":"LeanDeclaration","name":"QOU.BraidKnot.IntervalRotate.rotNat","kind":"def","line":29,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/IntervalRotate.lean#L29-L31","doc":"Rotate `[a, a+m)` by `k`, as a map on `ℕ`; the identity off that block. ","signatureChunk":0}]}