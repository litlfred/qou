{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Interactions.NuclearOperatorRegimes","@type":"LeanModule","name":"QOU.Interactions.NuclearOperatorRegimes","imports":["lean:module:Init","lean:module:QOU.Archimedean.HeckeRep","lean:module:QOU.Archimedean.HeckeH3","lean:module:QOU.Interactions.BorromeanUnique"],"declarations":22,"chunks":1},{"@id":"lean:QOU.Interactions.he4DemandClosure_singleton","@type":"LeanDeclaration","name":"QOU.Interactions.he4DemandClosure_singleton","kind":"instance","line":146,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Interactions/NuclearOperatorRegimes.lean#L146-L152","doc":"**Default instance for a singleton non-negative list**.\n`He4DemandClosure [c]` follows from `0 ≤ c` directly. ","signatureChunk":0},{"@id":"lean:QOU.Interactions.instHe4DemandClosureNilReal","@type":"LeanDeclaration","name":"QOU.Interactions.instHe4DemandClosureNilReal","kind":"instance","line":143,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Interactions/NuclearOperatorRegimes.lean#L143-L144","doc":"**Default instance for the empty list** — vacuously true. ","signatureChunk":0},{"@id":"lean:QOU.Interactions.He4DemandClosure.all_nonneg","@type":"LeanDeclaration","name":"QOU.Interactions.He4DemandClosure.all_nonneg","kind":"theorem","line":141,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Interactions/NuclearOperatorRegimes.lean#L141-L141","doc":"All NF coefficients are nonneg. ","signatureChunk":0},{"@id":"lean:QOU.Interactions.He4DemandClosure.mk","@type":"LeanDeclaration","name":"QOU.Interactions.He4DemandClosure.mk","kind":"ctor","line":139,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Interactions/NuclearOperatorRegimes.lean#L139-L139","signatureChunk":0},{"@id":"lean:QOU.Interactions.He4DemandClosure","@type":"LeanDeclaration","name":"QOU.Interactions.He4DemandClosure","kind":"class","line":132,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Interactions/NuclearOperatorRegimes.lean#L132-L141","doc":"**He-4 demand closure — typeclass.**\nPer-`(coeffs)` witness that at doubly magic `(Z = 2, N = 2)`\nthe `L₊`-derived NF has every coefficient nonneg. ","signatureChunk":0},{"@id":"lean:QOU.Interactions.regimeTransitionZ2_of_positive_gap","@type":"LeanDeclaration","name":"QOU.Interactions.regimeTransitionZ2_of_positive_gap","kind":"instance","line":122,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Interactions/NuclearOperatorRegimes.lean#L122-L130","doc":"**Default instance from a strict-positivity hypothesis on the\ndifference**. When `demandLplus + ε ≤ demandT25` for some\n`ε > 0` (witnessed by `Fact (0 < demandT25 - demandLplus)`),\nthe strict inequality holds. ","signatureChunk":0},{"@id":"lean:QOU.Interactions.RegimeTransitionZ2.Lplus_dominates","@type":"LeanDeclaration","name":"QOU.Interactions.RegimeTransitionZ2.Lplus_dominates","kind":"theorem","line":120,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Interactions/NuclearOperatorRegimes.lean#L120-L120","doc":"`L₊` strictly dominates `T_{2,5}` at `Z = 2`. ","signatureChunk":0},{"@id":"lean:QOU.Interactions.RegimeTransitionZ2.mk","@type":"LeanDeclaration","name":"QOU.Interactions.RegimeTransitionZ2.mk","kind":"ctor","line":118,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Interactions/NuclearOperatorRegimes.lean#L118-L118","signatureChunk":0},{"@id":"lean:QOU.Interactions.RegimeTransitionZ2","@type":"LeanDeclaration","name":"QOU.Interactions.RegimeTransitionZ2","kind":"class","line":109,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Interactions/NuclearOperatorRegimes.lean#L109-L120","doc":"**Regime transition at Z = 2 — typeclass.**\nPer-`(demandT25, demandLplus)` witness that the\ndemand-minimizing operator transitions from `T_{2,5}` to `L₊`\nat the first proton magic number. Pending q₀-numeric demand\nevaluation. ","signatureChunk":0},{"@id":"lean:QOU.Interactions.borromean3_not_nuclear_level","@type":"LeanDeclaration","name":"QOU.Interactions.borromean3_not_nuclear_level","kind":"theorem","line":90,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Interactions/NuclearOperatorRegimes.lean#L90-L105","doc":"The Borromean braid B₃ is NOT selected by demand-minimization\nat the nuclear level. For A ≤ 8, there always exists a\nnon-Borromean operator with lower or equal demand magnitude.\n\nVerified computationally in nuclear-binding-lp.witness.json. ","signatureChunk":0},{"@id":"lean:QOU.Interactions.yang_baxter_hopf","@type":"LeanDeclaration","name":"QOU.Interactions.yang_baxter_hopf","kind":"theorem","line":76,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Interactions/NuclearOperatorRegimes.lean#L76-L86","doc":"L₊ · σ₀ = L₋ · σ₁  (the Yang-Baxter relation).\n\nσ₀σ₁ · σ₀ = σ₁σ₀ · σ₁  ←→  σ₀σ₁σ₀ = σ₁σ₀σ₁ (braid relation) ","signatureChunk":0},{"@id":"lean:QOU.Interactions.hopf_links_distinct","@type":"LeanDeclaration","name":"QOU.Interactions.hopf_links_distinct","kind":"theorem","line":62,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Interactions/NuclearOperatorRegimes.lean#L62-L72","doc":"L₊ and L₋ are distinct operators in H₃(q).\n(Re-exported from BorromeanUnique for convenience.)\n\nL₊ = σ₀σ₁ and L₋ = σ₁σ₀ differ at entry (0,0):\nL₊(0,0) = 0, L₋(0,0) = -1. ","signatureChunk":0},{"@id":"lean:QOU.Interactions.trefoil_eq_gen0_hopfMinus","@type":"LeanDeclaration","name":"QOU.Interactions.trefoil_eq_gen0_hopfMinus","kind":"theorem","line":50,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Interactions/NuclearOperatorRegimes.lean#L50-L58","doc":"The trefoil also equals σ₀ · L₋ = σ₀ · σ₁σ₀ (by braid relation). ","signatureChunk":0},{"@id":"lean:QOU.Interactions.trefoil_eq_hopfPlus_gen0","@type":"LeanDeclaration","name":"QOU.Interactions.trefoil_eq_hopfPlus_gen0","kind":"theorem","line":40,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Interactions/NuclearOperatorRegimes.lean#L40-L48","doc":"The trefoil equals L₊ · σ₀ = σ₀σ₁ · σ₀. ","signatureChunk":0},{"@id":"lean:QOU.Interactions.trefoilMatrix","@type":"LeanDeclaration","name":"QOU.Interactions.trefoilMatrix","kind":"def","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Interactions/NuclearOperatorRegimes.lean#L36-L38","doc":"The trefoil (electron) e⁻ = σ₀σ₁σ₀ in the standard representation. ","signatureChunk":0},{"@id":"lean:QOU.Interactions.instReprBindingRegime","@type":"LeanDeclaration","name":"QOU.Interactions.instReprBindingRegime","kind":"instance","line":32,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Interactions/NuclearOperatorRegimes.lean#L32-L32","signatureChunk":0},{"@id":"lean:QOU.Interactions.instReprBindingRegime.repr","@type":"LeanDeclaration","name":"QOU.Interactions.instReprBindingRegime.repr","kind":"def","line":32,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Interactions/NuclearOperatorRegimes.lean#L32-L32","signatureChunk":0},{"@id":"lean:QOU.Interactions.instDecidableEqBindingRegime","@type":"LeanDeclaration","name":"QOU.Interactions.instDecidableEqBindingRegime","kind":"instance","line":32,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Interactions/NuclearOperatorRegimes.lean#L32-L32","signatureChunk":0},{"@id":"lean:QOU.Interactions.BindingRegime.openShell","@type":"LeanDeclaration","name":"QOU.Interactions.BindingRegime.openShell","kind":"ctor","line":31,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Interactions/NuclearOperatorRegimes.lean#L31-L31","signatureChunk":0},{"@id":"lean:QOU.Interactions.BindingRegime.magicClosure","@type":"LeanDeclaration","name":"QOU.Interactions.BindingRegime.magicClosure","kind":"ctor","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Interactions/NuclearOperatorRegimes.lean#L30-L30","signatureChunk":0},{"@id":"lean:QOU.Interactions.BindingRegime.shellFilling","@type":"LeanDeclaration","name":"QOU.Interactions.BindingRegime.shellFilling","kind":"ctor","line":29,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Interactions/NuclearOperatorRegimes.lean#L29-L29","signatureChunk":0},{"@id":"lean:QOU.Interactions.BindingRegime","@type":"LeanDeclaration","name":"QOU.Interactions.BindingRegime","kind":"inductive","line":27,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Interactions/NuclearOperatorRegimes.lean#L27-L32","doc":"The three nuclear binding regimes. ","signatureChunk":0}]}