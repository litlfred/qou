onomy.genImage","@type":"LeanDeclaration","name":"QOU.Mass.KZHolonomy.genImage","kind":"def","line":82,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/KZHolonomy/BraidRep.lean#L82-L83","doc":"The image `g_j = ρ(s_j) T_j` of the `j`-th Artin generator. ","signatureChunk":0},{"@id":"lean:QOU.Mass.KZHolonomy.genFund_spec","@type":"LeanDeclaration","name":"QOU.Mass.KZHolonomy.genFund_spec","kind":"theorem","line":78,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/KZHolonomy/BraidRep.lean#L78-L80","signatureChunk":0},{"@id":"lean:QOU.Mass.KZHolonomy.genFund","@type":"LeanDeclaration","name":"QOU.Mass.KZHolonomy.genFund","kind":"def","line":74,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/KZHolonomy/BraidRep.lean#L74-L76","doc":"The transport of the KZ connection along the half-turn `γ_j`, as a function of time. ","signatureChunk":0},{"@id":"lean:QOU.Mass.KZHolonomy.continuousOn_genCoeff","@type":"LeanDeclaration","name":"QOU.Mass.KZHolonomy.continuousOn_genCoeff","kind":"theorem","line":67,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/KZHolonomy/BraidRep.lean#L67-L72","signatureChunk":0},{"@id":"lean:QOU.Mass.KZHolonomy.genPath_mem","@type":"LeanDeclaration","name":"QOU.Mass.KZHolonomy.genPath_mem","kind":"theorem","line":62,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/KZHolonomy/BraidRep.lean#L62-L64","signatureChunk":0},{"@id":"lean:QOU.Mass.KZHolonomy.kz_isFlatOn_region","@type":"LeanDeclaration","name":"QOU.Mass.KZHolonomy.kz_isFlatOn_region","kind":"theorem","line":58,"sourceLink":"https://github.com/litlfre