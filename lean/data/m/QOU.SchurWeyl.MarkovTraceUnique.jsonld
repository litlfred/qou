{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.SchurWeyl.MarkovTraceUnique","@type":"LeanModule","name":"QOU.SchurWeyl.MarkovTraceUnique","imports":["lean:module:Init","lean:module:QOU.SchurWeyl.HeckeCoset"],"declarations":11,"chunks":1},{"@id":"lean:QOU.SchurWeyl.HeckeCoset.markovTrace_unique","@type":"LeanDeclaration","name":"QOU.SchurWeyl.HeckeCoset.markovTrace_unique","kind":"theorem","line":102,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/MarkovTraceUnique.lean#L102-L136","doc":"**Uniqueness of the Markov trace.** ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.HeckeCoset.MarkovTraceFamily.param_eq","@type":"LeanDeclaration","name":"QOU.SchurWeyl.HeckeCoset.MarkovTraceFamily.param_eq","kind":"theorem","line":91,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/MarkovTraceUnique.lean#L91-L100","doc":"**The Markov parameter is a value of the trace**, namely `z = tr₁(σ₀)`.\n\nTake `x = 1` in the Markov axiom: `tr₁(ι(1)·σ₀) = z · tr₀(1) = z`.  Two Markov trace families whose\nunderlying `tr` agree therefore carry the *same* parameter — which is what lets `markovTrace_unique`\n(one `z`, one trace) be used in the other direction, to read a parameter off a trace. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.HeckeCoset.MarkovTraceFamily.tr_coset","@type":"LeanDeclaration","name":"QOU.SchurWeyl.HeckeCoset.MarkovTraceFamily.tr_coset","kind":"theorem","line":83,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/MarkovTraceUnique.lean#L83-L89","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.HeckeCoset.MarkovTraceFamily.tr_markov","@type":"LeanDeclaration","name":"QOU.SchurWeyl.HeckeCoset.MarkovTraceFamily.tr_markov","kind":"theorem","line":80,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/MarkovTraceUnique.lean#L80-L80","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.HeckeCoset.MarkovTraceFamily.tr_incl","@type":"LeanDeclaration","name":"QOU.SchurWeyl.HeckeCoset.MarkovTraceFamily.tr_incl","kind":"theorem","line":79,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/MarkovTraceUnique.lean#L79-L79","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.HeckeCoset.MarkovTraceFamily.tr_cyclic","@type":"LeanDeclaration","name":"QOU.SchurWeyl.HeckeCoset.MarkovTraceFamily.tr_cyclic","kind":"theorem","line":78,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/MarkovTraceUnique.lean#L78-L78","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.HeckeCoset.MarkovTraceFamily.tr_one","@type":"LeanDeclaration","name":"QOU.SchurWeyl.HeckeCoset.MarkovTraceFamily.tr_one","kind":"theorem","line":77,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/MarkovTraceUnique.lean#L77-L77","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.HeckeCoset.MarkovTraceFamily.tr","@type":"LeanDeclaration","name":"QOU.SchurWeyl.HeckeCoset.MarkovTraceFamily.tr","kind":"def","line":76,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/MarkovTraceUnique.lean#L76-L76","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.HeckeCoset.MarkovTraceFamily.mk","@type":"LeanDeclaration","name":"QOU.SchurWeyl.HeckeCoset.MarkovTraceFamily.mk","kind":"ctor","line":75,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/MarkovTraceUnique.lean#L75-L75","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.HeckeCoset.MarkovTraceFamily","@type":"LeanDeclaration","name":"QOU.SchurWeyl.HeckeCoset.MarkovTraceFamily","kind":"structure","line":74,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/MarkovTraceUnique.lean#L74-L81","doc":"**A Markov trace on the Hecke tower**, with parameter `z`. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.HeckeCoset.descProd_eq_last_mul_incl","@type":"LeanDeclaration","name":"QOU.SchurWeyl.HeckeCoset.descProd_eq_last_mul_incl","kind":"theorem","line":56,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/MarkovTraceUnique.lean#L56-L71","doc":"For `1 ≤ j ≤ m+1`, the coset representative `r_j` factors as the top generator times\nsomething from the subalgebra. ","signatureChunk":0}]}