ter.lean#L544-L545","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.card_An_le","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.card_An_le","kind":"theorem","line":528,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L528-L542","doc":"**The order bound: `|W(Aₙ n)| ≤ (n+1)!`.** ","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.finiteAn","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.finiteAn","kind":"instance","line":520,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L520-L524","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.instSubsingletonGroupFinOfNatNatAₙ_folio","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.instSubsingletonGroupFinOfNatNatAₙ_folio","kind":"instance","line":517,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L517-L518","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.eq_one_of_A0","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.eq_one_of_A0","kind":"theorem","line":510,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L510-L515","doc":"`W(A₀)` is trivial: there are no generators. ","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.cover_surjective","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.cover_surjective","kind":"theorem","line":502,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L502-L508","doc":"The coset cover, as a surjection from `W(Aₙ n) × Fin (n+2)`. ","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.inCosets_all","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.inCosets_all","kind":"theorem","line":483,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L483-L491","doc":"**Every element lies in one of the `n+2` parabolic cosets.** ","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.inCosets_mul_gen","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.inCosets_mul_gen","kind":"theorem","line":462,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L462-L481","doc":"**The coset union is closed under right multiplication by a generator.**\nThis is where the four cases of the closure argument are consumed. ","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.inCosets_one","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.inCosets_one","kind":"theorem","line":458,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L458-L459","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.InCosets","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.InCosets","kind":"def","line":454,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L454-L456","doc":"Membership in the union of the `n+2` parabolic cosets `H · t_k`. ","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.gen_mem_incl_range","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.gen_mem_incl_range","kind":"theorem","line":446,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L446-L452","doc":"The parabolic contains every generator of index `< n`. ","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.incl_simple","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.incl_simple","kind":"theorem","line":441,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L441-L444","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.t_push","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.t_push","kind":"theorem","line":387,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L387-L424","doc":"Case `k < i`: the run pushes a generator down by one.\n`t_k σ_i = σ_{i-1} t_k`. ","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.t_comm","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.t_comm","kind":"theorem","line":380,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L380-L384","doc":"Case `i + 1 < k`: distant generators commute past the whole run. ","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.gen_comm_prod","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.gen_comm_prod","kind":"theorem","line":370,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L370-L378","doc":"A generator distant from every factor of a product commutes past it. ","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.t_mul_gen_pred","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.t_mul_gen_pred","kind":"theorem","line":362,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L362-L368","doc":"Case `i = k - 1`: the run extends downward. ","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.t_mul_gen_self","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.t_mul_gen_self","kind":"theorem","line":358,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L358-L360","doc":"Case `i = k`: the run absorbs its own bottom generator. ","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.t_succ","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.t_succ","kind":"theorem","line":348,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L348-L355","doc":"The bottom recursion: peel off the last (smallest-index) generator. ","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.t_of_ge","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.t_of_ge","kind":"theorem","line":345,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L345-L346","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.t_self","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.t_self","kind":"theorem","line":342,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L342-L343","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.t","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.t","kind":"def","line":338,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L338-L340","doc":"The descending run `t N k = σ_{N-1} σ_{N-2} ⋯ σ_k`, empty (`= 1`) when `k ≥ N`. ","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.gen_braid","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.gen_braid","kind":"theorem","line":300,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L300-L314","doc":"Adjacent generators braid. ","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.braid_of_pow_three","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.braid_of_pow_three","kind":"theorem","line":282,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L282-L298","doc":"From `(ab)³ = 1` with `a, b` involutions, the braid relation. ","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.gen_comm","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.gen_comm","kind":"theorem","line":264,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L264-L279","doc":"Distant generators commute. ","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.comm_of_sq_one","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.comm_of_sq_one","kind":"theorem","line":257,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L257-L262","doc":"Two elements of order ≤ 2 whose product squares to 1 commute. ","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.An_val","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.An_val","kind":"theorem","line":253,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L253-L255","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.gen_mul_self","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.gen_mul_self","kind":"theorem","line":247,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L247-L251","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.gen","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.gen","kind":"def","line":243,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L243-L245","doc":"`σ_j` as an `ℕ`-indexed generator, with junk value `1` out of range. ","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.incl","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.incl","kind":"def","line":218,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L218-L230","doc":"The parabolic inclusion `W(Aₙ) →* W(A_{n+1})`. ","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.An_castSucc","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.An_castSucc","kind":"theorem","line":208,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L208-L216","doc":"The `Aₙ` matrix entries depend only on the underlying naturals, so the\ninclusion `Fin n ↪ Fin (n+1)` preserves them. ","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.toPerm_surjective","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.toPerm_surjective","kind":"theorem","line":188,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L188-L200","doc":"**`toPerm` is surjective**: the adjacent transpositions generate `S_{n+1}`. ","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.toPerm_simple","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.toPerm_simple","kind":"theorem","line":183,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L183-L185","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.toPerm","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.toPerm","kind":"def","line":177,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L177-L181","doc":"**The canonical map from the type-`Aₙ` Coxeter group to `S_{n+1}`.** ","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.s_rel","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.s_rel","kind":"theorem","line":147,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L147-L174","doc":"**The adjacent transpositions satisfy the type-`Aₙ` Coxeter relations.** ","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.s_mul_self","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.s_mul_self","kind":"theorem","line":144,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L144-L145","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.pow_three_swap","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.pow_three_swap","kind":"theorem","line":138,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L138-L142","doc":"Helper: `(xy)^3 = x (yx)^3 x⁻¹`, so the braid relation is symmetric in the pair. ","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.castSucc_ne_succ","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.castSucc_ne_succ","kind":"theorem","line":135,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L135-L136","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.s","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.s","kind":"def","line":131,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L131-L133","doc":"The `i`-th adjacent transposition in `S_{n+1}`. ","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.swap_disjoint_pow_two","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.swap_disjoint_pow_two","kind":"theorem","line":105,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L105-L128","signatureChunk":0},{"@id":"lean:QOU.Hecke.SymmetricCoxeter.swap_braid_pow_three","@type":"LeanDeclaration","name":"QOU.Hecke.SymmetricCoxeter.swap_braid_pow_three","kind":"theorem","line":93,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/SymmetricCoxeter.lean#L93-L103","signatureChunk":0}]}