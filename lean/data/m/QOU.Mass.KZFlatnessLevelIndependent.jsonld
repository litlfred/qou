{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Mass.KZFlatnessLevelIndependent","@type":"LeanModule","name":"QOU.Mass.KZFlatnessLevelIndependent","imports":["lean:module:Init","lean:module:Mathlib.Tactic","lean:module:Mathlib.Algebra.Algebra.Defs"],"declarations":7,"chunks":1},{"@id":"lean:QOU.Mass.KZFlatnessLevelIndependent.InfinitesimalBraidRelations.zero","@type":"LeanDeclaration","name":"QOU.Mass.KZFlatnessLevelIndependent.InfinitesimalBraidRelations.zero","kind":"theorem","line":63,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/KZFlatnessLevelIndependent.lean#L63-L69","doc":"The zero family satisfies the relations — so the relations alone say nothing about\nwhich `c` is \"the\" level; that is the point. ","signatureChunk":0},{"@id":"lean:QOU.Mass.KZFlatnessLevelIndependent.InfinitesimalBraidRelations.smul","@type":"LeanDeclaration","name":"QOU.Mass.KZFlatnessLevelIndependent.InfinitesimalBraidRelations.smul","kind":"theorem","line":46,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/KZFlatnessLevelIndependent.lean#L46-L61","doc":"Homogeneity: the relations survive scaling by any scalar `c` — the level. ","signatureChunk":0},{"@id":"lean:QOU.Mass.KZFlatnessLevelIndependent.InfinitesimalBraidRelations.comm_disjoint","@type":"LeanDeclaration","name":"QOU.Mass.KZFlatnessLevelIndependent.InfinitesimalBraidRelations.comm_disjoint","kind":"theorem","line":44,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/KZFlatnessLevelIndependent.lean#L44-L44","doc":"`[t_ij, t_kl] = 0` for disjoint pairs. ","signatureChunk":0},{"@id":"lean:QOU.Mass.KZFlatnessLevelIndependent.InfinitesimalBraidRelations.comm_three","@type":"LeanDeclaration","name":"QOU.Mass.KZFlatnessLevelIndependent.InfinitesimalBraidRelations.comm_three","kind":"theorem","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/KZFlatnessLevelIndependent.lean#L42-L42","doc":"`[t_ij, t_ik + t_jk] = 0` for pairwise distinct `i, j, k`. ","signatureChunk":0},{"@id":"lean:QOU.Mass.KZFlatnessLevelIndependent.InfinitesimalBraidRelations.symm","@type":"LeanDeclaration","name":"QOU.Mass.KZFlatnessLevelIndependent.InfinitesimalBraidRelations.symm","kind":"theorem","line":40,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/KZFlatnessLevelIndependent.lean#L40-L40","signatureChunk":0},{"@id":"lean:QOU.Mass.KZFlatnessLevelIndependent.InfinitesimalBraidRelations.mk","@type":"LeanDeclaration","name":"QOU.Mass.KZFlatnessLevelIndependent.InfinitesimalBraidRelations.mk","kind":"ctor","line":39,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/KZFlatnessLevelIndependent.lean#L39-L39","signatureChunk":0},{"@id":"lean:QOU.Mass.KZFlatnessLevelIndependent.InfinitesimalBraidRelations","@type":"LeanDeclaration","name":"QOU.Mass.KZFlatnessLevelIndependent.InfinitesimalBraidRelations","kind":"structure","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/KZFlatnessLevelIndependent.lean#L38-L44","doc":"The infinitesimal braid (Kohno–Drinfeld) relations on a family `t : Fin n → Fin n → A`. ","signatureChunk":0}]}