{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:MeasurementObservation.BundleInitialConditions","@type":"LeanModule","name":"MeasurementObservation.BundleInitialConditions","imports":["lean:module:Init","lean:module:Mathlib.Algebra.Polynomial.Laurent","lean:module:Mathlib.Data.Int.Basic","lean:module:QOU.KnotTheory"],"declarations":28,"chunks":1},{"@id":"lean:QOU.BundleInitialConditions.equiv_preserves_size","@type":"LeanDeclaration","name":"QOU.BundleInitialConditions.equiv_preserves_size","kind":"theorem","line":148,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L148-L155","doc":"Equivalent BICs have the same size. ","signatureChunk":0},{"@id":"lean:QOU.BundleInitialConditions.equiv_trans","@type":"LeanDeclaration","name":"QOU.BundleInitialConditions.equiv_trans","kind":"theorem","line":143,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L143-L146","doc":"BIC equivalence is transitive. ","signatureChunk":0},{"@id":"lean:QOU.BundleInitialConditions.equiv_symm","@type":"LeanDeclaration","name":"QOU.BundleInitialConditions.equiv_symm","kind":"theorem","line":138,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L138-L141","doc":"BIC equivalence is symmetric. ","signatureChunk":0},{"@id":"lean:QOU.BundleInitialConditions.equiv_refl","@type":"LeanDeclaration","name":"QOU.BundleInitialConditions.equiv_refl","kind":"theorem","line":133,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L133-L136","doc":"BIC equivalence is reflexive. ","signatureChunk":0},{"@id":"lean:QOU.BundleInitialConditions.equiv","@type":"LeanDeclaration","name":"QOU.BundleInitialConditions.equiv","kind":"def","line":128,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L128-L131","doc":"Two BICs are equivalent: same multiset of (basePoint, knotName) pairs. ","signatureChunk":0},{"@id":"lean:QOU.BundleInitialConditions.totalCrossings_eq_sum","@type":"LeanDeclaration","name":"QOU.BundleInitialConditions.totalCrossings_eq_sum","kind":"theorem","line":115,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L115-L120","doc":"Total crossing number equals the sum of crossing numbers of\nall particles (directly from the definition). ","signatureChunk":0},{"@id":"lean:QOU.BundleInitialConditions.cluster_basePoint_eq","@type":"LeanDeclaration","name":"QOU.BundleInitialConditions.cluster_basePoint_eq","kind":"theorem","line":107,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L107-L113","doc":"The cluster at a point p contains only particles with base point p. ","signatureChunk":0},{"@id":"lean:QOU.BundleInitialConditions.particle_in_own_cluster","@type":"LeanDeclaration","name":"QOU.BundleInitialConditions.particle_in_own_cluster","kind":"theorem","line":99,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L99-L105","doc":"Every particle is in the cluster at its own base point. ","signatureChunk":0},{"@id":"lean:QOU.BundleInitialConditions.particlesAt","@type":"LeanDeclaration","name":"QOU.BundleInitialConditions.particlesAt","kind":"def","line":94,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L94-L97","doc":"Particles at a given base point. ","signatureChunk":0},{"@id":"lean:QOU.BundleInitialConditions.size_pos","@type":"LeanDeclaration","name":"QOU.BundleInitialConditions.size_pos","kind":"theorem","line":84,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L84-L86","doc":"Size is always positive. ","signatureChunk":0},{"@id":"lean:QOU.BundleInitialConditions.basePoints","@type":"LeanDeclaration","name":"QOU.BundleInitialConditions.basePoints","kind":"def","line":79,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L79-L82","doc":"The set of distinct base points in the bundle. ","signatureChunk":0},{"@id":"lean:QOU.BundleInitialConditions.totalCrossings","@type":"LeanDeclaration","name":"QOU.BundleInitialConditions.totalCrossings","kind":"def","line":75,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L75-L77","doc":"Total crossing number of all knots in the bundle. ","signatureChunk":0},{"@id":"lean:QOU.BundleInitialConditions.size","@type":"LeanDeclaration","name":"QOU.BundleInitialConditions.size","kind":"def","line":71,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L71-L73","doc":"Total number of particles in the bundle. ","signatureChunk":0},{"@id":"lean:QOU.BundleInitialConditions.nonempty","@type":"LeanDeclaration","name":"QOU.BundleInitialConditions.nonempty","kind":"theorem","line":67,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L67-L67","doc":"Must have at least one particle. ","signatureChunk":0},{"@id":"lean:QOU.BundleInitialConditions.particles","@type":"LeanDeclaration","name":"QOU.BundleInitialConditions.particles","kind":"def","line":64,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L64-L64","doc":"The localized knots (position + knot type pairs). ","signatureChunk":0},{"@id":"lean:QOU.BundleInitialConditions.mk","@type":"LeanDeclaration","name":"QOU.BundleInitialConditions.mk","kind":"ctor","line":62,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L62-L62","signatureChunk":0},{"@id":"lean:QOU.BundleInitialConditions","@type":"LeanDeclaration","name":"QOU.BundleInitialConditions","kind":"structure","line":59,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L59-L67","doc":"A bundle initial condition: a finite set of localized knots on CP¹.\nEquivalently, a section of the free commutative monoid on the knot\nsheaf K → P(V). ","formalizes":[{"@id":"block:def:bundle-initial-conditions","label":"def:bundle-initial-conditions","md":"quantum-observable-universe/measurement-observation/bundle-initial-conditions.md"}],"signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot.basePoint","@type":"LeanDeclaration","name":"QOU.LocalizedKnot.basePoint","kind":"def","line":57,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L57-L57","doc":"The base point on `P(V)` (affine-chart coordinate pair). ","signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot.knot","@type":"LeanDeclaration","name":"QOU.LocalizedKnot.knot","kind":"def","line":55,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L55-L55","doc":"The knot type sitting at this position. ","signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot.mk","@type":"LeanDeclaration","name":"QOU.LocalizedKnot.mk","kind":"ctor","line":53,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L53-L53","signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot","@type":"LeanDeclaration","name":"QOU.LocalizedKnot","kind":"structure","line":50,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L50-L57","doc":"A localized knot: a knot type placed at a base point on `P(V)`\n(an affine-chart coordinate pair over `R_q`).\nHonest in-file mirror; `def:localized-hadron` is the narrative source. ","formalizes":[{"@id":"block:def:localized-knot","label":"def:localized-knot","md":"quantum-observable-universe/lifting-and-descent/localized-knot.md"}],"signatureChunk":0},{"@id":"lean:QOU.Knot.name","@type":"LeanDeclaration","name":"QOU.Knot.name","kind":"def","line":48,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L48-L48","doc":"The knot name (ambient-isotopy combinatorial proxy). ","signatureChunk":0},{"@id":"lean:QOU.Knot.crossingCount","@type":"LeanDeclaration","name":"QOU.Knot.crossingCount","kind":"def","line":46,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L46-L46","doc":"Number of crossings of the knot diagram. ","signatureChunk":0},{"@id":"lean:QOU.Knot.mk","@type":"LeanDeclaration","name":"QOU.Knot.mk","kind":"ctor","line":44,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L44-L44","signatureChunk":0},{"@id":"lean:QOU.Knot","@type":"LeanDeclaration","name":"QOU.Knot","kind":"structure","line":39,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L39-L48","doc":"A knot type: combinatorial knot data carrying a crossing count and a\nname (the combinatorial proxy for ambient-isotopy class).\nHonest in-file mirror of the knot carrier used by the localized-knot\nsheaf; the canonical knot data lives in `QOU.KnotTheory`\n(`BraidWord.crossingCount` etc.). ","signatureChunk":0},{"@id":"lean:QOU.q_inv_param","@type":"LeanDeclaration","name":"QOU.q_inv_param","kind":"def","line":37,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L37-L37","signatureChunk":0},{"@id":"lean:QOU.q_param","@type":"LeanDeclaration","name":"QOU.q_param","kind":"def","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L36-L36","signatureChunk":0},{"@id":"lean:QOU.R_q","@type":"LeanDeclaration","name":"QOU.R_q","kind":"def","line":33,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-initial-conditions.lean#L33-L35","doc":"Ground ring `R_q = ℤ[q, q⁻¹]` (Laurent polynomials over ℤ).\nSee `QOU.Archimedean.GroundRing` for the compiled definition. ","signatureChunk":0}]}