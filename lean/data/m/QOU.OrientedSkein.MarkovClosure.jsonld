in.LeftTrace.fullTr_succ","@type":"LeanDeclaration","name":"QOU.OrientedSkein.LeftTrace.fullTr_succ","kind":"theorem","line":180,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/MarkovClosure.lean#L180-L181","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.LeftTrace.fullTr_zero","@type":"LeanDeclaration","name":"QOU.OrientedSkein.LeftTrace.fullTr_zero","kind":"theorem","line":178,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/MarkovClosure.lean#L178-L178","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.LeftTrace.fullTr","@type":"LeanDeclaration","name":"QOU.OrientedSkein.LeftTrace.fullTr","kind":"def","line":173,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/MarkovClosure.lean#L173-L176","doc":"The closure of all strands of `X^{⊗m}`. ","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.LeftTrace.ptr_whisker","@type":"LeanDeclaration","name":"QOU.OrientedSkein.LeftTrace.ptr_whisker","kind":"theorem","line":168,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/MarkovClosure.lean#L168-L171","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.LeftTrace.ptr2_conj","@type":"LeanDeclaration","name":"QOU.OrientedSkein.LeftTrace.ptr2_conj","kind":"theorem","line":161,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/MarkovClosure.lean#L161-L161","doc":"Closing the two leftmost strands is invariant under moving the crossing around. ","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.LeftTrace.ptr_cross","@type":"LeanDeclaration","name":"QOU.OrientedSkein.LeftTrace.ptr_cross","kind":"theorem","line":159,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/MarkovClosure.lean#L159-L159","doc":"Closing the left strand of a crossing gives the scalar `w`. ","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.LeftTrace.ptr_id","@type":"LeanDeclaration","name":"QOU.OrientedSkein.LeftTrace.ptr_id","kind":"theorem","line":157,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/MarkovClosure.lean#L157-L157","doc":"A closed loop is the scalar `d`. ","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.LeftTrace.w","@type":"LeanDeclaration","name":"QOU.OrientedSkein.LeftTrace.w","kind":"def","line":155,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/MarkovClosure.lean#L155-L155","doc":"The curl value. ","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.LeftTrace.d","@type":"LeanDeclaration","name":"QOU.OrientedSkein.LeftTrace.d","kind":"def","line":153,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/MarkovClosure.lean#L153-L153","doc":"The loop value. ","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.LeftTrace.ptr_comp_whisker","@type":"LeanDeclaration","name":"QOU.OrientedSkein.LeftTrace.ptr_comp_whisker","kind":"theorem","line":150,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/MarkovClosure.lean#L150-L150","doc":"Naturality on the target side. ","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.LeftTrace.ptr_whisker_comp","@type":"LeanDeclaration","name":"QOU.OrientedSkein.LeftTrace.ptr_whisker_comp","kind":"theorem","line":147,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/MarkovClosure.lean#L147-L147","doc":"Naturality on the source side. ","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.LeftTrace.ptr","@type":"LeanDeclaration","name":"QOU.OrientedSkein.LeftTrace.ptr","kind":"def","line":145,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/MarkovClosure.lean#L145-L145","doc":"Close the leftmost strand. ","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.LeftTrace.mk","@type":"LeanDeclaration","name":"QOU.OrientedSkein.LeftTrace.mk","kind":"ctor","line":143,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/MarkovClosure.lean#L143-L143","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.LeftTrace","@type":"LeanDeclaration","name":"QOU.OrientedSkein.LeftTrace","kind":"structure","line":140,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/MarkovClosure.lean#L140-L162","doc":"A **left trace** for a Hecke crossing `H` on `X`: `R`-linear maps closing the leftmost strand,\nnatural in the remaining strands, with loop value `d`, curl `w`, and invariance of the double\nclosure under conjugation by the crossing (Markov's first move on the two closed strands). ","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.HeckeCrossing.revAction_last","@type":"LeanDeclaration","name":"QOU.OrientedSkein.HeckeCrossing.revAction_last","kind":"theorem","line":132,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/MarkovClosure.lean#L132-L136","doc":"**The new generator acts on the two leftmost strands.** ","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.HeckeCrossing.revAction_incl","@type":"LeanDeclaration","name":"QOU.OrientedSkein.HeckeCrossing.revAction_incl","kind":"theorem","line":119,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/MarkovClosure.lean#L119-L130","doc":"**Tower compatibility.**  The inclusion `H_n ↪ H_{n+1}` adds a strand on the left. ","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.HeckeCrossing.whiskerAlg_apply","@type":"LeanDeclaration","name":"QOU.OrientedSkein.HeckeCrossing.whiskerAlg_apply","kind":"theorem","line":116,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/MarkovClosure.lean#L116-L117","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.HeckeCrossing.whiskerAlg","@type":"LeanDeclaration","name":"QOU.OrientedSkein.HeckeCrossing.whiskerAlg","kind":"def","line":105,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/MarkovClosure.lean#L105-L114","doc":"Left whiskering by `X`, as an `R`-algebra map `End Y →ₐ[R] End (X ⊗ Y)`. ","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.HeckeCrossing.revAction_σ","@type":"LeanDeclaration","name":"QOU.OrientedSkein.HeckeCrossing.revAction_σ","kind":"theorem","line":101,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/MarkovClosure.lean#L101-L103","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.HeckeCrossing.revAction","@type":"LeanDeclaration","name":"QOU.OrientedSkein.HeckeCrossing.revAction","kind":"def","line":82,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/MarkovClosure.lean#L82-L99","doc":"The Hecke action with generators numbered from the right: `σ_i ↦ gen (n - 1 - i)`. ","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.HeckeCrossing.gen_succ'","@type":"LeanDeclaration","name":"QOU.OrientedSkein.HeckeCrossing.gen_succ'","kind":"theorem","line":78,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/MarkovClosure.lean#L78-L80","signatureChunk":0}]}