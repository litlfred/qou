ecke.Inversions.mem_invSet","@type":"LeanDeclaration","name":"QOU.Hecke.Inversions.mem_invSet","kind":"theorem","line":111,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/PermInversions.lean#L111-L113","signatureChunk":0},{"@id":"lean:QOU.Hecke.Inversions.swap_pair_lt","@type":"LeanDeclaration","name":"QOU.Hecke.Inversions.swap_pair_lt","kind":"theorem","line":95,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/PermInversions.lean#L95-L108","doc":"Swapping two *adjacent* positions preserves the order of every pair except\nthe swapped pair itself. ","signatureChunk":0},{"@id":"lean:QOU.Hecke.Inversions.eq_one_of_invCount_eq_zero","@type":"LeanDeclaration","name":"QOU.Hecke.Inversions.eq_one_of_invCount_eq_zero","kind":"theorem","line":82,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/PermInversions.lean#L82-L90","doc":"**A permutation with no inversions is the identity.** ","signatureChunk":0},{"@id":"lean:QOU.Hecke.Inversions.invCount_one","@type":"LeanDeclaration","name":"QOU.Hecke.Inversions.invCount_one","kind":"theorem","line":76,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/PermInversions.lean#L76-L80","signatureChunk":0},{"@id":"lean:QOU.Hecke.Inversions.invCount","@type":"LeanDeclaration","name":"QOU.Hecke.Inversions.invCount","kind":"def","line":73,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/PermInversions.lean#L73-L74","doc":"The number of inversions. ","signatureChunk":0},{"@id":"lean:QOU.Hecke.Inversions.invSet","@type":"LeanDeclaration","name":"QOU.Hecke.Inversions.invSet","kind":"def","line"