{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.QBeta.DilogTheory","@type":"LeanModule","name":"QOU.QBeta.DilogTheory","imports":["lean:module:Init","lean:module:QOU.QBeta.FiveTwoFiveTermArguments","lean:module:Mathlib.Tactic"],"declarations":14,"chunks":1},{"@id":"lean:QOU.QBeta.DilogTheory.SuslinDilogTheory.anharmonic","@type":"LeanDeclaration","name":"QOU.QBeta.DilogTheory.SuslinDilogTheory.anharmonic","kind":"theorem","line":93,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/DilogTheory.lean#L93-L110","doc":"**The anharmonic orbit**, given reflection oddness `D(1 − z) = −D z`: the six cross-ratio\nimages of `z` carry `±D z`. Pure algebra. Reflection is a hypothesis here, not a field: it is\nproved for the Bloch–Wigner instance in `FiveTermProof.blochD_one_sub`; see\n`blochWigner_anharmonic`. ","signatureChunk":0},{"@id":"lean:QOU.QBeta.DilogTheory.SuslinDilogTheory.five","@type":"LeanDeclaration","name":"QOU.QBeta.DilogTheory.SuslinDilogTheory.five","kind":"theorem","line":88,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/DilogTheory.lean#L88-L88","signatureChunk":0},{"@id":"lean:QOU.QBeta.DilogTheory.SuslinDilogTheory.inv_odd","@type":"LeanDeclaration","name":"QOU.QBeta.DilogTheory.SuslinDilogTheory.inv_odd","kind":"theorem","line":87,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/DilogTheory.lean#L87-L87","signatureChunk":0},{"@id":"lean:QOU.QBeta.DilogTheory.SuslinDilogTheory.D","@type":"LeanDeclaration","name":"QOU.QBeta.DilogTheory.SuslinDilogTheory.D","kind":"def","line":86,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/DilogTheory.lean#L86-L86","signatureChunk":0},{"@id":"lean:QOU.QBeta.DilogTheory.SuslinDilogTheory.mk","@type":"LeanDeclaration","name":"QOU.QBeta.DilogTheory.SuslinDilogTheory.mk","kind":"ctor","line":85,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/DilogTheory.lean#L85-L85","signatureChunk":0},{"@id":"lean:QOU.QBeta.DilogTheory.SuslinDilogTheory","@type":"LeanDeclaration","name":"QOU.QBeta.DilogTheory.SuslinDilogTheory","kind":"structure","line":81,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/DilogTheory.lean#L81-L89","doc":"**A Bloch–Wigner-type dilogarithm theory** on a field `F` with values in an abelian\ngroup `A`: oddness under `z ↦ 1/z` and Suslin's five-term relation, in the orientation of\n`QOU.Archimedean.SuslinFiveTerm` (PR #7946). The corpus's `PentagonCoherent` uses the inverted\norientation and forces `D = 0`. ","signatureChunk":0},{"@id":"lean:QOU.QBeta.DilogTheory.RogersDilogTheory.numerators","@type":"LeanDeclaration","name":"QOU.QBeta.DilogTheory.RogersDilogTheory.numerators","kind":"theorem","line":56,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/DilogTheory.lean#L56-L77","doc":"**The level-7 numerators `(17, 5, −1)` hold in every Rogers-type theory.**\nNo analysis: the inputs are the two fields of the structure and the cubic. ","signatureChunk":0},{"@id":"lean:QOU.QBeta.DilogTheory.root_bounds","@type":"LeanDeclaration","name":"QOU.QBeta.DilogTheory.root_bounds","kind":"theorem","line":40,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/DilogTheory.lean#L40-L54","signatureChunk":0},{"@id":"lean:QOU.QBeta.DilogTheory.RogersDilogTheory.abel","@type":"LeanDeclaration","name":"QOU.QBeta.DilogTheory.RogersDilogTheory.abel","kind":"theorem","line":35,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/DilogTheory.lean#L35-L35","signatureChunk":0},{"@id":"lean:QOU.QBeta.DilogTheory.RogersDilogTheory.reflection","@type":"LeanDeclaration","name":"QOU.QBeta.DilogTheory.RogersDilogTheory.reflection","kind":"theorem","line":34,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/DilogTheory.lean#L34-L34","signatureChunk":0},{"@id":"lean:QOU.QBeta.DilogTheory.RogersDilogTheory.L1","@type":"LeanDeclaration","name":"QOU.QBeta.DilogTheory.RogersDilogTheory.L1","kind":"def","line":33,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/DilogTheory.lean#L33-L33","signatureChunk":0},{"@id":"lean:QOU.QBeta.DilogTheory.RogersDilogTheory.L","@type":"LeanDeclaration","name":"QOU.QBeta.DilogTheory.RogersDilogTheory.L","kind":"def","line":32,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/DilogTheory.lean#L32-L32","signatureChunk":0},{"@id":"lean:QOU.QBeta.DilogTheory.RogersDilogTheory.mk","@type":"LeanDeclaration","name":"QOU.QBeta.DilogTheory.RogersDilogTheory.mk","kind":"ctor","line":31,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/DilogTheory.lean#L31-L31","signatureChunk":0},{"@id":"lean:QOU.QBeta.DilogTheory.RogersDilogTheory","@type":"LeanDeclaration","name":"QOU.QBeta.DilogTheory.RogersDilogTheory","kind":"structure","line":29,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/DilogTheory.lean#L29-L36","doc":"**A Rogers-type dilogarithm theory** on an ordered field `K`: a function `L` with\nreflection and Abel's five-term relation on the open unit interval. ","signatureChunk":0}]}