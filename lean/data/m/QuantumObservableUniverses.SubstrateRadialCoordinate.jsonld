{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QuantumObservableUniverses.SubstrateRadialCoordinate","@type":"LeanModule","name":"QuantumObservableUniverses.SubstrateRadialCoordinate","imports":["lean:module:Init","lean:module:Mathlib.Data.Real.Basic","lean:module:Mathlib.Tactic"],"declarations":12,"chunks":1},{"@id":"lean:QOU.classical_limit_hbar","@type":"LeanDeclaration","name":"QOU.classical_limit_hbar","kind":"theorem","line":71,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/substrate-radial-coordinate.lean#L71-L75","doc":"In the classical limit (q → 1), ℏ_q → 0. ","signatureChunk":0},{"@id":"lean:QOU.deep_quantum_limit_hbar","@type":"LeanDeclaration","name":"QOU.deep_quantum_limit_hbar","kind":"theorem","line":61,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/substrate-radial-coordinate.lean#L61-L69","doc":"In the deep-quantum limit (q → ∞), ℏ_q → 1. ","signatureChunk":0},{"@id":"lean:QOU.hbar_q_pos","@type":"LeanDeclaration","name":"QOU.hbar_q_pos","kind":"theorem","line":48,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/substrate-radial-coordinate.lean#L48-L59","doc":"ℏ_q is positive for q > 1.\n\n`hbar_q` is a structure field carrying the default value `1 - q⁻¹`;\n`hdef` records that the constant takes this canonical value, which is\nthe definitional content `ℏ_q = 1 - q⁻¹` from the narrative. ","signatureChunk":0},{"@id":"lean:QOU.SubstrateRadialCoordinate.reeb_flow_rate","@type":"LeanDeclaration","name":"QOU.SubstrateRadialCoordinate.reeb_flow_rate","kind":"def","line":46,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/substrate-radial-coordinate.lean#L46-L46","doc":"The q-Reeb flow rate: ℒ_ξ Z = J · ℏ_q · Z. ","signatureChunk":0},{"@id":"lean:QOU.SubstrateRadialCoordinate.J","@type":"LeanDeclaration","name":"QOU.SubstrateRadialCoordinate.J","kind":"def","line":44,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/substrate-radial-coordinate.lean#L44-L44","doc":"The angular momentum quantum number J. ","signatureChunk":0},{"@id":"lean:QOU.SubstrateRadialCoordinate.hbar_q","@type":"LeanDeclaration","name":"QOU.SubstrateRadialCoordinate.hbar_q","kind":"def","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/substrate-radial-coordinate.lean#L42-L42","doc":"The quantum Planck constant ℏ_q = 1 - q⁻¹. ","signatureChunk":0},{"@id":"lean:QOU.SubstrateRadialCoordinate.Z_nonneg","@type":"LeanDeclaration","name":"QOU.SubstrateRadialCoordinate.Z_nonneg","kind":"theorem","line":40,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/substrate-radial-coordinate.lean#L40-L40","doc":"Z ≥ 0 (radial coordinate). ","signatureChunk":0},{"@id":"lean:QOU.SubstrateRadialCoordinate.Z","@type":"LeanDeclaration","name":"QOU.SubstrateRadialCoordinate.Z","kind":"def","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/substrate-radial-coordinate.lean#L38-L38","doc":"The affine coordinate Z = α_H / ι_ξ α. ","signatureChunk":0},{"@id":"lean:QOU.SubstrateRadialCoordinate.q_gt_one","@type":"LeanDeclaration","name":"QOU.SubstrateRadialCoordinate.q_gt_one","kind":"theorem","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/substrate-radial-coordinate.lean#L36-L36","doc":"q > 1. ","signatureChunk":0},{"@id":"lean:QOU.SubstrateRadialCoordinate.q","@type":"LeanDeclaration","name":"QOU.SubstrateRadialCoordinate.q","kind":"def","line":34,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/substrate-radial-coordinate.lean#L34-L34","doc":"The substrate parameter q > 1. ","signatureChunk":0},{"@id":"lean:QOU.SubstrateRadialCoordinate.mk","@type":"LeanDeclaration","name":"QOU.SubstrateRadialCoordinate.mk","kind":"ctor","line":32,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/substrate-radial-coordinate.lean#L32-L32","signatureChunk":0},{"@id":"lean:QOU.SubstrateRadialCoordinate","@type":"LeanDeclaration","name":"QOU.SubstrateRadialCoordinate","kind":"structure","line":29,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/substrate-radial-coordinate.lean#L29-L46","doc":"**Substrate radial coordinate**: the relationship between\nthe substrate parameter q and the affine coordinate Z. ","signatureChunk":0}]}