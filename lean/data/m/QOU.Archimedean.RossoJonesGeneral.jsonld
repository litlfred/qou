","kind":"def","line":51,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesGeneral.lean#L51-L52","doc":"The number of ones in a basis state. ","signatureChunk":0}]}