{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Knot.KummerDilogHalf","@type":"LeanModule","name":"QOU.Knot.KummerDilogHalf","imports":["lean:module:Init","lean:module:QOU.Knot.KummerUnitCircle","lean:module:QOU.MathlibExt.ComplexDilogarithmDeriv","lean:module:QOU.MathlibExt.ComplexDilogarithmInversion","lean:module:QOU.Knot.Clausen"],"declarations":6,"chunks":1},{"@id":"lean:QOU.Knot.Kummer.kummer_unit_circle","@type":"LeanDeclaration","name":"QOU.Knot.Kummer.kummer_unit_circle","kind":"theorem","line":212,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/KummerDilogHalf.lean#L212-L232","doc":"**KUMMER'S IDENTITY ON THE UNIT CIRCLE, both halves.**\n\nFor `θ ∈ (0, π)`,\n\n    `BlochWigner_lob(e^{iθ}) = Im cLiTwoExt(e^{iθ}) + log‖e^{iθ}‖ · arg(1 − e^{iθ})`\n\n— the second term vanishing because `‖e^{iθ}‖ = 1`.  This is Route 72's G3\ndischarged: the corpus's angle-built `BlochWigner_lob` **is** the Bloch–Wigner\ndilogarithm on the unit circle.\n\n⚠ Still only on `|z| = 1`.  `|y₁| = 1.5236`, so this does not reach `Vol(5₂)`. ","signatureChunk":0},{"@id":"lean:QOU.Knot.Kummer.im_cLiTwoExt_exp","@type":"LeanDeclaration","name":"QOU.Knot.Kummer.im_cLiTwoExt_exp","kind":"theorem","line":184,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/KummerDilogHalf.lean#L184-L210","doc":"**`Im cLiTwoExt(e^{iθ}) = Cl₂(θ)` on `(0, 2π)`.**\n\nSame derivative (`−log(2 sin(θ/2))` on both sides) and the same value at `θ = π`,\nwhere `cLiTwoExt(−1) = −π²/12` is real and `Cl₂(π) = 0`. ","signatureChunk":0},{"@id":"lean:QOU.Knot.Kummer.hasDerivAt_im_cLiTwoExt_exp","@type":"LeanDeclaration","name":"QOU.Knot.Kummer.hasDerivAt_im_cLiTwoExt_exp","kind":"theorem","line":157,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/KummerDilogHalf.lean#L157-L180","doc":"Its imaginary part has derivative `−log(2 sin(θ/2))` — verbatim `Cl₂′`. ","signatureChunk":0},{"@id":"lean:QOU.Knot.Kummer.hasDerivAt_cLiTwoExt_exp","@type":"LeanDeclaration","name":"QOU.Knot.Kummer.hasDerivAt_cLiTwoExt_exp","kind":"theorem","line":138,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/KummerDilogHalf.lean#L138-L155","doc":"`d/dθ cLiTwoExt(e^{iθ}) = −i·log(1 − e^{iθ})`. ","signatureChunk":0},{"@id":"lean:QOU.Knot.Kummer.exp_mem_notCut","@type":"LeanDeclaration","name":"QOU.Knot.Kummer.exp_mem_notCut","kind":"theorem","line":119,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/KummerDilogHalf.lean#L119-L134","doc":"The whole punctured unit circle is off both cuts: for `θ ∈ (0, 2π)`, either\n`sin θ ≠ 0`, or `θ = π` and the point is `−1` with real part `< 1`. ","signatureChunk":0},{"@id":"lean:QOU.Knot.Kummer.eq_of_hasDerivAt_zero_Ioo","@type":"LeanDeclaration","name":"QOU.Knot.Kummer.eq_of_hasDerivAt_zero_Ioo","kind":"theorem","line":103,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/KummerDilogHalf.lean#L103-L115","doc":"If a real function has derivative `0` throughout `Ioo a b`, it is constant\nthere.  `Ioo` is convex and open, so `fderivWithin` collapses to `fderiv`. ","signatureChunk":0}]}