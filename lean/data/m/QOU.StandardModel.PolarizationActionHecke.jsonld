{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.StandardModel.PolarizationActionHecke","@type":"LeanModule","name":"QOU.StandardModel.PolarizationActionHecke","imports":["lean:module:Init","lean:module:Mathlib.Tactic","lean:module:QOU.StandardModel.ChiralityPolarizationHopf"],"declarations":15,"chunks":1},{"@id":"lean:QOU.StandardModel.PolarizationHecke.conj_braid","@type":"LeanDeclaration","name":"QOU.StandardModel.PolarizationHecke.conj_braid","kind":"theorem","line":198,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/StandardModel/PolarizationActionHecke.lean#L198-L206","signatureChunk":0},{"@id":"lean:QOU.StandardModel.PolarizationHecke.conj_hecke","@type":"LeanDeclaration","name":"QOU.StandardModel.PolarizationHecke.conj_hecke","kind":"theorem","line":187,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/StandardModel/PolarizationActionHecke.lean#L187-L196","signatureChunk":0},{"@id":"lean:QOU.StandardModel.PolarizationHecke.conj_add_smul","@type":"LeanDeclaration","name":"QOU.StandardModel.PolarizationHecke.conj_add_smul","kind":"theorem","line":183,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/StandardModel/PolarizationActionHecke.lean#L183-L185","signatureChunk":0},{"@id":"lean:QOU.StandardModel.PolarizationHecke.no_automorphism_to_orthogonal_pair","@type":"LeanDeclaration","name":"QOU.StandardModel.PolarizationHecke.no_automorphism_to_orthogonal_pair","kind":"theorem","line":168,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/StandardModel/PolarizationActionHecke.lean#L168-L176","doc":"**No algebra automorphism carries `(σ₀, σ₁)` to the generators of an orthogonal\npair.** Here an automorphism of the block is any injective ring endomorphism, and \"the\ngenerators of `(v, v⊥)`\" are two elements diagonal in the projector `P` onto `v`. ","signatureChunk":0},{"@id":"lean:QOU.StandardModel.PolarizationHecke.s_noncomm","@type":"LeanDeclaration","name":"QOU.StandardModel.PolarizationHecke.s_noncomm","kind":"theorem","line":158,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/StandardModel/PolarizationActionHecke.lean#L158-L166","doc":"**The letters do not commute** unless `q² = −1`. ","signatureChunk":0},{"@id":"lean:QOU.StandardModel.PolarizationHecke.braid_s","@type":"LeanDeclaration","name":"QOU.StandardModel.PolarizationHecke.braid_s","kind":"theorem","line":149,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/StandardModel/PolarizationActionHecke.lean#L149-L156","signatureChunk":0},{"@id":"lean:QOU.StandardModel.PolarizationHecke.s1_hecke","@type":"LeanDeclaration","name":"QOU.StandardModel.PolarizationHecke.s1_hecke","kind":"theorem","line":141,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/StandardModel/PolarizationActionHecke.lean#L141-L147","signatureChunk":0},{"@id":"lean:QOU.StandardModel.PolarizationHecke.s0_hecke","@type":"LeanDeclaration","name":"QOU.StandardModel.PolarizationHecke.s0_hecke","kind":"theorem","line":136,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/StandardModel/PolarizationActionHecke.lean#L136-L139","signatureChunk":0},{"@id":"lean:QOU.StandardModel.PolarizationHecke.hecke","@type":"LeanDeclaration","name":"QOU.StandardModel.PolarizationHecke.hecke","kind":"def","line":132,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/StandardModel/PolarizationActionHecke.lean#L132-L134","doc":"The Hecke quadratic `(x − q)(x + q⁻¹) = 0`, in any `K`-algebra. ","signatureChunk":0},{"@id":"lean:QOU.StandardModel.PolarizationHecke.s1","@type":"LeanDeclaration","name":"QOU.StandardModel.PolarizationHecke.s1","kind":"def","line":128,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/StandardModel/PolarizationActionHecke.lean#L128-L130","doc":"`σ₁`, with off-diagonal product `(q⁴ + q² + 1)/(q² + 1)²`. ","signatureChunk":0},{"@id":"lean:QOU.StandardModel.PolarizationHecke.s0","@type":"LeanDeclaration","name":"QOU.StandardModel.PolarizationHecke.s0","kind":"def","line":125,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/StandardModel/PolarizationActionHecke.lean#L125-L126","doc":"`σ₀ = diag(q, −q⁻¹)`. ","signatureChunk":0},{"@id":"lean:QOU.StandardModel.PolarizationHecke.no_hom_to_axis_pair","@type":"LeanDeclaration","name":"QOU.StandardModel.PolarizationHecke.no_hom_to_axis_pair","kind":"theorem","line":106,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/StandardModel/PolarizationActionHecke.lean#L106-L116","doc":"**No injective homomorphism sends a non-commuting pair to a pair sharing an\neigenprojector.** ","signatureChunk":0},{"@id":"lean:QOU.StandardModel.PolarizationHecke.eigenAxis_commute","@type":"LeanDeclaration","name":"QOU.StandardModel.PolarizationHecke.eigenAxis_commute","kind":"theorem","line":94,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/StandardModel/PolarizationActionHecke.lean#L94-L104","doc":"**Two elements diagonal in the same idempotent commute.** ","signatureChunk":0},{"@id":"lean:QOU.Tetraplectic.orth_pair_eq_leftMul_std","@type":"LeanDeclaration","name":"QOU.Tetraplectic.orth_pair_eq_leftMul_std","kind":"theorem","line":77,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/StandardModel/PolarizationActionHecke.lean#L77-L86","doc":"**Every orthogonal unit pair is `L_{p₁}` of the standard pair `(1, c j + d k)`.** ","signatureChunk":0},{"@id":"lean:QOU.Tetraplectic.leftMul_preserves_orth","@type":"LeanDeclaration","name":"QOU.Tetraplectic.leftMul_preserves_orth","kind":"theorem","line":68,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/StandardModel/PolarizationActionHecke.lean#L68-L75","doc":"Left multiplication by a unit preserves `p̄₁ p₂`, hence Hermitian orthogonality. ","signatureChunk":0}]}