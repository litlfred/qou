{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:MassTheory.FlavorDressingFunctor","@type":"LeanModule","name":"MassTheory.FlavorDressingFunctor","imports":["lean:module:Init","lean:module:QOU.Basic"],"declarations":19,"chunks":1},{"@id":"lean:QOU.FlavorDressing.FlavorDressingFunctor.μ_d_pos","@type":"LeanDeclaration","name":"QOU.FlavorDressing.FlavorDressingFunctor.μ_d_pos","kind":"theorem","line":65,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/flavor-dressing-functor.lean#L65-L67","doc":"Positivity of the down-quark dressed mass (specialisation). ","signatureChunk":0},{"@id":"lean:QOU.FlavorDressing.FlavorDressingFunctor.μ_u_pos","@type":"LeanDeclaration","name":"QOU.FlavorDressing.FlavorDressingFunctor.μ_u_pos","kind":"theorem","line":61,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/flavor-dressing-functor.lean#L61-L63","doc":"Positivity of the up-quark dressed mass (specialisation). ","signatureChunk":0},{"@id":"lean:QOU.FlavorDressing.FlavorDressingFunctor.μ_ud_split","@type":"LeanDeclaration","name":"QOU.FlavorDressing.FlavorDressingFunctor.μ_ud_split","kind":"def","line":55,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/flavor-dressing-functor.lean#L55-L59","doc":"The u-d splitting `μ_d − μ_u` (commonly used in hadronic mass\nformulas; signed so that the neutron–proton splitting is\nproportional to this quantity). ","signatureChunk":0},{"@id":"lean:QOU.FlavorDressing.FlavorDressingFunctor.μ_d","@type":"LeanDeclaration","name":"QOU.FlavorDressing.FlavorDressingFunctor.μ_d","kind":"def","line":52,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/flavor-dressing-functor.lean#L52-L53","doc":"Convenience accessor for the down-quark dressed mass. ","signatureChunk":0},{"@id":"lean:QOU.FlavorDressing.FlavorDressingFunctor.μ_u","@type":"LeanDeclaration","name":"QOU.FlavorDressing.FlavorDressingFunctor.μ_u","kind":"def","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/flavor-dressing-functor.lean#L49-L50","doc":"Convenience accessor for the up-quark dressed mass. ","signatureChunk":0},{"@id":"lean:QOU.FlavorDressing.FlavorDressingFunctor.μ_pos","@type":"LeanDeclaration","name":"QOU.FlavorDressing.FlavorDressingFunctor.μ_pos","kind":"theorem","line":45,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/flavor-dressing-functor.lean#L45-L45","doc":"Positivity: every dressed quark mass is strictly positive. ","signatureChunk":0},{"@id":"lean:QOU.FlavorDressing.FlavorDressingFunctor.μ","@type":"LeanDeclaration","name":"QOU.FlavorDressing.FlavorDressingFunctor.μ","kind":"def","line":43,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/flavor-dressing-functor.lean#L43-L43","doc":"Dressed-mass scale at each flavor, in physical units (MeV). ","signatureChunk":0},{"@id":"lean:QOU.FlavorDressing.FlavorDressingFunctor.mk","@type":"LeanDeclaration","name":"QOU.FlavorDressing.FlavorDressingFunctor.mk","kind":"ctor","line":41,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/flavor-dressing-functor.lean#L41-L41","signatureChunk":0},{"@id":"lean:QOU.FlavorDressing.FlavorDressingFunctor","@type":"LeanDeclaration","name":"QOU.FlavorDressing.FlavorDressingFunctor","kind":"class","line":28,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/flavor-dressing-functor.lean#L28-L45","doc":"**Flavor dressing functor.** Assigns a dressed-mass scale `μ q ∈ ℝ`\nto each quark flavor with the positivity hypothesis `0 < μ q`.\n\nThe discrete-category framing makes the assignment compatible\nwith the chapter's other categorical constructions (Markov\ntrace, Hoefsmit functor, Wedderburn block decomposition):\nflavor-sums in hadronic mass formulas are then natural\ntransformations, not ad-hoc weighted sums.\n\nInstances at specific substrate parameter values (e.g. `q = q₀`)\nlive in sibling files; this class carries only the structural\nsignature + positivity. ","formalizes":[{"@id":"block:def:flavor-dressing-functor","label":"def:flavor-dressing-functor","md":"quantum-observable-universe/mass-theory/flavor-dressing-functor.md"}],"signatureChunk":0},{"@id":"lean:QOU.FlavorDressing.instDecidableEqFlavor","@type":"LeanDeclaration","name":"QOU.FlavorDressing.instDecidableEqFlavor","kind":"instance","line":26,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/flavor-dressing-functor.lean#L26-L26","signatureChunk":0},{"@id":"lean:QOU.FlavorDressing.instReprFlavor","@type":"LeanDeclaration","name":"QOU.FlavorDressing.instReprFlavor","kind":"instance","line":26,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/flavor-dressing-functor.lean#L26-L26","signatureChunk":0},{"@id":"lean:QOU.FlavorDressing.instReprFlavor.repr","@type":"LeanDeclaration","name":"QOU.FlavorDressing.instReprFlavor.repr","kind":"def","line":26,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/flavor-dressing-functor.lean#L26-L26","signatureChunk":0},{"@id":"lean:QOU.FlavorDressing.Flavor.top","@type":"LeanDeclaration","name":"QOU.FlavorDressing.Flavor.top","kind":"ctor","line":25,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/flavor-dressing-functor.lean#L25-L25","signatureChunk":0},{"@id":"lean:QOU.FlavorDressing.Flavor.bottom","@type":"LeanDeclaration","name":"QOU.FlavorDressing.Flavor.bottom","kind":"ctor","line":24,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/flavor-dressing-functor.lean#L24-L24","signatureChunk":0},{"@id":"lean:QOU.FlavorDressing.Flavor.charm","@type":"LeanDeclaration","name":"QOU.FlavorDressing.Flavor.charm","kind":"ctor","line":23,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/flavor-dressing-functor.lean#L23-L23","signatureChunk":0},{"@id":"lean:QOU.FlavorDressing.Flavor.strange","@type":"LeanDeclaration","name":"QOU.FlavorDressing.Flavor.strange","kind":"ctor","line":22,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/flavor-dressing-functor.lean#L22-L22","signatureChunk":0},{"@id":"lean:QOU.FlavorDressing.Flavor.down","@type":"LeanDeclaration","name":"QOU.FlavorDressing.Flavor.down","kind":"ctor","line":21,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/flavor-dressing-functor.lean#L21-L21","signatureChunk":0},{"@id":"lean:QOU.FlavorDressing.Flavor.up","@type":"LeanDeclaration","name":"QOU.FlavorDressing.Flavor.up","kind":"ctor","line":20,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/flavor-dressing-functor.lean#L20-L20","signatureChunk":0},{"@id":"lean:QOU.FlavorDressing.Flavor","@type":"LeanDeclaration","name":"QOU.FlavorDressing.Flavor","kind":"inductive","line":15,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/flavor-dressing-functor.lean#L15-L26","doc":"The discrete category of quark flavors.  Initial scope: u, d.\nHeavy flavors (s, c, b, t) included in the enum for forward\ncompatibility; their individual `μ` values are open and live as\nopt-in instances in follow-up files. ","signatureChunk":0}]}