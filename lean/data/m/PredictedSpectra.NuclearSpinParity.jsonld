{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:PredictedSpectra.NuclearSpinParity","@type":"LeanModule","name":"PredictedSpectra.NuclearSpinParity","imports":["lean:module:Init","lean:module:Mathlib.Data.Nat.Basic","lean:module:Mathlib.Algebra.Order.Group.Nat","lean:module:Mathlib.Algebra.Group.Nat.Even","lean:module:Mathlib.Algebra.Ring.Parity"],"declarations":10,"chunks":1},{"@id":"lean:QOU.Archimedean.beta_decay_preserves_spin_parity","@type":"LeanDeclaration","name":"QOU.Archimedean.beta_decay_preserves_spin_parity","kind":"theorem","line":61,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/nuclear-spin-parity.lean#L61-L68","doc":"Adding one nucleon (beta decay preserves A) preserves spin parity.\nRequires `1 ≤ n` (β⁻ decay consumes one neutron; with truncated\n`ℕ`-subtraction the statement is false at `n = 0`). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.nuclear_spin_parity_odd","@type":"LeanDeclaration","name":"QOU.Archimedean.nuclear_spin_parity_odd","kind":"theorem","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/nuclear-spin-parity.lean#L42-L47","doc":"Odd A gives half-integer spin (fermionic). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.nuclear_spin_parity_even","@type":"LeanDeclaration","name":"QOU.Archimedean.nuclear_spin_parity_even","kind":"theorem","line":35,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/nuclear-spin-parity.lean#L35-L40","doc":"Even A gives integer spin (bosonic). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.nuclearSpinParity","@type":"LeanDeclaration","name":"QOU.Archimedean.nuclearSpinParity","kind":"def","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7