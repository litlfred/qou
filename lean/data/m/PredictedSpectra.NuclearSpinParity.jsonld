anDeclaration","name":"QOU.Archimedean.SpinParity","kind":"inductive","line":23,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/nuclear-spin-parity.lean#L23-L28","doc":"A nucleus has integer or half-integer spin determined by A mod 2. ","signatureChunk":0}]}