{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:MolecularConstruction.Co2MolecularBraid","@type":"LeanModule","name":"MolecularConstruction.Co2MolecularBraid","imports":["lean:module:Init"],"declarations":7,"chunks":1},{"@id":"lean:QOU.Molecular.co2_strands","@type":"LeanDeclaration","name":"QOU.Molecular.co2_strands","kind":"theorem","line":22,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/co2-molecular-braid.lean#L22-L23","doc":"CO₂ strand count: carbon(18) + 2 × oxygen(24). ","signatureChunk":0},{"@id":"lean:QOU.Molecular.CO2Braid.sharedElectrons","@type":"LeanDeclaration","name":"QOU.Molecular.CO2Braid.sharedElectrons","kind":"def","line":20,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/co2-molecular-braid.lean#L20-L20","doc":"Total shared electrons = 8. ","signatureChunk":0},{"@id":"lean:QOU.Molecular.CO2Braid.bondOrder","@type":"LeanDeclaration","name":"QOU.Molecular.CO2Braid.bondOrder","kind":"def","line":18,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/co2-molecular-braid.lean#L18-L18","doc":"Bond orders: each C=O is a double bond (order 2). ","signatureChunk":0},{"@id":"lean:QOU.Molecular.CO2Braid.numBonds","@type":"LeanDeclaration","name":"QOU.Molecular.CO2Braid.numBonds","kind":"def","line":16,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/co2-molecular-braid.lean#L16-L16","doc":"Number of bonds = 4 (2 double bonds × 2 channels each). ","signatureChunk":0},{"@id":"lean:QOU.Molecular.CO2Braid.totalStrands","@type":"LeanDeclaration","name":"QOU.Molecular.CO2Braid.totalStrands","kind":"def","line":14,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/co2-molecular-braid.lean#L14-L14","doc":"Total strand count = 66 (C: 18 + 2 × O: 24). ","signatureChunk":0},{"@id":"lean:QOU.Molecular.CO2Braid.mk","@type":"LeanDeclaration","name":"QOU.Molecular.CO2Braid.mk","kind":"ctor","line":12,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/co2-molecular-braid.lean#L12-L12","signatureChunk":0},{"@id":"lean:QOU.Molecular.CO2Braid","@type":"LeanDeclaration","name":"QOU.Molecular.CO2Braid","kind":"structure","line":6,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/co2-molecular-braid.lean#L6-L20","doc":"**Carbon dioxide CO₂** as a molecular braid with 66 strands.\n\nCarbon with two oxygens, two double bonds.\nLP dual selects linear geometry by placing oxygens on opposite\nsides of carbon to maximize strand distance between repulsive\nproton-proton crossings. ","formalizes":[{"@id":"block:def:co2-molecular-braid","label":"def:co2-molecular-braid","md":"quantum-observable-universe/molecular-construction/co2-molecular-braid.md"}],"signatureChunk":0}]}