{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.BraidKnot.ClassicalRiemannHypothesis","@type":"LeanModule","name":"QOU.BraidKnot.ClassicalRiemannHypothesis","imports":["lean:module:Init","lean:module:Mathlib.NumberTheory.LSeries.RiemannZeta"],"declarations":3,"chunks":1},{"@id":"lean:QOU.BraidKnot.ClassicalRiemannHypothesis.rh","@type":"LeanDeclaration","name":"QOU.BraidKnot.ClassicalRiemannHypothesis.rh","kind":"theorem","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ClassicalRiemannHypothesis.lean#L38-L38","doc":"All non-trivial zeros of `ζ` satisfy `Re s = 1/2`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.ClassicalRiemannHypothesis.mk","@type":"LeanDeclaration","name":"QOU.BraidKnot.ClassicalRiemannHypothesis.mk","kind":"ctor","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ClassicalRiemannHypothesis.lean#L36-L36","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.ClassicalRiemannHypothesis","@type":"LeanDeclaration","name":"QOU.BraidKnot.ClassicalRiemannHypothesis","kind":"class","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ClassicalRiemannHypothesis.lean#L30-L38","doc":"**Conjecture (Riemann, 1859).** Every non-trivial zero `s` of the Riemann\nzeta function lies on the critical line `Re s = 1/2`. \"Non-trivial\" excludes the\ntrivial zeros at the negative even integers `s = -2(n+1)`, `n : ℕ`.\n\n    Conjectural class — see\n    [`conj:classical-riemann-hypothesis`](../../../quantum-observable-universe/stochastic-mechanics/classical-riemann-hypothesis.md). ","formalizes":[{"@id":"block:conj:classical-riemann-hypothesis","label":"conj:classical-riemann-hypothesis","md":"quantum-observable-universe/stochastic-mechanics/classical-riemann-hypothesis.md"}],"signatureChunk":0}]}