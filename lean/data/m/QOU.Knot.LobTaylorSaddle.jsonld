{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Knot.LobTaylorSaddle","@type":"LeanModule","name":"QOU.Knot.LobTaylorSaddle","imports":["lean:module:Init","lean:module:QOU.Archimedean.LobachevskyDerivative","lean:module:QOU.MathlibExt.TaylorRemainder","lean:module:QOU.MathlibExt.TrapezoidRule"],"declarations":7,"chunks":1},{"@id":"lean:QOU.Knot.FigureEightVolume.abs_Lob_taylor_saddle","@type":"LeanDeclaration","name":"QOU.Knot.FigureEightVolume.abs_Lob_taylor_saddle","kind":"theorem","line":113,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/LobTaylorSaddle.lean#L113-L128","doc":"**`Λ` at the saddle.**  The linear term is absent because `Λ′(θ*) = 0`;\nthe quadratic coefficient is `√3/2 = |cot θ*|/2`. ","signatureChunk":0},{"@id":"lean:QOU.Knot.FigureEightVolume.cot_five_pi_div_six","@type":"LeanDeclaration","name":"QOU.Knot.FigureEightVolume.cot_five_pi_div_six","kind":"theorem","line":107,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/LobTaylorSaddle.lean#L107-L111","doc":"`cot(5π/6) = −√3` — the Hessian of the Kashaev exponent, up to `2N/π`. ","signatureChunk":0},{"@id":"lean:QOU.Knot.FigureEightVolume.cos_five_pi_div_six","@type":"LeanDeclaration","name":"QOU.Knot.FigureEightVolume.cos_five_pi_div_six","kind":"theorem","line":102,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/LobTaylorSaddle.lean#L102-L105","doc":"`cos(5π/6) = −√3/2`. ","signatureChunk":0},{"@id":"lean:QOU.Knot.FigureEightVolume.sin_five_pi_div_six","@type":"LeanDeclaration","name":"QOU.Knot.FigureEightVolume.sin_five_pi_div_six","kind":"theorem","line":96,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/LobTaylorSaddle.lean#L96-L100","doc":"`sin(5π/6) = 1/2` — the saddle condition `2 sin θ* = 1`, at the point\n`saddle_forces_cot` singles out in `(π/2, π)`. ","signatureChunk":0},{"@id":"lean:QOU.Knot.FigureEightVolume.abs_Lob_taylor_two","@type":"LeanDeclaration","name":"QOU.Knot.FigureEightVolume.abs_Lob_taylor_two","kind":"theorem","line":61,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/LobTaylorSaddle.lean#L61-L92","doc":"**`Λ` to second order**, with the `O(|θ − θ₀|³)` remainder explicit. ","signatureChunk":0},{"@id":"lean:QOU.Knot.FigureEightVolume.hasDerivAt_Lob_deriv2","@type":"LeanDeclaration","name":"QOU.Knot.FigureEightVolume.hasDerivAt_Lob_deriv2","kind":"theorem","line":51,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/LobTaylorSaddle.lean#L51-L57","doc":"`Λ‴(t) = 1/sin²t` on `(0, π)`. ","signatureChunk":0},{"@id":"lean:QOU.Knot.FigureEightVolume.hasDerivAt_Lob_deriv","@type":"LeanDeclaration","name":"QOU.Knot.FigureEightVolume.hasDerivAt_Lob_deriv","kind":"theorem","line":44,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/LobTaylorSaddle.lean#L44-L49","doc":"`Λ″(t) = −cot t` on `(0, π)`. ","signatureChunk":0}]}