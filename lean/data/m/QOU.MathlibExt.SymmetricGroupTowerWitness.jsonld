OU/MathlibExt/SymmetricGroupTowerWitness.lean#L95-L95","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.SymmetricGroupTowerWitness.s","@type":"LeanDeclaration","name":"QOU.MathlibExt.SymmetricGroupTowerWitness.s","kind":"def","line":92,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/SymmetricGroupTowerWitness.lean#L92-L93","doc":"The `m`-th adjacent transposition. ","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.SymmetricGroupTowerWitness.G","@type":"LeanDeclaration","name":"QOU.MathlibExt.SymmetricGroupTowerWitness.G","kind":"def","line":89,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/SymmetricGroupTowerWitness.lean#L89-L90","doc":"The symmetric group on `ℕ`. Only adjacent transpositions are ever used. ","signatureChunk":0}]}