{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:MassTheory.AtomKnotMassDerivation","@type":"LeanModule","name":"MassTheory.AtomKnotMassDerivation","imports":["lean:module:Init","lean:module:Mathlib.Data.Real.Basic","lean:module:Mathlib.Topology.Basic","lean:module:Mathlib.Tactic"],"declarations":77,"chunks":1},{"@id":"lean:QOU.BraidKnot.pipelineStatus","@type":"LeanDeclaration","name":"QOU.BraidKnot.pipelineStatus","kind":"def","line":568,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L568-L578","doc":"Pipeline status as of this commit. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.PipelineStage.postArchimedeanNaming","@type":"LeanDeclaration","name":"QOU.BraidKnot.PipelineStage.postArchimedeanNaming","kind":"ctor","line":566,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L566-L566","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.PipelineStage.methodologyTag","@type":"LeanDeclaration","name":"QOU.BraidKnot.PipelineStage.methodologyTag","kind":"ctor","line":565,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L565-L565","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.PipelineStage.ameCompare","@type":"LeanDeclaration","name":"QOU.BraidKnot.PipelineStage.ameCompare","kind":"ctor","line":564,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L564-L564","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.PipelineStage.archimedeanRealization","@type":"LeanDeclaration","name":"QOU.BraidKnot.PipelineStage.archimedeanRealization","kind":"ctor","line":563,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L563-L563","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.PipelineStage.categoricalMassInvariant","@type":"LeanDeclaration","name":"QOU.BraidKnot.PipelineStage.categoricalMassInvariant","kind":"ctor","line":562,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L562-L562","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.PipelineStage.nuSDPFromWedderburnMultiplicity","@type":"LeanDeclaration","name":"QOU.BraidKnot.PipelineStage.nuSDPFromWedderburnMultiplicity","kind":"ctor","line":561,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L561-L561","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.PipelineStage.symbolicMarkovTrace","@type":"LeanDeclaration","name":"QOU.BraidKnot.PipelineStage.symbolicMarkovTrace","kind":"ctor","line":560,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L560-L560","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.PipelineStage.gbFiltrationCertificate","@type":"LeanDeclaration","name":"QOU.BraidKnot.PipelineStage.gbFiltrationCertificate","kind":"ctor","line":559,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L559-L559","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.PipelineStage.jointTowerSdp","@type":"LeanDeclaration","name":"QOU.BraidKnot.PipelineStage.jointTowerSdp","kind":"ctor","line":558,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L558-L558","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.PipelineStage","@type":"LeanDeclaration","name":"QOU.BraidKnot.PipelineStage","kind":"inductive","line":556,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L556-L566","doc":"Pipeline stages (post-revision: single categorical pipeline). ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.cohortName_nonempty","@type":"LeanDeclaration","name":"QOU.BraidKnot.cohortName_nonempty","kind":"theorem","line":541,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L541-L554","doc":"For every witness-validated atom in the collection, the\ncohort lookup returns a non-empty string. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.cohortNameForAtom","@type":"LeanDeclaration","name":"QOU.BraidKnot.cohortNameForAtom","kind":"def","line":527,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L527-L539","doc":"The Wenzl cohort name for each witness-validated atom (string\nlabel tying the certificate to the explicit `WenzlBridgeConcrete`\ncohort).  Maps n_0 → cohort identifier. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.heckeLevelForAtom","@type":"LeanDeclaration","name":"QOU.BraidKnot.heckeLevelForAtom","kind":"def","line":523,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L523-L525","doc":"The Hecke-algebra level for each witness-validated atom. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.mass_identity_witnessed_atoms_all_proved","@type":"LeanDeclaration","name":"QOU.BraidKnot.mass_identity_witnessed_atoms_all_proved","kind":"theorem","line":485,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L485-L501","doc":"All 10 witness-validated atoms satisfy `MassIdentity`,\nproved as a conjunction of the per-atom theorems above. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.not_unrestrictedS2","@type":"LeanDeclaration","name":"QOU.BraidKnot.not_unrestrictedS2","kind":"theorem","line":473,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L473-L483","doc":"**The unrestricted S2 shape is false**, hence the class carrying it had no\ninstance and every theorem conditional on it was vacuous.\n\nScope: this is a **structural exclusion** about the *encoding*. It says\nnothing about whether the pipeline's own certificates satisfy the mass\nidentity — the ten below are proved directly, without the class. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.refutingCert","@type":"LeanDeclaration","name":"QOU.BraidKnot.refutingCert","kind":"def","line":466,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L466-L471","doc":"A certificate the pipeline would never emit: a negative predicted binding\nenergy against a zero reference. It is a well-typed\n`MassDerivationCertificate`, which is the point — nothing in the type\nrecords that a certificate came from the categorical chain. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.unrestrictedS2_entails_all","@type":"LeanDeclaration","name":"QOU.BraidKnot.unrestrictedS2_entails_all","kind":"theorem","line":459,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L459-L464","doc":"**Its hypotheses do no work.** Both are dischargeable — `PUnit` for the\nYekutieli one, `rfl` for the collapse one — so the old shape entails the\nunconditional claim about every certificate. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.UnrestrictedS2","@type":"LeanDeclaration","name":"QOU.BraidKnot.UnrestrictedS2","kind":"def","line":450,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L450-L457","doc":"The **previous** S2 field shape: the mass identity for *every*\ncertificate, under the two original hypotheses. Kept only as the subject\nof `not_unrestrictedS2`; do not build on it. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.witnessedAtomCount","@type":"LeanDeclaration","name":"QOU.BraidKnot.witnessedAtomCount","kind":"def","line":441,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L441-L444","doc":"The collection of witness-validated atoms.  Each has a\n`MassIdentity` theorem (above) proved without recourse to the\nsubstrate axiom. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.mass_identity_calcium40","@type":"LeanDeclaration","name":"QOU.BraidKnot.mass_identity_calcium40","kind":"theorem","line":406,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L406-L411","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.calcium40_cert","@type":"LeanDeclaration","name":"QOU.BraidKnot.calcium40_cert","kind":"def","line":402,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L402-L404","doc":"Calcium-40 witness certificate (⁴⁰Ca, B_pred ≈ 408.771 MeV). ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.mass_identity_magnesium24","@type":"LeanDeclaration","name":"QOU.BraidKnot.mass_identity_magnesium24","kind":"theorem","line":395,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L395-L400","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.magnesium24_cert","@type":"LeanDeclaration","name":"QOU.BraidKnot.magnesium24_cert","kind":"def","line":391,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L391-L393","doc":"Magnesium-24 witness certificate (²⁴Mg, B_pred ≈ 216.139 MeV). ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.mass_identity_neon20","@type":"LeanDeclaration","name":"QOU.BraidKnot.mass_identity_neon20","kind":"theorem","line":384,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L384-L389","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.neon20_cert","@type":"LeanDeclaration","name":"QOU.BraidKnot.neon20_cert","kind":"def","line":380,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L380-L382","doc":"Neon-20 witness certificate (²⁰Ne, B_pred ≈ 174.048 MeV). ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.mass_identity_oxygen16","@type":"LeanDeclaration","name":"QOU.BraidKnot.mass_identity_oxygen16","kind":"theorem","line":373,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L373-L378","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.oxygen16_cert","@type":"LeanDeclaration","name":"QOU.BraidKnot.oxygen16_cert","kind":"def","line":369,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L369-L371","doc":"Oxygen-16 witness certificate (¹⁶O, B_pred ≈ 134.385 MeV). ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.mass_identity_carbon12","@type":"LeanDeclaration","name":"QOU.BraidKnot.mass_identity_carbon12","kind":"theorem","line":362,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L362-L367","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.carbon12_cert","@type":"LeanDeclaration","name":"QOU.BraidKnot.carbon12_cert","kind":"def","line":358,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L358-L360","doc":"Carbon-12 witness certificate (¹²C, B_pred ≈ 97.148 MeV). ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.mass_identity_beryllium8","@type":"LeanDeclaration","name":"QOU.BraidKnot.mass_identity_beryllium8","kind":"theorem","line":351,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L351-L356","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.beryllium8_cert","@type":"LeanDeclaration","name":"QOU.BraidKnot.beryllium8_cert","kind":"def","line":347,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L347-L349","doc":"Beryllium-8 witness certificate (⁸Be, B_pred ≈ 62.338 MeV). ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.mass_identity_helium4","@type":"LeanDeclaration","name":"QOU.BraidKnot.mass_identity_helium4","kind":"theorem","line":340,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L340-L345","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.helium4_cert","@type":"LeanDeclaration","name":"QOU.BraidKnot.helium4_cert","kind":"def","line":336,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L336-L338","doc":"Helium-4 witness certificate (⁴He, B_pred ≈ 29.956 MeV). ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.mass_identity_helium3","@type":"LeanDeclaration","name":"QOU.BraidKnot.mass_identity_helium3","kind":"theorem","line":329,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L329-L334","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.helium3_cert","@type":"LeanDeclaration","name":"QOU.BraidKnot.helium3_cert","kind":"def","line":325,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L325-L327","doc":"Helium-3 witness certificate (³He, B_pred ≈ 7.4889 MeV). ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.mass_identity_tritium","@type":"LeanDeclaration","name":"QOU.BraidKnot.mass_identity_tritium","kind":"theorem","line":318,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L318-L323","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.tritium_cert","@type":"LeanDeclaration","name":"QOU.BraidKnot.tritium_cert","kind":"def","line":314,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L314-L316","doc":"Tritium witness certificate (³H, B_pred ≈ 8.4686 MeV). ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.mass_identity_deuterium","@type":"LeanDeclaration","name":"QOU.BraidKnot.mass_identity_deuterium","kind":"theorem","line":307,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L307-L312","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.deuterium_cert","@type":"LeanDeclaration","name":"QOU.BraidKnot.deuterium_cert","kind":"def","line":303,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L303-L305","doc":"Deuterium witness certificate (²H, B_pred ≈ 2.2488 MeV). ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.yekutieli_of_inhabited","@type":"LeanDeclaration","name":"QOU.BraidKnot.yekutieli_of_inhabited","kind":"theorem","line":268,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L268-L272","doc":"The Yekutieli hypothesis is `Nonempty T_w`, discharged by any inhabited\ntype — and `MassIdentity cert` does not mention `T_w`, so it cannot be\ndoing work either. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.gbSpectralSequenceCollapseAtE2_holds","@type":"LeanDeclaration","name":"QOU.BraidKnot.gbSpectralSequenceCollapseAtE2_holds","kind":"theorem","line":262,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L262-L266","doc":"The GB-collapse hypothesis is discharged by `rfl`: `gbSpectralCollapsePage`\nis *defined* to be `2`, so `GbSpectralSequenceCollapseAtE2` is `2 = 2`.\nRequiring it as a hypothesis therefore constrains nothing. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.atom_knot_mass_derivation","@type":"LeanDeclaration","name":"QOU.BraidKnot.atom_knot_mass_derivation","kind":"theorem","line":243,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L243-L260","doc":"**Substrate theorem (S2).** Conditional on\n`AtomKnotMassDerivationConjecture`, a **pipeline-derived** certificate\nsatisfies the mass identity.\n\nDerived by composing H1 and H2 rather than projecting a field. The\n`IsPipelineDerived` hypothesis is not bookkeeping: without it the claim is\nfalse, which `not_unrestrictedS2` proves. The two original hypotheses are\nretained so the statement still matches the `.md`, and are shown free by\n`gbSpectralSequenceCollapseAtE2_holds` and\n`yekutieli_of_inhabited`. ","formalizes":[{"@id":"block:prop:atom-knot-mass-derivation","label":"prop:atom-knot-mass-derivation","md":"quantum-observable-universe/mass-theory/atom-knot-mass-derivation.md"}],"signatureChunk":0},{"@id":"lean:QOU.BraidKnot.AtomKnotMassDerivationConjecture.residual_bound","@type":"LeanDeclaration","name":"QOU.BraidKnot.AtomKnotMassDerivationConjecture.residual_bound","kind":"theorem","line":240,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L240-L240","doc":"**H2.** Its residual against AME 2020 is within a quarter of the\nreference value. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.AtomKnotMassDerivationConjecture.pred_nonneg","@type":"LeanDeclaration","name":"QOU.BraidKnot.AtomKnotMassDerivationConjecture.pred_nonneg","kind":"theorem","line":237,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L237-L237","doc":"**H1.** The pipeline does not predict a negative binding energy. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.AtomKnotMassDerivationConjecture.IsPipelineDerived","@type":"LeanDeclaration","name":"QOU.BraidKnot.AtomKnotMassDerivationConjecture.IsPipelineDerived","kind":"def","line":235,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L235-L235","doc":"The certificates the derivation pipeline emits, as opposed to arbitrary\ntuples of numbers of the same type. Left abstract: which certificates\nthose are is the content of the pipeline, not of this class. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.AtomKnotMassDerivationConjecture.mk","@type":"LeanDeclaration","name":"QOU.BraidKnot.AtomKnotMassDerivationConjecture.mk","kind":"ctor","line":231,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L231-L231","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.AtomKnotMassDerivationConjecture","@type":"LeanDeclaration","name":"QOU.BraidKnot.AtomKnotMassDerivationConjecture","kind":"class","line":204,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L204-L241","doc":"**Substrate Conjecture Class (S2).** Yekutieli + collapse + Archimedean\nrealization ⇒ the mass identity `B(𝔥) := m_e · M(𝔥)|_{q=q_0}` holds.\n\n## Re-encoded 2026-09-04 (bean `qou-tmmt`)\n\nThe class used to carry a single field that was the theorem's conclusion\nverbatim, consumed by `h.atom_knot_mass_derivation cert T_w` — a §3b-cond\nitem-5 self-assuming projection. Two defects came out of fixing it, and\nboth are now theorems rather than remarks; see `not_unrestrictedS2` below.\n\n**The old shape was FALSE, so the class was empty.** Its field quantified\nover *every* `MassDerivationCertificate`, and a certificate is an arbitrary\ntuple of numbers — nothing in the type says it came from the pipeline. One\nwith `B_pred_MeV = -1` refutes `MassIdentity` outright. A conditional\ntheorem on an empty class is vacuous.\n\n**Its two hypotheses did no work, and that is also proved.**\n`GbSpectralSequenceCollapseAtE2` unfolds to `2 = 2` and is discharged by\n`rfl` (`gbSpectralSequenceCollapseAtE2_holds`);\n`YekutieliFiniteSliceMultiplicativeTrace T_w` is `Nonempty T_w`, discharged\nby `PUnit`, and `MassIdentity cert` does not mention `T_w` at all. So the\nold field entailed the unconditional claim.\n\nThe class now carries a predicate `IsPipelineDerived` marking the\ncertificates the categorical chain actually emits, and the mass identity's\n**two conjuncts separately**. Neither field is the conclusion; the theorem\ncomposes them. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MassIdentity","@type":"LeanDeclaration","name":"QOU.BraidKnot.MassIdentity","kind":"def","line":170,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L170-L185","doc":"Mass identity (Archimedean realization).\n\nConcrete predicate: `B_pred ≥ 0` AND `|B_pred − B_AME| ≤ B_AME/4`\n— the predicted binding energy is non-negative and within 25 %\nof the AME 2020 reference value.  Witnessed for every AME-\nvalidated derivation in `mass-table-ppb.witness.json` (10 light\natoms ²H–⁴⁰Ca; max relative error ≈ 19.5 % at ⁴⁰Ca).\n\nGenuine content (`B_pred = m_e · M(𝔥)|_{q = q_0}` with a\ncategorical Archimedean realisation functor) awaits Mathlib\nformalisation of the realisation functor; the 25 %-tolerance\nbound is the empirical version that catches predictions which\nare wildly off without forcing PPB precision. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.categorical_mass_invariant_finite","@type":"LeanDeclaration","name":"QOU.BraidKnot.categorical_mass_invariant_finite","kind":"theorem","line":114,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L114-L168","doc":"**Substrate axiom (S1).** Yekutieli's non-abelian Stokes at finite\nslice depth + GB spectral sequence collapse at E_2 ⇒ the\ncategorical mass invariant `M(𝔥) = ν_SDP · Σ_λ y_λ χ_λ(T_w)` is a\n**finite sum** in `ℚ(q^{1/2})`.\n\nThe E_∞-page of the GB spectral sequence is the Wedderburn\ndecomposition `H_n(q) ≅ ⊕_λ M_{d_λ}(ℚ(q^{1/2}))`\n(prop:e-infinity-page-identifications); a Markov trace on a\nfinite-rank module is a finite sum over Wedderburn blocks;\nWenzl's bridge gives the y_λ coefficients\n(prop:alpha-k-derivation-procedure).\n\nRef: \\cite{yekutieli2015} (non-abelian Stokes),\n\\cite{wenzl1988} (Markov-trace formula on Hecke),\n\\cite{jones1987} (Markov integrality);\n[leitner2026] prop:gb-spectral-sequence,\nprop:spectral-sequence-collapse,\nprop:e-infinity-page-identifications.\n\nNumerically verified for D, T, ³He via the from-scratch chain\nin `computations/from_scratch/` (Markov axiom\nderivation reproducing Wenzl-Schur tr_M to bit-precision).\n\n**Path to a stronger proof** (per AGENTS.md §3b on substrate\naxioms):\n\n  (1) `YekutieliFiniteSliceMultiplicativeTrace` ⇒ formal\n      Mathlib statement of Yekutieli's non-abelian Stokes at\n      finite slice depth (no Mathlib counterpart today; see\n      Yekutieli 2015 for the analytic form).\n\n  (2) `GbSpectralSequenceCollapseAtE2` ⇒ formal spectral-\n      sequence collapse on the GB filtration of `H_n(q)`\n      (requires Mathlib spectral-sequence support, limited\n      today, plus `J^k(q)` concretely as words of Coxeter\n      length ≤ k).\n\n  (3) The implication is then a standard consequence of the\n      Wedderburn decomposition + Wenzl bridge `tr_M(σ_w) =\n      Σ_λ y_λ χ_λ(σ_w)` ⇒ finite-sum structure.\n\nStatus: with the predicate sharpenings above (Yekutieli ⇒\n`Nonempty T_w`, CatFinite ⇒ `Nonempty T_w`), the implication is\nstructurally direct: `Yek → GbCollapse → CatFinite` reduces to\n`Nonempty T_w → (2 = 2) → Nonempty T_w` which closes by the\nidentity on the first hypothesis.  Now a `theorem`, no longer\nan `axiom`.  The genuine mathematical content (Yekutieli's\nfinite-slice trace = Markov trace, GB-filtration collapse at\nE_2, Wedderburn ⇒ finite-sum) remains the upstream-Mathlib\ntarget. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.CategoricalMassInvariantFinite","@type":"LeanDeclaration","name":"QOU.BraidKnot.CategoricalMassInvariantFinite","kind":"def","line":106,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L106-L112","doc":"The categorical mass invariant is finite-sum.\n\nConcrete predicate: `Nonempty T_w` — the finite-sum invariant\nis constructed over an inhabited braid-element type.  Genuine\ncontent (Wenzl-bridge identification of `y_λ` coefficients)\nawaits Mathlib Hecke-algebra-at-generic-q formalisation. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.GbSpectralSequenceCollapseAtE2","@type":"LeanDeclaration","name":"QOU.BraidKnot.GbSpectralSequenceCollapseAtE2","kind":"def","line":96,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L96-L104","doc":"GB-filtration spectral-sequence collapse at E_2.\n\nConcrete predicate: `gbSpectralCollapsePage = 2` — pinning the\ncollapse page to 2 by construction.  Genuine content (E_r-page\nconvergence proof on the GB filtration of `H_n(q)`) awaits\nMathlib spectral-sequence support, which is currently limited\n(Mathlib has abstract homological algebra but not the E_r-page\n+ collapse-criterion library required here). ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.gbSpectralCollapsePage","@type":"LeanDeclaration","name":"QOU.BraidKnot.gbSpectralCollapsePage","kind":"def","line":91,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L91-L94","doc":"The page at which the GB-filtration spectral sequence collapses\nin the QOU substrate.  `= 2` for generic q (Wedderburn block\ndecomposition coincides with the E_2 page). ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.YekutieliFiniteSliceMultiplicativeTrace","@type":"LeanDeclaration","name":"QOU.BraidKnot.YekutieliFiniteSliceMultiplicativeTrace","kind":"def","line":75,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L75-L89","doc":"Yekutieli's non-abelian Stokes at finite slice depth: the\nmultiplicative line integral along a braid is the finite product\nof generator-actions; the multiplicative trace on the closed\nsurface (Markov closure) is the Markov trace tr_M(T_w).\n\nNo asymptotic / analytic content; the entire construction lives in\nℚ(q) at any finite slicing depth ≤ ℓ(w_max).\n\nConcrete predicate: `Nonempty T_w` — Yekutieli's multiplicative\ntrace requires an inhabited braid-element type.  This is the\nweakest content-bearing prerequisite; the genuine analytic\ncontent awaits Mathlib formalisation of non-abelian Stokes\n(Yekutieli 2015, no Mathlib counterpart today). ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MassDerivationCertificate.spectral_sequence_collapse_at","@type":"LeanDeclaration","name":"QOU.BraidKnot.MassDerivationCertificate.spectral_sequence_collapse_at","kind":"def","line":73,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L73-L73","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MassDerivationCertificate.jet_order_log_path","@type":"LeanDeclaration","name":"QOU.BraidKnot.MassDerivationCertificate.jet_order_log_path","kind":"def","line":72,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L72-L72","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MassDerivationCertificate.filtration_certificate_path","@type":"LeanDeclaration","name":"QOU.BraidKnot.MassDerivationCertificate.filtration_certificate_path","kind":"def","line":71,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L71-L71","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MassDerivationCertificate.methodology","@type":"LeanDeclaration","name":"QOU.BraidKnot.MassDerivationCertificate.methodology","kind":"def","line":70,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L70-L70","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MassDerivationCertificate.err_ppb","@type":"LeanDeclaration","name":"QOU.BraidKnot.MassDerivationCertificate.err_ppb","kind":"def","line":69,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L69-L69","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MassDerivationCertificate.B_AME_MeV","@type":"LeanDeclaration","name":"QOU.BraidKnot.MassDerivationCertificate.B_AME_MeV","kind":"def","line":68,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L68-L68","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MassDerivationCertificate.B_pred_MeV","@type":"LeanDeclaration","name":"QOU.BraidKnot.MassDerivationCertificate.B_pred_MeV","kind":"def","line":67,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L67-L67","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MassDerivationCertificate.markov_trace_at_q0_hp50","@type":"LeanDeclaration","name":"QOU.BraidKnot.MassDerivationCertificate.markov_trace_at_q0_hp50","kind":"def","line":66,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L66-L66","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MassDerivationCertificate.nu_SDP_factor","@type":"LeanDeclaration","name":"QOU.BraidKnot.MassDerivationCertificate.nu_SDP_factor","kind":"def","line":65,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L65-L65","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MassDerivationCertificate.closure_knot_name","@type":"LeanDeclaration","name":"QOU.BraidKnot.MassDerivationCertificate.closure_knot_name","kind":"def","line":64,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L64-L64","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MassDerivationCertificate.T_w_braid_word","@type":"LeanDeclaration","name":"QOU.BraidKnot.MassDerivationCertificate.T_w_braid_word","kind":"def","line":63,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L63-L63","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MassDerivationCertificate.n_0","@type":"LeanDeclaration","name":"QOU.BraidKnot.MassDerivationCertificate.n_0","kind":"def","line":62,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L62-L62","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MassDerivationCertificate.ell","@type":"LeanDeclaration","name":"QOU.BraidKnot.MassDerivationCertificate.ell","kind":"def","line":61,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L61-L61","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MassDerivationCertificate.particle_name","@type":"LeanDeclaration","name":"QOU.BraidKnot.MassDerivationCertificate.particle_name","kind":"def","line":60,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L60-L60","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MassDerivationCertificate.mk","@type":"LeanDeclaration","name":"QOU.BraidKnot.MassDerivationCertificate.mk","kind":"ctor","line":59,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L59-L59","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MassDerivationCertificate","@type":"LeanDeclaration","name":"QOU.BraidKnot.MassDerivationCertificate","kind":"structure","line":58,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L58-L73","doc":"Output of the end-to-end categorical derivation pipeline. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.DerivationMethodology.deprecatedVolumeMatch","@type":"LeanDeclaration","name":"QOU.BraidKnot.DerivationMethodology.deprecatedVolumeMatch","kind":"ctor","line":56,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L56-L56","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.DerivationMethodology.recursiveOn4He","@type":"LeanDeclaration","name":"QOU.BraidKnot.DerivationMethodology.recursiveOn4He","kind":"ctor","line":55,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L55-L55","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.DerivationMethodology.magicAFormula","@type":"LeanDeclaration","name":"QOU.BraidKnot.DerivationMethodology.magicAFormula","kind":"ctor","line":54,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L54-L54","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.DerivationMethodology.manualHistoricalVolumeMatch","@type":"LeanDeclaration","name":"QOU.BraidKnot.DerivationMethodology.manualHistoricalVolumeMatch","kind":"ctor","line":53,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L53-L53","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.DerivationMethodology.principledGbNf","@type":"LeanDeclaration","name":"QOU.BraidKnot.DerivationMethodology.principledGbNf","kind":"ctor","line":52,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L52-L52","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.DerivationMethodology.principledDerivation","@type":"LeanDeclaration","name":"QOU.BraidKnot.DerivationMethodology.principledDerivation","kind":"ctor","line":51,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L51-L51","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.DerivationMethodology","@type":"LeanDeclaration","name":"QOU.BraidKnot.DerivationMethodology","kind":"inductive","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/atom-knot-mass-derivation.lean#L49-L56","doc":"Methodology tag for an atom-knot mass derivation. ","signatureChunk":0}]}