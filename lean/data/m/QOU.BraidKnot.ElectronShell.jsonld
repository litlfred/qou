{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.BraidKnot.ElectronShell","@type":"LeanModule","name":"QOU.BraidKnot.ElectronShell","imports":["lean:module:Init","lean:module:QOU.BraidKnot.ConfinedParticle"],"declarations":17,"chunks":1},{"@id":"lean:QOU.BraidKnot.noble_gas_multi_operator","@type":"LeanDeclaration","name":"QOU.BraidKnot.noble_gas_multi_operator","kind":"theorem","line":90,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ElectronShell.lean#L90-L100","doc":"**Multi-operator regime at noble-gas `Z`** (per-instance form).\nBacked by `NobleGasMultiOperator`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.nobleGasMultiOperator_of_fact","@type":"LeanDeclaration","name":"QOU.BraidKnot.nobleGasMultiOperator_of_fact","kind":"instance","line":79,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ElectronShell.lean#L79-L88","doc":"**Default instance from a `Fact` witness on the multiplicity**.\nWhen `Fact (bindingMultiplicity S q ≥ 2)` is in scope (e.g. from\na numerical SDP solver providing the integer witness), the\nNobleGasMultiOperator instance follows directly. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.NobleGasMultiOperator.multi","@type":"LeanDeclaration","name":"QOU.BraidKnot.NobleGasMultiOperator.multi","kind":"theorem","line":77,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ElectronShell.lean#L77-L77","doc":"Binding multiplicity at noble-gas `Z` is at least 2. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.NobleGasMultiOperator.mk","@type":"LeanDeclaration","name":"QOU.BraidKnot.NobleGasMultiOperator.mk","kind":"ctor","line":73,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ElectronShell.lean#L73-L73","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.NobleGasMultiOperator","@type":"LeanDeclaration","name":"QOU.BraidKnot.NobleGasMultiOperator","kind":"class","line":62,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ElectronShell.lean#L62-L77","doc":"**Noble-gas multi-operator regime — typeclass (Pattern 4).**\n\nWitnesses `μ(S, q) ≥ 2` for a *specific* shell `S` whose\nelectron count lies in `nobleGasMagic`. The computational\ncontent is supplied by the `electron-shell-ilp` witnesses\n(alternating-`σ_0⁻¹`/`σ_1⁻¹` packings); a class lets each\ncaller bind to the witness for the specific `(S, q)` it cares\nabout, rather than asserting a universal SDP property. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.nobleGasMagic","@type":"LeanDeclaration","name":"QOU.BraidKnot.nobleGasMagic","kind":"def","line":58,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ElectronShell.lean#L58-L60","doc":"The set of noble-gas electron magic numbers. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.bindingMultiplicity","@type":"LeanDeclaration","name":"QOU.BraidKnot.bindingMultiplicity","kind":"def","line":53,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ElectronShell.lean#L53-L56","doc":"Binding multiplicity accessor, backed by `HasBindingMultiplicity`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.HasBindingMultiplicity.mu","@type":"LeanDeclaration","name":"QOU.BraidKnot.HasBindingMultiplicity.mu","kind":"def","line":51,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ElectronShell.lean#L51-L51","doc":"The multiplicity `μ(S, q)`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.HasBindingMultiplicity.mk","@type":"LeanDeclaration","name":"QOU.BraidKnot.HasBindingMultiplicity.mk","kind":"ctor","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ElectronShell.lean#L49-L49","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.HasBindingMultiplicity","@type":"LeanDeclaration","name":"QOU.BraidKnot.HasBindingMultiplicity","kind":"class","line":43,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ElectronShell.lean#L43-L51","doc":"Binding multiplicity data — class-supplied evaluation of\n`μ(S, q)` (cardinality of the active dual support of the\nconfinement SDP at `q`). `μ = 1` is the single-block regime;\n`μ ≥ 2` is the multi-operator regime that obtains at noble-gas\n`Z ∈ {2, 10, 18, 36, 54, 86}`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.ElectronShell.bindingWord","@type":"LeanDeclaration","name":"QOU.BraidKnot.ElectronShell.bindingWord","kind":"def","line":41,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ElectronShell.lean#L41-L41","doc":"Canonical binding subword as a formal Hecke word in the\ncabled algebra. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.ElectronShell.cabling","@type":"LeanDeclaration","name":"QOU.BraidKnot.ElectronShell.cabling","kind":"theorem","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ElectronShell.lean#L38-L38","doc":"Cabling consistency: `nStrandsTotal = nucleus.coarseStrands + nElectrons`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.ElectronShell.nStrandsTotal","@type":"LeanDeclaration","name":"QOU.BraidKnot.ElectronShell.nStrandsTotal","kind":"def","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ElectronShell.lean#L36-L36","doc":"Total strand count `A + Z` after cabling. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.ElectronShell.nElectrons","@type":"LeanDeclaration","name":"QOU.BraidKnot.ElectronShell.nElectrons","kind":"def","line":34,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ElectronShell.lean#L34-L34","doc":"Number `Z` of electrons in the shell. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.ElectronShell.nucleus","@type":"LeanDeclaration","name":"QOU.BraidKnot.ElectronShell.nucleus","kind":"def","line":32,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ElectronShell.lean#L32-L32","doc":"The nucleus particle the shell is attached to. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.ElectronShell.mk","@type":"LeanDeclaration","name":"QOU.BraidKnot.ElectronShell.mk","kind":"ctor","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ElectronShell.lean#L30-L30","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.ElectronShell","@type":"LeanDeclaration","name":"QOU.BraidKnot.ElectronShell","kind":"structure","line":23,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ElectronShell.lean#L23-L41","doc":"**Electron shell.** Cabled-strand representation: `Z` electrons\nadded as extra strands in `H_{A+Z}(q)` with binding subword\ndrawn from the confinement-SDP active support.\n\nThe `bindingWord` lives in `BraidWord nStrandsTotal` where\n`nStrandsTotal = A + nElectrons`. ","signatureChunk":0}]}