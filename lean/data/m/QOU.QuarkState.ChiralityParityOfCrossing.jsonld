/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuarkState/ChiralityParityOfCrossing.lean#L40-L44","signatureChunk":0},{"@id":"lean:QOU.QuarkState.ChiralityParity.spanElt","@type":"LeanDeclaration","name":"QOU.QuarkState.ChiralityParity.spanElt","kind":"def","line":37,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuarkState/ChiralityParityOfCrossing.lean#L37-L38","doc":"The element `a • s + b • 1`. ","signatureChunk":0},{"@id":"lean:QOU.QuarkState.ChiralityParity.iotaSpan","@type":"LeanDeclaration","name":"QOU.QuarkState.ChiralityParity.iotaSpan","kind":"def","line":34,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuarkState/ChiralityParityOfCrossing.lean#L34-L35","doc":"The chirality swap extended linearly to `span{1, s}`. ","signatureChunk":0}]}