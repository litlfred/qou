daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/CRRealisation.lean#L82-L82","doc":"When `n = 2` (`dim_ℝ H = 4`), the Hodge star on 2-forms restricted to `H`. ","signatureChunk":0},{"@id":"lean:QOU.InstantonConnection.parallelAdjointSections","@type":"LeanDeclaration","name":"QOU.InstantonConnection.parallelAdjointSections","kind":"def","line":80,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/CRRealisation.lean#L80-L80","doc":"The type of covariant-constant sections of `Ad(P)`. ","signatureChunk":0},{"@id":"lean:QOU.InstantonConnection.curvature_H","@type":"LeanDeclaration","name":"QOU.InstantonConnection.curvature_H","kind":"def","line":78,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/CRRealisation.lean#L78-L78","doc":"Curvature `F_A` restricted to `H = ker θ`. ","signatureChunk":0},{"@id":"lean:QOU.InstantonConnection.connectionData","@type":"LeanDeclaration","name":"QOU.InstantonConnection.connectionData","kind":"def","line":76,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/CRRealisation.lean#L76-L76","doc":"Abstract connection data (gauge potential). ","signatureChunk":0},{"@id":"lean:QOU.InstantonConnection.mk","@type":"LeanDeclaration","name":"QOU.InstantonConnection.mk","kind":"ctor","line":74,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/CRRealisation.lean#L74-L74","signatureChunk":0},{"@id":"lean:QOU.InstantonConnection","@type":"LeanDeclaration","name":"QOU.InstantonConnection","kind":"structure","line":71,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/CRRealisation.lean#L71-L88","doc":"**Instanton connection** on a principal bundle `P` over a CR manifold.\n\nLaTeX: `\\label{def:instanton}` ","formalizes":[{"@id":"block:ex:instanton","label":"ex:instanton","md":"quantum-observable-universe/models-of-qous/instanton.md"}],"signatureChunk":0},{"@id":"lean:QOU.CQuantumObservableUniverse.state_sections_vanish","@type":"LeanDeclaration","name":"QOU.CQuantumObservableUniverse.state_sections_vanish","kind":"theorem","line":69,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/CRRealisation.lean#L69-L69","doc":"`Γ_c(M, S)` is trivial. ","signatureChunk":0},{"@id":"lean:QOU.CQuantumObservableUniverse.compactStateSections","@type":"LeanDeclaration","name":"QOU.CQuantumObservableUniverse.compactStateSections","kind":"def","line":67,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/CRRealisation.lean#L67-L67","doc":"The type of compactly supported sections of the state bundle `S`. ","signatureChunk":0},{"@id":"lean:QOU.CQuantumObservableUniverse.adjoint_cohomology_vanishes","@type":"LeanDeclaration","name":"QOU.CQuantumObservableUniverse.adjoint_cohomology_vanishes","kind":"theorem","line":65,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/CRRealisation.lean#L65-L65","doc":"`H⁰(M, Ad(P))` is trivial. ","signatureChunk":0},{"@id":"lean:QOU.CQuantumObservableUniverse.adjointSections","@type":"LeanDeclaration","name":"QOU.CQuantumObservableUniverse.adjointSections","kind":"def","line":63,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/CRRealisation.lean#L63-L63","doc":"The type of global sections of the adjoint bundle `Ad(P)`. ","signatureChunk":0},{"@id":"lean:QOU.CQuantumObservableUniverse.mk","@type":"LeanDeclaration","name":"QOU.CQuantumObservableUniverse.mk","kind":"ctor","line":61,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/CRRealisation.lean#L61-L61","signatureChunk":0},{"@id":"lean:QOU.CQuantumObservableUniverse.toCRManifoldData","@type":"LeanDeclaration","name":"QOU.CQuantumObservableUniverse.toCRManifoldData","kind":"def","line":61,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/CRRealisation.lean#L61-L69","signatureChunk":0},{"@id":"lean:QOU.CQuantumObservableUniverse","@type":"LeanDeclaration","name":"QOU.CQuantumObservableUniverse","kind":"structure","line":57,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/CRRealisation.lean#L57-L69","doc":"**ℂ quantum observable universe**: CR manifold data satisfying the\nvanishing conditions `H⁰(M, Ad(P)) = 0` and `Γ_c(M, E) = 0`.\n\nLaTeX: `\\label{def:c-quantum-observable-universe}` ","formalizes":[{"@id":"block:ex:c-quantum-observable-universe","label":"ex:c-quantum-observable-universe","md":"quantum-observable-universe/quantum-observable-universes/c-quantum-observable-universe.md"}],"signatureChunk":0},{"@id":"lean:QOU.CRManifoldData.reeb_preserves_contact","@type":"LeanDeclaration","name":"QOU.CRManifoldData.reeb_preserves_contact","kind":"theorem","line":55,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/CRRealisation.lean#L55-L55","doc":"The Reeb field preserves the contact form: `θ(ξ(p)) = θ(p)`. ","signatureChunk":0},{"@id":"lean:QOU.CRManifoldData.reebField","@type":"LeanDeclaration","name":"QOU.CRManifoldData.reebField","kind":"def","line":53,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/CRRealisation.lean#L53-L53","doc":"The Reeb vector field `ξ`, characterised by `ι_ξ dθ = 0` and `θ(ξ) = 1`.\n\nContinuous, as `C(M, M)` — also from the siblings. This copy had the bare\nfunction `M → M`, weaker than a vector field on a manifold should be, and\nthe `TopologicalSpace M` instance above was already present to support it.\nNothing in the tree reads this field, so the strengthening breaks no\ncaller. ","signatureChunk":0},{"@id":"lean:QOU.CRManifoldData.contact_nondeg","@type":"LeanDeclaration","name":"QOU.CRManifoldData.contact_nondeg","kind":"theorem","line":45,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/CRRealisation.lean#L45-L45","doc":"**Non-degeneracy**: `θ` does not vanish identically.\n\nTaken from the two co-located siblings, which had it where this copy did\nnot (bean `qou-u87j`). Without it a \"CR manifold\" with `θ ≡ 0` satisfies\nthe structure, and `contactForm` is a contact form in name only. ","signatureChunk":0},{"@id":"lean:QOU.CRManifoldData.contactForm","@type":"LeanDeclaration","name":"QOU.CRManifoldData.contactForm","kind":"def","line":39,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/CRRealisation.lean#L39-L39","doc":"The contact form `θ` represented abstractly as a continuous 1-form. ","signatureChunk":0},{"@id":"lean:QOU.CRManifoldData.rs_sum","@type":"LeanDeclaration","name":"QOU.CRManifoldData.rs_sum","kind":"theorem","line":37,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/CRRealisation.lean#L37-L37","signatureChunk":0},{"@id":"lean:QOU.CRManifoldData.s","@type":"LeanDeclaration","name":"QOU.CRManifoldData.s","kind":"def","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/CRRealisation.lean#L36-L36","signatureChunk":0},{"@id":"lean:QOU.CRManifoldData.r","@type":"LeanDeclaration","name":"QOU.CRManifoldData.r","kind":"def","line":35,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/CRRealisation.lean#L35-L35","doc":"Levi form signature `(r, s)` with `r + s = n`. ","signatureChunk":0},{"@id":"lean:QOU.CRManifoldData.n_pos","@type":"LeanDeclaration","name":"QOU.CRManifoldData.n_pos","kind":"theorem","line":33,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/CRRealisation.lean#L33-L33","signatureChunk":0},{"@id":"lean:QOU.CRManifoldData.n","@type":"LeanDeclaration","name":"QOU.CRManifoldData.n","kind":"def","line":32,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/CRRealisation.lean#L32-L32","doc":"CR dimension `n ≥ 1`; real dimension of `M` is `2n + 1`. ","signatureChunk":0},{"@id":"lean:QOU.CRManifoldData.topM","@type":"LeanDeclaration","name":"QOU.CRManifoldData.topM","kind":"def","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/CRRealisation.lean#L30-L30","signatureChunk":0},{"@id":"lean:QOU.CRManifoldData.M","@type":"LeanDeclaration","name":"QOU.CRManifoldData.M","kind":"def","line":29,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/CRRealisation.lean#L29-L29","doc":"The underlying smooth manifold carrier. ","signatureChunk":0},{"@id":"lean:QOU.CRManifoldData.mk","@type":"LeanDeclaration","name":"QOU.CRManifoldData.mk","kind":"ctor","line":27,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/CRRealisation.lean#L27-L27","signatureChunk":0},{"@id":"lean:QOU.CRManifoldData","@type":"LeanDeclaration","name":"QOU.CRManifoldData","kind":"structure","line":19,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/CRRealisation.lean#L19-L55","doc":"**CR manifold data** for the ℂ realisation.\n\nCanonical 4-tuple `(C, θ, G, S)`: `C = Rep(SU_q(2))` is the monoidal\ncategory; `θ` is the contact form (pseudo-Hermitian structure) on a\nCR manifold `M` (implicit as domain of `θ`); `G = SU(2)`;\n`S = P ×_G CP¹` is the state bundle (principal bundle `P` implicit).\n\nLaTeX: `\\label{def:c-quantum-universe}` ","formalizes":[{"@id":"block:ex:c-quantum-universe","label":"ex:c-quantum-universe","md":"quantum-observable-universe/quantum-observable-universes/c-quantum-universe.md"}],"signatureChunk":0}]}