{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:PredictedSpectra.ModuliSymmetryD4","@type":"LeanModule","name":"PredictedSpectra.ModuliSymmetryD4","imports":["lean:module:Init","lean:module:Mathlib.Data.Real.Basic","lean:module:Mathlib.Data.Complex.Basic","lean:module:Mathlib.Tactic.Ring","lean:module:Mathlib.Tactic.FieldSimp"],"declarations":9,"chunks":1},{"@id":"lean:QOU.Archimedean.ModuliSymmetryD4.moduli_symmetry_d4","@type":"LeanDeclaration","name":"QOU.Archimedean.ModuliSymmetryD4.moduli_symmetry_d4","kind":"theorem","line":93,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/moduli-symmetry-d4.lean#L93-L109","doc":"**Dihedral D₄-action on ℂ×** (Proposition):\n\nσ : q ↦ iq has order dividing 4 (σ⁴ = id), τ : q ↦ q⁻¹ has order\ndividing 2 (τ² = id on ℂ×), and they satisfy the dihedral\ncommutation (στ)² = id.\n\nTogether with σ ≠ id (σ has actual order 4 since I⁴ = 1 and\nI, I², I³ are distinct from 1), τ ≠ id (since q ≠ q⁻¹ for, e.g.,\nq = 2), and σ ≠ τ, this presents D₄ of order 8 acting on ℂ×. ","formalizes":[{"@id":"block:prop:moduli-symmetry-d4","label":"prop:moduli-symmetry-d4","md":"quantum-observable-universe/predicted-spectra/moduli-symmetry-d4.md"}],"signatureChunk":0},{"@id":"lean:QOU.Archimedean.ModuliSymmetryD4.sigma_tau_involution","@type":"LeanDeclaration","name":"QOU.Archimedean.ModuliSymmetryD4.sigma_tau_involution","kind":"theorem","line":72,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/moduli-symmetry-d4.lean#L72-L91","doc":"The composition (σ ∘ τ) is its own inverse: (στ)²(q) = q for nonzero q.\nThis is the dihedral commutation, equivalent to τστ = σ⁻¹. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.ModuliSymmetryD4.I_inv","@type":"LeanDeclaration","name":"QOU.Archimedean.ModuliSymmetryD4.I_inv","kind":"theorem","line":64,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/moduli-symmetry-d4.lean#L64-L70","doc":"σ⁻¹(q) = -i · q (since I⁻¹ = -I). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.ModuliSymmetryD4.tau_ne_zero","@type":"LeanDeclaration","name":"QOU.Archimedean.ModuliSymmetryD4.tau_ne_zero","kind":"theorem","line":58,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/moduli-symmetry-d4.lean#L58-L62","doc":"τ maps nonzero to nonzero. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.ModuliSymmetryD4.sigma_ne_zero","@type":"LeanDeclaration","name":"QOU.Archimedean.ModuliSymmetryD4.sigma_ne_zero","kind":"theorem","line":52,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/moduli-symmetry-d4.lean#L52-L56","doc":"σ maps nonzero to nonzero. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.ModuliSymmetryD4.tau_pow_two","@type":"LeanDeclaration","name":"QOU.Archimedean.ModuliSymmetryD4.tau_pow_two","kind":"theorem","line":46,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/moduli-symmetry-d4.lean#L46-L50","doc":"τ has order dividing 2: τ²(q) = q for nonzero q. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.ModuliSymmetryD4.sigma_pow_four","@type":"LeanDeclaration","name":"QOU.Archimedean.ModuliSymmetryD4.sigma_pow_four","kind":"theorem","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/moduli-symmetry-d4.lean#L36-L44","doc":"σ has order dividing 4: σ⁴(q) = q for every q. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.ModuliSymmetryD4.tau","@type":"LeanDeclaration","name":"QOU.Archimedean.ModuliSymmetryD4.tau","kind":"def","line":33,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/moduli-symmetry-d4.lean#L33-L34","doc":"The bar involution τ : q ↦ q⁻¹. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.ModuliSymmetryD4.sigma","@type":"LeanDeclaration","name":"QOU.Archimedean.ModuliSymmetryD4.sigma","kind":"def","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/moduli-symmetry-d4.lean#L30-L31","doc":"The complex rotation σ : q ↦ iq. ","signatureChunk":0}]}