k: +1 (positive) or -1 (negative). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.instReprFlavor.repr","@type":"LeanDeclaration","name":"QOU.Archimedean.instReprFlavor.repr","kind":"def","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/observations/hopf-diquark.lean#L36-L36","signatureChunk":0},{"@id":"lean:QOU.Archimedean.instReprFlavor","@type":"LeanDeclaration","name":"QOU.Archimedean.instReprFlavor","kind":"instance","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/observations/hopf-diquark.lean#L36-L36","signatureChunk":0},{"@id":"lean:QOU.Archimedean.instDecidableEqFlavor","@type":"LeanDeclaration","name":"QOU.Archimedean.instDecidableEqFlavor","kind":"instance","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/observations/hopf-diquark.lean#L36-L36","signatureChunk":0},{"@id":"lean:QOU.Archimedean.Flavor.strange","@type":"LeanDeclaration","name":"QOU.Archimedean.Flavor.strange","kind":"ctor","line":35,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/observations/hopf-diquark.lean#L35-L35","signatureChunk":0},{"@id":"lean:QOU.Archimedean.Flavor.down","@type":"LeanDeclaration","name":"QOU.Archimedean.Flavor.down","kind":"ctor","line":34,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/observations/hopf-diquark.lean#L34-L34","signatureChunk":0},{"@id":"lean:QOU.Archimedean.Flavor.up","@type":"LeanDeclaration","name":"QOU.Archimedean.Flavor.up","kind":"ctor","line":33,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/observations/hopf-diquark.lean#L33-L33","signatureChunk":0},{"