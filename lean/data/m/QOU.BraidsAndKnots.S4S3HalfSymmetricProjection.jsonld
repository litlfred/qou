{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.BraidsAndKnots.S4S3HalfSymmetricProjection","@type":"LeanModule","name":"QOU.BraidsAndKnots.S4S3HalfSymmetricProjection","imports":["lean:module:Init","lean:module:Mathlib.GroupTheory.Perm.Basic","lean:module:Mathlib.Data.Fintype.Basic","lean:module:Mathlib.Data.Rat.Defs","lean:module:Mathlib.Tactic.NormNum"],"declarations":19,"chunks":1},{"@id":"lean:QOU.BraidsAndKnots.s4_s3_half_symmetric_projection","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.s4_s3_half_symmetric_projection","kind":"theorem","line":81,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/S4S3HalfSymmetricProjection.lean#L81-L88","doc":"Main result: in the half-symmetric part of H_4 at q = 1, the weighted\ndimension is 5, the weighted trivial-S_3 multiplicity is 2, and the\nS_3-trivial share is 2/5.  Branching arithmetic only\n([james1984representation] §2); no per-cell or curvature claim. ","formalizes":[{"@id":"block:prop:s4-s3-half-symmetric-projection","label":"prop:s4-s3-half-symmetric-projection","md":"quantum-observable-universe/mass-theory/s4-s3-half-symmetric-projection.md"}],"signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.effectiveCellCount_eq","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.effectiveCellCount_eq","kind":"theorem","line":76,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/S4S3HalfSymmetricProjection.lean#L76-L79","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.s3TrivialFactor_eq","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.s3TrivialFactor_eq","kind":"theorem","line":72,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/S4S3HalfSymmetricProjection.lean#L72-L74","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.halfSymTrivialS3_eq","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.halfSymTrivialS3_eq","kind":"theorem","line":69,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/S4S3HalfSymmetricProjection.lean#L69-L70","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.halfSymTotalDim_eq","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.halfSymTotalDim_eq","kind":"theorem","line":66,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/S4S3HalfSymmetricProjection.lean#L66-L67","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.effectiveCellCount","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.effectiveCellCount","kind":"def","line":59,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/S4S3HalfSymmetricProjection.lean#L59-L61","doc":"The product (5/2) × (2/5) = 1.  Arithmetic only: 5/2 is the weighted\nnumber of half-symmetric irreducibles.  No geometric meaning is claimed. ","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.s3TrivialFactor","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.s3TrivialFactor","kind":"def","line":56,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/S4S3HalfSymmetricProjection.lean#L56-L57","doc":"The S_3-trivial projection factor. ","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.halfSymTrivialS3","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.halfSymTrivialS3","kind":"def","line":52,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/S4S3HalfSymmetricProjection.lean#L52-L54","doc":"Total trivial-S_3 content in the half-symmetric projection. ","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.halfSymTotalDim","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.halfSymTotalDim","kind":"def","line":48,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/S4S3HalfSymmetricProjection.lean#L48-L50","doc":"Total half-symmetric dimension (weighted sum of dims). ","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.halfSymRepresentatives","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.halfSymRepresentatives","kind":"def","line":40,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/S4S3HalfSymmetricProjection.lean#L40-L46","doc":"Half-symmetric content: one of each conjugate pair + 1/2\nself-conjugate.  We track the representatives and their\ncontribution weights as rationals. ","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.s4Irreps","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.s4Irreps","kind":"def","line":31,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/S4S3HalfSymmetricProjection.lean#L31-L38","doc":"S_4 irrep data (standard; [james1984representation] §2). ","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.instReprS4Irrep","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.instReprS4Irrep","kind":"instance","line":29,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/S4S3HalfSymmetricProjection.lean#L29-L29","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.instReprS4Irrep.repr","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.instReprS4Irrep.repr","kind":"def","line":29,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/S4S3HalfSymmetricProjection.lean#L29-L29","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.S4Irrep.trivialS3Content","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.S4Irrep.trivialS3Content","kind":"def","line":28,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/S4S3HalfSymmetricProjection.lean#L28-L28","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.S4Irrep.conjugateLabel","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.S4Irrep.conjugateLabel","kind":"def","line":27,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/S4S3HalfSymmetricProjection.lean#L27-L27","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.S4Irrep.dim","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.S4Irrep.dim","kind":"def","line":26,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/S4S3HalfSymmetricProjection.lean#L26-L26","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.S4Irrep.label","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.S4Irrep.label","kind":"def","line":25,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/S4S3HalfSymmetricProjection.lean#L25-L25","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.S4Irrep.mk","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.S4Irrep.mk","kind":"ctor","line":24,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/S4S3HalfSymmetricProjection.lean#L24-L24","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.S4Irrep","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.S4Irrep","kind":"structure","line":20,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/S4S3HalfSymmetricProjection.lean#L20-L29","doc":"The five irreducible representations of S_4, indexed by\npartitions of 4.  We encode only the data needed for the\nbranching rule: classical dimension and trivial-S_3 content\nunder restriction. ","signatureChunk":0}]}