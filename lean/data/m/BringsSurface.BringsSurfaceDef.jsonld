{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:BringsSurface.BringsSurfaceDef","@type":"LeanModule","name":"BringsSurface.BringsSurfaceDef","imports":["lean:module:Init","lean:module:Mathlib.Data.Real.Basic","lean:module:Mathlib.Data.Int.Basic"],"declarations":16,"chunks":1},{"@id":"lean:QOU.Brings.brings_is_curve","@type":"LeanDeclaration","name":"QOU.Brings.brings_is_curve","kind":"theorem","line":78,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/brings-surface-def.lean#L78-L82","doc":"The dimension of the curve: ambient_dim − num_equations − 1 = 1. ","signatureChunk":0},{"@id":"lean:QOU.Brings.hurwitz_bound_genus_4","@type":"LeanDeclaration","name":"QOU.Brings.hurwitz_bound_genus_4","kind":"theorem","line":72,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/brings-surface-def.lean#L72-L76","doc":"Hurwitz bound for genus 4: 84(g−1) = 252.\nBring's surface achieves the maximal automorphism group for genus 4\nwith |Aut| = 120 ≤ 252. ","signatureChunk":0},{"@id":"lean:QOU.Brings.standardBringsSurface","@type":"LeanDeclaration","name":"QOU.Brings.standardBringsSurface","kind":"def","line":60,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/brings-surface-def.lean#L60-L70","doc":"The canonical instance of Bring's surface. ","signatureChunk":0},{"@id":"lean:QOU.Brings.euler_char_formula","@type":"LeanDeclaration","name":"QOU.Brings.euler_char_formula","kind":"theorem","line":53,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/brings-surface-def.lean#L53-L58","doc":"The Euler characteristic of any genus-g surface equals 2 − 2g. ","signatureChunk":0},{"@id":"lean:QOU.Brings.brings_euler_char","@type":"LeanDeclaration","name":"QOU.Brings.brings_euler_char","kind":"theorem","line":47,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/brings-surface-def.lean#L47-L51","doc":"**Euler characteristic of Bring's surface**: χ(Σ₄) = 2 − 2·4 = −6. ","signatureChunk":0},{"@id":"lean:QOU.Brings.eulerCharacteristic","@type":"LeanDeclaration","name":"QOU.Brings.eulerCharacteristic","kind":"def","line":43,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/brings-surface-def.lean#L43-L45","doc":"Euler characteristic of a genus-g surface: χ = 2 − 2g. ","signatureChunk":0},{"@id":"lean:QOU.Brings.BringsSurface.num_equations_eq","@type":"LeanDeclaration","name":"QOU.Brings.BringsSurface.num_equations_eq","kind":"theorem","line":41,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/brings-surface-def.lean#L41-L41","doc":"Three power-sum equations cut out the curve. ","signatureChunk":0},{"@id":"lean:QOU.Brings.BringsSurface.num_equations","@type":"LeanDeclaration","name":"QOU.Brings.BringsSurface.num_equations","kind":"def","line":39,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/brings-surface-def.lean#L39-L39","doc":"Number of defining equations (power sums p₁, p₂, p₃). ","signatureChunk":0},{"@id":"lean:QOU.Brings.BringsSurface.ambient_dim_eq","@type":"LeanDeclaration","name":"QOU.Brings.BringsSurface.ambient_dim_eq","kind":"theorem","line":37,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/brings-surface-def.lean#L37-L37","doc":"The ambient projective space is P⁴, so 5 coordinates. ","signatureChunk":0},{"@id":"lean:QOU.Brings.BringsSurface.ambient_dim","@type":"LeanDeclaration","name":"QOU.Brings.BringsSurface.ambient_dim","kind":"def","line":35,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/brings-surface-def.lean#L35-L35","doc":"Number of homogeneous coordinates (embedding in P⁴). ","signatureChunk":0},{"@id":"lean:QOU.Brings.BringsSurface.aut_eq","@type":"LeanDeclaration","name":"QOU.Brings.BringsSurface.aut_eq","kind":"theorem","line":33,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/brings-surface-def.lean#L33-L33","doc":"|Aut(Σ₄)| = 120 ≅ |S₅|. ","signatureChunk":0},{"@id":"lean:QOU.Brings.BringsSurface.automorphism_order","@type":"LeanDeclaration","name":"QOU.Brings.BringsSurface.automorphism_order","kind":"def","line":31,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/brings-surface-def.lean#L31-L31","doc":"Number of automorphisms |Aut(Σ₄)|. ","signatureChunk":0},{"@id":"lean:QOU.Brings.BringsSurface.genus_eq","@type":"LeanDeclaration","name":"QOU.Brings.BringsSurface.genus_eq","kind":"theorem","line":29,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/brings-surface-def.lean#L29-L29","doc":"genus = 4 for Bring's surface. ","signatureChunk":0},{"@id":"lean:QOU.Brings.BringsSurface.genus","@type":"LeanDeclaration","name":"QOU.Brings.BringsSurface.genus","kind":"def","line":27,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/brings-surface-def.lean#L27-L27","doc":"Genus of the surface. ","signatureChunk":0},{"@id":"lean:QOU.Brings.BringsSurface.mk","@type":"LeanDeclaration","name":"QOU.Brings.BringsSurface.mk","kind":"ctor","line":25,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/brings-surface-def.lean#L25-L25","signatureChunk":0},{"@id":"lean:QOU.Brings.BringsSurface","@type":"LeanDeclaration","name":"QOU.Brings.BringsSurface","kind":"structure","line":17,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/brings-surface-def.lean#L17-L41","doc":"**Bring's surface data**: a genus-4 algebraic curve defined by vanishing\nof the first three power sums in P⁴.\n\nOver an algebraically closed field K ⊇ R, Σ₄ is a smooth projective\ncurve with Aut(Σ₄) ≅ S₅ (120 automorphisms) and Euler characteristic\nχ(Σ₄) = 2 − 2g = −6.\n\nRef: [edge1978] https://doi.org/10.1017/S0305004100055699 ","signatureChunk":0}]}