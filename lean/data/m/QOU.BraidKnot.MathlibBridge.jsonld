{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.BraidKnot.MathlibBridge","@type":"LeanModule","name":"QOU.BraidKnot.MathlibBridge","imports":["lean:module:Init","lean:module:Mathlib.Combinatorics.Young.YoungDiagram","lean:module:QOU.BraidKnot.ShellNeutrality"],"declarations":11,"chunks":1},{"@id":"lean:QOU.BraidKnot.MathlibBridge.fromMathlib_kappa_zero_iff_transpose_eq","@type":"LeanDeclaration","name":"QOU.BraidKnot.MathlibBridge.fromMathlib_kappa_zero_iff_transpose_eq","kind":"theorem","line":121,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/MathlibBridge.lean#L121-L129","doc":"**Full iff via the bridge axioms.** ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MathlibBridge.ReverseBridge.transpose_eq_of_fromMathlib_kappa_zero","@type":"LeanDeclaration","name":"QOU.BraidKnot.MathlibBridge.ReverseBridge.transpose_eq_of_fromMathlib_kappa_zero","kind":"theorem","line":117,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/MathlibBridge.lean#L117-L117","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MathlibBridge.ReverseBridge.mk","@type":"LeanDeclaration","name":"QOU.BraidKnot.MathlibBridge.ReverseBridge.mk","kind":"ctor","line":116,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/MathlibBridge.lean#L116-L116","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MathlibBridge.ReverseBridge","@type":"LeanDeclaration","name":"QOU.BraidKnot.MathlibBridge.ReverseBridge","kind":"class","line":116,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/MathlibBridge.lean#L116-L119","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MathlibBridge.fromMathlib_kappa_zero_of_transpose_eq","@type":"LeanDeclaration","name":"QOU.BraidKnot.MathlibBridge.fromMathlib_kappa_zero_of_transpose_eq","kind":"theorem","line":85,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/MathlibBridge.lean#L85-L95","doc":"**Forward direction (proved, conditional on the bridge axiom).**\nIf `Y.transpose = Y`, then the bridged diagram has zero charge.\nCombines the bridge axiom with the abstract proved theorem\n`kappa_zero_of_self_conjugate`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MathlibBridge.TransposeBridge.fromMathlib_self_conj_of_transpose_eq","@type":"LeanDeclaration","name":"QOU.BraidKnot.MathlibBridge.TransposeBridge.fromMathlib_self_conj_of_transpose_eq","kind":"theorem","line":81,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/MathlibBridge.lean#L81-L81","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MathlibBridge.TransposeBridge.mk","@type":"LeanDeclaration","name":"QOU.BraidKnot.MathlibBridge.TransposeBridge.mk","kind":"ctor","line":80,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/MathlibBridge.lean#L80-L80","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MathlibBridge.TransposeBridge","@type":"LeanDeclaration","name":"QOU.BraidKnot.MathlibBridge.TransposeBridge","kind":"class","line":70,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/MathlibBridge.lean#L70-L83","doc":"**Bridge axiom (typeclass field).** If a Mathlib Young diagram is\nfixed by `transpose`, then its bridge image is self-conjugate in\nthe abstract Multiset model.\n\nProvable from `YoungDiagram.transpose_cells` (Mathlib): the cell\nset of the transpose is the swap-image of the original cell set,\nso the multiset of contents under `c ↦ c.2 - c.1` is invariant\nunder negation. Exposed here as a typeclass field so downstream\napplications can use it without depending on the proof\nconstruction. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MathlibBridge.fromMathlib_contents","@type":"LeanDeclaration","name":"QOU.BraidKnot.MathlibBridge.fromMathlib_contents","kind":"theorem","line":62,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/MathlibBridge.lean#L62-L66","doc":"The bridged contents multiset is the cells multiset under the\ncontent map. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MathlibBridge.fromMathlib_n","@type":"LeanDeclaration","name":"QOU.BraidKnot.MathlibBridge.fromMathlib_n","kind":"theorem","line":58,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/MathlibBridge.lean#L58-L60","doc":"Cardinality of the bridged diagram equals the Mathlib cell count. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MathlibBridge.fromMathlib","@type":"LeanDeclaration","name":"QOU.BraidKnot.MathlibBridge.fromMathlib","kind":"def","line":45,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/MathlibBridge.lean#L45-L56","doc":"Build the abstract `QOU.YoungDiagram` from a Mathlib `YoungDiagram`\nby extracting the multiset of contents `c.2 - c.1`. The data field\n`n` is the cardinality of the Mathlib cell set. ","signatureChunk":0}]}