tum-observable-universe/lean/QOU/GaugeFieldFluidDynamics.lean#L113-L116","doc":"Re_q → ∞ as q → 1: the denominator vanishes. ","signatureChunk":0},{"@id":"lean:QOU.GaugeFieldFluidDynamics.planckReynolds_pos","@type":"LeanDeclaration","name":"QOU.GaugeFieldFluidDynamics.planckReynolds_pos","kind":"theorem","line":106,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/GaugeFieldFluidDynamics.lean#L106-L111","doc":"Re_q > 0 when q > 1. ","signatureChunk":0},{"@id":"lean:QOU.GaugeFieldFluidDynamics.planckReynoldsNumber","@type":"LeanDeclaration","name":"QOU.GaugeFieldFluidDynamics.planckReynoldsNumber","kind":"def","line":101,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/GaugeFieldFluidDynamics.lean#L101-L104","doc":"Re_q = 2/(q-1). ","signatureChunk":0},{"@id":"lean:QOU.GaugeFieldFluidDynamics.quantumPlanckConstant_pos","@type":"LeanDeclaration","name":"QOU.GaugeFieldFluidDynamics.quantumPlanckConstant_pos","kind":"theorem","line":89,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/GaugeFieldFluidDynamics.lean#L89-L95","doc":"ℏ_q > 0 when q > 1. ","signatureChunk":0},{"@id":"lean:QOU.GaugeFieldFluidDynamics.BraneFluidData.viscosity_monotone","@type":"LeanDeclaration","name":"QOU.GaugeFieldFluidDynamics.BraneFluidData.viscosity_monotone","kind":"theorem","line":86,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/GaugeFieldFluidDynamics.lean#L86-L86","signatureChunk":0},{"@id":"lean:QOU.GaugeFieldFluidDynamics.BraneFluidData.viscosity_nonneg","@type":"LeanDeclaration","name":"QOU.GaugeFieldFluidDynamics.BraneFluidData.viscosity_nonneg","kind":"theorem","line":85,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/GaugeFieldFluidDynamics.lean#L85-L85","signatureChunk":0},{"@id":"lean:QOU.GaugeFieldFluidDynamics.BraneFluidData.viscosity","@type":"LeanDeclaration","name":"QOU.GaugeFieldFluidDynamics.BraneFluidData.viscosity","kind":"def","line":84,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/GaugeFieldFluidDynamics.lean#L84-L84","signatureChunk":0},{"@id":"lean:QOU.GaugeFieldFluidDynamics.BraneFluidData.substrate","@type":"LeanDeclaration","name":"QOU.GaugeFieldFluidDynamics.BraneFluidData.substrate","kind":"def","line":83,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/GaugeFieldFluidDynamics.lean#L83-L83","signatureChunk":0},{"@id":"lean:QOU.GaugeFieldFluidDynamics.BraneFluidData.mk","@type":"LeanDeclaration","name":"QOU.GaugeFieldFluidDynamics.BraneFluidData.mk","kind":"ctor","line":82,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/GaugeFieldFluidDynamics.lean#L82-L82","signatureChunk":0},{"@id":"lean:QOU.GaugeFieldFluidDynamics.BraneFluidData","@type":"LeanDeclaration","name":"QOU.GaugeFieldFluidDynamics.BraneFluidData","kind":"structure","line":81,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/GaugeFieldFluidDynamics.lean#L81-L87","doc":"Brane fluid: viscosity determined by substrate parameter. ","signatureChunk":0},{"@id":"lean:QOU.GaugeFieldFluidDynamics.markovParameter_pos","@type":"LeanDeclaration","name":"QOU.GaugeFieldFluidDynamics.markovParameter_pos","kind":"theorem","line":68,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/GaugeFieldFluidDynamics.lean#L68-L75","doc":"Markov parameter is positive when `s > 0` (so in particular\nwhen the underlying `q > 0` and `s = q^{1/2}`). ","signatureChunk":0},{"@id":"lean:QOU.GaugeFieldFluidDynamics.markovParameter","@type":"LeanDeclaration","name":"QOU.GaugeFieldFluidDynamics.markovParameter","kind":"def","line":62,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/GaugeFieldFluidDynamics.lean#L62-L66","doc":"The Markov parameter `z = 1/(q^{1/2} + q^{-1/2})` — but we\nparametrise by the substituted variable `s := q^{1/2}` so the\nresult is purely rational arithmetic.  The Jones-Markov trace\nobeys `tr_M(σ_w) = z^{ℓ(w)}` for trivial-NF braids. ","signatureChunk":0},{"@id":"lean:QOU.GaugeFieldFluidDynamics.qInteger_ne_zero","@type":"LeanDeclaration","name":"QOU.GaugeFieldFluidDynamics.qInteger_ne_zero","kind":"theorem","line":57,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/GaugeFieldFluidDynamics.lean#L57-L60","doc":"`[k]_q ≠ 0` for `k ≥ 1` and `q > 1`. ","signatureChunk":0},{"@id":"lean:QOU.GaugeFieldFluidDynamics.qInteger_sq_pos","@type":"LeanDeclaration","name":"QOU.GaugeFieldFluidDynamics.qInteger_sq_pos","kind":"theorem","line":52,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/GaugeFieldFluidDynamics.lean#L52-L55","doc":"[k]_q² > 0 for k ≥ 1 and q > 1. ","signatureChunk":0},{"@id":"lean:QOU.GaugeFieldFluidDynamics.qInteger_pos","@type":"LeanDeclaration","name":"QOU.GaugeFieldFluidDynamics.qInteger_pos","kind":"theorem","line":43,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/GaugeFieldFluidDynamics.lean#L43-L50","doc":"[k]_q > 0 for k ≥ 1 and q > 1. ","signatureChunk":0},{"@id":"lean:QOU.GaugeFieldFluidDynamics.pow_gt_inv_pow","@type":"LeanDeclaration","name":"QOU.GaugeFieldFluidDynamics.pow_gt_inv_pow","kind":"theorem","line":29,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/GaugeFieldFluidDynamics.lean#L29-L41","doc":"q^k > q^{-k} when q > 1 and k ≥ 1. ","signatureChunk":0}]}