{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.BraidKnot.LNaturalOptimality","@type":"LeanModule","name":"QOU.BraidKnot.LNaturalOptimality","imports":["lean:module:Init","lean:module:Mathlib.Algebra.Order.BigOperators.Group.Finset","lean:module:Mathlib.Tactic.Linarith"],"declarations":16,"chunks":1},{"@id":"lean:QOU.BraidKnot.LNaturalOptimality.global_of_local_boxDiffDomain","@type":"LeanDeclaration","name":"QOU.BraidKnot.LNaturalOptimality.global_of_local_boxDiffDomain","kind":"theorem","line":201,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/LNaturalOptimality.lean#L201-L210","doc":"**The L♮ optimality criterion on a box-plus-difference domain**, with domain midpoint closure\ndischarged automatically by `boxDiffDomain_midpoint_closed`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.LNaturalOptimality.boxDiffDomain_midpoint_closed","@type":"LeanDeclaration","name":"QOU.BraidKnot.LNaturalOptimality.boxDiffDomain_midpoint_closed","kind":"theorem","line":195,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/LNaturalOptimality.lean#L195-L199","doc":"Combined midpoint-closure witness for `boxDiffDomain`, ready to feed `global_of_local`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.LNaturalOptimality.floorMid_mem_boxDiffDomain","@type":"LeanDeclaration","name":"QOU.BraidKnot.LNaturalOptimality.floorMid_mem_boxDiffDomain","kind":"theorem","line":180,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/LNaturalOptimality.lean#L180-L192","doc":"The lower midpoint `⌊(x+y)/2⌋` preserves all box and pairwise-difference bounds. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.LNaturalOptimality.ceilMid_mem_boxDiffDomain","@type":"LeanDeclaration","name":"QOU.BraidKnot.LNaturalOptimality.ceilMid_mem_boxDiffDomain","kind":"theorem","line":165,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/LNaturalOptimality.lean#L165-L177","doc":"The upper midpoint `⌈(x+y)/2⌉` preserves all box and pairwise-difference bounds. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.LNaturalOptimality.boxDiffDomain","@type":"LeanDeclaration","name":"QOU.BraidKnot.LNaturalOptimality.boxDiffDomain","kind":"def","line":159,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/LNaturalOptimality.lean#L159-L162","doc":"The standard L♮-convex integer domain defined by coordinatewise box bounds `lo ≤ u ≤ hi` and\npairwise difference bounds `u i - u j ≤ c i j`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.LNaturalOptimality.global_of_local","@type":"LeanDeclaration","name":"QOU.BraidKnot.LNaturalOptimality.global_of_local","kind":"theorem","line":118,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/LNaturalOptimality.lean#L118-L150","doc":"**The L♮ optimality criterion, local ⟹ global, from midpoint concavity.**\n\n`D` is the effective domain.  Hypotheses: `g` is discretely midpoint concave on `D` (and `D` is\nclosed under both midpoints); `x ∈ D` admits no improving move `x + χ_S` or `x − χ_S` inside `D`.\nConclusion: `x` maximises `g` on `D`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.LNaturalOptimality.exists_near","@type":"LeanDeclaration","name":"QOU.BraidKnot.LNaturalOptimality.exists_near","kind":"theorem","line":108,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/LNaturalOptimality.lean#L108-L114","doc":"Every point is `Near` some distance: the `ℓ¹` distance bounds every coordinate. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.LNaturalOptimality.near_mono","@type":"LeanDeclaration","name":"QOU.BraidKnot.LNaturalOptimality.near_mono","kind":"theorem","line":104,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/LNaturalOptimality.lean#L104-L105","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.LNaturalOptimality.floorMid_near","@type":"LeanDeclaration","name":"QOU.BraidKnot.LNaturalOptimality.floorMid_near","kind":"theorem","line":94,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/LNaturalOptimality.lean#L94-L101","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.LNaturalOptimality.ceilMid_near","@type":"LeanDeclaration","name":"QOU.BraidKnot.LNaturalOptimality.ceilMid_near","kind":"theorem","line":84,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/LNaturalOptimality.lean#L84-L91","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.LNaturalOptimality.floorMid_of_near","@type":"LeanDeclaration","name":"QOU.BraidKnot.LNaturalOptimality.floorMid_of_near","kind":"theorem","line":75,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/LNaturalOptimality.lean#L75-L81","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.LNaturalOptimality.ceilMid_of_near","@type":"LeanDeclaration","name":"QOU.BraidKnot.LNaturalOptimality.ceilMid_of_near","kind":"theorem","line":67,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/LNaturalOptimality.lean#L67-L73","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.LNaturalOptimality.Near","@type":"LeanDeclaration","name":"QOU.BraidKnot.LNaturalOptimality.Near","kind":"def","line":64,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/LNaturalOptimality.lean#L64-L65","doc":"`x` is within `d` of `y` in every coordinate. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.LNaturalOptimality.chi","@type":"LeanDeclaration","name":"QOU.BraidKnot.LNaturalOptimality.chi","kind":"def","line":61,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/LNaturalOptimality.lean#L61-L62","doc":"The indicator vector `χ_S`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.LNaturalOptimality.floorMid","@type":"LeanDeclaration","name":"QOU.BraidKnot.LNaturalOptimality.floorMid","kind":"def","line":58,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/LNaturalOptimality.lean#L58-L59","doc":"The lower midpoint `⌊(x+y)/2⌋`, coordinatewise. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.LNaturalOptimality.ceilMid","@type":"LeanDeclaration","name":"QOU.BraidKnot.LNaturalOptimality.ceilMid","kind":"def","line":55,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/LNaturalOptimality.lean#L55-L56","doc":"The upper midpoint `⌈(x+y)/2⌉`, coordinatewise. ","signatureChunk":0}]}