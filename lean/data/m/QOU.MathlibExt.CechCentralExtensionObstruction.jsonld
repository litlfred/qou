ub.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/CechCentralExtensionObstruction.lean#L68-L72","signatureChunk":0},{"@id":"lean:QOU.CentralExtension.cechObstruction","@type":"LeanDeclaration","name":"QOU.CentralExtension.cechObstruction","kind":"def","line":63,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/CechCentralExtensionObstruction.lean#L63-L66","doc":"The Čech obstruction `c i j k`, the unique element of `A` with\n`inl (c i j k) = x i j * x j k * (x i k)⁻¹`. ","signatureChunk":0},{"@id":"lean:QOU.CentralExtension.rightHom_cech_defect","@type":"LeanDeclaration","name":"QOU.CentralExtension.rightHom_cech_defect","kind":"theorem","line":59,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/CechCentralExtensionObstruction.lean#L59-L61","signatureChunk":0},{"@id":"lean:QOU.CentralExtension.IsCechCocycle","@type":"LeanDeclaration","name":"QOU.CentralExtension.IsCechCocycle","kind":"def","line":51,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/CechCentralExtensionObstruction.lean#L51-L53","doc":"A Čech 1-cocycle on the index set `I` with values in a group. ","signatureChunk":0}]}