{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Mass.LagrangianKZIdentification","@type":"LeanModule","name":"QOU.Mass.LagrangianKZIdentification","imports":["lean:module:Init","lean:module:Mathlib.Tactic","lean:module:Mathlib.Algebra.Polynomial.Roots","lean:module:Mathlib.LinearAlgebra.Dual.Lemmas","lean:module:Mathlib.Data.Matrix.Basic","lean:module:Mathlib.RingTheory.MvPolynomial.Basic","lean:module:Mathlib.Algebra.MvPolynomial.Polynomial"],"declarations":42,"chunks":1},{"@id":"lean:QOU.Mass.LagrangianKZ.gauge_equiv_kz_iff_monodromy","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.gauge_equiv_kz_iff_monodromy","kind":"theorem","line":598,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L598-L602","doc":"A flat regular-singular connection is KZ up to gauge iff its monodromy is conjugate to the\nKZ monodromy (by Drinfeld–Kohno, the `R`-matrix representation; sibling thread A4). ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.RiemannHilbertInput.rh","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.RiemannHilbertInput.rh","kind":"theorem","line":596,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L596-L596","doc":"Riemann–Hilbert: gauge class ↔ monodromy class. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.RiemannHilbertInput.conj","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.RiemannHilbertInput.conj","kind":"def","line":594,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L594-L594","doc":"Conjugacy of representations. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.RiemannHilbertInput.monodromy","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.RiemannHilbertInput.monodromy","kind":"def","line":592,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L592-L592","doc":"Monodromy representation of the pure braid group. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.RiemannHilbertInput.gaugeEquiv","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.RiemannHilbertInput.gaugeEquiv","kind":"def","line":590,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L590-L590","doc":"Holomorphic gauge equivalence on `Conf_n`. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.RiemannHilbertInput.mk","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.RiemannHilbertInput.mk","kind":"ctor","line":588,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L588-L588","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.RiemannHilbertInput","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.RiemannHilbertInput","kind":"structure","line":585,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L585-L596","doc":"**The one analytic proposition.** For a class `Conn` of regular-singular flat connections\non `Conf_n` with fibre `V^{⊗n}`, gauge equivalence is detected by monodromy up to conjugacy\n(Deligne's Riemann–Hilbert correspondence). Carried as data, never proved here. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.eval_const_of_dilation_invariant","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.eval_const_of_dilation_invariant","kind":"theorem","line":566,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L566-L579","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.eval_aeval_line","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.eval_aeval_line","kind":"theorem","line":556,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L556-L563","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.arnoldForm_split","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.arnoldForm_split","kind":"theorem","line":538,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L538-L543","doc":"With pair residues `α + β S_{ij}`, the Arnold form is an abelian part plus a KZ form. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.schurWeyl_two","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.schurWeyl_two","kind":"theorem","line":451,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L451-L530","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.coprod_weight","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.coprod_weight","kind":"theorem","line":441,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L441-L449","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.coprod_rel","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.coprod_rel","kind":"theorem","line":432,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L432-L439","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.swapM","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.swapM","kind":"def","line":428,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L428-L430","doc":"The flip `P : u ⊗ v ↦ v ⊗ u`. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.coprodE","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.coprodE","kind":"def","line":423,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L423-L426","doc":"The diagonal action of `E_{ab}` on `V ⊗ V`, `V = K^N`, as a matrix on `Fin N × Fin N`. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.arnold_euler","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.arnold_euler","kind":"theorem","line":395,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L395-L405","doc":"**Euler contraction.** At a configuration with distinct coordinates, contracting with the\nEuler field `E = Σ z_m ∂_m` gives the constant `½ Σ_{i ≠ j} M_{ij}` (symmetric `M`). ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.const_gauge_iff","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.const_gauge_iff","kind":"theorem","line":380,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L380-L393","doc":"**KZ up to constant gauge.** `g` carries `ω_M` to `ω_N` on all of `Conf_n` iff\n`N_{ij} = g M_{ij} g⁻¹` for every `i ≠ j`. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.arnoldForm_conj","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.arnoldForm_conj","kind":"theorem","line":374,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L374-L378","doc":"A constant gauge transformation conjugates the residues. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.eq_kz_iff","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.eq_kz_iff","kind":"theorem","line":361,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L361-L372","doc":"**Identification.** An Arnold-class form equals the KZ form on all of `Conf_n` iff its\noff-diagonal residues are `ℏ Ω_{ij}`. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.arnoldForm_single","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.arnoldForm_single","kind":"theorem","line":351,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L351-L359","doc":"Coefficients of `dz_m` are read off the form by `u = e_m`. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.arnoldForm_congr_offDiag","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.arnoldForm_congr_offDiag","kind":"theorem","line":343,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L343-L349","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.kzForm","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.kzForm","kind":"def","line":339,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L339-L341","doc":"The KZ form with coupling `ℏ` and pair Casimirs `Ω`. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.arnoldCoeff_injective","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.arnoldCoeff_injective","kind":"theorem","line":294,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L294-L337","doc":"**Residues determine an Arnold-class form.** If `ω_M` and `ω_N` have the same\n`dz_m`-coefficients at every configuration with distinct coordinates, then `M_{mj} = N_{mj}` for\nall `m ≠ j`. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.arnoldForm_eq_half_dlog","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.arnoldForm_eq_half_dlog","kind":"theorem","line":270,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L270-L292","doc":"For symmetric `M`, `ω_M = ½ Σ_{i,j} M_{ij} d log(z_i − z_j)`, the sibling file's\n`Σ_{i<j} ω_{ij} M_{ij}`. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.arnoldForm","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.arnoldForm","kind":"def","line":266,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L266-L268","doc":"The Arnold-class form `ω_M(z)(u) = Σ_m u_m f_m(z)`. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.arnoldCoeff","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.arnoldCoeff","kind":"def","line":261,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L261-L264","doc":"The coefficient of `dz_m` in the Arnold-class form with residues `M`:\n`f_m(z) = Σ_j (z_m − z_j)⁻¹ M_{mj}` (the `j = m` term is `0⁻¹ M_{mm} = 0`). ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.partialFraction_unique_module","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.partialFraction_unique_module","kind":"theorem","line":243,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L243-L253","doc":"Module-valued partial-fraction uniqueness, for a vector space `M`. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.partialFraction_unique","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.partialFraction_unique","kind":"theorem","line":201,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L201-L241","doc":"**Partial-fraction uniqueness.** Over an infinite field, if `Σ_{j ∈ s} c_j / (t − p_j)`\nvanishes for every `t` outside the finite set `p(s)`, and `p` is injective on `s`, then every\n`c_j = 0`. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.dirac_eq_zero_iff","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.dirac_eq_zero_iff","kind":"theorem","line":185,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L185-L189","doc":"**`𝒟 s = 0 ↔ ∇ s = 0`** at every point: the Dirac operator and the connection have the\nsame flat sections. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.dirac_left_inverse","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.dirac_left_inverse","kind":"theorem","line":176,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L176-L183","doc":"The inverse of `𝒟`'s reweighting has weights `(q, 1 − q)`. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.dirac_transverse","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.dirac_transverse","kind":"theorem","line":171,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L171-L174","doc":"Transverse directions are scaled by `q⁻¹`. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.dirac_reeb","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.dirac_reeb","kind":"theorem","line":166,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L166-L169","doc":"`(𝒟 s)(ξ) = (∇ s)(ξ)`: the Dirac operator does not reweight the Reeb direction. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.dirac","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.dirac","kind":"def","line":162,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L162-L164","doc":"The Dirac reweighting: weights `q⁻¹` and `ℏ_q = 1 − q⁻¹`. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.reweight_comp_fibre","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.reweight_comp_fibre","kind":"theorem","line":155,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L155-L160","doc":"The reweighting acts by scalars on the fibre, so it commutes with every fibre map `f`.\nIn particular it commutes with the total `𝔰𝔩₂` (isospin): `𝒟` cannot split what `∇` does not. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.reweight_sum_eq_one_of_reeb","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.reweight_sum_eq_one_of_reeb","kind":"theorem","line":147,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L147-L153","doc":"If some `φ` has a nonzero Reeb component and `P_{a,b}` preserves Reeb components, then\n`a + b = 1`: the convex-pair condition is forced. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.reweight_eq_zero_iff","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.reweight_eq_zero_iff","kind":"theorem","line":133,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L133-L145","doc":"`P_{a,b}` is injective when `a ≠ 0` and `a + b ≠ 0`. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.reweight_one_zero","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.reweight_one_zero","kind":"theorem","line":129,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L129-L131","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.reweight_comp","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.reweight_comp","kind":"theorem","line":121,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L121-L127","doc":"Composition of reweightings. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.reweight_transverse","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.reweight_transverse","kind":"theorem","line":116,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L116-L119","doc":"Transverse components (`η u = 0`) are scaled by `a`. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.reweight_reeb","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.reweight_reeb","kind":"theorem","line":111,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L111-L114","doc":"The Reeb component is scaled by `a + b`. ","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.reweight_apply","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.reweight_apply","kind":"theorem","line":107,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L107-L109","signatureChunk":0},{"@id":"lean:QOU.Mass.LagrangianKZ.reweight","@type":"LeanDeclaration","name":"QOU.Mass.LagrangianKZ.reweight","kind":"def","line":103,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/LagrangianKZIdentification.lean#L103-L105","doc":"The reweighting `P_{a,b}(φ)(u) = a φ(u) + b η(u) φ(ξ)` of a fibre-valued covector `φ`. ","signatureChunk":0}]}