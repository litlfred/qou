reChunk":0},{"@id":"lean:QOU.Organic.MolecularHopfChain.length_ge","@type":"LeanDeclaration","name":"QOU.Organic.MolecularHopfChain.length_ge","kind":"theorem","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/organic-chemistry/molecular-hopf-chain.lean#L38-L38","doc":"At least 2 atoms. ","signatureChunk":0},{"@id":"lean:QOU.Organic.MolecularHopfChain.length","@type":"LeanDeclaration","name":"QOU.Organic.MolecularHopfChain.length","kind":"def","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/organic-chemistry/molecular-hopf-chain.lean#L36-L36","doc":"Number of atoms in the chain. ","signatureChunk":0},{"@id":"lean:QOU.Organic.MolecularHopfChain.mk","@type":"LeanDeclaration","name":"QOU.Organic.MolecularHopfChain.mk","kind":"ctor","line":34,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/organic-chemistry/molecular-hopf-chain.lean#L34-L34","signatureChunk":0},{"@id":"lean:QOU.Organic.MolecularHopfChain","@type":"LeanDeclaration","name":"QOU.Organic.MolecularHopfChain","kind":"structure","line":32,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/organic-chemistry/molecular-hopf-chain.lean#L32-L40","doc":"A molecular Hopf chain: N atoms bonded pairwise in a line. ","formalizes":[{"@id":"block:def:molecular-hopf-chain","label":"def:molecular-hopf-chain","md":"quantum-observable-universe/organic-chemistry/molecular-hopf-chain.md"}],"signatureChunk":0},{"@id":"lean:QOU.Organic.CovalentBond.order_le","@type":"LeanDeclaration","name":"QOU.Organic.CovalentBond.order_le","kind":"theorem","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/organic-chemistry/molecular-hopf-