atureChunk":0},{"@id":"lean:QOU.ElectronShellsHopf.NobleGasClosureHolds","@type":"LeanDeclaration","name":"QOU.ElectronShellsHopf.NobleGasClosureHolds","kind":"opaque","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/electron-shells-hopf.lean#L30-L33","doc":"**Noble-gas closure claim**: atoms whose electron cloud is a\nunion of closed sub-Hopf links are exactly the noble gases\n(He, Ne, Ar, Kr, Xe, Rn, Og). ","signatureChunk":0},{"@id":"lean:QOU.ElectronShellsHopf.ShellCapacity2nSquaredHolds","@type":"LeanDeclaration","name":"QOU.ElectronShellsHopf.ShellCapacity2nSquaredHolds","kind":"opaque","line":26,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/electron-shells-hopf.lean#L26-L28","doc":"**Shell-capacity claim**: the maximal closed sub-Hopf link\nat linking level `n` consists of exactly `2n²` trefoils. ","signatureChunk":0}]}