{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Eightfold.Sym2GateFSTrichotomy","@type":"LeanModule","name":"QOU.Eightfold.Sym2GateFSTrichotomy","imports":["lean:module:Init","lean:module:Mathlib.Tactic","lean:module:Mathlib.Data.Nat.Choose.Basic"],"declarations":32,"chunks":1},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.gate_does_not_separate_two_triples","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.gate_does_not_separate_two_triples","kind":"theorem","line":276,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L276-L283","doc":"**The gate is blind to the distinction.**  Two distinct three-dimensional\nobjects, both passing the `Sym²` gate.  Whatever separates a flavour triple\nfrom a colour triple, it is not this gate — so item 4's conclusion does not\nfollow from its premise, and no strengthening of the premise will rescue it. ","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.tripleB_passes","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.tripleB_passes","kind":"theorem","line":273,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L273-L274","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.tripleA_passes","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.tripleA_passes","kind":"theorem","line":270,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L270-L271","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.tripleB_dim","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.tripleB_dim","kind":"theorem","line":268,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L268-L268","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.tripleA_dim","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.tripleA_dim","kind":"theorem","line":267,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L267-L267","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.dualB","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.dualB","kind":"def","line":265,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L265-L265","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.dB","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.dB","kind":"def","line":264,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L264-L264","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.mB","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.mB","kind":"def","line":263,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L263-L263","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.fsB","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.fsB","kind":"def","line":260,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L260-L262","doc":"Second triple: irrep `2`, complex, conjugate `3` absent.  A different\nobject — a different index, a different conjugation. ","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.dualA","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.dualA","kind":"def","line":258,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L258-L258","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.dA","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.dA","kind":"def","line":257,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L257-L257","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.mA","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.mA","kind":"def","line":256,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L256-L256","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.fsA","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.fsA","kind":"def","line":254,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L254-L255","doc":"First triple: irrep `0`, complex, conjugate `1` absent. ","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.even_dimOf_of_selfDual","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.even_dimOf_of_selfDual","kind":"theorem","line":216,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L216-L229","doc":"The self-dual sector in this language: with no complex type present, the\nconclusion of `Sym2GateMultiplicity.even_dimOfMult_of_gate` is recovered. ","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.real_triple_fails_gate","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.real_triple_fails_gate","kind":"theorem","line":207,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L207-L214","doc":"**The chapter's comparison, as a corollary.**  A real-type triple — the\nicosahedral `T₁`, a rotation representation of `A₅ ⊂ SO(3)` — cannot pass the\ngate at any multiplicity, because passing already forces its multiplicity to\nzero.  No appeal to the icosahedron is needed; only its Frobenius–Schur type. ","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.gate_forces_complex_of_dim_three","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.gate_forces_complex_of_dim_three","kind":"theorem","line":189,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L189-L205","doc":"**The theorem.**  A three-dimensional object that passes the `Sym²` gate\nmust contain a complex-type irrep.\n\nReal and quaternionic constructions are excluded *as a class*: the real\nmultiplicities are forced to zero and the quaternionic dimensions are even, so\nthe total is even and cannot be `3`.  Complex type is not one way among several\nto reach dimension three through this gate — it is the only way. ","formalizes":[{"@id":"block:prop:color-su3-from-g2","label":"prop:color-su3-from-g2","md":"quantum-observable-universe/eightfold-way/color-su3-from-g2.md"}],"signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.two_dvd_dimOf_of_no_complex","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.two_dvd_dimOf_of_no_complex","kind":"theorem","line":172,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L172-L187","doc":"Every dimension term is even, provided no complex-type irrep occurs: the\nreal terms vanish outright and the quaternionic ones carry an even factor. ","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.quaternionic_mult_le_one_of_passes","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.quaternionic_mult_le_one_of_passes","kind":"theorem","line":159,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L159-L168","doc":"Passing forces every quaternionic-type multiplicity to be at most one: two\ncopies of a symplectic irrep pair to a singlet in `Sym²`. ","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.real_mult_eq_zero_of_passes","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.real_mult_eq_zero_of_passes","kind":"theorem","line":148,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L148-L157","doc":"Passing forces every real-type multiplicity to vanish: a real irrep carries\na symmetric invariant form, so a single copy already contributes a singlet. ","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.QuaternionicEvenDim","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.QuaternionicEvenDim","kind":"def","line":141,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L141-L144","doc":"A quaternionic irrep has even dimension — it is an `ℍ`-module.  Standard;\ncarried explicitly so the theorem names what it uses. ","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.Passes","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.Passes","kind":"def","line":135,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L135-L137","doc":"**The gate**: `Sym²(W)` carries no singlet. ","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.dimOf","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.dimOf","kind":"def","line":132,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L132-L133","doc":"`dim W = Σ mᵢ dᵢ`. ","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.sym2Singlets","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.sym2Singlets","kind":"def","line":121,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L121-L130","doc":"Singlets of `Sym²(W)` for `W ≅ ⨁ mᵢ Vᵢ`, counted per Frobenius–Schur type.\n\n**This is the model**, cited not derived — see the module docstring.  For the\ncomplex entries `m i * m (dual i)` counts ordered pairings, so it double-counts\neach conjugate pair; only its vanishing is used, which is unaffected. ","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.instDecidableSelfDual","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.instDecidableSelfDual","kind":"instance","line":116,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L116-L117","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.FSType.SelfDual","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.FSType.SelfDual","kind":"def","line":109,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L109-L114","doc":"Self-dual types: those admitting an invariant bilinear form on `Vᵢ` itself.\nExactly the two the companion `Sym2GateMultiplicity` models. ","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.instReprFSType","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.instReprFSType","kind":"instance","line":107,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L107-L107","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.instReprFSType.repr","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.instReprFSType.repr","kind":"def","line":107,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L107-L107","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.instDecidableEqFSType","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.instDecidableEqFSType","kind":"instance","line":107,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L107-L107","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.FSType.complex","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.FSType.complex","kind":"ctor","line":106,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L106-L106","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.FSType.quaternionic","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.FSType.quaternionic","kind":"ctor","line":105,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L105-L105","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.FSType.real","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.FSType.real","kind":"ctor","line":104,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L104-L104","signatureChunk":0},{"@id":"lean:QOU.Eightfold.Sym2GateFSTrichotomy.FSType","@type":"LeanDeclaration","name":"QOU.Eightfold.Sym2GateFSTrichotomy.FSType","kind":"inductive","line":102,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Eightfold/Sym2GateFSTrichotomy.lean#L102-L107","doc":"Frobenius–Schur type of an irreducible representation. ","signatureChunk":0}]}