{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Mathlib.SchenstedRowRightInverse","@type":"LeanModule","name":"QOU.Mathlib.SchenstedRowRightInverse","imports":["lean:module:Init","lean:module:QOU.Mathlib.SchenstedReverseRow"],"declarations":2,"chunks":1},{"@id":"lean:QOU.Mathlib.Schensted.rowInsert_rowUninsert","@type":"LeanDeclaration","name":"QOU.Mathlib.Schensted.rowInsert_rowUninsert","kind":"theorem","line":62,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SchenstedRowRightInverse.lean#L62-L103","doc":"**The other inversion law.** Re-inserting the displaced value into the reverse-inserted row\nrecovers the original row, and bumps back the value that was pushed in.\n\nThis is the mirror of `rowUninsert_rowInsert`: brick 1 undid an insertion, this redoes an undoing.\n","signatureChunk":0},{"@id":"lean:QOU.Mathlib.Schensted.mem_of_rowUninsert_some","@type":"LeanDeclaration","name":"QOU.Mathlib.Schensted.mem_of_rowUninsert_some","kind":"theorem","line":43,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SchenstedRowRightInverse.lean#L43-L60","doc":"The value a reverse insertion displaces is one of the row's entries. ","signatureChunk":0}]}