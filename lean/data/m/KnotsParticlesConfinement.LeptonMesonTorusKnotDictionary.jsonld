{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:KnotsParticlesConfinement.LeptonMesonTorusKnotDictionary","@type":"LeanModule","name":"KnotsParticlesConfinement.LeptonMesonTorusKnotDictionary","imports":["lean:module:Init","lean:module:Mathlib.Tactic.FinCases","lean:module:Mathlib.Tactic"],"declarations":4,"chunks":1},{"@id":"lean:QOU.ParticleInteractions.meson_crossing_is_sum","@type":"LeanDeclaration","name":"QOU.ParticleInteractions.meson_crossing_is_sum","kind":"theorem","line":37,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/lepton-meson-torus-knot-dictionary.lean#L37-L42","doc":"Meson crossing count = sum of two torus-knot indices. ","signatureChunk":0},{"@id":"lean:QOU.ParticleInteractions.lepton_meson_crossing_match","@type":"LeanDeclaration","name":"QOU.ParticleInteractions.lepton_meson_crossing_match","kind":"theorem","line":31,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/lepton-meson-torus-knot-dictionary.lean#L31-L35","doc":"The lepton torus-knot index equals the first quark's crossing\ncount in the corresponding meson generation. ","formalizes":[{"@id":"block:prop:lepton-meson-torus-knot-dictionary","label":"prop:lepton-meson-torus-knot-dictionary","md":"quantum-observable-universe/knots-particles-confinement/lepton-meson-torus-knot-dictionary.md"}],"signatureChunk":0},{"@id":"lean:QOU.ParticleInteractions.mesonCrossingCount","@type":"LeanDeclaration","name":"QOU.ParticleInteractions.mesonCrossingCount","kind":"def","line":24,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/lepton-meson-torus-knot-dictionary.lean#L24-L29","doc":"Meson crossing count: the total crossings in the meson braid\nword = n₁ + n₂ where n₁, n₂ are the quark torus-knot indices. ","signatureChunk":0},{"@id":"lean:QOU.ParticleInteractions.leptonTorusKnotIndex","@type":"LeanDeclaration","name":"QOU.ParticleInteractions.leptonTorusKnotIndex","kind":"def","line":17,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/lepton-meson-torus-knot-dictionary.lean#L17-L22","doc":"Lepton generation index: odd primes 3, 5, 7 indexing the torus\nknot T(2, n) for electron, muon, tau respectively. ","signatureChunk":0}]}