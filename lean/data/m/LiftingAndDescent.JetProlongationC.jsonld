{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:LiftingAndDescent.JetProlongationC","@type":"LeanModule","name":"LiftingAndDescent.JetProlongationC","imports":["lean:module:Init","lean:module:Mathlib.Data.Real.Basic","lean:module:Mathlib.Geometry.Manifold.IsManifold.Basic","lean:module:Mathlib.Topology.Basic"],"declarations":16,"chunks":1},{"@id":"lean:QOU.Torsion.jet_prolongation_C_iterable","@type":"LeanDeclaration","name":"QOU.Torsion.jet_prolongation_C_iterable","kind":"theorem","line":65,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/jet-prolongation-C.lean#L65-L74","doc":"The jet prolongation can be iterated: if jp₂.input = jp₁.output,\nthe composite yields valid QOU data at the second brane level. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.JetProlongationC.dim_formula","@type":"LeanDeclaration","name":"QOU.Torsion.JetProlongationC.dim_formula","kind":"theorem","line":62,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/jet-prolongation-C.lean#L62-L62","doc":"The new dimension: dim(J¹E) = dim(M) + dim(fibre) + dim(M) · dim(fibre). ","signatureChunk":0},{"@id":"lean:QOU.Torsion.JetProlongationC.gauge_preserved","@type":"LeanDeclaration","name":"QOU.Torsion.JetProlongationC.gauge_preserved","kind":"theorem","line":60,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/jet-prolongation-C.lean#L60-L60","doc":"The gauge group is preserved. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.JetProlongationC.base_is_total","@type":"LeanDeclaration","name":"QOU.Torsion.JetProlongationC.base_is_total","kind":"theorem","line":58,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/jet-prolongation-C.lean#L58-L58","doc":"The new base manifold is the total space of the input. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.JetProlongationC.output","@type":"LeanDeclaration","name":"QOU.Torsion.JetProlongationC.output","kind":"def","line":56,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/jet-prolongation-C.lean#L56-L56","doc":"The output archimedean QOU data (after jet prolongation). ","signatureChunk":0},{"@id":"lean:QOU.Torsion.JetProlongationC.input","@type":"LeanDeclaration","name":"QOU.Torsion.JetProlongationC.input","kind":"def","line":54,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/jet-prolongation-C.lean#L54-L54","doc":"The input archimedean QOU data. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.JetProlongationC.mk","@type":"LeanDeclaration","name":"QOU.Torsion.JetProlongationC.mk","kind":"ctor","line":52,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/jet-prolongation-C.lean#L52-L52","signatureChunk":0},{"@id":"lean:QOU.Torsion.JetProlongationC","@type":"LeanDeclaration","name":"QOU.Torsion.JetProlongationC","kind":"structure","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/jet-prolongation-C.lean#L42-L63","doc":"**Jet prolongation in the archimedean setting**.\n\nGiven archimedean QOU data `(C, θ, G, S)` with instanton connection\n`A` and metric `g`, the jet prolongation produces new archimedean\nQOU data `(C, θ̃, G, S')` where:\n- `M̃ = S` (the total space becomes the new base)\n- `P'` is the frame bundle of `J¹S`\n- `E'` is the bundle of orthonormal frames\n- `A'` is the unique connection determined by `A` and `g` ","signatureChunk":0},{"@id":"lean:QOU.Torsion.ArchimedeanQOUData.fibreDim","@type":"LeanDeclaration","name":"QOU.Torsion.ArchimedeanQOUData.fibreDim","kind":"def","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/jet-prolongation-C.lean#L38-L38","doc":"Fibre dimension. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.ArchimedeanQOUData.baseDim","@type":"LeanDeclaration","name":"QOU.Torsion.ArchimedeanQOUData.baseDim","kind":"def","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/jet-prolongation-C.lean#L36-L36","doc":"Dimension of the base manifold. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.ArchimedeanQOUData.TotalSpaceType","@type":"LeanDeclaration","name":"QOU.Torsion.ArchimedeanQOUData.TotalSpaceType","kind":"def","line":34,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/jet-prolongation-C.lean#L34-L34","doc":"The total space S (state bundle over M). ","signatureChunk":0},{"@id":"lean:QOU.Torsion.ArchimedeanQOUData.gaugeGroup","@type":"LeanDeclaration","name":"QOU.Torsion.ArchimedeanQOUData.gaugeGroup","kind":"def","line":32,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/jet-prolongation-C.lean#L32-L32","doc":"The gauge group is a group. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.ArchimedeanQOUData.GaugeGroupType","@type":"LeanDeclaration","name":"QOU.Torsion.ArchimedeanQOUData.GaugeGroupType","kind":"def","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/jet-prolongation-C.lean#L30-L30","doc":"The gauge group G. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.ArchimedeanQOUData.ManifoldType","@type":"LeanDeclaration","name":"QOU.Torsion.ArchimedeanQOUData.ManifoldType","kind":"def","line":28,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/jet-prolongation-C.lean#L28-L28","doc":"The base manifold M. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.ArchimedeanQOUData.mk","@type":"LeanDeclaration","name":"QOU.Torsion.ArchimedeanQOUData.mk","kind":"ctor","line":26,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/jet-prolongation-C.lean#L26-L26","signatureChunk":0},{"@id":"lean:QOU.Torsion.ArchimedeanQOUData","@type":"LeanDeclaration","name":"QOU.Torsion.ArchimedeanQOUData","kind":"structure","line":23,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/jet-prolongation-C.lean#L23-L38","doc":"**Archimedean QOU data**: the differential-geometric data of\n`(C, θ, G, S)` in the archimedean realisation. ","signatureChunk":0}]}