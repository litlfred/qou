{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QuantumObservableUniverses.SpinLabelsSu2","@type":"LeanModule","name":"QuantumObservableUniverses.SpinLabelsSu2","imports":["lean:module:Init","lean:module:Mathlib.Data.Nat.Basic"],"declarations":13,"chunks":1},{"@id":"lean:QOU.Examples.su2_tensor_square","@type":"LeanDeclaration","name":"QOU.Examples.su2_tensor_square","kind":"theorem","line":66,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/spin-labels-su2.lean#L66-L70","doc":"The Clebsch–Gordan rule: V_{1/2} ⊗ V_{1/2} ≅ V₀ ⊕ V₁,\nso dim(V ⊗ V) = dim V₀ + dim V₁ = 1 + 3 = 4 = 2². ","signatureChunk":0},{"@id":"lean:QOU.Examples.su2_dim_spin_two","@type":"LeanDeclaration","name":"QOU.Examples.su2_dim_spin_two","kind":"theorem","line":63,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/spin-labels-su2.lean#L63-L64","doc":"V₂ has dimension 5. ","signatureChunk":0},{"@id":"lean:QOU.Examples.su2_dim_spin_three_halves","@type":"LeanDeclaration","name":"QOU.Examples.su2_dim_spin_three_halves","kind":"theorem","line":60,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/spin-labels-su2.lean#L60-L61","doc":"V_{3/2} has dimension 4. ","signatureChunk":0},{"@id":"lean:QOU.Examples.su2_dim_adjoint","@type":"LeanDeclaration","name":"QOU.Examples.su2_dim_adjoint","kind":"theorem","line":57,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/spin-labels-su2.lean#L57-L58","doc":"V₁ (adjoint) has dimension 3. ","signatureChunk":0},{"@id":"lean:QOU.Examples.su2_dim_fundamental","@type":"LeanDeclaration","name":"QOU.Examples.su2_dim_fundamental","kind":"theorem","line":54,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/spin-labels-su2.lean#L54-L55","doc":"V_{1/2} (fundamental) has dimension 2. ","signatureChunk":0},{"@id":"lean:QOU.Examples.su2_dim_trivial","@type":"LeanDeclaration","name":"QOU.Examples.su2_dim_trivial","kind":"theorem","line":51,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/spin-labels-su2.lean#L51-L52","doc":"V₀ (trivial) has dimension 1. ","signatureChunk":0},{"@id":"lean:QOU.Examples.su2SpinLabels","@type":"LeanDeclaration","name":"QOU.Examples.su2SpinLabels","kind":"def","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/spin-labels-su2.lean#L42-L49","doc":"The SU(2) spin label data. ","formalizes":[{"@id":"block:ex:spin-labels-su2","label":"ex:spin-labels-su2","md":"quantum-observable-universe/quantum-observable-universes/spin-labels-su2.md"}],"signatureChunk":0},{"@id":"lean:QOU.Examples.SU2SpinLabels.completely_reducible","@type":"LeanDeclaration","name":"QOU.Examples.SU2SpinLabels.completely_reducible","kind":"theorem","line":40,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/spin-labels-su2.lean#L40-L40","doc":"Complete reducibility: every finite-dim rep decomposes.\nWitnessed by the Clebsch–Gordan rule:\nV_{1/2} ⊗ V_{1/2} ≅ V₀ ⊕ V₁, so dim(V⊗V) = dim(V₀) + dim(V₁). ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2SpinLabels.tensorSquareDim","@type":"LeanDeclaration","name":"QOU.Examples.SU2SpinLabels.tensorSquareDim","kind":"def","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/spin-labels-su2.lean#L36-L36","doc":"Dimension of the tensor square V_{1/2} ⊗ V_{1/2}. ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2SpinLabels.dim_formula","@type":"LeanDeclaration","name":"QOU.Examples.SU2SpinLabels.dim_formula","kind":"theorem","line":34,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/spin-labels-su2.lean#L34-L34","doc":"dim V_j = 2j + 1 = twice_j + 1. ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2SpinLabels.dim","@type":"LeanDeclaration","name":"QOU.Examples.SU2SpinLabels.dim","kind":"def","line":32,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/spin-labels-su2.lean#L32-L32","doc":"Dimension of V_j, given twice_j (so j = twice_j/2). ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2SpinLabels.mk","@type":"LeanDeclaration","name":"QOU.Examples.SU2SpinLabels.mk","kind":"ctor","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/spin-labels-su2.lean#L30-L30","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2SpinLabels","@type":"LeanDeclaration","name":"QOU.Examples.SU2SpinLabels","kind":"structure","line":26,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/spin-labels-su2.lean#L26-L40","doc":"**SU(2) spin labels**: concrete dimensions of low-spin representations.\n\nLaTeX: `\\label{ex:spin-labels-su2}` ","signatureChunk":0}]}