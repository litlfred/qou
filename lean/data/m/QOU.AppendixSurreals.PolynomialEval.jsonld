{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.AppendixSurreals.PolynomialEval","@type":"LeanModule","name":"QOU.AppendixSurreals.PolynomialEval","imports":["lean:module:Init","lean:module:QOU.AppendixSurreals.Basic","lean:module:QOU.AppendixSurreals.StandardPart","lean:module:QOU.AppendixSurreals.Blowup","lean:module:Mathlib.Algebra.Polynomial.Eval.Defs","lean:module:Mathlib.Algebra.Polynomial.Basic","lean:module:Mathlib.Algebra.MvPolynomial.CommRing"],"declarations":43,"chunks":1},{"@id":"lean:QOU.AppendixSurreals.polySubstrateEval_isClose_iff","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.polySubstrateEval_isClose_iff","kind":"theorem","line":590,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L590-L603","doc":"**Substrate-level proximity classification.**  Two polynomial\nsubstrate-evaluations are `IsClose` iff their classical values at\n`1` coincide.  This is the cleanest \"two surreal predictions agree\nat the standard-part level iff they agree on the archimedean\nbenchmark\" statement. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.polySubstrateEval_eq_aeval","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.polySubstrateEval_eq_aeval","kind":"theorem","line":583,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L583-L588","doc":"Substrate evaluation as Mathlib's `aeval` at the substrate point. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.polySubstrateEval_isFinite","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.polySubstrateEval_isFinite","kind":"theorem","line":577,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L577-L581","doc":"The polynomial substrate evaluation is finite. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.mvPolySurrealEval_eq_aeval","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.mvPolySurrealEval_eq_aeval","kind":"theorem","line":565,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L565-L573","doc":"**Multivariate aeval bridge.**  The multivariate surreal\nevaluation agrees with Mathlib's canonical `MvPolynomial.aeval`,\nvia the `Algebra ℝ K` instance. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.mvPolySubstrateEval","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.mvPolySubstrateEval","kind":"def","line":558,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L558-L563","doc":"**Multivariate substrate evaluator.**  Lifts a multivariate real\npolynomial in the substrate fluctuation variables to a `K`-value\nat the all-substrate point. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.mvSubstratePoint","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.mvSubstratePoint","kind":"def","line":551,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L551-L556","doc":"The **multivariate substrate point**: every coordinate is the\nsubstrate parameter `q := 1 + ε`.  This is the canonical point at\nwhich to evaluate substrate-physics formulas with multiple\nfluctuation parameters. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.mvPolySurrealEval","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.mvPolySurrealEval","kind":"def","line":546,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L546-L549","doc":"Convenience function form of `mvPolySurrealEvalHom`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.mvPolySurrealEvalHom","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.mvPolySurrealEvalHom","kind":"def","line":539,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L539-L544","doc":"**Multivariate polynomial surreal evaluator** as a ring hom.\nSends `p : MvPolynomial σ ℝ` to its `K`-valuation at the surreal\npoint `g : σ → K`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.substrateQ_ne_one","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.substrateQ_ne_one","kind":"theorem","line":519,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L519-L526","doc":"`substrateQ ≠ 1`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.substrateQ_isFinite'","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.substrateQ_isFinite'","kind":"theorem","line":515,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L515-L517","doc":"`substrateQ` is finite. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.standardPart_substrateQ_sub_one","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.standardPart_substrateQ_sub_one","kind":"theorem","line":508,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L508-L513","doc":"Standard-part of `substrateQ - 1` is `0` (the offset between\nsurreal substrate and archimedean unit). ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.substrateQ_pow_sub_one_isInfinitesimal","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.substrateQ_pow_sub_one_isInfinitesimal","kind":"theorem","line":496,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L496-L506","doc":"`substrateQ^n - 1` is infinitesimal for every `n`.  Useful as an\n\"all higher-order corrections vanish at standard-part\" identity. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.standardPart_substrateQ_pow","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.standardPart_substrateQ_pow","kind":"theorem","line":484,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L484-L494","doc":"The standard-part of `substrateQ^n` is `1` for every `n`.  The\nsubstrate parameter is \"infinitesimally close to 1 to all orders\". ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.substrateQ_isInfinitesimal_sub_one","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.substrateQ_isInfinitesimal_sub_one","kind":"theorem","line":477,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L477-L482","doc":"`substrateQ` is a finite element with positive infinitesimal\nperturbation away from `1`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.substrateQ_sub_one","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.substrateQ_sub_one","kind":"theorem","line":471,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L471-L475","doc":"`substrateQ - 1 = ε`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.polySubstrateEval_isClose_ofReal","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.polySubstrateEval_isClose_ofReal","kind":"theorem","line":453,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L453-L464","doc":"**Polynomial substrate evaluation is close to its archimedean\nvalue.**  For every real polynomial `p`,\n`polySubstrateEval p` is `IsClose` to `ofReal (p.eval 1)`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.substrateQ_isClose_one","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.substrateQ_isClose_one","kind":"theorem","line":445,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L445-L451","doc":"**Substrate parameter `q := 1 + ε` is close to `1`.**  Direct\nconsequence of `epsilonSurreal_isInfinitesimal`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.polySurrealEval_isClose","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.polySurrealEval_isClose","kind":"theorem","line":419,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L419-L443","doc":"**`polySurrealEval` preserves `IsClose` on finite arguments.**\nIf `a` is finite and `IsClose a b`, then `IsClose (polySurrealEval p a)\n(polySurrealEval p b)`.\n\nEquivalently: every real polynomial extends to a function on `K`\nthat is constant on `IsClose`-equivalence classes (modulo the\nfiniteness restriction). ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.standardPart_polynomialInEpsilon","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.standardPart_polynomialInEpsilon","kind":"theorem","line":396,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L396-L409","doc":"**Standard-part of `polynomialInEpsilon p` is the constant term**\n(`p.coeff 0`).  Algebraic content: in the Hahn-series view, the\nstandard-part picks out the coefficient at exponent `0`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.polynomialInEpsilon_eq_aeval","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.polynomialInEpsilon_eq_aeval","kind":"theorem","line":389,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L389-L394","doc":"`polynomialInEpsilon p = Polynomial.aeval ε p` — Mathlib aeval\nview of the polynomial-in-`ε` embedding. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.polynomialInEpsilon_apply","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.polynomialInEpsilon_apply","kind":"theorem","line":384,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L384-L387","doc":"Unfolding: `polynomialInEpsilon p = p.eval₂ ofReal ε`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.polynomialInEpsilon","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.polynomialInEpsilon","kind":"def","line":377,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L377-L382","doc":"The **polynomial-in-`ε` evaluator** as a ring homomorphism\n`ℝ[X] →+* K`.  Sends `p` to `Σ_n p.coeff n · ε^n`, the canonical\nfinite-support Hahn-series presentation of `p` lifted to `K`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.standardPart_polySubstrateEval","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.standardPart_polySubstrateEval","kind":"theorem","line":355,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L355-L366","doc":"**Master substrate-evaluation identity.**  For any real polynomial\n`p`, `standardPart (polySubstrateEval p) = p.eval 1`.\n\nThis is the core \"every real prediction is the standard-part of a\nsurreal computation\" theorem of the QOU framework. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.standardPart_substrateQ","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.standardPart_substrateQ","kind":"theorem","line":338,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L338-L353","doc":"The substrate parameter has standard part `1`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.substrateQ_isFinite","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.substrateQ_isFinite","kind":"theorem","line":332,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L332-L336","doc":"The substrate parameter is finite: `1 + ε` differs from `1` by\nan infinitesimal, hence is finite. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.polySubstrateEval","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.polySubstrateEval","kind":"def","line":325,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L325-L330","doc":"Evaluate a real polynomial at the substrate parameter.  This is\nthe master \"substrate evaluation\" map used by the paper:\n\n  `polySubstrateEval p ≈ p.eval 1` (modulo infinitesimals). ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.substrateQ","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.substrateQ","kind":"def","line":317,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L317-L323","doc":"The **substrate parameter** `q := 1 + ε` viewed as a surreal\nin `K`.  Infinitesimally close to the real number `1`.\n\nThis is the canonical perturbation of `1` that the QOU paper's\nformulas evaluate at; the surreal lift makes the perturbation\ntype-stable. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.standardPart_polySurrealEval","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.standardPart_polySurrealEval","kind":"theorem","line":276,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L276-L309","doc":"**Standard-part of a polynomial-in-(real + infinitesimal).**\nThe standard-part of the surreal evaluation of a real polynomial\nat any infinitesimal perturbation of a real argument equals the\nclassical real value.\n\nThis is the cleanest form of the substrate identity: every\npolynomial substrate function is \"stable under infinitesimal\nperturbation\" at every real base point. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.polySurrealEval_witness_at","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.polySurrealEval_witness_at","kind":"theorem","line":260,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L260-L274","doc":"**General witness corollary.**  Generalises `polySurrealEval_witness`\nto any real base point `r`: the surreal lift of a polynomial at\n`ofReal r + δ` (any infinitesimal perturbation of any real) is\ninfinitesimally close to the classical value `ofReal (p.eval r)`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.polySurrealEval_witness","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.polySurrealEval_witness","kind":"theorem","line":232,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L232-L258","doc":"**Automatic-witness corollary.**  For any real polynomial\n`f : ℝ[X]` and any infinitesimal `δ : K`, the surreal lift\nevaluated at `1 + δ` differs from `ofReal (f.eval 1)` by an\ninfinitesimal — i.e., hypothesis (2) of\n`ClassicalLimitIsStandardPart` is automatic for the polynomial\nsurreal lift `polySurrealEval f`.\n\nCombined with the unconditional continuity of polynomials at\nevery real point (hypothesis (1) of the conjecture), this gives\n`ClassicalLimitIsStandardPart` for **every polynomial real\nfunction**, with no further assumptions. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.polySurrealEval_isInfinitesimal_diff","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.polySurrealEval_isInfinitesimal_diff","kind":"theorem","line":191,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L191-L228","doc":"**Polynomial infinitesimal-stability** (the main lemma).\n\nFor any polynomial `p : ℝ[X]`, finite `a : K`, and infinitesimal\n`δ : K`, the difference\n\n  `polySurrealEval p (a + δ) - polySurrealEval p a`\n\nis infinitesimal.  In particular, the surreal evaluation of a real\npolynomial is \"BM-continuous at every finite point\".\n\nThis is the **automatic-witness lemma** for\n`ClassicalLimitIsStandardPart`: applied with `a := ofReal r` and\n`δ := ε`, it shows that polynomial extensions of real polynomials\nautomatically satisfy hypothesis (2) of the conjecture. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.isInfinitesimal_pow_diff","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.isInfinitesimal_pow_diff","kind":"theorem","line":161,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L161-L189","doc":"**Infinitesimal-stability for powers.**  If `δ` is infinitesimal\nand `a` is finite, then `(a + δ)^n - a^n` is infinitesimal.\n\nThis is the `n`-fold extension of `IsInfinitesimal.mul_finite`\nvia the algebraic identity\n`xⁿ⁺¹ - yⁿ⁺¹ = x · (xⁿ - yⁿ) + (x - y) · yⁿ`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.polySurrealEval_isFinite","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.polySurrealEval_isFinite","kind":"theorem","line":148,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L148-L159","doc":"The surreal evaluation of a real polynomial at a finite argument\nis finite.  Crucial finiteness lemma for the difference estimate\nbelow. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.SurrealField.IsFinite.pow","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.SurrealField.IsFinite.pow","kind":"theorem","line":136,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L136-L146","doc":"A finite power of a finite surreal is finite. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.polySurrealEval_ofReal","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.polySurrealEval_ofReal","kind":"theorem","line":111,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L111-L132","doc":"**Real-compatibility.**  On real arguments, the surreal evaluation\nmatches the classical evaluation: the diagram\n\n  ℝ[X] × ℝ  ─eval→  ℝ\n        │              │\n        │              │ ofReal\n        ↓              ↓\n  ℝ[X] × K  ─polySurrealEval→ K\n\ncommutes. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.polySurrealEval_one","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.polySurrealEval_one","kind":"theorem","line":102,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L102-L107","doc":"`polySurrealEval` of one. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.polySurrealEval_zero","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.polySurrealEval_zero","kind":"theorem","line":95,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L95-L100","doc":"`polySurrealEval` of zero. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.polySurrealEval_mul","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.polySurrealEval_mul","kind":"theorem","line":88,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L88-L93","doc":"`polySurrealEval` is multiplicative in the polynomial. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.polySurrealEval_add","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.polySurrealEval_add","kind":"theorem","line":81,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L81-L86","doc":"`polySurrealEval` is additive in the polynomial. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.polySurrealEval_X","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.polySurrealEval_X","kind":"theorem","line":74,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L74-L79","doc":"`polySurrealEval` of the indeterminate. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.polySurrealEval_C","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.polySurrealEval_C","kind":"theorem","line":67,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L67-L72","doc":"`polySurrealEval` of the constant polynomial. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.polySurrealEval_eq_aeval","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.polySurrealEval_eq_aeval","kind":"theorem","line":56,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L56-L65","doc":"**Bridge to Mathlib's `Polynomial.aeval`.**  Given the canonical\n`Algebra ℝ K` instance from `SurrealField.toAlgebra`, our\nsurreal-evaluation map agrees with the standard Mathlib\n`aeval`.  This means every theorem about `aeval` immediately\ntransfers to `polySurrealEval`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.polySurrealEval","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.polySurrealEval","kind":"def","line":47,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/PolynomialEval.lean#L47-L54","doc":"The **polynomial surreal evaluation map**: lifts a real polynomial\n`p : ℝ[X]` to a function `K → K` via the canonical real-to-surreal\nembedding `ofReal : ℝ →+* K`.\n\nThis is `Polynomial.eval₂` specialized to `ofReal`. ","signatureChunk":0}]}