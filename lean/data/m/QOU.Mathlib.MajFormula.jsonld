lib.MajFormula.part_le_sum","@type":"LeanDeclaration","name":"QOU.Mathlib.MajFormula.part_le_sum","kind":"theorem","line":61,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajFormula.lean#L61-L64","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajFormula.DN","@type":"LeanDeclaration","name":"QOU.Mathlib.MajFormula.DN","kind":"def","line":55,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajFormula.lean#L55-L59","doc":"`D_N(n)`: weakly decreasing sequences of length `n` with entries `< N`, weighted by `X^{|b|}`. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajFormula.fmaj","@type":"LeanDeclaration","name":"QOU.Mathlib.MajFormula.fmaj","kind":"def","line":52,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajFormula.lean#L52-L53","doc":"`f_μ = ∑_{S ∈ SYT(μ)} X^{maj S}`. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajFormula.instFintypeSYTe_folio","@type":"LeanDeclaration","name":"QOU.Mathlib.MajFormula.instFintypeSYTe_folio","kind":"instance","line":48,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajFormula.lean#L48-L50","signatureChunk":0}]}