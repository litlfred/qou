7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MassTheory/PinchedOctahedronDegenerate.lean#L90-L92","signatureChunk":0},{"@id":"lean:QOU.MassTheory.PinchedOctahedron.zeta0_l_pinch","@type":"LeanDeclaration","name":"QOU.MassTheory.PinchedOctahedron.zeta0_l_pinch","kind":"theorem","line":86,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MassTheory/PinchedOctahedronDegenerate.lean#L86-L88","signatureChunk":0},{"@id":"lean:QOU.MassTheory.PinchedOctahedron.zeta0_t_pinch","@type":"LeanDeclaration","name":"QOU.MassTheory.PinchedOctahedron.zeta0_t_pinch","kind":"theorem","line":82,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MassTheory/PinchedOctahedronDegenerate.lean#L82-L84","signatureChunk":0},{"@id":"lean:QOU.MassTheory.PinchedOctahedron.zeta0_r_pinch","@type":"LeanDeclaration","name":"QOU.MassTheory.PinchedOctahedron.zeta0_r_pinch","kind":"theorem","line":78,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MassTheory/PinchedOctahedronDegenerate.lean#L78-L80","signatureChunk":0},{"@id":"lean:QOU.MassTheory.PinchedOctahedron.e2","@type":"LeanDeclaration","name":"QOU.MassTheory.PinchedOctahedron.e2","kind":"def","line":70,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MassTheory/PinchedOctahedronDegenerate.lean#L70-L71","doc":"The bar-even quadratic order `e₂ = Σ_{i<j} ζ⁰_i ζ⁰_j` — the posited carrier of `g₂`. ","signatureChunk":0},{"@id":"lean:QOU.MassTheory.PinchedOctahedron.e1","@type":"LeanDeclaration","name":"QOU.MassTheory.PinchedOctahedron.e1","kind":"def","line":67,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MassTheory/PinchedOctahedronDegenerate.lean#L67-L68","doc":"The bar-odd linear order `e₁ = Σ ζ⁰_j`. ","signatureChunk":0},{"@id":"lean:QOU.MassTheory.PinchedOctahedron.zeta0_b","@type":"LeanDeclaration","name":"QOU.MassTheory.PinchedOctahedron.zeta0_b","kind":"def","line":64,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MassTheory/PinchedOctahedronDegenerate.lean#L64-L65","doc":"MSR eq (4.14): the **bottom** tetrahedron shape-log. ","signatureChunk":0},{"@id":"lean:QOU.MassTheory.PinchedOctahedron.zeta0_l","@type":"LeanDeclaration","name":"QOU.MassTheory.PinchedOctahedron.zeta0_l","kind":"def","line":61,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MassTheory/PinchedOctahedronDegenerate.lean#L61-L62","doc":"MSR eq (4.13): the **left** tetrahedron shape-log. ","signatureChunk":0},{"@id":"lean:QOU.MassTheory.PinchedOctahedron.zeta0_t","@type":"LeanDeclaration","name":"QOU.MassTheory.PinchedOctahedron.zeta0_t","kind":"def","line":58,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MassTheory/PinchedOctahedronDegenerate.lean#L58-L59","doc":"MSR eq (4.12): the **top** tetrahedron shape-log. ","signatureChunk":0},{"@id":"lean:QOU.MassTheory.PinchedOctahedron.zeta0_r","@type":"LeanDeclaration","name":"QOU.MassTheory.PinchedOctahedron.zeta0_r","kind":"def","line":55,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MassTheory/PinchedOctahedronDegenerate.lean#L55-L56","doc":"MSR eq (4.11): the **right** tetrahedron shape-log. ","signatureChunk":0}]}