{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:MolecularConstruction.BenzeneMolecularBraid","@type":"LeanModule","name":"MolecularConstruction.BenzeneMolecularBraid","imports":["lean:module:Init"],"declarations":9,"chunks":1},{"@id":"lean:QOU.Molecular.benzene_strands","@type":"LeanDeclaration","name":"QOU.Molecular.benzene_strands","kind":"theorem","line":25,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/benzene-molecular-braid.lean#L25-L26","doc":"Benzene strand count: 6 × carbon(18) + 6 × hydrogen(2). ","signatureChunk":0},{"@id":"lean:QOU.Molecular.BenzeneBraid.piElectrons","@type":"LeanDeclaration","name":"QOU.Molecular.BenzeneBraid.piElectrons","kind":"def","line":23,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/benzene-molecular-braid.lean#L23-L23","doc":"π electrons = 6 (delocalized ring). ","signatureChunk":0},{"@id":"lean:QOU.Molecular.BenzeneBraid.chBonds","@type":"LeanDeclaration","name":"QOU.Molecular.BenzeneBraid.chBonds","kind":"def","line":21,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/benzene-molecular-braid.lean#L21-L21","doc":"C-H σ bonds = 6. ","signatureChunk":0},{"@id":"lean:QOU.Molecular.BenzeneBraid.ccBonds","@type":"LeanDeclaration","name":"QOU.Molecular.BenzeneBraid.ccBonds","kind":"def","line":19,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/benzene-molecular-braid.lean#L19-L19","doc":"C-C σ bonds = 6. ","signatureChunk":0},{"@id":"lean:QOU.Molecular.BenzeneBraid.numHydrogens","@type":"LeanDeclaration","name":"QOU.Molecular.BenzeneBraid.numHydrogens","kind":"def","line":17,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/benzene-molecular-braid.lean#L17-L17","doc":"Number of hydrogen atoms = 6. ","signatureChunk":0},{"@id":"lean:QOU.Molecular.BenzeneBraid.numCarbons","@type":"LeanDeclaration","name":"QOU.Molecular.BenzeneBraid.numCarbons","kind":"def","line":15,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/benzene-molecular-braid.lean#L15-L15","doc":"Number of carbon atoms = 6. ","signatureChunk":0},{"@id":"lean:QOU.Molecular.BenzeneBraid.totalStrands","@type":"LeanDeclaration","name":"QOU.Molecular.BenzeneBraid.totalStrands","kind":"def","line":13,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/benzene-molecular-braid.lean#L13-L13","doc":"Total strand count = 120. ","signatureChunk":0},{"@id":"lean:QOU.Molecular.BenzeneBraid.mk","@type":"LeanDeclaration","name":"QOU.Molecular.BenzeneBraid.mk","kind":"ctor","line":11,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/benzene-molecular-braid.lean#L11-L11","signatureChunk":0},{"@id":"lean:QOU.Molecular.BenzeneBraid","@type":"LeanDeclaration","name":"QOU.Molecular.BenzeneBraid","kind":"structure","line":6,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/benzene-molecular-braid.lean#L6-L23","doc":"**Benzene C₆H₆** as a molecular braid with 120 strands.\n\n6 carbons (6 × 18 = 108 strands) + 6 hydrogens (6 × 2 = 12 strands).\nBonds: 6 C-C σ bonds, 6 C-H σ bonds, 6 π electrons forming a\nthreading link T(2,6) that emerges from the LP dual as optimal. ","formalizes":[{"@id":"block:def:benzene-molecular-braid","label":"def:benzene-molecular-braid","md":"quantum-observable-universe/molecular-construction/benzene-molecular-braid.md"}],"signatureChunk":0}]}