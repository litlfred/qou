ou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/NucleonWordTraceClosedForm.lean#L128-L166","doc":"The proton word, folded: each step is checked by `ring` on explicit coordinates. ","signatureChunk":0},{"@id":"lean:QOU.Mass.NucleonWordTraceClosedForm.vec6_ext","@type":"LeanDeclaration","name":"QOU.Mass.NucleonWordTraceClosedForm.vec6_ext","kind":"theorem","line":120,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/NucleonWordTraceClosedForm.lean#L120-L124","doc":"Componentwise equality of six-vectors. ","signatureChunk":0},{"@id":"lean:QOU.Mass.NucleonWordTraceClosedForm.trM_vec","@type":"LeanDeclaration","name":"QOU.Mass.NucleonWordTraceClosedForm.trM_vec","kind":"theorem","line":114,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/NucleonWordTraceClosedForm.lean#L114-L117","signatureChunk":0},{"@id":"lean:QOU.Mass.NucleonWordTraceClosedForm.nfStep_one","@type":"LeanDeclaration","name":"QOU.Mass.NucleonWordTraceClosedForm.nfStep_one","kind":"theorem","line":107,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/NucleonWordTraceClosedForm.lean#L107-L112","signatureChunk":0},{"@id":"lean:QOU.Mass.NucleonWordTraceClosedForm.nfStep_zero","@type":"LeanDeclaration","name":"QOU.Mass.NucleonWordTraceClosedForm.nfStep_zero","kind":"theorem","line":100,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/NucleonWordTraceClosedForm.lean#L100-L105","signatureChunk":0},{"@id":"lean:QOU.Mass.NucleonWordTraceClosedForm.neutronPoly","@type":"LeanDeclaration","name":"QOU.Mass.NucleonWordTraceClosedForm.neutronPoly","kind":"def","line":90,"sourceLink":"https://github.com/litlfred/qou/