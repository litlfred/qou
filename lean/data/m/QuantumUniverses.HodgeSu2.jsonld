{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QuantumUniverses.HodgeSu2","@type":"LeanModule","name":"QuantumUniverses.HodgeSu2","imports":["lean:module:Init","lean:module:Mathlib.Data.Nat.Basic"],"declarations":12,"chunks":1},{"@id":"lean:QOU.Examples.su2_hodge_one_to_two","@type":"LeanDeclaration","name":"QOU.Examples.su2_hodge_one_to_two","kind":"theorem","line":70,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/hodge-su2.lean#L70-L71","doc":"Hodge star on a 3-manifold maps Ω¹ to Ω². ","signatureChunk":0},{"@id":"lean:QOU.Examples.su2Hodge","@type":"LeanDeclaration","name":"QOU.Examples.su2Hodge","kind":"def","line":58,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/hodge-su2.lean#L58-L68","doc":"The Hodge star data for SU(2). ","formalizes":[{"@id":"block:ex:hodge-su2","label":"ex:hodge-su2","md":"quantum-observable-universe/quantum-universes/hodge-su2.md"}],"signatureChunk":0},{"@id":"lean:QOU.Examples.SU2HodgeData.involutive","@type":"LeanDeclaration","name":"QOU.Examples.SU2HodgeData.involutive","kind":"theorem","line":56,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/hodge-su2.lean#L56-L56","doc":"⋆² = id (involutivity): applying hodge twice returns to the same\ndegree, for every valid form-degree `k ≤ 3 = manifoldDim` of the\nde Rham complex. (⋆ is only defined on `Ωᵏ` for `0 ≤ k ≤ 3`.) ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2HodgeData.target_three","@type":"LeanDeclaration","name":"QOU.Examples.SU2HodgeData.target_three","kind":"theorem","line":52,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/hodge-su2.lean#L52-L52","doc":"⋆ maps Ω³ → Ω⁰. ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2HodgeData.target_two","@type":"LeanDeclaration","name":"QOU.Examples.SU2HodgeData.target_two","kind":"theorem","line":50,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/hodge-su2.lean#L50-L50","doc":"⋆ maps Ω² → Ω¹. ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2HodgeData.target_one","@type":"LeanDeclaration","name":"QOU.Examples.SU2HodgeData.target_one","kind":"theorem","line":48,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/hodge-su2.lean#L48-L48","doc":"⋆ maps Ω¹ → Ω². ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2HodgeData.target_zero","@type":"LeanDeclaration","name":"QOU.Examples.SU2HodgeData.target_zero","kind":"theorem","line":46,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/hodge-su2.lean#L46-L46","doc":"⋆ maps Ω⁰ → Ω³. ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2HodgeData.hodgeTarget","@type":"LeanDeclaration","name":"QOU.Examples.SU2HodgeData.hodgeTarget","kind":"def","line":44,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/hodge-su2.lean#L44-L44","doc":"⋆ maps Ωᵏ → Ω^{n−k}: the target degree of ⋆ on k-forms. ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2HodgeData.dim_three","@type":"LeanDeclaration","name":"QOU.Examples.SU2HodgeData.dim_three","kind":"theorem","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/hodge-su2.lean#L42-L42","doc":"SU(2) is 3-dimensional. ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2HodgeData.manifoldDim","@type":"LeanDeclaration","name":"QOU.Examples.SU2HodgeData.manifoldDim","kind":"def","line":40,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/hodge-su2.lean#L40-L40","doc":"The manifold dimension (for SU(2): dim = 3). ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2HodgeData.mk","@type":"LeanDeclaration","name":"QOU.Examples.SU2HodgeData.mk","kind":"ctor","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/hodge-su2.lean#L38-L38","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2HodgeData","@type":"LeanDeclaration","name":"QOU.Examples.SU2HodgeData","kind":"structure","line":33,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/hodge-su2.lean#L33-L56","doc":"**SU(2) Hodge star data**: the involutive Hodge operator on the\n3-dimensional de Rham complex.\n\nLaTeX: `\\label{ex:hodge-su2}` ","signatureChunk":0}]}