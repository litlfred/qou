verification.lean#L289-L293","signatureChunk":0},{"@id":"lean:QOU.Archimedean.HalfLifeVerification.tritium_ratio_upper","@type":"LeanDeclaration","name":"QOU.Archimedean.HalfLifeVerification.tritium_ratio_upper","kind":"theorem","line":281,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/observations/hadron-half-life-verification.lean#L281-L287","doc":"³H: predicted 13 yr vs observed 12.32 yr, ratio < 1.06. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.HalfLifeVerification.HalfLifePrediction.ratio_lower","@type":"LeanDeclaration","name":"QOU.Archimedean.HalfLifeVerification.HalfLifePrediction.ratio_lower","kind":"theorem","line":275,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/observations/hadron-half-life-verification.lean#L275-L275","signatureChunk":0},{"@id":"lean:QOU.Archimedean.HalfLifeVerification.HalfLifePrediction.ratio_upper","@type":"LeanDeclaration","name":"QOU.Archimedean.HalfLifeVerification.HalfLifePrediction.ratio_upper","kind":"theorem","line":274,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/observations/hadron-half-life-verification.lean#L274-L274","doc":"The prediction is near the observation: ratio bounded both ways. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.HalfLifeVerification.HalfLifePrediction.tol_gt_one","@type":"LeanDeclaration","name":"QOU.Archimedean.HalfLifeVerification.HalfLifePrediction.tol_gt_one","kind":"theorem","line":272,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/observations/hadron-half-life-verification.lean#L272-L272","doc":"tolerance > 1. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.HalfLifeVerification.HalfLifePrediction.tolerance","@type":"LeanDeclaration","name":"QOU.Archimedean.HalfLifeVe