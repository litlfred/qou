{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:MolecularConstruction.CoMolecularBraid","@type":"LeanModule","name":"MolecularConstruction.CoMolecularBraid","imports":["lean:module:Init"],"declarations":6,"chunks":1},{"@id":"lean:QOU.Molecular.co_strands","@type":"LeanDeclaration","name":"QOU.Molecular.co_strands","kind":"theorem","line":19,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/co-molecular-braid.lean#L19-L22","doc":"CO strand count: carbon(18) + oxygen(24). ","signatureChunk":0},{"@id":"lean:QOU.Molecular.COBraid.sharedElectrons","@type":"LeanDeclaration","name":"QOU.Molecular.COBraid.sharedElectrons","kind":"def","line":17,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/co-molecular-braid.lean#L17-L17","doc":"Total shared electrons = 6. ","signatureChunk":0},{"@id":"lean:QOU.Molecular.COBraid.numBonds","@type":"LeanDeclaration","name":"QOU.Molecular.COBraid.numBonds","kind":"def","line":15,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/co-molecular-braid.lean#L15-L15","doc":"Number of bonds = 3 (triple bond). ","signatureChunk":0},{"@id":"lean:QOU.Molecular.COBraid.totalStrands","@type":"LeanDeclaration","name":"QOU.Molecular.COBraid.totalStrands","kind":"def","line":13,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/co-molecular-braid.lean#L13-L13","doc":"Total strand count = 42 (C: 18 + O: 24). ","signatureChunk":0},{"@id":"lean:QOU.Molecular.COBraid.mk","@type":"LeanDeclaration","name":"QOU.Molecular.COBraid.mk","kind":"ctor","line":11,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/co-molecular-braid.lean#L11-L11","signatureChunk":0},{"@id":"lean:QOU.Molecular.COBraid","@type":"LeanDeclaration","name":"QOU.Molecular.COBraid","kind":"structure","line":6,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/co-molecular-braid.lean#L6-L17","doc":"**Carbon monoxide CO** as a molecular braid with 42 strands.\n\nTriple bond (1 σ + 2 π pairs). Carbon and oxygen each retain\ncore electrons plus one lone pair. 6 shared electrons across\n3 covalent channels determined by LP dual minimization. ","formalizes":[{"@id":"block:def:co-molecular-braid","label":"def:co-molecular-braid","md":"quantum-observable-universe/molecular-construction/co-molecular-braid.md"}],"signatureChunk":0}]}