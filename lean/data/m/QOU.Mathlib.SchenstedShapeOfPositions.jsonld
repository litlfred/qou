{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Mathlib.SchenstedShapeOfPositions","@type":"LeanModule","name":"QOU.Mathlib.SchenstedShapeOfPositions","imports":["lean:module:Init","lean:module:QOU.Mathlib.SchenstedRecordingTrunc"],"declarations":4,"chunks":1},{"@id":"lean:QOU.Mathlib.Schensted.addCellSteps_qPositions","@type":"LeanDeclaration","name":"QOU.Mathlib.Schensted.addCellSteps_qPositions","kind":"theorem","line":84,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SchenstedShapeOfPositions.lean#L84-L100","doc":"**The positions build the shape.** Row `i` gains one cell per position equal to `i`, which is\nthe count of row-`i` entries below the horizon — the row's whole length, once the horizon clears\nevery entry. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.Schensted.count_qPositions_past","@type":"LeanDeclaration","name":"QOU.Mathlib.Schensted.count_qPositions_past","kind":"theorem","line":71,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SchenstedShapeOfPositions.lean#L71-L82","doc":"Every recorded position is a genuine row index, so no position lands past the last row. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.Schensted.youngShape_addCellSteps","@type":"LeanDeclaration","name":"QOU.Mathlib.Schensted.youngShape_addCellSteps","kind":"theorem","line":62,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SchenstedShapeOfPositions.lean#L62-L69","doc":"An addable run builds a Young shape. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.Schensted.eq_of_getD_eq","@type":"LeanDeclaration","name":"QOU.Mathlib.Schensted.eq_of_getD_eq","kind":"theorem","line":43,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SchenstedShapeOfPositions.lean#L43-L60","doc":"**Lists of positive naturals agreeing at every index are equal.** Positivity is what pins the\nlengths: past the shorter list `getD` reads the default `0`, which the longer one cannot. ","signatureChunk":0}]}