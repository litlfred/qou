sSurface.SaddleTrajectory.mk","@type":"LeanDeclaration","name":"QOU.BringsSurface.SaddleTrajectory.mk","kind":"ctor","line":68,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BringsSurface/TurningPoints.lean#L68-L68","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.SaddleTrajectory","@type":"LeanDeclaration","name":"QOU.BringsSurface.SaddleTrajectory","kind":"structure","line":61,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BringsSurface/TurningPoints.lean#L61-L72","doc":"Saddle trajectory phase condition between two turning points i and j\n\n**`isBPS : Prop` removed 2026-09-07. Its own comment called it a \"placeholder\nfor `Im ∫_{x_i}^{x_j} (y_i - y_j) dx = 0`\", and typed with the *universe*\n`Prop` it asserted nothing — an instance chose the proposition. Neither read\nnor constructed anywhere. Stating it needs the path integral, which is what\nthe adjacent comment says is unavailable.** ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.turning_point_count","@type":"LeanDeclaration","name":"QOU.BringsSurface.turning_point_count","kind":"theorem","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BringsSurface/TurningPoints.lean#L42-L59","doc":"There are exactly 4 turning points, counted with multiplicity ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.turningPointPoly","@type":"LeanDeclaration","name":"QOU.BringsSurface.turningPointPoly","kind":"def","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BringsSurface/TurningPoints.lean#L38-L40","doc":"The polynomial whose roots are the turning points ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.turning_point_x","@type":"LeanDeclaration","name":"QOU.BringsSurface.turning_point_x","kind":"theorem","line":22,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BringsSurface/TurningPoints.lean#L22-L36","doc":"The x-coordinate at a turning point satisfies `x = -(4/5) * y` ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.isTurningPoint","@type":"LeanDeclaration","name":"QOU.BringsSurface.isTurningPoint","kind":"def","line":18,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BringsSurface/TurningPoints.lean#L18-L20","doc":"Turning points are where `dx/dy = 0` on Bring's curve, giving `5y^4 + 1 = 0` ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.bringsCurve","@type":"LeanDeclaration","name":"QOU.BringsSurface.bringsCurve","kind":"def","line":14,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BringsSurface/TurningPoints.lean#L14-L16","doc":"Bring's curve equation `y^5 + y + x = 0` ","signatureChunk":0}]}