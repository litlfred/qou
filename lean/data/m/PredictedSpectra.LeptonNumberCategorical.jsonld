{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:PredictedSpectra.LeptonNumberCategorical","@type":"LeanModule","name":"PredictedSpectra.LeptonNumberCategorical","imports":["lean:module:Init","lean:module:Mathlib.Data.Int.Basic","lean:module:Mathlib.Tactic.NormNum.Basic"],"declarations":11,"chunks":1},{"@id":"lean:QOU.Archimedean.lepton_number_conservation","@type":"LeanDeclaration","name":"QOU.Archimedean.lepton_number_conservation","kind":"theorem","line":58,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/lepton-number-categorical.lean#L58-L66","doc":"Lepton number is conserved: any sequence of k Skein smoothings\nproduces total lepton number 0 in the lepton sector. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.betaPlusSmoothing","@type":"LeanDeclaration","name":"QOU.Archimedean.betaPlusSmoothing","kind":"def","line":51,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/lepton-number-categorical.lean#L51-L56","doc":"β⁺ smoothing: positron (L=-1) + neutrino (L=+1). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.betaMinusSmoothing","@type":"LeanDeclaration","name":"QOU.Archimedean.betaMinusSmoothing","kind":"def","line":44,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/lepton-number-categorical.lean#L44-L49","doc":"β⁻ smoothing: electron (L=+1) + antineutrino (L=-1). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.SkeinSmoothing.pair_conservation","@type":"LeanDeclaration","name":"QOU.Archimedean.SkeinSmoothing.pair_conservation","kind":"theorem","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/lepton-number-categorical.lean#L42-L42","doc":"The pair sums to zero. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.SkeinSmoothing.neutral","@type":"LeanDeclaration","name":"QOU.Archimedean.SkeinSmoothing.neutral","kind":"def","line":40,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/lepton-number-categorical.lean#L40-L40","doc":"Lepton number of the neutral component. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.SkeinSmoothing.charged","@type":"LeanDeclaration","name":"QOU.Archimedean.SkeinSmoothing.charged","kind":"def","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/lepton-number-categorical.lean#L38-L38","doc":"Lepton number of the charged component. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.SkeinSmoothing.mk","@type":"LeanDeclaration","name":"QOU.Archimedean.SkeinSmoothing.mk","kind":"ctor","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/lepton-number-categorical.lean#L36-L36","signatureChunk":0},{"@id":"lean:QOU.Archimedean.SkeinSmoothing","@type":"LeanDeclaration","name":"QOU.Archimedean.SkeinSmoothing","kind":"structure","line":34,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/lepton-number-categorical.lean#L34-L42","doc":"A Skein smoothing event: produces exactly one lepton pair. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.LeptonNumber.L","@type":"LeanDeclaration","name":"QOU.Archimedean.LeptonNumber.L","kind":"def","line":32,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/lepton-number-categorical.lean#L32-L32","doc":"The lepton number value. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.LeptonNumber.mk","@type":"LeanDeclaration","name":"QOU.Archimedean.LeptonNumber.mk","kind":"ctor","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/lepton-number-categorical.lean#L30-L30","signatureChunk":0},{"@id":"lean:QOU.Archimedean.LeptonNumber","@type":"LeanDeclaration","name":"QOU.Archimedean.LeptonNumber","kind":"structure","line":20,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/lepton-number-categorical.lean#L20-L32","doc":"The lepton number of a particle.\n\nIn the QOU framework, lepton number counts Skein smoothings:\n- Charged leptons (trefoil components): L = +1 or -1\n- Neutrinos (unknot components): L = -1 or +1\n- Hadrons (no smoothing): L = 0\n\nEach Skein smoothing L₀ produces one (lepton, antilepton) pair\nwith total lepton number 0. ","formalizes":[{"@id":"block:def:lepton-number-categorical","label":"def:lepton-number-categorical","md":"quantum-observable-universe/predicted-spectra/lepton-number-categorical.md"}],"signatureChunk":0}]}