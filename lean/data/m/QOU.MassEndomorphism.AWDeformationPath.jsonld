{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.MassEndomorphism.AWDeformationPath","@type":"LeanModule","name":"QOU.MassEndomorphism.AWDeformationPath","imports":["lean:module:Init","lean:module:Mathlib.Data.Complex.Basic","lean:module:Mathlib.Data.Real.Basic","lean:module:Mathlib.Tactic.Ring","lean:module:Mathlib.Tactic.LinearCombination"],"declarations":14,"chunks":1},{"@id":"lean:QOU.MassEndomorphism.AWDeformationPath.ladder_recurrence","@type":"LeanDeclaration","name":"QOU.MassEndomorphism.AWDeformationPath.ladder_recurrence","kind":"theorem","line":59,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MassEndomorphism/AWDeformationPath.lean#L59-L59","doc":"ONE recurrence on the full complex ladder. ","signatureChunk":0},{"@id":"lean:QOU.MassEndomorphism.AWDeformationPath.multiplier_bar_even","@type":"LeanDeclaration","name":"QOU.MassEndomorphism.AWDeformationPath.multiplier_bar_even","kind":"theorem","line":57,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MassEndomorphism/AWDeformationPath.lean#L57-L57","doc":"the multiplier is bar-even — the load-bearing hypothesis. ","signatureChunk":0},{"@id":"lean:QOU.MassEndomorphism.AWDeformationPath.multiplier","@type":"LeanDeclaration","name":"QOU.MassEndomorphism.AWDeformationPath.multiplier","kind":"def","line":55,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MassEndomorphism/AWDeformationPath.lean#L55-L55","doc":"the shared three-term multiplier (the `2cosh`-type coefficient). ","signatureChunk":0},{"@id":"lean:QOU.MassEndomorphism.AWDeformationPath.ladder_head","@type":"LeanDeclaration","name":"QOU.MassEndomorphism.AWDeformationPath.ladder_head","kind":"theorem","line":53,"sourceLink":"https://github.