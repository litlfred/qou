{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.QBeta.BarEvenJet","@type":"LeanModule","name":"QOU.QBeta.BarEvenJet","imports":["lean:module:Init","lean:module:Mathlib.Algebra.DualNumber","lean:module:Mathlib.Algebra.Polynomial.Laurent","lean:module:Mathlib.Tactic"],"declarations":15,"chunks":1},{"@id":"lean:QOU.QBeta.BarEvenJet.laurent_snd_jet_eq_zero_of_barEven","@type":"LeanDeclaration","name":"QOU.QBeta.BarEvenJet.laurent_snd_jet_eq_zero_of_barEven","kind":"theorem","line":117,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/BarEvenJet.lean#L117-L121","doc":"**Corollary.** A bar-even Laurent polynomial (`f(q⁻¹) = f(q)`) over a ring where `2` is a\nunit has zero first-order part at `q = 1`. No analysis. ","signatureChunk":0},{"@id":"lean:QOU.QBeta.BarEvenJet.laurentFixedPointJet","@type":"LeanDeclaration","name":"QOU.QBeta.BarEvenJet.laurentFixedPointJet","kind":"def","line":100,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/BarEvenJet.lean#L100-L115","doc":"**The Laurent instance.** The bar involution `q ↦ q⁻¹` and evaluation at `1 + ε`. ","signatureChunk":0},{"@id":"lean:QOU.QBeta.BarEvenJet.laurentJet","@type":"LeanDeclaration","name":"QOU.QBeta.BarEvenJet.laurentJet","kind":"def","line":96,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/BarEvenJet.lean#L96-L98","doc":"The jet at `q = 1` of a Laurent polynomial: evaluate at `q = 1 + ε`. ","signatureChunk":0},{"@id":"lean:QOU.QBeta.BarEvenJet.dconj_zpow","@type":"LeanDeclaration","name":"QOU.QBeta.BarEvenJet.dconj_zpow","kind":"theorem","line":80,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/BarEvenJet.lean#L80-L94","doc":"`dconj` sends `(1+ε)^n` to `(1+ε)^(−n)`. ","signatureChunk":0},{"@id":"lean:QOU.QBeta.BarEvenJet.dconj_onePlusEps","@type":"LeanDeclaration","name":"QOU.QBeta.BarEvenJet.dconj_onePlusEps","kind":"theorem","line":76,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/BarEvenJet.lean#L76-L78","signatureChunk":0},{"@id":"lean:QOU.QBeta.BarEvenJet.onePlusEps","@type":"LeanDeclaration","name":"QOU.QBeta.BarEvenJet.onePlusEps","kind":"def","line":69,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/BarEvenJet.lean#L69-L74","doc":"`1 + ε`, a unit of `K[ε]` with inverse `1 − ε`. ","signatureChunk":0},{"@id":"lean:QOU.QBeta.BarEvenJet.snd_jet_eq_zero_of_invariant","@type":"LeanDeclaration","name":"QOU.QBeta.BarEvenJet.snd_jet_eq_zero_of_invariant","kind":"theorem","line":58,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/BarEvenJet.lean#L58-L65","doc":"**Bar-evenness forces stationarity, for any jet.** If `ι f = f` and `2` is a unit,\nthe first-order part of the jet of `f` is zero. Pure algebra. ","signatureChunk":0},{"@id":"lean:QOU.QBeta.BarEvenJet.FixedPointJet.jet_ι","@type":"LeanDeclaration","name":"QOU.QBeta.BarEvenJet.FixedPointJet.jet_ι","kind":"theorem","line":56,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/BarEvenJet.lean#L56-L56","signatureChunk":0},{"@id":"lean:QOU.QBeta.BarEvenJet.FixedPointJet.jet","@type":"LeanDeclaration","name":"QOU.QBeta.BarEvenJet.FixedPointJet.jet","kind":"def","line":55,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/BarEvenJet.lean#L55-L55","signatureChunk":0},{"@id":"lean:QOU.QBeta.BarEvenJet.FixedPointJet.ι","@type":"LeanDeclaration","name":"QOU.QBeta.BarEvenJet.FixedPointJet.ι","kind":"def","line":54,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/BarEvenJet.lean#L54-L54","signatureChunk":0},{"@id":"lean:QOU.QBeta.BarEvenJet.FixedPointJet.mk","@type":"LeanDeclaration","name":"QOU.QBeta.BarEvenJet.FixedPointJet.mk","kind":"ctor","line":53,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/BarEvenJet.lean#L53-L53","signatureChunk":0},{"@id":"lean:QOU.QBeta.BarEvenJet.FixedPointJet","@type":"LeanDeclaration","name":"QOU.QBeta.BarEvenJet.FixedPointJet","kind":"structure","line":50,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/BarEvenJet.lean#L50-L56","doc":"**A first-order jet at a fixed point of an involution.**  `jet : A → K[ε]` reads off\nvalue and first derivative at the fixed point, and the involution acts on the tangent line\nby `−1`: `jet ∘ ι = dconj ∘ jet`. ","signatureChunk":0},{"@id":"lean:QOU.QBeta.BarEvenJet.snd_dconj","@type":"LeanDeclaration","name":"QOU.QBeta.BarEvenJet.snd_dconj","kind":"theorem","line":48,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/BarEvenJet.lean#L48-L48","signatureChunk":0},{"@id":"lean:QOU.QBeta.BarEvenJet.fst_dconj","@type":"LeanDeclaration","name":"QOU.QBeta.BarEvenJet.fst_dconj","kind":"theorem","line":47,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/BarEvenJet.lean#L47-L47","signatureChunk":0},{"@id":"lean:QOU.QBeta.BarEvenJet.dconj","@type":"LeanDeclaration","name":"QOU.QBeta.BarEvenJet.dconj","kind":"def","line":34,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QBeta/BarEvenJet.lean#L34-L45","doc":"Conjugation on dual numbers, `a + bε ↦ a − bε`. ","signatureChunk":0}]}