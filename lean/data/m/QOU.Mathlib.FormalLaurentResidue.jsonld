{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Mathlib.FormalLaurentResidue","@type":"LeanModule","name":"QOU.Mathlib.FormalLaurentResidue","imports":["lean:module:Init","lean:module:Mathlib.Tactic"],"declarations":10,"chunks":1},{"@id":"lean:QOU.Mathlib.FormalLaurentResidue.fresidue_sum_jet_succ","@type":"LeanDeclaration","name":"QOU.Mathlib.FormalLaurentResidue.fresidue_sum_jet_succ","kind":"theorem","line":80,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/FormalLaurentResidue.lean#L80-L85","doc":"A finite residue sum of positive-order jets vanishes — the library form of\nthe exactness (b)-exclusion: no residue-sum period can be sourced by classical\njets. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.FormalLaurentResidue.fresidue_sum","@type":"LeanDeclaration","name":"QOU.Mathlib.FormalLaurentResidue.fresidue_sum","kind":"theorem","line":77,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/FormalLaurentResidue.lean#L77-L78","signatureChunk":0},{"@id":"lean:QOU.Mathlib.FormalLaurentResidue.fresidue_add","@type":"LeanDeclaration","name":"QOU.Mathlib.FormalLaurentResidue.fresidue_add","kind":"theorem","line":74,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/FormalLaurentResidue.lean#L74-L75","signatureChunk":0},{"@id":"lean:QOU.Mathlib.FormalLaurentResidue.fderiv_smul","@type":"LeanDeclaration","name":"QOU.Mathlib.FormalLaurentResidue.fderiv_smul","kind":"theorem","line":68,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/FormalLaurentResidue.lean#L68-L72","signatureChunk":0},{"@id":"lean:QOU.Mathlib.FormalLaurentResidue.fderiv_add","@