:QOU.Archimedean.RossoJonesGeneral.Em","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.Em","kind":"def","line":273,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L273-L276","doc":"**The raising operator** `E = Σ_k e_k ⊗ K⁻¹ ⊗ ⋯ ⊗ K⁻¹` of `U_q(sl₂)` on `V^{⊗(n+1)}`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.phi","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.phi","kind":"def","line":269,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L269-L271","doc":"The `K⁻¹`-string to the right of site `k`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.prod_qo_update","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.prod_qo_update","kind":"theorem","line":262,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L262-L265","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.prod_qz_update","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.prod_qz_update","kind":"theorem","line":256,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L256-L260","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.prod_update_one","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.prod_update_one","kind":"theorem","line":243,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L243-L254","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.prod_qz_mul_phi","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.prod_qz_mul_phi","kind":"theorem","line":225,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L225-L241","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.prod_qz_mul_ki","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.prod_qz_mul_ki","kind":"theorem","line":219,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L219-L223","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.gam_eq_G","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.gam_eq_G","kind":"theorem","line":182,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L182-L213","doc":"**`γ` is the explicit carry matrix `G`**, for every number of sites. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.cons_snoc'","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.cons_snoc'","kind":"theorem","line":177,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L177-L180","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.prod_snoc","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.prod_snoc","kind":"theorem","line":173,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L173-L175","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.snoc_eq_cons_one","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.snoc_eq_cons_one","kind":"theorem","line":169,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L169-L171","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.cJ_last_prod","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.cJ_last_prod","kind":"theorem","line":162,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L162-L167","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.cJ_castSucc_prod","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.cJ_castSucc_prod","kind":"theorem","line":154,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L154-L160","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.extS_apply","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.extS_apply","kind":"theorem","line":133,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L133-L152","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.S_last_apply","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.S_last_apply","kind":"theorem","line":94,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L94-L131","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.dg","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.dg","kind":"def","line":90,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L90-L92","doc":"The diagonal coefficient of `Ř` on `(y, x)`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.gam_succ","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.gam_succ","kind":"theorem","line":86,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L86-L88","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.G_snoc1","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.G_snoc1","kind":"theorem","line":76,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L76-L82","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.G_snoc0","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.G_snoc0","kind":"theorem","line":71,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L71-L74","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.G","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.G","kind":"def","line":54,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L54-L69","doc":"**The explicit matrix of `γ` on `V^{⊗(n+1)}`.** Writing a column state as `c · x` (`x` the\nlast site), `γ` carries the letter `x` from the last site to the first. A carried `0` passes every\nletter, picking up `q` per zero it passes. A carried `1` either passes every letter (`q` per one\npassed) or is set down at the first zero `c j` it meets and that zero is carried on instead,\nwith weight `(q − q⁻¹) · q^{#ones right of j + #zeros left of j}`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.cJ","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.cJ","kind":"def","line":48,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L48-L50","doc":"The weight of the split term of `γ`: ones to the right of `j` and zeros to its left. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.ki","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.ki","kind":"def","line":45,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L45-L46","doc":"The `K⁻¹` weight: `q⁻¹` on a zero, `q` on a one. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.qo","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.qo","kind":"def","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L42-L43","doc":"`q` on a one, `1` on a zero. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.qz","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.qz","kind":"def","line":39,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L39-L40","doc":"`q` on a zero, `1` on a one. ","signatureChunk":0}]}