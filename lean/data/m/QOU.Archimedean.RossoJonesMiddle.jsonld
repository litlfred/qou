erse/lean/QOU/Archimedean/RossoJonesMiddle.lean#L596-L605","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.T_Em_mul","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.T_Em_mul","kind":"theorem","line":566,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L566-L592","doc":"**The weight-space trace moves across `E`.** ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.Em_weight","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.Em_weight","kind":"theorem","line":553,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L553-L564","doc":"`E` raises the weight by one. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.ones_update","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.ones_update","kind":"theorem","line":540,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L540-L551","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.T_sub","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.T_sub","kind":"theorem","line":536,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L536-L538","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.T_add","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.T_add","kind":"theorem","line":532,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L532-L534","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.pow_decomp","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.pow_decomp","kind":"theorem","line":507,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L507-L530","doc":"**The ring-level telescoping.** If `g = r + e k`, `r e = e r'` and `k e = g − r'` in any\nring, then for every `p` there is `k_p` with `g^p = r^p + e k_p` and `k_p e = g^p − r'^p`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.Km_mul_Em","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.Km_mul_Em","kind":"theorem","line":476,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L476-L503","doc":"**`K E = γ − ρ'`.** ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.rho_mul_Em","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.rho_mul_Em","kind":"theorem","line":446,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L446-L474","doc":"**`ρ E = E ρ'`.** ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.Km_apply_snoc","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.Km_apply_snoc","kind":"theorem","line":439,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L439-L444","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.rho'_apply_snoc","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.rho'_apply_snoc","kind":"theorem","line":433,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-unive