Middle.lean#L364-L373","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.mul_Em_apply","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.mul_Em_apply","kind":"theorem","line":350,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L350-L362","doc":"`(X · E)` column by column: `E` raises one zero of the column state. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.Em_cons","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.Em_cons","kind":"theorem","line":338,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L338-L348","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.phi_succ","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.phi_succ","kind":"theorem","line":332,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L332-L336","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.phi_zero","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.phi_zero","kind":"theorem","line":327,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L327-L330","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.phi_last","@type":"LeanDeclaration","name":"QOU.Archimedean.RossoJonesGeneral.phi_last","kind":"theorem","line":323,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/RossoJonesMiddle.lean#L323-L325","signatureChunk":0},{"@id":"lean:QOU.Archimedean.RossoJonesGeneral.phi_castSuc