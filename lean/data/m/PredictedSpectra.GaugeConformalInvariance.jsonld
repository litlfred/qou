{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:PredictedSpectra.GaugeConformalInvariance","@type":"LeanModule","name":"PredictedSpectra.GaugeConformalInvariance","imports":["lean:module:Init","lean:module:Mathlib.Data.Real.Basic","lean:module:Mathlib.Analysis.SpecialFunctions.Pow.Real"],"declarations":4,"chunks":1},{"@id":"lean:QOU.Archimedean.gauge_conformal_invariance","@type":"LeanDeclaration","name":"QOU.Archimedean.gauge_conformal_invariance","kind":"theorem","line":20,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/gauge-conformal-invariance.lean#L20-L31","doc":"Gauge conformal invariance of the eigenspace ratios.\nProves that the relative mathematical distance between any two emission\npoles is preserved under continuous deformations of the substrate q → q', \nup to a global conformal scaling factor α.\n","formalizes":[{"@id":"block:thm:gauge-conformal-invariance","label":"thm:gauge-conformal-invariance","md":"quantum-observable-universe/predicted-spectra/gauge-conformal-invariance.md"}],"signatureChunk":0},{"@id":"lean:QOU.Archimedean.eigenvalue_minus","@type":"LeanDeclaration","name":"QOU.Archimedean.eigenvalue_minus","kind":"def","line":17,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/gauge-conformal-invariance.lean#L17-L18","signatureChunk":0},{"@id":"lean:QOU.Archimedean.eigenvalue_plus","@type":"LeanDeclaration","name":"QOU.Archimedean.eigenvalue_plus","kind":"def","line":13,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/gauge-conformal-invariance.lean#L13-L15","doc":"The eigenvalues of T_{γe}: λ± = ½[h ± √(h² + 4)]. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.hecke","@type":"LeanDeclaration","name":"QOU.Archimedean.hecke","kind":"def","line":10,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/gauge-conformal-invariance.lean#L10-L11","doc":"The Hecke coefficient h = q - q⁻¹. ","signatureChunk":0}]}