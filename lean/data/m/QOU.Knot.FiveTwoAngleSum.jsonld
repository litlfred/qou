{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Knot.FiveTwoAngleSum","@type":"LeanModule","name":"QOU.Knot.FiveTwoAngleSum","imports":["lean:module:Init","lean:module:QOU.Knot.FiveTwoVolumeConstant"],"declarations":5,"chunks":1},{"@id":"lean:QOU.Knot.FiveTwoVolume.VOL_5_2_eq_three_mul_lob_sum","@type":"LeanDeclaration","name":"QOU.Knot.FiveTwoVolume.VOL_5_2_eq_three_mul_lob_sum","kind":"theorem","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/FiveTwoAngleSum.lean#L42-L50","doc":"**`VOL_5_2` is three times the Λ-sum over the 5₂ dihedral angles.**\n\nThis is what lets a bound proved for the angle functional — Rivin concavity, and\nthe `qou-52ch` chord — be read as a bound on `VOL_5_2`. ","signatureChunk":0},{"@id":"lean:QOU.Knot.FiveTwoVolume.fiveTwoTet_angle₃_pos","@type":"LeanDeclaration","name":"QOU.Knot.FiveTwoVolume.fiveTwoTet_angle₃_pos","kind":"theorem","line":40,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/FiveTwoAngleSum.lean#L40-L40","signatureChunk":0},{"@id":"lean:QOU.Knot.FiveTwoVolume.fiveTwoTet_angle₂_pos","@type":"LeanDeclaration","name":"QOU.Knot.FiveTwoVolume.fiveTwoTet_angle₂_pos","kind":"theorem","line":39,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/FiveTwoAngleSum.lean#L39-L39","signatureChunk":0},{"@id":"lean:QOU.Knot.FiveTwoVolume.fiveTwoTet_angle₁_pos","@type":"LeanDeclaration","name":"QOU.Knot.FiveTwoVolume.fiveTwoTet_angle₁_pos","kind":"theorem","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/FiveTwoAngleSum.lean#L38-L38","signatureChunk":0},{"@id":"lean:QOU.Knot.FiveTwoVolume.fiveTwoTet_angle_sum","@type":"LeanDeclaration","name":"QOU.Knot.FiveTwoVolume.fiveTwoTet_angle_sum","kind":"theorem","line":32,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/FiveTwoAngleSum.lean#L32-L36","doc":"The 5₂ tetrahedron's three dihedral angles sum to `π` — one of the two\nhypotheses Rivin concavity takes. ","signatureChunk":0}]}