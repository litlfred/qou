{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Braiding.crossing_energy_channels","@type":"LeanModule","name":"QOU.Braiding.crossing_energy_channels","imports":["lean:module:Init","lean:module:Mathlib.Analysis.SpecialFunctions.ExpDeriv","lean:module:Mathlib.Analysis.SpecialFunctions.Log.Basic"],"declarations":5,"chunks":1},{"@id":"lean:QOU.Braiding.asymChannel","@type":"LeanDeclaration","name":"QOU.Braiding.asymChannel","kind":"def","line":37,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Braiding/crossing_energy_channels.lean#L37-L41","doc":"Antisymmetric (Coulomb) channel of the composite. The multiplicity is\n`p + m`: the `sinh` part is sign-blind, contributing `+sinh λ` for a\nnegative crossing just as for a positive one. ","signatureChunk":0},{"@id":"lean:QOU.Braiding.symChannel","@type":"LeanDeclaration","name":"QOU.Braiding.symChannel","kind":"def","line":32,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Braiding/crossing_energy_channels.lean#L32-L35","doc":"Symmetric (strong-binding) channel of the composite. The multiplicity\nis `p - m`: the `cosh` part carries the crossing sign. ","signatureChunk":0},{"@id":"lean:QOU.Braiding.crossingEnergy","@type":"LeanDeclaration","name":"QOU.Braiding.crossingEnergy","kind":"def","line":27,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Braiding/crossing_energy_channels.lean#L27-L30","doc":"Total crossing energy of a composite with `p` positive and `m`\nnegative crossings: `p·q - m·q⁻¹`. ","signatureChunk":0},{"@id":"lean:QOU.Braiding.antisymmetricWeight","@type":"LeanDeclaration","name":"QOU.Braiding.antisymmetricWeight","kind":"def","line":24,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Braiding/crossing_energy_channels.lean#L24-L25","doc":"The antisymmetric (Coulomb) channel weight: sinh(ln q). ","signatureChunk":0},{"@id":"lean:QOU.Braiding.symmetricWeight","@type":"LeanDeclaration","name":"QOU.Braiding.symmetricWeight","kind":"def","line":21,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Braiding/crossing_energy_channels.lean#L21-L22","doc":"The symmetric (strong) channel weight: cosh(ln q). ","signatureChunk":0}]}