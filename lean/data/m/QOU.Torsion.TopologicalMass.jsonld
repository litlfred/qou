tps://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L196-L196","signatureChunk":0},{"@id":"lean:QOU.Torsion.DimensionOneReduction.dim","@type":"LeanDeclaration","name":"QOU.Torsion.DimensionOneReduction.dim","kind":"def","line":195,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L195-L195","signatureChunk":0},{"@id":"lean:QOU.Torsion.DimensionOneReduction.mk","@type":"LeanDeclaration","name":"QOU.Torsion.DimensionOneReduction.mk","kind":"ctor","line":194,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L194-L194","signatureChunk":0},{"@id":"lean:QOU.Torsion.DimensionOneReduction","@type":"LeanDeclaration","name":"QOU.Torsion.DimensionOneReduction","kind":"structure","line":192,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L192-L197","doc":"**Remark (Reduction at dimension 1).**\nLaTeX: `\\label{rem:descent-reduction}` ","signatureChunk":0},{"@id":"lean:QOU.Torsion.categorical_mass_pos_of_transient","@type":"LeanDeclaration","name":"QOU.Torsion.categorical_mass_pos_of_transient","kind":"theorem","line":179,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L179-L188","doc":"A categorical decomposition with at least one blow-up has\nstrictly positive mass if any transient contribution is positive. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.transient_le_mass_minus_descended","@type":"LeanDeclaration","name":"QOU.Torsion.transient_le_mass_minus_descended","kind":"theorem","line":170,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L170-L177","doc":"Each transient contribution is bounded by total mass minus descended. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.categorical_mass_ge_descended","@type":"LeanDeclaration","name":"QOU.Torsion.categorical_mass_ge_descended","kind":"theorem","line":162,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L162-L168","doc":"The categorical decomposition implies mass ≥ descended trace. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.CategoricalMassDecomposition.decomposition","@type":"LeanDeclaration","name":"QOU.Torsion.CategoricalMassDecomposition.decomposition","kind":"theorem","line":159,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L159-L159","doc":"The decomposition: mass = descended + Σ transient. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.CategoricalMassDecomposition.transient_nonneg","@type":"LeanDeclaration","name":"QOU.Torsion.CategoricalMassDecomposition.transient_nonneg","kind":"theorem","line":157,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L157-L157","signatureChunk":0},{"@id":"lean:QOU.Torsion.CategoricalMassDecomposition.transientTrace","@type":"LeanDeclaration","name":"QOU.Torsion.CategoricalMassDecomposition.transientTrace","kind":"def","line":156,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L156-L156","doc":"Transient trace `‖tr_trans(ϱ, pᵢ)‖` at each blow-up centre. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.CategoricalMassDecomposition.descended_nonneg","@type":"LeanDeclaration","name":"QOU.Torsion.CategoricalMassDecomposition.descended_nonneg","kind":"theorem","line":154,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L154-L154","signatureChunk":0},{"@id":"lean:QOU.Torsion.CategoricalMassDecomposition.descendedTrace","@type":"LeanDeclaration","name":"QOU.Torsion.CategoricalMassDecomposition.descendedTrace","kind":"def","line":153,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L153-L153","doc":"Descended trace `‖tr_desc(ϱ)‖`: the mass of the base-level\ncycle ϱ₀, capturing baseline Frobenius–Hopf drag. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.CategoricalMassDecomposition.totalMass_nonneg","@type":"LeanDeclaration","name":"QOU.Torsion.CategoricalMassDecomposition.totalMass_nonneg","kind":"theorem","line":150,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L150-L150","signatureChunk":0},{"@id":"lean:QOU.Torsion.CategoricalMassDecomposition.totalMass","@type":"LeanDeclaration","name":"QOU.Torsion.CategoricalMassDecomposition.totalMass","kind":"def","line":149,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L149-L149","doc":"The total categorical mass `𝔪(ϱ)`. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.CategoricalMassDecomposition.numBlowups","@type":"LeanDeclaration","name":"QOU.Torsion.CategoricalMassDecomposition.numBlowups","kind":"def","line":147,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L147-L147","doc":"Number of blow-up centres (exceptional divisors). ","signatureChunk":0},{"@id":"lean:QOU.Torsion.CategoricalMassDecomposition.di","@type":"LeanDeclaration","name":"QOU.Torsion.CategoricalMassDecomposition.di","kind":"def","line":145,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L145-L145","doc":"The descent involution on the endomorphism algebra. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.CategoricalMassDecomposition.mk","@type":"LeanDeclaration","name":"QOU.Torsion.CategoricalMassDecomposition.mk","kind":"ctor","line":143,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L143-L143","signatureChunk":0},{"@id":"lean:QOU.Torsion.CategoricalMassDecomposition","@type":"LeanDeclaration","name":"QOU.Torsion.CategoricalMassDecomposition","kind":"structure","line":137,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L137-L160","doc":"**Categorical Mass Decomposition** (data).\n\nThe mass of a vortex `ϱ : 𝟙 → A` decomposes into descended\nand transient contributions via the descent involution `τ̂ₙ`.\nThis is the categorical formulation — it works in any QOU,\nnot just the archimedean realisation. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.mass_single_blowup","@type":"LeanDeclaration","name":"QOU.Torsion.mass_single_blowup","kind":"theorem","line":114,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L114-L126","doc":"For a single blow-up, mass = baseline + one exceptional term. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.mass_unknot","@type":"LeanDeclaration","name":"QOU.Torsion.mass_unknot","kind":"theorem","line":104,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L104-L112","doc":"When there are no blow-ups, mass = baseline. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.mass_ge_baseline","@type":"LeanDeclaration","name":"QOU.Torsion.mass_ge_baseline","kind":"theorem","line":95,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L95-L102","doc":"The total mass is bounded below by the baseline holonomy. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.topological_mass_decomposition","@type":"LeanDeclaration","name":"QOU.Torsion.topological_mass_decomposition","kind":"theorem","line":89,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L89-L93","signatureChunk":0},{"@id":"lean:QOU.Torsion.TopologicalMassDecomposition.transient_supported_on_boundary","@type":"LeanDeclaration","name":"QOU.Torsion.TopologicalMassDecomposition.transient_supported_on_boundary","kind":"theorem","line":87,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L87-L87","signatureChunk":0},{"@id":"lean:QOU.Torsion.TopologicalMassDecomposition.baseline_is_descended","@type":"LeanDeclaration","name":"QOU.Torsion.TopologicalMassDecomposition.baseline_is_descended","kind":"theorem","line":81,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L81-L81","signatureChunk":0},{"@id":"lean:QOU.Torsion.TopologicalMassDecomposition.decomposition","@type":"LeanDeclaration","name":"QOU.Torsion.TopologicalMassDecomposition.decomposition","kind":"theorem","line":74,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L74-L74","signatureChunk":0},{"@id":"lean:QOU.Torsion.TopologicalMassDecomposition.totalMass_nonneg","@type":"LeanDeclaration","name":"QOU.Torsion.TopologicalMassDecomposition.totalMass_nonneg","kind":"theorem","line":73,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L73-L73","signatureChunk":0},{"@id":"lean:QOU.Torsion.TopologicalMassDecomposition.totalMass","@type":"LeanDeclaration","name":"QOU.Torsion.TopologicalMassDecomposition.totalMass","kind":"def","line":72,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L72-L72","signatureChunk":0},{"@id":"lean:QOU.Torsion.TopologicalMassDecomposition.exceptional_nonneg","@type":"LeanDeclaration","name":"QOU.Torsion.TopologicalMassDecomposition.exceptional_nonneg","kind":"theorem","line":71,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L71-L71","signatureChunk":0},{"@id":"lean:QOU.Torsion.TopologicalMassDecomposition.exceptionalContribution","@type":"LeanDeclaration","name":"QOU.Torsion.TopologicalMassDecomposition.exceptionalContribution","kind":"def","line":70,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L70-L70","signatureChunk":0},{"@id":"lean:QOU.Torsion.TopologicalMassDecomposition.baseline_nonneg","@type":"LeanDeclaration","name":"QOU.Torsion.TopologicalMassDecomposition.baseline_nonneg","kind":"theorem","line":69,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L69-L69","signatureChunk":0},{"@id":"lean:QOU.Torsion.TopologicalMassDecomposition.baselineHolonomy","@type":"LeanDeclaration","name":"QOU.Torsion.TopologicalMassDecomposition.baselineHolonomy","kind":"def","line":68,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L68-L68","signatureChunk":0},{"@id":"lean:QOU.Torsion.TopologicalMassDecomposition.numBlowups","@type":"LeanDeclaration","name":"QOU.Torsion.TopologicalMassDecomposition.numBlowups","kind":"def","line":67,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L67-L67","signatureChunk":0},{"@id":"lean:QOU.Torsion.TopologicalMassDecomposition.bb","@type":"LeanDeclaration","name":"QOU.Torsion.TopologicalMassDecomposition.bb","kind":"def","line":66,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L66-L66","signatureChunk":0},{"@id":"lean:QOU.Torsion.TopologicalMassDecomposition.di","@type":"LeanDeclaration","name":"QOU.Torsion.TopologicalMassDecomposition.di","kind":"def","line":65,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L65-L65","signatureChunk":0},{"@id":"lean:QOU.Torsion.TopologicalMassDecomposition.mi","@type":"LeanDeclaration","name":"QOU.Torsion.TopologicalMassDecomposition.mi","kind":"def","line":64,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L64-L64","signatureChunk":0},{"@id":"lean:QOU.Torsion.TopologicalMassDecomposition.mk","@type":"LeanDeclaration","name":"QOU.Torsion.TopologicalMassDecomposition.mk","kind":"ctor","line":63,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L63-L63","signatureChunk":0},{"@id":"lean:QOU.Torsion.TopologicalMassDecomposition","@type":"LeanDeclaration","name":"QOU.Torsion.TopologicalMassDecomposition","kind":"structure","line":61,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L61-L87","doc":"**Topological Decomposition of Mass** (data).\nLaTeX: `\\label{thm:topological-mass}` ","signatureChunk":0},{"@id":"lean:QOU.Torsion.qNumber_pos","@type":"LeanDeclaration","name":"QOU.Torsion.qNumber_pos","kind":"theorem","line":41,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L41-L59","doc":"The q-number `[n]_q` is positive for `q > 0` and `n ≥ 1`. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.qNumber_eq_canonical","@type":"LeanDeclaration","name":"QOU.Torsion.qNumber_eq_canonical","kind":"theorem","line":27,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L27-L39","doc":"**Bridge to the canonical guarded geometric bracket.**\n\n`qNumber` is kept rather than aliased: its proofs below (`qNumber_pos`) need the\nclosed form `(qⁿ−1)/(q−1)` syntactically, and swapping the body for\n`qIntGeoCl`'s `Finset.sum` makes them fail. Consolidation here is this equation,\nnot a substitution — the two are the same function, and that is now proved\nrather than left to a comment. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.qNumber","@type":"LeanDeclaration","name":"QOU.Torsion.qNumber","kind":"def","line":22,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/TopologicalMass.lean#L22-L25","doc":"**Quantum dilogarithm**: `Φ_q(z) = ∫₀ᶻ ln_q(1+t)/t dt`. ","signatureChunk":0}]}