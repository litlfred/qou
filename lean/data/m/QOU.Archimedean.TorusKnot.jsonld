{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Archimedean.TorusKnot","@type":"LeanModule","name":"QOU.Archimedean.TorusKnot","imports":["lean:module:Init","lean:module:QOU.Archimedean.GroundRing","lean:module:Mathlib.Data.Nat.GCD.Basic","lean:module:Mathlib.Tactic"],"declarations":26,"chunks":1},{"@id":"lean:QOU.Archimedean.magicNumbers","@type":"LeanDeclaration","name":"QOU.Archimedean.magicNumbers","kind":"def","line":128,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TorusKnot.lean#L128-L129","doc":"Magic numbers: cumulative shell sizes `{2, 8, 20, 28, 50, 82, 126}`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TorusKnotLabel.shellNumber","@type":"LeanDeclaration","name":"QOU.Archimedean.TorusKnotLabel.shellNumber","kind":"def","line":118,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TorusKnot.lean#L118-L126","doc":"The shell number assigned to a torus knot on Σ₄. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.tau_2_11_not_embeddable","@type":"LeanDeclaration","name":"QOU.Archimedean.tau_2_11_not_embeddable","kind":"theorem","line":111,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TorusKnot.lean#L111-L114","doc":"No torus knot `τ(2,11)` is embeddable on Σ₄ (needs genus 5). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.sigma4_knots_embeddable","@type":"LeanDeclaration","name":"QOU.Archimedean.sigma4_knots_embeddable","kind":"theorem","line":102,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TorusKnot.lean#L102-L109","doc":"All 6 knots are embeddable on Σ₄. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.embeddableKnots","@type":"LeanDeclaration","name":"QOU.Archimedean.embeddableKnots","kind":"def","line":96,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TorusKnot.lean#L96-L100","doc":"The set of embeddable torus knots on a genus-`g` surface. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.sigma4_knots","@type":"LeanDeclaration","name":"QOU.Archimedean.sigma4_knots","kind":"def","line":92,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TorusKnot.lean#L92-L94","doc":"The 6 embeddable torus knots on Σ₄ (genus 4). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.strong_label","@type":"LeanDeclaration","name":"QOU.Archimedean.strong_label","kind":"def","line":89,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TorusKnot.lean#L89-L90","doc":"Strong binding: `τ(2,9) = τ(2,3²)` (degree-2 trefoil tower). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.weak_label","@type":"LeanDeclaration","name":"QOU.Archimedean.weak_label","kind":"def","line":86,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TorusKnot.lean#L86-L87","doc":"Weak vertex: `τ(3,5)`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.t_label","@type":"LeanDeclaration","name":"QOU.Archimedean.t_label","kind":"def","line":83,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TorusKnot.lean#L83-L84","doc":"Top: `t = τ(3,4)` (degree-2 Hopf tower). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.c_label","@type":"LeanDeclaration","name":"QOU.Archimedean.c_label","kind":"def","line":80,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TorusKnot.lean#L80-L81","doc":"Charm / third generation: `c = τ(2,7)`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.gen2_label","@type":"LeanDeclaration","name":"QOU.Archimedean.gen2_label","kind":"def","line":77,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TorusKnot.lean#L77-L78","doc":"Second generation: `τ(2,5)` (cinquefoil). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.e_label","@type":"LeanDeclaration","name":"QOU.Archimedean.e_label","kind":"def","line":74,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TorusKnot.lean#L74-L75","doc":"Electron / up quark: `e = τ(2,3)` (trefoil). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TorusKnotLabel.degree","@type":"LeanDeclaration","name":"QOU.Archimedean.TorusKnotLabel.degree","kind":"def","line":59,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TorusKnot.lean#L59-L68","doc":"The degree of a torus knot in the degree tower.\n`τ(r, p^k)` has degree `k` where `p` is the largest prime\npower dividing `s`.  For simplicity, we define degree as:\n- degree 1 if `s` is prime or 1\n- degree 2 if `s` is a perfect square of a prime\n- degree k if `s = p^k` for some prime p ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.instDecidableEmbeddableOn","@type":"LeanDeclaration","name":"QOU.Archimedean.instDecidableEmbeddableOn","kind":"instance","line":56,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TorusKnot.lean#L56-L57","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TorusKnotLabel.embeddableOn","@type":"LeanDeclaration","name":"QOU.Archimedean.TorusKnotLabel.embeddableOn","kind":"def","line":51,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TorusKnot.lean#L51-L54","doc":"A torus knot `τ(r,s)` is embeddable on a genus-`g` surface iff\nits Seifert rank fits: `(r−1)(s−1)/2 ≤ g`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TorusKnotLabel.product","@type":"LeanDeclaration","name":"QOU.Archimedean.TorusKnotLabel.product","kind":"def","line":46,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TorusKnot.lean#L46-L47","doc":"The product invariant `r × s`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TorusKnotLabel.crossings","@type":"LeanDeclaration","name":"QOU.Archimedean.TorusKnotLabel.crossings","kind":"def","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TorusKnot.lean#L42-L44","doc":"The number of crossings of `τ(r,s)`: `min(r(s−1), s(r−1))`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TorusKnotLabel.seifertRank","@type":"LeanDeclaration","name":"QOU.Archimedean.TorusKnotLabel.seifertRank","kind":"def","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TorusKnot.lean#L36-L40","doc":"The Seifert genus of a torus knot: `g(T_{r,s}) = (r−1)(s−1)/2`.\nReturns the Seifert rank (numerator); the actual genus is this\ndivided by 2 (which is always an integer for coprime r, s). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.«termτ(_,_)»","@type":"LeanDeclaration","name":"QOU.Archimedean.«termτ(_,_)»","kind":"def","line":33,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TorusKnot.lean#L33-L34","doc":"Notation: `τ(r,s)` for a torus knot label. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TorusKnotLabel.coprime","@type":"LeanDeclaration","name":"QOU.Archimedean.TorusKnotLabel.coprime","kind":"theorem","line":31,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TorusKnot.lean#L31-L31","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TorusKnotLabel.r_lt_s","@type":"LeanDeclaration","name":"QOU.Archimedean.TorusKnotLabel.r_lt_s","kind":"theorem","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TorusKnot.lean#L30-L30","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TorusKnotLabel.r_ge_two","@type":"LeanDeclaration","name":"QOU.Archimedean.TorusKnotLabel.r_ge_two","kind":"theorem","line":29,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TorusKnot.lean#L29-L29","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TorusKnotLabel.s","@type":"LeanDeclaration","name":"QOU.Archimedean.TorusKnotLabel.s","kind":"def","line":28,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TorusKnot.lean#L28-L28","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TorusKnotLabel.r","@type":"LeanDeclaration","name":"QOU.Archimedean.TorusKnotLabel.r","kind":"def","line":27,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TorusKnot.lean#L27-L27","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TorusKnotLabel.mk","@type":"LeanDeclaration","name":"QOU.Archimedean.TorusKnotLabel.mk","kind":"ctor","line":26,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TorusKnot.lean#L26-L26","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TorusKnotLabel","@type":"LeanDeclaration","name":"QOU.Archimedean.TorusKnotLabel","kind":"structure","line":24,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TorusKnot.lean#L24-L31","doc":"A torus knot label `τ(r, s)` with `r` strands and `s` winding.\nConvention: `2 ≤ r`, `r < s`, `gcd(r, s) = 1`. ","signatureChunk":0}]}