{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:MolecularConstruction.TetrahedralHbondDirections","@type":"LeanModule","name":"MolecularConstruction.TetrahedralHbondDirections","imports":["lean:module:Init","lean:module:Mathlib.Tactic"],"declarations":9,"chunks":1},{"@id":"lean:QOU.Molecular.tetrahedral_cos","@type":"LeanDeclaration","name":"QOU.Molecular.tetrahedral_cos","kind":"theorem","line":46,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/tetrahedral-hbond-directions.lean#L46-L49","doc":"**Tetrahedral bond-angle cosine `= -1/3`** — the symmetric reference\nangle `θ₀ = arccos(-1/3) ≈ 109.47°` of the water bent-geometry shift. ","formalizes":[{"@id":"block:prop:tetrahedral-hbond-directions","label":"prop:tetrahedral-hbond-directions","md":"quantum-observable-universe/molecular-construction/tetrahedral-hbond-directions.md"}],"signatureChunk":0},{"@id":"lean:QOU.Molecular.tetra_dot12","@type":"LeanDeclaration","name":"QOU.Molecular.tetra_dot12","kind":"theorem","line":43,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/tetrahedral-hbond-directions.lean#L43-L44","doc":"Any two distinct directions have dot product `-1`. ","signatureChunk":0},{"@id":"lean:QOU.Molecular.tetra_normSq","@type":"LeanDeclaration","name":"QOU.Molecular.tetra_normSq","kind":"theorem","line":40,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/tetrahedral-hbond-directions.lean#L40-L41","doc":"Each direction has squared length `3` (so `|tᵢ| = √3`). ","signatureChunk":0},{"@id":"lean:QOU.Molecular.tetra_sum_zero","@type":"LeanDeclaration","name":"QOU.Molecular.tetra_sum_zero","kind":"theorem","line":33,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/tetrahedral-hbond-directions.lean#L33-L38","doc":"The four directions sum to zero (balanced coordination). ","signatureChunk":0},{"@id":"lean:QOU.Molecular.t4","@type":"LeanDeclaration","name":"QOU.Molecular.t4","kind":"def","line":31,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/tetrahedral-hbond-directions.lean#L31-L31","signatureChunk":0},{"@id":"lean:QOU.Molecular.t3","@type":"LeanDeclaration","name":"QOU.Molecular.t3","kind":"def","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/tetrahedral-hbond-directions.lean#L30-L30","signatureChunk":0},{"@id":"lean:QOU.Molecular.t2","@type":"LeanDeclaration","name":"QOU.Molecular.t2","kind":"def","line":29,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/tetrahedral-hbond-directions.lean#L29-L29","signatureChunk":0},{"@id":"lean:QOU.Molecular.t1","@type":"LeanDeclaration","name":"QOU.Molecular.t1","kind":"def","line":27,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/tetrahedral-hbond-directions.lean#L27-L28","doc":"Four tetrahedral vertex directions. ","signatureChunk":0},{"@id":"lean:QOU.Molecular.dot3","@type":"LeanDeclaration","name":"QOU.Molecular.dot3","kind":"def","line":24,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/tetrahedral-hbond-directions.lean#L24-L25","doc":"Dot product on `ℝ³`. ","signatureChunk":0}]}