{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.QuarkState.DeltaSIsWeakVertexSum","@type":"LeanModule","name":"QOU.QuarkState.DeltaSIsWeakVertexSum","imports":["lean:module:Init","lean:module:QOU.QuarkState.OneSidedWeakVertex"],"declarations":3,"chunks":1},{"@id":"lean:QOU.QuarkState.DeltaSIsWeakVertexSum.deltaS_eq_weakVertex_sum","@type":"LeanDeclaration","name":"QOU.QuarkState.DeltaSIsWeakVertexSum.deltaS_eq_weakVertex_sum","kind":"theorem","line":67,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuarkState/DeltaSIsWeakVertexSum.lean#L67-L76","doc":"**`Δ_S` is the weak vertex summed over the two crossings** (both `s_i` letters). ","signatureChunk":0},{"@id":"lean:QOU.QuarkState.DeltaSIsWeakVertexSum.deltaS_eq_grading_sum","@type":"LeanDeclaration","name":"QOU.QuarkState.DeltaSIsWeakVertexSum.deltaS_eq_grading_sum","kind":"theorem","line":43,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuarkState/DeltaSIsWeakVertexSum.lean#L43-L65","doc":"**`Δ_S` is a multiple of the sum of the two chirality gradings.** ","signatureChunk":0},{"@id":"lean:QOU.QuarkState.DeltaSIsWeakVertexSum.deltaS","@type":"LeanDeclaration","name":"QOU.QuarkState.DeltaSIsWeakVertexSum.deltaS","kind":"def","line":39,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuarkState/DeltaSIsWeakVertexSum.lean#L39-L41","doc":"The single-wrap element `Δ_S = (h²/2)·1 − (h/2)(s₁ + s₂)`. ","signatureChunk":0}]}