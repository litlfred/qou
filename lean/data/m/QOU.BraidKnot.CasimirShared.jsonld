.lean#L202-L202","doc":"Braid relation: T_i T_{i+1} T_i = T_{i+1} T_i T_{i+1}. ","signatureChunk":0},{"@id":"lean:QOU.Braiding.HeckeAlgebra.T","@type":"LeanDeclaration","name":"QOU.Braiding.HeckeAlgebra.T","kind":"def","line":200,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L200-L200","doc":"Generators T₁, …, T_{n-1}. ","signatureChunk":0},{"@id":"lean:QOU.Braiding.HeckeAlgebra.smul","@type":"LeanDeclaration","name":"QOU.Braiding.HeckeAlgebra.smul","kind":"def","line":198,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L198-L198","doc":"Scalar multiplication by `R_q`. ","signatureChunk":0},{"@id":"lean:QOU.Braiding.HeckeAlgebra.sub","@type":"LeanDeclaration","name":"QOU.Braiding.HeckeAlgebra.sub","kind":"def","line":196,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L196-L196","doc":"Subtraction. ","signatureChunk":0},{"@id":"lean:QOU.Braiding.HeckeAlgebra.zero","@type":"LeanDeclaration","name":"QOU.Braiding.HeckeAlgebra.zero","kind":"def","line":194,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L194-L194","doc":"Zero element. ","signatureChunk":0},{"@id":"lean:QOU.Braiding.HeckeAlgebra.one","@type":"LeanDeclaration","name":"QOU.Braiding.HeckeAlgebra.one","kind":"def","line":192,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L192-L192","doc":"Unit element. ","signatureChunk":0},{"@id":"lean:QOU.Braiding.HeckeAlgebra.mul","@type":"LeanDeclaration","name":"QOU.Braiding.HeckeAlgebra.mul","kind":"def","line":190,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L190-L190","doc":"Multiplication. ","signatureChunk":0},{"@id":"lean:QOU.Braiding.HeckeAlgebra.q_mul_inv","@type":"LeanDeclaration","name":"QOU.Braiding.HeckeAlgebra.q_mul_inv","kind":"theorem","line":188,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L188-L188","doc":"Defining relation `q · q⁻¹ = 1`. ","signatureChunk":0},{"@id":"lean:QOU.Braiding.HeckeAlgebra.q_inv","@type":"LeanDeclaration","name":"QOU.Braiding.HeckeAlgebra.q_inv","kind":"def","line":186,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L186-L186","doc":"Inverse parameter q⁻¹ carried as data. ","signatureChunk":0},{"@id":"lean:QOU.Braiding.HeckeAlgebra.q_ne_zero","@type":"LeanDeclaration","name":"QOU.Braiding.HeckeAlgebra.q_ne_zero","kind":"theorem","line":184,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L184-L184","doc":"q ≠ 0. ","signatureChunk":0},{"@id":"lean:QOU.Braiding.HeckeAlgebra.q","@type":"LeanDeclaration","name":"QOU.Braiding.HeckeAlgebra.q","kind":"def","line":182,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L182-L182","doc":"Deformation parameter q. ","signatureChunk":0},{"@id":"lean:QOU.Braiding.HeckeAlgebra.carrier","@type":"LeanDeclaration","name":"QOU.Braiding.HeckeAlgebra.carrier","kind":"def","line":180,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L180-L180","doc":"Carrier type. ","signatureChunk":0},{"@id":"lean:QOU.Braiding.HeckeAlgebra.n","@type":"LeanDeclaration","name":"QOU.Braiding.HeckeAlgebra.n","kind":"def","line":178,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L178-L178","doc":"Number of strands. ","signatureChunk":0},{"@id":"lean:QOU.Braiding.HeckeAlgebra.mk","@type":"LeanDeclaration","name":"QOU.Braiding.HeckeAlgebra.mk","kind":"ctor","line":176,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L176-L176","signatureChunk":0},{"@id":"lean:QOU.Braiding.HeckeAlgebra","@type":"LeanDeclaration","name":"QOU.Braiding.HeckeAlgebra","kind":"structure","line":173,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L173-L208","doc":"**Hecke algebra H_n(q)**: the quotient of the group algebra k[B_n]\nby the quadratic relation (σ_i − q)(σ_i + q⁻¹) = 0. ","signatureChunk":0},{"@id":"lean:QOU.Braiding.q_inv_param","@type":"LeanDeclaration","name":"QOU.Braiding.q_inv_param","kind":"def","line":171,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L171-L171","signatureChunk":0},{"@id":"lean:QOU.Braiding.q_param","@type":"LeanDeclaration","name":"QOU.Braiding.q_param","kind":"def","line":170,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L170-L170","signatureChunk":0},{"@id":"lean:QOU.Braiding.R_q","@type":"LeanDeclaration","name":"QOU.Braiding.R_q","kind":"def","line":168,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L168-L169","doc":"Ground ring `R_q = ℤ[q, q⁻¹]` (Laurent polynomials over ℤ). ","signatureChunk":0},{"@id":"lean:QOU.QCasimir","@type":"LeanDeclaration","name":"QOU.QCasimir","kind":"def","line":151,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L151-L160","doc":"The (normalised) q-Casimir element inside `qs.Algebra`:\n\n`C_q = F·E + (q·K + q⁻¹·K⁻¹ - (q + q⁻¹)) · (q - q⁻¹)⁻²`. ","formalizes":[{"@id":"block:def:q-casimir","label":"def:q-casimir","md":"quantum-observable-universe/braids-and-knots/q-casimir.md"}],"signatureChunk":0},{"@id":"lean:QOU.QCasimirData.ι_qInv_right","@type":"LeanDeclaration","name":"QOU.QCasimirData.ι_qInv_right","kind":"theorem","line":143,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L143-L147","doc":"Symmetric counterpart of `ι_qInv_left`. ","signatureChunk":0},{"@id":"lean:QOU.QCasimirData.ι_qInv_left","@type":"LeanDeclaration","name":"QOU.QCasimirData.ι_qInv_left","kind":"theorem","line":136,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L136-L141","doc":"The qInv field genuinely behaves as `q⁻¹`: applying `ι` and\nmultiplying recovers `1` in the algebra. ","signatureChunk":0},{"@id":"lean:QOU.QCasimirData.qInv_unique","@type":"LeanDeclaration","name":"QOU.QCasimirData.qInv_unique","kind":"theorem","line":125,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L125-L134","doc":"Inverses in a (commutative) ring are unique: the `qInv` field is\ndetermined by the `qInv_left` witness alone. ","signatureChunk":0},{"@id":"lean:QOU.QCasimirData.invQm_central","@type":"LeanDeclaration","name":"QOU.QCasimirData.invQm_central","kind":"theorem","line":119,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L119-L119","doc":"`invQm` is central. ","signatureChunk":0},{"@id":"lean:QOU.QCasimirData.invQm_right","@type":"LeanDeclaration","name":"QOU.QCasimirData.invQm_right","kind":"theorem","line":117,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L117-L117","doc":"Witness that `invQm` is a right inverse. ","signatureChunk":0},{"@id":"lean:QOU.QCasimirData.invQm_left","@type":"LeanDeclaration","name":"QOU.QCasimirData.invQm_left","kind":"theorem","line":115,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L115-L115","doc":"Left inverse witness for `invQm`. ","signatureChunk":0},{"@id":"lean:QOU.QCasimirData.invQm","@type":"LeanDeclaration","name":"QOU.QCasimirData.invQm","kind":"def","line":113,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L113-L113","doc":"An algebra element that inverts `ι (q - qInv)`. ","signatureChunk":0},{"@id":"lean:QOU.QCasimirData.ι_central","@type":"LeanDeclaration","name":"QOU.QCasimirData.ι_central","kind":"theorem","line":111,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L111-L111","doc":"The image of `ι` lies in the centre of `qs.Algebra`. ","signatureChunk":0},{"@id":"lean:QOU.QCasimirData.ι","@type":"LeanDeclaration","name":"QOU.QCasimirData.ι","kind":"def","line":109,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L109-L109","doc":"Embedding of the ground ring into the algebra. ","signatureChunk":0},{"@id":"lean:QOU.QCasimirData.qInv_right","@type":"LeanDeclaration","name":"QOU.QCasimirData.qInv_right","kind":"theorem","line":107,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L107-L107","doc":"Witness that `qInv` is a right inverse. ","signatureChunk":0},{"@id":"lean:QOU.QCasimirData.qInv_left","@type":"LeanDeclaration","name":"QOU.QCasimirData.qInv_left","kind":"theorem","line":105,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L105-L105","doc":"Left inverse witness for `qInv`. ","signatureChunk":0},{"@id":"lean:QOU.QCasimirData.qInv","@type":"LeanDeclaration","name":"QOU.QCasimirData.qInv","kind":"def","line":103,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L103-L103","doc":"Explicit inverse of `q` in the ground ring. ","signatureChunk":0},{"@id":"lean:QOU.QCasimirData.mk","@type":"LeanDeclaration","name":"QOU.QCasimirData.mk","kind":"ctor","line":101,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L101-L101","signatureChunk":0},{"@id":"lean:QOU.QCasimirData","@type":"LeanDeclaration","name":"QOU.QCasimirData","kind":"structure","line":93,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L93-L119","doc":"Parameter bundle for constructing the q-Casimir element.\n\nWe carry explicit inverses of `q` and of `(q − qInv)` with two-sided\nwitnesses, plus a central embedding `ι : R_q →+* qs.Algebra`, so that the\nconstruction never invokes a field-style `⁻¹` on an abstract coefficient. ","signatureChunk":0},{"@id":"lean:QOU.qInt_two","@type":"LeanDeclaration","name":"QOU.qInt_two","kind":"theorem","line":84,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L84-L89","doc":"[2]_q = q + 1. ","signatureChunk":0},{"@id":"lean:QOU.qInt_one","@type":"LeanDeclaration","name":"QOU.qInt_one","kind":"theorem","line":79,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L79-L82","doc":"[1]_q = 1 for all q ≠ 1. ","signatureChunk":0},{"@id":"lean:QOU.QuantumSu2.qInt","@type":"LeanDeclaration","name":"QOU.QuantumSu2.qInt","kind":"def","line":74,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L74-L77","doc":"The q-integer [n]_q = (qⁿ - 1)/(q - 1). ","signatureChunk":0},{"@id":"lean:QOU.QuantumSu2.K_inv_right","@type":"LeanDeclaration","name":"QOU.QuantumSu2.K_inv_right","kind":"theorem","line":70,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L70-L70","signatureChunk":0},{"@id":"lean:QOU.QuantumSu2.K_inv_left","@type":"LeanDeclaration","name":"QOU.QuantumSu2.K_inv_left","kind":"theorem","line":69,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L69-L69","doc":"K · K⁻¹ = 1. ","signatureChunk":0},{"@id":"lean:QOU.QuantumSu2.K_inv","@type":"LeanDeclaration","name":"QOU.QuantumSu2.K_inv","kind":"def","line":67,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L67-L67","signatureChunk":0},{"@id":"lean:QOU.QuantumSu2.K","@type":"LeanDeclaration","name":"QOU.QuantumSu2.K","kind":"def","line":66,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L66-L66","signatureChunk":0},{"@id":"lean:QOU.QuantumSu2.F","@type":"LeanDeclaration","name":"QOU.QuantumSu2.F","kind":"def","line":65,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L65-L65","signatureChunk":0},{"@id":"lean:QOU.QuantumSu2.E","@type":"LeanDeclaration","name":"QOU.QuantumSu2.E","kind":"def","line":64,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L64-L64","doc":"Generators E, F, K, K⁻¹. ","signatureChunk":0},{"@id":"lean:QOU.QuantumSu2.instRing","@type":"LeanDeclaration","name":"QOU.QuantumSu2.instRing","kind":"def","line":62,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L62-L62","signatureChunk":0},{"@id":"lean:QOU.QuantumSu2.Algebra","@type":"LeanDeclaration","name":"QOU.QuantumSu2.Algebra","kind":"def","line":61,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L61-L61","doc":"The algebra carrier type. ","signatureChunk":0},{"@id":"lean:QOU.QuantumSu2.q_ne_one","@type":"LeanDeclaration","name":"QOU.QuantumSu2.q_ne_one","kind":"theorem","line":59,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L59-L59","signatureChunk":0},{"@id":"lean:QOU.QuantumSu2.q","@type":"LeanDeclaration","name":"QOU.QuantumSu2.q","kind":"def","line":58,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L58-L58","doc":"The deformation parameter q > 0, q ≠ 1. ","signatureChunk":0},{"@id":"lean:QOU.QuantumSu2.mk","@type":"LeanDeclaration","name":"QOU.QuantumSu2.mk","kind":"ctor","line":56,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L56-L56","signatureChunk":0},{"@id":"lean:QOU.QuantumSu2","@type":"LeanDeclaration","name":"QOU.QuantumSu2","kind":"structure","line":54,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L54-L70","doc":"**Quantum group 𝒰_q(𝔰𝔲(2))** generator data. ","formalizes":[{"@id":"block:def:quantum-su2","label":"def:quantum-su2","md":"quantum-observable-universe/braids-and-knots/quantum-su2.md"}],"signatureChunk":0},{"@id":"lean:QOU.q_inv_param","@type":"LeanDeclaration","name":"QOU.q_inv_param","kind":"def","line":51,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L51-L52","doc":"The formal inverse `q⁻¹` of the indeterminate in `R_q = ℚ(q)`. ","signatureChunk":0},{"@id":"lean:QOU.q_param","@type":"LeanDeclaration","name":"QOU.q_param","kind":"def","line":48,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/CasimirShared.lean#L48-L49","doc":"The canonical indeterminate `q` of `R_q 