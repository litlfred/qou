{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QuantumUniverses.QuantumUniverseSu2","@type":"LeanModule","name":"QuantumUniverses.QuantumUniverseSu2","imports":["lean:module:Init","lean:module:Mathlib.CategoryTheory.Monoidal.Category","lean:module:Mathlib.CategoryTheory.Category.Basic"],"declarations":18,"chunks":1},{"@id":"lean:QOU.Examples.su2_calculus_dim","@type":"LeanDeclaration","name":"QOU.Examples.su2_calculus_dim","kind":"theorem","line":89,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/quantum-universe-su2.lean#L89-L91","doc":"The 3D left-invariant calculus has structure constants ε_{abc}\n(Levi-Civita symbol): [e_a, e_b] = ε_{abc} e_c. ","signatureChunk":0},{"@id":"lean:QOU.Examples.su2HaarFrobenius","@type":"LeanDeclaration","name":"QOU.Examples.su2HaarFrobenius","kind":"def","line":81,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/quantum-universe-su2.lean#L81-L87","doc":"Haar integral on O(SU(2)) is a valid Frobenius form. ","signatureChunk":0},{"@id":"lean:QOU.Examples.HaarFrobeniusData.calculus_eq","@type":"LeanDeclaration","name":"QOU.Examples.HaarFrobeniusData.calculus_eq","kind":"theorem","line":79,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/quantum-universe-su2.lean#L79-L79","doc":"3D left-invariant calculus. ","signatureChunk":0},{"@id":"lean:QOU.Examples.HaarFrobeniusData.calculusRank","@type":"LeanDeclaration","name":"QOU.Examples.HaarFrobeniusData.calculusRank","kind":"def","line":77,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/quantum-universe-su2.lean#L77-L77","doc":"The Lie algebra dimension determines the calculus rank. ","signatureChunk":0},{"@id":"lean:QOU.Examples.HaarFrobeniusData.generators_eq","@type":"LeanDeclaration","name":"QOU.Examples.HaarFrobeniusData.generators_eq","kind":"theorem","line":75,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/quantum-universe-su2.lean#L75-L75","doc":"O(SU(2)) has 4 generators. ","signatureChunk":0},{"@id":"lean:QOU.Examples.HaarFrobeniusData.numGenerators","@type":"LeanDeclaration","name":"QOU.Examples.HaarFrobeniusData.numGenerators","kind":"def","line":73,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/quantum-universe-su2.lean#L73-L73","doc":"Dimension of the coordinate algebra. ","signatureChunk":0},{"@id":"lean:QOU.Examples.HaarFrobeniusData.mk","@type":"LeanDeclaration","name":"QOU.Examples.HaarFrobeniusData.mk","kind":"ctor","line":71,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/quantum-universe-su2.lean#L71-L71","signatureChunk":0},{"@id":"lean:QOU.Examples.HaarFrobeniusData","@type":"LeanDeclaration","name":"QOU.Examples.HaarFrobeniusData","kind":"structure","line":65,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/quantum-universe-su2.lean#L65-L79","doc":"The Frobenius form on O(SU(2)) is the Haar integral ∫_G.\n\nKey properties:\n- Faithful: ∫(f*f) = 0 ⟹ f = 0\n- Normalized: ∫(1_A) = 1\n- Invariant: ∫(f·g) = ∫(g·f) (tracial) ","signatureChunk":0},{"@id":"lean:QOU.Examples.su2QuantumUniverse","@type":"LeanDeclaration","name":"QOU.Examples.su2QuantumUniverse","kind":"def","line":55,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/quantum-universe-su2.lean#L55-L63","doc":"The SU(2) quantum universe instance. ","formalizes":[{"@id":"block:ex:quantum-universe-su2","label":"ex:quantum-universe-su2","md":"quantum-observable-universe/quantum-universes/quantum-universe-su2.md"}],"signatureChunk":0},{"@id":"lean:QOU.Examples.su2_tannaka_faithful","@type":"LeanDeclaration","name":"QOU.Examples.su2_tannaka_faithful","kind":"theorem","line":46,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/quantum-universe-su2.lean#L46-L53","doc":"Tannaka–Krein faithfulness: the forgetful functor τ : Rep(SU(2)) → Vect\nis faithful, and Aut⊗(τ) ≅ SU(2). This is a classical result requiring\nTannaka reconstruction for compact groups. ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2QuantumUniverseData.coord_gens","@type":"LeanDeclaration","name":"QOU.Examples.SU2QuantumUniverseData.coord_gens","kind":"theorem","line":44,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/quantum-universe-su2.lean#L44-L44","doc":"O(SU(2)) has 4 generators: α, β, ᾱ, β̄. ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2QuantumUniverseData.numCoordGenerators","@type":"LeanDeclaration","name":"QOU.Examples.SU2QuantumUniverseData.numCoordGenerators","kind":"def","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/quantum-universe-su2.lean#L42-L42","doc":"Number of generators of O(SU(2)). ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2QuantumUniverseData.lie_dim","@type":"LeanDeclaration","name":"QOU.Examples.SU2QuantumUniverseData.lie_dim","kind":"theorem","line":40,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/quantum-universe-su2.lean#L40-L40","doc":"su(2) has dimension 3 → three left-invariant 1-forms. ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2QuantumUniverseData.lieAlgDim","@type":"LeanDeclaration","name":"QOU.Examples.SU2QuantumUniverseData.lieAlgDim","kind":"def","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/quantum-universe-su2.lean#L38-L38","doc":"The Lie algebra dimension (= dim Ω¹(A) as free A-module rank). ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2QuantumUniverseData.fund_dim","@type":"LeanDeclaration","name":"QOU.Examples.SU2QuantumUniverseData.fund_dim","kind":"theorem","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/quantum-universe-su2.lean#L36-L36","doc":"V_{1/2} ≅ ℂ². ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2QuantumUniverseData.dimFundamental","@type":"LeanDeclaration","name":"QOU.Examples.SU2QuantumUniverseData.dimFundamental","kind":"def","line":34,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/quantum-universe-su2.lean#L34-L34","doc":"Dimension of the fundamental representation V = V_{1/2}. ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2QuantumUniverseData.mk","@type":"LeanDeclaration","name":"QOU.Examples.SU2QuantumUniverseData.mk","kind":"ctor","line":32,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/quantum-universe-su2.lean#L32-L32","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2QuantumUniverseData","@type":"LeanDeclaration","name":"QOU.Examples.SU2QuantumUniverseData","kind":"structure","line":27,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/quantum-universe-su2.lean#L27-L44","doc":"**SU(2) quantum universe data**: concrete numerical invariants\nwitnessing that Rep(SU(2)) satisfies the quantum universe axioms.\n\nLaTeX: `\\label{ex:quantum-universe-su2}` ","signatureChunk":0}]}