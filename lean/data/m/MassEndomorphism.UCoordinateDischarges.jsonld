{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:MassEndomorphism.UCoordinateDischarges","@type":"LeanModule","name":"MassEndomorphism.UCoordinateDischarges","imports":["lean:module:Init","lean:module:Mathlib.Tactic","lean:module:QOU.BraidKnot.QBetaCategoricalPrecisionLadder","lean:module:QOU.BraidKnot.HoefsmitV21CosSymmetrization","lean:module:QOU.BraidKnot.H3HeckeIdempotents"],"declarations":7,"chunks":1},{"@id":"lean:QOU.BraidKnot.dimQ_sq_sum_H3_in_u","@type":"LeanDeclaration","name":"QOU.BraidKnot.dimQ_sq_sum_H3_in_u","kind":"theorem","line":113,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-endomorphism/u-coordinate-discharges.lean#L113-L120","doc":"Sum of squared q-dimensions at H_3 equals `u + 4 + u⁻¹` with\n`u = q²`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.sigma_eigval_V111_sq_eq_u_inv","@type":"LeanDeclaration","name":"QOU.BraidKnot.sigma_eigval_V111_sq_eq_u_inv","kind":"theorem","line":100,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-endomorphism/u-coordinate-discharges.lean#L100-L104","doc":"σ_i eigenvalue squared on `V_(1,1,1)` equals `u⁻¹ = q⁻²`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.sigma_eigval_V3_sq_eq_u","@type":"LeanDeclaration","name":"QOU.BraidKnot.sigma_eigval_V3_sq_eq_u","kind":"theorem","line":93,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-endomorphism/u-coordinate-discharges.lean#L93-L97","doc":"σ_i eigenvalue squared on `V_(3)` equals `u = q²`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.hecke_root_sum_times_q","@type":"LeanDeclaration","name":"QOU.BraidKnot.hecke_root_sum_times_q","kind":"theorem","line":75,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-endomorphism/u-coordinate-discharges.lean#L75-L81","doc":"The Hecke quadratic root sum `q − q⁻¹ = u^{-1/2}·(u − 1)`\nexpressed multiplicatively: `q · (q − q⁻¹) = u − 1` with\n`u = q²`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.dimQ_V21_sq_in_u","@type":"LeanDeclaration","name":"QOU.BraidKnot.dimQ_V21_sq_in_u","kind":"theorem","line":64,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-endomorphism/u-coordinate-discharges.lean#L64-L70","doc":"The squared q-dimension of `V_(2,1)` equals `u + 2 + u⁻¹` with\n`u = q²`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.hoefsmit_b_sq_in_u","@type":"LeanDeclaration","name":"QOU.BraidKnot.hoefsmit_b_sq_in_u","kind":"theorem","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-endomorphism/u-coordinate-discharges.lean#L49-L56","doc":"`hoefsmit_b_sq q = (u² + u + 1)/(u + 1)²` with `u = q²`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.uCoord","@type":"LeanDeclaration","name":"QOU.BraidKnot.uCoord","kind":"def","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-endomorphism/u-coordinate-discharges.lean#L38-L39","doc":"The Macdonald coordinate `u := q²`. ","signatureChunk":0}]}