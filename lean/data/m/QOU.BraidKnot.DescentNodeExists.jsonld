{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.BraidKnot.DescentNodeExists","@type":"LeanModule","name":"QOU.BraidKnot.DescentNodeExists","imports":["lean:module:Init","lean:module:QOU.BraidKnot.GarnirTableau","lean:module:QOU.BraidKnot.RowStandardTableau","lean:module:QOU.BraidKnot.GarnirDescentAdditive"],"declarations":8,"chunks":1},{"@id":"lean:QOU.BraidKnot.DescentNodeExists.isStandard_refTab","@type":"LeanDeclaration","name":"QOU.BraidKnot.DescentNodeExists.isStandard_refTab","kind":"theorem","line":145,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/DescentNodeExists.lean#L145-L149","doc":"The reference tableau is standard, via the descent-node criterion. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.DescentNodeExists.exists_garnir_length_additive","@type":"LeanDeclaration","name":"QOU.BraidKnot.DescentNodeExists.exists_garnir_length_additive","kind":"theorem","line":122,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/DescentNodeExists.lean#L122-L136","doc":"**The length half of Mathas' Lemma 3.13, complete.**\n\nFor a row-standard tableau that is not standard there *exists* a Garnir tableau\nwhose every inversion survives in `d(t)` — which by `length_dOf_smul_eq_add_iff`\nis `ℓ(d(t)) = ℓ(d(g)) + ℓ(w)` for the `w` with `t = w • g`.\n\nThe existence half is this file; the additivity half is\n`invSet_garnirPerm_subset_of_descent`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.DescentNodeExists.exists_descentNode_of_not_standard","@type":"LeanDeclaration","name":"QOU.BraidKnot.DescentNodeExists.exists_descentNode_of_not_standard","kind":"theorem","line":111,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/DescentNodeExists.lean#L111-L118","doc":"**The second half of Mathas 3.13**: a row-standard tableau that is not\nstandard has a descent node. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.DescentNodeExists.isStandard_of_noDescent","@type":"LeanDeclaration","name":"QOU.BraidKnot.DescentNodeExists.isStandard_of_noDescent","kind":"theorem","line":101,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/DescentNodeExists.lean#L101-L109","doc":"**A row-standard tableau with no descent node is standard.** ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.DescentNodeExists.symm_pattern_of_col","@type":"LeanDeclaration","name":"QOU.BraidKnot.DescentNodeExists.symm_pattern_of_col","kind":"theorem","line":93,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/DescentNodeExists.lean#L93-L99","doc":"`symm_pattern` with the column supplied as a variable, so it transports along\nan equality of columns. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.DescentNodeExists.symm_pattern","@type":"LeanDeclaration","name":"QOU.BraidKnot.DescentNodeExists.symm_pattern","kind":"theorem","line":84,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/DescentNodeExists.lean#L84-L91","doc":"Reading a label off its own cell returns it. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.DescentNodeExists.mem_pattern","@type":"LeanDeclaration","name":"QOU.BraidKnot.DescentNodeExists.mem_pattern","kind":"theorem","line":79,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/DescentNodeExists.lean#L79-L82","doc":"The cell of a label, written out of its row and column patterns. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.DescentNodeExists.lt_of_noDescent","@type":"LeanDeclaration","name":"QOU.BraidKnot.DescentNodeExists.lt_of_noDescent","kind":"theorem","line":47,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/DescentNodeExists.lean#L47-L77","doc":"**No adjacent failure forces the whole column to increase.**\n\nThe induction that separates a descent node (adjacent rows) from\n`IsColStandard` (arbitrary rows). ","signatureChunk":0}]}