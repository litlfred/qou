":0},{"@id":"lean:QOU.Mass.GammaGammaH6Interface.Branching.b","@type":"LeanDeclaration","name":"QOU.Mass.GammaGammaH6Interface.Branching.b","kind":"def","line":116,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/GammaGammaH6Interface.lean#L116-L116","doc":"multiplicity of the standard block `(2,1)` ","signatureChunk":0},{"@id":"lean:QOU.Mass.GammaGammaH6Interface.Branching.a","@type":"LeanDeclaration","name":"QOU.Mass.GammaGammaH6Interface.Branching.a","kind":"def","line":114,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/GammaGammaH6Interface.lean#L114-L114","doc":"multiplicity of the trivial block `(3)` ","signatureChunk":0},{"@id":"lean:QOU.Mass.GammaGammaH6Interface.Branching.mk","@type":"LeanDeclaration","name":"QOU.Mass.GammaGammaH6Interface.Branching.mk","kind":"ctor","line":112,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/GammaGammaH6Interface.lean#L112-L112","signatureChunk":0},{"@id":"lean:QOU.Mass.GammaGammaH6Interface.Branching","@type":"LeanDeclaration","name":"QOU.Mass.GammaGammaH6Interface.Branching","kind":"structure","line":110,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/GammaGammaH6Interface.lean#L110-L119","doc":"Multiplicities of `(3), (2,1), (1³)` in the restriction of `V_λ`, `λ ⊢ 6`, to a\nparabolic `H₃` — by the branching rule, the path counts from `μ ⊢ 3` to `λ`. ","signatureChunk":0},{"@id":"lean:QOU.Mass.GammaGammaH6Interface.fDim","@type":"LeanDeclaration","name":"QOU.Mass.GammaGammaH6Interface.fDim","kind":"def","line":107,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/GammaGammaH6Interface.lean#L107-L108","doc":"`f^λ`, the number of standard Young tableaux, as paths from `∅`. ","signatureChunk":0},{"@id":"lean:QOU.Mass.GammaGammaH6Interface.pathCount","@type":"LeanDeclaration","name":"QOU.Mass.GammaGammaH6Interface.pathCount","kind":"def","line":101,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/GammaGammaH6Interface.lean#L101-L105","doc":"Number of saturated chains `μ ⊂ … ⊂ lam` in Young's lattice, with fuel. ","signatureChunk":0},{"@id":"lean:QOU.Mass.GammaGammaH6Interface.covers","@type":"LeanDeclaration","name":"QOU.Mass.GammaGammaH6Interface.covers","kind":"def","line":96,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/GammaGammaH6Interface.lean#L96-L99","doc":"The partitions covering `μ` in Young's lattice. ","signatureChunk":0},{"@id":"lean:QOU.Mass.GammaGammaH6Interface.addBox","@type":"LeanDeclaration","name":"QOU.Mass.GammaGammaH6Interface.addBox","kind":"def","line":88,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/GammaGammaH6Interface.lean#L88-L94","doc":"Add one box in row `i` (a new row when `i` is the length). Out-of-range\nindices return `[]`, which `covers` filters out. ","signatureChunk":0},{"@id":"lean:QOU.Mass.GammaGammaH6Interface.isPartition","@type":"LeanDeclaration","name":"QOU.Mass.GammaGammaH6Interface.isPartition","kind":"def","line":82,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/GammaGammaH6Interface.lean#L82-L86","doc":"Decides the partition condition. ","signatureChunk":0},{"@id":"lean:QOU.Mass.GammaGammaH6Interface.Part","@type":"LeanDeclaration","name":"QOU.Mass.GammaGammaH6Interface.Part","kind":"def","line":79,"sourceLink":"https://githu