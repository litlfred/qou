{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.AppendixSurreals.SurrealLimitTransfer","@type":"LeanModule","name":"QOU.AppendixSurreals.SurrealLimitTransfer","imports":["lean:module:Init","lean:module:QOU.AppendixSurreals.StandardPart"],"declarations":13,"chunks":1},{"@id":"lean:QOU.AppendixSurreals.tendstoReal_le_of_eventuallyLE","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.tendstoReal_le_of_eventuallyLE","kind":"theorem","line":122,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/SurrealLimitTransfer.lean#L122-L143","doc":"**Limit comparison through the surreal order.**  If `aₙ ≤ bₙ`\neventually and both sequences converge, the limits compare — the\nentire argument routed through one surreal inequality at `ω` and\nthe proved monotonicity of the standard part.  (The classical\nstrict-inequality collapse is visible here: `evalOmega a <\nevalOmega b` is compatible with equal standard parts, which is why\nonly `≤` survives the wall.) ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.SurrealLimitTransfer.standardPart_evalOmega_of_tendstoReal","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.SurrealLimitTransfer.standardPart_evalOmega_of_tendstoReal","kind":"theorem","line":109,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/SurrealLimitTransfer.lean#L109-L118","doc":"**Limits are computed by `st ∘ evalOmega`**: the analytic limit\nstatement becomes an exact surreal-side equality. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.SurrealLimitTransfer.evalOmega_isFinite_of_tendstoReal","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.SurrealLimitTransfer.evalOmega_isFinite_of_tendstoReal","kind":"theorem","line":96,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/SurrealLimitTransfer.lean#L96-L107","doc":"A convergent sequence evaluates to a **finite** surreal. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.SurrealLimitTransfer.evalOmega_isClose_of_tendstoReal","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.SurrealLimitTransfer.evalOmega_isClose_of_tendstoReal","kind":"theorem","line":89,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/SurrealLimitTransfer.lean#L89-L89","doc":"A convergent sequence evaluates infinitesimally close to its\nlimit: the limit statement as a surreal equality-up-to-ε. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.SurrealLimitTransfer.evalOmega_le_of_eventuallyLE","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.SurrealLimitTransfer.evalOmega_le_of_eventuallyLE","kind":"theorem","line":85,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/SurrealLimitTransfer.lean#L85-L85","doc":"Eventual pointwise domination transfers to the surreal order. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.SurrealLimitTransfer.evalOmega_mul","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.SurrealLimitTransfer.evalOmega_mul","kind":"theorem","line":82,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/SurrealLimitTransfer.lean#L82-L82","doc":"Multiplicativity. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.SurrealLimitTransfer.evalOmega_add","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.SurrealLimitTransfer.evalOmega_add","kind":"theorem","line":79,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/SurrealLimitTransfer.lean#L79-L79","doc":"Additivity. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.SurrealLimitTransfer.evalOmega_const","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.SurrealLimitTransfer.evalOmega_const","kind":"theorem","line":77,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/SurrealLimitTransfer.lean#L77-L77","doc":"Constant sequences evaluate to the embedded real. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.SurrealLimitTransfer.evalOmega","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.SurrealLimitTransfer.evalOmega","kind":"def","line":75,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/SurrealLimitTransfer.lean#L75-L75","doc":"Evaluation of a real sequence at the surreal `ω`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.SurrealLimitTransfer.mk","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.SurrealLimitTransfer.mk","kind":"ctor","line":73,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/SurrealLimitTransfer.lean#L73-L73","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.SurrealLimitTransfer","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.SurrealLimitTransfer","kind":"class","line":63,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/SurrealLimitTransfer.lean#L63-L90","doc":"**Conjecture (surreal limit transfer).**  An ω-evaluation of real\nsequences into `K`: constants map to `ofReal`, algebra is\nrespected pointwise, eventual domination transfers to the surreal\norder, and a convergent sequence evaluates infinitesimally close\nto its limit.\n\nThe fields carry the conjecture's *hypotheses* (the existence of a\nstructured evaluation); the theorems below derive consequences\nfrom them.  `@conjecture: primary` — no other conjecture class is\nassumed. ","formalizes":[{"@id":"block:conj:surreal-limit-transfer","label":"conj:surreal-limit-transfer","md":"quantum-observable-universe/appendix-surreals-archimedean/surreal-limit-transfer.md"}],"signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.EventuallyLE","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.EventuallyLE","kind":"def","line":59,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/SurrealLimitTransfer.lean#L59-L61","doc":"Eventual pointwise domination of one real sequence by another. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.TendstoReal","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.TendstoReal","kind":"def","line":54,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/SurrealLimitTransfer.lean#L54-L57","doc":"ε–N convergence of a real sequence (self-contained form; avoids\npulling topology into the surreal kernel). ","signatureChunk":0}]}