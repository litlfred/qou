{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.BraidsAndKnots.GapA4MuonBranching","@type":"LeanModule","name":"QOU.BraidsAndKnots.GapA4MuonBranching","imports":["lean:module:Init","lean:module:Mathlib.Data.Real.Basic","lean:module:QOU.BraidsAndKnots.S5SO3FiberAction"],"declarations":12,"chunks":1},{"@id":"lean:QOU.BraidsAndKnots.target_correction_constraint","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.target_correction_constraint","kind":"def","line":43,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/GapA4MuonBranching.lean#L43-L47","doc":"The target constraint: the Wedderburn correction must resolve the tension\nby shifting the prediction by exactly ~1.000000210.\nIn practice, this requires discovering the exact polynomial evaluation of E_{(3,2)}. ","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.GapA4MuonMass.true_mass","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.GapA4MuonMass.true_mass","kind":"def","line":41,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/GapA4MuonBranching.lean#L41-L41","doc":"The true mass is the product of the geometric scalar and the categorical trace correction ","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.GapA4MuonMass.wedderburn_correction","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.GapA4MuonMass.wedderburn_correction","kind":"def","line":39,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/GapA4MuonBranching.lean#L39-L39","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.GapA4MuonMass.topological_mass","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.GapA4MuonMass.topological_mass","kind":"def","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/GapA4MuonBranching.lean#L38-L38","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.GapA4MuonMass.mk","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.GapA4MuonMass.mk","kind":"ctor","line":37,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/GapA4MuonBranching.lean#L37-L37","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.GapA4MuonMass","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.GapA4MuonMass","kind":"structure","line":32,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/GapA4MuonBranching.lean#L32-L41","doc":"GAP-A-4 hypothesis statement:\nThe muon mass acquires a structural correction factor `F(E_{(3,2)}, q_0)`\nfrom the Wedderburn projector corresponding to its generation degree ℓ=2.\nThis factor must algebraically compensate for the 210 ppb mismatch \n(the H1 substrate repin shift). ","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.GenerationBranchingFunctor.project","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.GenerationBranchingFunctor.project","kind":"def","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/GapA4MuonBranching.lean#L30-L30","doc":"Projects an element of the 5-strand fiber to the 3-strand evaluation trace ","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.GenerationBranchingFunctor.mk","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.GenerationBranchingFunctor.mk","kind":"ctor","line":28,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/GapA4MuonBranching.lean#L28-L28","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.GenerationBranchingFunctor","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.GenerationBranchingFunctor","kind":"class","line":25,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/GapA4MuonBranching.lean#L25-L30","doc":"Cross-algebra functor from H_5 (generation fiber) to H_3 (mass scale)\nas required by `conj:s5-so3-fiber-action`. This map must project the \n5-strand geometric fiber space into the 3-strand topological knot evaluation. ","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.H5Trace.tr_M","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.H5Trace.tr_M","kind":"def","line":23,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/GapA4MuonBranching.lean#L23-L23","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.H5Trace.mk","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.H5Trace.mk","kind":"ctor","line":22,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/GapA4MuonBranching.lean#L22-L22","signatureChunk":0},{"@id":"lean:QOU.BraidsAndKnots.H5Trace","@type":"LeanDeclaration","name":"QOU.BraidsAndKnots.H5Trace","kind":"class","line":21,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidsAndKnots/GapA4MuonBranching.lean#L21-L23","doc":"Abstract definition of the 5-strand Hecke algebra trace ","signatureChunk":0}]}