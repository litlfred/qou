QOU.Mass.C1FormalSolutionGrowth.l1CoeffAt","kind":"def","line":184,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/C1FormalSolutionGrowth.lean#L184-L188","signatureChunk":0},{"@id":"lean:QOU.Mass.C1FormalSolutionGrowth.natDegree_c1CoeffPoly","@type":"LeanDeclaration","name":"QOU.Mass.C1FormalSolutionGrowth.natDegree_c1CoeffPoly","kind":"theorem","line":142,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/C1FormalSolutionGrowth.lean#L142-L148","signatureChunk":0},{"@id":"lean:QOU.Mass.C1FormalSolutionGrowth.c1CoeffPoly_ne_zero","@type":"LeanDeclaration","name":"QOU.Mass.C1FormalSolutionGrowth.c1CoeffPoly_ne_zero","kind":"theorem","line":137,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/C1FormalSolutionGrowth.lean#L137-L140","signatureChunk":0},{"@id":"lean:QOU.Mass.C1FormalSolutionGrowth.c1CoeffPoly","@type":"LeanDeclaration","name":"QOU.Mass.C1FormalSolutionGrowth.c1CoeffPoly","kind":"def","line":133,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/C1FormalSolutionGrowth.lean#L133-L135","signatureChunk":0},{"@id":"lean:QOU.Mass.C1FormalSolutionGrowth.c1MultPoly_ne_zero","@type":"LeanDeclaration","name":"QOU.Mass.C1FormalSolutionGrowth.c1MultPoly_ne_zero","kind":"theorem","line":130,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/C1FormalSolutionGrowth.lean#L130-L131","signatureChunk":0},{"@id":"lean:QOU.Mass.C1FormalSolutionGrowth.natDegree_c1MultPoly","@type":"LeanDeclaration","name":"QOU.Mass.C1FormalSolutionGrowth.natDegree_c1MultPoly","kind":"theorem","line":118,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/C1FormalSolutionGrowth.lean#L118-L128","signatureChunk":0},{"@id":"lean:QOU.Mass.C1FormalSolutionGrowth.coeff_c1MultPoly_top","@type":"LeanDeclaration","name":"QOU.Mass.C1FormalSolutionGrowth.coeff_c1MultPoly_top","kind":"theorem","line":107,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/C1FormalSolutionGrowth.lean#L107-L116","signatureChunk":0},{"@id":"lean:QOU.Mass.C1FormalSolutionGrowth.c1MultPoly","@type":"LeanDeclaration","name":"QOU.Mass.C1FormalSolutionGrowth.c1MultPoly","kind":"def","line":92,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/C1FormalSolutionGrowth.lean#L92-L93","signatureChunk":0},{"@id":"lean:QOU.Mass.C1FormalSolutionGrowth.c1FormalDeg_step","@type":"LeanDeclaration","name":"QOU.Mass.C1FormalSolutionGrowth.c1FormalDeg_step","kind":"theorem","line":72,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/C1FormalSolutionGrowth.lean#L72-L76","doc":"The growth is strictly super-linear for `n ≥ 2` (`n² > c·n` eventually) — a divergent\nformal series, confirming the ∞ singularity is irregular (not Fuchsian). Stated as the\nper-step increment `d_{n+1} − d_n = 2n+1`, which is unbounded. ","signatureChunk":0},{"@id":"lean:QOU.Mass.C1FormalSolutionGrowth.c1FormalDeg_eq_sq","@type":"LeanDeclaration","name":"QOU.Mass.C1FormalSolutionGrowth.c1FormalDeg_eq_sq","kind":"theorem","line":60,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/C1FormalSolutionGrowth.lean#L60-L70","doc":"**Gaussian growth**: `deg_q(cₙ) = n²`. The C1 formal solution at ∞ has coefficients of\nq-degree `n²`, i.e. growth `q^{n²}` — the divergent (q-Gevrey) behaviour that forces Stokes\nsummation. Under `QOU.Mathlib.QGevreyOrder.IsQGevreyOrder` that is order **2**, equivalently RSZ\nlevel **½**; see the level/order note in the module docstring. Proof: the sum of the first `n` odd numbers\nis `n²`. ","signatureChunk":0},{"@id":"lean:QOU.Mass.C1FormalSolutionGrowth.c1FormalDeg","@type":"LeanDeclaration","name":"QOU.Mass.C1FormalSolutionGrowth.c1FormalDeg","kind":"def","line":56,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/C1FormalSolutionGrowth.lean#L56-L58","doc":"**q-degree of the `n`-th C1 formal coefficient**, `d_n = ∑_{m<n}(2m+1)`, from the\nratio degree `deg_q(c_{m+1}/c_m) = 2m+1`. ","signatureChunk":0}]}