{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:EightfoldWay.MesonOctetDecomposition","@type":"LeanModule","name":"EightfoldWay.MesonOctetDecomposition","imports":["lean:module:Init","lean:module:Mathlib.Tactic"],"declarations":4,"chunks":1},{"@id":"lean:QOU.Eightfold.MesonOctet.meson_octet_at_three","@type":"LeanDeclaration","name":"QOU.Eightfold.MesonOctet.meson_octet_at_three","kind":"theorem","line":40,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/eightfold-way/meson-octet-decomposition.lean#L40-L45","doc":"At `N = 3`: `𝟑 ⊗ 𝟑̄ = 𝟖 ⊕ 𝟏` — nonet dimension `9`, octet (adjoint)\ndimension `8`, singlet dimension `1`, with `9 = 8 + 1`. ","formalizes":[{"@id":"block:prop:meson-octet-decomposition","label":"prop:meson-octet-decomposition","md":"quantum-observable-universe/eightfold-way/meson-octet-decomposition.md"}],"signatureChunk":0},{"@id":"lean:QOU.Eightfold.MesonOctet.meson_nonet_dim","@type":"LeanDeclaration","name":"QOU.Eightfold.MesonOctet.meson_nonet_dim","kind":"theorem","line":31,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/eightfold-way/meson-octet-decomposition.lean#L31-L38","doc":"**Meson-nonet dimension shadow** (general `N ≥ 1`): the fundamental ⊗\nanti-fundamental splits as adjoint ⊕ singlet at the dimension level,\n`N² = (N² − 1) + 1`.  This is `dim(V ⊗ V*) = dim(adjoint) + dim(singlet)`. ","signatureChunk":0},{"@id":"lean:QOU.Eightfold.MesonOctet.adjointDim","@type":"LeanDeclaration","name":"QOU.Eightfold.MesonOctet.adjointDim","kind":"def","line":27,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/eightfold-way/meson-octet-decomposition.lean#L27-L29","doc":"Dimension of the adjoint representation of `su_N` (the traceless part of\n`gl_N`), i.e. `N² − 1`. ","signatureChunk":0},{"@id":"lean:QOU.Eightfold.MesonOctet.fundAntifundDim","@type":"LeanDeclaration","name":"QOU.Eightfold.MesonOctet.fundAntifundDim","kind":"def","line":24,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/eightfold-way/meson-octet-decomposition.lean#L24-L25","doc":"Dimension of the fundamental ⊗ anti-fundamental of `gl_N`: `N · N = N²`. ","signatureChunk":0}]}