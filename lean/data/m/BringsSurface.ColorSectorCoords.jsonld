{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:BringsSurface.ColorSectorCoords","@type":"LeanModule","name":"BringsSurface.ColorSectorCoords","imports":["lean:module:Init","lean:module:Mathlib.Data.Real.Basic","lean:module:Mathlib.Analysis.SpecialFunctions.Trigonometric.Basic"],"declarations":18,"chunks":1},{"@id":"lean:QOU.sector_offsets_sum_to_two_pi","@type":"LeanDeclaration","name":"QOU.sector_offsets_sum_to_two_pi","kind":"theorem","line":90,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/color-sector-coords.lean#L90-L95","doc":"The three sectors tile the circle: their angular offsets sum to 2π.\nEach sector covers a 2π/3-wide strip, and 0 + 2π/3 + 4π/3 = 2π. ","signatureChunk":0},{"@id":"lean:QOU.ColorSectorCoords.blue_eq_red_shifted","@type":"LeanDeclaration","name":"QOU.ColorSectorCoords.blue_eq_red_shifted","kind":"theorem","line":82,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/color-sector-coords.lean#L82-L88","doc":"Blue is the red sector shifted by 4π/3 in the azimuthal coordinate. ","signatureChunk":0},{"@id":"lean:QOU.ColorSectorCoords.green_eq_red_shifted","@type":"LeanDeclaration","name":"QOU.ColorSectorCoords.green_eq_red_shifted","kind":"theorem","line":74,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/color-sector-coords.lean#L74-L80","doc":"Green is the red sector shifted by 2π/3 in the azimuthal coordinate. ","signatureChunk":0},{"@id":"lean:QOU.ColorSectorCoords.sectorPoint","@type":"LeanDeclaration","name":"QOU.ColorSectorCoords.sectorPoint","kind":"def","line":64,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/color-sector-coords.lean#L64-L72","doc":"The sector embedding: given color sector coordinates, a colour sector,\nand spherical parameters (φ, ψ), return the i-th coordinate of the\nfibre point with color twist. ","signatureChunk":0},{"@id":"lean:QOU.ColourSector.offset","@type":"LeanDeclaration","name":"QOU.ColourSector.offset","kind":"def","line":57,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/color-sector-coords.lean#L57-L62","doc":"The azimuthal offset for each colour sector: R → 0, G → 2π/3, B → 4π/3. ","signatureChunk":0},{"@id":"lean:QOU.ColourSector.blue","@type":"LeanDeclaration","name":"QOU.ColourSector.blue","kind":"ctor","line":55,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/color-sector-coords.lean#L55-L55","signatureChunk":0},{"@id":"lean:QOU.ColourSector.green","@type":"LeanDeclaration","name":"QOU.ColourSector.green","kind":"ctor","line":55,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/color-sector-coords.lean#L55-L55","signatureChunk":0},{"@id":"lean:QOU.ColourSector.red","@type":"LeanDeclaration","name":"QOU.ColourSector.red","kind":"ctor","line":55,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/color-sector-coords.lean#L55-L55","signatureChunk":0},{"@id":"lean:QOU.ColourSector","@type":"LeanDeclaration","name":"QOU.ColourSector","kind":"inductive","line":53,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/color-sector-coords.lean#L53-L55","doc":"Colour sector index: Red, Green, Blue. ","signatureChunk":0},{"@id":"lean:QOU.ColorSectorCoords.tangent2","@type":"LeanDeclaration","name":"QOU.ColorSectorCoords.tangent2","kind":"def","line":51,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/color-sector-coords.lean#L51-L51","doc":"Second tangent vector T₂. ","signatureChunk":0},{"@id":"lean:QOU.ColorSectorCoords.tangent1","@type":"LeanDeclaration","name":"QOU.ColorSectorCoords.tangent1","kind":"def","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/color-sector-coords.lean#L49-L49","doc":"First tangent vector T₁. ","signatureChunk":0},{"@id":"lean:QOU.ColorSectorCoords.normal","@type":"LeanDeclaration","name":"QOU.ColorSectorCoords.normal","kind":"def","line":47,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/color-sector-coords.lean#L47-L47","doc":"Outward unit normal at the brane point. ","signatureChunk":0},{"@id":"lean:QOU.ColorSectorCoords.centre","@type":"LeanDeclaration","name":"QOU.ColorSectorCoords.centre","kind":"def","line":45,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/color-sector-coords.lean#L45-L45","doc":"Centre of the exceptional divisor (ℝ³ coordinates). ","signatureChunk":0},{"@id":"lean:QOU.ColorSectorCoords.q","@type":"LeanDeclaration","name":"QOU.ColorSectorCoords.q","kind":"def","line":43,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/color-sector-coords.lean#L43-L43","doc":"The substrate parameter q controlling the color twist. ","signatureChunk":0},{"@id":"lean:QOU.ColorSectorCoords.R_pos","@type":"LeanDeclaration","name":"QOU.ColorSectorCoords.R_pos","kind":"theorem","line":41,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/color-sector-coords.lean#L41-L41","doc":"Radius is positive. ","signatureChunk":0},{"@id":"lean:QOU.ColorSectorCoords.R","@type":"LeanDeclaration","name":"QOU.ColorSectorCoords.R","kind":"def","line":39,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/color-sector-coords.lean#L39-L39","doc":"The radius of the ℙ¹(ℂ) fibre. ","signatureChunk":0},{"@id":"lean:QOU.ColorSectorCoords.mk","@type":"LeanDeclaration","name":"QOU.ColorSectorCoords.mk","kind":"ctor","line":37,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/color-sector-coords.lean#L37-L37","signatureChunk":0},{"@id":"lean:QOU.ColorSectorCoords","@type":"LeanDeclaration","name":"QOU.ColorSectorCoords","kind":"structure","line":23,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/color-sector-coords.lean#L23-L51","doc":"**Color sector coordinates**: the three colour sectors R/G/B on the\nexceptional divisor ℙ¹(ℂ), each covering a 2π/3-wide strip in the\nazimuthal coordinate ψ, with a color twist q·φ that rotates\nthe sector as latitude φ varies from 0 to π.\n\nThe red sector embedding is:\n  𝔯(φ, ψ) = O + R(sin φ (cos(ψ + qφ) T₁ + sin(ψ + qφ) T₂) - cos φ N)\n\nGreen and blue are offset by 2π/3 and 4π/3 respectively:\n  𝔤(φ, ψ) = 𝔯(φ, ψ + 2π/3)\n  𝔟(φ, ψ) = 𝔯(φ, ψ + 4π/3)\n\nLaTeX: `\\label{def:color-sector-coords}`\nRef: [leitner2026] Chapter 6, §Color-sector coordinates ","formalizes":[{"@id":"block:def:color-sector-coords","label":"def:color-sector-coords","md":"quantum-observable-universe/brings-surface/color-sector-coords.md"}],"signatureChunk":0}]}