{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:KnotsParticlesConfinement.KnotParticleCorrespondence","@type":"LeanModule","name":"KnotsParticlesConfinement.KnotParticleCorrespondence","imports":["lean:module:Init","lean:module:Mathlib.Data.Fintype.Card","lean:module:Mathlib.Data.Finset.Card","lean:module:Mathlib.SetTheory.Cardinal.Finite","lean:module:Mathlib.Tactic"],"declarations":7,"chunks":1},{"@id":"lean:QOU.Braiding.no_surjection_onto_infinite","@type":"LeanDeclaration","name":"QOU.Braiding.no_surjection_onto_infinite","kind":"theorem","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/knot-particle-correspondence.lean#L49-L54","doc":"**No bijection.** A finite set of summands cannot map onto an infinite set\nof link types. Closures of `n`-strand braids, `n ≥ 2`, include the torus\nlinks `T(2, k)` for every `k`, which are pairwise distinct. ","formalizes":[{"@id":"block:prop:knot-particle-correspondence","label":"prop:knot-particle-correspondence","md":"quantum-observable-universe/knots-particles-confinement/knot-particle-correspondence.md"}],"signatureChunk":0},{"@id":"lean:QOU.Braiding.card_twoRowPartition","@type":"LeanDeclaration","name":"QOU.Braiding.card_twoRowPartition","kind":"theorem","line":46,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/knot-particle-correspondence.lean#L46-L47","signatureChunk":0},{"@id":"lean:QOU.Braiding.TwoRowPartition.rows_valid","@type":"LeanDeclaration","name":"QOU.Braiding.TwoRowPartition.rows_valid","kind":"theorem","line":40,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/knot-particle-correspondence.lean#L40-L44","signatureChunk":0},{"@id":"lean:QOU.Braiding.TwoRowPartition.rows","@type":"LeanDeclaration","name":"QOU.Braiding.TwoRowPartition.rows","kind":"def","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/knot-particle-correspondence.lean#L36-L38","doc":"The row lengths of the partition with second row `b`. ","signatureChunk":0},{"@id":"lean:QOU.Braiding.instFiniteTwoRowPartition","@type":"LeanDeclaration","name":"QOU.Braiding.instFiniteTwoRowPartition","kind":"instance","line":34,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/knot-particle-correspondence.lean#L34-L34","signatureChunk":0},{"@id":"lean:QOU.Braiding.instFintypeTwoRowPartition","@type":"LeanDeclaration","name":"QOU.Braiding.instFintypeTwoRowPartition","kind":"instance","line":33,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/knot-particle-correspondence.lean#L33-L33","signatureChunk":0},{"@id":"lean:QOU.Braiding.TwoRowPartition","@type":"LeanDeclaration","name":"QOU.Braiding.TwoRowPartition","kind":"def","line":28,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/knot-particle-correspondence.lean#L28-L31","doc":"Two-row partitions of `n`: pairs `(a, b)` with `a ≥ b` and `a + b = n`,\nindexed by the second row `b ≤ n / 2`. These label the irreducible summands\nof `V^{⊗n}` for `V` the fundamental `U_q(sl₂)` module. ","signatureChunk":0}]}