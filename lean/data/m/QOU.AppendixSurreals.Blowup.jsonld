{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.AppendixSurreals.Blowup","@type":"LeanModule","name":"QOU.AppendixSurreals.Blowup","imports":["lean:module:Init","lean:module:QOU.AppendixSurreals.Basic","lean:module:QOU.AppendixSurreals.StandardPart"],"declarations":16,"chunks":1},{"@id":"lean:QOU.AppendixSurreals.BlowupCalculus.renormalise_ofReal","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.BlowupCalculus.renormalise_ofReal","kind":"theorem","line":167,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/Blowup.lean#L167-L174","doc":"A real counter-term subtracted from a real expression\nrenormalises to the real difference. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.BlowupCalculus.renormalise_eq_zero_of_isInfinitesimal","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.BlowupCalculus.renormalise_eq_zero_of_isInfinitesimal","kind":"theorem","line":160,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/Blowup.lean#L160-L165","doc":"If the counter-term recovers `X` up to an infinitesimal, the\nrenormalised value is `0`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.BlowupCalculus.renormalise_self","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.BlowupCalculus.renormalise_self","kind":"theorem","line":152,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/Blowup.lean#L152-L158","doc":"A counter-term that exactly cancels the divergence renormalises\nto `0`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.BlowupCalculus.renormalise","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.BlowupCalculus.renormalise","kind":"def","line":142,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/Blowup.lean#L142-L150","doc":"**Renormalisation**: subtract a counter-term `C` from a\nsurreal-valued divergent expression `X`, then project to ℝ via\n`standardPart`.  The result is `0` whenever `X - C` is not\nfinite — i.e. when the counter-term failed to absorb the\ndivergence. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.BlowupCalculus.Epsilon","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.BlowupCalculus.Epsilon","kind":"def","line":139,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/Blowup.lean#L139-L140","doc":"The named infinitesimal unit: `ε := 1/ω ∈ K`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.BlowupCalculus.Lambda","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.BlowupCalculus.Lambda","kind":"def","line":136,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/Blowup.lean#L136-L137","doc":"The named cutoff: `Λ := ω ∈ K`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.epsilonSurreal_isInfinitesimal","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.epsilonSurreal_isInfinitesimal","kind":"theorem","line":82,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/Blowup.lean#L82-L122","doc":"`ε` is infinitesimal. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.epsilonSurreal_ne_zero","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.epsilonSurreal_ne_zero","kind":"theorem","line":77,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/Blowup.lean#L77-L80","doc":"`ε` is non-zero. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.omegaSurreal_mul_epsilonSurreal","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.omegaSurreal_mul_epsilonSurreal","kind":"theorem","line":70,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/Blowup.lean#L70-L75","doc":"`ω * ε = 1`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.epsilonSurreal_mul_omegaSurreal","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.epsilonSurreal_mul_omegaSurreal","kind":"theorem","line":63,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/Blowup.lean#L63-L68","doc":"`ε * ω = 1`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.epsilonSurreal_pos","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.epsilonSurreal_pos","kind":"theorem","line":58,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/Blowup.lean#L58-L61","doc":"`ε` is positive. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.epsilonSurreal","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.epsilonSurreal","kind":"def","line":53,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/Blowup.lean#L53-L56","doc":"The **first positive infinitesimal** `ε := 1/ω`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.omegaSurreal_ne_zero","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.omegaSurreal_ne_zero","kind":"theorem","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/Blowup.lean#L49-L51","doc":"`ω` is non-zero. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.omegaSurreal_pos","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.omegaSurreal_pos","kind":"theorem","line":44,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/Blowup.lean#L44-L47","doc":"`ω` is positive. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.omegaSurreal_gt_natCast","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.omegaSurreal_gt_natCast","kind":"theorem","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/Blowup.lean#L38-L42","doc":"`ω` is greater than every natural number. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.omegaSurreal","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.omegaSurreal","kind":"def","line":32,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/Blowup.lean#L32-L36","doc":"Alias for the `SurrealField.omegaSurreal` member, for\nconvenience in downstream files. ","signatureChunk":0}]}