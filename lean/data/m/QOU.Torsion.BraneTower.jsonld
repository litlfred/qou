1d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/BraneTower.lean#L106-L110","doc":"**Proposition (Stability of the Euler Characteristic).**\nLaTeX: `\\label{prop:euler-char-stability}` ","signatureChunk":0},{"@id":"lean:QOU.Torsion.vacuum_state_value_eq_haar","@type":"LeanDeclaration","name":"QOU.Torsion.vacuum_state_value_eq_haar","kind":"theorem","line":98,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/BraneTower.lean#L98-L102","doc":"The vacuum state value is determined by the Haar state at level 0. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.vacuum_state_state_eq","@type":"LeanDeclaration","name":"QOU.Torsion.vacuum_state_state_eq","kind":"theorem","line":76,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/BraneTower.lean#L76-L96","doc":"**Uniqueness of the vacuum state**: any two vacuum states on the\nsame direct limit algebra agree on all elements.\n\n**Proof strategy:** Both states are constant (by `invariant`), and\nthey agree on embedded elements (by `extends_haar` + Haar uniqueness).\nSo they are equal everywhere.\n\nThis is the categorical analogue of the Schur uniqueness in\n`QOU.Torsion.invariant_functional_unique` (vacuum-state.lean). ","signatureChunk":0},{"@id":"lean:QOU.Torsion.vacuum_state_exists","@type":"LeanDeclaration","name":"QOU.Torsion.vacuum_state_exists","kind":"theorem","line":72,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/BraneTower.lean#L72-L74","signatureChunk":0},{"@id":"lean:QOU.Torsion.VacuumState.extends_haar","@type":"LeanDeclaration","name":"QOU.Torsion.VacuumState.extends_haar","kind":"theorem","line":69,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/BraneTower.lean#L69-L69","signatureChunk":0},{"@id":"lean:QOU.Torsion.VacuumState.invariant","@type":"LeanDeclaration","name":"QOU.Torsion.VacuumState.invariant","kind":"theorem","line":68,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/BraneTower.lean#L68-L68","signatureChunk":0},{"@id":"lean:QOU.Torsion.VacuumState.state","@type":"LeanDeclaration","name":"QOU.Torsion.VacuumState.state","kind":"def","line":67,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/BraneTower.lean#L67-L67","signatureChunk":0},{"@id":"lean:QOU.Torsion.VacuumState.mk","@type":"LeanDeclaration","name":"QOU.Torsion.VacuumState.mk","kind":"ctor","line":66,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/BraneTower.lean#L66-L66","signatureChunk":0},{"@id":"lean:QOU.Torsion.VacuumState","@type":"LeanDeclaration","name":"QOU.Torsion.VacuumState","kind":"structure","line":64,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/BraneTower.lean#L64-L70","doc":"**Proposition (Existence and Uniqueness of the Vacuum State).**\nLaTeX: `\\label{prop:vacuum-state}` ","signatureChunk":0},{"@id":"lean:QOU.Torsion.DirectLimitAlgebra.limitState_invariant","@type":"LeanDeclaration","name":"QOU.Torsion.DirectLimitAlgebra.limitState_invariant","kind":"theorem","line":59,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Torsion/BraneTower.lean#L59-L59","signatureChunk":0},{"@id":"lean:QOU.Torsion.DirectLimitAlgebra.limitState_extends","@type":"LeanDeclaration","name":"QOU.Torsion.DirectLimitAlgebra.limitState_extends","kin