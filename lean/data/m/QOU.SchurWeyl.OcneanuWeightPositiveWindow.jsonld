{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.SchurWeyl.OcneanuWeightPositiveWindow","@type":"LeanModule","name":"QOU.SchurWeyl.OcneanuWeightPositiveWindow","imports":["lean:module:Init","lean:module:QOU.SchurWeyl.OcneanuWeight","lean:module:Mathlib.Algebra.Order.Archimedean.Basic","lean:module:Mathlib.Tactic.Positivity","lean:module:Mathlib.Tactic.Linarith","lean:module:Mathlib.Data.Real.Archimedean","lean:module:Mathlib.Algebra.Order.BigOperators.Ring.Finset","lean:module:Mathlib.Tactic.FieldSimp","lean:module:Mathlib.Tactic.Ring"],"declarations":17,"chunks":1},{"@id":"lean:QOU.SchurWeyl.PositiveWindow.conventionD_not_all_pos","@type":"LeanDeclaration","name":"QOU.SchurWeyl.PositiveWindow.conventionD_not_all_pos","kind":"theorem","line":242,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/OcneanuWeightPositiveWindow.lean#L242-L247","doc":"Hence at convention D some weight is not positive. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.PositiveWindow.conventionD_gt_h","@type":"LeanDeclaration","name":"QOU.SchurWeyl.PositiveWindow.conventionD_gt_h","kind":"theorem","line":233,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/OcneanuWeightPositiveWindow.lean#L233-L240","doc":"Convention D, `z = q³/(q²+1)`, lies strictly above the window. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.PositiveWindow.half_h_pos","@type":"LeanDeclaration","name":"QOU.SchurWeyl.PositiveWindow.half_h_pos","kind":"theorem","line":225,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/OcneanuWeightPositiveWindow.lean#L225-L231","doc":"The self-dual point `z = h/2` is inside the window. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.PositiveWindow.forall_pos_iff","@type":"LeanDeclaration","name":"QOU.SchurWeyl.PositiveWindow.forall_pos_iff","kind":"theorem","line":213,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/OcneanuWeightPositiveWindow.lean#L213-L223","doc":"**The positive window.** For real `q > 1`, every Ocneanu weight is positive iff\n`0 ≤ z ≤ q − q⁻¹`. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.PositiveWindow.exists_not_pos_of_not_mem_window","@type":"LeanDeclaration","name":"QOU.SchurWeyl.PositiveWindow.exists_not_pos_of_not_mem_window","kind":"theorem","line":198,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/OcneanuWeightPositiveWindow.lean#L198-L211","doc":"**Outside the window some Ocneanu weight is not positive.** ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.PositiveWindow.exists_row_neg","@type":"LeanDeclaration","name":"QOU.SchurWeyl.PositiveWindow.exists_row_neg","kind":"theorem","line":185,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/OcneanuWeightPositiveWindow.lean#L185-L196","doc":"**Below the window some row factor is negative.** ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.PositiveWindow.exists_col_neg","@type":"LeanDeclaration","name":"QOU.SchurWeyl.PositiveWindow.exists_col_neg","kind":"theorem","line":171,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/OcneanuWeightPositiveWindow.lean#L171-L183","doc":"**Above the window some column factor is negative.** ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.PositiveWindow.not_both_pos_of_neg","@type":"LeanDeclaration","name":"QOU.SchurWeyl.PositiveWindow.not_both_pos_of_neg","kind":"theorem","line":163,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/OcneanuWeightPositiveWindow.lean#L163-L169","doc":"If one factor of a growing product is negative, the two products around it are not both\npositive. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.PositiveWindow.prod_row","@type":"LeanDeclaration","name":"QOU.SchurWeyl.PositiveWindow.prod_row","kind":"theorem","line":156,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/OcneanuWeightPositiveWindow.lean#L156-L161","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.PositiveWindow.prod_col","@type":"LeanDeclaration","name":"QOU.SchurWeyl.PositiveWindow.prod_col","kind":"theorem","line":149,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/OcneanuWeightPositiveWindow.lean#L149-L154","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.PositiveWindow.rowDiagram","@type":"LeanDeclaration","name":"QOU.SchurWeyl.PositiveWindow.rowDiagram","kind":"def","line":140,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/OcneanuWeightPositiveWindow.lean#L140-L147","doc":"The row of length `n`. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.PositiveWindow.colDiagram","@type":"LeanDeclaration","name":"QOU.SchurWeyl.PositiveWindow.colDiagram","kind":"def","line":131,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/OcneanuWeightPositiveWindow.lean#L131-L138","doc":"The column of height `n`. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.PositiveWindow.ocneanuWeight_pos_of_mem_window","@type":"LeanDeclaration","name":"QOU.SchurWeyl.PositiveWindow.ocneanuWeight_pos_of_mem_window","kind":"theorem","line":124,"sou