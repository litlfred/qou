.Mathlib.MajStandardization.SYTe.sum_phiFun","@type":"LeanDeclaration","name":"QOU.Mathlib.MajStandardization.SYTe.sum_phiFun","kind":"theorem","line":253,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajStandardization.lean#L253-L257","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajStandardization.SYTe.phiFun_isRSSYT","@type":"LeanDeclaration","name":"QOU.Mathlib.MajStandardization.SYTe.phiFun_isRSSYT","kind":"theorem","line":239,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajStandardization.lean#L239-L251","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajStandardization.SYTe.colN_e","@type":"LeanDeclaration","name":"QOU.Mathlib.MajStandardization.SYTe.colN_e","kind":"theorem","line":236,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajStandardization.lean#L236-L237","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajStandardization.SYTe.rowN_e","@type":"LeanDeclaration","name":"QOU.Mathlib.MajStandardization.SYTe.rowN_e","kind":"theorem","line":233,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajStandardization.lean#L233-L234","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajStandardization.SYTe.phiFun","@type":"LeanDeclaration","name":"QOU.Mathlib.MajStandardization.SYTe.phiFun","kind":"def","line":230,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajStandardization.lean#L230-L231","doc":"`Φ(S, b)`: put `b_k + D_k` in the cell carrying entry `k`. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajStandardization.DecSeq","@type":"LeanDeclaration","name":"QOU.Mathlib.MajStandardization.DecSeq","kind":"def","line":223,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajStandardization.lean#L223-L224","doc":"Weakly decreasing sequences of naturals of length `n` (partitions with at most `n` parts). ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajStandardization.RSSYT","@type":"LeanDeclaration","name":"QOU.Mathlib.MajStandardization.RSSYT","kind":"def","line":220,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajStandardization.lean#L220-L221","doc":"Reverse semistandard tableaux of shape `μ`. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajStandardization.IsRSSYT","@type":"LeanDeclaration","name":"QOU.Mathlib.MajStandardization.IsRSSYT","kind":"def","line":215,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajStandardization.lean#L215-L218","doc":"A **reverse semistandard tableau**: rows weakly decrease, columns strictly decrease. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajStandardization.SYTe.ext'","@type":"LeanDeclaration","name":"QOU.Mathlib.MajStandardization.SYTe.ext'","kind":"theorem","line":208,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajStandardization.lean#L208-L209","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajStandardization.SYTe.sum_D","@type":"LeanDeclaration","name":"QOU.Mathlib.MajStandardization.SYTe.sum_D","kind":"theorem","line":194,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajStandardization.lean#L194-L206","doc":"`Σ_{k<n} D k = maj S`. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajStandardization.SYTe.D_succ","@type":"LeanDeclaration","name":"QOU.Mathlib.MajStandardization.SYTe.D_succ","kind":"theorem","line":174,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajStandardization.lean#L174-L192","doc":"`D k = D (k+1) + [k is a descent]`. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajStandardization.SYTe.colN_lt_of_D_eq","@type":"LeanDeclaration","name":"QOU.Mathlib.MajStandardization.SYTe.colN_lt_of_D_eq","kind":"theorem","line":169,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajStandardization.lean#L169-L172","doc":"Equal budgets at `k < l` force a descent-free run, hence entry `l` strictly right of `k`. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajStandardization.SYTe.D_lt_of_rowN_lt","@type":"LeanDeclaration","name":"QOU.Mathlib.MajStandardization.SYTe.D_lt_of_rowN_lt","kind":"theorem","line":158,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajStandardization.lean#L158-L167","doc":"If entry `l > k` sits strictly below entry `k`, the strictness budget drops. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajStandardization.SYTe.D_lt_of_des","@type":"LeanDeclaration","name":"QOU.Mathlib.MajStandardization.SYTe.D_lt_of_des","kind":"theorem","line":147,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajStandardization.lean#L147-L156","doc":"A descent in `[k, l)` makes the strictness budget drop from `k` to `l`. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajStandardization.SYTe.D_le_of_le","@type":"LeanDeclaration","name":"QOU.Mathlib.MajStandardization.SYTe.D_le_of_le","kind":"theorem","line":142,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajStandardization.lean#L142-L145","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajStandardization.SYTe.run_no_des","@type":"LeanDeclaration","name":"QOU.Mathlib.MajStandardization.SYTe.run_no_des","kind":"theorem","line":124,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajStandardization.lean#L124-L140","doc":"**A descent-free run moves weakly up and strictly right.** ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajStandardization.SYTe.colN_lt_of_not_des","@type":"LeanDeclaration","name":"QOU.Mathlib.MajStandardization.SYTe.colN_lt_of_not_des","kind":"theorem","line":86,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajStandardization.lean#L86-L122","doc":"**No descent at `k` ⟹ entry `k + 1` is strictly to the right of entry `k`.** ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajStandardization.SYTe.colN_of_lt","@type":"LeanDeclaration","name":"QOU.Mathlib.MajStandardization.SYTe.colN_of_lt","kind":"theorem","line":84,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajStandardization.lean#L84-L84","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajStandardization.SYTe.rowN_of_lt","@type":"LeanDeclaration","name":"QOU.Mathlib.MajStandardization.SYTe.rowN_of_lt","kind":"theorem","line":83,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajStandardization.lean#L83-L83","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajStandardization.SYTe.D","@type":"LeanDeclaration","name":"QOU.Mathlib.MajStandardization.SYTe.D","kind":"def","line":80,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajStandardization.lean#L80-L81","doc":"`D k = #{descents j ≥ k}`: the strictness budget below entry `k`. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajStandardization.SYTe.maj","@type":"LeanDeclaration","name":"QOU.Mathlib.MajStandardization.SYTe.maj","kind":"def","line":77,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajStandardization.lean#L77-L78","doc":"The **major index** `maj S = Σ_{descents k} (k + 1)` (1-indexed descents). ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajStandardization.SYTe.instDecidableIsDes","@type":"LeanDeclaration","name":"QOU.Mathlib.MajStandardization.SYTe.instDecidableIsDes","kind":"instance","line":75,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajStandardization.lean#L75-L75","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajStandardization.SYTe.IsDes","@type":"LeanDeclaration","name":"QOU.Mathlib.MajStandardization.SYTe.IsDes","kind":"def","line":72,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajStandardization.lean#L72-L73","doc":"`k` is a **descent** (0-indexed): entry `k + 1` sits in a strictly lower row than `k`. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajStandardization.SYTe.colN","@type":"LeanDeclaration","name":"QOU.Mathlib.MajStandardization.SYTe.colN","kind":"def","line":69,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/MajStandardization.lean#L69-L70","doc":"Column of the cell carrying entry `k` (junk `0` for `k ≥ n`). ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.MajStandardization.SYTe.rowN","@type":"LeanDeclaration","name":"QOU.Mathlib.MajStandardization.SYTe.rowN","kind":"def","line":66,"sourceLink":"https://