ormalizes":[{"@id":"block:def:magic-shell-coupling-kappa","label":"def:magic-shell-coupling-kappa","md":"quantum-observable-universe/knots-particles-confinement/magic-shell-coupling-kappa.md"}],"signatureChunk":0}]}