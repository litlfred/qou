{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QuantumObservableUniverses.EmergenceToQuantumFlat","@type":"LeanModule","name":"QuantumObservableUniverses.EmergenceToQuantumFlat","imports":["lean:module:Init","lean:module:Mathlib.Data.Real.Basic","lean:module:Mathlib.Tactic.Linarith"],"declarations":13,"chunks":1},{"@id":"lean:QOU.self_dual_eq_b_field","@type":"LeanDeclaration","name":"QOU.self_dual_eq_b_field","kind":"theorem","line":69,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/emergence-to-quantum-flat.lean#L69-L76","doc":"The self-dual part equals the B-field when F⁻ = 0. ","signatureChunk":0},{"@id":"lean:QOU.emergence_to_quantum_flat","@type":"LeanDeclaration","name":"QOU.emergence_to_quantum_flat","kind":"theorem","line":58,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/emergence-to-quantum-flat.lean#L58-L67","doc":"Under the simplicity constraint, quantum flatness implies\nthe instanton equation: F⁻ = 0 follows from F⁻ = B⁻ (quantum\nflatness on the anti-self-dual component) and B⁻ = 0 (simplicity).\nThe conclusion is *derived* by composing the two hypotheses — it is\nno longer carried as a field. ","formalizes":[{"@id":"block:prop:emergence-to-quantum-flat","label":"prop:emergence-to-quantum-flat","md":"quantum-observable-universe/quantum-observable-universes/emergence-to-quantum-flat.md"}],"signatureChunk":0},{"@id":"lean:QOU.QuantumFlatnessEmergence.simplicity","@type":"LeanDeclaration","name":"QOU.QuantumFlatnessEmergence.simplicity","kind":"theorem","line":56,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/emergence-to-quantum-flat.lean#L56-L56","doc":"Simplicity constraint: the B-field is self-dual, so B⁻ = 0. ","signatureChunk":0},{"@id":"lean:QOU.QuantumFlatnessEmergence.quantum_flat_anti","@type":"LeanDeclaration","name":"QOU.QuantumFlatnessEmergence.quantum_flat_anti","kind":"theorem","line":54,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/emergence-to-quantum-flat.lean#L54-L54","doc":"Quantum flatness on the anti-self-dual component: F⁻ = B⁻\n(the F = B condition read off the anti-self-dual projection). ","signatureChunk":0},{"@id":"lean:QOU.QuantumFlatnessEmergence.quantum_flat","@type":"LeanDeclaration","name":"QOU.QuantumFlatnessEmergence.quantum_flat","kind":"theorem","line":51,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/emergence-to-quantum-flat.lean#L51-L51","doc":"Quantum flatness: F = B means curvature equals B-field. ","signatureChunk":0},{"@id":"lean:QOU.QuantumFlatnessEmergence.curvature_decomp","@type":"LeanDeclaration","name":"QOU.QuantumFlatnessEmergence.curvature_decomp","kind":"theorem","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/emergence-to-quantum-flat.lean#L49-L49","doc":"Curvature decomposes: ‖F‖² = ‖F⁺‖² + ‖F⁻‖². ","signatureChunk":0},{"@id":"lean:QOU.QuantumFlatnessEmergence.b_anti_self_dual","@type":"LeanDeclaration","name":"QOU.QuantumFlatnessEmergence.b_anti_self_dual","kind":"def","line":47,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/emergence-to-quantum-flat.lean#L47-L47","doc":"The anti-self-dual component of the B-field, B⁻. ","signatureChunk":0},{"@id":"lean:QOU.QuantumFlatnessEmergence.self_dual","@type":"LeanDeclaration","name":"QOU.QuantumFlatnessEmergence.self_dual","kind":"def","line":45,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/emergence-to-quantum-flat.lean#L45-L45","doc":"The self-dual component F⁺. ","signatureChunk":0},{"@id":"lean:QOU.QuantumFlatnessEmergence.anti_self_dual","@type":"LeanDeclaration","name":"QOU.QuantumFlatnessEmergence.anti_self_dual","kind":"def","line":43,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/emergence-to-quantum-flat.lean#L43-L43","doc":"The anti-self-dual component F⁻. ","signatureChunk":0},{"@id":"lean:QOU.QuantumFlatnessEmergence.b_field_norm","@type":"LeanDeclaration","name":"QOU.QuantumFlatnessEmergence.b_field_norm","kind":"def","line":41,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/emergence-to-quantum-flat.lean#L41-L41","doc":"The B-field (2-form background). ","signatureChunk":0},{"@id":"lean:QOU.QuantumFlatnessEmergence.curvature_norm","@type":"LeanDeclaration","name":"QOU.QuantumFlatnessEmergence.curvature_norm","kind":"def","line":39,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/emergence-to-quantum-flat.lean#L39-L39","doc":"The curvature F_A (scalar representative of the norm). ","signatureChunk":0},{"@id":"lean:QOU.QuantumFlatnessEmergence.mk","@type":"LeanDeclaration","name":"QOU.QuantumFlatnessEmergence.mk","kind":"ctor","line":37,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/emergence-to-quantum-flat.lean#L37-L37","signatureChunk":0},{"@id":"lean:QOU.QuantumFlatnessEmergence","@type":"LeanDeclaration","name":"QOU.QuantumFlatnessEmergence","kind":"structure","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/emergence-to-quantum-flat.lean#L30-L56","doc":"**Quantum flatness emergence data**.\n\nThe quantum flatness condition F_A = B is equivalent to the\ninstanton equation F_A⁻ = 0 under the simplicity constraint.\nThe 2-group INN(G_q) is the unique strict 2-group for which\nthis equivalence holds. ","signatureChunk":0}]}