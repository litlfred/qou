":"lean:QOU.Machinery.CoxeterParabolic.formLin_single","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.formLin_single","kind":"theorem","line":94,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterGeometricRepresentation.lean#L94-L96","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.formLin","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.formLin","kind":"def","line":89,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterGeometricRepresentation.lean#L89-L92","doc":"The pairing functional `⟨αᵢ, ·⟩` as a linear map. ","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.bilinCoeff_of_eq_three","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.bilinCoeff_of_eq_three","kind":"theorem","line":83,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterGeometricRepresentation.lean#L83-L87","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.bilinCoeff_of_eq_two","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.bilinCoeff_of_eq_two","kind":"theorem","line":77,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterGeometricRepresentation.lean#L77-L81","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.bilinCoeff_symm","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.bilinCoeff_symm","kind":"theorem","line":70,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterGeometricRepresentation.lean#L70-L75","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.bilinCoeff_diag","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.bilinCoeff_diag","kind":"theorem","line":67,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterGeometricRepresentation.lean#L67-L68","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.bilinCoeff","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.bilinCoeff","kind":"def","line":61,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterGeometricRepresentation.lean#L61-L65","doc":"The standard-form coefficients `B(αᵢ, αⱼ) = −cos(π / mᵢⱼ)`; the\ndiagonal is 1, and `m = 0` (infinite order) yields `−cos 0 = −1` from\nthe `π / 0 = 0` convention. ","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.SimplyLaced","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.SimplyLaced","kind":"def","line":57,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterGeometricRepresentation.lean#L57-L59","doc":"Every off-diagonal bond order is 2 or 3. ","signatureChunk":0}]}