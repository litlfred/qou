{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Archimedean.nuclear_spin_parity","@type":"LeanModule","name":"QOU.Archimedean.nuclear_spin_parity","imports":["lean:module:Init","lean:module:Mathlib.Data.Real.Basic"],"declarations":7,"chunks":1},{"@id":"lean:QOU.Archimedean.nuclear_spin_parity","@type":"LeanDeclaration","name":"QOU.Archimedean.nuclear_spin_parity","kind":"theorem","line":44,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/nuclear_spin_parity.lean#L44-L52","doc":"**Nuclear spin parity** ([`prop:nuclear-spin-parity`]).\n\n`2J` has the same parity as the mass number `A = Z + N`.  In\nparticular, `2J` is even ⟺ `A` is even, which corresponds to\n`J ∈ ℤ` ⟺ `A` even (and `J ∈ ℤ + 1/2` ⟺ `A` odd). ","formalizes":[{"@id":"block:prop:nuclear-spin-parity","label":"prop:nuclear-spin-parity","md":"quantum-observable-universe/predicted-spectra/nuclear-spin-parity.md"}],"signatureChunk":0},{"@id":"lean:QOU.Archimedean.NucleusLike.claim_spin_parity","@type":"LeanDeclaration","name":"QOU.Archimedean.NucleusLike.claim_spin_parity","kind":"theorem","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/nuclear_spin_parity.lean#L42-L42","doc":"Manuscript spin-parity identity: `2J ≡ A (mod 2)` where\n`A = Z + N`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.NucleusLike.twoJ","@type":"LeanDeclaration","name":"QOU.Archimedean.NucleusLike.twoJ","kind":"def","line":39,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/nuclear_spin_parity.lean#L39-L39","doc":"Twice the total angular momentum, `2J ∈ ℕ` (so `J = (2J)/2`). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.NucleusLike.N","@type":"LeanDeclaration","name":"QOU.Archimedean.NucleusLike.N","kind":"def","line":37,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/nuclear_spin_parity.lean#L37-L37","doc":"Neutron number. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.NucleusLike.Z","@type":"LeanDeclaration","name":"QOU.Archimedean.NucleusLike.Z","kind":"def","line":35,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/nuclear_spin_parity.lean#L35-L35","doc":"Proton number. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.NucleusLike.mk","@type":"LeanDeclaration","name":"QOU.Archimedean.NucleusLike.mk","kind":"ctor","line":33,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/nuclear_spin_parity.lean#L33-L33","signatureChunk":0},{"@id":"lean:QOU.Archimedean.NucleusLike","@type":"LeanDeclaration","name":"QOU.Archimedean.NucleusLike","kind":"class","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/nuclear_spin_parity.lean#L30-L42","doc":"Abstract nucleus record: proton/neutron counts and the\ntwice-angular-momentum `2J`.  Working with `2J : ℕ` rather than\n`J : ℚ` lets us state the parity claim without fractions. ","signatureChunk":0}]}