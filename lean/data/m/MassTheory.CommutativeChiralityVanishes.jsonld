{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:MassTheory.CommutativeChiralityVanishes","@type":"LeanModule","name":"MassTheory.CommutativeChiralityVanishes","imports":["lean:module:Init","lean:module:Mathlib.Analysis.SpecialFunctions.Pow.Real","lean:module:Mathlib.Topology.Basic"],"declarations":6,"chunks":1},{"@id":"lean:QOU.WedderburnMass.commutativeBindingCorrection","@type":"LeanDeclaration","name":"QOU.WedderburnMass.commutativeBindingCorrection","kind":"def","line":63,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/commutative-chirality-vanishes.lean#L63-L68","doc":"The classical (commutative) atomic-mass binding correction\nhas only two terms (Φ₁ and Φ₂), the chirality term having\nvanished. ","signatureChunk":0},{"@id":"lean:QOU.WedderburnMass.commutative_chirality_vanishes","@type":"LeanDeclaration","name":"QOU.WedderburnMass.commutative_chirality_vanishes","kind":"theorem","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/commutative-chirality-vanishes.lean#L49-L61","doc":"**Corollary (chirality vanishes in commutative limit).**\nFor any chirality function Φ₃ that is continuous at q = 1\n(or merely tendsto a finite limit), the product H_A²·Φ₃ tends\nto zero as q → 1. ","formalizes":[{"@id":"block:cor:commutative-chirality-vanishes","label":"cor:commutative-chirality-vanishes","md":"quantum-observable-universe/mass-theory/commutative-chirality-vanishes.md"}],"signatureChunk":0},{"@id":"lean:QOU.WedderburnMass.H_A_sq_tends_to_zero","@type":"LeanDeclaration","name":"QOU.WedderburnMass.H_A_sq_tends_to_zero","kind":"theorem","line":37,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/commutative-chirality-vanishes.lean#L37-L47","doc":"H_A² → 0 as q → 1. ","signatureChunk":0},{"@id":"lean:QOU.WedderburnMass.H_A_continuousAt_one","@type":"LeanDeclaration","name":"QOU.WedderburnMass.H_A_continuousAt_one","kind":"theorem","line":31,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/commutative-chirality-vanishes.lean#L31-L35","doc":"H_A is continuous on a neighborhood of q = 1 (away from q = 0). ","signatureChunk":0},{"@id":"lean:QOU.WedderburnMass.H_A_at_one","@type":"LeanDeclaration","name":"QOU.WedderburnMass.H_A_at_one","kind":"theorem","line":26,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/commutative-chirality-vanishes.lean#L26-L29","doc":"H_A is continuous away from q = 0, and H_A(1) = 0. ","signatureChunk":0},{"@id":"lean:QOU.WedderburnMass.H_A","@type":"LeanDeclaration","name":"QOU.WedderburnMass.H_A","kind":"def","line":23,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/commutative-chirality-vanishes.lean#L23-L24","doc":"The Hecke parameter H_A as a function of q. ","signatureChunk":0}]}