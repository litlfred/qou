{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.BraidKnot.ConfinedParticle","@type":"LeanModule","name":"QOU.BraidKnot.ConfinedParticle","imports":["lean:module:Init","lean:module:QOU.Archimedean.HeckeRep","lean:module:QOU.Archimedean.GroundRing","lean:module:QOU.Interactions.ConfinementSDP"],"declarations":15,"chunks":1},{"@id":"lean:QOU.BraidKnot.coarseStrands_eq_markov_strands","@type":"LeanDeclaration","name":"QOU.BraidKnot.coarseStrands_eq_markov_strands","kind":"theorem","line":79,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ConfinedParticle.lean#L79-L85","doc":"**Coarse-strand correctness** — proved by definition.\nThe earlier `WellFormedConfinedParticle` typeclass is no longer\nneeded: `coarseStrands` is now a derived projection through the\nMarkov class, so the equality holds by `rfl`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.confined","@type":"LeanDeclaration","name":"QOU.BraidKnot.confined","kind":"def","line":74,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ConfinedParticle.lean#L74-L77","doc":"Confinement predicate accessor. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.HasConfinementWitness.confined","@type":"LeanDeclaration","name":"QOU.BraidKnot.HasConfinementWitness.confined","kind":"def","line":72,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ConfinedParticle.lean#L72-L72","doc":"The confinement predicate at parameter `q`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.HasConfinementWitness.mk","@type":"LeanDeclaration","name":"QOU.BraidKnot.HasConfinementWitness.mk","kind":"ctor","line":70,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ConfinedParticle.lean#L70-L70","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.HasConfinementWitness","@type":"LeanDeclaration","name":"QOU.BraidKnot.HasConfinementWitness","kind":"class","line":65,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ConfinedParticle.lean#L65-L72","doc":"Confinement predicate on a particle at a parameter value. The\nsemantic content (`confined P q ↔ Slater-strict SDP feasibility\nat (P, q)`) is supplied per-instance via `HasConfinementWitness`\nbelow; the ambient predicate is just a typeclass accessor. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.ConfinedParticle.coarseStrands","@type":"LeanDeclaration","name":"QOU.BraidKnot.ConfinedParticle.coarseStrands","kind":"def","line":58,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ConfinedParticle.lean#L58-L61","doc":"Coarse strand count `n₀` at level ℓ — derived from the Markov\nclass so well-formedness holds definitionally. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.ConfinedParticle.markovClass","@type":"LeanDeclaration","name":"QOU.BraidKnot.ConfinedParticle.markovClass","kind":"def","line":54,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ConfinedParticle.lean#L54-L54","doc":"Canonical Markov class of the underlying closed braid. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.ConfinedParticle.level","@type":"LeanDeclaration","name":"QOU.BraidKnot.ConfinedParticle.level","kind":"def","line":52,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ConfinedParticle.lean#L52-L52","doc":"Confinement level ℓ (quark = 0, nucleon = 1, atom = 2,\ncompound = 3). ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.ConfinedParticle.name","@type":"LeanDeclaration","name":"QOU.BraidKnot.ConfinedParticle.name","kind":"def","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ConfinedParticle.lean#L49-L49","doc":"Symbol from the particle-shortcut registry\n(e.g. `\"proton\"`, `\"\\\\He4\"`, `\"electron\"`). ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.ConfinedParticle.mk","@type":"LeanDeclaration","name":"QOU.BraidKnot.ConfinedParticle.mk","kind":"ctor","line":46,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ConfinedParticle.lean#L46-L46","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.ConfinedParticle","@type":"LeanDeclaration","name":"QOU.BraidKnot.ConfinedParticle","kind":"structure","line":37,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ConfinedParticle.lean#L37-L54","doc":"**Confined particle.** A named tuple at a confinement level\nwith an underlying Markov class of closed braid. Stability\npredicates layer on top; confinement at `q ∈ R_q` is the\nSDP-feasibility predicate.\n\nNote: the coarse strand count is derived from the Markov class\nrather than stored separately, so well-formedness\n(`coarseStrands = markovClass.strandCount`) holds by definition. ","formalizes":[{"@id":"block:def:confined-particle","label":"def:confined-particle","md":"quantum-observable-universe/knots-particles-confinement/confined-particle.md"}],"signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MarkovClass.gsNormalForm","@type":"LeanDeclaration","name":"QOU.BraidKnot.MarkovClass.gsNormalForm","kind":"def","line":35,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ConfinedParticle.lean#L35-L35","doc":"The canonical GS-NF representative as a Hecke braid word. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MarkovClass.strandCount","@type":"LeanDeclaration","name":"QOU.BraidKnot.MarkovClass.strandCount","kind":"def","line":33,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ConfinedParticle.lean#L33-L33","doc":"Number of strands of the canonical representative. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MarkovClass.mk","@type":"LeanDeclaration","name":"QOU.BraidKnot.MarkovClass.mk","kind":"ctor","line":31,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ConfinedParticle.lean#L31-L31","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.MarkovClass","@type":"LeanDeclaration","name":"QOU.BraidKnot.MarkovClass","kind":"structure","line":23,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/ConfinedParticle.lean#L23-L35","doc":"**Markov class.** Equivalence class of closed braids under\nMarkov moves, represented canonically by its Gröbner–Shirshov\nnormal form as a `BraidWord n`.\n\nTwo closed braids that are Markov-equivalent share the same\ncanonical representative. The `strandCount` field is the `n` of\nthe underlying `BraidWord n`. ","signatureChunk":0}]}