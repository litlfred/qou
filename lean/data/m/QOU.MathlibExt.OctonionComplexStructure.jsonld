{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.MathlibExt.OctonionComplexStructure","@type":"LeanModule","name":"QOU.MathlibExt.OctonionComplexStructure","imports":["lean:module:Init","lean:module:QOU.MathlibExt.OctonionSU3BracketClosure"],"declarations":6,"chunks":1},{"@id":"lean:QOU.MathlibExt.OctonionDerivations.su3_comp_Le_eq_Le_comp","@type":"LeanDeclaration","name":"QOU.MathlibExt.OctonionDerivations.su3_comp_Le_eq_Le_comp","kind":"theorem","line":65,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/OctonionComplexStructure.lean#L65-L78","doc":"**The colour stabilizer acts ℂ-linearly on the octonions**: every\nderivation fixing `e₁` commutes with the complex structure `Le`. Pure\nLeibniz: `D(e₁·x) = D(e₁)·x + e₁·D(x) = e₁·D(x)`. ","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.OctonionDerivations.octMul_zero_left","@type":"LeanDeclaration","name":"QOU.MathlibExt.OctonionDerivations.octMul_zero_left","kind":"theorem","line":60,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/OctonionComplexStructure.lean#L60-L63","doc":"Zero-left-argument vanishing for the concrete product (helper). ","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.OctonionDerivations.Le_sq_eq_neg_id","@type":"LeanDeclaration","name":"QOU.MathlibExt.OctonionDerivations.Le_sq_eq_neg_id","kind":"theorem","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/OctonionComplexStructure.lean#L49-L58","doc":"**`Le` is a complex structure**: left multiplication by the unit\nimaginary `e₁` squares to `−id` on all of `𝕆` (the alternative-algebra\nidentity `u(ux) = u²x`, verified componentwise on the concrete\nmultiplication table). ","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.OctonionDerivations.Le_apply","@type":"LeanDeclaration","name":"QOU.MathlibExt.OctonionDerivations.Le_apply","kind":"theorem","line":47,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/OctonionComplexStructure.lean#L47-L47","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.OctonionDerivations.Le","@type":"LeanDeclaration","name":"QOU.MathlibExt.OctonionDerivations.Le","kind":"def","line":44,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/OctonionComplexStructure.lean#L44-L45","doc":"Left multiplication by `e₁`, as a ℚ-linear endomorphism of `𝕆`. ","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.OctonionDerivations.stdIm","@type":"LeanDeclaration","name":"QOU.MathlibExt.OctonionDerivations.stdIm","kind":"def","line":41,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/OctonionComplexStructure.lean#L41-L42","doc":"The standard unit imaginary octonion `e₁` as a concrete vector. ","signatureChunk":0}]}