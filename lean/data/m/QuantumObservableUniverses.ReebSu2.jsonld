tureChunk":0},{"@id":"lean:QOU.Examples.SU2ReebData.normalisation","@type":"LeanDeclaration","name":"QOU.Examples.SU2ReebData.normalisation","kind":"theorem","line":43,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/reeb-su2.lean#L43-L43","doc":"Normalisation: θ_A(ξ) = 1.\nWitnessed by: the contact form and generator indices match\n(ω₃(e₃) = δ₃₃ = 1 in a dual basis). ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2ReebData.contact_is_three","@type":"LeanDeclaration","name":"QOU.Examples.SU2ReebData.contact_is_three","kind":"theorem","line":39,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/reeb-su2.lean#L39-L39","doc":"θ_A = ω₃. ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2ReebData.contactFormIndex","@type":"LeanDeclaration","name":"QOU.Examples.SU2ReebData.contactFormIndex","kind":"def","line":37,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/reeb-su2.lean#L37-L37","doc":"Index of the dual 1-form θ_A (ω₃ → index 3). ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2ReebData.gen_is_three","@type":"LeanDeclaration","name":"QOU.Examples.SU2ReebData.gen_is_three","kind":"theorem","line":35,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/reeb-su2.lean#L35-L35","doc":"ξ is the third basis element. ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2ReebData.generatorIndex","@type":"LeanDeclaration","name":"QOU.Examples.SU2ReebData.generatorIndex","kind":"def","line":33,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/reeb-su2.lean#L33-L33","doc":"Index of the Lie algebra generator serving as ξ (e₃ → index 3). ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2ReebData.mk","@type":"LeanDeclaration","name":"QOU.Examples.SU2ReebData.mk","kind":"ctor","line":31,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/reeb-su2.lean#L31-L31","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2ReebData","@type":"LeanDeclaration","name":"QOU.Examples.SU2ReebData","kind":"structure","line":27,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/reeb-su2.lean#L27-L47","doc":"**SU(2) Reeb data**: ξ = e₃ with contact form θ_A = ω₃.\n\nLaTeX: `\\label{ex:reeb-su2}` ","signatureChunk":0}]}