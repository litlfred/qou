Chunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.act4He","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.act4He","kind":"def","line":182,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L182-L183","signatureChunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.act3H","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.act3H","kind":"def","line":181,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L181-L181","signatureChunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.act2H","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.act2H","kind":"def","line":180,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L180-L180","signatureChunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.lrPos","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.lrPos","kind":"def","line":162,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L162-L168","doc":"LR positivity `c^ν_{λμ} > 0`, by skew ballot-tableau search. ","signatureChunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.searchRows","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.searchRows","kind":"def","line":153,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L153-L160","doc":"Search all rows (paired `(λ_i, ν_i)`, top to bottom). Fuel is the row\nlist itself (structural). ","signatureChunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.fillRow","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.fillRow","kind":"def","line":128,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L128-L151","doc":"Fill one skew row right-to-left (columns `lo + k - 1` down to `lo`).\n`acc` accumulates the row **left-to-right** (each placement is one column\nfurther left and is prepended). `next` receives the finished row and updated\ncounts. Constraints per placement, in reverse-reading-word order: entry\ncapacity (`counts e < μ e`), incremental ballot (`counts e < counts (e-1)`),\nweak increase along the row (`e ≤ rightBound`), strict increase down the\ncolumn (`e > entry above`, when the cell above lies in the skew shape). ","signatureChunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.bump","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.bump","kind":"def","line":124,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L124-L126","doc":"Increment index `e-1` of the counts vector. ","signatureChunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.subShape","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.subShape","kind":"def","line":119,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L119-L122","doc":"λ ⊆ ν as Young diagrams (pointwise with zero padding). ","signatureChunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.getD","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.getD","kind":"def","line":117,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L117-L117","signatureChunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.partitionsOf","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.partitionsOf","kind":"def","line":115,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L115-L115","signatureChunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.partAux","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.partAux","kind":"def","line":103,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L103-L113","doc":"`part n maxPart`: all partitions of `n` with parts ≤ `maxPart`,\nfirst-part-descending. Fuel = `n` suffices (each chosen part ≥ 1). ","signatureChunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.weight","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.weight","kind":"def","line":101,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L101-L101","signatureChunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.Partition","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.Partition","kind":"def","line":98,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L98-L99","doc":"A partition, as a weakly decreasing list of positive naturals. ","signatureChunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.betaDecay_not_rearrangement","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.betaDecay_not_rearrangement","kind":"theorem","line":92,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L92-L94","doc":"β-decay is not a rearrangement: proton number moves. This is the\nsubject-side discriminator that routes it to the weak (bar-odd) sector. ","signatureChunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.dtFusion_strands_fifteen","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.dtFusion_strands_fifteen","kind":"theorem","line":87,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L87-L90","doc":"The two sides of D + T → ⁴He + n share the frame `H_15`. ","signatureChunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.dtFusion_isRearrangement","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.dtFusion_isRearrangement","kind":"theorem","line":85,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L85-L85","signatureChunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.betaDecay","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.betaDecay","kind":"def","line":81,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L81-L83","doc":"β-decay of the free neutron, subject side only (the lepton pair is not a\nnuclear subject). ","signatureChunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.dtFusion","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.dtFusion","kind":"def","line":78,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L78-L79","doc":"The D + T → ⁴He + n fusion process. ","signatureChunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.proton","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.proton","kind":"def","line":76,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L76-L76","signatureChunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.neutron","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.neutron","kind":"def","line":75,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L75-L75","signatureChunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.helium4","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.helium4","kind":"def","line":74,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L74-L74","signatureChunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.tritium","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.tritium","kind":"def","line":73,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L73-L73","signatureChunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.deuteron","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.deuteron","kind":"def","line":72,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L72-L72","signatureChunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.Process.isRearrangement","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.Process.isRearrangement","kind":"def","line":66,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L66-L70","doc":"A **fusion/rearrangement process** (strong sector): all three balances\nhold. A process failing `chargeBalanced` while conserving baryon number is a\nweak-sector conversion, not a rearrangement. ","formalizes":[{"@id":"block:def:fusion-process","label":"def:fusion-process","md":"quantum-observable-universe/knots-particles-confinement/fusion-process.md"}],"signatureChunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.Process.baryonBalanced","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.Process.baryonBalanced","kind":"def","line":62,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L62-L64","doc":"Baryon-number conservation. ","signatureChunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.Process.chargeBalanced","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.Process.chargeBalanced","kind":"def","line":58,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L58-L60","doc":"Proton-number conservation on the subject side. ","signatureChunk":0},{"@id":"lean:QOU.Interactions.FusionProcessBlock.Process.strandBalanced","@type":"LeanDeclaration","name":"QOU.Interactions.FusionProcessBlock.Process.strandBalanced","kind":"def","line":54,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/fusion-process.lean#L54-L56","doc":"Strand conservation: the two sides live in the same total Hecke frame. "