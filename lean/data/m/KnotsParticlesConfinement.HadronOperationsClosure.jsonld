{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:KnotsParticlesConfinement.HadronOperationsClosure","@type":"LeanModule","name":"KnotsParticlesConfinement.HadronOperationsClosure","imports":["lean:module:Init","lean:module:Mathlib.Algebra.BigOperators.Group.List.Basic","lean:module:Mathlib.Data.Real.Basic","lean:module:Mathlib.Tactic.Ring"],"declarations":24,"chunks":1},{"@id":"lean:QOU.Hadron.hadron_operations_closure","@type":"LeanDeclaration","name":"QOU.Hadron.hadron_operations_closure","kind":"theorem","line":124,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron-operations-closure.lean#L124-L154","doc":"`Sym^n(K)` is closed under braiding, Hopf linking, skein resolution,\nand fusion, satisfying braiding involution and alternating sign flip,\nHopf-linking two-sided invertibility, the skein mass decomposition,\nand fusion associativity and mass additivity (`qou-z3k1`). ","formalizes":[{"@id":"block:prop:hadron-operations-closure","label":"prop:hadron-operations-closure","md":"quantum-observable-universe/knots-particles-confinement/hadron-operations-closure.md"}],"signatureChunk":0},{"@id":"lean:QOU.Hadron.fusionOp_mass_add","@type":"LeanDeclaration","name":"QOU.Hadron.fusionOp_mass_add","kind":"theorem","line":117,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron-operations-closure.lean#L117-L122","signatureChunk":0},{"@id":"lean:QOU.Hadron.fusionOp_constituents_assoc","@type":"LeanDeclaration","name":"QOU.Hadron.fusionOp_constituents_assoc","kind":"theorem","line":111,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron-operations-closure.lean#L111-L115","signatureChunk":0},{"@id":"lean:QOU.Hadron.skein_mass_decomposition","@type":"LeanDeclaration","name":"QOU.Hadron.skein_mass_decomposition","kind":"theorem","line":106,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron-operations-closure.lean#L106-L109","signatureChunk":0},{"@id":"lean:QOU.Hadron.skeinOp_idem","@type":"LeanDeclaration","name":"QOU.Hadron.skeinOp_idem","kind":"theorem","line":101,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron-operations-closure.lean#L101-L104","signatureChunk":0},{"@id":"lean:QOU.Hadron.hopfLinkOp_zero","@type":"LeanDeclaration","name":"QOU.Hadron.hopfLinkOp_zero","kind":"theorem","line":96,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron-operations-closure.lean#L96-L99","signatureChunk":0},{"@id":"lean:QOU.Hadron.hopfLinkOp_right_inv","@type":"LeanDeclaration","name":"QOU.Hadron.hopfLinkOp_right_inv","kind":"theorem","line":91,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron-operations-closure.lean#L91-L94","signatureChunk":0},{"@id":"lean:QOU.Hadron.hopfLinkOp_left_inv","@type":"LeanDeclaration","name":"QOU.Hadron.hopfLinkOp_left_inv","kind":"theorem","line":86,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron-operations-closure.lean#L86-L89","signatureChunk":0},{"@id":"lean:QOU.Hadron.braidingOp_alt_sign","@type":"LeanDeclaration","name":"QOU.Hadron.braidingOp_alt_sign","kind":"theorem","line":81,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron-operations-closure.lean#L81-L84","signatureChunk":0},{"@id":"lean:QOU.Hadron.braidingOp_involution","@type":"LeanDeclaration","name":"QOU.Hadron.braidingOp_involution","kind":"theorem","line":76,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron-operations-closure.lean#L76-L79","signatureChunk":0},{"@id":"lean:QOU.Hadron.fusionOp","@type":"LeanDeclaration","name":"QOU.Hadron.fusionOp","kind":"def","line":69,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron-operations-closure.lean#L69-L74","doc":"Fusion of two hadrons `Sym^{n₁}(K) × Sym^{n₂}(K) → Sym^{n₁ + n₂}(K)`. ","signatureChunk":0},{"@id":"lean:QOU.Hadron.hadronMass","@type":"LeanDeclaration","name":"QOU.Hadron.hadronMass","kind":"def","line":65,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron-operations-closure.lean#L65-L67","doc":"Skein mass functional `M(H) = hopfLinkCount * Q(q) * M(L_Hopf) + ∑_i M(K_i)`. ","signatureChunk":0},{"@id":"lean:QOU.Hadron.skeinOp","@type":"LeanDeclaration","name":"QOU.Hadron.skeinOp","kind":"def","line":57,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron-operations-closure.lean#L57-L63","doc":"Skein resolution on `Sym^n(K)`: projects a linked composite onto its\nunlinked constituent state (`hopfLinkCount = 0`). ","signatureChunk":0},{"@id":"lean:QOU.Hadron.hopfLinkOp","@type":"LeanDeclaration","name":"QOU.Hadron.hopfLinkOp","kind":"def","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron-operations-closure.lean#L49-L55","doc":"Hopf linking endomorphism on `Sym^n(K) ⊗ L_Hopf` shifting the Hopf linking\nnumber by `k : ℤ`. ","signatureChunk":0},{"@id":"lean:QOU.Hadron.braidingOp","@type":"LeanDeclaration","name":"QOU.Hadron.braidingOp","kind":"def","line":41,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron-operations-closure.lean#L41-L47","doc":"Braiding operation on `Sym^n(K)`: reverses constituent order and flips the\nalternating-sector sign (`β|_{alt} = -1`). ","signatureChunk":0},{"@id":"lean:QOU.Hadron.Hadron","@type":"LeanDeclaration","name":"QOU.Hadron.Hadron","kind":"def","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron-operations-closure.lean#L38-L39","doc":"Alias `Hadron n` for an `n`-constituent hadron state in `Sym^n(K)`. ","signatureChunk":0},{"@id":"lean:QOU.Hadron.HadronState.altAmplitude","@type":"LeanDeclaration","name":"QOU.Hadron.HadronState.altAmplitude","kind":"def","line":35,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron-operations-closure.lean#L35-L35","doc":"Alternating-sector exchange amplitude. ","signatureChunk":0},{"@id":"lean:QOU.Hadron.HadronState.hopfLinkCount","@type":"LeanDeclaration","name":"QOU.Hadron.HadronState.hopfLinkCount","kind":"def","line":33,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron-operations-closure.lean#L33-L33","doc":"Net Hopf linking number with `L_Hopf`. ","signatureChunk":0},{"@id":"lean:QOU.Hadron.HadronState.length_eq","@type":"LeanDeclaration","name":"QOU.Hadron.HadronState.length_eq","kind":"theorem","line":31,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron-operations-closure.lean#L31-L31","doc":"Constituent count equals `n`. ","signatureChunk":0},{"@id":"lean:QOU.Hadron.HadronState.constituents","@type":"LeanDeclaration","name":"QOU.Hadron.HadronState.constituents","kind":"def","line":29,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron-operations-closure.lean#L29-L29","doc":"Constituent knot masses `(M(K_1), ..., M(K_n))`. ","signatureChunk":0},{"@id":"lean:QOU.Hadron.HadronState.mk","@type":"LeanDeclaration","name":"QOU.Hadron.HadronState.mk","kind":"ctor","line":27,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron-operations-closure.lean#L27-L27","signatureChunk":0},{"@id":"lean:QOU.Hadron.HadronState.ext","@type":"LeanDeclaration","name":"QOU.Hadron.HadronState.ext","kind":"theorem","line":26,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron-operations-closure.lean#L26-L26","signatureChunk":0},{"@id":"lean:QOU.Hadron.HadronState.ext_iff","@type":"LeanDeclaration","name":"QOU.Hadron.HadronState.ext_iff","kind":"theorem","line":26,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron-operations-closure.lean#L26-L26","signatureChunk":0},{"@id":"lean:QOU.Hadron.HadronState","@type":"LeanDeclaration","name":"QOU.Hadron.HadronState","kind":"structure","line":25,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron-operations-closure.lean#L25-L35","doc":"Concrete carrier for an `n`-constituent hadron state in `Sym^n(K) ⊗ L_Hopf` (`qou-z3k1`). ","signatureChunk":0}]}