gnatureChunk":0},{"@id":"lean:QOU.Torsion.skein_dd","@type":"LeanDeclaration","name":"QOU.Torsion.skein_dd","kind":"def","line":103,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/knot-particle-generation.lean#L103-L104","doc":"S_dd ≈ 313.665 MeV. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.skein_ud","@type":"LeanDeclaration","name":"QOU.Torsion.skein_ud","kind":"def","line":100,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/knot-particle-generation.lean#L100-L101","doc":"S_ud ≈ 312.950 MeV. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.skein_uu","@type":"LeanDeclaration","name":"QOU.Torsion.skein_uu","kind":"def","line":97,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/knot-particle-generation.lean#L97-L98","doc":"S_uu ≈ 312.370 MeV. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.pairSkeinMass","@type":"LeanDeclaration","name":"QOU.Torsion.pairSkeinMass","kind":"def","line":89,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/knot-particle-generation.lean#L89-L95","doc":"Pair Skein mass: S_ab(q) = (q·μ_a + q⁻¹·μ_b) / (q^½ + q^{-½}).\nThis is the mass contribution from a single crossing pair in the\nBorromean braid of a nucleon. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.mu_down","@type":"LeanDeclaration","name":"QOU.Torsion.mu_down","kind":"def","line":85,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/knot-particle-generation.lean#L85-L87","doc":"Dressed down-quark Skein mass (MeV), from CODATA nucleon masses. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.mu_up","@type":"LeanDeclaration","name":"QOU.Torsion.mu_up","kind":"def","line":81,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/knot-particle-generation.lean#L81-L83","doc":"Dressed up-quark Skein mass (MeV), from CODATA nucleon masses. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.vol_three_twist","@type":"LeanDeclaration","name":"QOU.Torsion.vol_three_twist","kind":"def","line":73,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/knot-particle-generation.lean#L73-L75","doc":"Vol(5₂) ≈ 2.8281220883 (three-twist knot, strange/down quark). ","signatureChunk":0},{"@id":"lean:QOU.Torsion.vol_figure_eight","@type":"LeanDeclaration","name":"QOU.Torsion.vol_figure_eight","kind":"def","line":69,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/knot-particle-generation.lean#L69-L71","doc":"Vol(4₁) = 2·Cl₂(π/3) ≈ 2.0298832128 (figure-eight knot, muon). ","signatureChunk":0},{"@id":"lean:QOU.Torsion.hyperbolicVolume","@type":"LeanDeclaration","name":"QOU.Torsion.hyperbolicVolume","kind":"def","line":61,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/knot-particle-generation.lean#L61-L63","doc":"Torus knots have zero hyperbolic volume. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.seifertGenus","@type":"LeanDeclaration","name":"QOU.Torsion.seifertGenus","kind":"def","line":57,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/knot-particle-generation.lean#L57-L59","doc":"Seifert genus of T_{m,n} = (m-1)(n-1)/2. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.TorusKnot.m_lt_n","@type":"LeanDeclaration","name":"QOU.Torsion.TorusKnot.m_lt_n","kind":"theorem","line":55,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/knot-particle-generation.lean#L55-L55","doc":"Convention m < n (for m ≥ 2). ","signatureChunk":0},{"@id":"lean:QOU.Torsion.TorusKnot.coprime","@type":"LeanDeclaration","name":"QOU.Torsion.TorusKnot.coprime","kind":"theorem","line":53,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/knot-particle-generation.lean#L53-L53","doc":"Winding numbers are coprime. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.TorusKnot.n","@type":"LeanDeclaration","name":"QOU.Torsion.TorusKnot.n","kind":"def","line":51,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/knot-particle-generation.lean#L51-L51","doc":"Longitudinal winding number. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.TorusKnot.m","@type":"LeanDeclaration","name":"QOU.Torsion.TorusKnot.m","kind":"def","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/knot-particle-generation.lean#L49-L49","doc":"Meridional winding number. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.TorusKnot.mk","@type":"LeanDeclaration","name":"QOU.Torsion.TorusKnot.mk","kind":"ctor","line":47,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/knot-particle-generation.lean#L47-L47","signatureChunk":0},{"@id":"lean:QOU.Torsion.TorusKnot","@type":"LeanDeclaration","name":"QOU.Torsion.TorusKnot","kind":"structure","line":45,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/knot-particle-generation.lean#L45-L55","doc":"A torus knot type T_{m,n} with coprime winding numbers. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.hbarQ","@type":"LeanDeclaration","name":"QOU.Torsion.hbarQ","kind":"def","line":37,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/knot-particle-generation.lean#L37-L39","doc":"Quantum Planck constant ℏ_q = 1 - 1/q. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.q_substrate","@type":"LeanDeclaration","name":"QOU.Torsion.q_substrate","kind":"def","line":32,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/knot-particle-generation.lean#L32-L35","doc":"The substrate parameter q, derived from the muon-electron mass ratio.\nCODATA 2022: m_μ/m_e = 206.7682830 → q ≈ 1.10997. ","signatureChunk":0}]}