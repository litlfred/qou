{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:KnotsParticlesConfinement.CategoricalNeutron","@type":"LeanModule","name":"KnotsParticlesConfinement.CategoricalNeutron","imports":["lean:module:Init","lean:module:Mathlib.Data.Real.Basic","lean:module:Mathlib.Tactic.NormNum","lean:module:Mathlib.Tactic.Ring"],"declarations":12,"chunks":1},{"@id":"lean:QOU.Torsion.neutron_proton_splitting","@type":"LeanDeclaration","name":"QOU.Torsion.neutron_proton_splitting","kind":"theorem","line":78,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/categorical-neutron.lean#L78-L91","doc":"The proton-neutron mass splitting is a pure function of q.\nΔm = S_dd(q) - S_uu(q) ≈ 1.293 MeV at q₀. ","formalizes":[{"@id":"block:prop:neutron-proton-splitting","label":"prop:neutron-proton-splitting","md":"quantum-observable-universe/mass-theory/neutron-proton-splitting.md"}],"signatureChunk":0},{"@id":"lean:QOU.Torsion.neutron_mass_from_substrate","@type":"LeanDeclaration","name":"QOU.Torsion.neutron_mass_from_substrate","kind":"theorem","line":74,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/categorical-neutron.lean#L74-L76","signatureChunk":0},{"@id":"lean:QOU.Torsion.neutron_mass_from_substrate_axiom","@type":"LeanDeclaration","name":"QOU.Torsion.neutron_mass_from_substrate_axiom","kind":"axiom","line":64,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/categorical-neutron.lean#L64-L72","doc":"**External axiom (§3b-cond pattern): neutron_mass_from_substrate.**\n\nAuto-extracted from the single-sorry theorem body in this file.\nEncodes the categorical content pending Mathlib infrastructure\nor a structure-tightening refactor.\n\nSee the theorem docstring below for the cited reference. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.neutron_mass","@type":"LeanDeclaration","name":"QOU.Torsion.neutron_mass","kind":"def","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/categorical-neutron.lean#L49-L58","doc":"The neutron mass as a function of the substrate parameter q.\nm_𝔫(q) = 2 · S_ud(q) + S_dd(q), where the pair Skein masses\nare determined by the Borromean volume and crossing energy at q.\nThe neutron has a slightly higher mass than the proton due to the\nSkein resolution asymmetry between dd and uu crossings. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.q₀_gt_one","@type":"LeanDeclaration","name":"QOU.Torsion.q₀_gt_one","kind":"theorem","line":46,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/categorical-neutron.lean#L46-L47","doc":"q₀ > 1. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.q₀","@type":"LeanDeclaration","name":"QOU.Torsion.q₀","kind":"def","line":41,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/categorical-neutron.lean#L41-L44","doc":"The CODATA substrate parameter q₀ ≈ 1.1097, the unique root q > 1\nof `(1 - q⁻¹)² = Vol(4₁)/(m_μ/m_e)`.\nSee `QOU.Experimental.LocalSubstrateQ`. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.CategoricalNeutron.chirality","@type":"LeanDeclaration","name":"QOU.Torsion.CategoricalNeutron.chirality","kind":"def","line":35,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/categorical-neutron.lean#L35-L35","doc":"Zero crossing chirality (electric charge = 0). ","signatureChunk":0},{"@id":"lean:QOU.Torsion.CategoricalNeutron.mass","@type":"LeanDeclaration","name":"QOU.Torsion.CategoricalNeutron.mass","kind":"def","line":33,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/categorical-neutron.lean#L33-L33","doc":"Mass = 2·S_ud + S_dd. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.CategoricalNeutron.skein_dd","@type":"LeanDeclaration","name":"QOU.Torsion.CategoricalNeutron.skein_dd","kind":"def","line":31,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/categorical-neutron.lean#L31-L31","doc":"Pair Skein mass S_dd. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.CategoricalNeutron.skein_ud","@type":"LeanDeclaration","name":"QOU.Torsion.CategoricalNeutron.skein_ud","kind":"def","line":29,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/categorical-neutron.lean#L29-L29","doc":"Pair Skein mass S_ud. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.CategoricalNeutron.mk","@type":"LeanDeclaration","name":"QOU.Torsion.CategoricalNeutron.mk","kind":"ctor","line":27,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/categorical-neutron.lean#L27-L27","signatureChunk":0},{"@id":"lean:QOU.Torsion.CategoricalNeutron","@type":"LeanDeclaration","name":"QOU.Torsion.CategoricalNeutron","kind":"structure","line":24,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/categorical-neutron.lean#L24-L35","doc":"The categorical neutron: color-linked triple [u, d, d]_c ⋈ L_H.\nMass = 2·S_ud + S_dd ≈ 939.565 MeV. ","formalizes":[{"@id":"block:def:categorical-neutron","label":"def:categorical-neutron","md":"quantum-observable-universe/knots-particles-confinement/categorical-neutron.md"}],"signatureChunk":0}]}