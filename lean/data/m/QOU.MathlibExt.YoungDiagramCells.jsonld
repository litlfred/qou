{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.MathlibExt.YoungDiagramCells","@type":"LeanModule","name":"QOU.MathlibExt.YoungDiagramCells","imports":["lean:module:Init","lean:module:Mathlib.Combinatorics.Young.YoungDiagram","lean:module:Mathlib.Tactic.FinCases","lean:module:Mathlib.Tactic.Ring"],"declarations":20,"chunks":1},{"@id":"lean:QOU.MathlibExt.YoungDiagramCells.content_spread_eq_corner","@type":"LeanDeclaration","name":"QOU.MathlibExt.YoungDiagramCells.content_spread_eq_corner","kind":"theorem","line":196,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/YoungDiagramCells.lean#L196-L201","doc":"**The content spread is the corner hook.** The number of diagonals the\ndiagram meets equals `λ₁ + λ'₁ - 1`. ","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.YoungDiagramCells.inf_content","@type":"LeanDeclaration","name":"QOU.MathlibExt.YoungDiagramCells.inf_content","kind":"theorem","line":178,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/YoungDiagramCells.lean#L178-L194","doc":"The smallest content is minus the corner's leg, attained on the first column. ","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.YoungDiagramCells.sup_content","@type":"LeanDeclaration","name":"QOU.MathlibExt.YoungDiagramCells.sup_content","kind":"theorem","line":160,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/YoungDiagramCells.lean#L160-L176","doc":"The largest content is the corner's arm, attained on the first row. ","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.YoungDiagramCells.colLen0_pos","@type":"LeanDeclaration","name":"QOU.MathlibExt.YoungDiagramCells.colLen0_pos","kind":"theorem","line":155,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/YoungDiagramCells.lean#L155-L158","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.YoungDiagramCells.rowLen0_pos","@type":"LeanDeclaration","name":"QOU.MathlibExt.YoungDiagramCells.rowLen0_pos","kind":"theorem","line":150,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/YoungDiagramCells.lean#L150-L153","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.YoungDiagramCells.axialDistance_trans","@type":"LeanDeclaration","name":"QOU.MathlibExt.YoungDiagramCells.axialDistance_trans","kind":"theorem","line":143,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/YoungDiagramCells.lean#L143-L146","doc":"Axial distance telescopes along a chain of cells. ","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.YoungDiagramCells.axialDistance_same_col","@type":"LeanDeclaration","name":"QOU.MathlibExt.YoungDiagramCells.axialDistance_same_col","kind":"theorem","line":138,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/YoungDiagramCells.lean#L138-L141","doc":"Cells in the same column: the axial distance is minus the row gap. ","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.YoungDiagramCells.axialDistance_same_row","@type":"LeanDeclaration","name":"QOU.MathlibExt.YoungDiagramCells.axialDistance_same_row","kind":"theorem","line":133,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/YoungDiagramCells.lean#L133-L136","doc":"Cells in the same row: the axial distance is the column gap. ","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.YoungDiagramCells.axialDistance_antisymm","@type":"LeanDeclaration","name":"QOU.MathlibExt.YoungDiagramCells.axialDistance_antisymm","kind":"theorem","line":127,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/YoungDiagramCells.lean#L127-L131","doc":"**Axial distance is antisymmetric.**  Exchanging the two cells negates it,\nwhich is what makes a seminormal pair carry the two parameters `a(d)`, `a(-d)`. ","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.YoungDiagramCells.axialDistance_self","@type":"LeanDeclaration","name":"QOU.MathlibExt.YoungDiagramCells.axialDistance_self","kind":"theorem","line":124,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/YoungDiagramCells.lean#L124-L125","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.YoungDiagramCells.axialDistance_apply","@type":"LeanDeclaration","name":"QOU.MathlibExt.YoungDiagramCells.axialDistance_apply","kind":"theorem","line":121,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/YoungDiagramCells.lean#L121-L122","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.YoungDiagramCells.axialDistance","@type":"LeanDeclaration","name":"QOU.MathlibExt.YoungDiagramCells.axialDistance","kind":"def","line":118,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/YoungDiagramCells.lean#L118-L119","doc":"**Axial distance** from `c` to `d`: the difference of their contents. ","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.YoungDiagramCells.one_le_hook","@type":"LeanDeclaration","name":"QOU.MathlibExt.YoungDiagramCells.one_le_hook","kind":"theorem","line":101,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/YoungDiagramCells.lean#L101-L104","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.YoungDiagramCells.leg_nonneg","@type":"LeanDeclaration","name":"QOU.MathlibExt.YoungDiagramCells.leg_nonneg","kind":"theorem","line":95,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/YoungDiagramCells.lean#L95-L99","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.YoungDiagramCells.arm_nonneg","@type":"LeanDeclaration","name":"QOU.MathlibExt.YoungDiagramCells.arm_nonneg","kind":"theorem","line":89,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/YoungDiagramCells.lean#L89-L93","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.YoungDiagramCells.hook_eq","@type":"LeanDeclaration","name":"QOU.MathlibExt.YoungDiagramCells.hook_eq","kind":"theorem","line":85,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/YoungDiagramCells.lean#L85-L87","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.YoungDiagramCells.hook","@type":"LeanDeclaration","name":"QOU.MathlibExt.YoungDiagramCells.hook","kind":"def","line":80,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/YoungDiagramCells.lean#L80-L81","doc":"**Hook** of a cell: `arm + leg + 1`. ","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.YoungDiagramCells.leg","@type":"LeanDeclaration","name":"QOU.MathlibExt.YoungDiagramCells.leg","kind":"def","line":77,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/YoungDiagramCells.lean#L77-L78","doc":"**Leg** of a cell: the cells strictly below it in its column. ","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.YoungDiagramCells.arm","@type":"LeanDeclaration","name":"QOU.MathlibExt.YoungDiagramCells.arm","kind":"def","line":74,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/YoungDiagramCells.lean#L74-L75","doc":"**Arm** of a cell: the cells strictly to its right in its row. ","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.YoungDiagramCells.content","@type":"LeanDeclaration","name":"QOU.MathlibExt.YoungDiagramCells.content","kind":"def","line":67,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/YoungDiagramCells.lean#L67-L72","doc":"**Content** (diagonal index) of a cell: `j - i`.\n\nContents are what the Jucys–Murphy elements measure — `L_k` acts on the\nseminormal basis by a function of the content of the cell added at step `k` — so\nthis is the coordinate in which diagram statistics become algebra statements. ","signatureChunk":0}]}