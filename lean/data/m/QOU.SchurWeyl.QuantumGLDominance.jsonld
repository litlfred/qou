{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.SchurWeyl.QuantumGLDominance","@type":"LeanModule","name":"QOU.SchurWeyl.QuantumGLDominance","imports":["lean:module:Init","lean:module:QOU.SchurWeyl.QuantumGLSl2Pair","lean:module:QOU.SchurWeyl.QuantumGLWeights","lean:module:Mathlib.LinearAlgebra.Eigenspace.Minpoly"],"declarations":14,"chunks":1},{"@id":"lean:QOU.SchurWeyl.QuantumGL.hwSpace_eq_bot_of_not_dominant","@type":"LeanDeclaration","name":"QOU.SchurWeyl.QuantumGL.hwSpace_eq_bot_of_not_dominant","kind":"theorem","line":229,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/QuantumGLDominance.lean#L229-L237","doc":"**`HW_μ = 0` unless `μ` is dominant**: if `μ(i) > μ(i+1)` for some Chevalley pair, the\nhighest-weight space of weight `μ` is zero. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.QuantumGL.le_of_mem_hwSpace","@type":"LeanDeclaration","name":"QOU.SchurWeyl.QuantumGL.le_of_mem_hwSpace","kind":"theorem","line":206,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/QuantumGLDominance.lean#L206-L227","doc":"**A nonzero highest-weight vector of weight `μ` forces `μ(i) ≤ μ(i+1)`** for every Chevalley\npair. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.QuantumGL.prod_kap_pow","@type":"LeanDeclaration","name":"QOU.SchurWeyl.QuantumGL.prod_kap_pow","kind":"theorem","line":199,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/QuantumGLDominance.lean#L199-L204","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.QuantumGL.sq_eq_pow_of_highest","@type":"LeanDeclaration","name":"QOU.SchurWeyl.QuantumGL.sq_eq_pow_of_highest","kind":"theorem","line":149,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/QuantumGLDominance.lean#L149-L189","doc":"**A nonzero highest-weight vector has `K`-eigenvalue a power of `q`**: `x² = q^{2M}` for some\n`M ≥ 0` (`M + 1` is the length of its `F`-string). ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.QuantumGL.Fpow_eventually_zero","@type":"LeanDeclaration","name":"QOU.SchurWeyl.QuantumGL.Fpow_eventually_zero","kind":"theorem","line":131,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/QuantumGLDominance.lean#L131-L147","doc":"**`F` is eventually zero on a `Kp`-eigenvector**: its iterates would otherwise give infinitely\nmany eigenvalues `x q^{-2k}` of `Kp`. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.QuantumGL.pow_injective_of_notRoot","@type":"LeanDeclaration","name":"QOU.SchurWeyl.QuantumGL.pow_injective_of_notRoot","kind":"theorem","line":116,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/QuantumGLDominance.lean#L116-L127","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.QuantumGL.E_Fpow_succ","@type":"LeanDeclaration","name":"QOU.SchurWeyl.QuantumGL.E_Fpow_succ","kind":"theorem","line":100,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/QuantumGLDominance.lean#L100-L112","doc":"**`E F^{k+1} v = C(k+1) F^k v`** for a highest-weight vector `v`. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.QuantumGL.coefC_succ","@type":"LeanDeclaration","name":"QOU.SchurWeyl.QuantumGL.coefC_succ","kind":"theorem","line":85,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/QuantumGLDominance.lean#L85-L98","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.QuantumGL.coefC_one","@type":"LeanDeclaration","name":"QOU.SchurWeyl.QuantumGL.coefC_one","kind":"theorem","line":78,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/QuantumGLDominance.lean#L78-L83","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.QuantumGL.coefC","@type":"LeanDeclaration","name":"QOU.SchurWeyl.QuantumGL.coefC","kind":"def","line":74,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/QuantumGLDominance.lean#L74-L76","doc":"The coefficient `C(k) = [k][h−k+1]` in multiplicative form, `a = q^k`, `x = q^h`. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.QuantumGL.Kp_Fpow","@type":"LeanDeclaration","name":"QOU.SchurWeyl.QuantumGL.Kp_Fpow","kind":"theorem","line":66,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/QuantumGLDominance.lean#L66-L72","doc":"`F^k v` is a `Kp`-eigenvector with eigenvalue `x q^{-2k}`. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.QuantumGL.E_F_mulVec","@type":"LeanDeclaration","name":"QOU.SchurWeyl.QuantumGL.E_F_mulVec","kind":"theorem","line":60,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/QuantumGLDominance.lean#L60-L64","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.QuantumGL.Kp_F_mulVec","@type":"LeanDeclaration","name":"QOU.SchurWeyl.QuantumGL.Kp_F_mulVec","kind":"theorem","line":57,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/QuantumGLDominance.lean#L57-L58","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.QuantumGL.Km_mulVec_of_Kp","@type":"LeanDeclaration","name":"QOU.SchurWeyl.QuantumGL.Km_mulVec_of_Kp","kind":"theorem","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/QuantumGLDominance.lean#L49-L55","signatureChunk":0}]}