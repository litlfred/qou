{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:KnotsParticlesConfinement.NucleonHeckeElement","@type":"LeanModule","name":"KnotsParticlesConfinement.NucleonHeckeElement","imports":["lean:module:Init"],"declarations":7,"chunks":1},{"@id":"lean:proton_ne_neutron","@type":"LeanDeclaration","name":"proton_ne_neutron","kind":"theorem","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/nucleon-hecke-element.lean#L30-L33","doc":"The proton and neutron have different flavor assignments. ","signatureChunk":0},{"@id":"lean:neutronFlavors","@type":"LeanDeclaration","name":"neutronFlavors","kind":"def","line":24,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/nucleon-hecke-element.lean#L24-L28","doc":"Neutron flavor assignment: (up, down, down). ","signatureChunk":0},{"@id":"lean:protonFlavors","@type":"LeanDeclaration","name":"protonFlavors","kind":"def","line":18,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/nucleon-hecke-element.lean#L18-L22","doc":"Proton flavor assignment: (up, up, down). ","signatureChunk":0},{"@id":"lean:NucleonHeckeElement.nfCoeffs","@type":"LeanDeclaration","name":"NucleonHeckeElement.nfCoeffs","kind":"def","line":16,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/nucleon-hecke-element.lean#L16-L16","doc":"NF coefficients after reduction (6 basis elements). ","signatureChunk":0},{"@id":"lean:NucleonHeckeElement.flavors","@type":"LeanDeclaration","name":"NucleonHeckeElement.flavors","kind":"def","line":14,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/nucleon-hecke-element.lean#L14-L14","doc":"Flavor assignment: proton = (u,u,d), neutron = (u,d,d). ","signatureChunk":0},{"@id":"lean:NucleonHeckeElement.mk","@type":"LeanDeclaration","name":"NucleonHeckeElement.mk","kind":"ctor","line":12,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/nucleon-hecke-element.lean#L12-L12","signatureChunk":0},{"@id":"lean:NucleonHeckeElement","@type":"LeanDeclaration","name":"NucleonHeckeElement","kind":"structure","line":7,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/nucleon-hecke-element.lean#L7-L16","doc":"The nucleon Hecke element for a flavor triple (f₁, f₂, f₃):\n𝔑(f₁,f₂,f₃) = 𝓑₃ · C(f₁,f₂;σ₀) · C(f₁,f₃;σ₀) · C(f₂,f₃;σ₁)\n\nAfter Groebner-Shirshov reduction, each nucleon has exactly 6 terms\n(one per S₃ basis element). ","signatureChunk":0}]}