eChunk":0},{"@id":"lean:QOU.MathlibExt.RankMinor.exists_selector_det_ne_zero","@type":"LeanDeclaration","name":"QOU.MathlibExt.RankMinor.exists_selector_det_ne_zero","kind":"theorem","line":97,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/RankMinor.lean#L97-L118","doc":"**Full row rank ⇒ a nonzero maximal minor.** Some strictly monotone\nselection of `r` columns has invertible square submatrix.\n\nThis is the hypothesis `CauchyBinet.det_gram_map_ne_zero` asks for. ","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.RankMinor.exists_finset_col_basis","@type":"LeanDeclaration","name":"QOU.MathlibExt.RankMinor.exists_finset_col_basis","kind":"theorem","line":70,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/RankMinor.lean#L70-L93","doc":"**An `r`-element set of columns forming a basis.** ","signatureChunk":0},{"@id":"lean:QOU.MathlibExt.RankMinor.span_col_eq_top","@type":"LeanDeclaration","name":"QOU.MathlibExt.RankMinor.span_col_eq_top","kind":"theorem","line":55,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/RankMinor.lean#L55-L62","doc":"**The columns of a full-row-rank matrix span `K^r`.** Row rank is column\nrank, so the column span has dimension `r` inside an `r`-dimensional space. ","signatureChunk":0}]}