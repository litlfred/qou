{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.QuarkState.BalancedIndexCharacter","@type":"LeanModule","name":"QOU.QuarkState.BalancedIndexCharacter","imports":["lean:module:Init","lean:module:QOU.IwahoriHecke.BalancedGenerators","lean:module:Mathlib.Algebra.Order.BigOperators.GroupWithZero.List"],"declarations":12,"chunks":1},{"@id":"lean:QOU.QuarkState.BalancedIndex.sign_cannot_separate","@type":"LeanDeclaration","name":"QOU.QuarkState.BalancedIndex.sign_cannot_separate","kind":"theorem","line":144,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuarkState/BalancedIndexCharacter.lean#L144-L157","doc":"**The sign character cannot replace the index character.** The two-letter word\n`σ_i σ_i` and `−σ_j⁻¹` both have positive sign value. ","signatureChunk":0},{"@id":"lean:QOU.QuarkState.BalancedIndex.wordImage_ne_neg_negCrossing","@type":"LeanDeclaration","name":"QOU.QuarkState.BalancedIndex.wordImage_ne_neg_negCrossing","kind":"theorem","line":124,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuarkState/BalancedIndexCharacter.lean#L124-L142","doc":"**`−σ_j⁻¹` is the image of no braid word** (positive parameter). The index\ncharacter sends every braid word to a positive number and `−σ_j⁻¹` to `−qi < 0`. ","signatureChunk":0},{"@id":"lean:QOU.QuarkState.BalancedIndex.sign_wordImage","@type":"LeanDeclaration","name":"QOU.QuarkState.BalancedIndex.sign_wordImage","kind":"theorem","line":102,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuarkState/BalancedIndexCharacter.lean#L102-L115","doc":"Under the sign character a braid word maps to a product of `−qi` and `−q`. ","signatureChunk":0},{"@id":"lean:QOU.QuarkState.BalancedIndex.index_wordImage","@type":"LeanDeclaration","name":"QOU.QuarkState.BalancedIndex.index_wordImage","kind":"theorem","line":86,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuarkState/BalancedIndexCharacter.lean#L86-L100","doc":"**A braid word maps to `q^{#pos} qi^{#neg}`** under the index character. ","signatureChunk":0},{"@id":"lean:QOU.QuarkState.BalancedIndex.wordImage","@type":"LeanDeclaration","name":"QOU.QuarkState.BalancedIndex.wordImage","kind":"def","line":83,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuarkState/BalancedIndexCharacter.lean#L83-L84","signatureChunk":0},{"@id":"lean:QOU.QuarkState.BalancedIndex.letter","@type":"LeanDeclaration","name":"QOU.QuarkState.BalancedIndex.letter","kind":"def","line":78,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuarkState/BalancedIndexCharacter.lean#L78-L81","doc":"The image of a braid word: a list of (generator, sign) pairs, `true` = positive\ncrossing `σ_i`, `false` = negative crossing `σ_i⁻¹`. ","signatureChunk":0},{"@id":"lean:QOU.QuarkState.BalancedIndex.sign_negCrossing","@type":"LeanDeclaration","name":"QOU.QuarkState.BalancedIndex.sign_negCrossing","kind":"theorem","line":72,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuarkState/BalancedIndexCharacter.lean#L72-L76","signatureChunk":0},{"@id":"lean:QOU.QuarkState.BalancedIndex.index_negCrossing","@type":"LeanDeclaration","name":"QOU.QuarkState.BalancedIndex.index_negCrossing","kind":"theorem","line":65,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuarkState/BalancedIndexCharacter.lean#L65-L70","signatureChunk":0},{"@id":"lean:QOU.QuarkState.BalancedIndex.sign_sigma","@type":"LeanDeclaration","name":"QOU.QuarkState.BalancedIndex.sign_sigma","kind":"theorem","line":59,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuarkState/BalancedIndexCharacter.lean#L59-L63","signatureChunk":0},{"@id":"lean:QOU.QuarkState.BalancedIndex.index_sigma","@type":"LeanDeclaration","name":"QOU.QuarkState.BalancedIndex.index_sigma","kind":"theorem","line":53,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuarkState/BalancedIndexCharacter.lean#L53-L57","signatureChunk":0},{"@id":"lean:QOU.QuarkState.BalancedIndex.signChar","@type":"LeanDeclaration","name":"QOU.QuarkState.BalancedIndex.signChar","kind":"def","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuarkState/BalancedIndexCharacter.lean#L49-L51","doc":"**The balanced sign character** `σ_i ↦ −qi`. ","signatureChunk":0},{"@id":"lean:QOU.QuarkState.BalancedIndex.indexChar","@type":"LeanDeclaration","name":"QOU.QuarkState.BalancedIndex.indexChar","kind":"def","line":45,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuarkState/BalancedIndexCharacter.lean#L45-L47","doc":"**The balanced index character** `σ_i ↦ q`. ","signatureChunk":0}]}