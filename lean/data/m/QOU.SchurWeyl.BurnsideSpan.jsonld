{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.SchurWeyl.BurnsideSpan","@type":"LeanModule","name":"QOU.SchurWeyl.BurnsideSpan","imports":["lean:module:Init","lean:module:QOU.SchurWeyl.Irreducibility"],"declarations":1,"chunks":1},{"@id":"lean:QOU.SchurWeyl.seminormal21_no_linear_relation","@type":"LeanDeclaration","name":"QOU.SchurWeyl.seminormal21_no_linear_relation","kind":"theorem","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/BurnsideSpan.lean#L42-L86","doc":"**No nontrivial linear relation among `1, S0, S1, S0·S1`** (`q ≠ 0`): the\ngenerator images of the `(2,1)` seminormal representation are linearly\nindependent, hence span `M₂(ℝ)` (Burnside surjectivity). ","signatureChunk":0}]}