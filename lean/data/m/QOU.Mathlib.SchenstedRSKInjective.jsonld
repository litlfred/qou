{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Mathlib.SchenstedRSKInjective","@type":"LeanModule","name":"QOU.Mathlib.SchenstedRSKInjective","imports":["lean:module:Init","lean:module:QOU.Mathlib.SchenstedReadbackFold"],"declarations":4,"chunks":1},{"@id":"lean:QOU.Mathlib.Schensted.insertWordRec_ne_of_ne","@type":"LeanDeclaration","name":"QOU.Mathlib.Schensted.insertWordRec_ne_of_ne","kind":"theorem","line":71,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SchenstedRSKInjective.lean#L71-L74","doc":"Contrapositive form: distinct words of the same length have distinct `(P, Q)` pairs. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.Schensted.word_eq_of_insertWordRec_eq","@type":"LeanDeclaration","name":"QOU.Mathlib.Schensted.word_eq_of_insertWordRec_eq","kind":"theorem","line":62,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SchenstedRSKInjective.lean#L62-L69","doc":"**The RSK map is injective on words of a fixed length.** The pair `(P(w), Q(w))` determines\n`w`. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.Schensted.rowIndices_eq_of_recording_eq","@type":"LeanDeclaration","name":"QOU.Mathlib.Schensted.rowIndices_eq_of_recording_eq","kind":"theorem","line":44,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SchenstedRSKInjective.lean#L44-L60","doc":"**Equal recording tableaux force equal row-index records** (at equal word length). This is\nbrick 4 followed by brick 6: `Q` *is* the fold, and the fold is readable. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.Schensted.rowIndices_length","@type":"LeanDeclaration","name":"QOU.Mathlib.Schensted.rowIndices_length","kind":"theorem","line":37,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SchenstedRSKInjective.lean#L37-L42","doc":"One row index per letter. ","signatureChunk":0}]}