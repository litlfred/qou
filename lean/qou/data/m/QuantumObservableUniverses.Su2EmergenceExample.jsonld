{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QuantumObservableUniverses.Su2EmergenceExample","@type":"LeanModule","name":"QuantumObservableUniverses.Su2EmergenceExample","imports":["lean:module:Init","lean:module:Mathlib.Data.Real.Basic"],"declarations":9,"chunks":1},{"@id":"lean:QOU.Examples.su2Emergence","@type":"LeanDeclaration","name":"QOU.Examples.su2Emergence","kind":"def","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/su2-emergence-example.lean#L49-L60","doc":"The SU(2) emergence chain is valid. ","formalizes":[{"@id":"block:ex:su2-emergence","label":"ex:su2-emergence","md":"quantum-observable-universe/quantum-observable-universes/su2-emergence-example.md"}],"signatureChunk":0},{"@id":"lean:QOU.Examples.SU2EmergenceChain.gauge_group_is_su2","@type":"LeanDeclaration","name":"QOU.Examples.SU2EmergenceChain.gauge_group_is_su2","kind":"theorem","line":47,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/su2-emergence-example.lean#L47-L47","doc":"Step 3: The resulting group is SU(2).\nWitnessed by: groupDim = compactFormDim (both 3). ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2EmergenceChain.groupDim","@type":"LeanDeclaration","name":"QOU.Examples.SU2EmergenceChain.groupDim","kind":"def","line":44,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/su2-emergence-example.lean#L44-L44","doc":"Dimension of the resulting gauge group. ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2EmergenceChain.dagger_forces_unitary","@type":"LeanDeclaration","name":"QOU.Examples.SU2EmergenceChain.dagger_forces_unitary","kind":"theorem","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/su2-emergence-example.lean#L42-L42","doc":"Step 2: Dagger forces unitarity (g† = g⁻¹).\nSL(2,ℂ) → SU(2).\nWitnessed by: the compact form has dimension 3. ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2EmergenceChain.compactFormDim","@type":"LeanDeclaration","name":"QOU.Examples.SU2EmergenceChain.compactFormDim","kind":"def","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/su2-emergence-example.lean#L38-L38","doc":"Dimension of the compact real form (SU(2) has dim 3). ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2EmergenceChain.volume_forces_det_one","@type":"LeanDeclaration","name":"QOU.Examples.SU2EmergenceChain.volume_forces_det_one","kind":"theorem","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/su2-emergence-example.lean#L36-L36","doc":"Step 1: Volume constraint forces det = 1.\nGL(2,ℂ) → SL(2,ℂ).\nWitnessed by: Λ²ℂ² ≅ ℂ (one-dimensional), so the volume form\nis unique up to scale, forcing det = 1. ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2EmergenceChain.exteriorPowerDim","@type":"LeanDeclaration","name":"QOU.Examples.SU2EmergenceChain.exteriorPowerDim","kind":"def","line":31,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/su2-emergence-example.lean#L31-L31","doc":"Dimension of Λ²ℂ². ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2EmergenceChain.mk","@type":"LeanDeclaration","name":"QOU.Examples.SU2EmergenceChain.mk","kind":"ctor","line":29,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/su2-emergence-example.lean#L29-L29","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2EmergenceChain","@type":"LeanDeclaration","name":"QOU.Examples.SU2EmergenceChain","kind":"structure","line":24,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/su2-emergence-example.lean#L24-L47","doc":"**SU(2) emergence chain**: the three-step restriction from GL(2)\nto SU(2) via the QOU axioms.\n\nLaTeX: `\\label{ex:su2-emergence}` ","signatureChunk":0}]}