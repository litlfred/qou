{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.BraidKnot.DressedParticle","@type":"LeanModule","name":"QOU.BraidKnot.DressedParticle","imports":["lean:module:Init","lean:module:QOU.BraidKnot.ConfinedParticle","lean:module:QOU.BraidKnot.ElectronShell","lean:module:QOU.BraidKnot.ConfinementCategory"],"declarations":9,"chunks":1},{"@id":"lean:QOU.BraidKnot.dressing_composes","@type":"LeanDeclaration","name":"QOU.BraidKnot.dressing_composes","kind":"theorem","line":48,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/DressedParticle.lean#L48-L57","doc":"**Dressing composition** — proved from the structure fields.\nEach `DressedParticle` carries `level_preserved`; chaining via\n`D₁.composite = D₂.bare` then gives the equality by `rfl`/`rw`.\nThe earlier `DressingComposes` typeclass has been removed. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.dressMorphism","@type":"LeanDeclaration","name":"QOU.BraidKnot.dressMorphism","kind":"def","line":41,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/DressedParticle.lean#L41-L46","doc":"The dressing morphism `dress_S : P_bare → P_dressed` in\nthe confinement category. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.DressedParticle.level_preserved","@type":"LeanDeclaration","name":"QOU.BraidKnot.DressedParticle.level_preserved","kind":"theorem","line":39,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/DressedParticle.lean#L39-L39","doc":"Level preservation: dressing does not change the level. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.DressedParticle.shell_on_bare","@type":"LeanDeclaration","name":"QOU.BraidKnot.DressedParticle.shell_on_bare","kind":"theorem","line":37,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/DressedParticle.lean#L37-L37","doc":"Consistency: the shell's nucleus is the bare particle. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.DressedParticle.composite","@type":"LeanDeclaration","name":"QOU.BraidKnot.DressedParticle.composite","kind":"def","line":35,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/DressedParticle.lean#L35-L35","doc":"The composite confined particle obtained after dressing. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.DressedParticle.shell","@type":"LeanDeclaration","name":"QOU.BraidKnot.DressedParticle.shell","kind":"def","line":33,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/DressedParticle.lean#L33-L33","doc":"Electron shell attached to `bare`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.DressedParticle.bare","@type":"LeanDeclaration","name":"QOU.BraidKnot.DressedParticle.bare","kind":"def","line":31,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/DressedParticle.lean#L31-L31","doc":"Bare nuclear confined particle. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.DressedParticle.mk","@type":"LeanDeclaration","name":"QOU.BraidKnot.DressedParticle.mk","kind":"ctor","line":29,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/DressedParticle.lean#L29-L29","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.DressedParticle","@type":"LeanDeclaration","name":"QOU.BraidKnot.DressedParticle","kind":"structure","line":24,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/DressedParticle.lean#L24-L39","doc":"**Dressed particle.** Codomain of a dressing morphism; carries\na bare-particle core, an electron shell, and the composite\nconfined particle whose Markov class is that of\n`ι(K_bare) · W_bind` in `H_{A+Z}(q)`. ","formalizes":[{"@id":"block:def:dressed-particle","label":"def:dressed-particle","md":"quantum-observable-universe/knots-particles-confinement/dressed-particle.md"}],"signatureChunk":0}]}