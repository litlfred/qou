{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:MolecularConstruction.H2MolecularBraid","@type":"LeanModule","name":"MolecularConstruction.H2MolecularBraid","imports":["lean:module:Init","lean:module:Mathlib.Tactic.NormNum.Basic"],"declarations":7,"chunks":1},{"@id":"lean:QOU.Molecular.h2_strands","@type":"LeanDeclaration","name":"QOU.Molecular.h2_strands","kind":"theorem","line":26,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/h2-molecular-braid.lean#L26-L27","doc":"H₂ has 4 strands. ","signatureChunk":0},{"@id":"lean:QOU.Molecular.H2Braid.sharedElectrons","@type":"LeanDeclaration","name":"QOU.Molecular.H2Braid.sharedElectrons","kind":"def","line":24,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/h2-molecular-braid.lean#L24-L24","doc":"Shared electrons = 2 (one pair). ","signatureChunk":0},{"@id":"lean:QOU.Molecular.H2Braid.bondOrder","@type":"LeanDeclaration","name":"QOU.Molecular.H2Braid.bondOrder","kind":"def","line":22,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/h2-molecular-braid.lean#L22-L22","doc":"Bond order = 1 (single bond). ","signatureChunk":0},{"@id":"lean:QOU.Molecular.H2Braid.numBonds","@type":"LeanDeclaration","name":"QOU.Molecular.H2Braid.numBonds","kind":"def","line":20,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/h2-molecular-braid.lean#L20-L20","doc":"Number of covalent bonds = 1 (single bond). ","signatureChunk":0},{"@id":"lean:QOU.Molecular.H2Braid.totalStrands","@type":"LeanDeclaration","name":"QOU.Molecular.H2Braid.totalStrands","kind":"def","line":18,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/h2-molecular-braid.lean#L18-L18","doc":"Number of strands = 4 (2 nucleons + 2 electrons). ","signatureChunk":0},{"@id":"lean:QOU.Molecular.H2Braid.mk","@type":"LeanDeclaration","name":"QOU.Molecular.H2Braid.mk","kind":"ctor","line":16,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/h2-molecular-braid.lean#L16-L16","signatureChunk":0},{"@id":"lean:QOU.Molecular.H2Braid","@type":"LeanDeclaration","name":"QOU.Molecular.H2Braid","kind":"structure","line":8,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/h2-molecular-braid.lean#L8-L24","doc":"**Hydrogen molecule H₂** as a molecular braid in H₄(q).\n\nH₂ consists of two hydrogen atoms sharing one electron pair.\nAssembly: (1) build two H atoms, (2) embed in H₄(q) with\ninter-atomic crossings, (3) compute the transfer matrix chain.\n\nThe covalent channel (electron-proton crossing) reduces Φ₁\ncompared to isolated atoms. ","formalizes":[{"@id":"block:def:h2-molecular-braid","label":"def:h2-molecular-braid","md":"quantum-observable-universe/molecular-construction/h2-molecular-braid.md"}],"signatureChunk":0}]}