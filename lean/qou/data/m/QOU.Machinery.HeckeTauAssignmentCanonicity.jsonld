{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Machinery.HeckeTauAssignmentCanonicity","@type":"LeanModule","name":"QOU.Machinery.HeckeTauAssignmentCanonicity","imports":["lean:module:Init","lean:module:QOU.Machinery.CoxeterA3Instantiation","lean:module:QOU.Machinery.HeckeTauAssignmentGeneralRank","lean:module:QOU.Machinery.CoxeterGeometricRepresentationFull"],"declarations":4,"chunks":1},{"@id":"lean:QOU.Machinery.CoxeterParabolic.tauAssignment_pair_dependent","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.tauAssignment_pair_dependent","kind":"theorem","line":115,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/HeckeTauAssignmentCanonicity.lean#L115-L139","doc":"**The τ-assignment depends on the marked pair**: at the A₃ rung the\n`(0,1)`- and `(1,2)`-assignments are different functions. The witness\nstate is read into the isotypic slot by the first (coefficient `I`)\nand killed by the second. Scope-limited negative: refutes *strict*\nindependence of this construction; coherent canonicity along diagram\nautomorphisms remains open. ","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.vPairWitness","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.vPairWitness","kind":"def","line":78,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/HeckeTauAssignmentCanonicity.lean#L78-L80","doc":"The indicator of the longest `(0,1)`-cell element `σ₀σ₁σ₀`. ","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.simple_ne_A3_12","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.simple_ne_A3_12","kind":"theorem","line":72,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/HeckeTauAssignmentCanonicity.lean#L72-L74","doc":"`σ₁ ≠ σ₂` in the A₃ group. ","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.simple_ne_A3_01","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.simple_ne_A3_01","kind":"theorem","line":67,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/HeckeTauAssignmentCanonicity.lean#L67-L70","doc":"`σ₀ ≠ σ₁` in the A₃ group — via the Chebyshev-leg `simple_ne_full`,\nno permutation computation needed. ","signatureChunk":0}]}