{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:KnotsParticlesConfinement.AtomicBraid","@type":"LeanModule","name":"KnotsParticlesConfinement.AtomicBraid","imports":["lean:module:Init"],"declarations":17,"chunks":1},{"@id":"lean:atomic_braid_crossing_count","@type":"LeanDeclaration","name":"atomic_braid_crossing_count","kind":"theorem","line":31,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/atomic-braid.lean#L31-L40","doc":"Strand count of a default-constructed neutral atom `(Z, N)`:\nwith the field defaults `A = Z + N` and `totalStrands = A + Z`,\nthe total strand count is `Z + N + Z = A + Z`.\n\nStated for `⟨Z, N⟩` (defaults applied) because for an arbitrary\n`NeutralAtom` the `A` and `totalStrands` fields are independent\nand may be set to non-default values. ","signatureChunk":0},{"@id":"lean:NeutralAtom.totalStrands","@type":"LeanDeclaration","name":"NeutralAtom.totalStrands","kind":"def","line":29,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/atomic-braid.lean#L29-L29","doc":"Total strand count = A + Z (nucleons + electrons). ","signatureChunk":0},{"@id":"lean:NeutralAtom.A","@type":"LeanDeclaration","name":"NeutralAtom.A","kind":"def","line":27,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/atomic-braid.lean#L27-L27","doc":"Mass number A = Z + N. ","signatureChunk":0},{"@id":"lean:NeutralAtom.N","@type":"LeanDeclaration","name":"NeutralAtom.N","kind":"def","line":25,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/atomic-braid.lean#L25-L25","doc":"Neutron number. ","signatureChunk":0},{"@id":"lean:NeutralAtom.Z","@type":"LeanDeclaration","name":"NeutralAtom.Z","kind":"def","line":23,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/atomic-braid.lean#L23-L23","doc":"Atomic number (proton count). ","signatureChunk":0},{"@id":"lean:NeutralAtom.mk","@type":"LeanDeclaration","name":"NeutralAtom.mk","kind":"ctor","line":21,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/atomic-braid.lean#L21-L21","signatureChunk":0},{"@id":"lean:NeutralAtom","@type":"LeanDeclaration","name":"NeutralAtom","kind":"structure","line":14,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/atomic-braid.lean#L14-L29","doc":"The **atomic braid** of a neutral atom (Z, N) as an element\nof H_{A+Z}(q), where A = Z + N.\n\n- A strands for nucleons\n- Z strands for electrons\n- Ground-state ordering via nuclear permutation minimizing Φ₁\n- Greedy electron insertion producing ep pairs ","signatureChunk":0},{"@id":"lean:instReprPairType","@type":"LeanDeclaration","name":"instReprPairType","kind":"instance","line":12,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/atomic-braid.lean#L12-L12","signatureChunk":0},{"@id":"lean:instReprPairType.repr","@type":"LeanDeclaration","name":"instReprPairType.repr","kind":"def","line":12,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/atomic-braid.lean#L12-L12","signatureChunk":0},{"@id":"lean:instDecidableEqPairType","@type":"LeanDeclaration","name":"instDecidableEqPairType","kind":"instance","line":12,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/atomic-braid.lean#L12-L12","signatureChunk":0},{"@id":"lean:PairType.ee","@type":"LeanDeclaration","name":"PairType.ee","kind":"ctor","line":11,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/atomic-braid.lean#L11-L11","signatureChunk":0},{"@id":"lean:PairType.ne","@type":"LeanDeclaration","name":"PairType.ne","kind":"ctor","line":10,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/atomic-braid.lean#L10-L10","signatureChunk":0},{"@id":"lean:PairType.pe","@type":"LeanDeclaration","name":"PairType.pe","kind":"ctor","line":9,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/atomic-braid.lean#L9-L9","signatureChunk":0},{"@id":"lean:PairType.pn","@type":"LeanDeclaration","name":"PairType.pn","kind":"ctor","line":8,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/atomic-braid.lean#L8-L8","signatureChunk":0},{"@id":"lean:PairType.nn","@type":"LeanDeclaration","name":"PairType.nn","kind":"ctor","line":7,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/atomic-braid.lean#L7-L7","signatureChunk":0},{"@id":"lean:PairType.pp","@type":"LeanDeclaration","name":"PairType.pp","kind":"ctor","line":6,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/atomic-braid.lean#L6-L6","signatureChunk":0},{"@id":"lean:PairType","@type":"LeanDeclaration","name":"PairType","kind":"inductive","line":4,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/atomic-braid.lean#L4-L12","doc":"Particle pair type for crossing coefficients. ","signatureChunk":0}]}