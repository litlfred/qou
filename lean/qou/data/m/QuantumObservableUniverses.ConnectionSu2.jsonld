{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QuantumObservableUniverses.ConnectionSu2","@type":"LeanModule","name":"QuantumObservableUniverses.ConnectionSu2","imports":["lean:module:Init","lean:module:Mathlib.Data.Nat.Basic"],"declarations":10,"chunks":1},{"@id":"lean:QOU.Examples.su2_gauge_components","@type":"LeanDeclaration","name":"QOU.Examples.su2_gauge_components","kind":"theorem","line":56,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/connection-su2.lean#L56-L57","doc":"A gauge potential on SU(2) has 3 components. ","signatureChunk":0},{"@id":"lean:QOU.Examples.su2Connection","@type":"LeanDeclaration","name":"QOU.Examples.su2Connection","kind":"def","line":46,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/connection-su2.lean#L46-L54","doc":"The connection data for SU(2). ","formalizes":[{"@id":"block:ex:connection-su2","label":"ex:connection-su2","md":"quantum-observable-universe/quantum-observable-universes/connection-su2.md"}],"signatureChunk":0},{"@id":"lean:QOU.Examples.SU2ConnectionData.curvature_linear","@type":"LeanDeclaration","name":"QOU.Examples.SU2ConnectionData.curvature_linear","kind":"theorem","line":44,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/connection-su2.lean#L44-L44","doc":"Curvature is A-linear: rank of Ω² is bounded by C(n,2) for\nn = numComponents. For n = 3: rank ≤ 3(3−1)/2 = 3. ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2ConnectionData.leibniz","@type":"LeanDeclaration","name":"QOU.Examples.SU2ConnectionData.leibniz","kind":"theorem","line":41,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/connection-su2.lean#L41-L41","doc":"The Leibniz rule holds: the connection has as many components as\nthe calculus dimension, so ∇ acts component-wise. ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2ConnectionData.curv_rank","@type":"LeanDeclaration","name":"QOU.Examples.SU2ConnectionData.curv_rank","kind":"theorem","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/connection-su2.lean#L38-L38","doc":"Curvature F_∇ ∈ Ω²(A) of rank 3. ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2ConnectionData.curvatureRank","@type":"LeanDeclaration","name":"QOU.Examples.SU2ConnectionData.curvatureRank","kind":"def","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/connection-su2.lean#L36-L36","doc":"Rank of Ω²(A) where curvature lives. ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2ConnectionData.num_comp","@type":"LeanDeclaration","name":"QOU.Examples.SU2ConnectionData.num_comp","kind":"theorem","line":34,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/connection-su2.lean#L34-L34","doc":"A has 3 components: A₁, A₂, A₃. ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2ConnectionData.numComponents","@type":"LeanDeclaration","name":"QOU.Examples.SU2ConnectionData.numComponents","kind":"def","line":32,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/connection-su2.lean#L32-L32","doc":"Number of components of the gauge potential (= dim su(2)). ","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2ConnectionData.mk","@type":"LeanDeclaration","name":"QOU.Examples.SU2ConnectionData.mk","kind":"ctor","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/connection-su2.lean#L30-L30","signatureChunk":0},{"@id":"lean:QOU.Examples.SU2ConnectionData","@type":"LeanDeclaration","name":"QOU.Examples.SU2ConnectionData","kind":"structure","line":25,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/connection-su2.lean#L25-L44","doc":"**SU(2) connection data**: a connection on the coordinate ring\nO(SU(2)) with its left-invariant 3D calculus.\n\nLaTeX: `\\label{ex:connection-su2}` ","signatureChunk":0}]}