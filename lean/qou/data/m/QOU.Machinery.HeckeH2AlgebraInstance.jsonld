ed/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/HeckeH2AlgebraInstance.lean#L51-L51","signatureChunk":0},{"@id":"lean:QOU.Machinery.H3.H2A.instZero","@type":"LeanDeclaration","name":"QOU.Machinery.H3.H2A.instZero","kind":"instance","line":50,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/HeckeH2AlgebraInstance.lean#L50-L50","signatureChunk":0},{"@id":"lean:QOU.Machinery.H3.H2A.b","@type":"LeanDeclaration","name":"QOU.Machinery.H3.H2A.b","kind":"def","line":44,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/HeckeH2AlgebraInstance.lean#L44-L44","doc":"Coefficient of the generator σ₀. ","signatureChunk":0},{"@id":"lean:QOU.Machinery.H3.H2A.a","@type":"LeanDeclaration","name":"QOU.Machinery.H3.H2A.a","kind":"def","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/HeckeH2AlgebraInstance.lean#L42-L42","doc":"Coefficient of the identity γ. ","signatureChunk":0},{"@id":"lean:QOU.Machinery.H3.H2A.mk","@type":"LeanDeclaration","name":"QOU.Machinery.H3.H2A.mk","kind":"ctor","line":40,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/HeckeH2AlgebraInstance.lean#L40-L40","signatureChunk":0},{"@id":"lean:QOU.Machinery.H3.H2A.ext_iff","@type":"LeanDeclaration","name":"QOU.Machinery.H3.H2A.ext_iff","kind":"theorem","line":39,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/HeckeH2AlgebraInstance.lean#L39-L39","signatureChunk":0},{"@id":"lean:QOU.Machinery.H3.H2A.ext","@type":"LeanDeclaration","name":"QOU.Machinery.H3.H2A.ext","kind":"theorem","