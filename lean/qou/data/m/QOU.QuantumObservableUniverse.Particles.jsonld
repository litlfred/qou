d/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/Particles.lean#L20-L20","doc":"The total form (abstract representative). ","signatureChunk":0},{"@id":"lean:QOU.ReebDecomposition.mk","@type":"LeanDeclaration","name":"QOU.ReebDecomposition.mk","kind":"ctor","line":18,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/Particles.lean#L18-L18","signatureChunk":0},{"@id":"lean:QOU.ReebDecomposition","@type":"LeanDeclaration","name":"QOU.ReebDecomposition","kind":"structure","line":16,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverse/Particles.lean#L16-L26","doc":"**Reeb decomposition** of a differential form on a CR manifold.\nLaTeX: `\\label{def:reeb-decomposition}` ","formalizes":[{"@id":"block:ex:reeb-decomposition","label":"ex:reeb-decomposition","md":"quantum-observable-universe/models-of-qous/reeb-decomposition.md"}],"signatureChunk":0}]}