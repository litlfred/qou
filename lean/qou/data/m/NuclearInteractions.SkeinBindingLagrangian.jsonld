{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:NuclearInteractions.SkeinBindingLagrangian","@type":"LeanModule","name":"NuclearInteractions.SkeinBindingLagrangian","imports":["lean:module:Init","lean:module:Mathlib.Analysis.SpecialFunctions.Pow.Real"],"declarations":16,"chunks":1},{"@id":"lean:QOU.Braiding.SkeinBindingLagrangian.L_vol_nonneg","@type":"LeanDeclaration","name":"QOU.Braiding.SkeinBindingLagrangian.L_vol_nonneg","kind":"theorem","line":70,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/nuclear-interactions/skein-binding-lagrangian.lean#L70-L81","doc":"The volume binding is non-negative when the volume scale is\nnon-negative: the average Skein weight `(q + q⁻¹)/2` is positive in\nthe substrate regime `q > 1`, and `A ≥ 0`. ","signatureChunk":0},{"@id":"lean:QOU.Braiding.SkeinBindingLagrangian.L_Pauli","@type":"LeanDeclaration","name":"QOU.Braiding.SkeinBindingLagrangian.L_Pauli","kind":"def","line":66,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/nuclear-interactions/skein-binding-lagrangian.lean#L66-L68","doc":"Pauli asymmetry: a_A · (n - p)²/(4A). ","signatureChunk":0},{"@id":"lean:QOU.Braiding.SkeinBindingLagrangian.L_Coul","@type":"LeanDeclaration","name":"QOU.Braiding.SkeinBindingLagrangian.L_Coul","kind":"def","line":62,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/nuclear-interactions/skein-binding-lagrangian.lean#L62-L64","doc":"Coulomb repulsion: (q - q⁻¹) · λ_C · p(p-1)/A^{1/3}. ","signatureChunk":0},{"@id":"lean:QOU.Braiding.SkeinBindingLagrangian.L_surf","@type":"LeanDeclaration","name":"QOU.Braiding.SkeinBindingLagrangian.L_surf","kind":"def","line":58,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantu