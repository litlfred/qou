uotGeneric.lean#L346-L351","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.TraceQuotGeneric.traceRadicalIdeal_eq_ker","@type":"LeanDeclaration","name":"QOU.SchurWeyl.TraceQuotGeneric.traceRadicalIdeal_eq_ker","kind":"theorem","line":333,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/TraceQuotGeneric.lean#L333-L342","doc":"**The trace radical of `wtrace` IS the kernel of the two-row projection**, as\ntwo-sided ideals, over any `CharZero` field `K`, for `q ≠ 0` not a root of unity. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.TraceQuotGeneric.twoRow_blocks_vanish_iff","@type":"LeanDeclaration","name":"QOU.SchurWeyl.TraceQuotGeneric.twoRow_blocks_vanish_iff","kind":"theorem","line":319,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/TraceQuotGeneric.lean#L319-L331","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.TraceQuotGeneric.mem_ker_twoRowProduct_iff","@type":"LeanDeclaration","name":"QOU.SchurWeyl.TraceQuotGeneric.mem_ker_twoRowProduct_iff","kind":"theorem","line":304,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/TraceQuotGeneric.lean#L304-L316","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.TraceQuotGeneric.twoRowProduct_surjective","@type":"LeanDeclaration","name":"QOU.SchurWeyl.TraceQuotGeneric.twoRowProduct_surjective","kind":"theorem","line":290,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/TraceQuotGeneric.lean#L290-L301","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.TraceQuotGeneric.twoRowProduct_apply","@type":"LeanDeclaration","name":"QOU.SchurWeyl.TraceQuotGeneric.twoRowProduct_apply","kind":"theorem","line":284,"sourceLink":"https://github.com/litlfred/qou/blob/734