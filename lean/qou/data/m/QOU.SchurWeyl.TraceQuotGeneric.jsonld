yl.TraceQuotGeneric.notMem_rad_of_twoRow_block_ne_zero","kind":"theorem","line":219,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/TraceQuotGeneric.lean#L219-L253","doc":"**⊆** over a generic field: a live two-row block is seen by `wtrace`.  Uses only that\nthe two-row weights are **nonzero** — no positivity. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.TraceQuotGeneric.mem_rad_of_twoRow_blocks_vanish","@type":"LeanDeclaration","name":"QOU.SchurWeyl.TraceQuotGeneric.mem_rad_of_twoRow_blocks_vanish","kind":"theorem","line":199,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/TraceQuotGeneric.lean#L199-L217","doc":"**⊇** over a generic field: needs only `q² + 1 ≠ 0` (for the three-row weights to vanish),\nwhich `NotRootOfUnity q` supplies; no `CharZero`. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.TraceQuotGeneric.exists_trace_mul_ne_zero","@type":"LeanDeclaration","name":"QOU.SchurWeyl.TraceQuotGeneric.exists_trace_mul_ne_zero","kind":"theorem","line":172,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/TraceQuotGeneric.lean#L172-L194","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.TraceQuotGeneric.ocneanuWeight_ne_zero_of_two_rows","@type":"LeanDeclaration","name":"QOU.SchurWeyl.TraceQuotGeneric.ocneanuWeight_ne_zero_of_two_rows","kind":"theorem","line":152,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/TraceQuotGeneric.lean#L152-L168","doc":"**The convention-D Ocneanu weight of an at-most-two-row shape is nonzero**, over any\nfield, from `q ≠ 0` and `NotRootOfUnity q` alone. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.TraceQuotGeneric.row_le_one_of_rowLen_two_eq_zero'","@type":"LeanDeclaration","name":"QOU.SchurWeyl.TraceQuotGeneric.row_le_one_of_rowLen_two_eq_zero'","kind":"theorem","line":145,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/TraceQuotGeneric.lean#L145-L150","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.TraceQuotGeneric.numFactor_conventionD_ne_zero","@type":"LeanDeclaration","name":"QOU.SchurWeyl.TraceQuotGeneric.numFactor_conventionD_ne_zero","kind":"theorem","line":129,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/TraceQuotGeneric.lean#L129-L143","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.TraceQuotGeneric.numFactor_conventionD","@type":"LeanDeclaration","name":"QOU.SchurWeyl.TraceQuotGeneric.numFactor_conventionD","kind":"theorem","line":121,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/TraceQuotGeneric.lean#L121-L127","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.TraceQuotGeneric.hookLength_pos'","@type":"LeanDeclaration","name":"QOU.SchurWeyl.TraceQuotGeneric.hookLength_pos'","kind":"theorem","line":111,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/TraceQuotGeneric.lean#L111-L119","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.TraceQuotGeneric.hq21_of_notRootOfUnity","@type":"LeanDeclaration","name":"QOU.SchurWeyl.TraceQuotGeneric.hq21_of_notRootOfUnity","kind":"theorem","line":97,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/TraceQuotGeneric.lean#L97-L104","doc":"`NotRootOfUnity q` implies `q² + 1 ≠ 0`: otherwise `q⁴ = (q²)² = 1`. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.TraceQuotGeneric.hgen_of_notRootOfUnity","@type":"LeanDeclaration","name":"QOU.SchurWeyl.TraceQuotGeneric.hgen_of_notRootOfUnity","kind":"theorem","line":89,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/TraceQuotGeneric.lean#L89-L95","doc":"`NotRootOfUnity q` implies `q²` is not a root of unity. ","signatureChunk":0}]}