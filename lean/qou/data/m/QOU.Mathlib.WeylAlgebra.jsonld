ylAlgebra.FourierLaplace_D","kind":"theorem","line":104,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/WeylAlgebra.lean#L104-L110","doc":"FL on the D generator: `FL(∂) = x`. ","signatureChunk":0},{"@id":"lean:WeylAlgebra.FourierLaplace_X","@type":"LeanDeclaration","name":"WeylAlgebra.FourierLaplace_X","kind":"theorem","line":95,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/WeylAlgebra.lean#L95-L102","doc":"FL on the X generator: `FL(x) = −∂`. ","signatureChunk":0},{"@id":"lean:WeylAlgebra.FourierLaplace","@type":"LeanDeclaration","name":"WeylAlgebra.FourierLaplace","kind":"def","line":75,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/WeylAlgebra.lean#L75-L93","signatureChunk":0},{"@id":"lean:WeylAlgebra.FourierLaplaceFree_D_X_sub_X_D","@type":"LeanDeclaration","name":"WeylAlgebra.FourierLaplaceFree_D_X_sub_X_D","kind":"theorem","line":52,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/WeylAlgebra.lean#L52-L73","signatureChunk":0},{"@id":"lean:WeylAlgebra.FourierLaplaceFree","@type":"LeanDeclaration","name":"WeylAlgebra.FourierLaplaceFree","kind":"def","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/WeylAlgebra.lean#L49-L50","signatureChunk":0},{"@id":"lean:WeylAlgebra.FourierLaplaceFreeGen","@type":"LeanDeclaration","name":"WeylAlgebra.FourierLaplaceFreeGen","kind":"def","line":45,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/WeylAlgebra.lean#L45-L47","signatureChunk":0},{"@id":"lean:WeylAlg