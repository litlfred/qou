{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.MassTheory.LeadingOrderTraceCoefficient","@type":"LeanModule","name":"QOU.MassTheory.LeadingOrderTraceCoefficient","imports":["lean:module:Init","lean:module:Mathlib.Tactic","lean:module:Mathlib.Algebra.DualNumber","lean:module:QOU.MassTheory.PairwiseChainLeadingOrder"],"declarations":35,"chunks":1},{"@id":"lean:QOU.MassTheory.c1_from_letters","@type":"LeanDeclaration","name":"QOU.MassTheory.c1_from_letters","kind":"theorem","line":269,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MassTheory/LeadingOrderTraceCoefficient.lean#L269-L280","doc":"[★] reproduces all six recorded coefficients from the letter data alone:\n`c₁ = starSum(free) − starSum(atom)`. ","signatureChunk":0},{"@id":"lean:QOU.MassTheory.star_He4Atom","@type":"LeanDeclaration","name":"QOU.MassTheory.star_He4Atom","kind":"theorem","line":265,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MassTheory/LeadingOrderTraceCoefficient.lean#L265-L266","signatureChunk":0},{"@id":"lean:QOU.MassTheory.letters_He4Atom","@type":"LeanDeclaration","name":"QOU.MassTheory.letters_He4Atom","kind":"def","line":263,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MassTheory/LeadingOrderTraceCoefficient.lean#L263-L264","doc":"Letter data `(w, c(σ⁽ˡ⁾))` of the 4He atom word, n = 12: [★] = 1/128. ","signatureChunk":0},{"@id":"lean:QOU.MassTheory.star_He4Free","@type":"LeanDeclaration","name":"QOU.MassTheory.star_He4Free","kind":"theorem","line":260,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MassTheory/LeadingOrderTraceCoefficient.lean#L260-L261","signatureChunk":0},{"@id":"l