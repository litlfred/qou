{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Archimedean.ForceCarrierBringUniqueness","@type":"LeanModule","name":"QOU.Archimedean.ForceCarrierBringUniqueness","imports":["lean:module:Init","lean:module:QOU.Archimedean.TorusKnotGenusFourUnique"],"declarations":3,"chunks":1},{"@id":"lean:QOU.Archimedean.force_carrier_categorical_complexity","@type":"LeanDeclaration","name":"QOU.Archimedean.force_carrier_categorical_complexity","kind":"theorem","line":37,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/ForceCarrierBringUniqueness.lean#L37-L45","doc":"**Corollary (categorical complexity of the force-carrier sector)**.\n\nThe product of categorical `q`-dimensions of the two\nforce-carrier knots is `[9]_q · [10]_q`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.force_carrier_bring_uniqueness","@type":"LeanDeclaration","name":"QOU.Archimedean.force_carrier_bring_uniqueness","kind":"theorem","line":27,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/ForceCarrierBringUniqueness.lean#L27-L35","doc":"**Proposition (Bring-supported force-carrier sector is forced)**.\n\nThe force-carrier sector of any QOU built on Bring's surface\ncontains exactly the two-element set `{T_{2,9}, T_{3,5}}`. ","formalizes":[{"@id":"block:prop:force-carrier-bring-uniqueness","label":"prop:force-carrier-bring-uniqueness","md":"quantum-observable-universe/predicted-spectra/force-carrier-bring-uniqueness.md"}],"signatureChunk":0},{"@id":"lean:QOU.Archimedean.IsBringSaturating","@type":"LeanDeclaration","name":"QOU.Archimedean.IsBringSaturating","kind":"def","line":23,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/ForceCarrierBringUniqueness.lean#L23-L25","doc":"A force-carrier knot must satisfy the Bring saturation\ncondition: its Seifert genus equals `g(Σ_4) = 4`. ","signatureChunk":0}]}