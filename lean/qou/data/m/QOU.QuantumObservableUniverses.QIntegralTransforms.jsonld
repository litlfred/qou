{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.QuantumObservableUniverses.QIntegralTransforms","@type":"LeanModule","name":"QOU.QuantumObservableUniverses.QIntegralTransforms","imports":["lean:module:Init","lean:module:QOU.Archimedean.GroundRing"],"declarations":9,"chunks":1},{"@id":"lean:QOU.CategoricalLaplace.monoidal_unit","@type":"LeanDeclaration","name":"QOU.CategoricalLaplace.monoidal_unit","kind":"theorem","line":54,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverses/QIntegralTransforms.lean#L54-L54","doc":"Unit preservation: `L[𝟙] = 𝟙`, with the monoidal unit of `A → A`\nunder composition pinned to `id`.  Quantifying `one` over *all*\nfunctions (the previous form) together with `monoidal_mul` makes\nthe structure uninhabitable for `|A| ≥ 2`; the unit is a specific\nobject, so it is `id`. ","signatureChunk":0},{"@id":"lean:QOU.CategoricalLaplace.monoidal_mul","@type":"LeanDeclaration","name":"QOU.CategoricalLaplace.monoidal_mul","kind":"theorem","line":46,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverses/QIntegralTransforms.lean#L46-L46","doc":"Monoidal: `L[f ∗_q g] = L[f] · L[g]`. ","signatureChunk":0},{"@id":"lean:QOU.CategoricalLaplace.transform","@type":"LeanDeclaration","name":"QOU.CategoricalLaplace.transform","kind":"def","line":44,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverses/QIntegralTransforms.lean#L44-L44","doc":"Pairing: `f ↦ (s ↦ ⟨exp_q(-s·), f⟩)`. ","signatureChunk":0},{"@id":"lean:QOU.CategoricalLaplace.mk","@type":"LeanDeclaration","name":"QOU.CategoricalLaplace.mk","kind":"ctor","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverses/QIntegralTransforms.lean#L42-L42","signatureChunk":0},{"@id":"lean:QOU.CategoricalLaplace","@type":"LeanDeclaration","name":"QOU.CategoricalLaplace","kind":"structure","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverses/QIntegralTransforms.lean#L38-L56","doc":"**Categorical Laplace transform data**: a monoidal functor from\nq-convolution to pointwise product (Hopf pairing with the\nreal-exponential grouplike). ","formalizes":[{"@id":"block:def:categorical-laplace","label":"def:categorical-laplace","md":"quantum-observable-universe/quantum-observable-universes/categorical-laplace-transform.md"}],"signatureChunk":0},{"@id":"lean:QOU.CategoricalFourier.monoidal","@type":"LeanDeclaration","name":"QOU.CategoricalFourier.monoidal","kind":"theorem","line":34,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverses/QIntegralTransforms.lean#L34-L34","doc":"Monoidal property: convolution becomes pointwise product\non each irreducible component. ","signatureChunk":0},{"@id":"lean:QOU.CategoricalFourier.project","@type":"LeanDeclaration","name":"QOU.CategoricalFourier.project","kind":"def","line":31,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverses/QIntegralTransforms.lean#L31-L31","doc":"The Fourier-image family: one projection per irreducible. ","signatureChunk":0},{"@id":"lean:QOU.CategoricalFourier.mk","@type":"LeanDeclaration","name":"QOU.CategoricalFourier.mk","kind":"ctor","line":29,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverses/QIntegralTransforms.lean#L29-L29","signatureChunk":0},{"@id":"lean:QOU.CategoricalFourier","@type":"LeanDeclaration","name":"QOU.CategoricalFourier","kind":"structure","line":25,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverses/QIntegralTransforms.lean#L25-L36","doc":"**Categorical Fourier transform data**: a monoidal functor\nintertwining q-convolution with pointwise product, given as the\nfamily of Peter–Weyl projections. ","formalizes":[{"@id":"block:def:categorical-fourier","label":"def:categorical-fourier","md":"quantum-observable-universe/quantum-observable-universes/categorical-fourier-transform.md"}],"signatureChunk":0}]}