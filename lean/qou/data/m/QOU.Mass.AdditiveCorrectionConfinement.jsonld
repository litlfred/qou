{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Mass.AdditiveCorrectionConfinement","@type":"LeanModule","name":"QOU.Mass.AdditiveCorrectionConfinement","imports":["lean:module:Init","lean:module:Mathlib.Algebra.Order.Field.Basic","lean:module:Mathlib.Tactic.Linarith"],"declarations":2,"chunks":1},{"@id":"lean:QOU.Mass.AdditiveCorrectionConfinement.additive_correction_zero_of_exact","@type":"LeanDeclaration","name":"QOU.Mass.AdditiveCorrectionConfinement.additive_correction_zero_of_exact","kind":"theorem","line":39,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/AdditiveCorrectionConfinement.lean#L39-L44","doc":"**Exact-match corollary.** If the prediction matches observation exactly both with\nand without the additional term, the term is zero — an exact absolute-mass match leaves\nno room for a new free-particle energy contribution. ","signatureChunk":0},{"@id":"lean:QOU.Mass.AdditiveCorrectionConfinement.additive_correction_confined","@type":"LeanDeclaration","name":"QOU.Mass.AdditiveCorrectionConfinement.additive_correction_confined","kind":"theorem","line":27,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/AdditiveCorrectionConfinement.lean#L27-L37","doc":"**Confinement bound.** If a predicted mass already matches observation within `ε`,\nthen any modified prediction `m_pred + δ` that also matches within `ε` has `|δ| ≤ 2ε`:\na proposed new energy term cannot exceed twice the existing agreement tolerance at the\nlevel where that agreement holds. ","signatureChunk":0}]}