{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.FrobeniusHopfData.FrobeniusPairingCategorical","@type":"LeanModule","name":"QOU.FrobeniusHopfData.FrobeniusPairingCategorical","imports":["lean:module:Init","lean:module:Mathlib.CategoryTheory.Monoidal.Rigid.Basic"],"declarations":7,"chunks":1},{"@id":"lean:QOU.FrobeniusHopfData.exactPairing_of_nondegenerate","@type":"LeanDeclaration","name":"QOU.FrobeniusHopfData.exactPairing_of_nondegenerate","kind":"theorem","line":66,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FrobeniusHopfData/FrobeniusPairingCategorical.lean#L66-L74","doc":"A non-degenerate Frobenius pairing IS an exact pairing in Mathlib's\nsense, so the rigid-monoidal API applies to it. ","signatureChunk":0},{"@id":"lean:QOU.FrobeniusHopfData.FrobeniusPairingData.Nondegenerate","@type":"LeanDeclaration","name":"QOU.FrobeniusHopfData.FrobeniusPairingData.Nondegenerate","kind":"def","line":55,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FrobeniusHopfData/FrobeniusPairingCategorical.lean#L55-L64","doc":"**Non-degeneracy of the Frobenius pairing.**  There is a coevaluation\n`η̃ : 𝟏 ⟶ A ⊗ A^∨` whose two snake composites with `d.eval` are the\nunitors — the manuscript's condition, written against the pairing `d`\nactually carries. ","signatureChunk":0},{"@id":"lean:QOU.FrobeniusHopfData.FrobeniusPairingData.eval","@type":"LeanDeclaration","name":"QOU.FrobeniusHopfData.FrobeniusPairingData.eval","kind":"def","line":51,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FrobeniusHopfData/FrobeniusPairingCategorical.lean#L51-L51","doc":"The Frobenius pairing as an evaluation morphism. ","signatureChunk":0},{"@id":"lean:QOU.FrobeniusHopfData.FrobeniusPairingData.dual","@type":"LeanDeclaration","name":"QOU.FrobeniusHopfData.FrobeniusPairingData.dual","kind":"def","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FrobeniusHopfData/FrobeniusPairingCategorical.lean#L49-L49","doc":"The candidate dual `A^∨`. ","signatureChunk":0},{"@id":"lean:QOU.FrobeniusHopfData.FrobeniusPairingData.obj","@type":"LeanDeclaration","name":"QOU.FrobeniusHopfData.FrobeniusPairingData.obj","kind":"def","line":47,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FrobeniusHopfData/FrobeniusPairingCategorical.lean#L47-L47","doc":"The algebra object `A`. ","signatureChunk":0},{"@id":"lean:QOU.FrobeniusHopfData.FrobeniusPairingData.mk","@type":"LeanDeclaration","name":"QOU.FrobeniusHopfData.FrobeniusPairingData.mk","kind":"ctor","line":45,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FrobeniusHopfData/FrobeniusPairingCategorical.lean#L45-L45","signatureChunk":0},{"@id":"lean:QOU.FrobeniusHopfData.FrobeniusPairingData","@type":"LeanDeclaration","name":"QOU.FrobeniusHopfData.FrobeniusPairingData","kind":"structure","line":43,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FrobeniusHopfData/FrobeniusPairingCategorical.lean#L43-L51","doc":"Frobenius pairing data in a monoidal category: an object, a candidate\ndual, and the evaluation `A^∨ ⊗ A ⟶ 𝟏` induced by `∫_A ∘ μ`. ","signatureChunk":0}]}