{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:InformationTheory.AeonAdjacency","@type":"LeanModule","name":"InformationTheory.AeonAdjacency","imports":["lean:module:Init","lean:module:Mathlib.Data.Set.Basic"],"declarations":4,"chunks":1},{"@id":"lean:QOU.aeonAdjacent_shared","@type":"LeanDeclaration","name":"QOU.aeonAdjacent_shared","kind":"theorem","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/aeon-adjacency.lean#L38-L42","doc":"Adjacency exhibits a shared boundary object. ","signatureChunk":0},{"@id":"lean:QOU.aeonAdjacent_symm","@type":"LeanDeclaration","name":"QOU.aeonAdjacent_symm","kind":"theorem","line":31,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/aeon-adjacency.lean#L31-L36","doc":"Adjacency is symmetric. ","signatureChunk":0},{"@id":"lean:QOU.aeonAdjacent","@type":"LeanDeclaration","name":"QOU.aeonAdjacent","kind":"def","line":23,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/aeon-adjacency.lean#L23-L29","doc":"**Aeon adjacency**: two aeons are adjacent iff their boundaries\nintersect.  Given the two boundary sets `b₁`, `b₂`, adjacency is\nthe non-emptiness of `b₁ ∩ b₂`. ","formalizes":[{"@id":"block:def:aeon-adjacency","label":"def:aeon-adjacency","md":"quantum-observable-universe/information-theory/aeon-adjacency.md"}],"signatureChunk":0},{"@id":"lean:QOU.AdjBunObject","@type":"LeanDeclaration","name":"QOU.AdjBunObject","kind":"def","line":20,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/aeon-adjacency.lean#L20-L21","doc":"An object of `Bun(ℙ(V))`, abstracted as its index. ","signatureChunk":0}]}