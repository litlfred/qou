thub.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OptionE/CrystalDeltaLambdaScaffold.lean#L124-L146","doc":"**§3b-cond class encoding Option E's substantive content.**\n\nAn instance asserts that Option E has been closed: the\ncrystal-graph derivation of `Δ_λ` exists, canonical rung-\nselection at k ≥ 3 is in place, and Path-D mass prediction\nworks.\n\nUntil a non-trivial instance is supplied, this remains\n`[Instance]`-hypothetical for any downstream proof. ","signatureChunk":0},{"@id":"lean:QOU.OptionE.current_status_one_answered","@type":"LeanDeclaration","name":"QOU.OptionE.current_status_one_answered","kind":"theorem","line":115,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OptionE/CrystalDeltaLambdaScaffold.lean#L115-L122","doc":"**Verification**: currently exactly 1 of the 4 questions is\nanswered (the q → 1 limit compatibility). ","signatureChunk":0},{"@id":"lean:QOU.OptionE.currentStatus","@type":"LeanDeclaration","name":"QOU.OptionE.currentStatus","kind":"def","line":110,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OptionE/CrystalDeltaLambdaScaffold.lean#L110-L113","doc":"**The current Option E status**: 3 of 4 questions open. The\nframework is structurally well-defined but the substantive\nderivation work is research-grade. ","signatureChunk":0},{"@id":"lean:QOU.OptionE.OptionEFramework.ame_validation_complete","@type":"LeanDeclaration","name":"QOU.OptionE.OptionEFramework.ame_validation_complete","kind":"def","line":108,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OptionE/CrystalDeltaLambdaScaffold.lean#L108-L108","doc":"Has the framework been empirically validated against AME light\nisotopes (D, T, ³He)? (Open: closure not yet attempted.) ","signatureChunk":0},{"@id":"lean:QOU.OptionE.OptionEFramework.q_to_one_limit_compatible","@type":"LeanDeclaration","name":"QOU.OptionE.OptionEFramework.q_to_one_limit_compatible","kind":"def","line":105,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OptionE/CrystalDeltaLambdaScaffold.lean#L105-L105","doc":"Is the `q → 1` classical limit compatible (the crystal\nclassical limit recovers the standard `S_n` characters)? ","signatureChunk":0},{"@id":"lean:QOU.OptionE.OptionEFramework.rung_selection_canonical_at_k_ge_3","@type":"LeanDeclaration","name":"QOU.OptionE.OptionEFramework.rung_selection_canonical_at_k_ge_3","kind":"def","line":102,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OptionE/CrystalDeltaLambdaScaffold.lean#L102-L102","doc":"Does Option E supply a canonical (non-fitted) rung-selection\nrule at `k ≥ 3`? (Open: the substantive content.) ","signatureChunk":0},{"@id":"lean:QOU.OptionE.OptionEFramework.delta_lambda_closed_form_derived","@type":"LeanDeclaration","name":"QOU.OptionE.OptionEFramework.delta_lambda_closed_form_derived","kind":"def","line":99,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OptionE/CrystalDeltaLambdaScaffold.lean#L99-L99","doc":"Does Option E provide a closed-form derivation of `Δ_λ` from\ncrystal vertices? (Open: no closed form yet.) ","signatureChunk":0},{"@id":"lean:QOU.OptionE.OptionEFramework.mk","@type":"LeanDeclaration","name":"QOU.OptionE.OptionEFramework.mk","kind":"ctor","line":96,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OptionE/CrystalDeltaLambdaScaffold.lean#L96-L96","signatureChunk":0},{"@id":"lean:QOU.OptionE.OptionEFramework","@type":"LeanDeclaration","