{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QuantumUniverses.CategoricalConnectionExists","@type":"LeanModule","name":"QuantumUniverses.CategoricalConnectionExists","imports":["lean:module:Init","lean:module:QOU.QuantumObservableUniverse.GaugeTheory"],"declarations":1,"chunks":1},{"@id":"lean:QOU.CategoricalConnection.exists","@type":"LeanDeclaration","name":"QOU.CategoricalConnection.exists","kind":"theorem","line":23,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-universes/categorical-connection-exists.lean#L23-L42","doc":"**Existence of categorical connections.**\n\nFor every `FrobeniusHopfData C`, a `CategoricalConnection C fh`\nterm exists — the trivial witness being the de Rham differential\n`∇₀ = d`; non-trivial witnesses add an `Ad(A)`-valued 1-form. ","formalizes":[{"@id":"block:prop:categorical-connection-exists","label":"prop:categorical-connection-exists","md":"quantum-observable-universe/quantum-universes/categorical-connection-exists.md"}],"signatureChunk":0}]}