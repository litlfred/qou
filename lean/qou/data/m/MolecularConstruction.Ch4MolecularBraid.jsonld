{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:MolecularConstruction.Ch4MolecularBraid","@type":"LeanModule","name":"MolecularConstruction.Ch4MolecularBraid","imports":["lean:module:Init"],"declarations":6,"chunks":1},{"@id":"lean:QOU.Molecular.ch4_strands","@type":"LeanDeclaration","name":"QOU.Molecular.ch4_strands","kind":"theorem","line":22,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/ch4-molecular-braid.lean#L22-L23","doc":"CH₄ strand count: carbon(18) + 4 × hydrogen(2). ","signatureChunk":0},{"@id":"lean:QOU.Molecular.CH4Braid.bondOrder","@type":"LeanDeclaration","name":"QOU.Molecular.CH4Braid.bondOrder","kind":"def","line":20,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/ch4-molecular-braid.lean#L20-L20","doc":"All bonds are single (order 1). ","signatureChunk":0},{"@id":"lean:QOU.Molecular.CH4Braid.numBonds","@type":"LeanDeclaration","name":"QOU.Molecular.CH4Braid.numBonds","kind":"def","line":18,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/ch4-molecular-braid.lean#L18-L18","doc":"Number of C-H bonds = 4. ","signatureChunk":0},{"@id":"lean:QOU.Molecular.CH4Braid.totalStrands","@type":"LeanDeclaration","name":"QOU.Molecular.CH4Braid.totalStrands","kind":"def","line":16,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/ch4-molecular-braid.lean#L16-L16","doc":"Total strand count = 26. ","signatureChunk":0},{"@id":"lean:QOU.Molecular.CH4Braid.mk","@type":"LeanDeclaration","name":"QOU.Molecular.CH4Braid.mk","kind":"ctor","line":14,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/ch4-molecular-braid.lean#L14-L14","signatureChunk":0},{"@id":"lean:QOU.Molecular.CH4Braid","@type":"LeanDeclaration","name":"QOU.Molecular.CH4Braid","kind":"structure","line":6,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/ch4-molecular-braid.lean#L6-L20","doc":"**Methane CH₄** as a molecular braid with 26 strands.\n\nOne carbon (6p + 6n + 6e = 18 strands) sharing 4 single C-H\nbonds with 4 hydrogens (2 strands each = 8 strands).\nTotal: 18 + 8 = 26 strands.\n\nThe LP dual selects S₄-symmetric strand ordering that maximizes\ninter-hydrogen separation, producing tetrahedral geometry. ","formalizes":[{"@id":"block:def:ch4-molecular-braid","label":"def:ch4-molecular-braid","md":"quantum-observable-universe/molecular-construction/ch4-molecular-braid.md"}],"signatureChunk":0}]}