lean:QOU.Hecke.q_param","@type":"LeanDeclaration","name":"QOU.Hecke.q_param","kind":"def","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/MarkovTraceProduct.lean#L38-L38","signatureChunk":0},{"@id":"lean:QOU.Hecke.R_q","@type":"LeanDeclaration","name":"QOU.Hecke.R_q","kind":"def","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Hecke/MarkovTraceProduct.lean#L36-L37","doc":"Ground ring `R_q = ℤ[q, q⁻¹]` (Laurent polynomials over ℤ). ","signatureChunk":0}]}