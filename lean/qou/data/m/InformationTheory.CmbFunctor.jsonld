red/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/cmb-functor.lean#L93-L93","doc":"The source aeon. ","signatureChunk":0},{"@id":"lean:QOU.CMBFunctorValue.mk","@type":"LeanDeclaration","name":"QOU.CMBFunctorValue.mk","kind":"ctor","line":91,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/cmb-functor.lean#L91-L91","signatureChunk":0},{"@id":"lean:QOU.CMBFunctorValue","@type":"LeanDeclaration","name":"QOU.CMBFunctorValue","kind":"structure","line":87,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/cmb-functor.lean#L87-L101","doc":"The CMB functor value: the degree ≥ 1 data surviving a\nboundary horizon. Composition of ∂ with the colimit of\n(A_1/A_0 ⊕ A_2/A_0) over the boundary. ","signatureChunk":0},{"@id":"lean:QOU.Aeon.boundary","@type":"LeanDeclaration","name":"QOU.Aeon.boundary","kind":"def","line":85,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/cmb-functor.lean#L85-L85","doc":"Boundary: jet horizons reachable as limits of directed diagrams. ","signatureChunk":0},{"@id":"lean:QOU.Aeon.observable","@type":"LeanDeclaration","name":"QOU.Aeon.observable","kind":"def","line":83,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/cmb-functor.lean#L83-L83","doc":"Each configuration is observable. ","signatureChunk":0},{"@id":"lean:QOU.Aeon.configs","@type":"LeanDeclaration","name":"QOU.Aeon.configs","kind":"def","line":81,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/cmb-functor.lean#L81-L81","doc":"The observable configurations in this 