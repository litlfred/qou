{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Mathlib.SchenstedListOfSYT","@type":"LeanModule","name":"QOU.Mathlib.SchenstedListOfSYT","imports":["lean:module:Init","lean:module:QOU.Mathlib.SchenstedStandardGeneric","lean:module:QOU.Mathlib.SchenstedRSKSurjective"],"declarations":10,"chunks":1},{"@id":"lean:QOU.Mathlib.Schensted.nodup_flatten_toListTableau","@type":"LeanDeclaration","name":"QOU.Mathlib.Schensted.nodup_flatten_toListTableau","kind":"theorem","line":129,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SchenstedListOfSYT.lean#L129-L148","doc":"**The entries are distinct.** Within a row this is strictness; across rows it is injectivity of\nthe filling — two cells carrying the same value are the same cell, hence in the same row. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.Schensted.colStrict_toListTableau","@type":"LeanDeclaration","name":"QOU.Mathlib.Schensted.colStrict_toListTableau","kind":"theorem","line":113,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SchenstedListOfSYT.lean#L113-L127","doc":"**Columns are `StrictBelow`.** Both halves are needed and they come from different places: the\nlength condition is the diagram's `rowLen_anti`, the entry condition the tableau's `col_strict`. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.Schensted.noEmptyRows_toListTableau","@type":"LeanDeclaration","name":"QOU.Mathlib.Schensted.noEmptyRows_toListTableau","kind":"theorem","line":98,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SchenstedListOfSYT.lean#L98-L111","doc":"No row of a Young diagram has length zero, so no row of the list tableau is empty. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.Schensted.rowsSorted_toListTableau","@type":"LeanDeclaration","name":"QOU.Mathlib.Schensted.rowsSorted_toListTableau","kind":"theorem","line":94,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SchenstedListOfSYT.lean#L94-L96","signatureChunk":0},{"@id":"lean:QOU.Mathlib.Schensted.rows_strict_toListTableau","@type":"LeanDeclaration","name":"QOU.Mathlib.Schensted.rows_strict_toListTableau","kind":"theorem","line":83,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SchenstedListOfSYT.lean#L83-L92","doc":"**Rows strictly increase** — the standard-tableau strengthening of the SSYT's weak rows. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.Schensted.tableauShape_toListTableau","@type":"LeanDeclaration","name":"QOU.Mathlib.Schensted.tableauShape_toListTableau","kind":"theorem","line":74,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SchenstedListOfSYT.lean#L74-L81","doc":"**The shape is the diagram's row lengths**, on the nose. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.Schensted.getD_getD_toListTableau","@type":"LeanDeclaration","name":"QOU.Mathlib.Schensted.getD_getD_toListTableau","kind":"theorem","line":66,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SchenstedListOfSYT.lean#L66-L72","doc":"Entry `(i, j)` of the list tableau, in range. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.Schensted.getElem_toListTableau","@type":"LeanDeclaration","name":"QOU.Mathlib.Schensted.getElem_toListTableau","kind":"theorem","line":60,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SchenstedListOfSYT.lean#L60-L64","doc":"Row `i` of the list tableau, in range. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.Schensted.length_toListTableau","@type":"LeanDeclaration","name":"QOU.Mathlib.Schensted.length_toListTableau","kind":"theorem","line":57,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SchenstedListOfSYT.lean#L57-L58","signatureChunk":0},{"@id":"lean:QOU.Mathlib.Schensted.toListTableau","@type":"LeanDeclaration","name":"QOU.Mathlib.Schensted.toListTableau","kind":"def","line":51,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SchenstedListOfSYT.lean#L51-L55","doc":"**A standard Young tableau read off row by row.** Row `i` is the entries at the cells\n`(i, 0), …, (i, rowLen i - 1)`; there are as many rows as `μ.rowLens` has entries. ","signatureChunk":0}]}