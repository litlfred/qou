{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.MassTheory.ConvolutionFlowParity","@type":"LeanModule","name":"QOU.MassTheory.ConvolutionFlowParity","imports":["lean:module:Init","lean:module:Mathlib.Tactic"],"declarations":6,"chunks":1},{"@id":"lean:QOU.MassTheory.ConvolutionFlow.even_power_nonneg","@type":"LeanDeclaration","name":"QOU.MassTheory.ConvolutionFlow.even_power_nonneg","kind":"theorem","line":83,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MassTheory/ConvolutionFlowParity.lean#L83-L88","doc":"**Even powers** are nonnegative when both channel weights are. ","signatureChunk":0},{"@id":"lean:QOU.MassTheory.ConvolutionFlow.odd_power_negative_iff","@type":"LeanDeclaration","name":"QOU.MassTheory.ConvolutionFlow.odd_power_negative_iff","kind":"theorem","line":61,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MassTheory/ConvolutionFlowParity.lean#L61-L81","doc":"**Odd powers**: the character is negative iff the Sym growth has not yet overtaken the\nAlt/Sym ratio. ","signatureChunk":0},{"@id":"lean:QOU.MassTheory.ConvolutionFlow.pow_interp_at_neg_inv","@type":"LeanDeclaration","name":"QOU.MassTheory.ConvolutionFlow.pow_interp_at_neg_inv","kind":"theorem","line":50,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MassTheory/ConvolutionFlowParity.lean#L50-L53","signatureChunk":0},{"@id":"lean:QOU.MassTheory.ConvolutionFlow.pow_interp_at_q","@type":"LeanDeclaration","name":"QOU.MassTheory.ConvolutionFlow.pow_interp_at_q","kind":"theorem","line":46,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MassTheory/ConvolutionFlowParity.lean#L46-L48","signatureChunk":0},{"@id":"lean:QOU.MassTheory.ConvolutionFlow.pA","@type":"LeanDeclaration","name":"QOU.MassTheory.ConvolutionFlow.pA","kind":"def","line":43,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MassTheory/ConvolutionFlowParity.lean#L43-L44","doc":"`p_A(x) = (q − x)/(q + q⁻¹)`. ","signatureChunk":0},{"@id":"lean:QOU.MassTheory.ConvolutionFlow.pS","@type":"LeanDeclaration","name":"QOU.MassTheory.ConvolutionFlow.pS","kind":"def","line":41,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MassTheory/ConvolutionFlowParity.lean#L41-L42","doc":"`p_S(x) = (x + q⁻¹)/(q + q⁻¹)`. ","signatureChunk":0}]}