{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.AlgebraicSubstrate.AdelicSubstrate","@type":"LeanModule","name":"QOU.AlgebraicSubstrate.AdelicSubstrate","imports":["lean:module:Init","lean:module:Mathlib.Data.Real.Basic"],"declarations":6,"chunks":1},{"@id":"lean:QOU.AlgebraicSubstrate.AdelicSubstrate.nonArchimedean","@type":"LeanDeclaration","name":"QOU.AlgebraicSubstrate.AdelicSubstrate.nonArchimedean","kind":"def","line":46,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AlgebraicSubstrate/AdelicSubstrate.lean#L46-L46","doc":"Non-archimedean projection π_p : A → Loc p at each prime p. ","signatureChunk":0},{"@id":"lean:QOU.AlgebraicSubstrate.AdelicSubstrate.archimedean","@type":"LeanDeclaration","name":"QOU.AlgebraicSubstrate.AdelicSubstrate.archimedean","kind":"def","line":44,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AlgebraicSubstrate/AdelicSubstrate.lean#L44-L44","doc":"Archimedean projection π_∞ : A → ℝ (the laboratory continuum). ","signatureChunk":0},{"@id":"lean:QOU.AlgebraicSubstrate.AdelicSubstrate.Loc","@type":"LeanDeclaration","name":"QOU.AlgebraicSubstrate.AdelicSubstrate.Loc","kind":"def","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AlgebraicSubstrate/AdelicSubstrate.lean#L42-L42","doc":"Local non-archimedean rings, indexed by rational primes. ","signatureChunk":0},{"@id":"lean:QOU.AlgebraicSubstrate.AdelicSubstrate.Carrier","@type":"LeanDeclaration","name":"QOU.AlgebraicSubstrate.AdelicSubstrate.Carrier","kind":"def","line":40,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AlgebraicSubstrate/AdelicSubstrate.lean#L40-L40","doc":"The carrier ring of the substrate. ","signatureChunk":0},{"@id":"lean:QOU.AlgebraicSubstrate.AdelicSubstrate.mk","@type":"LeanDeclaration","name":"QOU.AlgebraicSubstrate.AdelicSubstrate.mk","kind":"ctor","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AlgebraicSubstrate/AdelicSubstrate.lean#L38-L38","signatureChunk":0},{"@id":"lean:QOU.AlgebraicSubstrate.AdelicSubstrate","@type":"LeanDeclaration","name":"QOU.AlgebraicSubstrate.AdelicSubstrate","kind":"structure","line":29,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AlgebraicSubstrate/AdelicSubstrate.lean#L29-L46","doc":"The **adelic substrate** of the QOU framework.\n\nAbstract interface: a ring `Carrier` carrying an archimedean\nplace (projection to `ℝ`) and one non-archimedean place per\nrational prime `p` (projection to a local quantum-state ring\n`Loc p`).\n\nEncodes the rational adele ring `𝔸_ℚ = ℝ × ∏'_p ℚ_p` as\nused by Tate's adelic Fourier analysis. ","formalizes":[{"@id":"block:def:adelic-substrate","label":"def:adelic-substrate","md":"quantum-observable-universe/mass-theory/adelic-substrate.md"}],"signatureChunk":0}]}