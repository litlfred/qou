ps://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/transfer-matrix-operator.lean#L81-L81","doc":"Transfer matrix before interaction. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.InteractionOp.q","@type":"LeanDeclaration","name":"QOU.Archimedean.InteractionOp.q","kind":"def","line":79,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/transfer-matrix-operator.lean#L79-L79","signatureChunk":0},{"@id":"lean:QOU.Archimedean.InteractionOp.mk","@type":"LeanDeclaration","name":"QOU.Archimedean.InteractionOp.mk","kind":"ctor","line":78,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/transfer-matrix-operator.lean#L78-L78","signatureChunk":0},{"@id":"lean:QOU.Archimedean.InteractionOp","@type":"LeanDeclaration","name":"QOU.Archimedean.InteractionOp","kind":"structure","line":76,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/transfer-matrix-operator.lean#L76-L87","doc":"The interaction operator: Δ = T_after - T_before. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.heckeStep","@type":"LeanDeclaration","name":"QOU.Archimedean.heckeStep","kind":"def","line":69,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/transfer-matrix-operator.lean#L69-L74","doc":"The Hecke chain step: (aσ + b) × (cσ + d) → a'σ + b'\nvia σ² = (q-q⁻¹)σ + 1. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.photon_electron_eq_pp","@type":"LeanDeclaration","name":"QOU.Archimedean.photon_electron_eq_pp","kind":"theorem","line":64,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/transfer-matrix-operator.lean#L64-L67","doc":"Proof: photon-electron = proton-proton crossing coefficients. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.photonElectronCoeffs","@type":"LeanDeclaration","name":"QOU.Archimedean.photonElectronCoeffs","kind":"def","line":58,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/transfer-matrix-operator.lean#L58-L62","doc":"The photon-electron crossing has the same coefficients as pp.\nThis is because the photon (empty knot) has J(q) = 1,\ncontributing no deformation. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.mixCoeffs","@type":"LeanDeclaration","name":"QOU.Archimedean.mixCoeffs","kind":"def","line":54,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/transfer-matrix-operator.lean#L54-L56","signatureChunk":0},{"@id":"lean:QOU.Archimedean.nnCoeffs","@type":"LeanDeclaration","name":"QOU.Archimedean.nnCoeffs","kind":"def","line":50,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/transfer-matrix-operator.lean#L50-L52","signatureChunk":0},{"@id":"lean:QOU.Archimedean.ppCoeffs","@type":"LeanDeclaration","name":"QOU.Archimedean.ppCoeffs","kind":"def","line":46,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/transfer-matrix-operator.lean#L46-L48","doc":"The three nuclear crossing types. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TransferMatrixOp.m₂₂","@type":"LeanDeclaration","name":"QOU.Archimedean.TransferMatrixOp.m₂₂","kind":"def","line":44,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/transfer-matrix-operator.lean#L44-L44","doc":"(2,2) entry: d ","signatureChunk":0},{"@id":"lean:QOU.