{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Knot.BlockLengthAdditive","@type":"LeanModule","name":"QOU.Knot.BlockLengthAdditive","imports":["lean:module:Init","lean:module:QOU.Knot.JetGradePromotion","lean:module:QOU.Knot.JetGradeLengthShift"],"declarations":23,"chunks":1},{"@id":"lean:QOU.Knot.BlockLengthAdditive.supportedIn_one","@type":"LeanDeclaration","name":"QOU.Knot.BlockLengthAdditive.supportedIn_one","kind":"theorem","line":273,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/BlockLengthAdditive.lean#L273-L277","doc":"The condition is satisfiable non-trivially: a permutation fixing everything\noutside `[a, b)` is block-supported there, and the identity is the degenerate\ncase rather than the only one. ","signatureChunk":0},{"@id":"lean:QOU.Knot.BlockLengthAdditive.length_blockProd_of_supportedIn","@type":"LeanDeclaration","name":"QOU.Knot.BlockLengthAdditive.length_blockProd_of_supportedIn","kind":"theorem","line":263,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/BlockLengthAdditive.lean#L263-L271","doc":"**Length is additive over any family of block-supported permutations.**\nThis is `length_blockProd` with its two hypotheses replaced by the single\ncondition that each `w i` acts inside its own block — the form a nucleon\ndecomposition actually supplies. ","signatureChunk":0},{"@id":"lean:QOU.Knot.BlockLengthAdditive.upperOnly_of_supportedIn","@type":"LeanDeclaration","name":"QOU.Knot.BlockLengthAdditive.upperOnly_of_supportedIn","kind":"theorem","line":259,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/BlockLengthAdditive.lean#L259-L261","signatureChunk":0},{"@id":"lean:QOU.Knot.BlockLengthAdditive.lowerOnly_of_supportedIn","@type":"LeanDeclaration","name":"QOU.Knot.BlockLengthAdditive.lowerOnly_of_supportedIn","kind":"theorem","line":255,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/BlockLengthAdditive.lean#L255-L257","signatureChunk":0},{"@id":"lean:QOU.Knot.BlockLengthAdditive.SupportedIn","@type":"LeanDeclaration","name":"QOU.Knot.BlockLengthAdditive.SupportedIn","kind":"def","line":251,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/BlockLengthAdditive.lean#L251-L253","doc":"`w` moves only points in the half-open interval `[a, b)`. ","signatureChunk":0},{"@id":"lean:QOU.Knot.BlockLengthAdditive.length_blockProd","@type":"LeanDeclaration","name":"QOU.Knot.BlockLengthAdditive.length_blockProd","kind":"theorem","line":224,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/BlockLengthAdditive.lean#L224-L237","doc":"**Length is additive across `A` order-separated blocks.** Block `i` occupies\n`[b i, b (i+1))`; the Coxeter length of the whole is the sum of the blocks'.\n\nThis is what `BodyOrderExpansion.gf_pow` needs in order to apply to the atomic\nbraid: it makes the filtration's index set an honest `A`-fold product, not a\ntwo-fold one. ","signatureChunk":0},{"@id":"lean:QOU.Knot.BlockLengthAdditive.lowerOnly_blockProd","@type":"LeanDeclaration","name":"QOU.Knot.BlockLengthAdditive.lowerOnly_blockProd","kind":"theorem","line":214,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/BlockLengthAdditive.lean#L214-L222","doc":"The first `n` blocks together move nothing at or above the `n`-th split. ","signatureChunk":0},{"@id":"lean:QOU.Knot.BlockLengthAdditive.blockProd","@type":"LeanDeclaration","name":"QOU.Knot.BlockLengthAdditive.blockProd","kind":"def","line":209,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/BlockLengthAdditive.lean#L209-L212","doc":"The product of the first `n` blocks, in order. ","signatureChunk":0},{"@id":"lean:QOU.Knot.BlockLengthAdditive.lowerOnly_one","@type":"LeanDeclaration","name":"QOU.Knot.BlockLengthAdditive.lowerOnly_one","kind":"theorem","line":206,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/BlockLengthAdditive.lean#L206-L207","doc":"The identity is lower-only at every threshold. ","signatureChunk":0},{"@id":"lean:QOU.Knot.BlockLengthAdditive.lowerOnly_mono","@type":"LeanDeclaration","name":"QOU.Knot.BlockLengthAdditive.lowerOnly_mono","kind":"theorem","line":201,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/BlockLengthAdditive.lean#L201-L204","doc":"Lower-only at a threshold is lower-only at any larger one. ","signatureChunk":0},{"@id":"lean:QOU.Knot.BlockLengthAdditive.lowerOnly_mul","@type":"LeanDeclaration","name":"QOU.Knot.BlockLengthAdditive.lowerOnly_mul","kind":"theorem","line":195,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/BlockLengthAdditive.lean#L195-L199","doc":"Lower-only is closed under multiplication. ","signatureChunk":0},{"@id":"lean:QOU.Knot.BlockLengthAdditive.length_one","@type":"LeanDeclaration","name":"QOU.Knot.BlockLengthAdditive.length_one","kind":"theorem","line":187,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/BlockLengthAdditive.lean#L187-L193","doc":"The identity has no inversions. ","signatureChunk":0},{"@id":"lean:QOU.Knot.BlockLengthAdditive.length_mul","@type":"LeanDeclaration","name":"QOU.Knot.BlockLengthAdditive.length_mul","kind":"theorem","line":168,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/BlockLengthAdditive.lean#L168-L177","doc":"**Coxeter length is additive across an order-separated block split.**\n\nThis is the content half of the block factorisation: it is what makes the\nindex set of the filtration a product, and hence what lets\n`BodyOrderExpansion.gf_pow` apply to the atomic braid rather than to an\nabstract product. ","signatureChunk":0},{"@id":"lean:QOU.Knot.BlockLengthAdditive.invSet_disjoint","@type":"LeanDeclaration","name":"QOU.Knot.BlockLengthAdditive.invSet_disjoint","kind":"theorem","line":158,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/BlockLengthAdditive.lean#L158-L166","doc":"The two inversion sets are disjoint: one lives strictly below the split,\nthe other at or above it. ","signatureChunk":0},{"@id":"lean:QOU.Knot.BlockLengthAdditive.invSet_mul","@type":"LeanDeclaration","name":"QOU.Knot.BlockLengthAdditive.invSet_mul","kind":"theorem","line":122,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/BlockLengthAdditive.lean#L122-L156","doc":"**The inversion sets add.** Every inversion of the product is an inversion\nof exactly one factor, and a straddling pair is never an inversion at all. ","signatureChunk":0},{"@id":"lean:QOU.Knot.BlockLengthAdditive.mul_apply_upper","@type":"LeanDeclaration","name":"QOU.Knot.BlockLengthAdditive.mul_apply_upper","kind":"theorem","line":117,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/BlockLengthAdditive.lean#L117-L120","doc":"At or above the split, the product acts as `v` — `u` fixes where `v` lands. ","signatureChunk":0},{"@id":"lean:QOU.Knot.BlockLengthAdditive.mul_apply_lower","@type":"LeanDeclaration","name":"QOU.Knot.BlockLengthAdditive.mul_apply_lower","kind":"theorem","line":112,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/BlockLengthAdditive.lean#L112-L115","doc":"Below the split, the product acts as `u` — `v` fixes that part. ","signatureChunk":0},{"@id":"lean:QOU.Knot.BlockLengthAdditive.invSet_upper","@type":"LeanDeclaration","name":"QOU.Knot.BlockLengthAdditive.invSet_upper","kind":"theorem","line":94,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/BlockLengthAdditive.lean#L94-L110","doc":"Every inversion of an upper-only permutation has both coordinates at or\nabove `k`. ","signatureChunk":0},{"@id":"lean:QOU.Knot.BlockLengthAdditive.invSet_lower","@type":"LeanDeclaration","name":"QOU.Knot.BlockLengthAdditive.invSet_lower","kind":"theorem","line":77,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/BlockLengthAdditive.lean#L77-L92","doc":"Every inversion of a lower-only permutation has both coordinates below `k`. ","signatureChunk":0},{"@id":"lean:QOU.Knot.BlockLengthAdditive.upper_maps_upper","@type":"LeanDeclaration","name":"QOU.Knot.BlockLengthAdditive.upper_maps_upper","kind":"theorem","line":67,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/BlockLengthAdditive.lean#L67-L75","doc":"An upper-only permutation keeps the upper part upper. ","signatureChunk":0},{"@id":"lean:QOU.Knot.BlockLengthAdditive.lower_maps_lower","@type":"LeanDeclaration","name":"QOU.Knot.BlockLengthAdditive.lower_maps_lower","kind":"theorem","line":56,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/BlockLengthAdditive.lean#L56-L65","doc":"A lower-only permutation keeps the lower part lower — by injectivity, since\nit already fixes everything upper. ","signatureChunk":0},{"@id":"lean:QOU.Knot.BlockLengthAdditive.UpperOnly","@type":"LeanDeclaration","name":"QOU.Knot.BlockLengthAdditive.UpperOnly","kind":"def","line":52,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/BlockLengthAdditive.lean#L52-L54","doc":"`v` moves only points at or above `k`. ","signatureChunk":0},{"@id":"lean:QOU.Knot.BlockLengthAdditive.LowerOnly","@type":"LeanDeclaration","name":"QOU.Knot.BlockLengthAdditive.LowerOnly","kind":"def","line":48,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/BlockLengthAdditive.lean#L48-L50","doc":"`u` moves only points strictly below `k`. ","signatureChunk":0}]}