{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:BringsSurface.TorusKnotGenerators","@type":"LeanModule","name":"BringsSurface.TorusKnotGenerators","imports":["lean:module:Init","lean:module:Mathlib.Data.Nat.Basic","lean:module:Mathlib.Data.Finset.Basic","lean:module:Mathlib.Tactic.Linarith","lean:module:Mathlib.Tactic.IntervalCases"],"declarations":2,"chunks":1},{"@id":"lean:QOU.Torsion.torus_knot_generators_finite","@type":"LeanDeclaration","name":"QOU.Torsion.torus_knot_generators_finite","kind":"theorem","line":21,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/torus-knot-generators.lean#L21-L48","doc":"The torus knot T_{m,n} embeds in a surface of genus g iff\nits Seifert genus ≤ g. For Bring's surface (g = 4),\nthe constraint (m-1)(n-1) ≤ 8 selects a finite set. ","formalizes":[{"@id":"block:prop:torus-knot-generators","label":"prop:torus-knot-generators","md":"quantum-observable-universe/brings-surface/torus-knot-generators.md"}],"signatureChunk":0},{"@id":"lean:QOU.Torsion.seifertGenus","@type":"LeanDeclaration","name":"QOU.Torsion.seifertGenus","kind":"def","line":18,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/brings-surface/torus-knot-generators.lean#L18-L19","doc":"Seifert genus of a torus knot T_{m,n} with gcd(m,n) = 1. ","signatureChunk":0}]}