{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Mass.KZHolonomy.Continuity","@type":"LeanModule","name":"QOU.Mass.KZHolonomy.Continuity","imports":["lean:module:Init","lean:module:QOU.Mass.KZHolonomy.BraidRep","lean:module:Mathlib.Analysis.Normed.Ring.Units"],"declarations":5,"chunks":1},{"@id":"lean:QOU.Mass.KZHolonomy.continuous_kzBraidRep","@type":"LeanDeclaration","name":"QOU.Mass.KZHolonomy.continuous_kzBraidRep","kind":"theorem","line":135,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/KZHolonomy/Continuity.lean#L135-L157","doc":"**Continuity of the KZ holonomy in `κ`.**  For every braid `b`, the image of `b` under\n`kzBraidRep ρ κ c` depends continuously on the coupling `κ`. ","signatureChunk":0},{"@id":"lean:QOU.Mass.KZHolonomy.continuous_kzBraidRep_σ_inv","@type":"LeanDeclaration","name":"QOU.Mass.KZHolonomy.continuous_kzBraidRep_σ_inv","kind":"theorem","line":122,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/KZHolonomy/Continuity.lean#L122-L133","doc":"The inverse of the image of a braid generator is continuous in `κ`. ","signatureChunk":0},{"@id":"lean:QOU.Mass.KZHolonomy.continuous_kzBraidRep_σ","@type":"LeanDeclaration","name":"QOU.Mass.KZHolonomy.continuous_kzBraidRep_σ","kind":"theorem","line":107,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/KZHolonomy/Continuity.lean#L107-L120","doc":"The image of a braid generator under the KZ holonomy representation is continuous in the\ncoupling `κ`. ","signatureChunk":0},{"@id":"lean:QOU.Mass.KZHolonomy.continuous_fundSol_param","@type":"LeanDeclaration","name":"QOU.Mass.KZHolonomy.continuous_fundSol_param","kind":"theorem","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/KZHolonomy/Continuity.lean#L49-L96","doc":"**Continuity of the fundamental solution in the coupling.**  If `U κ` is the fundamental\nsolution of `U' = (κ • B) U` on `[0,1]` for every `κ ∈ ℂ`, then `κ ↦ U κ 1` is continuous. ","signatureChunk":0},{"@id":"lean:QOU.Mass.KZHolonomy.norm_fundSol_le","@type":"LeanDeclaration","name":"QOU.Mass.KZHolonomy.norm_fundSol_le","kind":"theorem","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mass/KZHolonomy/Continuity.lean#L30-L47","doc":"A uniform bound on a fundamental solution whose coefficient is bounded by `K`. ","signatureChunk":0}]}