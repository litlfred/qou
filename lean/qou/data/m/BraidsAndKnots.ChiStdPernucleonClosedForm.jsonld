Declaration","name":"QOU.ChiStdPerNucleon.M2.instMul","kind":"instance","line":62,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/braids-and-knots/chi-std-pernucleon-closed-form.lean#L62-L62","signatureChunk":0},{"@id":"lean:QOU.ChiStdPerNucleon.M2.trace","@type":"LeanDeclaration","name":"QOU.ChiStdPerNucleon.M2.trace","kind":"def","line":59,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/braids-and-knots/chi-std-pernucleon-closed-form.lean#L59-L60","doc":"2×2 trace. ","signatureChunk":0},{"@id":"lean:QOU.ChiStdPerNucleon.M2.one","@type":"LeanDeclaration","name":"QOU.ChiStdPerNucleon.M2.one","kind":"def","line":56,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/braids-and-knots/chi-std-pernucleon-closed-form.lean#L56-L57","doc":"2×2 identity matrix. ","signatureChunk":0},{"@id":"lean:QOU.ChiStdPerNucleon.M2.add","@type":"LeanDeclaration","name":"QOU.ChiStdPerNucleon.M2.add","kind":"def","line":52,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/braids-and-knots/chi-std-pernucleon-closed-form.lean#L52-L54","doc":"2×2 matrix addition. ","signatureChunk":0},{"@id":"lean:QOU.ChiStdPerNucleon.M2.smul","@type":"LeanDeclaration","name":"QOU.ChiStdPerNucleon.M2.smul","kind":"def","line":48,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/braids-and-knots/chi-std-pernucleon-closed-form.lean#L48-L50","doc":"2×2 scalar multiplication. ","signatureChunk":0},{"@id":"lean:QOU.ChiStdPerNucleon.M2.mul","@type":"LeanDeclaration","name":"QOU.ChiStdPerNucleon.M2.mul","kind":"def","line":43,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable