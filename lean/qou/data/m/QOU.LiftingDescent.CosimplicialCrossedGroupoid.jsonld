reChunk":0},{"@id":"lean:QOU.LiftingDescent.CosimplicialCrossedGroupoid.mk","@type":"LeanDeclaration","name":"QOU.LiftingDescent.CosimplicialCrossedGroupoid.mk","kind":"ctor","line":79,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/LiftingDescent/CosimplicialCrossedGroupoid.lean#L79-L79","signatureChunk":0},{"@id":"lean:QOU.LiftingDescent.CosimplicialCrossedGroupoid","@type":"LeanDeclaration","name":"QOU.LiftingDescent.CosimplicialCrossedGroupoid","kind":"structure","line":77,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/LiftingDescent/CosimplicialCrossedGroupoid.lean#L77-L91","doc":"**Cosimplicial crossed groupoid** for the brane tower. ","signatureChunk":0},{"@id":"lean:QOU.LiftingDescent.CrossedModule.peiffer","@type":"LeanDeclaration","name":"QOU.LiftingDescent.CrossedModule.peiffer","kind":"theorem","line":72,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/LiftingDescent/CosimplicialCrossedGroupoid.lean#L72-L72","signatureChunk":0},{"@id":"lean:QOU.LiftingDescent.CrossedModule.action","@type":"LeanDeclaration","name":"QOU.LiftingDescent.CrossedModule.action","kind":"def","line":71,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/LiftingDescent/CosimplicialCrossedGroupoid.lean#L71-L71","signatureChunk":0},{"@id":"lean:QOU.LiftingDescent.CrossedModule.boundary","@type":"LeanDeclaration","name":"QOU.LiftingDescent.CrossedModule.boundary","kind":"def","line":70,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/LiftingDescent/CosimplicialCrossedGroupoid.lean#L70-L70","signatureChunk":0},{"@id":"lean:QOU.LiftingDescent.CrossedModule.grpG","@type":"LeanDeclaration","name":"QOU.LiftingDescent.CrossedModule.grpG","kind":"def","line":69,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/LiftingDescent/CosimplicialCrossedGroupoid.lean#L69-L69","signatureChunk":0},{"@id":"lean:QOU.LiftingDescent.CrossedModule.grpN","@type":"LeanDeclaration","name":"QOU.LiftingDescent.CrossedModule.grpN","kind":"def","line":68,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/LiftingDescent/CosimplicialCrossedGroupoid.lean#L68-L68","signatureChunk":0},{"@id":"lean:QOU.LiftingDescent.CrossedModule.G","@type":"LeanDeclaration","name":"QOU.LiftingDescent.CrossedModule.G","kind":"def","line":67,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/LiftingDescent/CosimplicialCrossedGroupoid.lean#L67-L67","signatureChunk":0},{"@id":"lean:QOU.LiftingDescent.CrossedModule.N","@type":"LeanDeclaration","name":"QOU.LiftingDescent.CrossedModule.N","kind":"def","line":66,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/LiftingDescent/CosimplicialCrossedGroupoid.lean#L66-L66","signatureChunk":0},{"@id":"lean:QOU.LiftingDescent.CrossedModule.mk","@type":"LeanDeclaration","name":"QOU.LiftingDescent.CrossedModule.mk","kind":"ctor","line":65,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/LiftingDescent/CosimplicialCrossedGroupoid.lean#L65-L65","signatureChunk":0},{"@id":"lean:QOU.LiftingDescent.CrossedModule","@type":"LeanDeclaration","name":"QOU.LiftingDescent.CrossedModule","kind":"structure","line":53,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/LiftingDescent/CosimplicialCrossedGroupoid.lean#L53-L73","doc":"A crossed module in the sense of Yekutieli [yekutieli2010]:\na pair of (possibly non-abelian) groups `N`, `G`, a boundary\nhomomorphism `∂ : N → G`, and a conjugation action of `G` on\n`N` satisfying the Peiffer identity\n`∂(g · n) = g · ∂n · g⁻¹`.\n\nNote: the formal-chain layer keeps the carriers polymorphic\nrather than fixing them to `R_q`; the commutative ring `R_q`\nenters only through the *image* of `∂` when an instance is\nrealised over the deformation parameter. Cf. gemini-code-assist\nreview on PR #535. ","signatureChunk":0},{"@id":"lean:QOU.LiftingDescent.YekutieliTriple","@type":"LeanDeclaration","name":"QOU.LiftingDescent.YekutieliTriple","kind":"def","line":39,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/LiftingDescent/CosimplicialCrossedGroupoid.lean#L39-L51","doc":"A Yekutieli triple at level `n` over a manifold `M`:\nthe datum `(x, g, a)` of local trivialisations, transition\nautomorphisms, and deformation parameters.\n\n**De-duplicated (bean `qou-s82c`).** This module used to declare its own\ncopy of this structure, byte-identical to `QOU.Torsion.YekutieliTriple`\nexcept for the coefficient ring. It is now that structure instantiated at\nthis module's ground ring `R_q = ℤ[q, q⁻¹]` — one definition, two rings,\ninstead of two definitions that could drift apart. The generic structure\nasks only for `[Zero R]` precisely so a `CommRing` without total inverses\ncan instantiate it. ","signatureChunk":0},{"@id":"lean:QOU.LiftingDescent.q_inv_param","@type":"LeanDeclaration","name":"QOU.LiftingDescent.q_inv_param","kind":"def","line":37,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/LiftingDescent/CosimplicialCrossedGroupoid.lean#L37-L37","signatureChunk":0},{"@id":"lean:QOU.LiftingDescent.q_param","@type":"LeanDeclaration","name":"QOU.LiftingDescent.q_param","kind":"def","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/LiftingDescent/CosimplicialCrossedGroupoid.lean#L36-L36","signatureChunk":0},{"@id":"lean:QOU.LiftingDescent.R_q","@type":"LeanDeclaration","name":"QOU.LiftingDescent.R_q","kind":"def","line":34,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/LiftingDescent/CosimplicialCrossedGroupoid.lean#L34-L35","doc":"Ground ring `R_q = ℤ[q, q⁻¹]`. ","signatureChunk":0}]}