","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.SingleLevelMassAmplitude.mass_eq_abs_tr","kind":"theorem","line":339,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L339-L339","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.SingleLevelMassAmplitude.singleLevelMass_nonneg","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.SingleLevelMassAmplitude.singleLevelMass_nonneg","kind":"theorem","line":338,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L338-L338","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.SingleLevelMassAmplitude.singleLevelMass","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.SingleLevelMassAmplitude.singleLevelMass","kind":"def","line":337,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L337-L337","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.SingleLevelMassAmplitude.braidElement","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.SingleLevelMassAmplitude.braidElement","kind":"def","line":336,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L336-L336","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.SingleLevelMassAmplitude.fct","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.SingleLevelMassAmplitude.fct","kind":"def","line":335,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L335-L335","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.SingleLevelMassAmplitude.mk","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.SingleLevelMassAmplitude.mk","kind":"ctor","line":334,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L334-L334","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.SingleLevelMassAmplitude","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.SingleLevelMassAmplitude","kind":"structure","line":333,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L333-L342","doc":"**Categorical mass at single level = |transition amplitude|.** ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.FeynmanQOUDictionary.planckConstant","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.FeynmanQOUDictionary.planckConstant","kind":"def","line":329,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L329-L329","doc":"The quantum Planck constant ℏ_q = 1 - q⁻¹. ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.FeynmanQOUDictionary.q_not_root_of_unity","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.FeynmanQOUDictionary.q_not_root_of_unity","kind":"theorem","line":327,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L327-L327","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.FeynmanQOUDictionary.q_pos","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.FeynmanQOUDictionary.q_pos","kind":"theorem","line":326,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L326-L326","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.FeynmanQOUDictionary.q","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.FeynmanQOUDictionary.q","kind":"def","line":325,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L325-L325","doc":"The q-deformation parameter. ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.FeynmanQOUDictionary.equivalence","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.FeynmanQOUDictionary.equivalence","kind":"def","line":323,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L323-L323","doc":"The central equivalence: path integral = categorical trace. ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.FeynmanQOUDictionary.eigenbasisComplete","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.FeynmanQOUDictionary.eigenbasisComplete","kind":"def","line":321,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L321-L321","doc":"Eigenbasis completeness: the basis spans the tensor power. ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.FeynmanQOUDictionary.pathMeasure","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.FeynmanQOUDictionary.pathMeasure","kind":"def","line":319,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L319-L319","doc":"Path measure Dφ ↔ Markov trace tr_M on H_n(q). ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.FeynmanQOUDictionary.configSpace","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.FeynmanQOUDictionary.configSpace","kind":"def","line":317,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L317-L317","doc":"Configuration space of paths ↔ Braid group B_n acting on V^{⊗n}. ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.FeynmanQOUDictionary.mk","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.FeynmanQOUDictionary.mk","kind":"ctor","line":315,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L315-L315","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.FeynmanQOUDictionary","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.FeynmanQOUDictionary","kind":"structure","line":310,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L310-L329","doc":"**Structural correspondence** between the Feynman path integral\nand the QOU categorical trace.\n\nLaTeX: `\\label{rem:feynman-qou-dictionary}` ","formalizes":[{"@id":"block:rem:feynman-qou-dictionary","label":"rem:feynman-qou-dictionary","md":"quantum-observable-universe/mass-theory/feynman-qou-dictionary.md"}],"signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.ClassicalLimitDegeneration.qdim_limit","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.ClassicalLimitDegeneration.qdim_limit","kind":"theorem","line":302,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L302-L302","doc":"(3) [n]_q → n as q → 1. ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.ClassicalLimitDegeneration.planck_limit","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.ClassicalLimitDegeneration.planck_limit","kind":"theorem","line":298,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L298-L298","doc":"(2) ℏ_q = 1 - q⁻¹ → 0 as q → 1. ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.ClassicalLimitDegeneration.symmetric_degeneration","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.ClassicalLimitDegeneration.symmetric_degeneration","kind":"theorem","line":293,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L293-L293","doc":"(1) At q = 1, T² = 1 (symmetric group relation).  The index ranges\nover `hecke_q`'s own strand count (`= n` by `n_eq`). ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.ClassicalLimitDegeneration.n_eq","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.ClassicalLimitDegeneration.n_eq","kind":"theorem","line":290,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L290-L290","doc":"Consistency: same n. ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.ClassicalLimitDegeneration.hecke_q","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.ClassicalLimitDegeneration.hecke_q","kind":"def","line":288,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L288-L288","doc":"The Hecke algebra at generic q. ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.ClassicalLimitDegeneration.n","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.ClassicalLimitDegeneration.n","kind":"def","line":286,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L286-L286","doc":"Number of strands. ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.ClassicalLimitDegeneration.mk","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.ClassicalLimitDegeneration.mk","kind":"ctor","line":284,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L284-L284","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.ClassicalLimitDegeneration","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.ClassicalLimitDegeneration","kind":"structure","line":279,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L279-L306","doc":"**Classical limit data**: the algebraic structures at q = 1 where\nthe Hecke algebra degenerates to the symmetric group algebra.\n\nLaTeX: `\\label{prop:feynman-classical-limit}` ","formalizes":[{"@id":"block:prop:feynman-classical-limit","label":"prop:feynman-classical-limit","md":"quantum-observable-universe/mass-theory/feynman-classical-limit.md"}],"signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.q_energy_classical_limit","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.q_energy_classical_limit","kind":"theorem","line":271,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L271-L277","doc":"The q-energy reduces to the classical action at q = 1:\nE_q(K) → S_1(K) because rotational and translational terms\nvanish with ℏ_q → 0. ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.jones_trace_generator_at_one","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.jones_trace_generator_at_one","kind":"theorem","line":244,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L244-L269","doc":"At q = 1, the Hecke quadratic relation T² - (q-q⁻¹)T - 1 = 0\ndegenerates to T² = 1.  Applying the Markov trace (which is linear\nand satisfies tr(ab) = tr(ba)) to T² = 1 gives tr(T²) = tr(1).\nSince tr(T²) = tr(T·T) and T is invertible with T⁻¹ = T (from\nT² = 1), we get tr(T) = tr(T⁻¹).  The theorem below records only\ntr(T·T) = tr(1).\n\nScope (2026-11-16): z does NOT tend to 0. Under convention D,\nz = q³/(q²+1) → 1/2, and the q = 1 trace is tr(w) = 2^{-(n - c(w))}\nwith c(w) the number of cycles. A generator has tr(T) = 1/2, not\ntr(1) = 1. The normalised Jones value J = z^{-(n-1)} tr depends only\non the number of components (1 for a knot, 2^{c-1} for c components);\nthat is not shown here. ","formalizes":[{"@id":"block:rem:feynman-classical-limit-interpretation","label":"rem:feynman-classical-limit-interpretation","md":"quantum-observable-universe/mass-theory/feynman-classical-limit-interpretation.md"}],"signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.speed_diverges_at_one","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.speed_diverges_at_one","kind":"theorem","line":231,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L231-L242","doc":"The speed of light c_q = 1/(q-1) diverges as q → 1⁺. ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.planck_at_one","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.planck_at_one","kind":"theorem","line":228,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L228-L229","doc":"The quantum Planck constant ℏ_q = 1 - q⁻¹ vanishes at q = 1. ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.hecke_degeneration_symmetric","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.hecke_degeneration_symmetric","kind":"theorem","line":221,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L221-L226","doc":"At q = 1, the quadratic relation (T - 1)(T + 1) = 0 gives T² = 1,\nwhich is the defining relation of the symmetric group S_n.\nEquivalently, the Hecke parameter q - q⁻¹ vanishes. ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.mass_eq_abs_amplitude","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.mass_eq_abs_amplitude","kind":"theorem","line":207,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L207-L217","doc":"**Mass from transition amplitude**: the categorical mass at a single\nbrane level equals the absolute value of the Markov trace, which\nequals the absolute value of the transition amplitude. ","formalizes":[{"@id":"block:prf:feynman-categorical-trace","label":"prf:feynman-categorical-trace","md":"quantum-observable-universe/mass-theory/feynman-categorical-trace-proof.md"}],"signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.FeynmanCategoricalTrace.partitions_count","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.FeynmanCategoricalTrace.partitions_count","kind":"theorem","line":205,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L205-L205","doc":"The partition list has at most ⌊n/2⌋ + 1 entries. ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.FeynmanCategoricalTrace.amplitude_eq_markov","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.FeynmanCategoricalTrace.amplitude_eq_markov","kind":"theorem","line":202,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L202-L202","doc":"**Central identity**: the transition amplitude equals the Markov trace.\nΣ_λ w_λ · tr_{S_λ}(ρ(β)) = tr_M(ρ(β)).\nThe `consistent` field bridges `decomp.hecke.carrier` and\n`markov.hecke.carrier` so `markov.tr` accepts the cast element. ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.FeynmanCategoricalTrace.transitionAmplitude","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.FeynmanCategoricalTrace.transitionAmplitude","kind":"def","line":196,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L196-L196","doc":"The transition amplitude: Markov-weighted sum of partial traces. ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.FeynmanCategoricalTrace.partialTrace","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.FeynmanCategoricalTrace.partialTrace","kind":"def","line":194,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L194-L194","doc":"Partial trace on each irreducible Hecke module S_λ. ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.FeynmanCategoricalTrace.markovWeight","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.FeynmanCategoricalTrace.markovWeight","kind":"def","line":192,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L192-L192","doc":"Markov weight for each partition (determined by Markov property). ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.FeynmanCategoricalTrace.braidRep","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.FeynmanCategoricalTrace.braidRep","kind":"def","line":190,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L190-L190","doc":"The braid representation map β ↦ ρ(β) ∈ H_n(q). ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.FeynmanCategoricalTrace.consistent","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.FeynmanCategoricalTrace.consistent","kind":"theorem","line":188,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L188-L188","doc":"Consistency: same Hecke algebra. ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.FeynmanCategoricalTrace.markov","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.FeynmanCategoricalTrace.markov","kind":"def","line":186,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L186-L186","doc":"The Markov trace on the Hecke algebra. ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.FeynmanCategoricalTrace.decomp","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.FeynmanCategoricalTrace.decomp","kind":"def","line":184,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L184-L184","doc":"The q-Schur–Weyl decomposition providing the eigenbasis. ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.FeynmanCategoricalTrace.mk","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.FeynmanCategoricalTrace.mk","kind":"ctor","line":182,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L182-L182","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.FeynmanCategoricalTrace","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.FeynmanCategoricalTrace","kind":"structure","line":161,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L161-L205","doc":"**Feynman transition amplitude on the knot-type eigenbasis.**\n\nGiven a q-Schur–Weyl decomposition V^{⊗n} ≅ ⊕_λ V_λ ⊗ S_λ\nand a braid representative β ∈ B_n, the transition amplitude\nrestricted to the eigenbasis is the Markov-weighted sum of traces\non irreducible Hecke modules.\n\nThe Markov weights w_λ are determined by the Markov property\ntr_M(x T_n^{±1}) = z^{±1} tr_M(x).  The weighted sum is\nexactly the Jones–Markov trace:\n\n  Σ_λ w_λ · tr_{S_λ}(ρ(β)) = tr_M(ρ(β))\n\nThis replaces the continuum path integral ∫Dφ e^{iS/ℏ} with a\nfinite algebraic expression.\n\nLaTeX: `\\label{prop:feynman-categorical-trace}` ","formalizes":[{"@id":"block:prop:feynman-categorical-trace","label":"prop:feynman-categorical-trace","md":"quantum-observable-universe/mass-theory/feynman-categorical-trace.md"}],"signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.markovIdentification_refl","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.markovIdentification_refl","kind":"instance","line":156,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L156-L159","doc":"Reflexivity instance: when both arguments are syntactically\nthe same value, the identity holds by `rfl`. ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.MarkovIdentification.identity","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.MarkovIdentification.identity","kind":"theorem","line":154,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L154-L154","doc":"The weighted-character sum equals the Markov trace. ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.MarkovIdentification.mk","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.MarkovIdentification.mk","kind":"ctor","line":152,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L152-L152","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.MarkovIdentification","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.MarkovIdentification","kind":"class","line":138,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L138-L154","doc":"**Markov identification — typeclass.** The Markov-weighted\nsum of partial traces on the eigenbasis equals the Jones–Markov\ntrace on `H_n(R, q)`:\n`Σ_λ w_λ · tr_{S_λ}(ρ(β)) = tr_M(ρ(β))`. Follows from the\nWedderburn–Artin decomposition of the semisimple algebra\n`H_n(R, q)` and the uniqueness of the Markov trace via\n`tr_M(x σ_n^{±1}) = z^{±1} tr_M(x)`. Per-instance witness\npending the full Wedderburn-Artin formalisation in Mathlib.\n\nLaTeX: `\\label{lem:feynman-markov-identification}` ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.trace_collapse","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.trace_collapse","kind":"theorem","line":123,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L123-L136","doc":"**Trace collapse.**  Given the complete eigenbasis, the Feynman\npath integral on V_phys = colim V^{⊗n} collapses to a finite\nweighted sum over irreducible summands.  No regularisation is\nneeded because H_n(R, q) is semisimple at non-root-of-unity q.\n\nThe conclusion (partition count ≤ n/2 + 1) is the same as\n`eigenbasis_decomposition`; the trace collapse is a corollary.\n\nLaTeX: `\\label{lem:feynman-trace-collapse}` ","formalizes":[{"@id":"block:lem:feynman-trace-collapse","label":"lem:feynman-trace-collapse","md":"quantum-observable-universe/mass-theory/feynman-trace-collapse.md"}],"signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.eigenbasis_decomposition","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.eigenbasis_decomposition","kind":"theorem","line":97,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L97-L121","doc":"**Eigenbasis decomposition.**  By q-Schur–Weyl duality,\nV^{⊗n} ≅ ⊕_{λ ⊢ n, ℓ(λ) ≤ 2} V_λ ⊗ S_λ, and the number of\nsummands is ⌊n/2⌋ + 1, finite for every n.\n\nDIAGNOSTIC: as written, the bound is **not** provable from the\n`SchurWeylDecomposition` structure alone, because `partitions :\nList YoungDiagram` is a free field — a user can pick any list\nsatisfying the per-element constraints (`partitions_size`,\n`partitions_rank`), including duplicates. Without `Nodup`, the\nlength is unbounded.\n\nTo recover provability, sharpen the structure with\n`partitions_nodup : partitions.Nodup` (then length ≤ count of\nvalid 2-row partitions of n, which is `n/2 + 1`). The\n`complete` field already provides the surjectivity direction.\nSorry retained with this diagnosis.\n\nLaTeX: `\\label{lem:feynman-eigenbasis-decomposition}` ","formalizes":[{"@id":"block:lem:feynman-eigenbasis-decomposition","label":"lem:feynman-eigenbasis-decomposition","md":"quantum-observable-universe/mass-theory/feynman-eigenbasis-decomposition.md"}],"signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.qNum_pos","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.qNum_pos","kind":"theorem","line":56,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L56-L93","doc":"The quantum number `[n]_q` is positive for `q > 0`, `q ≠ 1`, `n ≥ 1`.\n\nProof: when `q > 1`, both `qⁿ > q⁻ⁿ` and `q > q⁻¹`, so num/denom > 0.\nWhen `0 < q < 1`, both inequalities reverse, so neg/neg > 0. ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.qNum_at_one","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.qNum_at_one","kind":"theorem","line":52,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L52-L54","doc":"At q = 1, the quantum number reduces to n. ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.quantumDim","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.quantumDim","kind":"def","line":48,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L48-L50","doc":"The quantum dimension `[2j+1]_q` for half-integer spin `j`,\nencoded as `dim_q(n) = [n]_q` for `n = 2j+1 : ℕ`. ","signatureChunk":0},{"@id":"lean:QOU.FeynmanPathIntegrals.qNum","@type":"LeanDeclaration","name":"QOU.FeynmanPathIntegrals.qNum","kind":"def","line":43,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/FeynmanPathIntegrals.lean#L43-L46","doc":"The quantum number `[n]_q = (qⁿ − q⁻ⁿ)/(q − q⁻¹)` for natural `n`.\nUses `ℕ` exponent to avoid `rpow` complications. ","signatureChunk":0}]}