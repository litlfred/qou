{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.QuantumObservableUniverses.QExpEntire","@type":"LeanModule","name":"QOU.QuantumObservableUniverses.QExpEntire","imports":["lean:module:Init","lean:module:Mathlib.Analysis.SpecificLimits.Normed","lean:module:Mathlib.Analysis.Complex.Basic"],"declarations":11,"chunks":1},{"@id":"lean:QOU.QExp.qExpTerm_summable","@type":"LeanDeclaration","name":"QOU.QExp.qExpTerm_summable","kind":"theorem","line":89,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverses/QExpEntire.lean#L89-L111","doc":"**The q-exponential is entire.**  For `q > 1` the series\n`∑ xⁿ / [n]_q!` is summable for every `x : ℂ` — the analytic fact that\nlicenses the categorical Wick rotation `F(ξ) = L(iξ)`. ","formalizes":[{"@id":"block:prop:q-exp-entire","label":"prop:q-exp-entire","md":"quantum-observable-universe/quantum-observable-universes/q-exp-entire.md"}],"signatureChunk":0},{"@id":"lean:QOU.QExp.norm_qExpTerm","@type":"LeanDeclaration","name":"QOU.QExp.norm_qExpTerm","kind":"theorem","line":83,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverses/QExpEntire.lean#L83-L87","doc":"Norm of the `n`-th q-exponential term. ","signatureChunk":0},{"@id":"lean:QOU.QExp.qFact_pos","@type":"LeanDeclaration","name":"QOU.QExp.qFact_pos","kind":"theorem","line":76,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverses/QExpEntire.lean#L76-L81","doc":"The q-factorial is positive for `q > 1`. ","signatureChunk":0},{"@id":"lean:QOU.QExp.qNat_succ_pos","@type":"LeanDeclaration","name":"QOU.QExp.qNat_succ_pos","kind":"theorem","line":72,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverses/QExpEntire.lean#L72-L74","doc":"The balanced q-integer of `n+1` is positive for `q > 1`. ","signatureChunk":0},{"@id":"lean:QOU.QExp.qNat_succ_ge","@type":"LeanDeclaration","name":"QOU.QExp.qNat_succ_ge","kind":"theorem","line":57,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverses/QExpEntire.lean#L57-L70","doc":"The balanced q-integer of `n+1` dominates `qⁿ` (drop the positive tail). ","signatureChunk":0},{"@id":"lean:QOU.QExp.sub_inv_pos","@type":"LeanDeclaration","name":"QOU.QExp.sub_inv_pos","kind":"theorem","line":51,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverses/QExpEntire.lean#L51-L55","doc":"For `q > 1` the denominator `q − q⁻¹` is positive. ","signatureChunk":0},{"@id":"lean:QOU.QExp.qFact_succ","@type":"LeanDeclaration","name":"QOU.QExp.qFact_succ","kind":"theorem","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverses/QExpEntire.lean#L49-L49","signatureChunk":0},{"@id":"lean:QOU.QExp.qFact_zero","@type":"LeanDeclaration","name":"QOU.QExp.qFact_zero","kind":"theorem","line":47,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverses/QExpEntire.lean#L47-L47","signatureChunk":0},{"@id":"lean:QOU.QExp.qExpTerm","@type":"LeanDeclaration","name":"QOU.QExp.qExpTerm","kind":"def","line":44,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverses/QExpEntire.lean#L44-L45","doc":"`n`-th term of the q-exponential `∑ xⁿ / [n]_q!`. ","signatureChunk":0},{"@id":"lean:QOU.QExp.qFact","@type":"LeanDeclaration","name":"QOU.QExp.qFact","kind":"def","line":39,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverses/QExpEntire.lean#L39-L42","doc":"q-factorial `[n]_q! = ∏_{k=1}^{n} [k]_q`. ","signatureChunk":0},{"@id":"lean:QOU.QExp.qNat","@type":"LeanDeclaration","name":"QOU.QExp.qNat","kind":"def","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuantumObservableUniverses/QExpEntire.lean#L36-L37","doc":"Balanced q-integer `[n]_q = (qⁿ − q⁻ⁿ)/(q − q⁻¹)`. ","signatureChunk":0}]}