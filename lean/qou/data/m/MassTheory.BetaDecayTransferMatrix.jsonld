{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:MassTheory.BetaDecayTransferMatrix","@type":"LeanModule","name":"MassTheory.BetaDecayTransferMatrix","imports":["lean:module:Init","lean:module:Mathlib.Data.Real.Basic","lean:module:Mathlib.Tactic"],"declarations":32,"chunks":1},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.daughter_volumes_smaller","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.daughter_volumes_smaller","kind":"theorem","line":209,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L209-L215","doc":"At each generator, the daughter volume is smaller than the parent\n(the decay releases action). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.generator_volumes_pos","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.generator_volumes_pos","kind":"theorem","line":201,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L201-L207","doc":"All generator volumes are positive. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.V_dau_sigma1","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.V_dau_sigma1","kind":"def","line":199,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L199-L199","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.V_par_sigma1","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.V_par_sigma1","kind":"def","line":198,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L198-L198","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.V_dau_sigma0","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.V_dau_sigma0","kind":"def","line":197,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L197-L197","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.V_par_sigma0","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.V_par_sigma0","kind":"def","line":192,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L192-L196","doc":"Tritium per-generator volumes from witness computation.\nσ₀: V_par = 0.7684, V_dau = 0.7510\nσ₁: V_par = 1.3029, V_dau = 1.2036 ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.tritium_ratio_pos","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.tritium_ratio_pos","kind":"theorem","line":187,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L187-L190","doc":"The Skein ratio is positive (both polynomials positive). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.tritium_ratio_lt_one","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.tritium_ratio_lt_one","kind":"theorem","line":182,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L182-L185","doc":"The Skein ratio is less than 1 (daughter has smaller polynomial). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.tritium_skein_ratio","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.tritium_skein_ratio","kind":"def","line":177,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L177-L180","doc":"Tritium Skein polynomial ratio: P(³He)/P(³H) ≈ 0.9029.\nSource: beta-decay-matrix.witness.json. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.decay_offdiag_at_q","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.decay_offdiag_at_q","kind":"theorem","line":172,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L172-L175","doc":"At q = 1.110: off-diagonal = 0 (the decay matrix is scalar). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.decay_offdiag_formula","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.decay_offdiag_formula","kind":"theorem","line":164,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L164-L170","doc":"Decay matrix off-diagonal entry is 0: Δ_β = ½(q - q⁻¹)·I is\nscalar (the off-diagonal `c` entries cancel between T_mix and T_nn). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.decay_matrix_sign_pattern","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.decay_matrix_sign_pattern","kind":"theorem","line":154,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L154-L162","doc":"The decay matrix is a scalar multiple of the identity:\nΔ_β(q) = ½(q - q⁻¹)·I, so the diagonal entry is (q - q⁻¹)/2\nand the off-diagonal entries vanish. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.hecke_coeff_pos","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.hecke_coeff_pos","kind":"theorem","line":149,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L149-L152","doc":"The Hecke coefficient is positive for q > 1. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.hecke_coeff_at_q","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.hecke_coeff_at_q","kind":"def","line":144,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L144-L147","doc":"The Hecke coefficient T_pp(1,1) = q - q⁻¹ ≈ 0.2091 at q = 1.110.\nWitness: 0.2090990990990993. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.T_pp_corner","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.T_pp_corner","kind":"theorem","line":139,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L139-L142","doc":"T_pp(2,2) at any q is 0 (exact). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.T_pp_offdiag","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.T_pp_offdiag","kind":"theorem","line":134,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L134-L137","doc":"T_pp off-diagonal at q = 1.110 is 1 (exact). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.TM.tracedVolume","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.TM.tracedVolume","kind":"def","line":124,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L124-L127","doc":"The Markov-traced volume from a transfer matrix. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.beta_decay_vanishes_classical","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.beta_decay_vanishes_classical","kind":"theorem","line":116,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L116-L122","doc":"At q = 1, the decay matrix vanishes (no beta decay). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.T_mix_midpoint","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.T_mix_midpoint","kind":"theorem","line":105,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L105-L114","doc":"T_mix is the exact midpoint: T_mix = ½(T_pp + T_nn). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.beta_decay_universal","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.beta_decay_universal","kind":"theorem","line":93,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L93-L103","doc":"UNIVERSALITY: Δ_β^{nn→mix} = Δ_β^{mix→pp}.\nThe two elementary decay matrices are the same. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.Delta_beta","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.Delta_beta","kind":"def","line":87,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L87-L91","doc":"The universal beta decay matrix: Δ_β = T_mix - T_nn = T_pp - T_mix.\nBoth elementary decay matrices are identical. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.TM.sub","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.TM.sub","kind":"def","line":79,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L79-L85","doc":"Matrix subtraction. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.T_mix","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.T_mix","kind":"def","line":73,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L73-L77","doc":"T_mix: mixed crossing (c=1, d=-½(q-q⁻¹)).\nThe algebraic average ½(σ + σ⁻¹). No fractional powers of q. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.T_nn","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.T_nn","kind":"def","line":66,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L66-L71","doc":"T_nn: neutron-neutron crossing (c=1, d=-(q-q⁻¹)).\nHecke-inverse convention: T(1, -(q-q⁻¹)) consistent with\nσ⁻¹ = σ - (q - q⁻¹). No fractional powers of q. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.T_pp","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.T_pp","kind":"def","line":62,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L62-L64","doc":"T_pp: proton-proton crossing (c=1, d=0). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.tm","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.tm","kind":"def","line":54,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L54-L60","doc":"Transfer matrix from crossing coefficients (c, d). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.TM.a₂₂","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.TM.a₂₂","kind":"def","line":52,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L52-L52","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.TM.a₂₁","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.TM.a₂₁","kind":"def","line":51,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L51-L51","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.TM.a₁₂","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.TM.a₁₂","kind":"def","line":50,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L50-L50","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.TM.a₁₁","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.TM.a₁₁","kind":"def","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L49-L49","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.TM.mk","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.TM.mk","kind":"ctor","line":48,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L48-L48","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BetaDecayTransfer.TM","@type":"LeanDeclaration","name":"QOU.Archimedean.BetaDecayTransfer.TM","kind":"structure","line":46,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/beta-decay-transfer-matrix.lean#L46-L52","doc":"A 2×2 transfer matrix (entries are polynomials in q). ","signatureChunk":0}]}