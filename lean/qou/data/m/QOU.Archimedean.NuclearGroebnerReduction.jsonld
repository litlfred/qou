{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Archimedean.NuclearGroebnerReduction","@type":"LeanModule","name":"QOU.Archimedean.NuclearGroebnerReduction","imports":["lean:module:Init","lean:module:Mathlib.Data.Real.Basic","lean:module:Mathlib.Tactic","lean:module:Mathlib.Data.List.Basic"],"declarations":24,"chunks":1},{"@id":"lean:QOU.Archimedean.nuclear_groebner_reduction","@type":"LeanDeclaration","name":"QOU.Archimedean.nuclear_groebner_reduction","kind":"def","line":123,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/NuclearGroebnerReduction.lean#L123-L130","doc":"Top-level alias matching the manifest declaration. ","formalizes":[{"@id":"block:prop:nuclear-groebner-reduction","label":"prop:nuclear-groebner-reduction","md":"quantum-observable-universe/nuclear-interactions/nuclear-groebner-reduction.md"}],"signatureChunk":0},{"@id":"lean:QOU.Archimedean.max_word_length_bound","@type":"LeanDeclaration","name":"QOU.Archimedean.max_word_length_bound","kind":"theorem","line":104,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/NuclearGroebnerReduction.lean#L104-L121","doc":"The maximum word length of a reduced word with no duplicate\ngenerators and all generators in {0, ..., A-2} is A-1.\nThis follows by pigeonhole: A-1 distinct values, no repeats. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.isReduced","@type":"LeanDeclaration","name":"QOU.Archimedean.isReduced","kind":"def","line":83,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/NuclearGroebnerReduction.lean#L83-L94","doc":"A word is Gröbner-reduced if no relation in G applies. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.instDecidableEqGroebnerRelation","@type":"LeanDeclaration","name":"QOU.Archimedean.instDecidableEqGroebnerRelation","kind":"instance","line":81,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/NuclearGroebnerReduction.lean#L81-L81","signatureChunk":0},{"@id":"lean:QOU.Archimedean.instDecidableEqGroebnerRelation.decEq","@type":"LeanDeclaration","name":"QOU.Archimedean.instDecidableEqGroebnerRelation.decEq","kind":"def","line":81,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/NuclearGroebnerReduction.lean#L81-L81","signatureChunk":0},{"@id":"lean:QOU.Archimedean.GroebnerRelation.farComm","@type":"LeanDeclaration","name":"QOU.Archimedean.GroebnerRelation.farComm","kind":"ctor","line":80,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/NuclearGroebnerReduction.lean#L80-L80","signatureChunk":0},{"@id":"lean:QOU.Archimedean.GroebnerRelation.yangBaxter","@type":"LeanDeclaration","name":"QOU.Archimedean.GroebnerRelation.yangBaxter","kind":"ctor","line":79,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/NuclearGroebnerReduction.lean#L79-L79","signatureChunk":0},{"@id":"lean:QOU.Archimedean.GroebnerRelation.hecke","@type":"LeanDeclaration","name":"QOU.Archimedean.GroebnerRelation.hecke","kind":"ctor","line":78,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/NuclearGroebnerReduction.lean#L78-L78","signatureChunk":0},{"@id":"lean:QOU.Archimedean.GroebnerRelation","@type":"LeanDeclaration","name":"QOU.Archimedean.GroebnerRelation","kind":"inductive","line":74,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/NuclearGroebnerReduction.lean#L74-L81","doc":"The Gröbner basis for the Hecke algebra consists of three\ntypes of relations. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.HeckeRelation.sigma_coeff_pos","@type":"LeanDeclaration","name":"QOU.Archimedean.HeckeRelation.sigma_coeff_pos","kind":"theorem","line":69,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/NuclearGroebnerReduction.lean#L69-L69","doc":"The sigma coefficient is positive. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.HeckeRelation.const_coeff","@type":"LeanDeclaration","name":"QOU.Archimedean.HeckeRelation.const_coeff","kind":"def","line":67,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/NuclearGroebnerReduction.lean#L67-L67","doc":"σ² constant term: 1. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.HeckeRelation.sigma_coeff","@type":"LeanDeclaration","name":"QOU.Archimedean.HeckeRelation.sigma_coeff","kind":"def","line":65,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/NuclearGroebnerReduction.lean#L65-L65","doc":"σ² coefficient of σ: (q - q⁻¹). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.HeckeRelation.q_gt_one","@type":"LeanDeclaration","name":"QOU.Archimedean.HeckeRelation.q_gt_one","kind":"theorem","line":63,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/NuclearGroebnerReduction.lean#L63-L63","signatureChunk":0},{"@id":"lean:QOU.Archimedean.HeckeRelation.q","@type":"LeanDeclaration","name":"QOU.Archimedean.HeckeRelation.q","kind":"def","line":62,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/NuclearGroebnerReduction.lean#L62-L62","signatureChunk":0},{"@id":"lean:QOU.Archimedean.HeckeRelation.mk","@type":"LeanDeclaration","name":"QOU.Archimedean.HeckeRelation.mk","kind":"ctor","line":61,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/NuclearGroebnerReduction.lean#L61-L61","signatureChunk":0},{"@id":"lean:QOU.Archimedean.HeckeRelation","@type":"LeanDeclaration","name":"QOU.Archimedean.HeckeRelation","kind":"structure","line":56,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/NuclearGroebnerReduction.lean#L56-L72","doc":"The Hecke relation: σ_i² = (q - q⁻¹) σ_i + 1.\n\nThis is the unique energy-changing generator in the\nGröbner basis. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.crossingType","@type":"LeanDeclaration","name":"QOU.Archimedean.crossingType","kind":"def","line":47,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/NuclearGroebnerReduction.lean#L47-L54","doc":"The nuclear crossing matrix: for each pair (i,j) with i < j,\nthe crossing type depends on whether nucleon i and j are\nprotons or neutrons. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.instDecidableEqCrossingType","@type":"LeanDeclaration","name":"QOU.Archimedean.instDecidableEqCrossingType","kind":"instance","line":45,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/NuclearGroebnerReduction.lean#L45-L45","signatureChunk":0},{"@id":"lean:QOU.Archimedean.CrossingType.mixed","@type":"LeanDeclaration","name":"QOU.Archimedean.CrossingType.mixed","kind":"ctor","line":44,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/NuclearGroebnerReduction.lean#L44-L44","signatureChunk":0},{"@id":"lean:QOU.Archimedean.CrossingType.nn","@type":"LeanDeclaration","name":"QOU.Archimedean.CrossingType.nn","kind":"ctor","line":43,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/NuclearGroebnerReduction.lean#L43-L43","signatureChunk":0},{"@id":"lean:QOU.Archimedean.CrossingType.pp","@type":"LeanDeclaration","name":"QOU.Archimedean.CrossingType.pp","kind":"ctor","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/NuclearGroebnerReduction.lean#L42-L42","signatureChunk":0},{"@id":"lean:QOU.Archimedean.CrossingType","@type":"LeanDeclaration","name":"QOU.Archimedean.CrossingType","kind":"inductive","line":37,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/NuclearGroebnerReduction.lean#L37-L45","doc":"The crossing sign for a nucleon pair.\npp = positive (weight q), nn = negative (weight q⁻¹),\nmixed = neutral (weight (q+q⁻¹)/2). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.HeckeElement","@type":"LeanDeclaration","name":"QOU.Archimedean.HeckeElement","kind":"def","line":33,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/NuclearGroebnerReduction.lean#L33-L35","doc":"An element of the Hecke algebra: a list of (word, coefficient) pairs. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.NuclearBraidWord","@type":"LeanDeclaration","name":"QOU.Archimedean.NuclearBraidWord","kind":"def","line":22,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/NuclearGroebnerReduction.lean#L22-L31","doc":"A braid word as a plain list of generator indices, local to the\nGröbner–Shirshov reduction in this module.\n\nRenamed from `BraidWord` (bean `qou-kfcl`): `QOU.Archimedean.BraidWord` is\nalready `List (Fin (n - 1) × Bool)` in `QOU.Archimedean.HeckeRep` — a\ndifferent type, not a mirror — so the two modules could never both be\nimported. Renamed rather than namespace-nested because a content block's\n`lean.ref` names `QOU.Archimedean.nuclear_groebner_reduction` in this file,\nand nesting would have moved that name too. ","signatureChunk":0}]}