{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:PredictedSpectra.BarSelfDualConfinementBand","@type":"LeanModule","name":"PredictedSpectra.BarSelfDualConfinementBand","imports":["lean:module:Init","lean:module:Mathlib.Data.Real.Basic","lean:module:Mathlib.Analysis.SpecialFunctions.Pow.Real","lean:module:Mathlib.Tactic.Ring","lean:module:Mathlib.Tactic.Linarith","lean:module:Mathlib.Tactic.Positivity"],"declarations":23,"chunks":1},{"@id":"lean:QOU.Archimedean.BarSelfDualConfBand.bar_self_dual_confinement_band","@type":"LeanDeclaration","name":"QOU.Archimedean.BarSelfDualConfBand.bar_self_dual_confinement_band","kind":"theorem","line":162,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/bar-self-dual-confinement-band.lean#L162-L173","doc":"**Bar-self-dual confinement band** (Proposition):\n\nℬ = (1/φ², φ²) is invariant under the bar involution q ↦ q⁻¹,\ncontains q = 1, and the two endpoints are bar-paired\n(qGold · qGoldDual = 1). ","formalizes":[{"@id":"block:prop:bar-self-dual-confinement-band","label":"prop:bar-self-dual-confinement-band","md":"quantum-observable-universe/predicted-spectra/bar-self-dual-confinement-band.md"}],"signatureChunk":0},{"@id":"lean:QOU.Archimedean.BarSelfDualConfBand.bar_invariant_confBand","@type":"LeanDeclaration","name":"QOU.Archimedean.BarSelfDualConfBand.bar_invariant_confBand","kind":"theorem","line":144,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/bar-self-dual-confinement-band.lean#L144-L160","doc":"**Bar-invariance of the confinement band**: q ∈ ℬ iff q⁻¹ ∈ ℬ. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BarSelfDualConfBand.bar_bar","@type":"LeanDeclaration","name":"QOU.Archimedean.BarSelfDualConfBand.bar_bar","kind":"theorem","line":139,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/bar-self-dual-confinement-band.lean#L139-L142","doc":"The bar involution is an involution on nonzero reals. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BarSelfDualConfBand.qGold_eq_inv_qGoldDual","@type":"LeanDeclaration","name":"QOU.Archimedean.BarSelfDualConfBand.qGold_eq_inv_qGoldDual","kind":"theorem","line":135,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/bar-self-dual-confinement-band.lean#L135-L137","doc":"1/φ² is the multiplicative inverse of φ². ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BarSelfDualConfBand.qGoldDual_eq_inv_qGold","@type":"LeanDeclaration","name":"QOU.Archimedean.BarSelfDualConfBand.qGoldDual_eq_inv_qGold","kind":"theorem","line":128,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/bar-self-dual-confinement-band.lean#L128-L133","doc":"φ² is the multiplicative inverse of 1/φ². ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BarSelfDualConfBand.one_mem_confBand","@type":"LeanDeclaration","name":"QOU.Archimedean.BarSelfDualConfBand.one_mem_confBand","kind":"theorem","line":123,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/bar-self-dual-confinement-band.lean#L123-L126","doc":"The band ℬ is non-empty: 1 ∈ ℬ. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BarSelfDualConfBand.qGold_lt_qGoldDual","@type":"LeanDeclaration","name":"QOU.Archimedean.BarSelfDualConfBand.qGold_lt_qGoldDual","kind":"theorem","line":119,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/bar-self-dual-confinement-band.lean#L119-L121","doc":"1/φ² < φ². ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BarSelfDualConfBand.one_lt_qGoldDual","@type":"LeanDeclaration","name":"QOU.Archimedean.BarSelfDualConfBand.one_lt_qGoldDual","kind":"theorem","line":112,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/bar-self-dual-confinement-band.lean#L112-L117","doc":"1 < φ². ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BarSelfDualConfBand.qGold_lt_one","@type":"LeanDeclaration","name":"QOU.Archimedean.BarSelfDualConfBand.qGold_lt_one","kind":"theorem","line":105,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/bar-self-dual-confinement-band.lean#L105-L110","doc":"1/φ² < 1. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BarSelfDualConfBand.qGoldDual_pos","@type":"LeanDeclaration","name":"QOU.Archimedean.BarSelfDualConfBand.qGoldDual_pos","kind":"theorem","line":99,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/bar-self-dual-confinement-band.lean#L99-L103","doc":"φ² > 0. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BarSelfDualConfBand.qGold_pos","@type":"LeanDeclaration","name":"QOU.Archimedean.BarSelfDualConfBand.qGold_pos","kind":"theorem","line":93,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/bar-self-dual-confinement-band.lean#L93-L97","doc":"1/φ² > 0. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BarSelfDualConfBand.qGold_mul_qGoldDual","@type":"LeanDeclaration","name":"QOU.Archimedean.BarSelfDualConfBand.qGold_mul_qGoldDual","kind":"theorem","line":87,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/bar-self-dual-confinement-band.lean#L87-L91","doc":"q_gold · q* = 1. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BarSelfDualConfBand.phi_mul_phiInv","@type":"LeanDeclaration","name":"QOU.Archimedean.BarSelfDualConfBand.phi_mul_phiInv","kind":"theorem","line":81,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/bar-self-dual-confinement-band.lean#L81-L85","doc":"φ · (1/φ) = 1. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BarSelfDualConfBand.phi_pos","@type":"LeanDeclaration","name":"QOU.Archimedean.BarSelfDualConfBand.phi_pos","kind":"theorem","line":76,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/bar-self-dual-confinement-band.lean#L76-L79","doc":"φ > 0. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BarSelfDualConfBand.phiInv_pos","@type":"LeanDeclaration","name":"QOU.Archimedean.BarSelfDualConfBand.phiInv_pos","kind":"theorem","line":71,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/bar-self-dual-confinement-band.lean#L71-L74","doc":"1/φ > 0. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BarSelfDualConfBand.phiInv_lt_one","@type":"LeanDeclaration","name":"QOU.Archimedean.BarSelfDualConfBand.phiInv_lt_one","kind":"theorem","line":66,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/bar-self-dual-confinement-band.lean#L66-L69","doc":"1/φ < 1. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BarSelfDualConfBand.phi_gt_one","@type":"LeanDeclaration","name":"QOU.Archimedean.BarSelfDualConfBand.phi_gt_one","kind":"theorem","line":61,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/bar-self-dual-confinement-band.lean#L61-L64","doc":"φ > 1. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BarSelfDualConfBand.confBand","@type":"LeanDeclaration","name":"QOU.Archimedean.BarSelfDualConfBand.confBand","kind":"def","line":45,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/bar-self-dual-confinement-band.lean#L45-L46","doc":"The bar-self-dual confinement band ℬ = (1/φ², φ²). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BarSelfDualConfBand.bar","@type":"LeanDeclaration","name":"QOU.Archimedean.BarSelfDualConfBand.bar","kind":"def","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/bar-self-dual-confinement-band.lean#L42-L43","doc":"The bar involution on the positive reals: q ↦ q⁻¹. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BarSelfDualConfBand.qGoldDual","@type":"LeanDeclaration","name":"QOU.Archimedean.BarSelfDualConfBand.qGoldDual","kind":"def","line":39,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/bar-self-dual-confinement-band.lean#L39-L40","doc":"The skew-dual golden node q* = φ². ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BarSelfDualConfBand.qGold","@type":"LeanDeclaration","name":"QOU.Archimedean.BarSelfDualConfBand.qGold","kind":"def","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/bar-self-dual-confinement-band.lean#L36-L37","doc":"The sub-classical golden node q_gold = 1/φ². ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BarSelfDualConfBand.phiInv","@type":"LeanDeclaration","name":"QOU.Archimedean.BarSelfDualConfBand.phiInv","kind":"def","line":33,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/bar-self-dual-confinement-band.lean#L33-L34","doc":"The reciprocal of the golden ratio, 1/φ = (√5 − 1)/2. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.BarSelfDualConfBand.phi","@type":"LeanDeclaration","name":"QOU.Archimedean.BarSelfDualConfBand.phi","kind":"def","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/bar-self-dual-confinement-band.lean#L30-L31","doc":"The golden ratio φ = (1 + √5)/2. ","signatureChunk":0}]}