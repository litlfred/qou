{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:PredictedSpectra.CategoricalProtonExists","@type":"LeanModule","name":"PredictedSpectra.CategoricalProtonExists","imports":["lean:module:Init","lean:module:Mathlib.Data.Real.Basic"],"declarations":7,"chunks":1},{"@id":"lean:QOU.CategoricalProton.exists","@type":"LeanDeclaration","name":"QOU.CategoricalProton.exists","kind":"theorem","line":33,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/categorical-proton-exists.lean#L33-L45","doc":"**Existence of the categorical proton.**\n\nThe Borromean braid B₃(u,u,d) + LP-optimal Hopf gluon L_- yields\na canonical `CategoricalProton` term with negative crossing\nenergy and Frobenius stability. ","formalizes":[{"@id":"block:prop:categorical-proton-exists","label":"prop:categorical-proton-exists","md":"quantum-observable-universe/predicted-spectra/categorical-proton-exists.md"}],"signatureChunk":0},{"@id":"lean:QOU.CategoricalProton.chirality","@type":"LeanDeclaration","name":"QOU.CategoricalProton.chirality","kind":"def","line":31,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/categorical-proton-exists.lean#L31-L31","doc":"Positive crossing chirality (electric charge `+1`). ","signatureChunk":0},{"@id":"lean:QOU.CategoricalProton.mass","@type":"LeanDeclaration","name":"QOU.CategoricalProton.mass","kind":"def","line":29,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/categorical-proton-exists.lean#L29-L29","doc":"Mass `= S_uu + 2·S_ud`. ","signatureChunk":0},{"@id":"lean:QOU.CategoricalProton.skein_ud","@type":"LeanDeclaration","name":"QOU.CategoricalProton.skein_ud","kind":"def","line":27,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/categorical-proton-exists.lean#L27-L27","doc":"Pair Skein mass `S_ud`. ","signatureChunk":0},{"@id":"lean:QOU.CategoricalProton.skein_uu","@type":"LeanDeclaration","name":"QOU.CategoricalProton.skein_uu","kind":"def","line":25,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/categorical-proton-exists.lean#L25-L25","doc":"Pair Skein mass `S_uu`. ","signatureChunk":0},{"@id":"lean:QOU.CategoricalProton.mk","@type":"LeanDeclaration","name":"QOU.CategoricalProton.mk","kind":"ctor","line":23,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/categorical-proton-exists.lean#L23-L23","signatureChunk":0},{"@id":"lean:QOU.CategoricalProton","@type":"LeanDeclaration","name":"QOU.CategoricalProton","kind":"structure","line":19,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/categorical-proton-exists.lean#L19-L31","doc":"Defining data of the categorical proton (mirror of\n[`def:categorical-proton`], shared with `categorical-proton-unique.lean`):\nthe colour-linked triple `[u, u, d]_c` is determined by its pair-Skein\nmasses `(S_uu, S_ud)`, with derived mass `S_uu + 2·S_ud` and chirality `+1`. ","signatureChunk":0}]}