{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Knot.SincDeriv","@type":"LeanModule","name":"QOU.Knot.SincDeriv","imports":["lean:module:Init","lean:module:Mathlib.Analysis.SpecialFunctions.Trigonometric.Bounds","lean:module:Mathlib.Analysis.SpecialFunctions.Trigonometric.Sinc","lean:module:Mathlib.Analysis.SpecialFunctions.Trigonometric.Deriv"],"declarations":4,"chunks":1},{"@id":"lean:QOU.Knot.differentiable_sinc","@type":"LeanDeclaration","name":"QOU.Knot.differentiable_sinc","kind":"theorem","line":94,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/SincDeriv.lean#L94-L99","doc":"**`sinc` is differentiable everywhere.** ","signatureChunk":0},{"@id":"lean:QOU.Knot.hasDerivAt_sinc_zero","@type":"LeanDeclaration","name":"QOU.Knot.hasDerivAt_sinc_zero","kind":"theorem","line":53,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/SincDeriv.lean#L53-L92","doc":"**`sinc` is differentiable at the removable point, with derivative `0`.**\nThe slope is `(sin y − y)/y²`, which `Real.sin_bound` squeezes to `0`. ","signatureChunk":0},{"@id":"lean:QOU.Knot.hasDerivAt_sinc","@type":"LeanDeclaration","name":"QOU.Knot.hasDerivAt_sinc","kind":"theorem","line":41,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/SincDeriv.lean#L41-L51","doc":"**`sinc` is differentiable away from `0`**, with the quotient-rule\nderivative `(x·cos x − sin x)/x²`. ","signatureChunk":0},{"@id":"lean:QOU.Knot.sinc_eventuallyEq","@type":"LeanDeclaration","name":"QOU.Knot.sinc_eventuallyEq","kind":"theorem","line":35,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Knot/SincDeriv.lean#L35-L39","doc":"Off the origin, `sinc` agrees with `sin x / x` on a neighbourhood. ","signatureChunk":0}]}