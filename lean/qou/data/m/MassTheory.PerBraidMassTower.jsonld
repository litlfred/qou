{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:MassTheory.PerBraidMassTower","@type":"LeanModule","name":"MassTheory.PerBraidMassTower","imports":["lean:module:Init","lean:module:Mathlib.Data.Real.Basic","lean:module:Mathlib.Algebra.BigOperators.Group.Finset.Basic"],"declarations":17,"chunks":1},{"@id":"lean:QOU.BraidKnot.perBraidMassTower","@type":"LeanDeclaration","name":"QOU.BraidKnot.perBraidMassTower","kind":"theorem","line":84,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/per-braid-mass-tower.lean#L84-L93","doc":"Headline statement: mass factors per the per-braid tower. ","formalizes":[{"@id":"block:prop:per-braid-mass-tower","label":"prop:per-braid-mass-tower","md":"quantum-observable-universe/mass-theory/per-braid-mass-tower.md"}],"signatureChunk":0},{"@id":"lean:QOU.BraidKnot.PerBraidMassTower.mass_factorisation","@type":"LeanDeclaration","name":"QOU.BraidKnot.PerBraidMassTower.mass_factorisation","kind":"theorem","line":73,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/per-braid-mass-tower.lean#L73-L73","doc":"The per-braid factorisation. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.PerBraidMassTower.mass","@type":"LeanDeclaration","name":"QOU.BraidKnot.PerBraidMassTower.mass","kind":"def","line":71,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/per-braid-mass-tower.lean#L71-L71","doc":"The mass functional. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.PerBraidMassTower.strat","@type":"LeanDeclaration","name":"QOU.BraidKnot.PerBraidMassTower.strat","kind":"def","line":69,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/per-braid-mass-tower.lean#L69-L69","doc":"The JSJ stratification of `W`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.PerBraidMassTower.product","@type":"LeanDeclaration","name":"QOU.BraidKnot.PerBraidMassTower.product","kind":"def","line":67,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/per-braid-mass-tower.lean#L67-L67","doc":"Sub-braid product (concatenation). ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.PerBraidMassTower.mark_z","@type":"LeanDeclaration","name":"QOU.BraidKnot.PerBraidMassTower.mark_z","kind":"def","line":65,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/per-braid-mass-tower.lean#L65-L65","doc":"Markov weight `z = 1/(q^{1/2} + q^{-1/2})`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.PerBraidMassTower.phiQ","@type":"LeanDeclaration","name":"QOU.BraidKnot.PerBraidMassTower.phiQ","kind":"def","line":63,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/per-braid-mass-tower.lean#L63-L63","doc":"Quantum dilogarithm Φ_q at the substrate parameter. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.PerBraidMassTower.trM","@type":"LeanDeclaration","name":"QOU.BraidKnot.PerBraidMassTower.trM","kind":"def","line":61,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/per-braid-mass-tower.lean#L61-L61","doc":"Markov trace of a sub-braid as a real value. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.PerBraidMassTower.mk","@type":"LeanDeclaration","name":"QOU.BraidKnot.PerBraidMassTower.mk","kind":"ctor","line":59,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/per-braid-mass-tower.lean#L59-L59","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.PerBraidMassTower","@type":"LeanDeclaration","name":"QOU.BraidKnot.PerBraidMassTower","kind":"class","line":47,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/per-braid-mass-tower.lean#L47-L82","doc":"The per-braid mass-tower discipline.\n\nAn instance asserts that the mass functional `mass` factors\nalong the JSJ stratification:\n\n  mass W = |trM W| + Σ_{ξ ∈ S_1} Φ_q (|trM ξ|)\n                   + z^2 · Σ_{(ξ,ξ') ∈ S_2} Φ_q (|trM (ξ * ξ')|)\n\nThe class is left abstract (`trM`, `phiQ`, `mark_z` are supplied\nby an instance); its purpose is to record the *per-braid*\ndiscipline that supersedes the per-generator\n`prop:mass-endomorphism-tower`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.JSJStratification.level_zero","@type":"LeanDeclaration","name":"QOU.BraidKnot.JSJStratification.level_zero","kind":"theorem","line":44,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/per-braid-mass-tower.lean#L44-L44","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.JSJStratification.level","@type":"LeanDeclaration","name":"QOU.BraidKnot.JSJStratification.level","kind":"def","line":43,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/per-braid-mass-tower.lean#L43-L43","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.JSJStratification.mk","@type":"LeanDeclaration","name":"QOU.BraidKnot.JSJStratification.mk","kind":"ctor","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/per-braid-mass-tower.lean#L42-L42","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.JSJStratification","@type":"LeanDeclaration","name":"QOU.BraidKnot.JSJStratification","kind":"structure","line":39,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/per-braid-mass-tower.lean#L39-L44","doc":"An algebraic-JSJ stratification of a braid `W` into sub-braids\nindexed by depth `ℓ`. `level 0 = {W}`, `level 1 = per-nucleon`,\n`level 2 = per-nucleon-pair`, etc. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.Braid.carrier","@type":"LeanDeclaration","name":"QOU.BraidKnot.Braid.carrier","kind":"def","line":37,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/per-braid-mass-tower.lean#L37-L37","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.Braid.mk","@type":"LeanDeclaration","name":"QOU.BraidKnot.Braid.mk","kind":"ctor","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/per-braid-mass-tower.lean#L36-L36","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.Braid","@type":"LeanDeclaration","name":"QOU.BraidKnot.Braid","kind":"structure","line":34,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/per-braid-mass-tower.lean#L34-L37","doc":"An abstract braid (placeholder; actual realisation is via the\nHecke algebra `H_n(q)`). ","signatureChunk":0}]}