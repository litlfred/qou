niverse/lean/QOU/Machinery/CoxeterCommutingTransversal.lean#L52-L54","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.cellElem2","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.cellElem2","kind":"def","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterCommutingTransversal.lean#L49-L50","doc":"The four cell elements. ","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.cellWord2","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.cellWord2","kind":"def","line":45,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterCommutingTransversal.lean#L45-L47","doc":"The four cell words of the `{i, j}` parabolic (`M i j = 2`), ordered\nto match the merged `descentC2σi` tables: `e, sᵢ, sⱼ, sᵢsⱼ`. ","signatureChunk":0}]}