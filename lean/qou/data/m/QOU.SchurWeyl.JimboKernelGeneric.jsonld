d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/JimboKernelGeneric.lean#L122-L128","doc":"`ρ(q − σ_i) = tlRep(e_i)`. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.JimboKernelGeneric.tlE","@type":"LeanDeclaration","name":"QOU.SchurWeyl.JimboKernelGeneric.tlE","kind":"def","line":118,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/JimboKernelGeneric.lean#L118-L120","doc":"The Temperley–Lieb element `q − σ_i` of the Hecke algebra. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.JimboKernelGeneric.proj_eq_of_jimbo_eq","@type":"LeanDeclaration","name":"QOU.SchurWeyl.JimboKernelGeneric.proj_eq_of_jimbo_eq","kind":"theorem","line":111,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/JimboKernelGeneric.lean#L111-L116","doc":"**Relations that hold after the Jimbo action hold in `H/rad`.** ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.JimboKernelGeneric.proj_eq_zero_iff","@type":"LeanDeclaration","name":"QOU.SchurWeyl.JimboKernelGeneric.proj_eq_zero_iff","kind":"theorem","line":106,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/JimboKernelGeneric.lean#L106-L109","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.JimboKernelGeneric.proj","@type":"LeanDeclaration","name":"QOU.SchurWeyl.JimboKernelGeneric.proj","kind":"def","line":101,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/JimboKernelGeneric.lean#L101-L104","doc":"The quotient map `H → H/rad`. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.JimboKernelGeneric.Quot","@type":"LeanDeclaration","name":"QOU.SchurWeyl.JimboKernelGeneric.Quot","kind":"def","line":97,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9