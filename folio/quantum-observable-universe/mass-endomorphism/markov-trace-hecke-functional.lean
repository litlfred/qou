import MassEndomorphism.MarkovTraceRecursiveReducer
import QOU.MathlibExt.HeckeTowerWitness
import Mathlib.Algebra.MonoidAlgebra.Basic
import QOU.Hecke.IwahoriHecke
import QOU.BraidKnot.KnotFactorFrobeniusPairing

/-!
# The Markov trace as a linear functional on the Hecke tower, and the connected-sum rule

`prop:markov-trace-recursive-reducer` proves that the word evaluator `trWord z h` is a
Markov trace on **positive braid words** (`trWord_isMarkovTrace`, Ocneanu existence) and
that it is the only one (`markovTrace_unique`).  This file moves it from words to the
algebra: it is a linear functional on the presented infinite Iwahori–Hecke tower
`HeckeTower R h` (generators `σ_m`, `σ_m² = h σ_m + 1`, braid, far commutation).

## What is proved

* `towerTr z h : HeckeTower R h →ₗ[R] R`, with `towerTr (σ_{l₁} ⋯ σ_{l_k}) = trWord z h _ l`.
* `towerTr_one`, `towerTr_mul_comm` — normalised and cyclic.
* `towerTr_markov` — for `x ∈ H_n` (the subalgebra generated by `σ_0, …, σ_{n-1}`),
  `tr(x · σ_n) = z · tr x`.
* `towerTr_disjoint` — **no crossing between the clusters**: for `x ∈ H_m` and any `y`,
  `tr(x · y↑ᵐ) = tr x · tr y`, where `y↑ᵐ` shifts every generator up by `m`
  (the two clusters share strand `m`).
* `towerTr_connectedSum` — **the connected-sum rule**: for `x ∈ H_m` and any `y`,
  `tr(x · σ_m · y↑ᵐ⁺¹) = z · tr x · tr y`.
* `towerTr_interface` — for a one-crossing interface letter `a + b σ_m`,
  `tr(x · (a + b σ_m) · y↑ᵐ⁺¹) = (a + b z) · tr x · tr y`.  The factor does not depend
  on `x` or `y`: any bond made of a single crossing is pair-independent.

## On `H_n(q)`

The finite type `QOU.Hecke.IwahoriHecke K q n` uses `σ² = (q-1)σ + q`.  With `s² = q` and
`s h = q - 1` (for a unit `s`, `h = s - s⁻¹`), `σ_i ↦ s σ_i` is an algebra map into the
tower (`toTower`), so

* `heckeMarkovTrace s h z : IwahoriHecke K q n →ₗ[K] K` is a normalised trace with
  `tr(σ_i) = s z`;
* `markovKnotFactor` / `markov_trace_eq_tau_mul_knotFactor` — the Markov instance of
  `QOU.Hecke.KnotFactor`: for `q ≠ 0` and any splitting, `tr_M x = τ(x κ)` with `κ`
  central.

On the finite algebras: `heckeIncl : H_m(q) →ₐ H_n(q)` and `heckeShift k`, compatible with
the tower (`toTower_heckeIncl`, `toTower_heckeShift`), so the trace is coherent along
inclusions (`heckeMarkovTrace_heckeIncl`), and the connected-sum rule holds there,
`tr_n(x · σ_m · y↑ᵐ⁺¹) = s z · tr_m x · tr_p y` (`heckeMarkovTrace_connectedSum`).

Generic over `[CommRing R]` with `z h : R` (§7c).

Ref: [jones1987] https://doi.org/10.2307/1971403 — the Markov trace (statement only;
everything here is proved).
-/

namespace QOU.BraidKnot.HeckeFunctional

open QOU.BraidKnot QOU.MathlibExt.HeckeTowerWitness

/-! ## Words over `ℕ` -/

/-- A word over `ℕ`, as the `ℤ`-word `trWord` reads. -/
def zw (w : List ℕ) : List ℤ := w.map (fun a => (a : ℤ))

@[simp] theorem zw_cons (a : ℕ) (u : List ℕ) : zw (a :: u) = (a : ℤ) :: zw u := rfl

@[simp] theorem zw_append (u v : List ℕ) : zw (u ++ v) = zw u ++ zw v := by
  induction u with
  | nil => rfl
  | cons a u ih => simp only [List.cons_append, zw_cons, ih]

theorem zw_map_add (u : List ℕ) (m : ℕ) :
    zw (u.map (· + m)) = (zw u).map (· + (m : ℤ)) := by
  induction u with
  | nil => rfl
  | cons a u ih => simp only [List.map_cons, zw_cons, ih, Nat.cast_add]

@[simp] theorem zw_nil : zw [] = [] := rfl

theorem supp_zw {n : ℕ} {w : List ℕ} (hw : ∀ a ∈ w, a < n) : Supp n (zw w) := by
  induction w with
  | nil => intro c hc; exact absurd hc List.not_mem_nil
  | cons a w ih =>
    intro c hc
    rw [zw_cons, List.mem_cons] at hc
    rcases hc with rfl | hc
    · have := hw a (by simp); constructor <;> omega
    · exact ih (fun b hb => hw b (List.mem_cons_of_mem _ hb)) c hc

theorem lt_sum_succ {w : List ℕ} {a : ℕ} (ha : a ∈ w) : a < w.sum + 1 :=
  Nat.lt_succ_of_le (List.le_sum_of_mem ha)

section Words

variable {R : Type*} [CommRing R] (z h : R)

theorem trWord_add {N : ℕ} {w : List ℤ} (hw : Supp N w) :
    ∀ d, trWord z h (N + d) w = trWord z h N w
  | 0 => rfl
  | d + 1 => by
    rw [← Nat.add_assoc, trWord_stable z h _ w (hw.mono (Nat.le_add_right N d)),
      trWord_add hw d]

theorem trWord_congr {N M : ℕ} {w : List ℤ} (hN : Supp N w) (hM : Supp M w) :
    trWord z h N w = trWord z h M w := by
  rcases le_total N M with hle | hle
  · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hle
    exact (trWord_add z h hN d).symm
  · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hle
    exact trWord_add z h hM d

/-- **The trace of a word**, read at any level that contains its letters. -/
def G (w : List ℕ) : R := trWord z h (w.sum + 1) (zw w)

theorem G_eq {N : ℕ} {w : List ℕ} (hw : ∀ a ∈ w, a < N) : G z h w = trWord z h N (zw w) :=
  trWord_congr z h (supp_zw fun _ ha => lt_sum_succ ha) (supp_zw hw)

@[simp] theorem G_nil : G z h [] = 1 := trWord_nil z h _

theorem G_hecke (u v : List ℕ) (m : ℕ) :
    G z h (u ++ [m, m] ++ v) = h * G z h (u ++ [m] ++ v) + G z h (u ++ v) := by
  set N := (u ++ [m] ++ v).sum + 1
  have hm : ∀ a ∈ u ++ [m] ++ v, a < N := fun _ ha => lt_sum_succ ha
  rw [G_eq z h (w := u ++ [m, m] ++ v) (N := N) (fun a ha => hm a (by simp at ha ⊢; tauto)),
    G_eq z h hm, G_eq z h (w := u ++ v) (N := N) (fun a ha => hm a (by simp at ha ⊢; tauto))]
  have := trWord_hecke z h N (zw u) (zw v) (m : ℤ) (by simpa using supp_zw hm)
  simpa [zw] using this

theorem G_braid (u v : List ℕ) (m : ℕ) :
    G z h (u ++ [m + 1, m, m + 1] ++ v) = G z h (u ++ [m, m + 1, m] ++ v) := by
  set N := (u ++ [m, m + 1] ++ v).sum + 1
  have hm : ∀ a ∈ u ++ [m, m + 1] ++ v, a < N := fun _ ha => lt_sum_succ ha
  rw [G_eq z h (w := u ++ [m + 1, m, m + 1] ++ v) (N := N)
      (fun a ha => hm a (by simp at ha ⊢; tauto)),
    G_eq z h (w := u ++ [m, m + 1, m] ++ v) (N := N)
      (fun a ha => hm a (by simp at ha ⊢; tauto))]
  have := trWord_braid z h N (zw u) (zw v) (m : ℤ) (by simpa [zw] using supp_zw hm)
  simpa [zw] using this.symm

theorem G_far (u v : List ℕ) (m k : ℕ) (hk : k + 1 < m) :
    G z h (u ++ [m, k] ++ v) = G z h (u ++ [k, m] ++ v) := by
  set N := (u ++ [m, k] ++ v).sum + 1
  have hm : ∀ a ∈ u ++ [m, k] ++ v, a < N := fun _ ha => lt_sum_succ ha
  rw [G_eq z h hm, G_eq z h (w := u ++ [k, m] ++ v) (N := N)
      (fun a ha => hm a (by simp at ha ⊢; tauto))]
  have hd : (2 : ℤ) ≤ |(m : ℤ) - (k : ℤ)| := le_abs.mpr (Or.inl (by omega))
  have := trWord_far_comm z h N (zw u) (zw v) (m : ℤ) (k : ℤ) hd (by simpa [zw] using supp_zw hm)
  simpa [zw] using this

theorem G_cyclic (u v : List ℕ) : G z h (u ++ v) = G z h (v ++ u) := by
  set N := (u ++ v).sum + 1
  have hm : ∀ a ∈ u ++ v, a < N := fun _ ha => lt_sum_succ ha
  rw [G_eq z h hm, G_eq z h (w := v ++ u) (N := N) (fun a ha => hm a (by simp at ha ⊢; tauto))]
  have := trWord_cyclic z h N (zw u) (zw v)
    (supp_zw fun a ha => hm a (by simp [ha])) (supp_zw fun a ha => hm a (by simp [ha]))
  simpa using this

theorem G_strip {n : ℕ} {w : List ℕ} (hw : ∀ a ∈ w, a < n) :
    G z h (w ++ [n]) = z * G z h w := by
  rw [G_eq z h (N := n + 1) (w := w ++ [n])
      (fun a ha => by simp at ha; rcases ha with ha | rfl <;> [exact Nat.lt_succ_of_lt (hw a ha); omega]),
    G_eq z h hw]
  have := trWord_strip z h n (zw w) (supp_zw hw)
  simpa [zw] using this

/-- **The disjoint-product law on words**: clusters sharing strand `m`, no crossing. -/
theorem G_disjoint {m : ℕ} {α : List ℕ} (hα : ∀ a ∈ α, a < m) (β : List ℕ) :
    G z h (α ++ β.map (· + m)) = G z h α * G z h β := by
  rcases m with _ | k
  · have : α = [] := List.eq_nil_iff_forall_not_mem.mpr fun a ha => by have := hα a ha; omega
    subst this
    simp
  · set M := β.sum + 1
    have hβ : ∀ b ∈ β, b < M := fun _ hb => lt_sum_succ hb
    have key := markovTrace_disjointProduct (trWord_isMarkovTrace z h) k M (zw α) (zw β)
      (supp_zw hα) (supp_zw hβ)
    rw [G_eq z h (N := k + 1 + M) (w := α ++ β.map (· + (k + 1))), G_eq z h hα, G_eq z h hβ]
    · rw [zw_append, zw_map_add]
      simpa [Function.comp_def, add_comm, add_left_comm, add_assoc] using key
    · intro a ha
      simp only [List.mem_append, List.mem_map] at ha
      rcases ha with ha | ⟨b, hb, rfl⟩
      · have := hα a ha; omega
      · have := hβ b hb; omega

end Words

/-! ## The functional on the free algebra -/

section Free

variable {R : Type*} [CommRing R] (z h : R)

local notation "MA" => MonoidAlgebra R (FreeMonoid ℕ)

/-- The word trace, extended linearly to the monoid algebra of words. -/
noncomputable def phiM : MA →ₗ[R] R :=
  Finsupp.lsum R fun w => G z h (FreeMonoid.toList w) • LinearMap.id

theorem phiM_of (w : FreeMonoid ℕ) :
    phiM z h (MonoidAlgebra.of R (FreeMonoid ℕ) w) = G z h (FreeMonoid.toList w) := by
  rw [phiM, MonoidAlgebra.of_apply]
  erw [Finsupp.lsum_single]
  simp

/-- Equality in every two-sided word context extends to every two-sided context. -/
theorem phiM_ctx {a b : MA}
    (H : ∀ u v : FreeMonoid ℕ,
      phiM z h (MonoidAlgebra.of R _ u * a * MonoidAlgebra.of R _ v)
        = phiM z h (MonoidAlgebra.of R _ u * b * MonoidAlgebra.of R _ v))
    (x y : MA) : phiM z h (x * a * y) = phiM z h (x * b * y) := by
  induction x using MonoidAlgebra.induction_on with
  | hM u =>
    induction y using MonoidAlgebra.induction_on with
    | hM v => exact H u v
    | hadd y₁ y₂ h₁ h₂ => rw [mul_add, mul_add, map_add, map_add, h₁, h₂]
    | hsmul r y hy => rw [mul_smul_comm, mul_smul_comm, map_smul, map_smul, hy]
  | hadd x₁ x₂ h₁ h₂ => rw [add_mul, add_mul, add_mul, add_mul, map_add, map_add, h₁, h₂]
  | hsmul r x hx => rw [smul_mul_assoc, smul_mul_assoc, smul_mul_assoc, smul_mul_assoc,
      map_smul, map_smul, hx]

theorem phiM_cyclic (x y : MA) : phiM z h (x * y) = phiM z h (y * x) := by
  induction x using MonoidAlgebra.induction_on with
  | hM u =>
    induction y using MonoidAlgebra.induction_on with
    | hM v =>
      rw [← map_mul, ← map_mul, phiM_of, phiM_of, FreeMonoid.toList_mul, FreeMonoid.toList_mul,
        G_cyclic]
    | hadd y₁ y₂ h₁ h₂ => rw [mul_add, add_mul, map_add, map_add, h₁, h₂]
    | hsmul r y hy => rw [mul_smul_comm, smul_mul_assoc, map_smul, map_smul, hy]
  | hadd x₁ x₂ h₁ h₂ => rw [add_mul, mul_add, map_add, map_add, h₁, h₂]
  | hsmul r x hx => rw [smul_mul_assoc, mul_smul_comm, map_smul, map_smul, hx]

/-- The equivalence of the free algebra with the monoid algebra of words. -/
noncomputable abbrev eqv : FreeAlgebra R ℕ ≃ₐ[R] MA := FreeAlgebra.equivMonoidAlgebraFreeMonoid

theorem eqv_fgen (m : ℕ) : eqv (fgen R m) = MonoidAlgebra.of R _ (FreeMonoid.of m) := by
  simp [eqv, fgen, FreeAlgebra.equivMonoidAlgebraFreeMonoid]

/-- The word trace on the free algebra. -/
noncomputable def phiF : FreeAlgebra R ℕ →ₗ[R] R := (phiM z h).comp eqv.toLinearMap

theorem phiF_apply (a : FreeAlgebra R ℕ) : phiF z h a = phiM z h (eqv a) := rfl

/-- `of u * of w * of v` as a single word. -/
theorem of_mul_of_mul_of (u w v : FreeMonoid ℕ) :
    MonoidAlgebra.of R (FreeMonoid ℕ) u * MonoidAlgebra.of R _ w * MonoidAlgebra.of R _ v
      = MonoidAlgebra.of R _ (u * w * v) := by
  rw [map_mul, map_mul]

/-- **The defining relations of the tower are killed in every context.** -/
theorem rel_ctx {a b : FreeAlgebra R ℕ} (hab : RingQuot.Rel (QOU.MathlibExt.HeckeTowerWitness.HeckeRel h) a b) :
    ∀ x y, phiF z h (x * a * y) = phiF z h (x * b * y) := by
  induction hab with
  | of hr =>
    intro x y
    simp only [phiF_apply, map_mul]
    apply phiM_ctx
    intro u v
    cases hr with
    | quad m =>
      simp only [map_mul, map_add, map_smul, map_one, eqv_fgen]
      rw [mul_add, add_mul, mul_smul_comm, smul_mul_assoc, mul_one, map_add, map_smul,
        ← mul_assoc, of_mul_of_mul_of, of_mul_of_mul_of, ← map_mul, phiM_of, phiM_of]
      rw [← map_mul, phiM_of]
      have := G_hecke z h (FreeMonoid.toList u) (FreeMonoid.toList v) m
      simpa [FreeMonoid.toList_mul, smul_eq_mul, List.append_assoc] using this
    | braid m =>
      simp only [map_mul, eqv_fgen]
      rw [← mul_assoc, ← mul_assoc, ← mul_assoc, ← mul_assoc, ← map_mul, ← map_mul, ← map_mul,
        ← map_mul, ← map_mul, ← map_mul, ← map_mul, ← map_mul, phiM_of, phiM_of]
      have := G_braid z h (FreeMonoid.toList u) (FreeMonoid.toList v) m
      simpa [FreeMonoid.toList_mul, List.append_assoc] using this
    | far m k hk =>
      simp only [map_mul, eqv_fgen]
      rw [← mul_assoc, ← mul_assoc, ← map_mul, ← map_mul, ← map_mul, ← map_mul, ← map_mul,
        ← map_mul, phiM_of, phiM_of]
      have := G_far z h (FreeMonoid.toList u) (FreeMonoid.toList v) m k hk
      simpa [FreeMonoid.toList_mul, List.append_assoc] using this
  | add_left _ ih =>
    intro x y
    rw [mul_add, add_mul, mul_add, add_mul, map_add, map_add, ih x y]
  | @mul_left a b c _ ih =>
    intro x y
    have e1 : x * (a * c) * y = x * a * (c * y) := by simp only [mul_assoc]
    have e2 : x * (b * c) * y = x * b * (c * y) := by simp only [mul_assoc]
    rw [e1, e2, ih x (c * y)]
  | @mul_right a b c _ ih =>
    intro x y
    have e1 : x * (a * b) * y = x * a * b * y := by simp only [mul_assoc]
    have e2 : x * (a * c) * y = x * a * c * y := by simp only [mul_assoc]
    rw [e1, e2, ih (x * a) y]

end Free

/-! ## The functional on the tower -/

section Tower

variable {R : Type*} [CommRing R] (z h : R)

/-- The underlying function of the tower trace. -/
noncomputable def towerTrFun (X : HeckeTower R h) : R :=
  Quot.lift (phiF z h) (fun a b hab => by simpa using rel_ctx z h hab 1 1) X.toQuot

theorem towerTrFun_mk (a : FreeAlgebra R ℕ) :
    towerTrFun z h (RingQuot.mkAlgHom R (QOU.MathlibExt.HeckeTowerWitness.HeckeRel h) a) = phiF z h a := by
  simp [towerTrFun, RingQuot.mkAlgHom_def, RingQuot.mkRingHom_def]

/-- **The Markov trace as a linear functional on the Hecke tower.** -/
noncomputable def towerTr : HeckeTower R h →ₗ[R] R where
  toFun := towerTrFun z h
  map_add' X Y := by
    obtain ⟨a, rfl⟩ := RingQuot.mkAlgHom_surjective R (QOU.MathlibExt.HeckeTowerWitness.HeckeRel h) X
    obtain ⟨b, rfl⟩ := RingQuot.mkAlgHom_surjective R (QOU.MathlibExt.HeckeTowerWitness.HeckeRel h) Y
    rw [← map_add, towerTrFun_mk, towerTrFun_mk, towerTrFun_mk, map_add]
  map_smul' r X := by
    obtain ⟨a, rfl⟩ := RingQuot.mkAlgHom_surjective R (QOU.MathlibExt.HeckeTowerWitness.HeckeRel h) X
    rw [← map_smul, towerTrFun_mk, towerTrFun_mk, map_smul, RingHom.id_apply]

theorem towerTr_mk (a : FreeAlgebra R ℕ) :
    towerTr z h (RingQuot.mkAlgHom R (QOU.MathlibExt.HeckeTowerWitness.HeckeRel h) a) = phiF z h a :=
  towerTrFun_mk z h a

/-- **The trace property.** -/
theorem towerTr_mul_comm (X Y : HeckeTower R h) :
    towerTr z h (X * Y) = towerTr z h (Y * X) := by
  obtain ⟨a, rfl⟩ := RingQuot.mkAlgHom_surjective R (QOU.MathlibExt.HeckeTowerWitness.HeckeRel h) X
  obtain ⟨b, rfl⟩ := RingQuot.mkAlgHom_surjective R (QOU.MathlibExt.HeckeTowerWitness.HeckeRel h) Y
  rw [← map_mul, ← map_mul, towerTr_mk, towerTr_mk, phiF_apply, phiF_apply, map_mul (eqv (R := R)) a b, map_mul (eqv (R := R)) b a,
    phiM_cyclic]

/-- A word in the tower generators. -/
noncomputable def twWord (l : List ℕ) : HeckeTower R h := (l.map (twGen h)).prod

theorem twWord_append (l l' : List ℕ) :
    twWord (R := R) h (l ++ l') = twWord h l * twWord h l' := by
  simp [twWord, List.prod_append]

theorem twWord_eq_mk (l : List ℕ) :
    twWord (R := R) h l
      = RingQuot.mkAlgHom R (QOU.MathlibExt.HeckeTowerWitness.HeckeRel h) ((l.map (fgen R)).prod) := by
  induction l with
  | nil => simp [twWord]
  | cons a l ih => simp [twWord, twGen] at ih ⊢; rw [ih]

theorem eqv_prod_fgen (l : List ℕ) :
    eqv (R := R) ((l.map (fgen R)).prod) = MonoidAlgebra.of R _ (FreeMonoid.ofList l) := by
  induction l with
  | nil => simp [FreeMonoid.ofList_nil]; rfl
  | cons a l ih =>
    rw [List.map_cons, List.prod_cons, map_mul, ih, eqv_fgen, ← map_mul, FreeMonoid.ofList_cons]

@[simp] theorem towerTr_twWord (l : List ℕ) : towerTr z h (twWord h l) = G z h l := by
  rw [twWord_eq_mk, towerTr_mk, phiF_apply, eqv_prod_fgen, phiM_of, FreeMonoid.toList_ofList]

theorem towerTr_one : towerTr z h (1 : HeckeTower R h) = 1 := by
  have : (1 : HeckeTower R h) = twWord h [] := by simp [twWord]
  rw [this, towerTr_twWord, G_nil]

/-- Words with letters below `n` span a submodule. -/
def wordSpan (n : ℕ) : Submodule R (HeckeTower R h) :=
  Submodule.span R (twWord h '' {l | ∀ a ∈ l, a < n})

/-- All words span a submodule. -/
def allWords : Submodule R (HeckeTower R h) := Submodule.span R (Set.range (twWord h))

/-- A submodule containing `1` and closed under right multiplication by `S` contains
    `Algebra.adjoin R S` (`QOU.Hecke.mem_of_mem_adjoin_of_mul_mem`, restated to keep the
    import cone small). -/
theorem mem_of_adjoin {A : Type*} [Ring A] [Algebra R A] {S : Set A} (W : Submodule R A)
    (h1 : (1 : A) ∈ W) (hS : ∀ x ∈ W, ∀ s ∈ S, x * s ∈ W) {y : A}
    (hy : y ∈ Algebra.adjoin R S) : y ∈ W := by
  let M : Subalgebra R A :=
    { carrier := {y | ∀ x ∈ W, x * y ∈ W}
      mul_mem' := fun {a b} ha hb x hx => by rw [← mul_assoc]; exact hb _ (ha x hx)
      one_mem' := fun x hx => by rwa [mul_one]
      add_mem' := fun {a b} ha hb x hx => by rw [mul_add]; exact W.add_mem (ha x hx) (hb x hx)
      zero_mem' := fun x _ => by rw [mul_zero]; exact W.zero_mem
      algebraMap_mem' := fun r x hx => by
        rw [← Algebra.commutes, ← Algebra.smul_def]; exact W.smul_mem r hx }
  have hle : Algebra.adjoin R S ≤ M := Algebra.adjoin_le fun s hs x hx => hS x hx s hs
  simpa using hle hy 1 h1

theorem twH_le_wordSpan (n : ℕ) {X : HeckeTower R h} (hX : X ∈ twH h n) :
    X ∈ wordSpan h n := by
  refine mem_of_adjoin (wordSpan h n) ?_ ?_ hX
  · exact Submodule.subset_span ⟨[], by simp, by simp [twWord]⟩
  · rintro x hx s ⟨m, hm, rfl⟩
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨l, hl, rfl⟩ := hx
      refine Submodule.subset_span ⟨l ++ [m], ?_, ?_⟩
      · intro a ha; simp at ha; rcases ha with ha | rfl; exact hl a ha; exact hm
      · simp [twWord_append, twWord]
    | zero => simp
    | add x y _ _ hx hy => rw [add_mul]; exact Submodule.add_mem _ hx hy
    | smul r x _ hx => rw [smul_mul_assoc]; exact Submodule.smul_mem _ r hx

theorem allWords_mul_mem {X Y : HeckeTower R h} (hX : X ∈ allWords h) (hY : Y ∈ allWords h) :
    X * Y ∈ allWords h := by
  induction hX using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨l, rfl⟩ := hx
    induction hY using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨l', rfl⟩ := hy
      exact Submodule.subset_span ⟨l ++ l', twWord_append h l l'⟩
    | zero => simp
    | add a b _ _ ha hb => rw [mul_add]; exact Submodule.add_mem _ ha hb
    | smul r a _ ha => rw [mul_smul_comm]; exact Submodule.smul_mem _ r ha
  | zero => simp
  | add a b _ _ ha hb => rw [add_mul]; exact Submodule.add_mem _ ha hb
  | smul r a _ ha => rw [smul_mul_assoc]; exact Submodule.smul_mem _ r ha

theorem mem_allWords (X : HeckeTower R h) : X ∈ allWords h := by
  obtain ⟨a, rfl⟩ := RingQuot.mkAlgHom_surjective R (QOU.MathlibExt.HeckeTowerWitness.HeckeRel h) X
  induction a using FreeAlgebra.induction with
  | grade0 r =>
    rw [AlgHom.commutes, Algebra.algebraMap_eq_smul_one]
    exact Submodule.smul_mem _ r (Submodule.subset_span ⟨[], by simp [twWord]⟩)
  | grade1 x =>
    exact Submodule.subset_span ⟨[x], by simp [twWord, twGen, fgen]⟩
  | mul a b ha hb => rw [map_mul]; exact allWords_mul_mem h ha hb
  | add a b ha hb => rw [map_add]; exact Submodule.add_mem _ ha hb

/-- **Markov stabilisation** on the algebra: `tr(x · σ_n) = z · tr x` for `x ∈ H_n`. -/
theorem towerTr_markov (n : ℕ) {X : HeckeTower R h} (hX : X ∈ twH h n) :
    towerTr z h (X * twGen h n) = z * towerTr z h X := by
  have hW := twH_le_wordSpan h n hX
  clear hX
  induction hW using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨l, hl, rfl⟩ := hx
    have : twWord h l * twGen h n = twWord h (l ++ [n]) := by simp [twWord_append, twWord]
    rw [this, towerTr_twWord, towerTr_twWord, G_strip z h hl]
  | zero => simp
  | add x y _ _ hx hy => rw [add_mul, map_add, map_add, hx, hy, mul_add]
  | smul r x _ hx => rw [smul_mul_assoc, map_smul, map_smul, hx, smul_eq_mul, smul_eq_mul]; ring

/-! ## Shifting a cluster up the tower -/

/-- **The shift** `σ_i ↦ σ_{i+k}`, an algebra endomorphism of the tower. -/
noncomputable def shift (k : ℕ) : HeckeTower R h →ₐ[R] HeckeTower R h :=
  RingQuot.liftAlgHom R ⟨FreeAlgebra.lift R (fun i => twGen h (i + k)), by
    intro x y hxy
    cases hxy with
    | quad m => simp [fgen, twGen_quad]
    | braid m =>
      simp only [fgen, map_mul, FreeAlgebra.lift_ι_apply]
      have := twGen_braid h (m + k)
      rwa [show m + 1 + k = m + k + 1 by omega]
    | far m j hj =>
      simp only [fgen, map_mul, FreeAlgebra.lift_ι_apply]
      exact twGen_far h (m + k) (j + k) (by omega)⟩

theorem shift_twGen (k m : ℕ) : shift h k (twGen h m) = twGen h (m + k) := by
  simp [shift, twGen, RingQuot.liftAlgHom_mkAlgHom_apply, fgen]

theorem shift_twWord (k : ℕ) (l : List ℕ) :
    shift h k (twWord (R := R) h l) = twWord h (l.map (· + k)) := by
  induction l with
  | nil => simp [twWord]
  | cons a l ih =>
    simp only [twWord, List.map_cons, List.prod_cons, map_mul] at ih ⊢
    rw [ih, shift_twGen]

/-! ## The disjoint rule and the connected-sum rule -/

/-- **Clusters sharing one strand, no crossing between them**:
    `tr(x · y↑ᵐ) = tr x · tr y` for `x ∈ H_m`. -/
theorem towerTr_disjoint (m : ℕ) {X : HeckeTower R h} (hX : X ∈ twH h m)
    (Y : HeckeTower R h) :
    towerTr z h (X * shift h m Y) = towerTr z h X * towerTr z h Y := by
  have hW := twH_le_wordSpan h m hX
  clear hX
  induction hW using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨l, hl, rfl⟩ := hx
    have hY := mem_allWords h Y
    induction hY using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨l', rfl⟩ := hy
      rw [shift_twWord, ← twWord_append, towerTr_twWord, towerTr_twWord, towerTr_twWord,
        G_disjoint z h hl]
    | zero => simp
    | add a b _ _ ha hb => rw [map_add, mul_add, map_add, map_add, ha, hb, mul_add]
    | smul r a _ ha =>
      rw [map_smul, mul_smul_comm, map_smul, map_smul, ha, smul_eq_mul, smul_eq_mul]
      ring
  | zero => simp
  | add a b _ _ ha hb => rw [add_mul, map_add, map_add, ha, hb, add_mul]
  | smul r a _ ha => rw [smul_mul_assoc, map_smul, map_smul, ha, smul_eq_mul, smul_eq_mul]; ring

/-- **Shift invariance**: raising every generator index by `m` does not change the trace.
    This is the hypothesis the split form of the product law needs. -/
theorem towerTr_shift (m : ℕ) (Y : HeckeTower R h) :
    towerTr z h (shift h m Y) = towerTr z h Y := by
  have := towerTr_disjoint z h m (Subalgebra.one_mem (twH h m)) Y
  rwa [one_mul, towerTr_one, one_mul] at this

/-- **The split product law**: clusters on disjoint strands, separated by the unused
    generator `σ_m`, `tr(x · y↑ᵐ⁺¹) = tr x · tr y` for `x ∈ H_m`. -/
theorem towerTr_split (m : ℕ) {X : HeckeTower R h} (hX : X ∈ twH h m) (Y : HeckeTower R h) :
    towerTr z h (X * shift h (m + 1) Y) = towerTr z h X * towerTr z h Y := by
  have hX1 : X ∈ twH h (m + 1) := twH_mono h (Nat.le_succ m) hX
  exact towerTr_disjoint z h (m + 1) hX1 Y

/-- **The connected-sum rule**: one crossing `σ_m` joining a cluster on `σ_0, …, σ_{m-1}`
    to a cluster shifted above it, `tr(x · σ_m · y↑ᵐ⁺¹) = z · tr x · tr y`. -/
theorem towerTr_connectedSum (m : ℕ) {X : HeckeTower R h} (hX : X ∈ twH h m)
    (Y : HeckeTower R h) :
    towerTr z h (X * twGen h m * shift h (m + 1) Y) = z * towerTr z h X * towerTr z h Y := by
  have hXg : X * twGen h m ∈ twH h (m + 1) :=
    Subalgebra.mul_mem _ (twH_mono h (Nat.le_succ m) hX) (twGen_mem h m)
  rw [towerTr_disjoint z h (m + 1) hXg Y, towerTr_markov z h m hX]

/-- **A one-crossing interface is pair-independent**:
    `tr(x · (a + b σ_m) · y↑ᵐ⁺¹) = (a + b z) · tr x · tr y`. -/
theorem towerTr_interface (m : ℕ) {X : HeckeTower R h} (hX : X ∈ twH h m)
    (Y : HeckeTower R h) (a b : R) :
    towerTr z h (X * (a • 1 + b • twGen h m) * shift h (m + 1) Y)
      = (a + b * z) * towerTr z h X * towerTr z h Y := by
  have hX1 : X ∈ twH h (m + 1) := twH_mono h (Nat.le_succ m) hX
  rw [mul_add, add_mul, map_add, mul_smul_comm, mul_one, smul_mul_assoc, map_smul,
    mul_smul_comm, smul_mul_assoc, map_smul, towerTr_connectedSum z h m hX Y,
    towerTr_disjoint z h (m + 1) hX1 Y, smul_eq_mul, smul_eq_mul]
  ring

end Tower

/-! ## Carrying the trace to `QOU.Hecke.IwahoriHecke K q n` -/

section Iwahori

variable {K : Type*} [CommRing K] {q : K} {n : ℕ}

/-- **The rescaling map** `σ_i ↦ s · σ_i` from `H_n(q)` (`σ² = (q-1)σ + q`) to the tower
    (`σ² = hσ + 1`).  It is an algebra map when `s² = q` and `s h = q - 1`
    (for a unit `s`, this is `h = s - s⁻¹`). -/
noncomputable def toTower (s h : K) (hs : s * s = q) (hh : s * h = q - 1) :
    QOU.Hecke.IwahoriHecke K q n →ₐ[K] HeckeTower K h :=
  RingQuot.liftAlgHom K ⟨FreeAlgebra.lift K (fun i : Fin n => s • twGen h (i : ℕ)), by
    intro x y hxy
    cases hxy with
    | quadratic i =>
      simp only [map_mul, map_add, map_smul, map_one, FreeAlgebra.lift_ι_apply]
      have e : (q - 1) * s = s * s * h := by rw [← hh]; ring
      rw [smul_mul_smul_comm, twGen_quad, smul_add, smul_smul, smul_smul, e, hs]
    | braid i hi =>
      simp only [map_mul, FreeAlgebra.lift_ι_apply]
      simp only [smul_mul_smul_comm]
      congr 1
      exact (twGen_braid h (i : ℕ)).symm
    | commute i j hij =>
      simp only [map_mul, FreeAlgebra.lift_ι_apply, smul_mul_smul_comm]
      congr 1
      exact twGen_far h (i : ℕ) (j : ℕ) (by omega)⟩

theorem toTower_σ (s h : K) (hs : s * s = q) (hh : s * h = q - 1) (i : Fin n) :
    toTower s h hs hh (QOU.Hecke.IwahoriHecke.σ K q n i) = s • twGen h (i : ℕ) := by
  simp only [toTower, QOU.Hecke.IwahoriHecke.σ, QOU.Hecke.IwahoriHecke.mk]
  erw [RingQuot.liftAlgHom_mkAlgHom_apply]
  simp

/-- **The Markov trace on `H_n(q)`, as a linear functional.** -/
noncomputable def heckeMarkovTrace (s h z : K) (hs : s * s = q) (hh : s * h = q - 1) :
    QOU.Hecke.IwahoriHecke K q n →ₗ[K] K :=
  (towerTr z h).comp (toTower s h hs hh).toLinearMap

theorem heckeMarkovTrace_apply (s h z : K) (hs : s * s = q) (hh : s * h = q - 1)
    (x : QOU.Hecke.IwahoriHecke K q n) :
    heckeMarkovTrace s h z hs hh x = towerTr z h (toTower s h hs hh x) := rfl

/-- It is a trace. -/
theorem heckeMarkovTrace_mul_comm (s h z : K) (hs : s * s = q) (hh : s * h = q - 1)
    (x y : QOU.Hecke.IwahoriHecke K q n) :
    heckeMarkovTrace s h z hs hh (x * y) = heckeMarkovTrace s h z hs hh (y * x) := by
  simp only [heckeMarkovTrace_apply, map_mul, towerTr_mul_comm]

theorem heckeMarkovTrace_one (s h z : K) (hs : s * s = q) (hh : s * h = q - 1) :
    heckeMarkovTrace s h z hs hh (1 : QOU.Hecke.IwahoriHecke K q n) = 1 := by
  rw [heckeMarkovTrace_apply, map_one, towerTr_one]

/-- On one generator: `tr(σ_i) = s z`. -/
theorem heckeMarkovTrace_σ (s h z : K) (hs : s * s = q) (hh : s * h = q - 1) (i : Fin n) :
    heckeMarkovTrace s h z hs hh (QOU.Hecke.IwahoriHecke.σ K q n i) = s * z := by
  rw [heckeMarkovTrace_apply, toTower_σ, map_smul, smul_eq_mul]
  have : twGen h (i : ℕ) = twWord (R := K) h [(i : ℕ)] := by simp [twWord]
  rw [this, towerTr_twWord]
  congr 1
  have h1 := G_strip z h (n := (i : ℕ)) (w := []) (by simp)
  simpa using h1

end Iwahori

/-! ## The Markov knot factor -/

section KnotFactor

open QOU.Hecke.KnotFactor

variable {K : Type*} [Field K] {q : K} {n : ℕ}
variable {ι : Type*} [Fintype ι] [DecidableEq ι]
variable {J : ι → Type*} [∀ i, Fintype (J i)] [∀ i, DecidableEq (J i)]

/-- **The Markov instance of the braid-level knot-factor identity**: for every `q ≠ 0`
    and every splitting `E`, the Markov trace is the `τ`-pairing with its central knot
    factor, `tr_M x = τ(x κ)`. -/
noncomputable def markovKnotFactor (hq : q ≠ 0)
    (E : QOU.Hecke.IwahoriHecke K q n ≃ₐ[K] ∀ i, Matrix (J i) (J i) K) (a : ∀ i, J i)
    (s h z : K) (hs : s * s = q) (hh : s * h = q - 1) :
    QOU.BraidKnot.KnotFactorFrobeniusPairing K (QOU.Hecke.IwahoriHecke K q n) :=
  QOU.BraidKnot.ofHecke hq E a (heckeMarkovTrace s h z hs hh)
    (heckeMarkovTrace_mul_comm s h z hs hh)

theorem markov_trace_eq_tau_mul_knotFactor (hq : q ≠ 0)
    (E : QOU.Hecke.IwahoriHecke K q n ≃ₐ[K] ∀ i, Matrix (J i) (J i) K) (a : ∀ i, J i)
    (s h z : K) (hs : s * s = q) (hh : s * h = q - 1) (x : QOU.Hecke.IwahoriHecke K q n) :
    heckeMarkovTrace s h z hs hh x
      = QOU.Hecke.TwBasis.tau K q n
          (x * knotFactor E (heckeMarkovTrace s h z hs hh) (QOU.Hecke.TwBasis.tau K q n) a) :=
  QOU.Hecke.KnotFactor.hecke_trace_eq_tau_mul_knotFactor hq E a _
    (heckeMarkovTrace_mul_comm s h z hs hh) x

end KnotFactor

/-! ## Inclusions and shifts of the finite algebras -/

open QOU.Hecke
open QOU.BraidKnot QOU.MathlibExt.HeckeTowerWitness QOU.Hecke

section Incl

variable {K : Type*} [CommRing K] {q : K}

/-- Algebra maps out of `H_m(q)` agree when they agree on the generators. -/
theorem iwahori_hom_ext {m : ℕ} {A : Type*} [Semiring A] [Algebra K A]
    {f g : IwahoriHecke K q m →ₐ[K] A}
    (H : ∀ i, f (IwahoriHecke.σ K q m i) = g (IwahoriHecke.σ K q m i)) : f = g := by
  apply RingQuot.ringQuot_ext' K (s := QOU.Hecke.HeckeRel K q m)
  apply FreeAlgebra.hom_ext
  funext i
  exact H i

/-- An algebra map out of `H_m(q)` from images of the generators satisfying the relations. -/
noncomputable def iwahoriLift {m : ℕ} {A : Type*} [Ring A] [Algebra K A] (g : Fin m → A)
    (hq : ∀ i, g i * g i = (q - 1) • g i + q • 1)
    (hb : ∀ (i : Fin m) (hi : (i : ℕ) + 1 < m),
      g i * g ⟨(i : ℕ) + 1, hi⟩ * g i = g ⟨(i : ℕ) + 1, hi⟩ * g i * g ⟨(i : ℕ) + 1, hi⟩)
    (hc : ∀ i j : Fin m, (j : ℕ) + 2 ≤ (i : ℕ) → g i * g j = g j * g i) :
    IwahoriHecke K q m →ₐ[K] A :=
  RingQuot.liftAlgHom K ⟨FreeAlgebra.lift K g, by
    intro x y hxy
    cases hxy with
    | quadratic i =>
      simp only [map_mul, map_add, map_smul, map_one, FreeAlgebra.lift_ι_apply]
      exact hq i
    | braid i hi =>
      simp only [map_mul, FreeAlgebra.lift_ι_apply]
      exact hb i hi
    | commute i j hij =>
      simp only [map_mul, FreeAlgebra.lift_ι_apply]
      exact hc i j hij⟩

theorem iwahoriLift_σ {m : ℕ} {A : Type*} [Ring A] [Algebra K A] (g : Fin m → A)
    (hq hb hc) (i : Fin m) :
    iwahoriLift (q := q) g hq hb hc (IwahoriHecke.σ K q m i) = g i := by
  simp only [iwahoriLift, IwahoriHecke.σ, IwahoriHecke.mk]
  erw [RingQuot.liftAlgHom_mkAlgHom_apply]
  simp

/-- The generator of `H_n(q)` with index `a < n`. -/
noncomputable abbrev gN (n a : ℕ) (ha : a < n) : IwahoriHecke K q n :=
  IwahoriHecke.σ K q n ⟨a, ha⟩

/-- Relations for a family `i ↦ σ_{i+k}` of generators of `H_n(q)`. -/
theorem shifted_rels {m n : ℕ} (k : ℕ) (hkn : m + k ≤ n) :
    (∀ i : Fin m, gN (q := q) n (i + k) (by omega) * gN n (i + k) (by omega)
        = (q - 1) • gN n (i + k) (by omega) + q • 1) ∧
    (∀ (i : Fin m) (hi : (i : ℕ) + 1 < m),
        gN (q := q) n (i + k) (by omega) * gN n ((i + 1) + k) (by omega) * gN n (i + k) (by omega)
          = gN n ((i + 1) + k) (by omega) * gN n (i + k) (by omega)
              * gN n ((i + 1) + k) (by omega)) ∧
    (∀ i j : Fin m, (j : ℕ) + 2 ≤ (i : ℕ) →
        gN (q := q) n (i + k) (by omega) * gN n (j + k) (by omega)
          = gN n (j + k) (by omega) * gN n (i + k) (by omega)) := by
  refine ⟨fun i => IwahoriHecke.σ_quadratic K q n _, fun i hi => ?_, fun i j hij => ?_⟩
  · have := IwahoriHecke.σ_braid K q n ⟨(i : ℕ) + k, by omega⟩ (show (i : ℕ) + k + 1 < n by omega)
    have e : (⟨(i : ℕ) + k + 1, by omega⟩ : Fin n) = ⟨(i : ℕ) + 1 + k, by omega⟩ :=
      Fin.ext (show (i : ℕ) + k + 1 = (i : ℕ) + 1 + k by omega)
    simpa [gN, e] using this
  · exact IwahoriHecke.σ_commute K q n ⟨(i : ℕ) + k, by omega⟩ ⟨(j : ℕ) + k, by omega⟩
      (show (j : ℕ) + k + 2 ≤ (i : ℕ) + k by omega)

/-- **The shift** `H_m(q) → H_n(q)`, `σ_i ↦ σ_{i+k}`, for `m + k ≤ n`. -/
noncomputable def heckeShift {m n : ℕ} (k : ℕ) (hkn : m + k ≤ n) :
    IwahoriHecke K q m →ₐ[K] IwahoriHecke K q n :=
  iwahoriLift (fun i : Fin m => gN (q := q) n (i + k) (by omega))
    (shifted_rels k hkn).1 (shifted_rels k hkn).2.1 (shifted_rels k hkn).2.2

theorem heckeShift_σ {m n : ℕ} (k : ℕ) (hkn : m + k ≤ n) (i : Fin m) :
    heckeShift (q := q) k hkn (IwahoriHecke.σ K q m i)
      = IwahoriHecke.σ K q n ⟨(i : ℕ) + k, by omega⟩ :=
  iwahoriLift_σ _ _ _ _ i

/-- **The inclusion** `H_m(q) → H_n(q)`, `σ_i ↦ σ_i`, for `m ≤ n`. -/
noncomputable def heckeIncl {m n : ℕ} (hmn : m ≤ n) :
    IwahoriHecke K q m →ₐ[K] IwahoriHecke K q n :=
  heckeShift 0 (by omega)

theorem heckeIncl_σ {m n : ℕ} (hmn : m ≤ n) (i : Fin m) :
    heckeIncl (q := q) hmn (IwahoriHecke.σ K q m i)
      = IwahoriHecke.σ K q n (Fin.castLE hmn i) := by
  rw [heckeIncl, heckeShift_σ]
  rfl

/-! ## Compatibility with the rescaling map into the tower -/

variable (s h z : K) (hs : s * s = q) (hh : s * h = q - 1)

theorem toTower_heckeShift {m n : ℕ} (k : ℕ) (hkn : m + k ≤ n) :
    (toTower (n := n) s h hs hh).comp (heckeShift k hkn)
      = (shift h k).comp (toTower (n := m) s h hs hh) := by
  apply iwahori_hom_ext
  intro i
  simp only [AlgHom.comp_apply, heckeShift_σ, toTower_σ, map_smul, shift_twGen]

theorem toTower_heckeIncl {m n : ℕ} (hmn : m ≤ n) :
    (toTower (n := n) s h hs hh).comp (heckeIncl hmn) = toTower (n := m) s h hs hh := by
  apply iwahori_hom_ext
  intro i
  simp only [AlgHom.comp_apply, heckeIncl_σ, toTower_σ, Fin.coe_castLE]

theorem toTower_heckeIncl_apply {m n : ℕ} (hmn : m ≤ n) (x : IwahoriHecke K q m) :
    toTower (n := n) s h hs hh (heckeIncl hmn x) = toTower s h hs hh x :=
  congrArg (fun f => f x) (toTower_heckeIncl s h hs hh hmn)

theorem toTower_heckeShift_apply {m n : ℕ} (k : ℕ) (hkn : m + k ≤ n)
    (x : IwahoriHecke K q m) :
    toTower (n := n) s h hs hh (heckeShift k hkn x) = shift h k (toTower s h hs hh x) :=
  congrArg (fun f => f x) (toTower_heckeShift s h hs hh k hkn)

/-- **The Markov tower is coherent**: the trace on `H_n` restricts to the trace on `H_m`. -/
theorem heckeMarkovTrace_heckeIncl {m n : ℕ} (hmn : m ≤ n) (x : IwahoriHecke K q m) :
    heckeMarkovTrace (n := n) s h z hs hh (heckeIncl hmn x) = heckeMarkovTrace s h z hs hh x := by
  rw [heckeMarkovTrace_apply, heckeMarkovTrace_apply, toTower_heckeIncl_apply]

/-- The image of `H_m(q)` lies in the tower's `H_m`. -/
theorem toTower_mem_twH {m : ℕ} (x : IwahoriHecke K q m) :
    toTower s h hs hh x ∈ twH h m := by
  obtain ⟨a, rfl⟩ := RingQuot.mkAlgHom_surjective K (QOU.Hecke.HeckeRel K q m) x
  induction a using FreeAlgebra.induction with
  | grade0 r =>
    erw [AlgHom.commutes, AlgHom.commutes]
    exact Subalgebra.algebraMap_mem _ r
  | grade1 i =>
    have : RingQuot.mkAlgHom K (QOU.Hecke.HeckeRel K q m) (FreeAlgebra.ι K i)
        = IwahoriHecke.σ K q m i := rfl
    rw [this, toTower_σ]
    have hi : twGen h (i : ℕ) ∈ twH h m :=
      Algebra.subset_adjoin (Set.mem_image_of_mem (twGen h) (show (i : ℕ) ∈ {a | a < m} from i.isLt))
    exact Subalgebra.smul_mem _ hi s
  | mul a b ha hb => rw [map_mul, map_mul]; exact Subalgebra.mul_mem _ ha hb
  | add a b ha hb => rw [map_add, map_add]; exact Subalgebra.add_mem _ ha hb

/-! ## The disjoint and connected-sum rules on the finite algebras -/

/-- **No crossing between the clusters** (they share strand `m`):
    `tr_n(x · y↑ᵐ) = tr_m x · tr_p y` for `m + p ≤ n`. -/
theorem heckeMarkovTrace_disjoint {m p n : ℕ} (hmn : m ≤ n) (hpn : p + m ≤ n)
    (x : IwahoriHecke K q m) (y : IwahoriHecke K q p) :
    heckeMarkovTrace (n := n) s h z hs hh (heckeIncl hmn x * heckeShift m hpn y)
      = heckeMarkovTrace s h z hs hh x * heckeMarkovTrace s h z hs hh y := by
  rw [heckeMarkovTrace_apply, map_mul (toTower s h hs hh), toTower_heckeIncl_apply,
    toTower_heckeShift_apply, towerTr_disjoint z h m (toTower_mem_twH s h hs hh x), heckeMarkovTrace_apply,
    heckeMarkovTrace_apply]

/-- **The connected-sum rule on `H_n(q)`**: one crossing `σ_m` joining a cluster in `H_m` to
    a cluster in `H_p` shifted above it, `tr_n(x · σ_m · y↑ᵐ⁺¹) = s z · tr_m x · tr_p y`. -/
theorem heckeMarkovTrace_connectedSum {m p n : ℕ} (hmn : m ≤ n) (hm : m < n)
    (hpn : p + (m + 1) ≤ n) (x : IwahoriHecke K q m) (y : IwahoriHecke K q p) :
    heckeMarkovTrace (n := n) s h z hs hh
        (heckeIncl hmn x * IwahoriHecke.σ K q n ⟨m, hm⟩ * heckeShift (m + 1) hpn y)
      = s * z * heckeMarkovTrace s h z hs hh x * heckeMarkovTrace s h z hs hh y := by
  rw [heckeMarkovTrace_apply, map_mul (toTower s h hs hh), map_mul (toTower s h hs hh),
    toTower_heckeIncl_apply,
    toTower_heckeShift_apply, toTower_σ, mul_smul_comm, smul_mul_assoc, map_smul,
    towerTr_connectedSum z h m (toTower_mem_twH s h hs hh x), heckeMarkovTrace_apply,
    heckeMarkovTrace_apply, smul_eq_mul]
  ring

end Incl


/-! ## Interface words between two clusters: the block-form rule and the overlapping γγ bond

`MarkovTraceHeckeFunctional` proves the disjoint rule `towerTr_disjoint` and the
one-crossing interface rule `towerTr_interface`. This file treats a bond made of a
**word**, in two layouts.

## Strand bookkeeping

The tower generator `σ_i` crosses strands `i` and `i+1`. A cluster `x ∈ H_m`
(generators `σ_0, …, σ_{m-1}`) lives on strands `0, …, m`. `shift h m B` with
`B ∈ H_k` uses generators `σ_m, …, σ_{m+k-1}`, i.e. strands `m, …, m+k`.

* **Block form** (`towerTr_interfaceWord`): `x · B↑ᵐ · Y↑ᵐ⁺ᵏ`. The bond shares strand
  `m` with `x` and strand `m+k` with `Y`, but **no generator** with either. Then
  `tr = tr x · tr B · tr Y`: the bond contributes the pair-independent factor `tr B`.
* **Overlapping form** (`towerTr_overlapBond`), the corpus layout: the γγ bond
  `G³ = (σ₂σ₃⁻¹)³` of `QOU.Mass.GammaGammaH6Interface.interfaceBond 3` sits between
  `p(0,1)` (generators `σ₀, σ₁`) and `p(3,4)` (generators `σ₃, σ₄`); its letter `σ₃`
  **is a generator of the second cluster**. This is `x · B↑ᵐ · Y↑ᵐ⁺¹` with `m = 2`,
  `B = (σ₀σ₁⁻¹)³ ∈ H_2`. Then `tr = tr x · tr(B · Y↑¹)`: the factor
  `tr(B·Y↑¹) / tr Y` depends on the second cluster `Y` and not on the first `x`.
  No pair-independence is claimed for this layout.
* `towerTr_overlapBond_appended` is the same statement with the bond appended after the
  free word, `tr(x · Y↑ᵐ⁺¹ · B↑ᵐ)`, which is the order the probes use (`W_atom = W_free · bond`).

Generic over `[CommRing R]` (§7c). Nothing here reads AME, CODATA, or a census.
-/


section InterfaceWord

open QOU.MathlibExt.HeckeTowerWitness

variable {R : Type*} [CommRing R] (z h : R)

/-! ## The shift on the filtration -/

/-- `shift h m` carries `H_k` into `H_{m+k}`. -/
theorem shift_mem_twH (m k : ℕ) {B : HeckeTower R h} (hB : B ∈ twH h k) :
    shift h m B ∈ twH h (m + k) := by
  have hle : twH h k ≤ (twH h (m + k)).comap (shift h m) := by
    refine Algebra.adjoin_le ?_
    rintro _ ⟨i, hi, rfl⟩
    show shift h m (twGen h i) ∈ twH h (m + k)
    rw [shift_twGen]
    exact Algebra.subset_adjoin ⟨i + m, by simp only [Set.mem_setOf_eq] at hi ⊢; omega, rfl⟩
  exact hle hB

theorem shift_twGenInv (k m : ℕ) : shift h k (twGenInv h m) = twGenInv h (m + k) := by
  simp only [twGenInv, map_sub, map_smul, map_one, shift_twGen]

/-- Shifts compose. -/
theorem shift_shift (a b : ℕ) (Y : HeckeTower R h) :
    shift h a (shift h b Y) = shift h (b + a) Y := by
  have hY := mem_allWords h Y
  induction hY using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨l, rfl⟩ := hy
    rw [shift_twWord, shift_twWord, shift_twWord, List.map_map]
    congr 2
    funext i
    simp only [Function.comp_apply]
    omega
  | zero => simp
  | add u v _ _ hu hv => simp only [map_add, hu, hv]
  | smul r u _ hu => simp only [map_smul, hu]

/-! ## Block form: the bond on its own generators -/

/-- **A bond word on its own block of generators is pair-independent.**
    For `x ∈ H_m` (strands `0..m`), `B ∈ H_k` placed as `B↑ᵐ` (generators `σ_m..σ_{m+k-1}`,
    strands `m..m+k`) and any `Y` placed as `Y↑ᵐ⁺ᵏ` (strands from `m+k` up):
    `tr(x · B↑ᵐ · Y↑ᵐ⁺ᵏ) = tr x · tr B · tr Y`. The bond shares strand `m` with `x` and
    strand `m+k` with `Y`, and no generator with either. -/
theorem towerTr_interfaceWord (m k : ℕ) {X B : HeckeTower R h} (hX : X ∈ twH h m)
    (hB : B ∈ twH h k) (Y : HeckeTower R h) :
    towerTr z h (X * shift h m B * shift h (m + k) Y)
      = towerTr z h X * towerTr z h B * towerTr z h Y := by
  have hXB : X * shift h m B ∈ twH h (m + k) :=
    Subalgebra.mul_mem _ (twH_mono h (Nat.le_add_right m k) hX) (shift_mem_twH h m k hB)
  rw [towerTr_disjoint z h (m + k) hXB Y, towerTr_disjoint z h m hX B]

/-- The vertex cube `V³ = (σ₀ σ₁⁻¹)³`. -/
noncomputable def vertexCube : HeckeTower R h :=
  (twGen h 0 * twGenInv h 1) * (twGen h 0 * twGenInv h 1) * (twGen h 0 * twGenInv h 1)

theorem vertexCube_mem : vertexCube h ∈ twH h 2 := by
  have h0 : twGen h 0 ∈ twH h 2 := twH_mono h (by norm_num) (twGen_mem h 0)
  have h1 : twGenInv h 1 ∈ twH h 2 := twGenInv_mem h 1
  have hv : twGen h 0 * twGenInv h 1 ∈ twH h 2 := Subalgebra.mul_mem _ h0 h1
  exact Subalgebra.mul_mem _ (Subalgebra.mul_mem _ hv hv) hv

theorem shift_vertexCube (m : ℕ) :
    shift h m (vertexCube h)
      = (twGen h m * twGenInv h (m + 1)) * (twGen h m * twGenInv h (m + 1))
          * (twGen h m * twGenInv h (m + 1)) := by
  simp only [vertexCube, map_mul, shift_twGen, shift_twGenInv, Nat.zero_add,
    Nat.add_comm 1 m]

/-- **Block-form γγ bond**: `(σ_m σ_{m+1}⁻¹)³` on strands `m..m+2`, with the second cluster
    starting at strand `m+2`, contributes the pair-independent factor `tr(V³)`. -/
theorem towerTr_vertexCube_block (m : ℕ) {X : HeckeTower R h} (hX : X ∈ twH h m)
    (Y : HeckeTower R h) :
    towerTr z h (X * ((twGen h m * twGenInv h (m + 1)) * (twGen h m * twGenInv h (m + 1))
        * (twGen h m * twGenInv h (m + 1))) * shift h (m + 2) Y)
      = towerTr z h X * towerTr z h (vertexCube h) * towerTr z h Y := by
  rw [← shift_vertexCube, towerTr_interfaceWord z h m 2 hX (vertexCube_mem h) Y]

/-! ## Overlapping form: the corpus γγ bond -/

/-- **A bond sharing a generator with the second cluster.** For `x ∈ H_m`, `B ∈ H_2` placed
    as `B↑ᵐ` (generators `σ_m, σ_{m+1}`) and `Y` placed as `Y↑ᵐ⁺¹` (generators from
    `σ_{m+1}` up — so `σ_{m+1}` is shared by the bond and the second cluster):
    `tr(x · B↑ᵐ · Y↑ᵐ⁺¹) = tr x · tr(B · Y↑¹)`. The first cluster factors out; the bond
    does not factor from the second. -/
theorem towerTr_overlapBond (m : ℕ) {X : HeckeTower R h} (hX : X ∈ twH h m)
    (B Y : HeckeTower R h) :
    towerTr z h (X * shift h m B * shift h (m + 1) Y)
      = towerTr z h X * towerTr z h (B * shift h 1 Y) := by
  have e : shift h m B * shift h (m + 1) Y = shift h m (B * shift h 1 Y) := by
    rw [map_mul, shift_shift, Nat.add_comm 1 m]
  rw [mul_assoc, e, towerTr_disjoint z h m hX]

/-- The free word of the same layout factors: `tr(x · Y↑ᵐ⁺¹) = tr x · tr Y`. -/
theorem towerTr_overlapFree (m : ℕ) {X : HeckeTower R h} (hX : X ∈ twH h m)
    (Y : HeckeTower R h) :
    towerTr z h (X * shift h (m + 1) Y) = towerTr z h X * towerTr z h Y :=
  towerTr_disjoint z h (m + 1) (twH_mono h (Nat.le_succ m) hX) Y

/-! ## Commutation of far-apart clusters, and the appended order -/

theorem twGen_comm_twWord (a : ℕ) (l : List ℕ) (hl : ∀ b ∈ l, a + 1 < b) :
    twGen h a * twWord (R := R) h l = twWord h l * twGen h a := by
  induction l with
  | nil => simp [twWord]
  | cons b l ih =>
    have hb : a + 1 < b := hl b (by simp)
    have ih' := ih (fun c hc => hl c (List.mem_cons_of_mem _ hc))
    have e : twWord (R := R) h (b :: l) = twGen h b * twWord h l := by simp [twWord]
    rw [e, ← mul_assoc, ← twGen_far h b a hb, mul_assoc, ih', ← mul_assoc]

theorem twWord_comm_twWord (l l' : List ℕ) (hll : ∀ a ∈ l, ∀ b ∈ l', a + 1 < b) :
    twWord (R := R) h l * twWord h l' = twWord h l' * twWord h l := by
  induction l with
  | nil => simp [twWord]
  | cons a l ih =>
    have e : twWord (R := R) h (a :: l) = twGen h a * twWord h l := by simp [twWord]
    have ih' := ih (fun c hc => hll c (List.mem_cons_of_mem _ hc))
    rw [e, mul_assoc, ih', ← mul_assoc,
      twGen_comm_twWord h a l' (hll a (by simp)), mul_assoc]

/-- **Far-apart clusters commute**: for `x ∈ H_m`, `x · Y↑ᵐ⁺¹ = Y↑ᵐ⁺¹ · x`. -/
theorem twH_comm_shift (m : ℕ) {X : HeckeTower R h} (hX : X ∈ twH h m)
    (Y : HeckeTower R h) :
    X * shift h (m + 1) Y = shift h (m + 1) Y * X := by
  have hW := twH_le_wordSpan h m hX
  clear hX
  induction hW using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨l, hl, rfl⟩ := hx
    have hY := mem_allWords h Y
    induction hY using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨l', rfl⟩ := hy
      rw [shift_twWord]
      refine twWord_comm_twWord h l _ ?_
      intro a ha b hb
      obtain ⟨c, _, rfl⟩ := List.mem_map.mp hb
      have := hl a ha
      omega
    | zero => simp
    | add u v _ _ hu hv => rw [map_add, mul_add, add_mul, hu, hv]
    | smul r u _ hu => rw [map_smul, mul_smul_comm, smul_mul_assoc, hu]
  | zero => simp
  | add u v _ _ hu hv => rw [add_mul, mul_add, hu, hv]
  | smul r u _ hu => rw [smul_mul_assoc, mul_smul_comm, hu]

/-- **The probe order** `W_atom = W_free · bond`: `tr(x · Y↑ᵐ⁺¹ · B↑ᵐ) = tr x · tr(B · Y↑¹)`. -/
theorem towerTr_overlapBond_appended (m : ℕ) {X : HeckeTower R h} (hX : X ∈ twH h m)
    (B Y : HeckeTower R h) :
    towerTr z h (X * shift h (m + 1) Y * shift h m B)
      = towerTr z h X * towerTr z h (B * shift h 1 Y) := by
  rw [twH_comm_shift h m hX Y, mul_assoc, towerTr_mul_comm,
    towerTr_overlapBond z h m hX B Y]

/-- **The corpus γγ bond `G³ = (σ₂σ₃⁻¹)³` between `x ∈ H_2` (strands `0..2`) and `Y↑³`
    (strands `3..`)**, in the probe order: the first cluster factors out and the bond
    factor `tr(V³ · Y↑¹)` is a function of the second cluster `Y`. -/
theorem towerTr_gammaGammaBond (X : HeckeTower R h) (hX : X ∈ twH h 2) (Y : HeckeTower R h) :
    towerTr z h (X * shift h 3 Y * shift h 2 (vertexCube h))
      = towerTr z h X * towerTr z h (vertexCube h * shift h 1 Y) :=
  towerTr_overlapBond_appended z h 2 hX (vertexCube h) Y

end InterfaceWord

end QOU.BraidKnot.HeckeFunctional


/-!
# Bonds that touch both clusters: no gap letter, or one gap letter, factorise

Setting of the interface-word section of `MarkovTraceHeckeFunctional`: a cluster `x ∈ H_m` (generators `σ_0, …, σ_{m-1}`)
and a second cluster `Y↑ᵐ⁺¹`, with the generator `σ_m` between them. A bond
`A · C↑ᵐ⁺¹` with `A ∈ H_m` enters **both** clusters but does not use `σ_m`. For the
γγ words of the he4 probe (`m = 2`) these are the products of vertices
`σ_iσ_{i+1}⁻¹` with `i ∈ {0, 3}` only; any such word equals `A · C↑³` by far commutation.

* `towerTr_gapBond` — `tr(x · Y↑ · A · C↑) = tr(x A) · tr(Y C)`.
* `towerTr_gapBond_crossRatio` — for two first clusters `x₁, x₂` and two second clusters
  `Y₁, Y₂`, the atom traces satisfy `T₁₁ T₂₂ = T₁₂ T₂₁`. The free traces satisfy the
  same identity (`towerTr_split`), so the bond ratios obey `μ₁₁ μ₂₂ = μ₁₂ μ₂₁`.
* `towerTr_singleGapBond` — a bond `A₁ C₁↑ · (a + b σ_m) · A₂ C₂↑` with **one** gap
  letter: `tr(x · Y↑ · bond) = (a + b z) · tr(x A₁ A₂) · tr(Y C₁ C₂)` (cyclicity, far
  commutation, then the connected-sum rule). `σ_m⁻¹ = σ_m − h` is such a letter.
* `towerTr_singleGapBond_crossRatio` — the same cross-ratio identity for that case.
* `not_both_lt_one_of_crossRatio` — over an ordered field, `μ₁₁ μ₂₂ = μ₁₂ μ₂₁`,
  `μ₁₁ > 1`, `μ₂₂ > 1` and `μ₁₂ ≥ 0` exclude `μ₁₂ < 1 ∧ μ₂₁ < 1`.

So a bond with at most one gap letter cannot give "pn and np bind, pp and nn do not".
A bond with two or more gap letters (that do not cancel) is not covered here; the he4
probe `computations/probes/he4_bond_both_nucleons/` finds the cross-ratio identity
fails for 9 such γγ words of length ≤ 6.

Generic over `[CommRing R]` (§7c); the order lemma is over a linear ordered field.
-/

namespace QOU.BraidKnot.HeckeFunctional

open QOU.MathlibExt.HeckeTowerWitness

variable {R : Type*} [CommRing R] (z h : R)

/-- **A gap-avoiding bond factorises**: for `x, A ∈ H_m`,
    `tr(x · Y↑ᵐ⁺¹ · (A · C↑ᵐ⁺¹)) = tr(x A) · tr(Y C)`. -/
theorem towerTr_gapBond (m : ℕ) {X A : HeckeTower R h} (hX : X ∈ twH h m)
    (hA : A ∈ twH h m) (Y C : HeckeTower R h) :
    towerTr z h (X * shift h (m + 1) Y * (A * shift h (m + 1) C))
      = towerTr z h (X * A) * towerTr z h (Y * C) := by
  have e : X * shift h (m + 1) Y * (A * shift h (m + 1) C)
      = (X * A) * shift h (m + 1) (Y * C) := by
    rw [map_mul, ← mul_assoc, mul_assoc X, ← twH_comm_shift h m hA Y]
    simp only [mul_assoc]
  rw [e, towerTr_split z h m (Subalgebra.mul_mem _ hX hA)]


/-- **A bond crossing the gap exactly once factorises.** For `x, A₁, A₂ ∈ H_m`, any `Y, C₁, C₂`
    and one gap letter `g = a + b σ_m`, the bond `A₁ C₁↑ · g · A₂ C₂↑` gives
    `tr(x · Y↑ · bond) = (a + b z) · tr(x A₁ A₂) · tr(Y C₁ C₂)`. -/
theorem towerTr_singleGapBond (m : ℕ) {X A₁ A₂ : HeckeTower R h} (hX : X ∈ twH h m)
    (hA₁ : A₁ ∈ twH h m) (hA₂ : A₂ ∈ twH h m) (Y C₁ C₂ : HeckeTower R h) (a b : R) :
    towerTr z h (X * shift h (m + 1) Y *
        (A₁ * shift h (m + 1) C₁ * (a • 1 + b • twGen h m) * (A₂ * shift h (m + 1) C₂)))
      = (a + b * z) * towerTr z h (X * A₁ * A₂) * towerTr z h (Y * C₁ * C₂) := by
  have hZ : A₂ * X * A₁ ∈ twH h m :=
    Subalgebra.mul_mem _ (Subalgebra.mul_mem _ hA₂ hX) hA₁
  have c1 := twH_comm_shift h m hX C₂
  have c2 := twH_comm_shift h m hA₁ (C₂ * Y)
  have c3 := twH_comm_shift h m hZ (C₂ * Y * C₁)
  -- cycle the trailing `A₂ C₂↑` to the front, then regroup
  have e : towerTr z h (X * shift h (m + 1) Y *
        (A₁ * shift h (m + 1) C₁ * (a • 1 + b • twGen h m) * (A₂ * shift h (m + 1) C₂)))
      = towerTr z h ((A₂ * X * A₁) * (a • 1 + b • twGen h m)
          * shift h (m + 1) (C₂ * Y * C₁)) := by
    rw [show X * shift h (m + 1) Y *
          (A₁ * shift h (m + 1) C₁ * (a • 1 + b • twGen h m) * (A₂ * shift h (m + 1) C₂))
        = (X * shift h (m + 1) Y * (A₁ * shift h (m + 1) C₁ * (a • 1 + b • twGen h m)))
          * (A₂ * shift h (m + 1) C₂) by simp only [mul_assoc], towerTr_mul_comm]
    have e2 : A₂ * shift h (m + 1) C₂ *
          (X * shift h (m + 1) Y * (A₁ * shift h (m + 1) C₁ * (a • 1 + b • twGen h m)))
        = shift h (m + 1) (C₂ * Y * C₁) * ((A₂ * X * A₁) * (a • 1 + b • twGen h m)) := by
      calc A₂ * shift h (m + 1) C₂ *
            (X * shift h (m + 1) Y * (A₁ * shift h (m + 1) C₁ * (a • 1 + b • twGen h m)))
          = A₂ * (shift h (m + 1) C₂ * X) * shift h (m + 1) Y * A₁ * shift h (m + 1) C₁
              * (a • 1 + b • twGen h m) := by simp only [mul_assoc]
        _ = A₂ * X * (shift h (m + 1) C₂ * shift h (m + 1) Y) * A₁ * shift h (m + 1) C₁
              * (a • 1 + b • twGen h m) := by rw [← c1]; simp only [mul_assoc]
        _ = A₂ * X * (A₁ * shift h (m + 1) (C₂ * Y)) * shift h (m + 1) C₁
              * (a • 1 + b • twGen h m) := by
            rw [← map_mul, c2]; simp only [mul_assoc]
        _ = (A₂ * X * A₁) * shift h (m + 1) (C₂ * Y * C₁) * (a • 1 + b • twGen h m) := by
            rw [map_mul (shift h (m + 1)) (C₂ * Y) C₁]; simp only [mul_assoc]
        _ = shift h (m + 1) (C₂ * Y * C₁) * ((A₂ * X * A₁) * (a • 1 + b • twGen h m)) := by
            rw [c3, mul_assoc]
    rw [e2, towerTr_mul_comm]
  rw [e, towerTr_interface z h m hZ]
  have t1 : towerTr z h (A₂ * X * A₁) = towerTr z h (X * A₁ * A₂) := by
    rw [mul_assoc, towerTr_mul_comm]
  have t2 : towerTr z h (C₂ * Y * C₁) = towerTr z h (Y * C₁ * C₂) := by
    rw [mul_assoc, towerTr_mul_comm]
  rw [t1, t2]

/-- **Cross-ratio for a single-gap-crossing bond**: the atom traces of the four pairs
    `(xᵢ, Yⱼ)` satisfy `T₁₁ T₂₂ = T₁₂ T₂₁`. -/
theorem towerTr_singleGapBond_crossRatio (m : ℕ) {X₁ X₂ A₁ A₂ : HeckeTower R h}
    (h₁ : X₁ ∈ twH h m) (h₂ : X₂ ∈ twH h m) (hA₁ : A₁ ∈ twH h m) (hA₂ : A₂ ∈ twH h m)
    (Y₁ Y₂ C₁ C₂ : HeckeTower R h) (a b : R) :
    let B := A₁ * shift h (m + 1) C₁ * (a • 1 + b • twGen h m) * (A₂ * shift h (m + 1) C₂)
    towerTr z h (X₁ * shift h (m + 1) Y₁ * B) * towerTr z h (X₂ * shift h (m + 1) Y₂ * B)
      = towerTr z h (X₁ * shift h (m + 1) Y₂ * B) * towerTr z h (X₂ * shift h (m + 1) Y₁ * B) := by
  intro B
  simp only [B, towerTr_singleGapBond z h m h₁ hA₁ hA₂, towerTr_singleGapBond z h m h₂ hA₁ hA₂]
  ring

/-- **Cross-ratio of the atom traces** for a gap-avoiding bond. -/
theorem towerTr_gapBond_crossRatio (m : ℕ) {X₁ X₂ A : HeckeTower R h}
    (h₁ : X₁ ∈ twH h m) (h₂ : X₂ ∈ twH h m) (hA : A ∈ twH h m) (Y₁ Y₂ C : HeckeTower R h) :
    towerTr z h (X₁ * shift h (m + 1) Y₁ * (A * shift h (m + 1) C))
      * towerTr z h (X₂ * shift h (m + 1) Y₂ * (A * shift h (m + 1) C))
    = towerTr z h (X₁ * shift h (m + 1) Y₂ * (A * shift h (m + 1) C))
      * towerTr z h (X₂ * shift h (m + 1) Y₁ * (A * shift h (m + 1) C)) := by
  rw [towerTr_gapBond z h m h₁ hA, towerTr_gapBond z h m h₂ hA,
    towerTr_gapBond z h m h₁ hA, towerTr_gapBond z h m h₂ hA]
  ring

/-- **Cross-ratio of the free traces** (no bond). -/
theorem towerTr_free_crossRatio (m : ℕ) {X₁ X₂ : HeckeTower R h}
    (h₁ : X₁ ∈ twH h m) (h₂ : X₂ ∈ twH h m) (Y₁ Y₂ : HeckeTower R h) :
    towerTr z h (X₁ * shift h (m + 1) Y₁) * towerTr z h (X₂ * shift h (m + 1) Y₂)
    = towerTr z h (X₁ * shift h (m + 1) Y₂) * towerTr z h (X₂ * shift h (m + 1) Y₁) := by
  rw [towerTr_split z h m h₁, towerTr_split z h m h₂, towerTr_split z h m h₁,
    towerTr_split z h m h₂]
  ring

/-- **The sign-mixed pattern is excluded by a cross-ratio identity**: if
    `μ₁₁ μ₂₂ = μ₁₂ μ₂₁`, `1 < μ₁₁`, `1 < μ₂₂` and `μ₁₂ ≥ 0`, then not both
    `μ₁₂ < 1` and `μ₂₁ < 1`. -/
theorem not_both_lt_one_of_crossRatio {K : Type*} [Field K] [LinearOrder K]
    [IsStrictOrderedRing K] {a b c d : K} (hx : a * d = b * c) (ha : 1 < a) (hd : 1 < d)
    (hb : 0 ≤ b) : ¬ (b < 1 ∧ c < 1) := by
  rintro ⟨hb1, hc1⟩
  have h1 : 1 < a * d := by nlinarith
  have h2 : b * c < 1 := by nlinarith
  linarith

end QOU.BraidKnot.HeckeFunctional


/-!
# The γγ chain factorises into second-nucleon bond factors

For a chain of nucleon blocks `N₀, N₁, …, N_k ∈ H₂` (each on its own three strands, block
`j` on strands `3j, 3j+1, 3j+2`) joined by the γγ bond `V³ = (σ₀σ₁⁻¹)³` placed on
generators `σ_{3j-1}, σ_{3j}` directly after block `j` (the probe order of
`computations/probes/he4_gg_all_pairs/`), the Markov trace is

  `tr(W_chain) = tr N₀ · ∏_{j ≥ 1} tr(V³ · N_j↑¹)`,

while the free word (no bonds) has `tr(W_free) = ∏_j tr N_j`.  So each bond contributes
the factor `tr(V³ · N↑¹) / tr N` of the nucleon on its right, and nothing else.

What is proved, over a generic `CommRing R` (§7c):

* `towerTr_ggTail`, `towerTr_ggChain` — the chain law for any list of blocks;
* `towerTr_freeTail` — the free word is the product of the block traces;
* `towerTr_he4_ggChain_word`, `towerTr_he4_free_word` — the ⁴He words written out letter
  block by letter block, exactly as the probe assembles them;
* `he4_ggChain_trace_difference` — `tr W_free − tr W_chain` as a closed form in the
  single-nucleon factors.

Every step is the disjoint law `towerTr_disjoint` (two clusters sharing one strand and no
generator) plus cyclicity; no numerical value enters.
-/

namespace QOU.BraidKnot.HeckeFunctional

open QOU.MathlibExt.HeckeTowerWitness

section GammaGammaChain

variable {R : Type*} [CommRing R] (z h : R)

/-- The chain above the first nucleon, read from strand `2` (the first nucleon's last
    strand) upward: each nucleon `N` sits on strands `1..3` as `N↑¹`, its incoming bond
    `V³` on `σ₀ σ₁`, and the rest of the chain three strands higher. -/
noncomputable def ggTail : List (HeckeTower R h) → HeckeTower R h
  | [] => 1
  | N :: Ns => shift h 1 N * vertexCube h * shift h 3 (ggTail Ns)

/-- The γγ chain on the nucleons `N₀ :: Ns`. -/
noncomputable def ggChain (N₀ : HeckeTower R h) (Ns : List (HeckeTower R h)) :
    HeckeTower R h :=
  N₀ * shift h 2 (ggTail h Ns)

/-- The free word: the nucleon blocks side by side, no bond. -/
noncomputable def freeTail : List (HeckeTower R h) → HeckeTower R h
  | [] => 1
  | N :: Ns => N * shift h 3 (freeTail Ns)

/-- The bond factor of the nucleon on the right of a γγ bond, `tr(V³ · N↑¹)`. -/
noncomputable def ggBondFactor (N : HeckeTower R h) : R :=
  towerTr z h (vertexCube h * shift h 1 N)

theorem towerTr_ggTail (Ns : List (HeckeTower R h)) (hNs : ∀ N ∈ Ns, N ∈ twH h 2) :
    towerTr z h (ggTail h Ns) = (Ns.map (ggBondFactor z h)).prod := by
  induction Ns with
  | nil => simp [ggTail, towerTr_one]
  | cons N Ns ih =>
    have hN : N ∈ twH h 2 := hNs N (by simp)
    have hrest : ∀ M ∈ Ns, M ∈ twH h 2 := fun M hM => hNs M (List.mem_cons_of_mem _ hM)
    have h1 : shift h 1 N ∈ twH h 3 := by
      simpa using shift_mem_twH h 1 2 hN
    have h2 : vertexCube h ∈ twH h 3 := twH_mono h (by norm_num) (vertexCube_mem h)
    have hX : shift h 1 N * vertexCube h ∈ twH h 3 := Subalgebra.mul_mem _ h1 h2
    simp only [ggTail, List.map_cons, List.prod_cons]
    rw [towerTr_disjoint z h 3 hX, ih hrest, towerTr_mul_comm, ggBondFactor]

/-- **The γγ chain law**: `tr(W_chain) = tr N₀ · ∏ tr(V³ · N_j↑¹)`. -/
theorem towerTr_ggChain (N₀ : HeckeTower R h) (hN₀ : N₀ ∈ twH h 2)
    (Ns : List (HeckeTower R h)) (hNs : ∀ N ∈ Ns, N ∈ twH h 2) :
    towerTr z h (ggChain h N₀ Ns) = towerTr z h N₀ * (Ns.map (ggBondFactor z h)).prod := by
  rw [ggChain, towerTr_disjoint z h 2 hN₀, towerTr_ggTail z h Ns hNs]

/-- **The free word is the product of the block traces.** -/
theorem towerTr_freeTail (Ns : List (HeckeTower R h)) (hNs : ∀ N ∈ Ns, N ∈ twH h 2) :
    towerTr z h (freeTail h Ns) = (Ns.map (towerTr z h)).prod := by
  induction Ns with
  | nil => simp [freeTail, towerTr_one]
  | cons N Ns ih =>
    have hN : N ∈ twH h 2 := hNs N (by simp)
    have hrest : ∀ M ∈ Ns, M ∈ twH h 2 := fun M hM => hNs M (List.mem_cons_of_mem _ hM)
    simp only [freeTail, List.map_cons, List.prod_cons]
    rw [towerTr_disjoint z h 3 (twH_mono h (by norm_num) hN), ih hrest]

/-! ## ⁴He, written out in the probe order -/

/-- The ⁴He γγ-chain word of the probe, `N₀ N₁ G₀₁ N₂ G₁₂ N₃ G₂₃` with `N_j` on strands
    `3j..3j+2` and `G_{j-1,j} = V³↑(3j-1)`, is the chain `ggChain N₀ [N₁, N₂, N₃]`. -/
theorem he4_ggChain_word_eq (N₀ N₁ N₂ N₃ : HeckeTower R h) :
    N₀ * shift h 3 N₁ * shift h 2 (vertexCube h) * shift h 6 N₂ * shift h 5 (vertexCube h)
        * shift h 9 N₃ * shift h 8 (vertexCube h)
      = ggChain h N₀ [N₁, N₂, N₃] := by
  simp only [ggChain, ggTail, map_mul, map_one, mul_one, shift_shift]
  simp only [mul_assoc]

theorem he4_free_word_eq (N₀ N₁ N₂ N₃ : HeckeTower R h) :
    N₀ * shift h 3 N₁ * shift h 6 N₂ * shift h 9 N₃ = freeTail h [N₀, N₁, N₂, N₃] := by
  simp only [freeTail, map_mul, map_one, mul_one, shift_shift]
  simp only [mul_assoc]

/-- **⁴He γγ chain, closed form**: only the first nucleon enters through its own trace;
    each of the other three enters through its bond factor `tr(V³ · N↑¹)`. -/
theorem towerTr_he4_ggChain_word (N₀ N₁ N₂ N₃ : HeckeTower R h)
    (h₀ : N₀ ∈ twH h 2) (h₁ : N₁ ∈ twH h 2) (h₂ : N₂ ∈ twH h 2) (h₃ : N₃ ∈ twH h 2) :
    towerTr z h (N₀ * shift h 3 N₁ * shift h 2 (vertexCube h) * shift h 6 N₂
        * shift h 5 (vertexCube h) * shift h 9 N₃ * shift h 8 (vertexCube h))
      = towerTr z h N₀ * ggBondFactor z h N₁ * ggBondFactor z h N₂ * ggBondFactor z h N₃ := by
  rw [he4_ggChain_word_eq, towerTr_ggChain z h N₀ h₀ [N₁, N₂, N₃]]
  · simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one]
    ring
  · intro N hN
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hN
    rcases hN with rfl | rfl | rfl <;> assumption

theorem towerTr_he4_free_word (N₀ N₁ N₂ N₃ : HeckeTower R h)
    (h₀ : N₀ ∈ twH h 2) (h₁ : N₁ ∈ twH h 2) (h₂ : N₂ ∈ twH h 2) (h₃ : N₃ ∈ twH h 2) :
    towerTr z h (N₀ * shift h 3 N₁ * shift h 6 N₂ * shift h 9 N₃)
      = towerTr z h N₀ * towerTr z h N₁ * towerTr z h N₂ * towerTr z h N₃ := by
  rw [he4_free_word_eq, towerTr_freeTail z h [N₀, N₁, N₂, N₃]]
  · simp only [List.map_cons, List.map_nil, List.prod_cons, List.prod_nil, mul_one]
    ring
  · intro N hN
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hN
    rcases hN with rfl | rfl | rfl | rfl <;> assumption

/-- **The ⁴He γγ-chain trace difference** `tr W_free − tr W_chain` (the quantity the
    probe multiplies by `E₀` to report `B_diff`), in single-nucleon factors. -/
theorem he4_ggChain_trace_difference (N₀ N₁ N₂ N₃ : HeckeTower R h)
    (h₀ : N₀ ∈ twH h 2) (h₁ : N₁ ∈ twH h 2) (h₂ : N₂ ∈ twH h 2) (h₃ : N₃ ∈ twH h 2) :
    towerTr z h (N₀ * shift h 3 N₁ * shift h 6 N₂ * shift h 9 N₃)
        - towerTr z h (N₀ * shift h 3 N₁ * shift h 2 (vertexCube h) * shift h 6 N₂
            * shift h 5 (vertexCube h) * shift h 9 N₃ * shift h 8 (vertexCube h))
      = towerTr z h N₀ * (towerTr z h N₁ * towerTr z h N₂ * towerTr z h N₃
          - ggBondFactor z h N₁ * ggBondFactor z h N₂ * ggBondFactor z h N₃) := by
  rw [towerTr_he4_free_word z h N₀ N₁ N₂ N₃ h₀ h₁ h₂ h₃,
    towerTr_he4_ggChain_word z h N₀ N₁ N₂ N₃ h₀ h₁ h₂ h₃]
  ring

end GammaGammaChain

end QOU.BraidKnot.HeckeFunctional


/-!
# The binding half of `conj:knot-factor-frobenius-pairing`, read through the knot factor

The braid half is a theorem: every cyclic trace `t` on `H_n(q)`, `q ≠ 0`, is the
Frobenius pairing `t x = τ(x κ)` with a unique central knot factor `κ = Σ_λ y_λ s_λ e_λ`
(`QOU.Hecke.KnotFactor`; Markov instance `markov_trace_eq_tau_mul_knotFactor`).

The binding half of the block is `B = E₀ (|tr(W_free)| − |tr(W_atom)|)`.  This file tests
the reading "binding = free trace minus convolved trace = `τ(x (κ_free − κ_atom))`" in
the three forms that make sense, and records what each gives.

* **R1 (linearity).** `t a − t c = τ((a − c) κ)` for any two elements: the trace
  difference is the pairing of the *word difference* with the one knot factor
  (`binding_eq_pair_wordDifference`).  No second knot factor appears.
* **R2 (free = product of constituent traces).**  On the free word
  `x ⊔ y = incl x · shift_m y`, the pairing with the atom-level knot factor `κ_n` equals
  the product of the constituent pairings `τ_m(x κ_m) · τ_p(y κ_p)`
  (`markov_free_pairing`).  So "free minus atom" evaluated on the free word is zero: the
  binding is carried entirely by `W_free − W_atom`, never by a difference of knot
  factors (`markov_binding_eq_free_minus_atom_pair`).
* **R3 (bond-convolved functional).**  `x ↦ t(x b)` is paired by `b κ`
  (`convolve_eq_pair`), and it is a trace **iff `b κ` is central**
  (`convolve_isTrace_iff`, generic; `hecke_convolve_isTrace_iff` in `H_n(q)`).  So a
  bond-convolved "atom trace" has a central knot factor only when the bond is central
  on the support of `κ`.  The symbolic probe
  `computations/probes/knot_factor_binding_half/` finds that the γγ bond
  `(σ_iσ_{i+1}⁻¹)³` is not (blocks `(2,1)` of `H_3`, `(5,1)`, `(4,2)`, `(3,3)` of `H_6`
  at `z_D`): that is a computation, not a theorem in this file.

## What this is not

Nothing here is about measured binding energies.  The absolute values `|tr|` of the
block are not linear; R1 and R2 are statements about the signed traces.  The comparison
against AME2020 is still the open part of the conjecture.

Generic over `[Field K]` / `[Ring A]`; no ordering, no archimedean structure (§7c).

## References

- [geckpfeiffer2000] §7.2, §8.1 (symmetrizing trace, Schur elements)
- [jones1987] Ocneanu trace and its multiplicativity on split braids
-/

namespace QOU.BraidKnot.BindingHalf

open QOU.Hecke.KnotFactor

section General

variable {K : Type*} [Field K] {A : Type*} [Ring A] [Algebra K A]

/-- **R1.** The difference of two pairings with one knot factor is the pairing of the
    difference. -/
theorem binding_eq_pair_wordDifference (τ : A →ₗ[K] K) (κ a c : A) :
    τ (a * κ) - τ (c * κ) = τ ((a - c) * κ) := by
  rw [sub_mul, map_sub]

/-- **A pairing functional is a trace iff its element is central**, for a cyclic and
    nondegenerate pairing trace `τ`. -/
theorem pair_isTrace_iff_central (τ : A →ₗ[K] K) (hτ : ∀ x y : A, τ (x * y) = τ (y * x))
    (hnd : ∀ z : A, (∀ y : A, τ (z * y) = 0) → z = 0) (k : A) :
    (∀ x y : A, τ (x * y * k) = τ (y * x * k)) ↔ ∀ y : A, k * y = y * k := by
  constructor
  · intro H y
    have hz : k * y - y * k = 0 := by
      refine hnd _ fun x => ?_
      have e1 : τ (k * y * x) = τ (y * x * k) := by
        rw [mul_assoc, hτ k (y * x)]
      have e2 : τ (y * k * x) = τ (x * y * k) := by
        rw [mul_assoc, hτ y (k * x), mul_assoc, hτ k (x * y)]
      rw [sub_mul, map_sub, e1, e2, H y x, sub_self]
    exact sub_eq_zero.mp hz
  · intro H x y
    calc τ (x * y * k) = τ (x * (y * k)) := by rw [mul_assoc]
      _ = τ (x * (k * y)) := by rw [H y]
      _ = τ ((x * k) * y) := by rw [mul_assoc]
      _ = τ (y * (x * k)) := hτ _ _
      _ = τ (y * x * k) := by rw [mul_assoc]

/-- The bond-convolved functional `x ↦ t(x b)`. -/
noncomputable def convolve (t : A →ₗ[K] K) (b : A) : A →ₗ[K] K :=
  t.comp (LinearMap.mulRight K b)

theorem convolve_apply (t : A →ₗ[K] K) (b x : A) : convolve t b x = t (x * b) := rfl

/-- **R3, pairing element.** If `t = τ(· κ)`, then `x ↦ t(x b)` is paired by `b κ`. -/
theorem convolve_eq_pair (t τ : A →ₗ[K] K) (κ b : A) (hk : ∀ x, t x = τ (x * κ)) (x : A) :
    convolve t b x = τ (x * (b * κ)) := by
  rw [convolve_apply, hk, mul_assoc]

/-- **R3.** The bond-convolved functional is a trace iff `b κ` is central. -/
theorem convolve_isTrace_iff (t τ : A →ₗ[K] K) (hτ : ∀ x y : A, τ (x * y) = τ (y * x))
    (hnd : ∀ z : A, (∀ y : A, τ (z * y) = 0) → z = 0)
    (κ b : A) (hk : ∀ x, t x = τ (x * κ)) :
    (∀ x y : A, convolve t b (x * y) = convolve t b (y * x))
      ↔ ∀ y : A, (b * κ) * y = y * (b * κ) := by
  rw [← pair_isTrace_iff_central τ hτ hnd (b * κ)]
  simp only [convolve_eq_pair t τ κ b hk]

/-- **R2, abstract form.** If `κ'` pairs to the same functional as `κ` on a subspace
    `P`, the pairing with `κ' − κ` vanishes on `P`. -/
theorem pair_sub_vanishes_on (t τ : A →ₗ[K] K) (κ κ' : A) (P : Submodule K A)
    (hk : ∀ x, t x = τ (x * κ)) (hk' : ∀ x ∈ P, t x = τ (x * κ')) :
    ∀ x ∈ P, τ (x * (κ' - κ)) = 0 := by
  intro x hx
  rw [mul_sub, map_sub, ← hk, ← hk' x hx, sub_self]

end General

section Hecke

open QOU.Hecke.TwBasis

variable {K : Type*} [Field K] {q : K} {n : ℕ}
variable {ι : Type*} [Fintype ι] [DecidableEq ι]
variable {J : ι → Type*} [∀ i, Fintype (J i)] [∀ i, DecidableEq (J i)]

/-- **R3 in `H_n(q)`.**  For any trace `t`, `q ≠ 0` and any splitting, the bond-convolved
    functional `x ↦ t(x b)` is a trace iff `b κ` is central, `κ` the knot factor of `t`. -/
theorem hecke_convolve_isTrace_iff (hq : q ≠ 0)
    (E : QOU.Hecke.IwahoriHecke K q n ≃ₐ[K] ∀ i, Matrix (J i) (J i) K)
    (a : ∀ i, J i) (t : QOU.Hecke.IwahoriHecke K q n →ₗ[K] K)
    (ht : ∀ x y, t (x * y) = t (y * x)) (b : QOU.Hecke.IwahoriHecke K q n) :
    (∀ x y, convolve t b (x * y) = convolve t b (y * x))
      ↔ ∀ y, (b * knotFactor E t (tau K q n) a) * y
              = y * (b * knotFactor E t (tau K q n) a) :=
  convolve_isTrace_iff t (tau K q n) (tau_mul_comm K q n)
    (fun _ hz => tau_eq_zero_of_forall_mul K q n hq hz) _ b
    (hecke_trace_eq_tau_mul_knotFactor hq E a t ht)

end Hecke

section Markov

open QOU.Hecke QOU.Hecke.TwBasis QOU.BraidKnot.HeckeFunctional

variable {K : Type*} [Field K] {q : K}
variable {ι₁ ι₂ ι₃ : Type*} [Fintype ι₁] [DecidableEq ι₁] [Fintype ι₂] [DecidableEq ι₂]
  [Fintype ι₃] [DecidableEq ι₃]
variable {J₁ : ι₁ → Type*} [∀ i, Fintype (J₁ i)] [∀ i, DecidableEq (J₁ i)]
variable {J₂ : ι₂ → Type*} [∀ i, Fintype (J₂ i)] [∀ i, DecidableEq (J₂ i)]
variable {J₃ : ι₃ → Type*} [∀ i, Fintype (J₃ i)] [∀ i, DecidableEq (J₃ i)]

/-- **R2.** On a free (split) word `incl x · shift_m y`, the pairing with the atom-level
    Markov knot factor `κ_n` is the product of the constituents' pairings with their own
    knot factors `κ_m`, `κ_p`. -/
theorem markov_free_pairing (hq : q ≠ 0) (s h z : K) (hs : s * s = q) (hh : s * h = q - 1)
    {m p n : ℕ} (hmn : m ≤ n) (hpn : p + m ≤ n)
    (Em : IwahoriHecke K q m ≃ₐ[K] ∀ i, Matrix (J₁ i) (J₁ i) K) (am : ∀ i, J₁ i)
    (Ep : IwahoriHecke K q p ≃ₐ[K] ∀ i, Matrix (J₂ i) (J₂ i) K) (ap : ∀ i, J₂ i)
    (En : IwahoriHecke K q n ≃ₐ[K] ∀ i, Matrix (J₃ i) (J₃ i) K) (an : ∀ i, J₃ i)
    (x : IwahoriHecke K q m) (y : IwahoriHecke K q p) :
    tau K q n ((heckeIncl hmn x * heckeShift m hpn y)
        * knotFactor En (heckeMarkovTrace s h z hs hh) (tau K q n) an)
      = tau K q m (x * knotFactor Em (heckeMarkovTrace s h z hs hh) (tau K q m) am)
        * tau K q p (y * knotFactor Ep (heckeMarkovTrace s h z hs hh) (tau K q p) ap) := by
  rw [← markov_trace_eq_tau_mul_knotFactor hq En an, ← markov_trace_eq_tau_mul_knotFactor hq Em am,
    ← markov_trace_eq_tau_mul_knotFactor hq Ep ap, heckeMarkovTrace_disjoint]

/-- **R2, the binding.**  With the free word `incl x · shift_m y` and any atom word `W` in
    `H_n`, "free trace minus atom trace", the free trace taken as the product of the
    constituent pairings, is the pairing of `free − W` with the single knot factor `κ_n`. -/
theorem markov_binding_eq_free_minus_atom_pair (hq : q ≠ 0) (s h z : K) (hs : s * s = q)
    (hh : s * h = q - 1) {m p n : ℕ} (hmn : m ≤ n) (hpn : p + m ≤ n)
    (Em : IwahoriHecke K q m ≃ₐ[K] ∀ i, Matrix (J₁ i) (J₁ i) K) (am : ∀ i, J₁ i)
    (Ep : IwahoriHecke K q p ≃ₐ[K] ∀ i, Matrix (J₂ i) (J₂ i) K) (ap : ∀ i, J₂ i)
    (En : IwahoriHecke K q n ≃ₐ[K] ∀ i, Matrix (J₃ i) (J₃ i) K) (an : ∀ i, J₃ i)
    (x : IwahoriHecke K q m) (y : IwahoriHecke K q p) (W : IwahoriHecke K q n) :
    tau K q m (x * knotFactor Em (heckeMarkovTrace s h z hs hh) (tau K q m) am)
        * tau K q p (y * knotFactor Ep (heckeMarkovTrace s h z hs hh) (tau K q p) ap)
      - tau K q n (W * knotFactor En (heckeMarkovTrace s h z hs hh) (tau K q n) an)
      = tau K q n ((heckeIncl hmn x * heckeShift m hpn y - W)
          * knotFactor En (heckeMarkovTrace s h z hs hh) (tau K q n) an) := by
  rw [← markov_free_pairing hq s h z hs hh hmn hpn Em am Ep ap En an x y,
    binding_eq_pair_wordDifference]

end Markov

end QOU.BraidKnot.BindingHalf


/-!
# Bonds that cross the interface twice

Setting of `MarkovTraceHeckeFunctional`: a first cluster `x ∈ H_m` (generators
`σ_0, …, σ_{m-1}`), a second cluster `Y↑ᵐ⁺¹`, and the interface generator `σ_m` between
them. `towerTr_singleGapBond` covers bonds with one interface letter. This file covers two.

* `towerTr_twoGapBond_reduce` — `tr(x · Y↑ · (A₁C₁↑ · u · A₂C₂↑ · v · A₃C₃↑))
  = tr(P · Q↑ · (u A₂ C₂↑ v))` with `P = A₃ x A₁`, `Q = C₃ Y C₁`, any letters `u, v`.
* `towerTr_twoLetter_expand` — for `u = α + βσ_m`, `v = γ + δσ_m` (so `σ_m⁻¹ = σ_m − h`
  is included), the terms with at most one `σ_m` give
  `(αγ + (αδ + βγ) z) · tr(P A) · tr(Q C)`; what remains is `βδ` times the core
  `tr(P · Q↑ · σ_m A C↑ σ_m)`.
* `towerTr_twoGap` — the core, for `m = n + 1`, `A = a₀ + a₁ σ_n a₂` (`aᵢ ∈ H_n`) and
  `C = c₀↑¹ + c₁↑¹ σ_0 c₂↑¹`:

      tr(P Q↑ σ A C↑ σ) = (hz + 1) tr(P a₀) tr(Q c₀↑¹)
                        + z tr(P a₁ σ_n² a₂) tr(Q c₀↑¹)
                        + z tr(P a₀) tr(Q c₁↑¹ σ_0² c₂↑¹)
                        + tr(a₂ P a₁ · (c₂↑¹ Q c₁↑¹)↑ · σ_{n+1} σ_n σ_{n+2} σ_{n+1}).

  The first three terms are products of single-cluster traces (rank ≤ 2 between them). The
  last, the cable term, is the trace of the crossing of two 2-cables and does not split.
* `towerTr_twoGap_outerLeft` / `towerTr_twoGap_outerRight` — if `A` has no `σ_n` or `C`
  has no `σ_0`, the core is a product `f(P) · g(Q)`.
* `towerTr_twoGap_outerLeft_crossRatio` / `towerTr_twoGap_outerRight_crossRatio` — for such
  bonds, with any two gap letters `α + βσ_m`, `γ + δσ_m`, the atom traces of the four pairs
  satisfy `T₁₁ T₂₂ = T₁₂ T₂₁`; with `not_both_lt_one_of_crossRatio` this excludes
  "pn and np bind, pp and nn do not" whenever the μ are positive.

* `not_pattern_of_affine_rankOne` — if `μᵢⱼ = c + aᵢ bⱼ` with `c ≤ 1/2`, the pattern
  (with all four `μ > 0`) is impossible. A rank-2 bond form whose span contains the free trace
  in both arguments has this shape, `μ(x, y) = c + ℓ'(x) r'(y)`, on the whole cluster algebra.

Not covered: the cable term (both inner letters present), and three or more gap letters.
Generic over `[CommRing R]` (§7c).
-/
namespace QOU.BraidKnot.HeckeFunctional
open QOU.MathlibExt.HeckeTowerWitness
variable {R : Type*} [CommRing R] (z h : R)

theorem mg_comm_shift {n : ℕ} {a : HeckeTower R h} (ha : a ∈ twH h n) {k : ℕ} (hk : n + 1 ≤ k)
    (Y : HeckeTower R h) : Commute a (shift h k Y) := by
  obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
  exact twH_comm_shift h j (twH_mono h (by omega) ha) Y

theorem mg_comm_gen {n : ℕ} {a : HeckeTower R h} (ha : a ∈ twH h n) {k : ℕ} (hk : n + 1 ≤ k) :
    Commute a (twGen h k) := by
  have := mg_comm_shift h ha hk (twGen h 0)
  rwa [shift_twGen, zero_add] at this

theorem mg_shift_mul (k : ℕ) (Y c : HeckeTower R h) :
    shift h (k + 1) Y * shift h (k + 1 + 1) c = shift h (k + 1) (Y * shift h 1 c) := by
  rw [map_mul, shift_shift, show 1 + (k + 1) = k + 1 + 1 by omega]

theorem towerTr_XYg (m : ℕ) {X : HeckeTower R h} (hX : X ∈ twH h m) (Y : HeckeTower R h) :
    towerTr z h (X * shift h (m + 1) Y * twGen h m) = z * towerTr z h X * towerTr z h Y := by
  rw [twH_comm_shift h m hX Y, mul_assoc, towerTr_mul_comm, towerTr_connectedSum z h m hX Y]

theorem towerTr_XYgg (m : ℕ) {X : HeckeTower R h} (hX : X ∈ twH h m) (Y : HeckeTower R h) :
    towerTr z h (X * shift h (m + 1) Y * (twGen h m * twGen h m))
      = (h * z + 1) * towerTr z h X * towerTr z h Y := by
  rw [twGen_quad, mul_add, mul_smul_comm, mul_one, map_add, map_smul,
    towerTr_XYg z h m hX Y, towerTr_split z h m hX Y, smul_eq_mul]; ring

/-- Left factor, outer letter: `a ∈ H_n`, `n + 1 ≤ m`, so `a` commutes with `σ_m`. -/
theorem towerTr_twoGap_left_outer (m n : ℕ) (hnm : n + 1 ≤ m) {X a : HeckeTower R h}
    (hX : X ∈ twH h m) (ha : a ∈ twH h n) (Y : HeckeTower R h) :
    towerTr z h (X * shift h (m + 1) Y * (twGen h m * a * twGen h m))
      = (h * z + 1) * towerTr z h (X * a) * towerTr z h Y := by
  have ca := mg_comm_gen h ha hnm
  have cs := mg_comm_shift h ha (k := m + 1) (by omega) Y
  have e : X * shift h (m + 1) Y * (twGen h m * a * twGen h m)
      = X * a * shift h (m + 1) Y * (twGen h m * twGen h m) := by
    rw [← ca.eq]; simp only [mul_assoc]; rw [cs.symm.left_comm]
  rw [e, towerTr_XYgg z h m (Subalgebra.mul_mem _ hX (twH_mono h (by omega) ha))]

/-- Left factor, inner letter: `A = a₁ σ_n a₂` with `a₁, a₂ ∈ H_n`, gap `σ_{n+1}`. -/
theorem towerTr_twoGap_left_inner (n : ℕ) {X a₁ a₂ : HeckeTower R h}
    (hX : X ∈ twH h (n + 1)) (ha₁ : a₁ ∈ twH h n) (ha₂ : a₂ ∈ twH h n) (Y : HeckeTower R h) :
    towerTr z h (X * shift h (n + 1 + 1) Y *
        (twGen h (n + 1) * (a₁ * twGen h n * a₂) * twGen h (n + 1)))
      = z * towerTr z h (X * a₁ * (twGen h n * twGen h n) * a₂) * towerTr z h Y := by
  have c1g := mg_comm_gen h ha₁ (k := n + 1) le_rfl
  have c2g := mg_comm_gen h ha₂ (k := n + 1) le_rfl
  have c1s := mg_comm_shift h ha₁ (k := n + 1 + 1) (by omega) Y
  have hg' : twGen h n ∈ twH h (n + 1) := twGen_mem h n
  have cgs : Commute (twGen h n) (shift h (n + 1 + 1) Y) := twH_comm_shift h (n + 1) hg' Y
  have hX' : twGen h n * (a₂ * X * a₁) * twGen h n ∈ twH h (n + 1) :=
    Subalgebra.mul_mem _ (Subalgebra.mul_mem _ hg' (Subalgebra.mul_mem _
      (Subalgebra.mul_mem _ (twH_mono h (by omega) ha₂) hX) (twH_mono h (by omega) ha₁))) hg'
  calc towerTr z h (X * shift h (n + 1 + 1) Y *
        (twGen h (n + 1) * (a₁ * twGen h n * a₂) * twGen h (n + 1)))
      = towerTr z h ((X * a₁ * shift h (n + 1 + 1) Y *
          (twGen h (n + 1) * twGen h n * twGen h (n + 1))) * a₂) := by
        congr 1; simp only [mul_assoc]; rw [c2g.eq, c1g.symm.left_comm, c1s.symm.left_comm]
    _ = towerTr z h (a₂ * (X * a₁ * shift h (n + 1 + 1) Y *
          (twGen h (n + 1) * twGen h n * twGen h (n + 1)))) := towerTr_mul_comm z h _ _
    _ = towerTr z h ((a₂ * X * a₁ * shift h (n + 1 + 1) Y * twGen h n * twGen h (n + 1))
          * twGen h n) := by rw [twGen_braid]; simp only [mul_assoc]
    _ = towerTr z h (twGen h n * (a₂ * X * a₁ * shift h (n + 1 + 1) Y * twGen h n
          * twGen h (n + 1))) := towerTr_mul_comm z h _ _
    _ = towerTr z h (twGen h n * (a₂ * X * a₁) * twGen h n * shift h (n + 1 + 1) Y
          * twGen h (n + 1)) := by congr 1; simp only [mul_assoc]; rw [cgs.symm.left_comm]
    _ = z * towerTr z h (twGen h n * (a₂ * X * a₁) * twGen h n) * towerTr z h Y :=
        towerTr_XYg z h (n + 1) hX' Y
    _ = z * towerTr z h (X * a₁ * (twGen h n * twGen h n) * a₂) * towerTr z h Y := by
        congr 2
        rw [mul_assoc, towerTr_mul_comm,
          show a₂ * X * a₁ * twGen h n * twGen h n
            = a₂ * (X * a₁ * (twGen h n * twGen h n)) by simp only [mul_assoc],
          towerTr_mul_comm]

/-- Right factor, outer letter: `C↑ = c↑ᵐ⁺²` commutes with `σ_m`. -/
theorem towerTr_twoGap_right_outer (m : ℕ) {X : HeckeTower R h} (hX : X ∈ twH h m)
    (Y c : HeckeTower R h) :
    towerTr z h (X * shift h (m + 1) Y * (twGen h m * shift h (m + 1 + 1) c * twGen h m))
      = (h * z + 1) * towerTr z h X * towerTr z h (Y * shift h 1 c) := by
  have cg : Commute (twGen h m) (shift h (m + 1 + 1) c) :=
    twH_comm_shift h (m + 1) (twGen_mem h m) c
  rw [← towerTr_XYgg z h m hX, ← mg_shift_mul]
  congr 1; simp only [mul_assoc]; rw [cg.left_comm]

/-- Right factor, inner letter: `C↑ = c₁↑ σ_{m+1} c₂↑` (`c↑ = c↑ᵐ⁺²`). -/
theorem towerTr_twoGap_right_inner (m : ℕ) {X : HeckeTower R h} (hX : X ∈ twH h m)
    (Y c₁ c₂ : HeckeTower R h) :
    towerTr z h (X * shift h (m + 1) Y * (twGen h m *
        (shift h (m + 1 + 1) c₁ * twGen h (m + 1) * shift h (m + 1 + 1) c₂) * twGen h m))
      = z * towerTr z h X *
          towerTr z h (Y * shift h 1 c₁ * (twGen h 0 * twGen h 0) * shift h 1 c₂) := by
  have c1 : Commute (twGen h m) (shift h (m + 1 + 1) c₁) :=
    twH_comm_shift h (m + 1) (twGen_mem h m) c₁
  have c2 : Commute (twGen h m) (shift h (m + 1 + 1) c₂) :=
    twH_comm_shift h (m + 1) (twGen_mem h m) c₂
  have cXg := mg_comm_gen h hX (k := m + 1) le_rfl
  have cX2 := mg_comm_shift h hX (k := m + 1 + 1) (by omega) c₂
  have hk : 1 + (m + 1) = m + 1 + 1 := by omega
  have e3 : twGen h (m + 1) * shift h (m + 1 + 1) c₂ * shift h (m + 1) Y
        * shift h (m + 1 + 1) c₁ * twGen h (m + 1)
      = shift h (m + 1) (twGen h 0 * shift h 1 c₂ * Y * shift h 1 c₁ * twGen h 0) := by
    simp only [map_mul, shift_twGen, shift_shift, zero_add, hk]
  calc towerTr z h (X * shift h (m + 1) Y * (twGen h m *
        (shift h (m + 1 + 1) c₁ * twGen h (m + 1) * shift h (m + 1 + 1) c₂) * twGen h m))
      = towerTr z h ((X * shift h (m + 1) Y * shift h (m + 1 + 1) c₁ * twGen h (m + 1)
          * twGen h m) * (twGen h (m + 1) * shift h (m + 1 + 1) c₂)) := by
        congr 1
        have hb : ∀ w : HeckeTower R h, twGen h m * (twGen h (m + 1) * (twGen h m * w))
            = twGen h (m + 1) * (twGen h m * (twGen h (m + 1) * w)) := by
          intro w; simp only [← mul_assoc]; rw [twGen_braid]
        simp only [mul_assoc]; rw [c1.left_comm, ← c2.eq, hb]
    _ = towerTr z h ((twGen h (m + 1) * shift h (m + 1 + 1) c₂) *
          (X * shift h (m + 1) Y * shift h (m + 1 + 1) c₁ * twGen h (m + 1) * twGen h m)) :=
        towerTr_mul_comm z h _ _
    _ = towerTr z h (X * (twGen h (m + 1) * shift h (m + 1 + 1) c₂ * shift h (m + 1) Y
          * shift h (m + 1 + 1) c₁ * twGen h (m + 1)) * twGen h m) := by
        congr 1; simp only [mul_assoc]; rw [cX2.symm.left_comm, cXg.symm.left_comm]
    _ = z * towerTr z h X *
          towerTr z h (twGen h 0 * shift h 1 c₂ * Y * shift h 1 c₁ * twGen h 0) := by
        rw [e3, towerTr_XYg z h m hX]
    _ = z * towerTr z h X *
          towerTr z h (Y * shift h 1 c₁ * (twGen h 0 * twGen h 0) * shift h 1 c₂) := by
        congr 1
        rw [show twGen h 0 * shift h 1 c₂ * Y * shift h 1 c₁ * twGen h 0
            = twGen h 0 * (shift h 1 c₂ * Y * shift h 1 c₁ * twGen h 0) by
              simp only [mul_assoc], towerTr_mul_comm,
          show shift h 1 c₂ * Y * shift h 1 c₁ * twGen h 0 * twGen h 0
            = shift h 1 c₂ * (Y * shift h 1 c₁ * (twGen h 0 * twGen h 0)) by
              simp only [mul_assoc], towerTr_mul_comm]

/-- **The cable term**: both inner letters present. `σ_{n+1} (a₁ σ_n a₂) (c₁↑ σ_{n+2} c₂↑) σ_{n+1}`
    reduces to the four-letter word `σ_{n+1} σ_n σ_{n+2} σ_{n+1}` (the crossing of two 2-cables). -/
theorem towerTr_twoGap_cable (n : ℕ) {X a₁ a₂ : HeckeTower R h}
    (hX : X ∈ twH h (n + 1)) (ha₁ : a₁ ∈ twH h n) (ha₂ : a₂ ∈ twH h n)
    (Y c₁ c₂ : HeckeTower R h) :
    towerTr z h (X * shift h (n + 1 + 1) Y *
        (twGen h (n + 1) * (a₁ * twGen h n * a₂) *
          (shift h (n + 1 + 1 + 1) c₁ * twGen h (n + 1 + 1) * shift h (n + 1 + 1 + 1) c₂)
          * twGen h (n + 1)))
      = towerTr z h (a₂ * X * a₁ * shift h (n + 1 + 1) (shift h 1 c₂ * Y * shift h 1 c₁) *
          (twGen h (n + 1) * twGen h n * twGen h (n + 1 + 1) * twGen h (n + 1))) := by
  have c1g := mg_comm_gen h ha₁ (k := n + 1) le_rfl
  have c1s := mg_comm_shift h ha₁ (k := n + 1 + 1) (by omega) Y
  have c2S1 := mg_comm_shift h ha₂ (k := n + 1 + 1 + 1) (by omega) c₁
  have c2S2 := mg_comm_shift h ha₂ (k := n + 1 + 1 + 1) (by omega) c₂
  have c2g'' := mg_comm_gen h ha₂ (k := n + 1 + 1) (by omega)
  have c2g := mg_comm_gen h ha₂ (k := n + 1) le_rfl
  have cgS1 : Commute (twGen h (n + 1)) (shift h (n + 1 + 1 + 1) c₁) :=
    twH_comm_shift h (n + 1 + 1) (twGen_mem h (n + 1)) c₁
  have cgS2 : Commute (twGen h (n + 1)) (shift h (n + 1 + 1 + 1) c₂) :=
    twH_comm_shift h (n + 1 + 1) (twGen_mem h (n + 1)) c₂
  have cg'S1 : Commute (twGen h n) (shift h (n + 1 + 1 + 1) c₁) :=
    mg_comm_shift h (twGen_mem h n) (k := n + 1 + 1 + 1) (by omega) c₁
  have c2S2' := mg_comm_shift h ha₂ (k := n + 1 + 1 + 1) (by omega) c₂
  have cXS2 := mg_comm_shift h hX (k := n + 1 + 1 + 1) (by omega) c₂
  have c1S2 := mg_comm_shift h ha₁ (k := n + 1 + 1 + 1) (by omega) c₂
  have hk : 1 + (n + 1 + 1) = n + 1 + 1 + 1 := by omega
  have hS : shift h (n + 1 + 1) (shift h 1 c₂ * Y * shift h 1 c₁)
      = shift h (n + 1 + 1 + 1) c₂ * shift h (n + 1 + 1) Y * shift h (n + 1 + 1 + 1) c₁ := by
    simp only [map_mul, shift_shift, hk]
  calc _ = towerTr z h ((X * a₁ * shift h (n + 1 + 1) Y * shift h (n + 1 + 1 + 1) c₁ *
          (twGen h (n + 1) * twGen h n * twGen h (n + 1 + 1) * twGen h (n + 1)) *
          shift h (n + 1 + 1 + 1) c₂) * a₂) := by
        congr 1; simp only [mul_assoc]
        rw [c1g.symm.left_comm, c1s.symm.left_comm, c2S1.left_comm, c2g''.left_comm,
          c2S2.left_comm, c2g.eq, cgS2.symm.left_comm, cg'S1.left_comm, cgS1.left_comm]
    _ = towerTr z h (a₂ * (X * a₁ * shift h (n + 1 + 1) Y * shift h (n + 1 + 1 + 1) c₁ *
          (twGen h (n + 1) * twGen h n * twGen h (n + 1 + 1) * twGen h (n + 1)) *
          shift h (n + 1 + 1 + 1) c₂)) := towerTr_mul_comm z h _ _
    _ = towerTr z h ((a₂ * X * a₁ * shift h (n + 1 + 1) Y * shift h (n + 1 + 1 + 1) c₁ *
          (twGen h (n + 1) * twGen h n * twGen h (n + 1 + 1) * twGen h (n + 1))) *
          shift h (n + 1 + 1 + 1) c₂) := by simp only [mul_assoc]
    _ = towerTr z h (shift h (n + 1 + 1 + 1) c₂ * (a₂ * X * a₁ * shift h (n + 1 + 1) Y *
          shift h (n + 1 + 1 + 1) c₁ *
          (twGen h (n + 1) * twGen h n * twGen h (n + 1 + 1) * twGen h (n + 1)))) :=
        towerTr_mul_comm z h _ _
    _ = _ := by
        congr 1; rw [hS]; simp only [mul_assoc]
        rw [c2S2'.symm.left_comm, cXS2.symm.left_comm, c1S2.symm.left_comm]

/-- Moving a right cluster's outer piece `c↑ᵐ⁺²` out of the bond into the second cluster. -/
theorem mg_absorb (m : ℕ) {B : HeckeTower R h} (hB : B ∈ twH h (m + 1))
    (X Y c : HeckeTower R h) :
    X * shift h (m + 1) Y * (twGen h m * B * shift h (m + 1 + 1) c * twGen h m)
      = X * shift h (m + 1) (Y * shift h 1 c) * (twGen h m * B * twGen h m) := by
  have cgB : Commute (twGen h m * B) (shift h (m + 1 + 1) c) :=
    twH_comm_shift h (m + 1)
      (Subalgebra.mul_mem _ (twGen_mem h m) hB) c
  have e : twGen h m * B * shift h (m + 1 + 1) c * twGen h m
      = shift h (m + 1 + 1) c * (twGen h m * B * twGen h m) := by
    rw [cgB.eq, mul_assoc]
  rw [e, ← mg_shift_mul, ← mul_assoc, mul_assoc X]

/-- Moving a left cluster's outer piece `a ∈ H_n` (`n + 1 ≤ m`) out of the bond. -/
theorem mg_pull_left (m n : ℕ) (hnm : n + 1 ≤ m) {a : HeckeTower R h} (ha : a ∈ twH h n)
    (X Y W : HeckeTower R h) :
    X * shift h (m + 1) Y * (twGen h m * a * W * twGen h m)
      = X * a * shift h (m + 1) Y * (twGen h m * W * twGen h m) := by
  have ca := mg_comm_gen h ha hnm
  have cs := mg_comm_shift h ha (k := m + 1) (by omega) Y
  rw [← ca.eq]; simp only [mul_assoc]; rw [cs.symm.left_comm]

/-- **Two gap letters: the four-term decomposition.** Gap `σ_{n+1}`, first cluster
    `x ∈ H_{n+1}`, second cluster `Y↑ⁿ⁺²`. Between the two gap letters sits `A · C↑ⁿ⁺²` with
    `A = a₀ + a₁ σ_n a₂` (`aᵢ ∈ H_n`) and `C = c₀↑¹ + c₁↑¹ σ_0 c₂↑¹`. Then
    `tr(x · Y↑ · σ A C↑ σ)` is the sum of three products of single-cluster traces and one
    cable term (the trace of `σ_{n+1} σ_n σ_{n+2} σ_{n+1}` between the dressed clusters). -/
theorem towerTr_twoGap (n : ℕ) {X a₀ a₁ a₂ : HeckeTower R h}
    (hX : X ∈ twH h (n + 1)) (ha₀ : a₀ ∈ twH h n) (ha₁ : a₁ ∈ twH h n) (ha₂ : a₂ ∈ twH h n)
    (Y c₀ c₁ c₂ : HeckeTower R h) :
    towerTr z h (X * shift h (n + 1 + 1) Y *
        (twGen h (n + 1) * (a₀ + a₁ * twGen h n * a₂) *
          shift h (n + 1 + 1) (shift h 1 c₀ + shift h 1 c₁ * twGen h 0 * shift h 1 c₂)
          * twGen h (n + 1)))
      = (h * z + 1) * towerTr z h (X * a₀) * towerTr z h (Y * shift h 1 c₀)
        + z * towerTr z h (X * a₁ * (twGen h n * twGen h n) * a₂) * towerTr z h (Y * shift h 1 c₀)
        + z * towerTr z h (X * a₀) *
            towerTr z h (Y * shift h 1 c₁ * (twGen h 0 * twGen h 0) * shift h 1 c₂)
        + towerTr z h (a₂ * X * a₁ * shift h (n + 1 + 1) (shift h 1 c₂ * Y * shift h 1 c₁) *
            (twGen h (n + 1) * twGen h n * twGen h (n + 1 + 1) * twGen h (n + 1))) := by
  have hk : 1 + (n + 1 + 1) = n + 1 + 1 + 1 := by omega
  have hC : shift h (n + 1 + 1) (shift h 1 c₀ + shift h 1 c₁ * twGen h 0 * shift h 1 c₂)
      = shift h (n + 1 + 1 + 1) c₀
        + shift h (n + 1 + 1 + 1) c₁ * twGen h (n + 1 + 1) * shift h (n + 1 + 1 + 1) c₂ := by
    simp only [map_add, map_mul, shift_shift, shift_twGen, hk, zero_add]
  have hA₁ : a₁ * twGen h n * a₂ ∈ twH h (n + 1 + 1) :=
    Subalgebra.mul_mem _ (Subalgebra.mul_mem _ (twH_mono h (by omega) ha₁)
      (twH_mono h (by omega) (twGen_mem h n))) (twH_mono h (by omega) ha₂)
  rw [hC]
  have hsplit : ∀ (g A₀ A₁ S₀ W : HeckeTower R h),
      g * (A₀ + A₁) * (S₀ + W) * g
        = g * A₀ * S₀ * g + g * A₁ * S₀ * g + g * A₀ * W * g + g * A₁ * W * g := by
    intros; noncomm_ring
  rw [hsplit, mul_add, mul_add, mul_add, map_add, map_add, map_add,
    mg_absorb h (n + 1) (twH_mono h (by omega) ha₀),
    mg_absorb h (n + 1) hA₁,
    towerTr_twoGap_left_outer z h (n + 1) n le_rfl hX ha₀,
    towerTr_twoGap_left_inner z h n hX ha₁ ha₂,
    mg_pull_left h (n + 1) n le_rfl ha₀,
    towerTr_twoGap_right_inner z h (n + 1) (Subalgebra.mul_mem _ hX (twH_mono h (by omega) ha₀)),
    towerTr_twoGap_cable z h n hX ha₁ ha₂]

/-- **A general two-gap-letter bond reduces to the core.** For `x, A₁ ∈ H_m`, any letters
    `u, v` and any `A₂, A₃`, `C₁, C₂, C₃` (`↑ = ↑ᵐ⁺¹`):
    `tr(x · Y↑ · (A₁C₁↑ · u · A₂C₂↑ · v · A₃C₃↑)) = tr(P · Q↑ · (u A₂ C₂↑ v))`,
    `P = A₃ x A₁`, `Q = C₃ Y C₁`. -/
theorem towerTr_twoGapBond_reduce (m : ℕ) {X A₁ : HeckeTower R h} (hX : X ∈ twH h m)
    (hA₁ : A₁ ∈ twH h m) (A₂ A₃ Y C₁ C₂ C₃ u v : HeckeTower R h) :
    towerTr z h (X * shift h (m + 1) Y *
        (A₁ * shift h (m + 1) C₁ * u * (A₂ * shift h (m + 1) C₂) * v *
          (A₃ * shift h (m + 1) C₃)))
      = towerTr z h (A₃ * X * A₁ * shift h (m + 1) (C₃ * Y * C₁) *
          (u * A₂ * shift h (m + 1) C₂ * v)) := by
  have c3X : Commute X (shift h (m + 1) C₃) := twH_comm_shift h m hX C₃
  have c13 : Commute A₁ (shift h (m + 1) C₃) := twH_comm_shift h m hA₁ C₃
  have c1Y : Commute A₁ (shift h (m + 1) Y) := twH_comm_shift h m hA₁ Y
  rw [show X * shift h (m + 1) Y *
        (A₁ * shift h (m + 1) C₁ * u * (A₂ * shift h (m + 1) C₂) * v *
          (A₃ * shift h (m + 1) C₃))
      = (X * shift h (m + 1) Y *
        (A₁ * shift h (m + 1) C₁ * u * (A₂ * shift h (m + 1) C₂) * v)) *
          (A₃ * shift h (m + 1) C₃) by simp only [mul_assoc], towerTr_mul_comm]
  congr 1
  simp only [map_mul, mul_assoc]
  rw [c3X.symm.left_comm, c1Y.symm.left_comm, c13.symm.left_comm]

/-- **Expanding the two gap letters.** With `u = α + β σ_m`, `v = γ + δ σ_m`, `P, A ∈ H_m`:
    the terms with at most one `σ_m` factorise, and the `σ_m … σ_m` term is the core. -/
theorem towerTr_twoLetter_expand (m : ℕ) {P A : HeckeTower R h} (hP : P ∈ twH h m)
    (hA : A ∈ twH h m) (Q C : HeckeTower R h) (α β γ δ : R) :
    towerTr z h (P * shift h (m + 1) Q *
        ((α • 1 + β • twGen h m) * A * shift h (m + 1) C * (γ • 1 + δ • twGen h m)))
      = (α * γ + (α * δ + β * γ) * z) * towerTr z h (P * A) * towerTr z h (Q * C)
        + β * δ * towerTr z h (P * shift h (m + 1) Q *
            (twGen h m * A * shift h (m + 1) C * twGen h m)) := by
  have hPA : P * A ∈ twH h m := Subalgebra.mul_mem _ hP hA
  have hAP : A * P ∈ twH h m := Subalgebra.mul_mem _ hA hP
  have cAQ : Commute A (shift h (m + 1) Q) := twH_comm_shift h m hA Q
  have cPC : Commute P (shift h (m + 1) C) := twH_comm_shift h m hP C
  have hsplit : (α • 1 + β • twGen h m) * A * shift h (m + 1) C * (γ • 1 + δ • twGen h m)
      = (α * γ) • (A * shift h (m + 1) C) + (α * δ) • (A * shift h (m + 1) C * twGen h m)
        + (β * γ) • (twGen h m * A * shift h (m + 1) C)
        + (β * δ) • (twGen h m * A * shift h (m + 1) C * twGen h m) := by
    simp only [add_mul, mul_add, smul_mul_assoc, mul_smul_comm, one_mul, mul_one, smul_add,
      smul_smul]
    rw [mul_comm γ α, mul_comm γ β, mul_comm δ α, mul_comm δ β]
    abel
  have t1 : towerTr z h (P * shift h (m + 1) Q * (A * shift h (m + 1) C))
      = towerTr z h (P * A) * towerTr z h (Q * C) := by
    rw [← towerTr_split z h m hPA, map_mul (shift h (m + 1))]; congr 1; simp only [mul_assoc]
    rw [cAQ.symm.left_comm]
  have t2 : towerTr z h (P * shift h (m + 1) Q * (A * shift h (m + 1) C * twGen h m))
      = z * towerTr z h (P * A) * towerTr z h (Q * C) := by
    rw [← towerTr_XYg z h m hPA, map_mul (shift h (m + 1))]; congr 1; simp only [mul_assoc]
    rw [cAQ.symm.left_comm]
  have t3 : towerTr z h (P * shift h (m + 1) Q * (twGen h m * A * shift h (m + 1) C))
      = z * towerTr z h (P * A) * towerTr z h (Q * C) := by
    rw [show P * shift h (m + 1) Q * (twGen h m * A * shift h (m + 1) C)
        = (P * shift h (m + 1) Q * (twGen h m * A)) * shift h (m + 1) C by
          simp only [mul_assoc], towerTr_mul_comm,
      show shift h (m + 1) C * (P * shift h (m + 1) Q * (twGen h m * A))
        = (shift h (m + 1) C * P * shift h (m + 1) Q * twGen h m) * A by
          simp only [mul_assoc], towerTr_mul_comm, ← cPC.eq,
      show A * (P * shift h (m + 1) C * shift h (m + 1) Q * twGen h m)
        = A * P * shift h (m + 1) (C * Q) * twGen h m by simp only [map_mul, mul_assoc],
      towerTr_XYg z h m hAP, towerTr_mul_comm z h A P, towerTr_mul_comm z h C Q]
  rw [hsplit, mul_add, mul_add, mul_add, map_add, map_add, map_add, mul_smul_comm,
    mul_smul_comm, mul_smul_comm, mul_smul_comm, map_smul, map_smul, map_smul, map_smul,
    t1, t2, t3, smul_eq_mul, smul_eq_mul, smul_eq_mul, smul_eq_mul]
  ring

/-- **Two gap letters, left inner letter absent**: if the piece between the two `σ_{n+1}`
    has its first-cluster part `a₀ ∈ H_n` (no `σ_n`), the core factorises. -/
theorem towerTr_twoGap_outerLeft (n : ℕ) {X a₀ : HeckeTower R h}
    (hX : X ∈ twH h (n + 1)) (ha₀ : a₀ ∈ twH h n) (Y c₀ c₁ c₂ : HeckeTower R h) :
    towerTr z h (X * shift h (n + 1 + 1) Y *
        (twGen h (n + 1) * a₀ *
          shift h (n + 1 + 1) (shift h 1 c₀ + shift h 1 c₁ * twGen h 0 * shift h 1 c₂)
          * twGen h (n + 1)))
      = towerTr z h (X * a₀) * ((h * z + 1) * towerTr z h (Y * shift h 1 c₀)
          + z * towerTr z h (Y * shift h 1 c₁ * (twGen h 0 * twGen h 0) * shift h 1 c₂)) := by
  have := towerTr_twoGap z h n hX ha₀ (Subalgebra.zero_mem _) (Subalgebra.zero_mem _) Y c₀ c₁ c₂
  simp only [zero_mul, mul_zero, add_zero, map_zero] at this
  rw [this]; ring

/-- **Two gap letters, right inner letter absent**: if the second-cluster part of the piece
    between the two `σ_{n+1}` is `c₀↑ⁿ⁺³` (no `σ_{n+2}`), the core factorises. -/
theorem towerTr_twoGap_outerRight (n : ℕ) {X a₀ a₁ a₂ : HeckeTower R h}
    (hX : X ∈ twH h (n + 1)) (ha₀ : a₀ ∈ twH h n) (ha₁ : a₁ ∈ twH h n) (ha₂ : a₂ ∈ twH h n)
    (Y c₀ : HeckeTower R h) :
    towerTr z h (X * shift h (n + 1 + 1) Y *
        (twGen h (n + 1) * (a₀ + a₁ * twGen h n * a₂) *
          shift h (n + 1 + 1) (shift h 1 c₀) * twGen h (n + 1)))
      = ((h * z + 1) * towerTr z h (X * a₀)
          + z * towerTr z h (X * a₁ * (twGen h n * twGen h n) * a₂))
        * towerTr z h (Y * shift h 1 c₀) := by
  have := towerTr_twoGap z h n hX ha₀ ha₁ ha₂ Y c₀ 0 0
  simp only [map_zero, zero_mul, mul_zero, add_zero] at this
  rw [this]; ring

/-- **The cross-ratio survives two gap letters when one inner letter is absent (left).**
    Bond `A₁C₁↑ · u · a₀C₂↑ · v · A₃C₃↑` with `a₀ ∈ H_n`, `C₂ = c₀↑¹ + c₁↑¹σ₀c₂↑¹`, gap
    letters `u = α + βσ`, `v = γ + δσ`: the atom traces satisfy `T₁₁ T₂₂ = T₁₂ T₂₁`. -/
theorem towerTr_twoGap_outerLeft_crossRatio (n : ℕ) {X₁ X₂ A₁ A₃ a₀ : HeckeTower R h}
    (h₁ : X₁ ∈ twH h (n + 1)) (h₂ : X₂ ∈ twH h (n + 1)) (hA₁ : A₁ ∈ twH h (n + 1))
    (hA₃ : A₃ ∈ twH h (n + 1)) (ha₀ : a₀ ∈ twH h n)
    (Y₁ Y₂ C₁ c₀ c₁ c₂ C₃ : HeckeTower R h) (α β γ δ : R) :
    let B := A₁ * shift h (n + 1 + 1) C₁ * (α • 1 + β • twGen h (n + 1)) *
      (a₀ * shift h (n + 1 + 1) (shift h 1 c₀ + shift h 1 c₁ * twGen h 0 * shift h 1 c₂)) *
      (γ • 1 + δ • twGen h (n + 1)) * (A₃ * shift h (n + 1 + 1) C₃)
    towerTr z h (X₁ * shift h (n + 1 + 1) Y₁ * B) * towerTr z h (X₂ * shift h (n + 1 + 1) Y₂ * B)
      = towerTr z h (X₁ * shift h (n + 1 + 1) Y₂ * B)
        * towerTr z h (X₂ * shift h (n + 1 + 1) Y₁ * B) := by
  intro B
  have ha₀' : a₀ ∈ twH h (n + 1) := twH_mono h (Nat.le_succ n) ha₀
  have key : ∀ X Y, X ∈ twH h (n + 1) → towerTr z h (X * shift h (n + 1 + 1) Y * B)
      = towerTr z h (A₃ * X * A₁ * a₀) *
        ((α * γ + (α * δ + β * γ) * z) *
            towerTr z h (C₃ * Y * C₁ * (shift h 1 c₀ + shift h 1 c₁ * twGen h 0 * shift h 1 c₂))
          + β * δ * ((h * z + 1) * towerTr z h (C₃ * Y * C₁ * shift h 1 c₀)
            + z * towerTr z h (C₃ * Y * C₁ * shift h 1 c₁ * (twGen h 0 * twGen h 0)
                * shift h 1 c₂))) := by
    intro X Y hX
    have hP : A₃ * X * A₁ ∈ twH h (n + 1) :=
      Subalgebra.mul_mem _ (Subalgebra.mul_mem _ hA₃ hX) hA₁
    simp only [B]
    rw [towerTr_twoGapBond_reduce z h (n + 1) hX hA₁, towerTr_twoLetter_expand z h (n + 1) hP ha₀',
      towerTr_twoGap_outerLeft z h n hP ha₀]
    ring
  rw [key X₁ Y₁ h₁, key X₂ Y₂ h₂, key X₁ Y₂ h₁, key X₂ Y₁ h₂]
  ring

/-- **The cross-ratio survives two gap letters when one inner letter is absent (right).**
    Bond `A₁C₁↑ · u · (a₀ + a₁σ_na₂)c₀↑ⁿ⁺³ · v · A₃C₃↑`. -/
theorem towerTr_twoGap_outerRight_crossRatio (n : ℕ) {X₁ X₂ A₁ A₃ a₀ a₁ a₂ : HeckeTower R h}
    (h₁ : X₁ ∈ twH h (n + 1)) (h₂ : X₂ ∈ twH h (n + 1)) (hA₁ : A₁ ∈ twH h (n + 1))
    (hA₃ : A₃ ∈ twH h (n + 1)) (ha₀ : a₀ ∈ twH h n) (ha₁ : a₁ ∈ twH h n) (ha₂ : a₂ ∈ twH h n)
    (Y₁ Y₂ C₁ c₀ C₃ : HeckeTower R h) (α β γ δ : R) :
    let B := A₁ * shift h (n + 1 + 1) C₁ * (α • 1 + β • twGen h (n + 1)) *
      ((a₀ + a₁ * twGen h n * a₂) * shift h (n + 1 + 1) (shift h 1 c₀)) *
      (γ • 1 + δ • twGen h (n + 1)) * (A₃ * shift h (n + 1 + 1) C₃)
    towerTr z h (X₁ * shift h (n + 1 + 1) Y₁ * B) * towerTr z h (X₂ * shift h (n + 1 + 1) Y₂ * B)
      = towerTr z h (X₁ * shift h (n + 1 + 1) Y₂ * B)
        * towerTr z h (X₂ * shift h (n + 1 + 1) Y₁ * B) := by
  intro B
  have hA : a₀ + a₁ * twGen h n * a₂ ∈ twH h (n + 1) :=
    Subalgebra.add_mem _ (twH_mono h (Nat.le_succ n) ha₀)
      (Subalgebra.mul_mem _ (Subalgebra.mul_mem _ (twH_mono h (Nat.le_succ n) ha₁)
        (twGen_mem h n)) (twH_mono h (Nat.le_succ n) ha₂))
  have key : ∀ X Y, X ∈ twH h (n + 1) → towerTr z h (X * shift h (n + 1 + 1) Y * B)
      = ((α * γ + (α * δ + β * γ) * z) *
            towerTr z h (A₃ * X * A₁ * (a₀ + a₁ * twGen h n * a₂))
          + β * δ * ((h * z + 1) * towerTr z h (A₃ * X * A₁ * a₀)
            + z * towerTr z h (A₃ * X * A₁ * a₁ * (twGen h n * twGen h n) * a₂)))
        * towerTr z h (C₃ * Y * C₁ * shift h 1 c₀) := by
    intro X Y hX
    have hP : A₃ * X * A₁ ∈ twH h (n + 1) :=
      Subalgebra.mul_mem _ (Subalgebra.mul_mem _ hA₃ hX) hA₁
    simp only [B]
    rw [towerTr_twoGapBond_reduce z h (n + 1) hX hA₁, towerTr_twoLetter_expand z h (n + 1) hP hA,
      towerTr_twoGap_outerRight z h n hP ha₀ ha₁ ha₂]
    ring
  rw [key X₁ Y₁ h₁, key X₂ Y₂ h₂, key X₁ Y₂ h₁, key X₂ Y₁ h₂]
  ring

/-- **A rank-one perturbation of a constant cannot carry the pattern when the constant is at
    most `1/2`.** If `μᵢⱼ = c + aᵢ bⱼ` with `c ≤ 1/2`, then not (`μ₁₁ > 1`, `μ₂₂ > 1` and
    `0 < μ₁₂, μ₂₁ < 1`). This is the shape of a rank-2 bond form whose span contains the free
    trace in both arguments: `μ(x, y) = c + ℓ'(x) r'(y)`. -/
theorem not_pattern_of_affine_rankOne {K : Type*} [Field K] [LinearOrder K]
    [IsStrictOrderedRing K] {c a₁ a₂ b₁ b₂ : K} (hc : c ≤ 1 / 2) :
    ¬ (1 < c + a₁ * b₁ ∧ 1 < c + a₂ * b₂ ∧ 0 < c + a₁ * b₂ ∧ c + a₁ * b₂ < 1 ∧
        0 < c + a₂ * b₁ ∧ c + a₂ * b₁ < 1) := by
  rintro ⟨h11, h22, l12, u12, l21, u21⟩
  have hd : (1 - c) * (1 - c) < (a₁ * b₁) * (a₂ * b₂) := by
    have : 0 ≤ 1 - c := by linarith
    nlinarith
  have he : (a₁ * b₂) * (a₂ * b₁) < (1 - c) * (1 - c) := by
    rcases le_or_gt 0 (a₁ * b₂) with p | p <;> rcases le_or_gt 0 (a₂ * b₁) with r | r
    · nlinarith
    · nlinarith
    · nlinarith
    · nlinarith
  have : (a₁ * b₁) * (a₂ * b₂) = (a₁ * b₂) * (a₂ * b₁) := by ring
  linarith

end QOU.BraidKnot.HeckeFunctional


/-!
# Two γγ bonds landing on one nucleon: the convergence factor `ρ₂` does not see the
transport's crossing sign or the bond order

Setting of `computations/probes/he4_closed_form/` (`conv_word`, `k = 2`): two external
strands `0, 1`, each bonded by the γγ vertex `V³ = (σ₀σ₁⁻¹)³` placed on `σ₁, σ₂` to a
nucleon `N ∈ H₂` sitting on strands `2..4` as `N↑²`. Strand `1` is bonded directly;
strand `0` is carried to position `1` by `σ₀` ("over") or `σ₀⁻¹` ("under") and carried
back by the inverse. The probe measured that the trace of the resulting word does not
depend on the crossing sign of the transport, nor on which of the two bonds is applied
first. This file proves it, for any bond element `a` placed as `a↑¹` (so in particular
for `V³`), and any `N`.

* `towerTr_gen_zero_shift` — `tr(σ₀ · Z↑¹) = z · tr Z` (connected sum at `m = 0`).
* `towerTr_conj_over_eq_under` — for any `Y, B`,
  `tr(σ₀ Y↑¹ σ₀⁻¹ B↑¹) = tr(σ₀⁻¹ Y↑¹ σ₀ B↑¹)`. The two expansions differ only by
  `h·tr(σ₀ Y↑¹ B↑¹)` against `h·tr(Y↑¹ σ₀ B↑¹)`, both `h z tr(YB)`.
* `towerTr_rho2_over_eq_under`, `towerTr_rho2_order`, `towerTr_rho2_all` — the four
  arrangements (direct bond first or second, transport over or under) of the `k = 2`
  convergence word have one trace.

What is NOT proved here: the `k = 3` case (measured, all `3!` orders and both signs), and
the reduction of the full ⁴He word with the other nucleon blocks set to `1` to the
`k + 3`-strand word (that needs the free strands the transport crosses to be removed,
which is a Markov destabilisation through a crossing, not cyclicity or far commutation).

Generic over `[CommRing R]` (§7c). Everything is proved.
-/

namespace QOU.BraidKnot.HeckeFunctional

open QOU.MathlibExt.HeckeTowerWitness

section GammaGammaAllPairs

variable {R : Type*} [CommRing R] (z h : R)

/-- `tr(σ₀ · Z↑¹) = z · tr Z`. -/
theorem towerTr_gen_zero_shift (Z : HeckeTower R h) :
    towerTr z h (twGen h 0 * shift h 1 Z) = z * towerTr z h Z := by
  have := towerTr_connectedSum z h 0 (Subalgebra.one_mem (twH h 0)) Z
  rwa [one_mul, towerTr_one, mul_one] at this

/-- `tr(σ₀ · Y↑¹ · B↑¹) = tr(Y↑¹ · σ₀ · B↑¹)`: both are `z · tr(Y B)`. -/
theorem towerTr_gen_zero_slide (Y B : HeckeTower R h) :
    towerTr z h (twGen h 0 * shift h 1 Y * shift h 1 B)
      = towerTr z h (shift h 1 Y * twGen h 0 * shift h 1 B) := by
  have e1 : towerTr z h (twGen h 0 * shift h 1 Y * shift h 1 B)
      = z * towerTr z h (Y * B) := by
    rw [mul_assoc, ← map_mul, towerTr_gen_zero_shift]
  have e2 : towerTr z h (shift h 1 Y * twGen h 0 * shift h 1 B)
      = z * towerTr z h (B * Y) := by
    rw [mul_assoc, towerTr_mul_comm, mul_assoc, ← map_mul, towerTr_gen_zero_shift]
  rw [e1, e2, towerTr_mul_comm]

/-- **Over equals under.** Conjugating `Y↑¹` by `σ₀` or by `σ₀⁻¹` gives the same trace
    against any `B↑¹`. -/
theorem towerTr_conj_over_eq_under (Y B : HeckeTower R h) :
    towerTr z h (twGen h 0 * shift h 1 Y * twGenInv h 0 * shift h 1 B)
      = towerTr z h (twGenInv h 0 * shift h 1 Y * twGen h 0 * shift h 1 B) := by
  simp only [twGenInv, mul_sub, sub_mul, mul_smul_comm, smul_mul_assoc, mul_one, one_mul,
    map_sub, map_smul]
  rw [towerTr_gen_zero_slide]

/-- `σ₀^{±1}` commute with anything placed at `↑²`. -/
theorem twGen_zero_comm_shift_two (N : HeckeTower R h) :
    twGen h 0 * shift h 2 N = shift h 2 N * twGen h 0 :=
  twH_comm_shift h 1 (twGen_mem h 0) N

theorem twGenInv_zero_comm_shift_two (N : HeckeTower R h) :
    twGenInv h 0 * shift h 2 N = shift h 2 N * twGenInv h 0 :=
  twH_comm_shift h 1 (twGenInv_mem h 0) N

theorem shift_one_one (N : HeckeTower R h) : shift h 1 (shift h 1 N) = shift h 2 N := by
  rw [shift_shift]

theorem shift_one_mul (x y : HeckeTower R h) :
    shift h 1 (x * y) = shift h 1 x * shift h 1 y := (shift h 1).map_mul x y

/-- The transported-bond-then-direct-bond word, cycled: for either sign pair `(s, t)`,
    `tr((s a↑¹ t) · a↑¹ · N↑²) = tr(s a↑¹ t · (a · N↑¹)↑¹)`. -/
theorem towerTr_rho2_regroup (s t a N : HeckeTower R h) :
    towerTr z h ((s * shift h 1 a * t) * shift h 1 a * shift h 2 N)
      = towerTr z h (s * shift h 1 a * t * shift h 1 (a * shift h 1 N)) := by
  rw [shift_one_mul, shift_one_one, mul_assoc (s * shift h 1 a * t)]

/-- **`ρ₂`, the transport sign**: with the direct bond first,
    `tr(a↑¹ · σ₀ a↑¹ σ₀⁻¹ · N↑²) = tr(a↑¹ · σ₀⁻¹ a↑¹ σ₀ · N↑²)`. -/
theorem towerTr_rho2_over_eq_under (a N : HeckeTower R h) :
    towerTr z h (shift h 1 a * (twGen h 0 * shift h 1 a * twGenInv h 0) * shift h 2 N)
      = towerTr z h (shift h 1 a * (twGenInv h 0 * shift h 1 a * twGen h 0) * shift h 2 N) := by
  have cyc : ∀ X : HeckeTower R h,
      towerTr z h (shift h 1 a * X * shift h 2 N)
        = towerTr z h (X * shift h 1 (shift h 1 N * a)) := by
    intro X
    rw [mul_assoc, towerTr_mul_comm, shift_one_mul, shift_one_one, mul_assoc]
  rw [cyc, cyc]
  exact towerTr_conj_over_eq_under z h a (shift h 1 N * a)

/-- The direct-bond-first word, cycled: for `(s, t) = (σ₀, σ₀⁻¹)`,
    `tr(a↑¹ · σ₀ a↑¹ σ₀⁻¹ · N↑²) = tr(σ₀⁻¹ a↑¹ σ₀ · (a · N↑¹)↑¹)`. -/
theorem towerTr_rho2_direct_first_cycled (a N : HeckeTower R h) :
    towerTr z h (shift h 1 a * (twGen h 0 * shift h 1 a * twGenInv h 0) * shift h 2 N)
      = towerTr z h (twGenInv h 0 * shift h 1 a * twGen h 0 * shift h 1 (a * shift h 1 N)) := by
  calc towerTr z h (shift h 1 a * (twGen h 0 * shift h 1 a * twGenInv h 0) * shift h 2 N)
      = towerTr z h ((shift h 1 a * twGen h 0 * shift h 1 a) * (twGenInv h 0 * shift h 2 N)) := by
        simp only [mul_assoc]
    _ = towerTr z h ((twGenInv h 0 * shift h 2 N) * (shift h 1 a * twGen h 0 * shift h 1 a)) :=
        towerTr_mul_comm z h _ _
    _ = towerTr z h (shift h 2 N * (twGenInv h 0 * shift h 1 a * twGen h 0 * shift h 1 a)) := by
        rw [twGenInv_zero_comm_shift_two]; simp only [mul_assoc]
    _ = towerTr z h ((twGenInv h 0 * shift h 1 a * twGen h 0 * shift h 1 a) * shift h 2 N) :=
        towerTr_mul_comm z h _ _
    _ = towerTr z h (twGenInv h 0 * shift h 1 a * twGen h 0 * shift h 1 (a * shift h 1 N)) := by
        rw [shift_one_mul, shift_one_one]; simp only [mul_assoc]

/-- **`ρ₂`, the bond order** (over transport): applying the direct bond before or after the
    transported one gives one trace. -/
theorem towerTr_rho2_order (a N : HeckeTower R h) :
    towerTr z h (shift h 1 a * (twGen h 0 * shift h 1 a * twGenInv h 0) * shift h 2 N)
      = towerTr z h ((twGen h 0 * shift h 1 a * twGenInv h 0) * shift h 1 a * shift h 2 N) := by
  rw [towerTr_rho2_direct_first_cycled, ← towerTr_conj_over_eq_under z h a (a * shift h 1 N),
    towerTr_rho2_regroup]

/-- **`ρ₂` is one number**: the four arrangements (bond order × transport sign). -/
theorem towerTr_rho2_all (a N : HeckeTower R h) :
    let t := towerTr z h (shift h 1 a * (twGen h 0 * shift h 1 a * twGenInv h 0) * shift h 2 N)
    towerTr z h (shift h 1 a * (twGenInv h 0 * shift h 1 a * twGen h 0) * shift h 2 N) = t ∧
    towerTr z h ((twGen h 0 * shift h 1 a * twGenInv h 0) * shift h 1 a * shift h 2 N) = t ∧
    towerTr z h ((twGenInv h 0 * shift h 1 a * twGen h 0) * shift h 1 a * shift h 2 N) = t := by
  intro t
  refine ⟨(towerTr_rho2_over_eq_under z h a N).symm, (towerTr_rho2_order z h a N).symm, ?_⟩
  rw [towerTr_rho2_regroup]
  exact (towerTr_rho2_direct_first_cycled z h a N).symm

/-- The corpus instance: the γγ vertex `V³`. -/
theorem towerTr_rho2_vertexCube (N : HeckeTower R h) :
    towerTr z h (shift h 1 (vertexCube h) * (twGenInv h 0 * shift h 1 (vertexCube h) * twGen h 0)
        * shift h 2 N)
      = towerTr z h (shift h 1 (vertexCube h)
          * (twGen h 0 * shift h 1 (vertexCube h) * twGenInv h 0) * shift h 2 N) :=
  (towerTr_rho2_over_eq_under z h (vertexCube h) N).symm

end GammaGammaAllPairs

end QOU.BraidKnot.HeckeFunctional
