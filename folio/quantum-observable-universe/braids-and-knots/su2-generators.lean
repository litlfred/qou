import QOU.Basic


/-!
# QOU.Su2Generators

The binary dihedral group Dic₃ (order 12, lift of S₃ ≅ D₃ to SU(2)):
generated by α = exp(2π/3 · e₃) and β = exp(π · e₁), with
α³ = β² = −I, βαβ⁻¹ = α⁻¹, [β,α] = α⁻².

LaTeX label: `def:su2-generators`

## References

- [leitner2026] Chapter 4, §SU(2)–SO(3)
-/

namespace QOU

/-- **Dic₃ generator data**: the binary dihedral group of order 12.

    Generators α, β with:
    - α³ = β² = center element (−I in SU(2))
    - βαβ⁻¹ = α⁻¹ (dihedral relation)
    - [β, α] = α⁻² (commutator) -/
-- Ref: [leitner2026] Chapter 4
structure Dic3Data where
  /-- The group carrier. -/
  G : Type*
  [grp : Group G]
  /-- Generator α (3-cycle lift). -/
  alpha : G
  /-- Generator β (2-cycle lift). -/
  beta : G
  /-- The central element (−I in SU(2)). -/
  center : G
  /-- center² = 1 (order 2). -/
  center_sq : center * center = 1
  /-- α³ = center. -/
  alpha_cubed : alpha * alpha * alpha = center
  /-- β² = center. -/
  beta_sq : beta * beta = center
  /-- Dihedral relation: βαβ⁻¹ = α⁻¹. -/
  dihedral : beta * alpha * beta⁻¹ = alpha⁻¹

attribute [instance] Dic3Data.grp

/-- Dic₃ has order 12. -/
-- Ref: [leitner2026] Chapter 4
theorem dic3_order : 2 * 2 * 3 = 12 := by norm_num

/-- The commutator [β, α] = βαβ⁻¹α⁻¹ = α⁻¹α⁻¹ = α⁻². -/
-- Ref: [leitner2026] Chapter 4
theorem commutator_eq (d : Dic3Data) :
    d.beta * d.alpha * d.beta⁻¹ * d.alpha⁻¹ = d.alpha⁻¹ * d.alpha⁻¹ := by
  rw [d.dihedral]

end QOU
