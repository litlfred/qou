/-
  Fantini–Wheeler eq. (14): the state-integral recursion lattice.

  Andersen–Kashaev state integrals I_{m,ℓ}(τ), indexed by (m,ℓ) ∈ ℤ²,
  satisfy the two-part recursion of Fantini–Wheeler,
  "Summability for state integrals of hyperbolic knots"
  (arXiv:2410.20973), eq. (14):

      ∑_{k=0}^{B} C(B,k) (−1)^k q^{−ℓk} I_{m+k,ℓ}
        = I_{m,ℓ+1}
        = (−1)^A q^{A+m} I_{m+A,ℓ}                              (FW 14)

  for (A,B) ∈ ℤ²_{>0} with A ≠ B.  FW conclude that over Q(q) there are
  exactly max{A,B} independent integrals.

  ── SCOPE (HONEST) ─────────────────────────────────────────────────
  This file does NOT prove the analytic integrals satisfy (FW 14) — that
  is FW's contour/quasi-periodicity analysis of Faddeev's quantum
  dilogarithm, which is not in Mathlib.  It formalizes (FW 14) as a
  §3b-cond hypothesis CLASS `Recursion` (carrying the two relations as
  parameter-quantified equations — the FW INPUT) and DERIVES, sorry-free,
  the ALGEBRAIC lattice structure the recursion forces on ANY R-module
  carrying such a family (the OUTPUT):

    • `row_zero_recurrence`  — combining the two relations at ℓ = 0 gives
      the single order-max{A,B} linear recurrence on the row ℓ = 0.
    • `ell_collapse`         — every I_{m,ℓ} with ℓ ≥ 0 is a NONZERO scalar
      multiple of a row-0 integral (the ℓ-direction collapses to row 0).
    • `lattice_in_row_zero_span` — hence the whole ℓ ≥ 0 lattice lies in
      the R-span of row 0 (the 2-D lattice collapses to the 1-D row 0).
    • `row_zero_solve_A`     — the A-shifted row-0 integral is an R-linear
      combination of the B-window {I_{m},…,I_{m+B}}.
    • `row_zero_top_reduction` — the top index of the order-max{A,B}
      recurrence reduces into the fundamental window
      {I_{m},…,I_{m+max{A,B}−1}} (the one-step m-direction reduction).
    • `row_zero_bot_reduction` — mirror of the above: the BOTTOM index
      I_{m,0} reduces UP into {I_{m+1},…,I_{m+max{A,B}}} (the k=0 term of
      the recurrence carries the unit coefficient 1, so no A≠B split).
    • `row_zero_in_window`   — the full two-sided ℤ reduction: EVERY row-0
      integral I_{m,0} (m ∈ ℤ) lies in the R-span of the single fixed
      window {I_{0},…,I_{max{A,B}−1}} (two ℕ-strong-inductions, top-
      reduction upward + bottom-reduction downward).
    • `row_zero_fg_bound` / `row_zero_span_fg` / `lattice_span_fg` — the
      capstone: row 0 (hence, via `lattice_in_row_zero_span`, the whole
      ℓ ≥ 0 lattice) is `Submodule.FG`, generated by ≤ max{A,B} elements.

  Anti-laundering: no class field carries a conclusion; each is the FW
  recursion itself.  The theorems DERIVE finite generation FROM the
  class — they do not assume it.  The `≤ max{A,B}` generator bound is the
  algebraic shadow of FW's "max{A,B} independent integrals" corollary.
  This proves NOTHING about the physics (c₃ / resurgent Stokes data);
  per roast qou-l7vf it is fibre-side structural scaffold for the FW
  Thm 1.4 formalization map (beans qou-h7yk / qou-523q), not a c₃ closure.

  Base ring: generic `[Field R]` (inverses of q and of the top
  coefficient are genuinely needed); §7c-clean, no ℝ/ℂ.

  Sorry-free.

  -- Ref: [fantini-wheeler2024] arXiv:2410.20973, eq. (14) and the
  --      "max{A,B} independent integrals" corollary (§1.2).
  -- Ref: [dimofte-gukov-lenells-zagier-2009] arXiv:0903.2472, §3 (the state-integral
  --      model for perturbative SL(2,ℂ) Chern–Simons theory on an ideal
  --      triangulation, built from Faddeev's quantum dilogarithm, §3.3): the
  --      earliest held source for the state-integral form used here.
-/
import Mathlib.LinearAlgebra.Span.Basic
import Mathlib.Algebra.BigOperators.Group.Finset.Basic
import Mathlib.Algebra.Field.Basic
import Mathlib.Tactic

namespace QOU.QBeta.StateIntegral

open Finset

variable {R M : Type*} [Field R] [AddCommGroup M] [Module R M]
variable {A B : ℕ} {q : R} {I : ℤ → ℤ → M}

/-- **§3b-cond hypothesis class** carrying Fantini–Wheeler eq. (14).

    `Recursion R M A B q I` asserts that the family
    `I : ℤ → ℤ → M`, `I m ℓ = I_{m,ℓ}`, satisfies the two FW relations
    for the positive integers `A ≠ B` and the deformation parameter `q`.
    Each field is the recursion itself (a parameter-quantified equation
    in `M`), NOT a conclusion — this is the FW INPUT, to be *assumed*;
    the theorems below DERIVE the algebraic lattice structure from it.

    This is the analytic content FW prove for the actual integrals; here
    it is axiomatized so the downstream algebra can be checked by Lean. -/
class Recursion (R M : Type*) [Field R] [AddCommGroup M] [Module R M]
    (A B : ℕ) (q : R) (I : ℤ → ℤ → M) : Prop where
  /-- FW setup: `A` is a positive integer. -/
  hA : 0 < A
  /-- FW setup: `B` is a positive integer. -/
  hB : 0 < B
  /-- FW setup: `A ≠ B` (so `max{A,B}` is a strict maximum). -/
  hAB : A ≠ B
  /-- Left equality of (FW 14): the raising-in-ℓ relation.
      `I_{m,ℓ+1} = ∑_{k=0}^{B} C(B,k)(−1)^k q^{−ℓk} I_{m+k,ℓ}`. -/
  relation_l : ∀ m ℓ : ℤ,
    I m (ℓ + 1)
      = ∑ k ∈ Finset.range (B + 1),
          ((B.choose k : R) * (-1) ^ k * q ^ (-(ℓ * (k : ℤ)))) • I (m + (k : ℤ)) ℓ
  /-- Right equality of (FW 14): the single-shift relation.
      `I_{m,ℓ+1} = (−1)^A q^{A+m} I_{m+A,ℓ}`. -/
  relation_r : ∀ m ℓ : ℤ,
    I m (ℓ + 1) = ((-1 : R) ^ A * q ^ ((A : ℤ) + m)) • I (m + (A : ℤ)) ℓ

/-- The order-`max{A,B}` linear recurrence on the row `ℓ = 0`, obtained
    by equating the two sides of (FW 14) at `ℓ = 0` (where `q^{−0·k} = 1`):

      `(−1)^A q^{A+m} · I_{m+A,0} = ∑_{k=0}^{B} C(B,k)(−1)^k I_{m+k,0}`.

    This relates the `max{A,B}+1` consecutive row-0 integrals
    `I_{m,0}, …, I_{m+max{A,B},0}`. -/
theorem row_zero_recurrence [inst : Recursion R M A B q I] (m : ℤ) :
    ((-1 : R) ^ A * q ^ ((A : ℤ) + m)) • I (m + (A : ℤ)) 0
      = ∑ k ∈ Finset.range (B + 1), ((B.choose k : R) * (-1) ^ k) • I (m + (k : ℤ)) 0 := by
  have hr := inst.relation_r m 0
  have hl := inst.relation_l m 0
  rw [← hr, hl]
  refine Finset.sum_congr rfl (fun k _ => ?_)
  simp only [zero_mul, neg_zero, zpow_zero, mul_one]

/-- **ℓ-collapse.** For every `n : ℕ` and `m : ℤ`, the integral `I_{m,n}`
    is a *nonzero* scalar multiple of a single row-0 integral:

      `I_{m,n} = c · I_{m + n·A, 0}`,  `c ≠ 0`.

    The ℓ-direction of the lattice is fully determined by row `ℓ = 0`.
    Proof: iterate `relation_r`; the coefficient is a product of the
    units `(−1)^A` and `q^{A+·}` (nonzero since `q ≠ 0`). -/
theorem ell_collapse [inst : Recursion R M A B q I] (hq : q ≠ 0) :
    ∀ (n : ℕ) (m : ℤ), ∃ c : R, c ≠ 0 ∧ I m (n : ℤ) = c • I (m + (n : ℤ) * (A : ℤ)) 0 := by
  intro n
  induction n with
  | zero => intro m; exact ⟨1, one_ne_zero, by simp⟩
  | succ n ih =>
      intro m
      obtain ⟨c', hc', hEq'⟩ := ih (m + (A : ℤ))
      have hr := inst.relation_r m (n : ℤ)
      have hidx : (m + (A : ℤ)) + (n : ℤ) * (A : ℤ) = m + ((n : ℤ) + 1) * (A : ℤ) := by ring
      refine ⟨((-1 : R) ^ A * q ^ ((A : ℤ) + m)) * c',
        mul_ne_zero (mul_ne_zero (pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero))
          (zpow_ne_zero _ hq)) hc', ?_⟩
      push_cast
      rw [hr, hEq', smul_smul, hidx]

/-- **2-D → 1-D collapse.** The entire `ℓ ≥ 0` half-lattice lies in the
    `R`-span of the row `ℓ = 0`.  Immediate from `ell_collapse`. -/
theorem lattice_in_row_zero_span [Recursion R M A B q I] (hq : q ≠ 0)
    (m : ℤ) (n : ℕ) :
    I m (n : ℤ) ∈ Submodule.span R (Set.range (fun j : ℤ => I j 0)) := by
  obtain ⟨c, _, hEq⟩ := ell_collapse (A := A) (B := B) (q := q) (I := I) hq n m
  rw [hEq]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨_, rfl⟩)

/-- **A-shift reduction.** The `A`-shifted row-0 integral `I_{m+A,0}` is an
    `R`-linear combination of the `B`-window `{I_{m,0}, …, I_{m+B,0}}`.
    Solve `row_zero_recurrence` for `I_{m+A,0}` (its coefficient
    `(−1)^A q^{A+m}` is a unit). -/
theorem row_zero_solve_A [Recursion R M A B q I] (hq : q ≠ 0) (m : ℤ) :
    I (m + (A : ℤ)) 0 ∈
      Submodule.span R {y : M | ∃ k : ℕ, k < B + 1 ∧ y = I (m + (k : ℤ)) 0} := by
  have hrec := row_zero_recurrence (R := R) (M := M) (A := A) (B := B) (q := q) (I := I) m
  set u : R := (-1 : R) ^ A * q ^ ((A : ℤ) + m) with hu
  have hune : u ≠ 0 :=
    mul_ne_zero (pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero)) (zpow_ne_zero _ hq)
  have hEq : I (m + (A : ℤ)) 0
      = u⁻¹ • ∑ k ∈ Finset.range (B + 1), ((B.choose k : R) * (-1) ^ k) • I (m + (k : ℤ)) 0 := by
    rw [← hrec, smul_smul, inv_mul_cancel₀ hune, one_smul]
  rw [hEq]
  apply Submodule.smul_mem
  apply Submodule.sum_mem
  intro k hk
  apply Submodule.smul_mem
  apply Submodule.subset_span
  exact ⟨k, Finset.mem_range.mp hk, rfl⟩

/-- **Top-of-window reduction (m-direction one step).**  The top index of
    the order-`max{A,B}` recurrence, `I_{m+max{A,B},0}`, lies in the span
    of the fundamental window `{I_{m,0}, …, I_{m+max{A,B}−1,0}}`.

    This is the single-step reduction that shifts any row-0 index toward a
    size-`max{A,B}` fundamental domain — the algebraic core of FW's
    "`max{A,B}` independent integrals".  Two cases on `A ≠ B`:
    if `B < A` the top is the `A`-shift (`row_zero_solve_A` + span
    monotonicity); if `A < B` the top is the `B`-term, isolated from the
    recurrence (its coefficient `(−1)^B` is a unit). -/
theorem row_zero_top_reduction [inst : Recursion R M A B q I] (hq : q ≠ 0) (m : ℤ) :
    I (m + ((max A B : ℕ) : ℤ)) 0 ∈
      Submodule.span R {y : M | ∃ j : ℕ, j < max A B ∧ y = I (m + (j : ℤ)) 0} := by
  rcases lt_or_gt_of_ne inst.hAB with hlt | hgt
  · -- A < B, so max A B = B: isolate the top (k = B) term of the recurrence.
    have hmax : max A B = B := max_eq_right (le_of_lt hlt)
    rw [hmax]
    have hrec := row_zero_recurrence (R := R) (M := M) (A := A) (B := B) (q := q) (I := I) m
    rw [Finset.sum_range_succ] at hrec
    set u : R := (-1 : R) ^ A * q ^ ((A : ℤ) + m) with hu
    set S : M := ∑ k ∈ Finset.range B, ((B.choose k : R) * (-1) ^ k) • I (m + (k : ℤ)) 0 with hS
    have hcB : ((B.choose B : R) * (-1) ^ B) ≠ 0 := by
      rw [Nat.choose_self, Nat.cast_one, one_mul]
      exact pow_ne_zero B (neg_ne_zero.mpr one_ne_zero)
    have hiso : ((B.choose B : R) * (-1) ^ B) • I (m + (B : ℤ)) 0 = u • I (m + (A : ℤ)) 0 - S :=
      eq_sub_of_add_eq' hrec.symm
    have hmem : I (m + (B : ℤ)) 0
        = ((B.choose B : R) * (-1) ^ B)⁻¹ • (u • I (m + (A : ℤ)) 0 - S) := by
      rw [← hiso, smul_smul, inv_mul_cancel₀ hcB, one_smul]
    rw [hmem]
    apply Submodule.smul_mem
    apply Submodule.sub_mem
    · apply Submodule.smul_mem
      apply Submodule.subset_span
      exact ⟨A, hlt, rfl⟩
    · rw [hS]
      apply Submodule.sum_mem
      intro k hk
      apply Submodule.smul_mem
      apply Submodule.subset_span
      exact ⟨k, Finset.mem_range.mp hk, rfl⟩
  · -- B < A, so max A B = A: the top is the A-shift; widen the B-window to A.
    have hmax : max A B = A := max_eq_left (le_of_lt hgt)
    rw [hmax]
    have hsub := row_zero_solve_A (R := R) (M := M) (A := A) (B := B) (q := q) (I := I) hq m
    refine Submodule.span_mono ?_ hsub
    rintro y ⟨k, hk, rfl⟩
    exact ⟨k, lt_of_le_of_lt (Nat.lt_succ_iff.mp hk) hgt, rfl⟩

/-- **Bottom-of-window reduction (m-direction one step, mirror image).**  The
    bottom index of the order-`max{A,B}` recurrence, `I_{m,0}`, lies in the span
    of the window *above* it, `{I_{m+1,0}, …, I_{m+max{A,B},0}}`.

    This is the mirror of `row_zero_top_reduction`: it shifts any row-0 index
    *up* toward a size-`max{A,B}` fundamental domain.  Unlike the top reduction,
    no case split on `A ≠ B` is needed — the `k = 0` term of
    `row_zero_recurrence` always carries the unit coefficient
    `C(B,0)·(−1)^0 = 1`, so `I_{m,0}` is isolated directly:

      `I_{m,0} = (−1)^A q^{A+m}·I_{m+A,0} − ∑_{k=1}^{B} C(B,k)(−1)^k I_{m+k,0}`,

    and every index on the right (`m+A` with `1 ≤ A ≤ max{A,B}`, and `m+k` with
    `1 ≤ k ≤ B ≤ max{A,B}`) lies in the up-window.  (No `hq` hypothesis: the
    isolated coefficient is `1`, so no inverse is taken.) -/
theorem row_zero_bot_reduction [inst : Recursion R M A B q I] (m : ℤ) :
    I m 0 ∈
      Submodule.span R {y : M | ∃ j : ℕ, 1 ≤ j ∧ j ≤ max A B ∧ y = I (m + (j : ℤ)) 0} := by
  have hrec := row_zero_recurrence (R := R) (M := M) (A := A) (B := B) (q := q) (I := I) m
  rw [Finset.sum_range_succ'] at hrec
  simp only [Nat.choose_zero_right, Nat.cast_one, pow_zero, mul_one, Nat.cast_zero,
    add_zero, one_smul] at hrec
  -- hrec : u • I (m+A) 0 = (∑ k ∈ range B, C(B,k+1)(-1)^(k+1) • I (m+(k+1)) 0) + I m 0
  have hIm : I m 0
      = ((-1 : R) ^ A * q ^ ((A : ℤ) + m)) • I (m + (A : ℤ)) 0
        - ∑ k ∈ Finset.range B,
            ((B.choose (k + 1) : R) * (-1) ^ (k + 1)) • I (m + ((k + 1 : ℕ) : ℤ)) 0 :=
    eq_sub_of_add_eq' hrec.symm
  rw [hIm]
  apply Submodule.sub_mem
  · apply Submodule.smul_mem
    apply Submodule.subset_span
    exact ⟨A, inst.hA, le_max_left A B, rfl⟩
  · apply Submodule.sum_mem
    intro k hk
    apply Submodule.smul_mem
    apply Submodule.subset_span
    exact ⟨k + 1, Nat.succ_pos k,
      le_trans (Nat.succ_le_of_lt (Finset.mem_range.mp hk)) (le_max_right A B), rfl⟩

/-- **Two-sided ℤ reduction of row 0 into a fixed size-`max{A,B}` window.**
    Every row-0 integral `I_{m,0}`, for *any* `m ∈ ℤ`, lies in the `R`-span of
    the single fundamental window `{I_{0,0}, I_{1,0}, …, I_{max{A,B}−1,0}}`.

    This is the full finite-generation core FW's "`max{A,B}` independent
    integrals" corollary rests on: the entire two-sided row `ℓ = 0` reduces into
    one size-`max{A,B}` window.  The proof is two `ℕ`-indexed strong inductions:

    * **upward** (`hUp`, `∀ n : ℕ, I_{n,0} ∈ W`): indices `< max{A,B}` are window
      generators; an index `n ≥ max{A,B}` is pushed *down* by
      `row_zero_top_reduction` (base `n − max{A,B}`) into `{I_{n−max,0}, …,
      I_{n−1,0}}`, every element of which is a strictly-smaller natural index —
      strong IH.
    * **downward** (`hDown`, `∀ n : ℕ, I_{−n−1,0} ∈ W`): `row_zero_bot_reduction`
      pushes `I_{−n−1,0}` *up* into `{I_{−n,0}, …, I_{−n−1+max,0}}`; each element
      is either a nonnegative index (covered by `hUp`) or a strictly-smaller
      negative index — strong IH. -/
theorem row_zero_in_window [inst : Recursion R M A B q I] (hq : q ≠ 0) (m : ℤ) :
    I m 0 ∈ Submodule.span R {y : M | ∃ j : ℕ, j < max A B ∧ y = I (j : ℤ) 0} := by
  -- upward direction: every nonnegative row-0 index reduces into the window
  have hUp : ∀ n : ℕ,
      I (n : ℤ) 0 ∈ Submodule.span R {y : M | ∃ j : ℕ, j < max A B ∧ y = I (j : ℤ) 0} := by
    intro n
    induction n using Nat.strongRecOn with
    | _ n ih =>
      by_cases hn : n < max A B
      · exact Submodule.subset_span ⟨n, hn, rfl⟩
      · push_neg at hn
        have htop := row_zero_top_reduction (R := R) (M := M) (A := A) (B := B) (q := q)
          (I := I) hq ((n : ℤ) - ((max A B : ℕ) : ℤ))
        have hidx : (n : ℤ) - ((max A B : ℕ) : ℤ) + ((max A B : ℕ) : ℤ) = (n : ℤ) := by ring
        rw [hidx] at htop
        refine (Submodule.span_le.mpr ?_) htop
        rintro y ⟨j, hj, rfl⟩
        have hpi : (n : ℤ) - ((max A B : ℕ) : ℤ) + (j : ℤ) = ((n - max A B + j : ℕ) : ℤ) := by
          push_cast [Nat.cast_sub hn]; ring
        rw [hpi]
        exact ih (n - max A B + j) (by omega)
  -- downward direction: every negative row-0 index reduces into the window
  have hDown : ∀ n : ℕ,
      I (-(n : ℤ) - 1) 0 ∈ Submodule.span R {y : M | ∃ j : ℕ, j < max A B ∧ y = I (j : ℤ) 0} := by
    intro n
    induction n using Nat.strongRecOn with
    | _ n ih =>
      have hbot := row_zero_bot_reduction (R := R) (M := M) (A := A) (B := B) (q := q)
        (I := I) (-(n : ℤ) - 1)
      refine (Submodule.span_le.mpr ?_) hbot
      rintro y ⟨j, hj1, hjN, rfl⟩
      rcases le_or_gt 0 ((-(n : ℤ) - 1) + (j : ℤ)) with hpos | hneg
      · rw [show (-(n : ℤ) - 1) + (j : ℤ)
            = (((-(n : ℤ) - 1) + (j : ℤ)).toNat : ℤ) from (Int.toNat_of_nonneg hpos).symm]
        exact hUp _
      · have hjn : j ≤ n := by omega
        rw [show (-(n : ℤ) - 1) + (j : ℤ) = -((n - j : ℕ) : ℤ) - 1 by
          push_cast [Nat.cast_sub hjn]; ring]
        exact ih (n - j) (by omega)
  -- combine: dispatch on the sign of m
  rcases lt_or_ge m 0 with hm | hm
  · have hnn : (0 : ℤ) ≤ -m - 1 := by omega
    have heq : (((-m - 1).toNat : ℤ)) = -m - 1 := Int.toNat_of_nonneg hnn
    have hm2 : m = -(((-m - 1).toNat : ℤ)) - 1 := by rw [heq]; ring
    rw [hm2]; exact hDown ((-m - 1).toNat)
  · have hm2 : m = ((m.toNat : ℤ)) := (Int.toNat_of_nonneg hm).symm
    rw [hm2]; exact hUp m.toNat

/-- **Finite generation with an explicit `≤ max{A,B}` bound.**  The row-0
    submodule `span R {I_{j,0} : j ∈ ℤ}` is generated by the explicit finite set
    `{I_{0,0}, …, I_{max{A,B}−1,0}}` — a `Finset` of cardinality `≤ max{A,B}`.

    This is the literal "`max{A,B}` independent integrals" bound of FW: `≥`
    is `row_zero_in_window` (every generator reduces into the window), `≤` is
    that each window element is itself a row-0 integral. -/
theorem row_zero_fg_bound [Recursion R M A B q I] (hq : q ≠ 0) :
    ∃ s : Finset M, s.card ≤ max A B ∧
      Submodule.span R (s : Set M) = Submodule.span R (Set.range (fun j : ℤ => I j 0)) := by
  classical
  refine ⟨(Finset.range (max A B)).image (fun j : ℕ => I (j : ℤ) 0), ?_, ?_⟩
  · calc ((Finset.range (max A B)).image (fun j : ℕ => I (j : ℤ) 0)).card
        ≤ (Finset.range (max A B)).card := Finset.card_image_le
      _ = max A B := Finset.card_range _
  · apply le_antisymm
    · rw [Submodule.span_le]
      intro y hy
      rw [Finset.coe_image] at hy
      obtain ⟨j, _, rfl⟩ := hy
      exact Submodule.subset_span ⟨(j : ℤ), rfl⟩
    · rw [Submodule.span_le]
      rintro y ⟨j, rfl⟩
      have hw := row_zero_in_window (R := R) (M := M) (A := A) (B := B) (q := q) (I := I) hq j
      refine (Submodule.span_le.mpr ?_) hw
      rintro z ⟨k, hk, rfl⟩
      apply Submodule.subset_span
      rw [Finset.coe_image]
      exact ⟨k, Finset.mem_coe.mpr (Finset.mem_range.mpr hk), rfl⟩

/-- **Row 0 is finitely generated.**  The submodule spanned by the entire
    two-sided row `ℓ = 0` is `Submodule.FG` (by `≤ max{A,B}` generators, via
    `row_zero_fg_bound`). -/
theorem row_zero_span_fg [Recursion R M A B q I] (hq : q ≠ 0) :
    (Submodule.span R (Set.range (fun j : ℤ => I j 0))).FG := by
  obtain ⟨s, _, hs⟩ := row_zero_fg_bound (R := R) (M := M) (A := A) (B := B) (q := q) (I := I) hq
  exact ⟨s, hs⟩

/-- **The whole `ℓ ≥ 0` lattice is finitely generated.**  Composing
    `lattice_in_row_zero_span` (the 2-D → 1-D collapse) with `row_zero_span_fg`,
    the submodule spanned by every `I_{m,ℓ}` with `ℓ ≥ 0` coincides with the
    row-0 submodule and is therefore `Submodule.FG` (by `≤ max{A,B}`
    generators). -/
theorem lattice_span_fg [Recursion R M A B q I] (hq : q ≠ 0) :
    (Submodule.span R (Set.range (fun p : ℤ × ℕ => I p.1 (p.2 : ℤ)))).FG := by
  have hEq : Submodule.span R (Set.range (fun p : ℤ × ℕ => I p.1 (p.2 : ℤ)))
      = Submodule.span R (Set.range (fun j : ℤ => I j 0)) := by
    apply le_antisymm
    · rw [Submodule.span_le]
      rintro y ⟨⟨m, n⟩, rfl⟩
      exact lattice_in_row_zero_span (R := R) (M := M) (A := A) (B := B) (q := q) (I := I) hq m n
    · rw [Submodule.span_le]
      rintro y ⟨j, rfl⟩
      exact Submodule.subset_span ⟨(j, 0), by simp⟩
  rw [hEq]
  exact row_zero_span_fg (R := R) (M := M) (A := A) (B := B) (q := q) (I := I) hq

end QOU.QBeta.StateIntegral
