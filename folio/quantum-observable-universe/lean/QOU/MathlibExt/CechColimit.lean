import QOU.MathlibExt.CechGerbe

/-!
# Čech `H²` across covers: refinement maps and a cover-independent class

Step G1 of the gerbe layer (bean `qou-skn4`). `QOU.MathlibExt.CechGerbe` gives
Čech `H²` of a presheaf of groups on **one** family `U : I → C`. This file
moves the theory off the single cover.

## Results, all sorry-free

* `TwoCocycle.pull`: a 2-cocycle pulls back along a refinement `f : V j ⟶ U (r j)`.
* `TwoCocycle.Rel.pull`, `H2.pull`: cohomologous cocycles pull back to
  cohomologous ones, so refinement induces a map `H2 U 𝒜 → H2 V 𝒜`;
  `H2.pull_one`: it sends the trivial class to the trivial class.
* `Cover X`: a family of arrows into `X`. `Cover.Refines`: a refinement
  over `X`.
* `CechH2 𝒜 Cov`: the colimit of `H2 U 𝒜` over the covers of `X` allowed by
  a predicate `Cov` (for example: generating a covering sieve). It is the
  quotient of `Σ (cover, 2-cocycle)` by the relation generated by
  "pull back along a refinement" and "cohomologous on the same cover".
  This is the colimit of sets for any diagram shape; no pullbacks and no
  filteredness are assumed.
* `cechClass_pull`: a class and its pullback to a refinement agree in the
  colimit.
* `PresheafCentralExtension.cechObstruction`, `cechObstruction_indep_lift`,
  `cechObstruction_pull`: the obstruction class of lifting a torsor along
  a central extension (T2b) is a well-defined element of the colimit. It
  does not depend on the local lift, and it is unchanged under refinement.
* `cechObstruction_eq_one_of_lift`: if `γ` lifts on the cover, its colimit
  class is trivial.

## What is NOT proved here (honest scope)

* The **converse** "trivial in the colimit ⇒ lifts on some refinement". The
  colimit relation is an equivalence closure (`EqvGen`), and inverting it needs
  the system of covers to be **filtered**: common refinements, i.e. pullbacks
  in `C` and a Grothendieck topology. That is step G1b (see bean `qou-skn4`).
* The scope note for G1 proposed proving "vanishing on a refinement ⇒
  vanishing on the coarse cover". That is the refinement map being
  **injective** on `H²`. For sheaves the refinement map is injective in
  degree 1; in degree 2 no such statement is standard, so it is not claimed
  here, and the colimit is the right home for the cover-independent statement.
-/

-- Ref: [manuscript] lifting-and-descent, bean qou-skn4 (gerbe layer G1)

universe w' w v u

namespace QOU.CentralExtension.CechGerbe

open CategoryTheory Opposite QOU.CentralExtension

variable {C : Type u} [Category.{v} C]

/-! ### Pulling 2-cocycles and classes back along a refinement -/

section Pull

variable {I J : Type w'} {U : I → C} {V : J → C} (r : J → I) (f : ∀ j, V j ⟶ U (r j))
variable {𝒜 : Cᵒᵖ ⥤ GrpCat.{w}}

/-- Pull a 2-cocycle back along a refinement. -/
def TwoCocycle.pull (c : TwoCocycle U 𝒜) : TwoCocycle V 𝒜 where
  toTwoCochain := pullTwoCochain U r f c.toTwoCochain
  cocycle _ _ _ _ _ _ _ _ _ := c.cocycle _ _ _ _ _ _ _ _

@[simp] theorem TwoCocycle.pull_ev (c : TwoCocycle U 𝒜) (j j' j'' : J) ⦃T : C⦄
    (a : T ⟶ V j) (b : T ⟶ V j') (d : T ⟶ V j'') :
    (c.pull r f).ev j j' j'' a b d = c.ev (r j) (r j') (r j'') (a ≫ f j) (b ≫ f j') (d ≫ f j'') :=
  rfl

theorem TwoCocycle.one_pull : (TwoCocycle.one : TwoCocycle U 𝒜).pull r f = TwoCocycle.one :=
  rfl

/-- Cohomologous cocycles pull back to cohomologous cocycles. -/
theorem TwoCocycle.Rel.pull {c₁ c₂ : TwoCocycle U 𝒜} (h : TwoCocycle.Rel c₁ c₂) :
    TwoCocycle.Rel (c₁.pull r f) (c₂.pull r f) := by
  obtain ⟨α, hα⟩ := h
  exact ⟨pullOneCochain U r f α, fun j j' j'' T a b d => hα _ _ _ _ _ _⟩

/-- The refinement map on Čech `H²`. -/
def H2.pull : H2 U 𝒜 → H2 V 𝒜 :=
  Quot.lift (fun c => (c.pull r f).class) (fun _ _ h => Quot.sound (h.pull r f))

@[simp] theorem H2.pull_class (c : TwoCocycle U 𝒜) :
    H2.pull r f c.class = (c.pull r f).class := rfl

theorem H2.pull_one : H2.pull r f (1 : H2 U 𝒜) = 1 := rfl

end Pull

/-! ### Covers of an object and their refinements -/

/-- A family of arrows into `X`, indexed by a type in universe `w'`. -/
structure Cover (X : C) where
  /-- the index type -/
  ι : Type w'
  /-- the objects of the family -/
  obj : ι → C
  /-- the arrows into `X` -/
  arr : ∀ i, obj i ⟶ X

/-- `𝒱` refines `𝒰` over `X`: every member of `𝒱` maps into some member of `𝒰`,
compatibly with the arrows to `X`. -/
structure Cover.Refines {X : C} (𝒱 𝒰 : Cover.{w'} X) where
  /-- which member of `𝒰` each member of `𝒱` lands in -/
  r : 𝒱.ι → 𝒰.ι
  /-- the comparison arrows -/
  f : ∀ j, 𝒱.obj j ⟶ 𝒰.obj (r j)
  w : ∀ j, f j ≫ 𝒰.arr (r j) = 𝒱.arr j

/-! ### The colimit `Ȟ²` over covers -/

section Colimit

variable {X : C} (𝒜 : Cᵒᵖ ⥤ GrpCat.{w}) (Cov : Cover.{w'} X → Prop)

/-- A 2-cocycle on an admissible cover. -/
structure CoverCocycle where
  /-- the cover -/
  cov : Cover.{w'} X
  /-- it is admissible (for example, it generates a covering sieve) -/
  adm : Cov cov
  /-- the cocycle on it -/
  c : TwoCocycle cov.obj 𝒜

variable {𝒜 Cov}

/-- One step of the colimit relation: refining the cover, or changing the
cocycle within its class on the same cover. -/
inductive CoverCocycle.Step : CoverCocycle 𝒜 Cov → CoverCocycle 𝒜 Cov → Prop
  | refine (x : CoverCocycle 𝒜 Cov) (𝒱 : Cover.{w'} X) (h𝒱 : Cov 𝒱) (ρ : 𝒱.Refines x.cov) :
      Step x ⟨𝒱, h𝒱, x.c.pull ρ.r ρ.f⟩
  | coh (𝒰 : Cover.{w'} X) (h𝒰 : Cov 𝒰) (c₁ c₂ : TwoCocycle 𝒰.obj 𝒜)
      (h : TwoCocycle.Rel c₁ c₂) : Step ⟨𝒰, h𝒰, c₁⟩ ⟨𝒰, h𝒰, c₂⟩

variable (𝒜 Cov) in
/-- **Čech `H²` over all admissible covers of `X`**: the colimit (of sets) of
`H2 U 𝒜` along refinements. -/
def CechH2 := Quot (CoverCocycle.Step (𝒜 := 𝒜) (Cov := Cov))

/-- The colimit class of a cocycle on an admissible cover. -/
def cechClass (𝒰 : Cover.{w'} X) (h𝒰 : Cov 𝒰) (c : TwoCocycle 𝒰.obj 𝒜) : CechH2 𝒜 Cov :=
  Quot.mk _ ⟨𝒰, h𝒰, c⟩

/-- The colimit class depends only on the class in `H2` of the cover. -/
theorem cechClass_eq_of_rel (𝒰 : Cover.{w'} X) (h𝒰 : Cov 𝒰) {c₁ c₂ : TwoCocycle 𝒰.obj 𝒜}
    (h : TwoCocycle.Rel c₁ c₂) : cechClass 𝒰 h𝒰 c₁ = cechClass 𝒰 h𝒰 c₂ :=
  Quot.sound (.coh 𝒰 h𝒰 c₁ c₂ h)

/-- **Cover independence.** A class and its pullback to an admissible
refinement agree in the colimit. -/
theorem cechClass_pull (𝒰 𝒱 : Cover.{w'} X) (h𝒰 : Cov 𝒰) (h𝒱 : Cov 𝒱) (ρ : 𝒱.Refines 𝒰)
    (c : TwoCocycle 𝒰.obj 𝒜) :
    cechClass 𝒱 h𝒱 (c.pull ρ.r ρ.f) = cechClass 𝒰 h𝒰 c :=
  (Quot.sound (.refine ⟨𝒰, h𝒰, c⟩ 𝒱 h𝒱 ρ)).symm

/-- The map `H2 U 𝒜 → CechH2` for an admissible cover. -/
def H2.toCech (𝒰 : Cover.{w'} X) (h𝒰 : Cov 𝒰) : H2 𝒰.obj 𝒜 → CechH2 𝒜 Cov :=
  Quot.lift (cechClass 𝒰 h𝒰) (fun _ _ h => cechClass_eq_of_rel 𝒰 h𝒰 h)

/-- The maps `H2 U 𝒜 → CechH2` form a cocone over refinement. -/
theorem H2.toCech_pull (𝒰 𝒱 : Cover.{w'} X) (h𝒰 : Cov 𝒰) (h𝒱 : Cov 𝒱) (ρ : 𝒱.Refines 𝒰)
    (x : H2 𝒰.obj 𝒜) : H2.toCech 𝒱 h𝒱 (H2.pull ρ.r ρ.f x) = H2.toCech 𝒰 h𝒰 x := by
  induction x using Quot.ind with
  | mk c => exact cechClass_pull 𝒰 𝒱 h𝒰 h𝒱 ρ c

/-- The trivial class of one admissible cover is the trivial class of any
admissible cover it refines. -/
theorem cechClass_one_pull (𝒰 𝒱 : Cover.{w'} X) (h𝒰 : Cov 𝒰) (h𝒱 : Cov 𝒱) (ρ : 𝒱.Refines 𝒰) :
    cechClass 𝒱 h𝒱 (TwoCocycle.one : TwoCocycle 𝒱.obj 𝒜) =
      cechClass 𝒰 h𝒰 (TwoCocycle.one : TwoCocycle 𝒰.obj 𝒜) :=
  cechClass_pull 𝒰 𝒱 h𝒰 h𝒱 ρ TwoCocycle.one

end Colimit

/-! ### The lifting obstruction as a cover-independent class -/

end QOU.CentralExtension.CechGerbe

namespace QOU.CentralExtension.PresheafCentralExtension

open CategoryTheory Opposite QOU.CentralExtension QOU.CentralExtension.CechGerbe

variable {C : Type u} [Category.{v} C]

variable {X : C} {𝒜 𝓔 𝒢 : Cᵒᵖ ⥤ GrpCat.{w}} (E : PresheafCentralExtension 𝒜 𝓔 𝒢)
variable {Cov : Cover.{w'} X → Prop} (𝒰 : Cover.{w'} X) (h𝒰 : Cov 𝒰)
variable (γ : PresheafOfGroups.OneCocycle 𝒢 𝒰.obj) (ξ : PresheafOfGroups.OneCochain 𝓔 𝒰.obj)
  (hξ : ∀ (i j : 𝒰.ι) ⦃T : C⦄ (a : T ⟶ 𝒰.obj i) (b : T ⟶ 𝒰.obj j),
    E.π.app (op T) (ξ.ev i j a b) = γ.ev i j a b)

/-- The obstruction 2-cochain, packaged as a 2-cocycle. -/
noncomputable def obstructionCocycle : TwoCocycle 𝒰.obj 𝒜 where
  toTwoCochain := E.obstruction γ ξ hξ
  cocycle := E.obstruction_cocycle γ ξ hξ

/-- **The obstruction class in the colimit `Ȟ²`** of lifting the `𝒢`-torsor
`γ` along the central extension. -/
noncomputable def cechObstruction : CechH2 𝒜 Cov :=
  cechClass 𝒰 h𝒰 (E.obstructionCocycle 𝒰 γ ξ hξ)

/-- It does not depend on the local lift. -/
theorem cechObstruction_indep_lift (ξ' : PresheafOfGroups.OneCochain 𝓔 𝒰.obj)
    (hξ' : ∀ (i j : 𝒰.ι) ⦃T : C⦄ (a : T ⟶ 𝒰.obj i) (b : T ⟶ 𝒰.obj j),
      E.π.app (op T) (ξ'.ev i j a b) = γ.ev i j a b) :
    E.cechObstruction 𝒰 h𝒰 γ ξ hξ = E.cechObstruction 𝒰 h𝒰 γ ξ' hξ' := by
  obtain ⟨t, ht⟩ := E.obstruction_lift_change γ ξ hξ ξ' hξ'
  exact cechClass_eq_of_rel 𝒰 h𝒰 ⟨t, ht⟩

/-- **It does not depend on the cover.** Pulling the torsor and its local lift
back to an admissible refinement gives the same colimit class. -/
theorem cechObstruction_pull (𝒱 : Cover.{w'} X) (h𝒱 : Cov 𝒱) (ρ : 𝒱.Refines 𝒰) :
    E.cechObstruction 𝒱 h𝒱 (pullOneCocycle 𝒰.obj ρ.r ρ.f γ) (pullOneCochain 𝒰.obj ρ.r ρ.f ξ)
        (fun j j' _ a b => hξ (ρ.r j) (ρ.r j') (a ≫ ρ.f j) (b ≫ ρ.f j')) =
      E.cechObstruction 𝒰 h𝒰 γ ξ hξ := by
  unfold cechObstruction
  rw [← cechClass_pull 𝒰 𝒱 h𝒰 h𝒱 ρ]
  congr 1

/-- If `γ` lifts to an `𝓔`-cocycle on the cover, its colimit class is trivial. -/
theorem cechObstruction_eq_one_of_lift
    (hlift : ∃ η : PresheafOfGroups.OneCocycle 𝓔 𝒰.obj, ∀ (i j : 𝒰.ι) ⦃T : C⦄
      (a : T ⟶ 𝒰.obj i) (b : T ⟶ 𝒰.obj j), E.π.app (op T) (η.ev i j a b) = γ.ev i j a b) :
    E.cechObstruction 𝒰 h𝒰 γ ξ hξ = cechClass 𝒰 h𝒰 TwoCocycle.one := by
  obtain ⟨α, hα⟩ := (E.exists_lift_iff γ ξ hξ).1 hlift
  refine (cechClass_eq_of_rel 𝒰 h𝒰 ⟨α, fun i j k T a b d => ?_⟩).symm
  change (E.obstruction γ ξ hξ).ev i j k a b d = 1 * _
  rw [hα, one_mul]

end QOU.CentralExtension.PresheafCentralExtension
