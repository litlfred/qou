import QOU.MathlibExt.TowerSpanReduction
import Mathlib.Algebra.MonoidAlgebra.Basic
import Mathlib.Data.ZMod.Basic

/-!
# A `TowerSpan` witness whose filtration actually GROWS

Bean `qou-301d`. This exists to answer a specific criticism made of
`DisjointBlockTraceLaw.towerSpan_unit`, in that file's own docstring: it is a
**degenerate** witness. Its algebra is `R` itself, so every submodule containing
`1` is already `⊤`; and its filtration is constant, so
`towerSpan_of_constant` covers it for reasons unrelated to anything `TowerSpan`
asserts.

This file supplies a witness without that defect.

## The construction

`A = MonoidAlgebra R G` with `G = Multiplicative (ℕ →₀ ZMod 2)` — countably many
**commuting involutions** `t m`. The tower is `H n = adjoin {t m | m < n}`, the
generators are `g m = ginv m = t m`, and the trace is the **augmentation**, with
`z = z' = 1`.

* `t_mul_t` — `t m * t m = 1`, so the quadratic relation holds with `h = 0`.
* `sandwichReduces_involution` — `SandwichReduces` holds, and **non-trivially**:
  `t * c * t = c * (t * t) = c` uses commutativity *and* the involution relation.
  This is the local rewriting rule of `TowerSpanReduction` doing real work.
* `towerSpan_involution` — hence `TowerSpan`, via
  `towerSpan_of_sandwichReduces`.
* `t_not_mem_shiftedUpTo` — **the filtration genuinely grows**: `t N` is not in
  `shiftedUpTo n M` for `M < N`. Proved by exhibiting an algebra endomorphism
  (`killN`, induced by the coordinate projection that kills index `N`) which
  fixes every generator of the stage but sends `t N` to `1`; if `t N` were in the
  stage it would be fixed, forcing `t N = 1`, which `t_ne_one` refutes.

## 🛑 What this witness still does NOT exercise

**The trace is an algebra homomorphism.** So `DisjointBlockMultiplicative` holds
here for *every* pair `a, b` — disjointness plays no part — and the witness
therefore tests the **filtration** content of `TowerSpan` while saying nothing
about its **trace** content.

That is a real limitation and it is stated here rather than left for a reader to
discover: this file removes the *constant-filtration* objection to
`towerSpan_unit`, and only that one. A witness with a growing filtration **and** a
non-multiplicative trace would essentially be a Hecke or symmetric-group tower,
which Mathlib does not supply.

-- Ref: [leitner2026] bean qou-301d.
-/

namespace QOU.MathlibExt.InvolutionTowerWitness
open QOU.MathlibExt.OcneanuTrace QOU.MathlibExt.DisjointBlockTrace
open QOU.MathlibExt.TowerSpanReduction

variable (R : Type*) [CommRing R]

/-- Countably many commuting involutions. -/
abbrev G : Type := Multiplicative (ℕ →₀ ZMod 2)

/-- The `m`-th involution. -/
noncomputable def t (m : ℕ) : MonoidAlgebra R (G) :=
  MonoidAlgebra.single (Multiplicative.ofAdd (Finsupp.single m (1 : ZMod 2))) (1 : R)

theorem t_mul_t (m : ℕ) : t R m * t R m = 1 := by
  have h2 : (1 : ZMod 2) + 1 = 0 := by decide
  unfold t
  rw [MonoidAlgebra.single_mul_single, mul_one, ← ofAdd_add, ← Finsupp.single_add, h2,
    Finsupp.single_zero]
  rfl

/-- The augmentation, as an algebra hom. -/
noncomputable def aug : MonoidAlgebra R (G) →ₐ[R] R :=
  MonoidAlgebra.lift R (G) R 1

@[simp] theorem aug_t (m : ℕ) : aug R (t R m) = 1 := by
  simp [aug, t, MonoidAlgebra.lift_single]

/-- The tower: level `n` is generated by the first `n` involutions. -/
noncomputable def Hlev (n : ℕ) : Subalgebra R (MonoidAlgebra R (G)) :=
  Algebra.adjoin R {x | ∃ m, m < n ∧ x = t R m}

theorem Hlev_mono : Monotone (Hlev R) := by
  intro a b hab
  refine Algebra.adjoin_le ?_
  rintro x ⟨m, hm, rfl⟩
  exact Algebra.subset_adjoin ⟨m, lt_of_lt_of_le hm hab, rfl⟩

/-- **A `MarkovTrace` on commuting involutions**, with the augmentation as trace
and `z = z' = 1`. -/
noncomputable def involutionTrace : MarkovTrace R (MonoidAlgebra R (G)) where
  H := Hlev R
  H_mono := Hlev_mono R
  g := t R
  g_mem n := Algebra.subset_adjoin ⟨n, by omega, rfl⟩
  ginv := t R
  ginv_mem n := Algebra.subset_adjoin ⟨n, by omega, rfl⟩
  ginv_mul n := t_mul_t R n
  mul_ginv n := t_mul_t R n
  tr := (aug R).toLinearMap
  tr_mul_comm a b := by simp [mul_comm]
  tr_one := by simp
  z := 1
  zinv := 1
  markov := by
    intro n a _
    simp [aug_t]
  markov_inv := by
    intro n a _
    simp [aug_t]

theorem sandwichReduces_involution (B : Subalgebra R (MonoidAlgebra R (G))) (m : ℕ) :
    SandwichReduces (involutionTrace R) B m := by
  intro c hc
  have e : (involutionTrace R).g m * c * (involutionTrace R).g m = c := by
    show t R m * c * t R m = c
    rw [mul_comm (t R m) c, mul_assoc, t_mul_t, mul_one]
  rw [e]
  exact base_le_P _ B m hc

theorem quad_involution (m : ℕ) :
    (involutionTrace R).g m * (involutionTrace R).g m
      = (0 : R) • (involutionTrace R).g m + 1 := by
  show t R m * t R m = _
  rw [t_mul_t]; simp

/-- **The witness satisfies `TowerSpan`.** -/
noncomputable instance towerSpan_involution : TowerSpan (involutionTrace R) :=
  towerSpan_of_sandwichReduces (involutionTrace R)
    (fun m => ⟨0, quad_involution R m⟩)
    (fun n M => sandwichReduces_involution R _ (M + 1))

/-- Projection killing coordinate `N`, as an algebra endomorphism. -/
noncomputable def killN (N : ℕ) : MonoidAlgebra R (G) →ₐ[R] MonoidAlgebra R (G) :=
  MonoidAlgebra.mapDomainAlgHom R R
    (AddMonoidHom.toMultiplicative (Finsupp.filterAddHom (fun k => k ≠ N)))

theorem killN_single (f : ℕ →₀ ZMod 2) (N : ℕ) :
    killN R N (MonoidAlgebra.single (Multiplicative.ofAdd f) (1 : R))
      = MonoidAlgebra.single (Multiplicative.ofAdd
          (Finsupp.filter (fun k => k ≠ N) f)) (1 : R) := by
  simp [killN, MonoidAlgebra.mapDomainAlgHom, MonoidAlgebra.mapDomainRingHom,
    MonoidAlgebra.mapDomain_single]
  rfl

theorem killN_t_of_ne (N m : ℕ) (h : m ≠ N) : killN R N (t R m) = t R m := by
  rw [t, killN_single, Finsupp.filter_single_of_pos (fun k => k ≠ N) h]

theorem killN_t_self (N : ℕ) : killN R N (t R N) = 1 := by
  rw [t, killN_single, Finsupp.filter_single_of_neg (fun k => k ≠ N) (by simp)]
  rfl

theorem ofAdd_single_ne_one (N : ℕ) :
    Multiplicative.ofAdd (Finsupp.single N (1 : ZMod 2)) ≠ 1 := by
  intro hh
  have h0 : (Finsupp.single N (1 : ZMod 2)) = 0 := hh
  have h1 := congrArg (fun f : ℕ →₀ ZMod 2 => f N) h0
  simp at h1

theorem t_ne_one [Nontrivial R] (N : ℕ) : t R N ≠ 1 := by
  intro h
  have key := congrArg (fun x : MonoidAlgebra R (G) => x 1) h
  simp only [t, MonoidAlgebra.one_def, MonoidAlgebra.single_apply] at key
  rw [if_neg (ofAdd_single_ne_one N)] at key
  simp at key

/-- **The filtration GROWS** — the property `towerSpan_unit` lacks. -/
theorem t_not_mem_shiftedUpTo [Nontrivial R] (n M N : ℕ) (hN : M < N) :
    t R N ∉ shiftedUpTo (involutionTrace R) n M := by
  intro hmem
  have hfix : shiftedUpTo (involutionTrace R) n M
      ≤ AlgHom.equalizer (killN R N) (AlgHom.id R (MonoidAlgebra R (G))) := by
    refine Algebra.adjoin_le ?_
    rintro x ⟨m, _, hmM, rfl | rfl⟩ <;>
      exact (AlgHom.mem_equalizer _ _ _).2 (killN_t_of_ne R N m (by omega))
  have hEq := (AlgHom.mem_equalizer _ _ _).1 (hfix hmem)
  rw [killN_t_self, AlgHom.id_apply] at hEq
  exact t_ne_one R N hEq.symm

end QOU.MathlibExt.InvolutionTowerWitness
