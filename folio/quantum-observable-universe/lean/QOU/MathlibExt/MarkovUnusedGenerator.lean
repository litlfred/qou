import Mathlib.Algebra.Algebra.Subalgebra.Basic
import Mathlib.Algebra.Algebra.Subalgebra.Lattice
import Mathlib.Algebra.Module.LinearMap.Basic
import Mathlib.Data.List.Sort
import Mathlib.Tactic.Ring
import QOU.MathlibExt.MarkovBondRule

/-!
# The bond rule at an unused generator, derived

`QOU.MathlibExt.MarkovBondRule.BondRule` carried, as an unproved hypothesis,
the one trace-level input of the bond-product formula. `MarkovBondLinear`
removed the parameter `d` from it, leaving exactly one open equation:

  `tr (W * σ_g) = z * tr W`   for a monotone word `W` not using generator `g`.

**This file proves that equation** from the Markov-trace axioms. Nothing here
is assumed about `q`, about the Hecke relation, or about which convention fixes
`z`: the argument uses only that `tr` is a linear trace on a tower of
subalgebras, that generators far apart commute, and the Markov property at the
top of the tower.

## Why it is not simply the Markov property

The Markov property is a statement about the *last* generator: `tr (a * σ_n) =
z * tr a` for `a ∈ H_n`. The bond generators of an atom word are **interior** —
there are strands above them — so the rule has the *form* of the Markov
property without being an instance of it. What licenses it is that `g` is
*unused*: the word splits across the gap into two commuting sub-towers.

## The proof

Induction on the word, peeling the **top** letter `σ_m` (available because the
word is monotone: each generator occurs once, in increasing order). Three cases:

* `m < g` — every letter is below `g`, so the whole word lies in `H_g` and the
  Markov property applies directly. No induction needed.
* `g + 2 ≤ m` — `σ_m` and `σ_g` commute, so `σ_g` slides down past the top
  letter; Markov at `m` peels `σ_m`, and the induction hypothesis finishes.
* `m = g + 1` — the one case where neither move is available. Cyclicity of the
  trace rotates `σ_g` to the front, `σ_g * W` lands in `H_{g+1}`, Markov at
  `g + 1` peels `σ_{g+1}`, cyclicity rotates back, and Markov at `g` finishes.

The `m = g + 1` case is the reason this needs the trace property and not merely
linearity.

## Scope

`MarkovTower` axiomatises the Jones/Ocneanu trace on the `H_n(q)` tower; it does
not construct it, and no claim is made here that the Hecke tower satisfies these
axioms — that is the standard result cited below. What *is* new here is that the
unused-generator rule is a **consequence** of those axioms rather than an extra
assumption, which is what `qou-g8i1` needed.

`z` is an abstract ring element throughout. In particular this file is
convention-neutral: it is neither a convention-C nor a convention-D statement,
and instantiating `z := q³/(q²+1)` (convention D, per
`QOU.MathlibExt.MarkovNormalisation`) specialises it without reproving anything.

## Base ring

Generic `[CommRing R]` and a generic `R`-algebra `A`. No `ℝ`, no ordering, no
archimedean content.

-- Ref: [jones1987] https://doi.org/10.2307/1971403
-- Ref: [wenzl1988] https://doi.org/10.1007/BF01393699
-- Ref: [leitner2026] docs/audits/2026-08-19-bar-involution-is-isospin-conjugation.md §4g
-/

namespace QOU.MathlibExt.MarkovUnusedGenerator

variable {R : Type*} [CommRing R]
variable {A : Type*} [Ring A] [Algebra R A]

/-- A **Markov-trace tower**: the axioms of the Jones/Ocneanu trace on
`H_1 ⊆ H_2 ⊆ ⋯`, with an abstract Markov parameter `z`.

Deliberately minimal — every field below is used by the theorem, and no field
encodes the conclusion. In particular there is no hypothesis about interior
generators; that is what gets derived. -/
structure MarkovTower (R : Type*) [CommRing R] (A : Type*) [Ring A]
    [Algebra R A] where
  /-- The tower of subalgebras. `H n` is generated by `σ 0, …, σ (n-1)`. -/
  H : ℕ → Subalgebra R A
  /-- The tower is increasing. -/
  H_mono : Monotone H
  /-- The generators. -/
  σ : ℕ → A
  /-- `σ n` is the new generator at level `n + 1`. -/
  σ_mem : ∀ n, σ n ∈ H (n + 1)
  /-- Generators at distance `≥ 2` commute (the far-commutation braid relation). -/
  far_comm : ∀ i j : ℕ, i + 2 ≤ j → σ i * σ j = σ j * σ i
  /-- The trace, as a linear functional. -/
  tr : A →ₗ[R] R
  /-- The trace property `tr (a * b) = tr (b * a)`. -/
  tr_comm : ∀ a b : A, tr (a * b) = tr (b * a)
  /-- The Markov parameter. -/
  z : R
  /-- **The Markov property**, at the top of the tower only. -/
  markov : ∀ (n : ℕ), ∀ a ∈ H n, tr (a * σ n) = z * tr a

variable (T : MarkovTower R A)

/-- The product of the generators listed by `l`, in order. -/
def wordProd (l : List ℕ) : A := (l.map T.σ).prod

@[simp] theorem wordProd_nil : wordProd T [] = 1 := by simp [wordProd]

theorem wordProd_append_singleton (l : List ℕ) (m : ℕ) :
    wordProd T (l ++ [m]) = wordProd T l * T.σ m := by
  simp [wordProd]

/-- A word all of whose letters are below `n` lies in `H n`. -/
theorem wordProd_mem (l : List ℕ) (n : ℕ) (h : ∀ i ∈ l, i < n) :
    wordProd T l ∈ T.H n := by
  induction l with
  | nil => simp [wordProd]
  | cons i l ih =>
    have hi : i < n := h i (by simp)
    have hl : ∀ j ∈ l, j < n := fun j hj => h j (by simp [hj])
    have hσ : T.σ i ∈ T.H n := T.H_mono hi (T.σ_mem i)
    have : wordProd T (i :: l) = T.σ i * wordProd T l := by simp [wordProd]
    rw [this]
    exact (T.H n).mul_mem hσ (ih hl)

/-- **The bond rule at an unused generator.**

For a monotone word `l` (strictly increasing letters) that does not use `g`,

  `tr (wordProd l * σ g) = z * tr (wordProd l)`.

This is the single equation `qou-g8i1` left open, and it is derived here from
the Markov axioms — no extra hypothesis. -/
theorem tr_wordProd_mul_sigma :
    ∀ l : List ℕ, l.Sorted (· < ·) → ∀ g : ℕ, g ∉ l →
      T.tr (wordProd T l * T.σ g) = T.z * T.tr (wordProd T l) := by
  intro l
  induction l using List.reverseRecOn with
  | nil =>
    intro _ g _
    have h1 : (1 : A) ∈ T.H g := (T.H g).one_mem
    simpa using T.markov g 1 h1
  | append_singleton l m ih =>
    intro hsorted g hg
    -- decompose the sortedness and the non-membership
    have hpair := List.pairwise_append.mp hsorted
    have hl_sorted : l.Sorted (· < ·) := hpair.1
    have hlm : ∀ a ∈ l, a < m := by
      intro a ha
      exact hpair.2.2 a ha m (by simp)
    have hgl : g ∉ l := fun hc => hg (by simp [hc])
    have hgm : g ≠ m := fun hc => hg (by simp [hc])
    have hWm : wordProd T l ∈ T.H m := wordProd_mem T l m hlm
    -- peel σ_m off the right-hand side, once and for all
    have hRHS : T.tr (wordProd T l * T.σ m) = T.z * T.tr (wordProd T l) :=
      T.markov m _ hWm
    rw [wordProd_append_singleton, hRHS]
    rcases lt_trichotomy g m with hlt | heq | hgt
    · -- g < m : two sub-cases, by whether σ_g and σ_m commute
      by_cases hfar : g + 2 ≤ m
      · -- far apart: slide σ_g down past σ_m, peel σ_m, then induct
        have hcomm : T.σ m * T.σ g = T.σ g * T.σ m := (T.far_comm g m hfar).symm
        have hstep : wordProd T l * T.σ m * T.σ g = (wordProd T l * T.σ g) * T.σ m := by
          rw [mul_assoc, hcomm, mul_assoc]
        have hmem : wordProd T l * T.σ g ∈ T.H m :=
          (T.H m).mul_mem hWm (T.H_mono hlt (T.σ_mem g))
        rw [hstep, T.markov m _ hmem, ih hl_sorted g hgl]
      · -- adjacent: m = g + 1.  Cyclicity twice.
        have hm : m = g + 1 := by omega
        subst hm
        -- every letter of l is < g
        have hlg : ∀ a ∈ l, a < g := by
          intro a ha
          have := hlm a ha
          have : a ≠ g := fun hc => hgl (hc ▸ ha)
          omega
        have hWg : wordProd T l ∈ T.H g := wordProd_mem T l g hlg
        have hσgW : T.σ g * wordProd T l ∈ T.H (g + 1) :=
          (T.H (g + 1)).mul_mem (T.σ_mem g) (T.H_mono (Nat.le_succ g) hWg)
        calc T.tr (wordProd T l * T.σ (g + 1) * T.σ g)
            = T.tr (T.σ g * (wordProd T l * T.σ (g + 1))) := T.tr_comm _ _
          _ = T.tr ((T.σ g * wordProd T l) * T.σ (g + 1)) := by rw [mul_assoc]
          _ = T.z * T.tr (T.σ g * wordProd T l) := T.markov (g + 1) _ hσgW
          _ = T.z * T.tr (wordProd T l * T.σ g) := by
                rw [T.tr_comm (T.σ g) (wordProd T l)]
          _ = T.z * (T.z * T.tr (wordProd T l)) := by rw [T.markov g _ hWg]
    · exact absurd heq hgm
    · -- m < g : the whole word lies in H g, Markov applies directly
      have hmem : wordProd T l * T.σ m ∈ T.H g :=
        (T.H g).mul_mem (T.H_mono (le_of_lt hgt) hWm) (T.H_mono hgt (T.σ_mem m))
      rw [T.markov g _ hmem, T.markov m _ hWm]

/-- **The `(z + d)` bond rule**, now unconditional for monotone words.

Combining the derived `σ_g` case with the linearity reduction of
`QOU.MathlibExt.MarkovBondLinear`: each bond letter `σ_g + d • 1` at an unused
generator contributes exactly `z + d`. -/
theorem tr_wordProd_mul_bond (l : List ℕ) (hl : l.Sorted (· < ·)) (g : ℕ)
    (hg : g ∉ l) (d : R) :
    T.tr (wordProd T l * (T.σ g + d • (1 : A)))
      = (T.z + d) * T.tr (wordProd T l) := by
  have hlin : wordProd T l * (T.σ g + d • (1 : A))
      = wordProd T l * T.σ g + d • wordProd T l := by
    rw [mul_add, mul_smul_comm, mul_one]
  rw [hlin, map_add, map_smul, smul_eq_mul,
    tr_wordProd_mul_sigma T l hl g hg]
  ring

/-- The axioms are consistent and admit a **non-degenerate** model: `A = R`,
every `H n = ⊤`, every `σ n = 1`, `tr = id`, `z = 1`.

Present so `MarkovTower` is demonstrably not an empty abstraction. It is a
witness of inhabitation only — this model is commutative and says nothing about
the Hecke tower. Unlike a zero-functional witness it is at least faithful
(`tr 1 = 1 ≠ 0` in a nontrivial `R`), so the axioms do not force degeneracy. -/
def trivialMarkovTower : MarkovTower R R where
  H := fun _ => ⊤
  H_mono := fun _ _ _ => le_rfl
  σ := fun _ => 1
  σ_mem := fun _ => by trivial
  far_comm := fun _ _ _ => by ring
  tr := LinearMap.id
  tr_comm := fun a b => by simp [mul_comm]
  z := 1
  markov := fun _ a _ => by simp

/-! ## Discharging `BondRule`

`QOU.MathlibExt.MarkovBondRule.BondRule` was introduced as an *open primary*: a
content-bearing class carrying the bond rule as a hypothesis, with no instance
provided. The theorem above supplies one.

Reading `Unused g x` as "`x` is a monotone word that omits generator `g`" — the
condition the numerics were measured under — every field of `BondRule` is now
constructed, and its `tr_mul_sigmaPlus` is *derived*. What remains an assumption
is only that the Hecke tower carries a Markov trace, which is the cited standard
result rather than anything specific to this framework.

Consequently `MarkovBondRule.bond_pp_nn`, stated there conditionally on
`BondRule`, holds outright for any Markov tower whose parameter is `markovZ q`.
-/

/-- **A Markov tower with parameter `markovZ q` satisfies the bond rule.**

Given as a `def` rather than an `instance`: it is a construction to be applied
to a specific tower, not something typeclass search should attempt to build. -/
noncomputable def bondRuleOfTower {R : Type*} [Field R] {A : Type*} [Ring A]
    [Algebra R A] (T : MarkovTower R A) (q : R)
    (hz : T.z = MarkovBondRule.markovZ q) :
    MarkovBondRule.BondRule R A q where
  tr := T.tr
  mul := (· * ·)
  sigmaPlus := fun g d => T.σ g + d • (1 : A)
  Unused := fun g x => ∃ l : List ℕ, l.Sorted (· < ·) ∧ x = wordProd T l ∧ g ∉ l
  tr_mul_sigmaPlus := by
    rintro x g d ⟨l, hl, rfl, hg⟩
    rw [← hz]
    exact tr_wordProd_mul_bond T l hl g hg d

end QOU.MathlibExt.MarkovUnusedGenerator
