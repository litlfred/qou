import QOU.MathlibExt.TowerSpanReduction
import Mathlib.Algebra.MonoidAlgebra.Basic
import Mathlib.GroupTheory.Perm.Basic

/-!
# A `TowerSpan` witness with a growing filtration AND a non-multiplicative trace

Bean `qou-fq1i` (child of `qou-301d`). `InvolutionTowerWitness` removed the
constant-filtration objection to `DisjointBlockTraceLaw.towerSpan_unit`, but its
trace is an algebra homomorphism, so it says nothing about the **trace** content
of `TowerSpan`: `DisjointBlockMultiplicative` holds there for every pair,
disjointness playing no part. This file supplies the cheaper of the two towers
Mathlib lacks — the **symmetric-group algebra tower** — with a trace that is
*not* a homomorphism, and proves `SandwichReduces` there.

## The construction

`A = MonoidAlgebra R (Equiv.Perm ℕ)`; the generators are the adjacent
transpositions `t m = of (swap m (m+1))`, with `g m = ginv m = t m`; the tower is
`H n = adjoin {t m | m < n}` (the group algebra of the permutations of
`{0, …, n}`); and the trace is the **coefficient of the identity**,
`tr x = x 1`, with `z = z' = 0`.

* `idCoeff_mul_comm`, `idCoeff_one` — `tr` is a normalised trace.
* `symTrace` — the `MarkovTrace` axioms hold with `z = z' = 0`: for `a ∈ H n`,
  `tr (a * t n) = a (s n)`, and `s n` moves `n+1`, which nothing in `H n` does.
  The quadratic relation holds with `h = 0`, so `z' = z - h` is consistent.
* `idCoeff_not_mul_hom` — **the trace is not multiplicative**:
  `tr (t m * t m) = 1 ≠ 0 = tr (t m) * tr (t m)`.
* `sandwichReduces_sym` — `SandwichReduces` holds at every level, and this is
  the substantive part of the file. By linearity it reduces to the group-level
  **double-coset decomposition** `doubleCoset`: every permutation supported on
  `[n, M+2]` lies in `W ∪ W · s (M+1) · W`, where `W` is generated by
  `s n, …, s M`. That in turn needs `mem_closure_of_suppIn`: the adjacent
  transpositions of an interval generate every permutation supported on it —
  proved by a double induction (`gen_aux`) that pushes the preimage of the top
  point upward one transposition at a time.
* `towerSpan_sym`, `disjointBlock_sym` — hence `TowerSpan`, via
  `towerSpan_of_sandwichReduces`, and the disjoint-block law, via
  `disjointBlock_of_sandwichReduces`.
* `disjointBlock_sym_direct` — the same law proved **directly**, without the
  tower machinery, from `W_{<n} ∩ W_{≥n} = {1}`: a permutation supported on
  `{0..n}` and on `{n, n+1, …}` at once is supported on the single point `n`,
  hence trivial. This is an independent check that the reduction's conclusion
  is true in this model.
* `t_not_mem_shiftedUpTo` — **the filtration grows**: `t N ∉ shiftedUpTo n M`
  for `M < N`, because every element of that stage has zero coefficient at
  `s N` (which moves `N+1`), while `t N` has coefficient `1` there.
* `pair_law_disjoint` / `pair_law_same_block_fails` — the law is **content**
  here, not a restatement of multiplicativity: with `a = 1 + t n ∈ H (n+1)` and
  `b = 1 + t (n+1) ∈ shifted (n+1)`, `tr (a * b) = 1 = tr a * tr b` — the cross
  term `t n * t (n+1)` is a 3-cycle and contributes nothing — whereas
  `tr (a * a) = 2 ≠ 1 = tr a * tr a`, because the cross term `t n * t n = 1`
  contributes `1`.

## 🛑 What this witness still does NOT exercise

**`q = 1`, `z = 0`.** The quadratic relation here is `t m * t m = 1`, i.e.
`h = 0`, and the Markov parameter is `z = 0`. The Iwahori–Hecke tower at
`q ≠ 1` has `h = q - q⁻¹ ≠ 0` and a non-zero Markov parameter, and the
double-coset decomposition for it must be carried out by **rewriting** with the
braid relation and the quadratic relation. Here the decomposition is proved in
the **permutation model** — by support and point-pushing arguments — and the
braid relation is never written down. So `SandwichReduces` for a Hecke tower
with `q ≠ 1` remains unproved, and the disjoint-block law for the production
atom word — hence its bond-product reading — remains **measured, not derived**.

What is established is narrower and stated exactly: `TowerSpan`'s trace content
is now exercised by a witness in which the trace is not a homomorphism, the
filtration grows, and the disjoint-block law is true for a reason
(`W_{<n} ∩ W_{≥n} = {1}`) that is specific to a trace supported at the
identity. A Hecke trace with `z ≠ 0` does not have that shape.

## Base ring

Generic `[CommRing R]`; no ordering, no `ℝ`, no archimedean content. The three
statements needing `1 ≠ 0` carry `[Nontrivial R]`.

-- Ref: [leitner2026] bean qou-fq1i / qou-301d; Kassel–Turaev, *Braid Groups*, ch. 4.
-/

namespace QOU.MathlibExt.SymmetricGroupTowerWitness
open QOU.MathlibExt.OcneanuTrace QOU.MathlibExt.DisjointBlockTrace
open QOU.MathlibExt.TowerSpanReduction
open Equiv

/-! ## Permutations of `ℕ`, adjacent transpositions, supports -/

/-- The symmetric group on `ℕ`. Only adjacent transpositions are ever used. -/
abbrev G : Type := Equiv.Perm ℕ

/-- The `m`-th adjacent transposition. -/
def s (m : ℕ) : G := Equiv.swap m (m + 1)

theorem s_mul_s (m : ℕ) : s m * s m = 1 := Equiv.swap_mul_self _ _

theorem s_inv (m : ℕ) : (s m)⁻¹ = s m := Equiv.swap_inv _ _

theorem s_apply_left (m : ℕ) : s m m = m + 1 := Equiv.swap_apply_left _ _

theorem s_apply_right (m : ℕ) : s m (m + 1) = m := Equiv.swap_apply_right _ _

theorem s_apply_of_ne (m x : ℕ) (h1 : x ≠ m) (h2 : x ≠ m + 1) : s m x = x :=
  Equiv.swap_apply_of_ne_of_ne h1 h2

theorem s_s_apply (m x : ℕ) : s m (s m x) = x := by
  have h := congrArg (fun p : G => p x) (s_mul_s m)
  simpa [Perm.mul_apply] using h

/-- `u` moves only points of `S`. -/
def SuppIn (u : G) (S : Set ℕ) : Prop := ∀ x, u x ≠ x → x ∈ S

theorem suppIn_one (S : Set ℕ) : SuppIn 1 S := fun _ h => absurd rfl h

theorem suppIn_mul {u v : G} {S : Set ℕ} (hu : SuppIn u S) (hv : SuppIn v S) :
    SuppIn (u * v) S := by
  intro x hx
  rw [Perm.mul_apply] at hx
  by_cases h : v x = x
  · rw [h] at hx; exact hu x hx
  · exact hv x h

theorem suppIn_swap (i j : ℕ) {S : Set ℕ} (hi : i ∈ S) (hj : j ∈ S) :
    SuppIn (Equiv.swap i j) S := by
  intro x hx
  by_cases h1 : x = i
  · rw [h1]; exact hi
  by_cases h2 : x = j
  · rw [h2]; exact hj
  exact absurd (Equiv.swap_apply_of_ne_of_ne h1 h2) hx

/-- A permutation moving at most one point is the identity. -/
theorem eq_one_of_suppIn_singleton (u : G) (p : ℕ) (h : SuppIn u {p}) : u = 1 := by
  ext x
  rw [Perm.one_apply]
  by_contra hx
  have hxp : x = p := h x hx
  subst hxp
  have hk : u (u x) ≠ u x := fun hk => hx (u.injective hk)
  have : u x = x := h (u x) hk
  exact hx this

/-! ## The subgroup generated by an index set of adjacent transpositions -/

/-- The adjacent transpositions indexed by `I`. -/
def gens (I : Set ℕ) : Set G := {p | ∃ m ∈ I, p = s m}

theorem s_mem_closure {I : Set ℕ} {m : ℕ} (hm : m ∈ I) :
    s m ∈ Submonoid.closure (gens I) :=
  Submonoid.subset_closure ⟨m, hm, rfl⟩

/-- The points an element of `closure (gens I)` can move. -/
def pts (I : Set ℕ) : Set ℕ := {x | ∃ m ∈ I, x = m ∨ x = m + 1}

theorem suppIn_of_mem_closure {I : Set ℕ} {u : G} (hu : u ∈ Submonoid.closure (gens I)) :
    SuppIn u (pts I) := by
  induction hu using Submonoid.closure_induction with
  | mem x hx =>
      obtain ⟨m, hm, rfl⟩ := hx
      exact suppIn_swap m (m + 1) ⟨m, hm, Or.inl rfl⟩ ⟨m, hm, Or.inr rfl⟩
  | one => exact suppIn_one _
  | mul x y _ _ ihx ihy => exact suppIn_mul ihx ihy

/-- **Generation, interval form.** A permutation supported on `[n, n+k)` is a
product of the adjacent transpositions `s m` with `n ≤ m`, `m + 1 < n + k`.

Outer induction on `k`; inner induction on the distance `d` from the preimage
`i` of the top point `n + k` to that point, multiplying by `s i` to push the
preimage up by one. -/
theorem gen_aux (k : ℕ) : ∀ (n : ℕ) (u : G), SuppIn u {x | n ≤ x ∧ x < n + k} →
    u ∈ Submonoid.closure (gens {m | n ≤ m ∧ m + 1 < n + k}) := by
  induction k with
  | zero =>
      intro n u hu
      have hone : u = 1 := by
        ext x
        rw [Perm.one_apply]
        by_contra hx
        have h := hu x hx
        simp only [Set.mem_setOf_eq] at h
        omega
      rw [hone]; exact Submonoid.one_mem _
  | succ k ih =>
      intro n u hu
      have inner : ∀ (d i : ℕ) (u : G), i + d = n + k →
          SuppIn u {x | n ≤ x ∧ x < n + (k + 1)} → u i = n + k →
          u ∈ Submonoid.closure (gens {m | n ≤ m ∧ m + 1 < n + (k + 1)}) := by
        intro d
        induction d with
        | zero =>
            intro i u hi hu hui
            have hi' : i = n + k := by omega
            subst hi'
            have hsupp : SuppIn u {x | n ≤ x ∧ x < n + k} := by
              intro x hx
              have h1 := hu x hx
              simp only [Set.mem_setOf_eq] at h1 ⊢
              refine ⟨h1.1, ?_⟩
              rcases Nat.lt_or_ge x (n + k) with h | h
              · exact h
              · have hx' : x = n + k := by omega
                rw [hx'] at hx
                exact absurd hui hx
            refine Submonoid.closure_mono ?_ (ih n u hsupp)
            rintro p ⟨m, hm, rfl⟩
            obtain ⟨hm1, hm2⟩ := hm
            exact ⟨m, ⟨hm1, by omega⟩, rfl⟩
        | succ d ihd =>
            intro i u hi hu hui
            have hne : u i ≠ i := by rw [hui]; omega
            have hni : n ≤ i := (hu i hne).1
            set u' : G := u * s i with hu'
            have hu'i : u' (i + 1) = n + k := by
              rw [hu', Perm.mul_apply, s_apply_right, hui]
            have hsupp' : SuppIn u' {x | n ≤ x ∧ x < n + (k + 1)} := by
              intro x hx
              rw [hu', Perm.mul_apply] at hx
              by_cases h1 : x = i
              · rw [h1]; exact ⟨hni, by omega⟩
              by_cases h2 : x = i + 1
              · rw [h2]; exact ⟨by omega, by omega⟩
              rw [s_apply_of_ne i x h1 h2] at hx
              exact hu x hx
            have hmem := ihd (i + 1) u' (by omega) hsupp' hu'i
            have hdecomp : u = u' * s i := by rw [hu', mul_assoc, s_mul_s, mul_one]
            rw [hdecomp]
            exact Submonoid.mul_mem _ hmem
              (s_mem_closure (show n ≤ i ∧ i + 1 < n + (k + 1) from ⟨hni, by omega⟩))
      set i := u.symm (n + k) with hi
      have hui : u i = n + k := by rw [hi]; exact u.apply_symm_apply _
      have hile : i ≤ n + k := by
        by_contra hlt
        push_neg at hlt
        have hne : u i ≠ i := by rw [hui]; omega
        have h := (hu i hne).2
        omega
      exact inner (n + k - i) i u (by omega) hu hui

/-- **Generation.** A permutation supported on `[n, M+1]` lies in the submonoid
generated by `s n, …, s M`. -/
theorem mem_closure_of_suppIn (n M : ℕ) (u : G) (hu : SuppIn u {x | n ≤ x ∧ x ≤ M + 1}) :
    u ∈ Submonoid.closure (gens {m | n ≤ m ∧ m ≤ M}) := by
  rcases le_or_gt n (M + 2) with h | h
  · obtain ⟨k, hk⟩ := Nat.exists_eq_add_of_le h
    have hsupp : SuppIn u {x | n ≤ x ∧ x < n + k} := by
      intro x hx
      have h1 := hu x hx
      simp only [Set.mem_setOf_eq] at h1 ⊢
      omega
    refine Submonoid.closure_mono ?_ (gen_aux k n u hsupp)
    rintro p ⟨m, hm, rfl⟩
    obtain ⟨hm1, hm2⟩ := hm
    exact ⟨m, ⟨hm1, by omega⟩, rfl⟩
  · have hone : u = 1 := by
      ext x
      rw [Perm.one_apply]
      by_contra hx
      have h1 := hu x hx
      simp only [Set.mem_setOf_eq] at h1
      omega
    rw [hone]; exact Submonoid.one_mem _

/-- **The double-coset decomposition** `S_{k+1} = S_k ∪ S_k · s_k · S_k`, in the
form needed here: a permutation supported on `[n, M+2]` is either in
`W = ⟨s n, …, s M⟩` or of the form `a * s (M+1) * b` with `a, b ∈ W`. -/
theorem doubleCoset (n M : ℕ) (u : G) (hu : SuppIn u {x | n ≤ x ∧ x ≤ M + 2}) :
    u ∈ Submonoid.closure (gens {m | n ≤ m ∧ m ≤ M}) ∨
      ∃ a ∈ Submonoid.closure (gens {m | n ≤ m ∧ m ≤ M}),
        ∃ b ∈ Submonoid.closure (gens {m | n ≤ m ∧ m ≤ M}), u = a * s (M + 1) * b := by
  by_cases h : u (M + 2) = M + 2
  · left
    apply mem_closure_of_suppIn
    intro x hx
    have h1 := hu x hx
    simp only [Set.mem_setOf_eq] at h1 ⊢
    refine ⟨h1.1, ?_⟩
    rcases Nat.lt_or_ge x (M + 2) with h2 | h2
    · omega
    · have hx' : x = M + 2 := by omega
      rw [hx'] at hx
      exact absurd h hx
  · right
    set j := u (M + 2) with hj
    have hjne : j ≠ M + 2 := h
    have hjsupp : u j ≠ j := fun hh => hjne (u.injective (hh.trans hj))
    have hjmem := hu j hjsupp
    have hnj : n ≤ j := hjmem.1
    have hjle : j ≤ M + 1 := by have := hjmem.2; omega
    set a : G := Equiv.swap j (M + 1) with ha
    have haW : a ∈ Submonoid.closure (gens {m | n ≤ m ∧ m ≤ M}) :=
      mem_closure_of_suppIn n M a
        (suppIn_swap j (M + 1) ⟨hnj, hjle⟩ ⟨by omega, le_refl _⟩)
    set b : G := s (M + 1) * a * u with hb
    have hbfix : b (M + 2) = M + 2 := by
      rw [hb, Perm.mul_apply, Perm.mul_apply, ← hj, ha, Equiv.swap_apply_left]
      have := s_apply_left (M + 1)
      omega
    have hbW : b ∈ Submonoid.closure (gens {m | n ≤ m ∧ m ≤ M}) := by
      apply mem_closure_of_suppIn
      have hb' : SuppIn b {x | n ≤ x ∧ x ≤ M + 2} := by
        rw [hb]
        refine suppIn_mul (suppIn_mul ?_ ?_) hu
        · exact suppIn_swap (M + 1) (M + 1 + 1) ⟨by omega, by omega⟩ ⟨by omega, by omega⟩
        · exact suppIn_swap j (M + 1) ⟨hnj, by omega⟩ ⟨by omega, by omega⟩
      intro x hx
      have h1 := hb' x hx
      simp only [Set.mem_setOf_eq] at h1 ⊢
      refine ⟨h1.1, ?_⟩
      rcases Nat.lt_or_ge x (M + 2) with h2 | h2
      · omega
      · have hx' : x = M + 2 := by omega
        rw [hx'] at hx
        exact absurd hbfix hx
    refine ⟨a, haW, b, hbW, ?_⟩
    calc u = a * a * u := by rw [ha, Equiv.swap_mul_self, one_mul]
      _ = a * (s (M + 1) * s (M + 1)) * a * u := by rw [s_mul_s, mul_one]
      _ = a * s (M + 1) * (s (M + 1) * a * u) := by simp only [mul_assoc]

/-! ## The group algebra, the generators, the identity-coefficient trace -/

variable (R : Type*) [CommRing R]

/-- The `m`-th adjacent transposition as an element of the group algebra. -/
noncomputable def t (m : ℕ) : MonoidAlgebra R G := MonoidAlgebra.of R G (s m)

theorem t_mul_t (m : ℕ) : t R m * t R m = 1 := by
  rw [t, ← map_mul, s_mul_s, map_one]

/-- **The trace: the coefficient of the identity.** A linear functional, not an
algebra homomorphism (`idCoeff_not_mul_hom`). -/
noncomputable def idCoeff : MonoidAlgebra R G →ₗ[R] R where
  toFun x := x 1
  map_add' x y := by simp
  map_smul' r x := by simp

@[simp] theorem idCoeff_apply (x : MonoidAlgebra R G) : idCoeff R x = x 1 := rfl

theorem idCoeff_one : idCoeff R 1 = 1 := by
  classical
  simp [MonoidAlgebra.one_def]

theorem idCoeff_of_one : idCoeff R (MonoidAlgebra.of R G 1) = 1 := by
  rw [map_one, idCoeff_one]

theorem idCoeff_of_ne {g : G} (hg : g ≠ 1) : idCoeff R (MonoidAlgebra.of R G g) = 0 := by
  classical
  rw [idCoeff_apply, MonoidAlgebra.of_apply, MonoidAlgebra.single_apply, if_neg hg]

theorem s_ne_one (m : ℕ) : s m ≠ 1 := by
  intro h
  have := congrArg (fun p : G => p m) h
  simp only [Perm.one_apply, s_apply_left] at this
  omega

@[simp] theorem idCoeff_t (m : ℕ) : idCoeff R (t R m) = 0 :=
  idCoeff_of_ne R (s_ne_one m)

/-- **(T1)** The identity coefficient is a trace. -/
theorem idCoeff_mul_comm (a b : MonoidAlgebra R G) :
    idCoeff R (a * b) = idCoeff R (b * a) := by
  classical
  simp only [idCoeff_apply, MonoidAlgebra.mul_apply]
  rw [Finsupp.sum_comm]
  refine Finsupp.sum_congr fun y _ => Finsupp.sum_congr fun x _ => ?_
  have hiff : x * y = 1 ↔ y * x = 1 := by
    rw [mul_eq_one_iff_eq_inv, mul_eq_one_iff_inv_eq]
    exact eq_comm
  by_cases hxy : x * y = 1
  · rw [if_pos hxy, if_pos (hiff.1 hxy), mul_comm]
  · rw [if_neg hxy, if_neg (fun hh => hxy (hiff.2 hh))]

/-- Multiplying by a generator on the right reads off the coefficient at that
generator: `tr (a * t m) = a (s m)`. -/
theorem idCoeff_mul_t (a : MonoidAlgebra R G) (m : ℕ) :
    idCoeff R (a * t R m) = a (s m) := by
  have H : ∀ m' ∈ a.support, m' * s m = 1 ↔ m' = s m := fun m' _ => by
    rw [mul_eq_one_iff_eq_inv, s_inv]
  rw [idCoeff_apply, t, MonoidAlgebra.of_apply, MonoidAlgebra.mul_single_apply_aux H, mul_one]

/-! ## Subalgebras generated by index sets -/

/-- The generators indexed by `I`, in the group algebra. -/
def agens (I : Set ℕ) : Set (MonoidAlgebra R G) := {x | ∃ m ∈ I, x = t R m}

theorem agens_eq (I : Set ℕ) : agens R I = MonoidAlgebra.of R G '' gens I := by
  ext x
  constructor
  · rintro ⟨m, hm, rfl⟩; exact ⟨s m, ⟨m, hm, rfl⟩, rfl⟩
  · rintro ⟨p, ⟨m, hm, rfl⟩, rfl⟩; exact ⟨m, hm, rfl⟩

/-- Elements of `adjoin (agens I)` are linear combinations of the group elements
of `closure (gens I)`. -/
theorem mem_span_of_mem_adjoin (I : Set ℕ) {c : MonoidAlgebra R G}
    (hc : c ∈ Algebra.adjoin R (agens R I)) :
    c ∈ Submodule.span R (MonoidAlgebra.of R G '' ↑(Submonoid.closure (gens I))) := by
  rw [agens_eq] at hc
  have h1 : c ∈ Subalgebra.toSubmodule (Algebra.adjoin R (MonoidAlgebra.of R G '' gens I)) := hc
  rw [Algebra.adjoin_eq_span, ← MonoidHom.map_mclosure, Submonoid.coe_map] at h1
  exact h1

theorem of_mem_adjoin (I : Set ℕ) {w : G} (hw : w ∈ Submonoid.closure (gens I)) :
    MonoidAlgebra.of R G w ∈ Algebra.adjoin R (agens R I) := by
  induction hw using Submonoid.closure_induction with
  | mem x hx =>
      obtain ⟨m, hm, rfl⟩ := hx
      exact Algebra.subset_adjoin ⟨m, hm, rfl⟩
  | one => rw [map_one]; exact Subalgebra.one_mem _
  | mul x y _ _ ihx ihy => rw [map_mul]; exact Subalgebra.mul_mem _ ihx ihy

/-- A coefficient outside `closure (gens I)` vanishes on `adjoin (agens I)`. -/
theorem coeff_eq_zero_of_mem_adjoin (I : Set ℕ) {c : MonoidAlgebra R G}
    (hc : c ∈ Algebra.adjoin R (agens R I)) (g : G)
    (hg : g ∉ Submonoid.closure (gens I)) : c g = 0 := by
  classical
  have h := mem_span_of_mem_adjoin R I hc
  clear hc
  induction h using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨w, hw, rfl⟩ := hx
      rw [MonoidAlgebra.of_apply, MonoidAlgebra.single_apply, if_neg]
      intro hwg
      subst hwg
      exact hg hw
  | zero => simp
  | add x y _ _ ihx ihy => simp [ihx, ihy]
  | smul r x _ ihx => simp [ihx]

theorem s_not_mem_closure_of_lt (I : Set ℕ) (N : ℕ) (hN : ∀ m ∈ I, m < N) :
    s N ∉ Submonoid.closure (gens I) := by
  intro h
  have hsupp := suppIn_of_mem_closure h
  have hmem : (N + 1) ∈ pts I := hsupp (N + 1) (by rw [s_apply_right]; omega)
  obtain ⟨m, hm, hm'⟩ := hmem
  have := hN m hm
  omega

/-! ## The tower and the `MarkovTrace` -/

/-- Level `n`: generated by `t 0, …, t (n-1)`. -/
noncomputable def Hlev (n : ℕ) : Subalgebra R (MonoidAlgebra R G) :=
  Algebra.adjoin R (agens R {m | m < n})

theorem Hlev_mono : Monotone (Hlev R) := by
  intro a b hab
  exact Algebra.adjoin_mono (fun _ ⟨m, hm, hx⟩ => ⟨m, lt_of_lt_of_le hm hab, hx⟩)

/-- **A `MarkovTrace` on the symmetric-group algebra tower**, with the identity
coefficient as trace and `z = z' = 0`. -/
noncomputable def symTrace : MarkovTrace R (MonoidAlgebra R G) where
  H := Hlev R
  H_mono := Hlev_mono R
  g := t R
  g_mem n := Algebra.subset_adjoin ⟨n, Nat.lt_succ_self n, rfl⟩
  ginv := t R
  ginv_mem n := Algebra.subset_adjoin ⟨n, Nat.lt_succ_self n, rfl⟩
  ginv_mul n := t_mul_t R n
  mul_ginv n := t_mul_t R n
  tr := idCoeff R
  tr_mul_comm := idCoeff_mul_comm R
  tr_one := idCoeff_one R
  z := 0
  zinv := 0
  markov := by
    intro n a ha
    rw [idCoeff_mul_t, zero_mul]
    exact coeff_eq_zero_of_mem_adjoin R _ ha _ (s_not_mem_closure_of_lt _ n (fun _ hm => hm))
  markov_inv := by
    intro n a ha
    rw [idCoeff_mul_t, zero_mul]
    exact coeff_eq_zero_of_mem_adjoin R _ ha _ (s_not_mem_closure_of_lt _ n (fun _ hm => hm))

theorem quad_sym (m : ℕ) :
    (symTrace R).g m * (symTrace R).g m = (0 : R) • (symTrace R).g m + 1 := by
  show t R m * t R m = _
  rw [t_mul_t, zero_smul, zero_add]

/-- **The trace is NOT an algebra homomorphism** — the property the involution
witness lacked. -/
theorem idCoeff_not_mul_hom [Nontrivial R] (m : ℕ) :
    idCoeff R (t R m * t R m) ≠ idCoeff R (t R m) * idCoeff R (t R m) := by
  rw [t_mul_t, idCoeff_one, idCoeff_t, mul_zero]
  exact one_ne_zero

/-! ## `SandwichReduces`, `TowerSpan`, the disjoint-block law -/

theorem shiftedUpTo_eq (n M : ℕ) :
    shiftedUpTo (symTrace R) n M = Algebra.adjoin R (agens R {m | n ≤ m ∧ m ≤ M}) := by
  unfold shiftedUpTo
  congr 1
  ext x
  constructor
  · rintro ⟨m, hnm, hmM, hx | hx⟩ <;> exact ⟨m, ⟨hnm, hmM⟩, hx⟩
  · rintro ⟨m, ⟨hnm, hmM⟩, hx⟩; exact ⟨m, hnm, hmM, Or.inl hx⟩

/-- **`SandwichReduces` holds at every level of the symmetric-group tower.**

For `c` in the stage `⟨t n, …, t M⟩`, `t (M+1) * c * t (M+1)` lies in the stage
plus single sandwiches. By linearity it suffices to take `c = of w` for a
permutation `w` supported on `[n, M+1]`; then `s (M+1) * w * s (M+1)` is
supported on `[n, M+2]` and `doubleCoset` places it in `W` or in
`W · s (M+1) · W`. -/
theorem sandwichReduces_sym (n M : ℕ) :
    SandwichReduces (symTrace R) (shiftedUpTo (symTrace R) n M) (M + 1) := by
  intro c hc
  set B := shiftedUpTo (symTrace R) n M with hB
  have hc' : c ∈ Submodule.span R
      (MonoidAlgebra.of R G '' ↑(Submonoid.closure (gens {m | n ≤ m ∧ m ≤ M}))) := by
    rw [hB, shiftedUpTo_eq] at hc
    exact mem_span_of_mem_adjoin R _ hc
  clear hc
  show t R (M + 1) * c * t R (M + 1) ∈ P (symTrace R) B (M + 1)
  induction hc' using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨w, hw, rfl⟩ := hx
      have hsw : SuppIn w (pts {m | n ≤ m ∧ m ≤ M}) := suppIn_of_mem_closure hw
      have hu : SuppIn (s (M + 1) * w * s (M + 1)) {x | n ≤ x ∧ x ≤ M + 2} := by
        intro x hx
        have hx' : w (s (M + 1) x) ≠ s (M + 1) x := by
          intro hh
          apply hx
          rw [Perm.mul_apply, Perm.mul_apply, hh, s_s_apply]
        obtain ⟨m, hm, hy⟩ := hsw _ hx'
        obtain ⟨hm1, hm2⟩ := hm
        set y := s (M + 1) x with hy_def
        have hxy : x = s (M + 1) y := (s_s_apply _ _).symm
        have hy1 : n ≤ y ∧ y ≤ M + 1 := by rcases hy with h | h <;> omega
        by_cases hc1 : y = M + 1
        · rw [hxy, hc1, s_apply_left]
          exact ⟨by omega, by omega⟩
        · have hc2 : y ≠ M + 1 + 1 := by omega
          rw [hxy, s_apply_of_ne _ _ hc1 hc2]
          exact ⟨hy1.1, by omega⟩
      have hconj : t R (M + 1) * MonoidAlgebra.of R G w * t R (M + 1)
          = MonoidAlgebra.of R G (s (M + 1) * w * s (M + 1)) := by
        rw [t, map_mul, map_mul]
      rcases doubleCoset n M _ hu with h | ⟨a, ha, b, hb, hab⟩
      · apply base_le_P
        rw [hconj, hB, shiftedUpTo_eq]
        exact of_mem_adjoin R _ h
      · have hsplit : t R (M + 1) * MonoidAlgebra.of R G w * t R (M + 1)
            = MonoidAlgebra.of R G a * t R (M + 1) * MonoidAlgebra.of R G b := by
          rw [hconj, hab, t, map_mul, map_mul]
        rw [hsplit]
        refine Submodule.mem_sup_right (Submodule.subset_span ⟨_, ?_, _, ?_, rfl⟩)
        · rw [hB, shiftedUpTo_eq]; exact of_mem_adjoin R _ ha
        · rw [hB, shiftedUpTo_eq]; exact of_mem_adjoin R _ hb
  | zero => simp
  | add x y _ _ ihx ihy =>
      rw [mul_add, add_mul]
      exact Submodule.add_mem _ ihx ihy
  | smul r x _ ihx =>
      rw [mul_smul_comm, smul_mul_assoc]
      exact Submodule.smul_mem _ _ ihx

/-- **The witness satisfies `TowerSpan`.** -/
instance towerSpan_sym : TowerSpan (symTrace R) :=
  towerSpan_of_sandwichReduces (symTrace R) (fun m => ⟨0, quad_sym R m⟩)
    (fun n M => sandwichReduces_sym R n M)

/-- **The disjoint-block law, derived through the reduction chain**
`SandwichReduces → TowerSpan → DisjointBlockMultiplicative`. -/
theorem disjointBlock_sym : DisjointBlockMultiplicative (symTrace R) :=
  disjointBlock_of_sandwichReduces (symTrace R) (fun m => ⟨0, quad_sym R m⟩)
    (fun n M => sandwichReduces_sym R n M)

/-! ## The filtration grows -/

/-- **The filtration GROWS**: `t N` is not in the stage `⟨t n, …, t M⟩` for
`M < N`, since every element of that stage has zero coefficient at `s N`. -/
theorem t_not_mem_shiftedUpTo [Nontrivial R] (n M N : ℕ) (hN : M < N) :
    t R N ∉ shiftedUpTo (symTrace R) n M := by
  intro hmem
  rw [shiftedUpTo_eq] at hmem
  have h0 := coeff_eq_zero_of_mem_adjoin R _ hmem (s N)
    (s_not_mem_closure_of_lt _ N (fun m hm => by obtain ⟨_, h2⟩ := hm; omega))
  classical
  rw [t, MonoidAlgebra.of_apply, MonoidAlgebra.single_apply, if_pos rfl] at h0
  exact one_ne_zero h0

/-! ## The law holds for a reason that is CONTENT here -/

theorem shifted_eq (n : ℕ) :
    shifted (symTrace R) n = Algebra.adjoin R (agens R {m | n ≤ m}) := by
  unfold shifted
  congr 1
  ext x
  simp only [Set.mem_iUnion, Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨k, hx | hx⟩ <;> exact ⟨n + k, Nat.le_add_right n k, hx⟩
  · rintro ⟨m, hm, hx⟩
    obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hm
    exact ⟨k, Or.inl hx⟩

/-- **The disjoint-block law, proved DIRECTLY** — an independent check of the
reduction chain's conclusion in this model.

The reason it holds is `W_{<n} ∩ W_{≥n} = {1}`: for group elements `w ∈ W_{<n}`
(supported on `{0..n}`) and `v ∈ W_{≥n}` (supported on `{n, n+1, …}`),
`tr (w v) = [w v = 1]`, and `w v = 1` forces `w = v⁻¹` to be supported on the
single point `n`, hence `w = v = 1`. So `tr (w v) = [w = 1][v = 1]`, and
bilinearity finishes. -/
theorem disjointBlock_sym_direct : DisjointBlockMultiplicative (symTrace R) := by
  intro n a ha b hb
  rw [shifted_eq] at hb
  have ha' := mem_span_of_mem_adjoin R _ ha
  have hb' := mem_span_of_mem_adjoin R _ hb
  clear ha hb
  show idCoeff R (a * b) = idCoeff R a * idCoeff R b
  induction ha' using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨w, hw, rfl⟩ := hx
      induction hb' using Submodule.span_induction with
      | mem y hy =>
          obtain ⟨v, hv, rfl⟩ := hy
          rw [← map_mul]
          by_cases h1 : w = 1
          · subst h1
            rw [one_mul, idCoeff_of_one, one_mul]
          · rw [idCoeff_of_ne R h1, zero_mul, idCoeff_of_ne R]
            intro hwv
            apply h1
            have hw' := suppIn_of_mem_closure hw
            have hv' := suppIn_of_mem_closure hv
            apply eq_one_of_suppIn_singleton w n
            intro x hx
            have hvx : v x ≠ x := by
              intro hvx
              apply hx
              have hh := congrArg (fun p : G => p x) hwv
              simp only [Perm.mul_apply, Perm.one_apply] at hh
              rw [hvx] at hh
              exact hh
            obtain ⟨m1, hm1, h1'⟩ := hw' x hx
            obtain ⟨m2, hm2, h2'⟩ := hv' x hvx
            simp only [Set.mem_setOf_eq] at hm1 hm2
            show x = n
            omega
      | zero => simp
      | add y z _ _ ihy ihz => rw [mul_add, map_add, map_add, ihy, ihz, mul_add]
      | smul r y _ ihy =>
          rw [mul_smul_comm, map_smul, map_smul, ihy, smul_eq_mul, smul_eq_mul]
          ring
  | zero => simp
  | add x y _ _ ihx ihy => rw [add_mul, map_add, map_add, ihx, ihy, add_mul]
  | smul r x _ ihx =>
      rw [smul_mul_assoc, map_smul, map_smul, ihx, smul_eq_mul, smul_eq_mul]
      ring

/-! ## A pair in disjoint blocks where the law is not multiplicativity -/

theorem s_mul_s_succ_ne_one (n : ℕ) : s n * s (n + 1) ≠ 1 := by
  intro h
  have hh := congrArg (fun p : G => p n) h
  simp only [Perm.mul_apply, Perm.one_apply] at hh
  rw [s_apply_of_ne (n + 1) n (by omega) (by omega), s_apply_left] at hh
  omega

theorem idCoeff_t_mul_t_succ (n : ℕ) : idCoeff R (t R n * t R (n + 1)) = 0 := by
  rw [t, t, ← map_mul]
  exact idCoeff_of_ne R (s_mul_s_succ_ne_one n)

theorem idCoeff_one_add_t (m : ℕ) : idCoeff R (1 + t R m) = 1 := by
  rw [map_add, idCoeff_one, idCoeff_t, add_zero]

theorem one_add_t_mem_H (n : ℕ) : 1 + t R n ∈ (symTrace R).H (n + 1) :=
  Subalgebra.add_mem _ (Subalgebra.one_mem _) ((symTrace R).g_mem n)

theorem one_add_t_succ_mem_shifted (n : ℕ) : 1 + t R (n + 1) ∈ shifted (symTrace R) (n + 1) :=
  Subalgebra.add_mem _ (Subalgebra.one_mem _) (g_mem_shifted (symTrace R) (n + 1) 0)

/-- **The law holding with non-zero traces on both sides**: `a = 1 + t n`,
`b = 1 + t (n+1)` have `tr a = tr b = 1` and `tr (a * b) = 1`. The cross term
`t n * t (n+1)` is the 3-cycle `s n s (n+1) ≠ 1` and contributes nothing. This is
an instance of `disjointBlock_sym`, computed by hand. -/
theorem pair_law_disjoint (n : ℕ) :
    idCoeff R ((1 + t R n) * (1 + t R (n + 1)))
      = idCoeff R (1 + t R n) * idCoeff R (1 + t R (n + 1)) := by
  have e : (1 + t R n) * (1 + t R (n + 1))
      = 1 + t R n + t R (n + 1) + t R n * t R (n + 1) := by noncomm_ring
  rw [e, idCoeff_one_add_t, idCoeff_one_add_t, mul_one, map_add, map_add, map_add,
    idCoeff_one, idCoeff_t, idCoeff_t, idCoeff_t_mul_t_succ]
  ring

/-- **The same element against ITSELF fails**: `tr (a * a) = 2 ≠ 1 = tr a * tr a`
for `a = 1 + t n`, because now the cross term is `t n * t n = 1`. So the
disjoint-block law is genuinely about disjointness, not a corollary of
multiplicativity. -/
theorem pair_law_same_block_fails [Nontrivial R] (n : ℕ) :
    idCoeff R ((1 + t R n) * (1 + t R n)) ≠ idCoeff R (1 + t R n) * idCoeff R (1 + t R n) := by
  have e : (1 + t R n) * (1 + t R n) = 1 + t R n + t R n + t R n * t R n := by noncomm_ring
  rw [e, idCoeff_one_add_t, mul_one, map_add, map_add, map_add, idCoeff_one, idCoeff_t,
    t_mul_t, idCoeff_one]
  intro h
  have : (1 : R) = 0 := by linear_combination h
  exact one_ne_zero this

/-- The two `a, b` above are in the blocks the law is about, so the hand
computation `pair_law_disjoint` is literally the instance
`disjointBlock_sym R (n+1) a _ b _`. -/
theorem pair_law_disjoint_is_instance (n : ℕ) :
    idCoeff R ((1 + t R n) * (1 + t R (n + 1)))
      = idCoeff R (1 + t R n) * idCoeff R (1 + t R (n + 1)) :=
  disjointBlock_sym R (n + 1) _ (one_add_t_mem_H R n) _ (one_add_t_succ_mem_shifted R n)

end QOU.MathlibExt.SymmetricGroupTowerWitness
