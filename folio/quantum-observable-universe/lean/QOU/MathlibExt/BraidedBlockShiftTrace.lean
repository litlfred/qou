import QOU.MathlibExt.HeckeSandwichReduces

/-!
# Disjoint strand blocks on a braided tower: the trace multiplies, and a block's trace does not see where it sits

Bean `qou-5zl1`, step 3.  Two facts about any Markov trace on a braided tower
(`OcneanuTrace.MarkovTrace` with the `HeckeSandwichReduces.BraidedTower`
relations):

1. **Multiplicativity over consecutive strand windows.**  If block `k` lies in
   `H (3k+2)` (generated by `g_t`, `t ≤ 3k+1`) and in `shifted (3k)` (generated by
   `g_t`, `t ≥ 3k`), then
   `tr (blk 0 * blk 1 * ⋯ * blk n) = tr (blk 0) * ⋯ * tr (blk n)`
   (`tr_blockProd`).  Each step is one application of the disjoint-block law
   `disjointBlock_of_braided`, which the corpus has already proved from the
   three Hecke relations.

2. **Shift invariance.**  For a word `w` whose letters are `a • 1 + b • g_{off+i}`
   with every `i ≤ L`, `tr (w at offset off) = tr (w at offset 0)`
   (`tr_wordVal_shift`).  The proof conjugates by `c = g_off g_{off+1} ⋯ g_{off+L+1}`,
   which satisfies `c g_t = g_{t+1} c` for `off ≤ t ≤ off + L` (`cyc_mul_g`, from
   the braid and far-commutation relations alone), and uses the trace property.

Together they say that a word made of disjoint nucleon blocks has trace equal to
the product of the traces of the nucleon words, each read at offset `0`.

Letters are affine, `a • 1 + b • g_i`.  An inverse generator is such a letter on
a braided tower: `ginv i = g i - h • 1` (`OcneanuTrace.gen_inv_eq_of_quadratic`),
which `ginv_letter` records.

Base ring: generic `[CommRing R]`, generic `R`-algebra `A`; no ordering.

-- Ref: [jones1987] https://doi.org/10.2307/1971403
-- Ref: [leitner2026] bean qou-5zl1.
-/

namespace QOU.MathlibExt.BraidedBlockShiftTrace

open QOU.MathlibExt.OcneanuTrace QOU.MathlibExt.DisjointBlockTrace
  QOU.MathlibExt.HeckeSandwichReduces

variable {R : Type*} [CommRing R] {A : Type*} [Ring A] [Algebra R A]
variable (T : MarkovTrace R A)

/-! ## Letters and words -/

/-- The letter `(i, a, b)` placed at offset `off`: `a • 1 + b • g_{off+i}`. -/
def letterVal (off : ℕ) (l : ℕ × R × R) : A := l.2.1 • (1 : A) + l.2.2 • T.g (off + l.1)

/-- A word of letters at offset `off`, multiplied left to right. -/
def wordVal (off : ℕ) (w : List (ℕ × R × R)) : A := (w.map (letterVal T off)).prod

@[simp] theorem wordVal_nil (off : ℕ) : wordVal T off [] = 1 := rfl

@[simp] theorem wordVal_cons (off : ℕ) (l : ℕ × R × R) (w : List (ℕ × R × R)) :
    wordVal T off (l :: w) = letterVal T off l * wordVal T off w := rfl

/-- The inverse generator is the affine letter `(i, -h, 1)` once `g_i` satisfies
`g² = h g + 1`. -/
theorem ginv_letter (off i : ℕ) (h : R) (hq : T.g (off + i) * T.g (off + i) = h • T.g (off + i) + 1) :
    T.ginv (off + i) = letterVal T off (i, -h, 1) := by
  rw [T.gen_inv_eq_of_quadratic (off + i) h hq, letterVal, one_smul, neg_smul]
  abel

theorem letterVal_mem_H (off L : ℕ) (l : ℕ × R × R) (hl : l.1 ≤ L) :
    letterVal T off l ∈ T.H (off + L + 1) := by
  have hg : T.g (off + l.1) ∈ T.H (off + L + 1) :=
    T.H_mono (show off + l.1 + 1 ≤ off + L + 1 by omega) (T.g_mem _)
  exact Subalgebra.add_mem _ (Subalgebra.smul_mem _ (Subalgebra.one_mem _) _)
    (Subalgebra.smul_mem _ hg _)

theorem wordVal_mem_H (off L : ℕ) :
    ∀ w : List (ℕ × R × R), (∀ l ∈ w, l.1 ≤ L) → wordVal T off w ∈ T.H (off + L + 1)
  | [], _ => Subalgebra.one_mem _
  | l :: w, hw => Subalgebra.mul_mem _
      (letterVal_mem_H T off L l (hw l (List.mem_cons_self ..)))
      (wordVal_mem_H off L w fun l' hl' => hw l' (List.mem_cons_of_mem _ hl'))

theorem letterVal_mem_shifted (off : ℕ) (l : ℕ × R × R) :
    letterVal T off l ∈ shifted T off :=
  Subalgebra.add_mem _ (Subalgebra.smul_mem _ (Subalgebra.one_mem _) _)
    (Subalgebra.smul_mem _ (g_mem_shifted T off l.1) _)

theorem wordVal_mem_shifted (off : ℕ) :
    ∀ w : List (ℕ × R × R), wordVal T off w ∈ shifted T off
  | [] => Subalgebra.one_mem _
  | l :: w => Subalgebra.mul_mem _ (letterVal_mem_shifted T off l) (wordVal_mem_shifted off w)

/-! ## The shift element `c = g_s g_{s+1} ⋯ g_{s+m-1}` -/

/-- `cyc s m = g_s * g_{s+1} * ⋯ * g_{s+m-1}`. -/
def cyc (s : ℕ) : ℕ → A
  | 0 => 1
  | m + 1 => cyc s m * T.g (s + m)

/-- `cycInv s m = ginv_{s+m-1} * ⋯ * ginv_s`. -/
def cycInv (s : ℕ) : ℕ → A
  | 0 => 1
  | m + 1 => T.ginv (s + m) * cycInv s m

theorem cyc_mul_cycInv (s : ℕ) : ∀ m, cyc T s m * cycInv T s m = 1
  | 0 => by simp [cyc, cycInv]
  | m + 1 => by
      rw [cyc, cycInv, mul_assoc, ← mul_assoc (T.g _), T.mul_ginv, one_mul, cyc_mul_cycInv s m]

theorem cycInv_mul_cyc (s : ℕ) : ∀ m, cycInv T s m * cyc T s m = 1
  | 0 => by simp [cyc, cycInv]
  | m + 1 => by
      rw [cyc, cycInv, mul_assoc, ← mul_assoc (cycInv T s m), cycInv_mul_cyc s m, one_mul,
        T.ginv_mul]

variable [hbt : BraidedTower T]

/-- A generator above the range of `cyc s m` commutes with it. -/
theorem g_commute_cyc {s t : ℕ} : ∀ m, s + m < t → T.g t * cyc T s m = cyc T s m * T.g t
  | 0, _ => by simp [cyc]
  | m + 1, h => by
      rw [cyc, ← mul_assoc, g_commute_cyc m (by omega), mul_assoc, hbt.far t (s + m) (by omega),
        ← mul_assoc]

/-- **The shift relation** `c g_t = g_{t+1} c` for `s ≤ t` and `t + 1 < s + m`,
from the braid and far-commutation relations. -/
theorem cyc_mul_g {s t : ℕ} (hst : s ≤ t) : ∀ m, t + 1 < s + m →
    cyc T s m * T.g t = T.g (t + 1) * cyc T s m
  | 0, h => absurd h (by omega)
  | m + 1, h => by
      rcases Nat.lt_or_ge (t + 1) (s + m) with hlt | hge
      · -- `t` lies inside the old range: commute past the new factor, then induct.
        calc cyc T s (m + 1) * T.g t = cyc T s m * (T.g (s + m) * T.g t) := by
              rw [cyc, mul_assoc]
          _ = cyc T s m * T.g t * T.g (s + m) := by rw [hbt.far (s + m) t hlt, mul_assoc]
          _ = T.g (t + 1) * cyc T s m * T.g (s + m) := by rw [cyc_mul_g hst m hlt]
          _ = T.g (t + 1) * cyc T s (m + 1) := by rw [cyc, mul_assoc]
      · -- `t + 1 = s + m`: the braid relation at the top of the range.
        obtain ⟨m', rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by omega⟩
        obtain rfl : t = s + m' := by omega
        have hb := hbt.braid (s + m')
        rw [show s + (m' + 1) = s + m' + 1 by omega] at *
        simp only [cyc]
        calc cyc T s m' * T.g (s + m') * T.g (s + m' + 1) * T.g (s + m')
            = cyc T s m' * (T.g (s + m') * T.g (s + m' + 1) * T.g (s + m')) := by
              simp only [mul_assoc]
          _ = cyc T s m' * (T.g (s + m' + 1) * T.g (s + m') * T.g (s + m' + 1)) := by rw [hb]
          _ = T.g (s + m' + 1) * cyc T s m' * T.g (s + m') * T.g (s + m' + 1) := by
              rw [← mul_assoc, ← mul_assoc, g_commute_cyc T m' (by omega)]
          _ = T.g (s + m' + 1) * (cyc T s m' * T.g (s + m') * T.g (s + (m' + 1))) := by
              rw [show s + (m' + 1) = s + m' + 1 by omega]; simp only [mul_assoc]

theorem cyc_mul_letter {s m off : ℕ} (l : ℕ × R × R) (h1 : s ≤ off + l.1)
    (h2 : off + l.1 + 1 < s + m) :
    cyc T s m * letterVal T off l = letterVal T (off + 1) l * cyc T s m := by
  have hg := cyc_mul_g T h1 m h2
  have hidx : off + 1 + l.1 = off + l.1 + 1 := by omega
  rw [letterVal, letterVal, mul_add, add_mul, mul_smul_comm, mul_one, smul_mul_assoc, one_mul,
    mul_smul_comm, hg, smul_mul_assoc, hidx]

theorem cyc_mul_word {s m off : ℕ} :
    ∀ w : List (ℕ × R × R), (∀ l ∈ w, s ≤ off + l.1 ∧ off + l.1 + 1 < s + m) →
      cyc T s m * wordVal T off w = wordVal T (off + 1) w * cyc T s m
  | [], _ => by simp
  | l :: w, hw => by
      have hl := hw l (List.mem_cons_self ..)
      rw [wordVal_cons, wordVal_cons, ← mul_assoc, cyc_mul_letter T l hl.1 hl.2, mul_assoc,
        cyc_mul_word w (fun l' hl' => hw l' (List.mem_cons_of_mem _ hl')), mul_assoc]

/-- **Shifting a word by one strand does not change its trace.** -/
theorem tr_wordVal_succ (off L : ℕ) (w : List (ℕ × R × R)) (hw : ∀ l ∈ w, l.1 ≤ L) :
    T.tr (wordVal T (off + 1) w) = T.tr (wordVal T off w) := by
  have hc := cyc_mul_word T (s := off) (m := L + 2) (off := off) w
    (fun l hl => ⟨by omega, by have := hw l hl; omega⟩)
  calc T.tr (wordVal T (off + 1) w)
      = T.tr (wordVal T (off + 1) w * cyc T off (L + 2) * cycInv T off (L + 2)) := by
        rw [mul_assoc, cyc_mul_cycInv, mul_one]
    _ = T.tr (cyc T off (L + 2) * wordVal T off w * cycInv T off (L + 2)) := by rw [hc]
    _ = T.tr (cycInv T off (L + 2) * cyc T off (L + 2) * wordVal T off w) := by
        rw [T.tr_mul_comm, ← mul_assoc]
    _ = T.tr (wordVal T off w) := by rw [cycInv_mul_cyc, one_mul]

/-- **A word's trace does not depend on its offset.** -/
theorem tr_wordVal_shift (L : ℕ) (w : List (ℕ × R × R)) (hw : ∀ l ∈ w, l.1 ≤ L) :
    ∀ off, T.tr (wordVal T off w) = T.tr (wordVal T 0 w)
  | 0 => rfl
  | off + 1 => by rw [tr_wordVal_succ T off L w hw, tr_wordVal_shift L w hw off]

/-! ## Multiplicativity over consecutive strand windows -/

/-- `blk 0 * blk 1 * ⋯ * blk n`, multiplied left to right. -/
def blockProd (blk : ℕ → A) (n : ℕ) : A := ((List.range (n + 1)).map blk).prod

omit hbt in
theorem blockProd_succ (blk : ℕ → A) (n : ℕ) :
    blockProd blk (n + 1) = blockProd blk n * blk (n + 1) := by
  simp [blockProd, List.range_succ, List.prod_append, mul_assoc]

omit hbt in
theorem blockProd_mem_H (blk : ℕ → A) (hlow : ∀ k, blk k ∈ T.H (3 * k + 2)) :
    ∀ n, blockProd blk n ∈ T.H (3 * n + 2)
  | 0 => by simpa [blockProd] using hlow 0
  | n + 1 => by
      rw [blockProd_succ]
      exact Subalgebra.mul_mem _
        (T.H_mono (show 3 * n + 2 ≤ 3 * (n + 1) + 2 by omega) (blockProd_mem_H blk hlow n))
        (hlow (n + 1))

omit hbt in
/-- **Core form**: given the disjoint-block law, the trace of a product of blocks in
consecutive strand windows is the product of the block traces. -/
theorem tr_blockProd_of_disjointBlock (hD : DisjointBlockMultiplicative T) (blk : ℕ → A)
    (hlow : ∀ k, blk k ∈ T.H (3 * k + 2)) (hhigh : ∀ k, blk k ∈ shifted T (3 * k)) :
    ∀ n, T.tr (blockProd blk n) = ∏ k ∈ Finset.range (n + 1), T.tr (blk k)
  | 0 => by simp [blockProd]
  | n + 1 => by
      have hpre : blockProd blk n ∈ T.H (3 * (n + 1)) :=
        T.H_mono (show 3 * n + 2 ≤ 3 * (n + 1) by omega) (blockProd_mem_H T blk hlow n)
      rw [blockProd_succ, hD _ _ hpre _ (hhigh (n + 1)),
        tr_blockProd_of_disjointBlock hD blk hlow hhigh n, Finset.prod_range_succ _ (n + 1)]

/-- **On every braided tower**, the trace of a product of blocks in consecutive
strand windows is the product of the block traces. -/
theorem tr_blockProd (blk : ℕ → A) (hlow : ∀ k, blk k ∈ T.H (3 * k + 2))
    (hhigh : ∀ k, blk k ∈ shifted T (3 * k)) (n : ℕ) :
    T.tr (blockProd blk n) = ∏ k ∈ Finset.range (n + 1), T.tr (blk k) :=
  tr_blockProd_of_disjointBlock T (disjointBlock_of_braided T) blk hlow hhigh n

/-- **Nucleon blocks.**  Block `k` is the word `word k` placed on strands
`3k, 3k+1, 3k+2` (letters at generator index `≤ 1`).  The trace of the product of
all blocks is the product of the traces of the words, each read at offset `0`. -/
theorem tr_blockProd_words (word : ℕ → List (ℕ × R × R)) (hw : ∀ k, ∀ l ∈ word k, l.1 ≤ 1)
    (n : ℕ) :
    T.tr (blockProd (fun k => wordVal T (3 * k) (word k)) n)
      = ∏ k ∈ Finset.range (n + 1), T.tr (wordVal T 0 (word k)) := by
  rw [tr_blockProd T _ (fun k => by simpa [add_assoc] using wordVal_mem_H T (3 * k) 1 (word k) (hw k))
    (fun k => wordVal_mem_shifted T (3 * k) (word k)) n]
  exact Finset.prod_congr rfl fun k _ => tr_wordVal_shift T 1 (word k) (hw k) (3 * k)

/-- **Two nucleon types.**  If block `k` is the proton word when `isP k` and the
neutron word otherwise, the product of block traces is `P_p ^ Z * P_n ^ N`, with
`Z` and `N` the numbers of proton and neutron blocks among `0 … n`. -/
theorem tr_blockProd_pn (isP : ℕ → Prop) [DecidablePred isP] (wp wn : List (ℕ × R × R))
    (hp : ∀ l ∈ wp, l.1 ≤ 1) (hn : ∀ l ∈ wn, l.1 ≤ 1) (n : ℕ) :
    T.tr (blockProd (fun k => wordVal T (3 * k) (if isP k then wp else wn)) n)
      = T.tr (wordVal T 0 wp) ^ ((Finset.range (n + 1)).filter isP).card
        * T.tr (wordVal T 0 wn) ^ ((Finset.range (n + 1)).filter (fun k => ¬ isP k)).card := by
  rw [tr_blockProd_words T (fun k => if isP k then wp else wn)
    (fun k => by dsimp only; split_ifs; exacts [hp, hn]) n]
  have e : ∀ k, T.tr (wordVal T 0 (if isP k then wp else wn))
      = if isP k then T.tr (wordVal T 0 wp) else T.tr (wordVal T 0 wn) := fun k => by
    split_ifs <;> rfl
  simp_rw [e]
  rw [Finset.prod_ite, Finset.prod_const, Finset.prod_const]

end QOU.MathlibExt.BraidedBlockShiftTrace
