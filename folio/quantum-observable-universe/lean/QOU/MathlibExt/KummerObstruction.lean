import Mathlib.Data.ZMod.Basic
import Mathlib.Algebra.NoZeroSMulDivisors.Basic
import Mathlib.Algebra.Module.LinearMap.Defs

/-!
# The Kummer obstruction and torsion-free coefficients (C-5a)

On a closed surface `S`, the obstruction to an `n`-th root of a line bundle
of degree `d` is the image of `d` under `ℤ → ℤ/n` (Kummer sequence
`1 → μ_n → 𝔾_m → 𝔾_m → 1`). Here that obstruction is modelled by its value
`(d : ZMod n)`; the identification of `H²(S, μ_n)` with `ℤ/n` is not
formalised (Mathlib has no sheaf cohomology of curves).

Two facts:
1. the Kummer obstruction is the mod-`n` reduction of ONE integer, so it is
   zero iff `n ∣ d`; for Bring's surface (`d = χ = -6`) iff `n ∣ 6`;
2. any additive map from `ℤ/n` into a torsion-free group is zero, so a
   class valued in a torsion-free group (for example a trace in a
   characteristic-zero field) cannot be the image of the Kummer class under
   a group homomorphism, except by vanishing identically.
-/

namespace QOU.KummerObstruction

/-- The Kummer obstruction at level `n` for degree `d`: `d mod n`. -/
def kummerObstruction (d : ℤ) (n : ℕ) : ZMod n := (d : ZMod n)

theorem kummerObstruction_eq_zero_iff (d : ℤ) (n : ℕ) :
    kummerObstruction d n = 0 ↔ (n : ℤ) ∣ d :=
  ZMod.intCast_zmod_eq_zero_iff_dvd d n

/-- Bring's surface, `χ = -6`: the obstruction vanishes iff `n ∣ 6`. -/
theorem bring_kummerObstruction_eq_zero_iff (n : ℕ) :
    kummerObstruction (-6) n = 0 ↔ n ∣ 6 := by
  rw [kummerObstruction_eq_zero_iff, Int.dvd_neg]
  exact_mod_cast Iff.rfl

/-- R1 bridge: if the level-0 Markov trace of the identity is the integer
`χ(A)` (relation C-4b, `tr_M(id) = χ(A)`), the Kummer obstruction is that trace
reduced mod `n`. The trace value is a hypothesis here, not proved. -/
theorem kummerObstruction_eq_trace_id_mod (trId χ : ℤ) (hC4b : trId = χ)
    (n : ℕ) : kummerObstruction χ n = (trId : ZMod n) := by
  rw [hC4b]; rfl

/-- Every additive map from `ℤ/n` (`n ≠ 0`) into an `ℕ`-torsion-free group
is zero. -/
theorem addMonoidHom_zmod_eq_zero {M : Type*} [AddCommGroup M]
    [NoZeroSMulDivisors ℕ M] {n : ℕ} (hn : n ≠ 0) (φ : ZMod n →+ M) :
    φ = 0 := by
  ext x
  have h : n • φ x = 0 := by
    rw [← map_nsmul, nsmul_eq_mul, ZMod.natCast_self, zero_mul, map_zero]
  rcases smul_eq_zero.mp h with h | h
  · exact absurd h hn
  · simpa using h

/-- No additive map from `ℤ/n` into a torsion-free group can detect a
nonzero Kummer class. -/
theorem not_detects_kummer {M : Type*} [AddCommGroup M]
    [NoZeroSMulDivisors ℕ M] (d : ℤ) {n : ℕ} (hn : n ≠ 0)
    (φ : ZMod n →+ M) : φ (kummerObstruction d n) = 0 := by
  rw [addMonoidHom_zmod_eq_zero hn φ]; rfl

/-- At `n = 4` the Bring Kummer class is nonzero, yet every map into a
torsion-free group sends it to `0`: the class is not recoverable from any
torsion-free-valued image. -/
theorem bring_level_four_invisible {M : Type*} [AddCommGroup M]
    [NoZeroSMulDivisors ℕ M] :
    kummerObstruction (-6) 4 ≠ 0 ∧
      ∀ φ : ZMod 4 →+ M, φ (kummerObstruction (-6) 4) = 0 := by
  refine ⟨?_, fun φ => not_detects_kummer (-6) (n := 4) (by decide) φ⟩
  rw [Ne, bring_kummerObstruction_eq_zero_iff]; decide

end QOU.KummerObstruction

/-!
## The jet obstruction JC-4 / C-5 vanishes on descended R-matrices

Model of the jet relations (`vertex-algebra-jet-relations`, J-1, J-3, JC-4):
the jet embedding `ℓ : H⁽ⁿ⁾ → H⁽ⁿ⁺¹⁾` with `ℓ σᵢ = σᵢ`, and traces satisfying
the level compatibility `tr' ∘ ℓ = tr` (J-3). The obstruction is
`κ = tr'(Ř' − ℓ Ř)`. It is a difference of two scalars, and it vanishes
whenever `Ř'` is the jet image of `Ř` (for instance `Ř = σᵢ` at every level).
-/


namespace QOU.JetObstruction

variable {K Hn Hn1 : Type*} [CommRing K] [Ring Hn] [Ring Hn1]
  [Module K Hn] [Module K Hn1]

/-- `κ = tr'(R') - tr(R)`: the obstruction is a difference of two scalars. -/
theorem kappa_eq_sub (ℓ : Hn →+ Hn1) (tr : Hn →ₗ[K] K) (tr' : Hn1 →ₗ[K] K)
    (hcompat : ∀ w, tr' (ℓ w) = tr w) (R : Hn) (R' : Hn1) :
    tr' (R' - ℓ R) = tr' R' - tr R := by
  rw [map_sub, hcompat]

omit [Module K Hn] in
/-- If the level-`(n+1)` R-matrix is the jet image of the level-`n` one
(as it is when `Ř` is the generator `σ_i`, since `ℓ σ_i = σ_i`), the
obstruction vanishes identically. -/
theorem kappa_eq_zero_of_descended (ℓ : Hn →+ Hn1) (tr' : Hn1 →ₗ[K] K)
    (R : Hn) (R' : Hn1) (hdesc : R' = ℓ R) :
    tr' (R' - ℓ R) = 0 := by
  rw [hdesc, sub_self, map_zero]

omit [Module K Hn] in
/-- The transient part `(1 - τ̂) Ř'`, with `τ̂ = ℓ ∘ 𝔡` (JC-4, second form),
vanishes for every `Ř'` once `ℓ` is surjective and `𝔡 ∘ ℓ = id`. Under J-1 the
level-`(n+1)` algebra is generated by `σᵢ⁽ⁿ⁺¹⁾ = ℓ σᵢ⁽ⁿ⁾`, so `ℓ` is
surjective whenever it is multiplicative and the strand count is fixed. -/
theorem transient_eq_zero_of_surjective (ℓ : Hn →+ Hn1) (𝔡 : Hn1 →+ Hn)
    (tr' : Hn1 →ₗ[K] K) (hsurj : Function.Surjective ℓ)
    (hret : ∀ w, 𝔡 (ℓ w) = w) (R' : Hn1) :
    tr' (R' - ℓ (𝔡 R')) = 0 := by
  obtain ⟨w, rfl⟩ := hsurj R'
  rw [hret, sub_self, map_zero]

end QOU.JetObstruction
