import QOU.MathlibExt.QIntegerCanonical
import Mathlib.Tactic.Module
import Mathlib.Algebra.Algebra.Defs
import Mathlib.Algebra.Module.LinearMap.Defs
import Mathlib.RingTheory.Adjoin.Basic

/-!
# QOU.Archimedean.rj_canonical_inner_product — Rosso–Jones inner product, convention D

**Proposition** ([`prop:rj-canonical-inner-product`](../../../predicted-spectra/rj-canonical-inner-product.md)).

Hecke relation `(σ − q)(σ + q⁻¹) = 0`, `[n] = (qⁿ − q⁻ⁿ)/(q − q⁻¹)` (`qIntBal`),
Markov parameter `z = q³/(q² + 1) = q²/[2]` (convention D).

## What this file proves (sorry-free, over a generic field `R`)

* `markovZD_eq` — the block's `z = q²/[2]` is `z_D = q³/(q²+1)`.
* `hookContent_row` — the hook-content product of the one-row shape `(r)`:
  `∏_{i<r} [2+i] = [r+1] · ∏_{i<r} [r−i]`, i.e. `d_(r) = [r+1]` (denominators
  cleared, so no non-vanishing hypothesis is needed).
* `hookContent_hook` — the same for the two-row hook `(m,1)`: `d_(m,1) = [m]`.
  These are the two hook dimensions that survive in part (iii).
* `h2Trace_rossoJones` — part (iii) at `r = 2`, for **every** `s`, computed in
  `H₂(q)` itself (basis `{1, σ}`, `σ² = (q − q⁻¹)σ + 1`) with the Markov trace
  `tr(1) = 1`, `tr(σ) = z_D`:
  `[2]² · tr_M(σˢ) = [3] qˢ + (−q⁻¹)ˢ`.
  For odd `s` (the torus knots `τ(2,s)`) this is the block's
  `[r+1] q^{s(r−1)} − [r−1] q^{s(r−3)}` at `r = 2` (`h2Trace_rossoJones_odd`).
* `h3Trace_rossoJones` — part (iii) at `r = 3`, for **every** `s`, computed in
  `H₃(q)` on the basis `{1, σ₁, σ₂, σ₁σ₂, σ₂σ₁, σ₁σ₂σ₁}`:
  `[2]³ · tr_M((σ₁σ₂)ˢ) = [4] q^{2s} + [2]·χ(s)`, `χ(s) = 2` if `3 ∣ s`, else `−1`.
  For `3 ∤ s` (torus knots `τ(3,s)`) this is the block's formula at `r = 3`
  (`h3Trace_rossoJones_coprime`). The right-multiplication tables are derived
  from the Hecke and braid relations in an arbitrary `R`-algebra
  (`H3.eval_rs1`, `H3.eval_rs2`), and the trace values on the basis are forced
  by the Markov conditions (`H3.markov3_unique`); `h3_markov_rossoJones` states
  the result for **every** linear functional satisfying them.
* `H3.markov3_unique_adjoin` — part (ii)'s uniqueness input at `r = 3`: two
  Markov traces with the same `z` agree on the whole subalgebra generated by
  `σ₁, σ₂` (that subalgebra is spanned by the six basis words,
  `H3.exists_eval_of_mem_adjoin`).
* `old_form_ii_false_r2` — the formerly carried field `claim_unique_up_to_scalar`
  ("every diagonal form normalised at the trivial class is a scalar multiple of
  `d_λ`") is **false** already at `r = 2`.

## What it does NOT prove — stated here so the gap stays visible

* Part (iii) for general `r` (the hook/Adams-sign Rosso–Jones formula) is
  **not** formalised; only `r = 2` and `r = 3` are here (by explicit computation in
  `H₂`, `H₃`), and `r = 4` is in `QOU.Archimedean.RossoJonesH4`
  (`h4_markov_rossoJones`). It is cited (`[rosso-jones1993]`) and re-verified in exact
  arithmetic over `ℚ(q)` for every coprime `(r,s)` tested at `r = 2, 3, 4` by
  `computations/probes/rj_inner_product_conventionD_torus_probe.py`. It is
  deliberately **not** encoded as a class field: a class whose torus-trace datum
  is unconstrained data is inhabited by defining that datum to be the right-hand
  side, which is the self-assuming pattern AGENTS.md §1a forbids. Formalising it
  honestly needs the Markov trace on `H_r(q)` for general `r`
  (`QOU.IwahoriHecke.MarkovTrace`), which is open infrastructure.
* Part (ii)'s positive content — the form is `[2]^r tr_M(p_λ p_μ)` and is fixed
  because the Markov trace with `tr_M(1) = 1` is unique for given `z` — rests on
  Markov uniqueness, formalised here only for `r ≤ 3` (`H3.markov3_unique_adjoin`;
  `r = 2` is immediate from `{1, σ}` spanning `H₂`). General `r` needs a
  normal-form / spanning theorem for `H_r(q)`. That is now proved for every `r`
  in `QOU.IwahoriHecke.JonesNormalForm` (`markov_unique`), and
  `QOU.IwahoriHecke.MarkovTransfer` carries it across algebras. (The older modules
  `QOU.Hecke.MarkovTrace`, `QOU.IwahoriHecke.MarkovTrace` carry the trace as class
  data. `QOU.Hecke.markov_trace_unique` was proved from `markov_trace_unique_axiom`,
  which was **false** and has been removed; it is now a theorem that takes the
  cross-level Markov property `MarkovTrace.IsMarkov` as a hypothesis; the concrete
  traces on `H₂`, `H₃`, `H₄` satisfy it, `QOU.Hecke.MarkovTraceIsMarkov`.)

## History

Until 2026-10-10 this file carried a self-assuming `HeckeRepRingContext` class
whose fields `claim_unique_up_to_scalar` (false, see `old_form_ii_false_r2`) and
`jonesPoly_eq_eval` (the convention-C sum `Σ_{λ⊢r} d_λ q^{c_λ s}`, which agrees
with the trace only for `r = 2`, `s` even) were projected out as "theorems".
Both are removed; bean `qou-q425`.

-- Ref: [rosso-jones1993] Rosso–Jones, *J. Knot Theory Ramifications* 2 (1993)
-/

namespace QOU.Archimedean

open QOU.QInteger Finset

variable {R : Type*} [Field R]

/-! ### Small quantum integers -/

theorem qIntBal_one (q : R) (hq : q ≠ 0) (hq2 : q ^ 2 ≠ 1) : qIntBal q 1 = 1 := by
  have h : q - q⁻¹ ≠ 0 := by
    intro h; apply hq2; field_simp at h; linear_combination h
  simp [qIntBal_def, h]

theorem qIntBal_two (q : R) (hq : q ≠ 0) (hq2 : q ^ 2 ≠ 1) :
    qIntBal q 2 = q + q⁻¹ := by
  have h : q - q⁻¹ ≠ 0 := by
    intro h; apply hq2; field_simp at h; linear_combination h
  rw [qIntBal_def, div_eq_iff h]; ring

theorem qIntBal_three (q : R) (hq : q ≠ 0) (hq2 : q ^ 2 ≠ 1) :
    qIntBal q 3 = q ^ 2 + 1 + q⁻¹ ^ 2 := by
  have h : q - q⁻¹ ≠ 0 := by
    intro h; apply hq2; field_simp at h; linear_combination h
  rw [qIntBal_def, div_eq_iff h]; field_simp; ring

/-! ### The Markov parameter -/

/-- Convention-D Markov parameter `z_D = q³/(q²+1)`. -/
noncomputable def markovZD (q : R) : R := q ^ 3 / (q ^ 2 + 1)

/-- The block's `z = q²/[2]` is `z_D`. -/
theorem markovZD_eq (q : R) (hq : q ≠ 0) (hq2 : q ^ 2 ≠ 1) (hq1 : q ^ 2 + 1 ≠ 0) :
    markovZD q = q ^ 2 / qIntBal q 2 := by
  rw [qIntBal_two q hq hq2, markovZD]
  have : q + q⁻¹ ≠ 0 := by
    intro h; apply hq1; field_simp at h; linear_combination h
  field_simp

/-! ### Hook-content dimensions `d_λ = ∏ [2 + c(□)] / [h(□)]` of the surviving hooks -/

/-- Telescoping core: `∏_{i<r} [i+2] = [r+1] · ∏_{i<r} [i+1]`. -/
theorem prod_shift (q : R) (hq : q ≠ 0) (hq2 : q ^ 2 ≠ 1) (r : ℕ) :
    ∏ i ∈ range r, qIntBal q (i + 2) = qIntBal q (r + 1) * ∏ i ∈ range r, qIntBal q (i + 1) := by
  induction r with
  | zero => rw [range_zero, prod_empty, prod_empty, mul_one, zero_add, qIntBal_one q hq hq2]
  | succ n ih =>
    rw [prod_range_succ, prod_range_succ, ih]
    ring

/-- **One-row shape `(r)`**: contents `0,…,r−1`, hooks `r,…,1`. The hook-content
product, denominators cleared, gives `d_(r) = [r+1]`. -/
theorem hookContent_row (q : R) (hq : q ≠ 0) (hq2 : q ^ 2 ≠ 1) (r : ℕ) :
    ∏ i ∈ range r, qIntBal q (2 + i) = qIntBal q (r + 1) * ∏ i ∈ range r, qIntBal q (r - i) := by
  have hrefl : ∏ i ∈ range r, qIntBal q (r - i) = ∏ i ∈ range r, qIntBal q (i + 1) := by
    rw [← prod_range_reflect]
    refine prod_congr rfl fun i hi => ?_
    have := mem_range.mp hi
    congr 1; omega
  rw [hrefl]
  simp_rw [add_comm 2]
  exact prod_shift q hq hq2 r

/-- **Two-row hook `(m,1)`, `m ≥ 1`** (so `r = m+1`): first-row cells have
contents `0,…,m−1` and hooks `m+1` (corner) then `m−1,…,1`; the second-row cell
has content `−1` and hook `1`. Denominators cleared, `d_(m,1) = [m]`. -/
theorem hookContent_hook (q : R) (hq : q ≠ 0) (hq2 : q ^ 2 ≠ 1) (m : ℕ) (hm : 1 ≤ m) :
    qIntBal q 1 * ∏ j ∈ range m, qIntBal q (2 + j)
      = qIntBal q m *
        (qIntBal q (m + 1) * qIntBal q 1 * ∏ j ∈ range (m - 1), qIntBal q (m - 1 - j)) := by
  obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
  have hrow := hookContent_row q hq hq2 (k + 1)
  have hrefl : ∏ j ∈ range k, qIntBal q (k - j) = ∏ i ∈ range k, qIntBal q (i + 1) := by
    rw [← prod_range_reflect]
    refine prod_congr rfl fun i hi => ?_
    have := mem_range.mp hi
    congr 1; omega
  have hrefl' : ∏ i ∈ range (k + 1), qIntBal q (k + 1 - i)
      = ∏ i ∈ range (k + 1), qIntBal q (i + 1) := by
    rw [← prod_range_reflect]
    refine prod_congr rfl fun i hi => ?_
    have := mem_range.mp hi
    congr 1; omega
  simp only [Nat.add_sub_cancel] at *
  rw [hrow, hrefl', hrefl, prod_range_succ]
  ring

/-! ### Part (iii) at `r = 2`, computed in `H₂(q)` -/

/-- Coordinates `(a, b)` of `σˢ = a + bσ` in `H₂(q)`, basis `{1, σ}`.
Multiplying `a + bσ` by `σ` and using `σ² = (q − q⁻¹)σ + 1` gives
`b + (a + (q − q⁻¹) b) σ`. -/
noncomputable def h2Pow (q : R) : ℕ → R × R
  | 0 => (1, 0)
  | s + 1 => ((h2Pow q s).2, (h2Pow q s).1 + (q - q⁻¹) * (h2Pow q s).2)

/-- The Markov trace on `H₂(q)`: `tr(1) = 1`, `tr(σ) = z_D`. -/
noncomputable def h2Trace (q : R) (s : ℕ) : R := (h2Pow q s).1 + (h2Pow q s).2 * markovZD q

/-- `σ` acts on its two eigenlines by `q` and `−q⁻¹`. -/
theorem h2Pow_eigen (q : R) (hq : q ≠ 0) (s : ℕ) :
    (h2Pow q s).1 + (h2Pow q s).2 * q = q ^ s ∧
      (h2Pow q s).1 + (h2Pow q s).2 * (-q⁻¹) = (-q⁻¹) ^ s := by
  induction s with
  | zero => simp [h2Pow]
  | succ n ih =>
    obtain ⟨h1, h2⟩ := ih
    simp only [h2Pow]
    constructor
    · rw [pow_succ, ← h1]; field_simp; ring
    · rw [pow_succ, ← h2]; field_simp; ring

/-- **Rosso–Jones at `r = 2`, every `s`**: `[2]² · tr_M(σˢ) = [3] qˢ + (−q⁻¹)ˢ`.
The weights are `d_(2)/[2]² = [3]/[2]²` and `d_(1,1)/[2]² = [1]/[2]²`. -/
theorem h2Trace_rossoJones (q : R) (hq : q ≠ 0) (hq2 : q ^ 2 ≠ 1) (hq1 : q ^ 2 + 1 ≠ 0)
    (s : ℕ) :
    qIntBal q 2 ^ 2 * h2Trace q s = qIntBal q 3 * q ^ s + (-q⁻¹) ^ s := by
  obtain ⟨h1, h2⟩ := h2Pow_eigen q hq s
  rw [← h1, ← h2, qIntBal_two q hq hq2, qIntBal_three q hq hq2, h2Trace, markovZD]
  field_simp
  ring

/-- **Torus knots `τ(2, s)`, `s` odd**: the block's formula
`[r+1] q^{s(r−1)} − [r−1] q^{s(r−3)}` at `r = 2`. -/
theorem h2Trace_rossoJones_odd (q : R) (hq : q ≠ 0) (hq2 : q ^ 2 ≠ 1)
    (hq1 : q ^ 2 + 1 ≠ 0) (s : ℕ) (hs : Odd s) :
    qIntBal q 2 ^ 2 * h2Trace q s = qIntBal q 3 * q ^ s - qIntBal q 1 * q⁻¹ ^ s := by
  rw [h2Trace_rossoJones q hq hq2 hq1, qIntBal_one q hq hq2, neg_pow, hs.neg_one_pow]
  ring

/-! ### The old part (ii) is false -/

/-- The field formerly carried as `claim_unique_up_to_scalar` — every diagonal
form normalised at the trivial class is a scalar multiple of `d_λ` — fails at
`r = 2` (classes `(2) ↦ 0`, `(1,1) ↦ 1`, `d = ([3], [1])`): the diagonal form
`diag(1, 0)` is not a multiple of it. A diagonal form has one free entry per
two-row class; only the Markov trace (unique for given `z`) fixes the form. -/
theorem old_form_ii_false_r2 (q : R) (hq : q ≠ 0) (hq2 : q ^ 2 ≠ 1) :
    ¬ ∀ φ : Fin 2 → Fin 2 → R, (∀ i j, i ≠ j → φ i j = 0) → φ 0 0 = 1 →
        ∃ c : R, ∀ i, φ i i = c * ![qIntBal q 3, qIntBal q 1] i := by
  intro h
  obtain ⟨c, hc⟩ := h (fun i j => if i = 0 ∧ j = 0 then 1 else 0)
    (fun i j hij => by simp only [ite_eq_right_iff, and_imp]; intro hi hj; exact absurd (hi.trans hj.symm) hij)
    (by simp)
  have h1 : (0 : R) = c * 1 := by
    have := hc 1
    rw [qIntBal_one q hq hq2] at this
    simpa using this
  have h0 : (1 : R) = c * qIntBal q 3 := by
    have := hc 0
    simpa using this
  rw [mul_one] at h1
  rw [← h1, zero_mul] at h0
  exact one_ne_zero h0

/-- **Top-level bundle** for `prop:rj-canonical-inner-product`, the part that is
formalised: the Markov parameter is `z_D`, the surviving hook dimensions are
`[r+1]` and `[r−1]`, and part (iii) holds at `r = 2` for every `s`. -/
theorem rj_canonical_inner_product (q : R) (hq : q ≠ 0) (hq2 : q ^ 2 ≠ 1)
    (hq1 : q ^ 2 + 1 ≠ 0) :
    markovZD q = q ^ 2 / qIntBal q 2 ∧
    (∀ r : ℕ, ∏ i ∈ range r, qIntBal q (2 + i)
        = qIntBal q (r + 1) * ∏ i ∈ range r, qIntBal q (r - i)) ∧
    (∀ s : ℕ, qIntBal q 2 ^ 2 * h2Trace q s = qIntBal q 3 * q ^ s + (-q⁻¹) ^ s) :=
  ⟨markovZD_eq q hq hq2 hq1, hookContent_row q hq hq2, h2Trace_rossoJones q hq hq2 hq1⟩


/-! ### Part (iii) at `r = 3`, computed in `H₃(q)`

`H₃(q)` has the standard basis `{1, σ₁, σ₂, σ₁σ₂, σ₂σ₁, σ₁σ₂σ₁}`. Right
multiplication by `σ₁`, `σ₂` on these coordinates is derived from the Hecke
relation `σᵢ² = (q − q⁻¹)σᵢ + 1` and the braid relation `σ₁σ₂σ₁ = σ₂σ₁σ₂`
(`H3.eval_rs1`, `H3.eval_rs2` prove the derivation in any `R`-algebra carrying
such generators). The Markov trace on the basis is then **forced** by
`tr(1) = 1`, `tr(σ₁) = z`, cyclicity and the Markov property on
`H₂ = span{1, σ₁}` (`markov3_unique`). The torus braid `γ = σ₁σ₂` is iterated
on the coordinates and its trace is evaluated in closed form
(`h3Trace_rossoJones`). Nothing about the answer is assumed: the only inputs
are the defining relations and the Markov conditions. -/

/-- Coordinates of an element of `H₃(q)` in the basis
`{1, σ₁, σ₂, σ₁σ₂, σ₂σ₁, σ₁σ₂σ₁}`. -/
structure H3 (R : Type*) where
  e : R
  a : R
  b : R
  ab : R
  ba : R
  aba : R

namespace H3

/-- Right multiplication by `σ₁`: `σ₁·σ₁ = (q−q⁻¹)σ₁ + 1`,
`σ₂σ₁·σ₁ = (q−q⁻¹)σ₂σ₁ + σ₂`, `σ₁σ₂σ₁·σ₁ = (q−q⁻¹)σ₁σ₂σ₁ + σ₁σ₂`. -/
noncomputable def rs1 (q : R) (v : H3 R) : H3 R :=
  ⟨v.a, v.e + (q - q⁻¹) * v.a, v.ba, v.aba, v.b + (q - q⁻¹) * v.ba,
    v.ab + (q - q⁻¹) * v.aba⟩

/-- Right multiplication by `σ₂`: `σ₂·σ₂ = (q−q⁻¹)σ₂ + 1`,
`σ₁σ₂·σ₂ = (q−q⁻¹)σ₁σ₂ + σ₁`, `σ₂σ₁·σ₂ = σ₁σ₂σ₁` (braid),
`σ₁σ₂σ₁·σ₂ = (q−q⁻¹)σ₁σ₂σ₁ + σ₂σ₁`. -/
noncomputable def rs2 (q : R) (v : H3 R) : H3 R :=
  ⟨v.b, v.ab, v.e + (q - q⁻¹) * v.b, v.a + (q - q⁻¹) * v.ab, v.aba,
    v.ba + (q - q⁻¹) * v.aba⟩

/-- The unit `1 ∈ H₃(q)`. -/
def one : H3 R := ⟨1, 0, 0, 0, 0, 0⟩

/-- Coordinates of `γˢ`, `γ = σ₁σ₂` (the `(3, s)` torus braid). -/
noncomputable def gammaPow (q : R) : ℕ → H3 R
  | 0 => one
  | s + 1 => rs2 q (rs1 q (gammaPow q s))

/-- The Markov trace on the basis, as forced by the Markov conditions
(`markov3_unique`): `tr(1) = 1`, `tr(σᵢ) = z`, `tr(σ₁σ₂) = tr(σ₂σ₁) = z²`,
`tr(σ₁σ₂σ₁) = z·(1 + (q − q⁻¹) z)`. -/
noncomputable def markovTr (q z : R) (v : H3 R) : R :=
  v.e + z * (v.a + v.b) + z ^ 2 * (v.ab + v.ba) + z * (1 + (q - q⁻¹) * z) * v.aba

/-- The trivial character `σᵢ ↦ q`, read on coordinates. -/
noncomputable def triv (q : R) (v : H3 R) : R :=
  v.e + q * (v.a + v.b) + q ^ 2 * (v.ab + v.ba) + q ^ 3 * v.aba

section Embed

variable {A : Type*} [Ring A] [Algebra R A]

/-- Evaluation of coordinates in an `R`-algebra with chosen `s₁, s₂`. -/
def eval (s1 s2 : A) (v : H3 R) : A :=
  v.e • (1 : A) + v.a • s1 + v.b • s2 + v.ab • (s1 * s2) + v.ba • (s2 * s1)
    + v.aba • (s1 * s2 * s1)

variable (q : R) (s1 s2 : A)
  (h1 : s1 * s1 = (q - q⁻¹) • s1 + 1) (h2 : s2 * s2 = (q - q⁻¹) • s2 + 1)
  (hbr : s1 * s2 * s1 = s2 * s1 * s2)
include h1

theorem eval_rs1 (v : H3 R) : eval s1 s2 (rs1 q v) = eval s1 s2 v * s1 := by
  have k1 : s2 * s1 * s1 = (q - q⁻¹) • (s2 * s1) + s2 := by
    rw [mul_assoc, h1, mul_add, mul_smul_comm, mul_one]
  have k2 : s1 * s2 * s1 * s1 = (q - q⁻¹) • (s1 * s2 * s1) + s1 * s2 := by
    rw [mul_assoc, h1, mul_add, mul_smul_comm, mul_one]
  simp only [eval, rs1, add_mul, smul_mul_assoc, one_mul, h1, k1, k2]
  simp only [smul_add, add_smul, mul_smul]
  module

include h2 hbr

omit h1 in
theorem eval_rs2 (v : H3 R) : eval s1 s2 (rs2 q v) = eval s1 s2 v * s2 := by
  have k1 : s1 * s2 * s2 = (q - q⁻¹) • (s1 * s2) + s1 := by
    rw [mul_assoc, h2, mul_add, mul_smul_comm, mul_one]
  have k2 : s1 * s2 * s1 * s2 = (q - q⁻¹) • (s1 * s2 * s1) + s2 * s1 := by
    rw [hbr, mul_assoc, h2, mul_add, mul_smul_comm, mul_one]
  simp only [eval, rs2, add_mul, smul_mul_assoc, one_mul, k1, k2, ← hbr]
  simp only [h2, smul_add, add_smul, mul_smul]
  module

/-- `γˢ = (s₁s₂)ˢ` is the evaluation of `gammaPow q s`. -/
theorem eval_gammaPow (s : ℕ) : eval s1 s2 (gammaPow q s) = (s1 * s2) ^ s := by
  induction s with
  | zero => simp [gammaPow, one, eval]
  | succ n ih =>
    rw [gammaPow, eval_rs2 q s1 s2 h2 hbr, eval_rs1 q s1 s2 h1, ih, pow_succ, mul_assoc]

omit h2 hbr in
/-- **Markov uniqueness on `H₃`.** Any `R`-linear functional `t` with `t 1 = 1`,
`t s₁ = z`, `t(xy) = t(yx)`, and the Markov property `t(x s₂) = z t(x)` for
`x ∈ H₂ = span{1, s₁}` takes the value `markovTr q z v` on `eval v`. In
particular it is unique given `z`. -/
theorem markov3_unique (z : R) (t : A →ₗ[R] R) (ht1 : t 1 = 1) (hts1 : t s1 = z)
    (hcyc : ∀ x y : A, t (x * y) = t (y * x))
    (hmark : ∀ c d : R, t ((c • (1 : A) + d • s1) * s2) = z * t (c • (1 : A) + d • s1))
    (v : H3 R) : t (eval s1 s2 v) = markovTr q z v := by
  have ts2 : t s2 = z := by
    have := hmark 1 0
    simpa [ht1] using this
  have ts12 : t (s1 * s2) = z ^ 2 := by
    have := hmark 0 1
    simp only [zero_smul, zero_add, one_smul] at this
    rw [this, hts1]; ring
  have ts21 : t (s2 * s1) = z ^ 2 := by rw [hcyc, ts12]
  have ts121 : t (s1 * s2 * s1) = z * (1 + (q - q⁻¹) * z) := by
    rw [hcyc, ← mul_assoc, h1]
    have := hmark 1 (q - q⁻¹)
    rw [one_smul, add_comm] at this
    rw [this, map_add, map_smul, ht1, hts1, smul_eq_mul]
    ring
  simp only [eval, map_add, map_smul, ht1, hts1, ts2, ts12, ts21, ts121, smul_eq_mul, markovTr]
  ring

end Embed

/-- The trivial character is multiplicative along `σ₁`. -/
theorem triv_rs1 (q : R) (hq : q ≠ 0) (v : H3 R) : triv q (rs1 q v) = q * triv q v := by
  simp only [triv, rs1]; field_simp; ring

/-- The trivial character is multiplicative along `σ₂`. -/
theorem triv_rs2 (q : R) (hq : q ≠ 0) (v : H3 R) : triv q (rs2 q v) = q * triv q v := by
  simp only [triv, rs2]; field_simp; ring

theorem triv_gammaPow (q : R) (hq : q ≠ 0) (s : ℕ) : triv q (gammaPow q s) = q ^ (2 * s) := by
  induction s with
  | zero => simp [triv, gammaPow, one]
  | succ n ih =>
    rw [gammaPow, triv_rs2 q hq, triv_rs1 q hq, ih]; ring

end H3

theorem qIntBal_four (q : R) (hq : q ≠ 0) (hq2 : q ^ 2 ≠ 1) :
    qIntBal q 4 = q ^ 3 + q + q⁻¹ + q⁻¹ ^ 3 := by
  have h : q - q⁻¹ ≠ 0 := by
    intro h; apply hq2; field_simp at h; linear_combination h
  rw [qIntBal_def, div_eq_iff h]; field_simp; ring

open H3 in
/-- The residual `g = [2]³·tr_M − [4]·triv` is invariant under the full twist
`γ³ = Δ²`: `Δ²` acts by `1` on the two-row block `(2,1)` and the Ocneanu weight
of the three-row block `(1³)` is `0` under convention D. Proved as an identity
in the six coordinates. -/
theorem h3_residual_fullTwist (q : R) (hq : q ≠ 0) (hq2 : q ^ 2 ≠ 1) (hq1 : q ^ 2 + 1 ≠ 0)
    (v : H3 R) :
    let st := fun w : H3 R => rs2 q (rs1 q w)
    qIntBal q 2 ^ 3 * markovTr q (markovZD q) (st (st (st v)))
        - qIntBal q 4 * triv q (st (st (st v)))
      = qIntBal q 2 ^ 3 * markovTr q (markovZD q) v - qIntBal q 4 * triv q v := by
  simp only [rs1, rs2, markovTr, triv, markovZD, qIntBal_two q hq hq2, qIntBal_four q hq hq2]
  field_simp
  ring

open H3 in
/-- **Rosso–Jones at `r = 3`, every `s`**, in `H₃(q)` with the convention-D
Markov trace: `[2]³ · tr_M((σ₁σ₂)ˢ) = [4] q^{2s} + [2] · χ(s)`, where
`χ(s) = 2` if `3 ∣ s` and `−1` otherwise (the character of `γˢ` on the
two-row block `(2,1)`, whose sl₂ dimension is `[2]`; the `(1³)` block carries
weight `0`). -/
theorem h3Trace_rossoJones (q : R) (hq : q ≠ 0) (hq2 : q ^ 2 ≠ 1) (hq1 : q ^ 2 + 1 ≠ 0)
    (s : ℕ) :
    qIntBal q 2 ^ 3 * markovTr q (markovZD q) (gammaPow q s)
      = qIntBal q 4 * q ^ (2 * s) + qIntBal q 2 * (if s % 3 = 0 then 2 else -1) := by
  rw [← triv_gammaPow q hq s]
  suffices H : ∀ s, qIntBal q 2 ^ 3 * markovTr q (markovZD q) (gammaPow q s)
      - qIntBal q 4 * triv q (gammaPow q s) = qIntBal q 2 * (if s % 3 = 0 then 2 else -1) by
    rw [← H s]; ring
  intro s
  induction s using Nat.strong_induction_on with
  | _ s ih =>
    match s, ih with
    | 0, _ =>
      simp only [gammaPow, one, markovTr, triv, markovZD, qIntBal_two q hq hq2,
        qIntBal_four q hq hq2]
      norm_num
      field_simp
      ring
    | 1, _ =>
      simp only [gammaPow, one, rs1, rs2, markovTr, triv, markovZD, qIntBal_two q hq hq2,
        qIntBal_four q hq hq2]
      norm_num
      field_simp
      ring
    | 2, _ =>
      simp only [gammaPow, one, rs1, rs2, markovTr, triv, markovZD, qIntBal_two q hq hq2,
        qIntBal_four q hq hq2]
      norm_num
      field_simp
      ring
    | n + 3, ih =>
      have hp := h3_residual_fullTwist q hq hq2 hq1 (gammaPow q n)
      simp only at hp
      have e : gammaPow q (n + 3)
          = rs2 q (rs1 q (rs2 q (rs1 q (rs2 q (rs1 q (gammaPow q n)))))) := rfl
      rw [e, hp, ih n (by omega), show (n + 3) % 3 = n % 3 by omega]

open H3 in
/-- **Torus knots `τ(3, s)`, `3 ∤ s`**: the block's formula
`[r+1] q^{s(r−1)} − [r−1] q^{s(r−3)}` at `r = 3`. -/
theorem h3Trace_rossoJones_coprime (q : R) (hq : q ≠ 0) (hq2 : q ^ 2 ≠ 1)
    (hq1 : q ^ 2 + 1 ≠ 0) (s : ℕ) (hs : ¬ 3 ∣ s) :
    qIntBal q 2 ^ 3 * markovTr q (markovZD q) (gammaPow q s)
      = qIntBal q 4 * q ^ (s * 2) - qIntBal q 2 * q ^ (s * 0) := by
  rw [h3Trace_rossoJones q hq hq2 hq1, if_neg (by omega)]
  ring

open H3 in
/-- **Part (iii) at `r = 3` for every Markov trace.** In any `R`-algebra `A`
with `s₁, s₂` satisfying the Hecke and braid relations, any linear functional
satisfying the convention-D Markov conditions has
`[2]³ · t((s₁s₂)ˢ) = [4] q^{2s} + [2]·χ(s)`. -/
theorem h3_markov_rossoJones {A : Type*} [Ring A] [Algebra R A] (q : R)
    (hq : q ≠ 0) (hq2 : q ^ 2 ≠ 1) (hq1 : q ^ 2 + 1 ≠ 0) (s1 s2 : A)
    (h1 : s1 * s1 = (q - q⁻¹) • s1 + 1) (h2 : s2 * s2 = (q - q⁻¹) • s2 + 1)
    (hbr : s1 * s2 * s1 = s2 * s1 * s2) (t : A →ₗ[R] R) (ht1 : t 1 = 1)
    (hts1 : t s1 = markovZD q) (hcyc : ∀ x y : A, t (x * y) = t (y * x))
    (hmark : ∀ c d : R,
      t ((c • (1 : A) + d • s1) * s2) = markovZD q * t (c • (1 : A) + d • s1))
    (s : ℕ) :
    qIntBal q 2 ^ 3 * t ((s1 * s2) ^ s)
      = qIntBal q 4 * q ^ (2 * s) + qIntBal q 2 * (if s % 3 = 0 then 2 else -1) := by
  rw [← eval_gammaPow q s1 s2 h1 h2 hbr,
    markov3_unique q s1 s2 h1 (markovZD q) t ht1 hts1 hcyc hmark]
  exact h3Trace_rossoJones q hq hq2 hq1 s


namespace H3

/-- Coordinate-wise sum. -/
def add (v w : H3 R) : H3 R :=
  ⟨v.e + w.e, v.a + w.a, v.b + w.b, v.ab + w.ab, v.ba + w.ba, v.aba + w.aba⟩

/-- Coordinate-wise scalar multiple. -/
def smul (c : R) (v : H3 R) : H3 R :=
  ⟨c * v.e, c * v.a, c * v.b, c * v.ab, c * v.ba, c * v.aba⟩

section Span

variable {A : Type*} [Ring A] [Algebra R A] (s1 s2 : A)

theorem eval_add (v w : H3 R) : eval s1 s2 (add v w) = eval s1 s2 v + eval s1 s2 w := by
  simp only [eval, add, add_smul]; abel

theorem eval_smul (c : R) (v : H3 R) : eval s1 s2 (smul c v) = c • eval s1 s2 v := by
  simp only [eval, smul, smul_add, mul_smul]

/-- Every element of the subalgebra generated by `s₁, s₂` is the evaluation of
some coordinate vector, i.e. `{1, s₁, s₂, s₁s₂, s₂s₁, s₁s₂s₁}` spans it. -/
theorem exists_eval_of_mem_adjoin (q : R)
    (h1 : s1 * s1 = (q - q⁻¹) • s1 + 1) (h2 : s2 * s2 = (q - q⁻¹) • s2 + 1)
    (hbr : s1 * s2 * s1 = s2 * s1 * s2) {x : A}
    (hx : x ∈ Algebra.adjoin R ({s1, s2} : Set A)) : ∃ v : H3 R, eval s1 s2 v = x := by
  have r1 := eval_rs1 q s1 s2 h1
  have r2 := eval_rs2 q s1 s2 h2 hbr
  induction hx using Algebra.adjoin_induction with
  | mem y hy =>
    rcases hy with rfl | rfl
    · exact ⟨⟨0, 1, 0, 0, 0, 0⟩, by simp [eval]⟩
    · exact ⟨⟨0, 0, 1, 0, 0, 0⟩, by simp [eval]⟩
  | algebraMap c =>
    exact ⟨⟨c, 0, 0, 0, 0, 0⟩, by simp [eval, Algebra.algebraMap_eq_smul_one]⟩
  | add y z _ _ hy hz =>
    obtain ⟨v, rfl⟩ := hy
    obtain ⟨w, rfl⟩ := hz
    exact ⟨add v w, eval_add s1 s2 v w⟩
  | mul y z _ _ hy hz =>
    obtain ⟨v, rfl⟩ := hy
    obtain ⟨w, rfl⟩ := hz
    refine ⟨add (add (add (add (add (smul w.e v) (smul w.a (rs1 q v)))
      (smul w.b (rs2 q v))) (smul w.ab (rs2 q (rs1 q v))))
      (smul w.ba (rs1 q (rs2 q v)))) (smul w.aba (rs1 q (rs2 q (rs1 q v)))), ?_⟩
    simp only [eval_add, eval_smul, r1, r2]
    generalize eval s1 s2 v = X
    simp only [eval, mul_add, mul_smul_comm, mul_one, mul_assoc]

/-- **Markov uniqueness on the whole of `H₃`** (part (ii) at `r = 3`): two linear
functionals satisfying the Markov conditions for the same `z` agree on every
element of the subalgebra generated by `s₁, s₂`. -/
theorem markov3_unique_adjoin (q z : R)
    (h1 : s1 * s1 = (q - q⁻¹) • s1 + 1) (h2 : s2 * s2 = (q - q⁻¹) • s2 + 1)
    (hbr : s1 * s2 * s1 = s2 * s1 * s2) (t t' : A →ₗ[R] R)
    (ht1 : t 1 = 1) (hts1 : t s1 = z) (hcyc : ∀ x y : A, t (x * y) = t (y * x))
    (hmark : ∀ c d : R, t ((c • (1 : A) + d • s1) * s2) = z * t (c • (1 : A) + d • s1))
    (ht1' : t' 1 = 1) (hts1' : t' s1 = z) (hcyc' : ∀ x y : A, t' (x * y) = t' (y * x))
    (hmark' : ∀ c d : R, t' ((c • (1 : A) + d • s1) * s2) = z * t' (c • (1 : A) + d • s1))
    {x : A} (hx : x ∈ Algebra.adjoin R ({s1, s2} : Set A)) : t x = t' x := by
  obtain ⟨v, rfl⟩ := exists_eval_of_mem_adjoin s1 s2 q h1 h2 hbr hx
  rw [markov3_unique q s1 s2 h1 z t ht1 hts1 hcyc hmark,
    markov3_unique q s1 s2 h1 z t' ht1' hts1' hcyc' hmark']

end Span

end H3

end QOU.Archimedean
