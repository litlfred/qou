import QOU.Mass.QuantumSl2ClaspModuleMap

/-!
# The clasp commutes with `Δ(F)`

`QuantumSl2ClaspModuleMap` shows that the clasp `X = (cap ⊗ 1 ⊗ 1)(1 ⊗ M ⊗ 1)(1 ⊗ 1 ⊗ cup)`
commutes with `Δ(E)` and so fixes the line of each highest-weight vector `w_j`. This file proves
the companion identity `X Δ(F) = Δ(F) X`. Together they give: `X` acts on the whole `F`-string
`Δ(F)^i w_j`, i.e. on the summand `V_{2n+1} ⊂ V_{m+1} ⊗ V_{m+1}` generated by `w_j`
(`m = j + n`), by the same scalar it has on `w_j` (`clasp_deltaF_pow_hwVec`). This is the
clasp half of Zheng's decomposition `X = ⊕_n C(n) · id_{V_{2n+1}}` used in van der Veen's
Lemma 1.

-- Ref: [vanderveen2008] van der Veen, AGT 8 (2008) 603–624, proof of Lemma 1
-- Ref: [kassel1995] Kassel, "Quantum Groups", Ch. XIV
-/

namespace QOU.Mass.QuantumSl2

open Matrix
open scoped Kronecker

variable {𝕜 : Type*} [Field 𝕜]

/-- `Δ(K⁻¹) = K⁻¹ ⊗ K⁻¹` on `V_{m+1} ⊗ V_{m'+1}`. -/
def deltaKm (q : 𝕜) (m m' : ℕ) :
    Matrix (Fin (m + 1) × Fin (m' + 1)) (Fin (m + 1) × Fin (m' + 1)) 𝕜 :=
  irrepKm q m ⊗ₖ irrepKm q m'

section IntertwineF

variable (s : 𝕜) (hs : s ≠ 0)

/-- **`Ř` is a module map for `K⁻¹`.** -/
theorem rCheckMat_deltaKm (m m' : ℕ) :
    rCheckMat s hs m m' * deltaKm (s ^ 2) m m' = deltaKm (s ^ 2) m' m * rCheckMat s hs m m' := by
  unfold rCheckMat deltaKm
  rw [← submatrix_id_id (irrepKm (s ^ 2) m ⊗ₖ irrepKm (s ^ 2) m'),
    ← submatrix_mul _ _ _ _ _ Function.bijective_id, rMat_Km s hs m m',
    submatrix_mul _ _ _ Prod.swap _ Prod.swap_bijective]
  congr 1
  ext x y
  simp only [submatrix_apply, Prod.swap, kroneckerMap_apply]
  ring

/-- **The monodromy commutes with `Δ(K⁻¹)`.** -/
theorem mono_deltaKm (m m' : ℕ) :
    mono s hs m m' * deltaKm (s ^ 2) m m' = deltaKm (s ^ 2) m m' * mono s hs m m' := by
  unfold mono
  rw [Matrix.mul_assoc, rCheckMat_deltaKm s hs m m', ← Matrix.mul_assoc,
    rCheckMat_deltaKm s hs m' m, Matrix.mul_assoc]

variable (hq2 : s ^ 2 - (s ^ 2)⁻¹ ≠ 0)

include hq2 in
/-- **The monodromy commutes with `Δ(F)`.** -/
theorem mono_deltaF (m m' : ℕ) (hint : ∀ k < rOrder m m', qint (s ^ 2) (k + 1) ≠ 0) :
    mono s hs m m' * deltaF (s ^ 2) m m' = deltaF (s ^ 2) m m' * mono s hs m m' :=
  monodromy_deltaF s hs hq2 m m' hint

end IntertwineF

/-! ### Cup and cap against `Δ(F)` and `Δ(K⁻¹)` -/

theorem deltaF_cupCol (q : 𝕜) (hq : q ≠ 0) (m : ℕ) (hint : ∀ p < m, qint q (m - p) ≠ 0) :
    deltaF q m m * cupCol q m = 0 := by
  have h : deltaF q m m *ᵥ cupVec q m = 0 := cupVec_F q hq m hint
  ext x u
  have := congrFun h x
  simp only [mulVec, dotProduct] at this
  simp only [mul_apply, cupCol, of_apply, zero_apply]
  exact this

theorem capRow_deltaF (q : 𝕜) (hq : q ≠ 0) (m : ℕ)
    (hint : ∀ i, 0 < i → i ≤ m → qint q i ≠ 0) :
    capRow q m * deltaF q m m = 0 := by
  have h : capVec q m ᵥ* deltaF q m m = 0 := capVec_F q hq m hint
  ext u x
  have := congrFun h x
  simp only [vecMul, dotProduct] at this
  simp only [mul_apply, capRow, of_apply, zero_apply]
  exact this

theorem capRow_deltaK (q : 𝕜) (hq : q ≠ 0) (m : ℕ) :
    capRow q m * deltaK q m m = capRow q m := by
  have h : capVec q m ᵥ* deltaK q m m = capVec q m := capVec_K q hq m
  ext u x
  have := congrFun h x
  simp only [vecMul, dotProduct] at this
  simp only [mul_apply, capRow, of_apply]
  exact this

/-- **The cap is invariant under `Δ(K⁻¹)`**, since `Δ(K⁻¹) = Δ(K)⁻¹`. -/
theorem capRow_deltaKm (q : 𝕜) (hq : q ≠ 0) (m : ℕ) :
    capRow q m * deltaKm q m m = capRow q m := by
  have hKK : deltaK q m m * deltaKm q m m = 1 := by
    unfold deltaK deltaKm
    rw [← mul_kronecker_mul, show irrepKp q m * irrepKm q m = 1 from (irrep hq m).Kp_Km,
      one_kronecker_one]
  calc capRow q m * deltaKm q m m
      = (capRow q m * deltaK q m m) * deltaKm q m m := by rw [capRow_deltaK q hq m]
    _ = capRow q m := by rw [Matrix.mul_assoc, hKK, Matrix.mul_one]

/-! ### The four-fold tensor -/

/-- `Δ³(F)` on `(V ⊗ V) ⊗ (V ⊗ V)`, split `2 + 2`. -/
def delta4F (q : 𝕜) (m : ℕ) :
    Matrix ((Fin (m + 1) × Fin (m + 1)) × (Fin (m + 1) × Fin (m + 1)))
      ((Fin (m + 1) × Fin (m + 1)) × (Fin (m + 1) × Fin (m + 1))) 𝕜 :=
  deltaKm q m m ⊗ₖ deltaF q m m + deltaF q m m ⊗ₖ 1

/-- `Δ³(F)` on `V ⊗ ((V ⊗ V) ⊗ V)`, split `1 + 2 + 1`. -/
def delta4F' (q : 𝕜) (m : ℕ) :
    Matrix (Fin (m + 1) × ((Fin (m + 1) × Fin (m + 1)) × Fin (m + 1)))
      (Fin (m + 1) × ((Fin (m + 1) × Fin (m + 1)) × Fin (m + 1))) 𝕜 :=
  irrepKm q m ⊗ₖ (deltaKm q m m ⊗ₖ irrepF q m) + irrepKm q m ⊗ₖ (deltaF q m m ⊗ₖ 1)
    + irrepF q m ⊗ₖ (((1 : Matrix (Fin (m + 1)) (Fin (m + 1)) 𝕜) ⊗ₖ 1) ⊗ₖ 1)

/-- The two splittings of `Δ³(F)` agree (coassociativity, entrywise). -/
theorem delta4F_regroup (q : 𝕜) (m : ℕ) :
    delta4F q m = (delta4F' q m).submatrix (regroup m) (regroup m) := by
  have h1 : (1 : Matrix (Fin (m + 1) × Fin (m + 1)) (Fin (m + 1) × Fin (m + 1)) 𝕜) = 1 ⊗ₖ 1 :=
    one_kronecker_one.symm
  unfold delta4F delta4F'
  rw [h1]
  ext ⟨⟨c, d⟩, ⟨p, g⟩⟩ ⟨⟨c', d'⟩, ⟨p', g'⟩⟩
  simp only [regroup, Equiv.coe_fn_mk, submatrix_apply, deltaF, deltaKm, add_apply,
    kroneckerMap_apply]
  ring

theorem delta4F_cup4 (q : 𝕜) (hq : q ≠ 0) (m : ℕ) (hint : ∀ p < m, qint q (m - p) ≠ 0) :
    delta4F q m * cup4 q m = cup4 q m * (deltaF q m m ⊗ₖ (1 : Matrix Unit Unit 𝕜)) := by
  unfold delta4F cup4
  rw [Matrix.add_mul]
  simp only [← mul_kronecker_mul, mul_one, one_mul, Matrix.mul_one, Matrix.one_mul,
    deltaF_cupCol q hq m hint, kronecker_zero, zero_add]

theorem cap4_delta4F (q : 𝕜) (hq : q ≠ 0) (m : ℕ)
    (hint : ∀ i, 0 < i → i ≤ m → qint q i ≠ 0) :
    cap4 q m * delta4F q m = ((1 : Matrix Unit Unit 𝕜) ⊗ₖ deltaF q m m) * cap4 q m := by
  unfold delta4F cap4
  rw [Matrix.mul_add]
  simp only [← mul_kronecker_mul, mul_one, one_mul, Matrix.one_mul,
    capRow_deltaKm q hq m, capRow_deltaF q hq m hint, zero_kronecker, add_zero]

section ClaspF

variable (s : 𝕜) (hs : s ≠ 0) (hq2 : s ^ 2 - (s ^ 2)⁻¹ ≠ 0)

include hq2 in
theorem mid4_delta4F (m : ℕ) (hint : ∀ k < rOrder m m, qint (s ^ 2) (k + 1) ≠ 0) :
    mid4 s hs m * delta4F (s ^ 2) m = delta4F (s ^ 2) m * mid4 s hs m := by
  have hc : ((1 : Matrix (Fin (m + 1)) (Fin (m + 1)) 𝕜) ⊗ₖ
        (mono s hs m m ⊗ₖ (1 : Matrix (Fin (m + 1)) (Fin (m + 1)) 𝕜))) * delta4F' (s ^ 2) m
      = delta4F' (s ^ 2) m * ((1 : Matrix (Fin (m + 1)) (Fin (m + 1)) 𝕜) ⊗ₖ
        (mono s hs m m ⊗ₖ (1 : Matrix (Fin (m + 1)) (Fin (m + 1)) 𝕜))) := by
    unfold delta4F'
    simp only [mul_add, add_mul, ← mul_kronecker_mul, one_mul, mul_one, one_kronecker_one,
      mono_deltaKm s hs m m, mono_deltaF s hs hq2 m m hint]
  unfold mid4
  rw [delta4F_regroup, ← submatrix_mul _ _ _ _ _ (regroup m).bijective,
    ← submatrix_mul _ _ _ _ _ (regroup m).bijective, hc]

include hq2 in
theorem claspBig_commF (m : ℕ) (hint : ∀ i, 0 < i → i ≤ m → qint (s ^ 2) i ≠ 0) :
    claspBig s hs m * (deltaF (s ^ 2) m m ⊗ₖ (1 : Matrix Unit Unit 𝕜))
      = ((1 : Matrix Unit Unit 𝕜) ⊗ₖ deltaF (s ^ 2) m m) * claspBig s hs m := by
  have hq : s ^ 2 ≠ 0 := pow_ne_zero 2 hs
  have hr : ∀ k < rOrder m m, qint (s ^ 2) (k + 1) ≠ 0 := fun k hk =>
    hint (k + 1) (by omega) (by unfold rOrder at hk; omega)
  have hc : ∀ p < m, qint (s ^ 2) (m - p) ≠ 0 := fun p hp => hint (m - p) (by omega) (by omega)
  unfold claspBig
  simp only [Matrix.mul_assoc]
  rw [← delta4F_cup4 (s ^ 2) hq m hc, ← Matrix.mul_assoc (mid4 s hs m),
    mid4_delta4F s hs hq2 m hr, Matrix.mul_assoc, ← Matrix.mul_assoc (cap4 (s ^ 2) m),
    cap4_delta4F (s ^ 2) hq m hint, Matrix.mul_assoc]

include hq2 in
/-- **The clasp commutes with `Δ(F)`.** -/
theorem clasp_deltaF (m : ℕ) (hint : ∀ i, 0 < i → i ≤ m → qint (s ^ 2) i ≠ 0) :
    clasp s hs m * deltaF (s ^ 2) m m = deltaF (s ^ 2) m m * clasp s hs m := by
  have h1 : deltaF (s ^ 2) m m = (deltaF (s ^ 2) m m ⊗ₖ (1 : Matrix Unit Unit 𝕜)).submatrix
      (Equiv.prodPUnit _).symm (Equiv.prodPUnit _).symm := by
    ext a b; simp
  have h2 : deltaF (s ^ 2) m m = ((1 : Matrix Unit Unit 𝕜) ⊗ₖ deltaF (s ^ 2) m m).submatrix
      (Equiv.punitProd _).symm (Equiv.punitProd _).symm := by
    ext a b; simp
  unfold clasp
  conv_lhs => rw [h1]
  conv_rhs => rw [h2]
  rw [← submatrix_mul _ _ _ _ _ (Equiv.prodPUnit _).symm.bijective,
    ← submatrix_mul _ _ _ _ _ (Equiv.punitProd _).symm.bijective, claspBig_commF s hs hq2 m hint]

include hq2 in
/-- **The clasp is scalar on each `F`-string.** On `Δ(F)^i w_j`, which spans the summand
`V_{2n+1} ⊂ V_{m+1} ⊗ V_{m+1}` with `m = j + n`, the clasp acts by van der Veen's scalar
`Σ_{k=0}^{j} vdvTerm k (j−k) n`. -/
theorem clasp_deltaF_pow_hwVec (j n i : ℕ)
    (hint : ∀ i, 0 < i → i ≤ j + n → qint (s ^ 2) i ≠ 0) :
    clasp s hs (j + n) *ᵥ (deltaF (s ^ 2) (j + n) (j + n) ^ i *ᵥ hwVec (s ^ 2) (j + n) (j + n) j)
      = (∑ k ∈ Finset.range (j + 1), vdvTerm s k (j - k) n)
          • (deltaF (s ^ 2) (j + n) (j + n) ^ i *ᵥ hwVec (s ^ 2) (j + n) (j + n) j) := by
  have hc : Commute (clasp s hs (j + n)) (deltaF (s ^ 2) (j + n) (j + n) ^ i) :=
    Commute.pow_right (clasp_deltaF s hs hq2 (j + n) hint) i
  rw [mulVec_mulVec, hc.eq, ← mulVec_mulVec, clasp_hwVec s hs hq2 j n hint, mulVec_smul]

end ClaspF

end QOU.Mass.QuantumSl2
