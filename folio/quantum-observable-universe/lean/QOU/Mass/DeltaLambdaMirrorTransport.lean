import Mathlib.Algebra.Algebra.Defs
import Mathlib.Data.Matrix.Mul
import Mathlib.Tactic

/-!
# Mirror transport for the Δ_λ-weighted bond functional

Companion to `computations/probes/delta_lambda_mirror_symmetry_probe.py` (owner pick "2",
2026-10-11): is there a *derived* reason the functional
`Φ = Σ_λ y_λ χ^λ Δ_λ` should be evaluated on mirror-symmetric two-nucleon words, so that the
`pn` and `np` bonds agree?

Everything here is over a generic ring; `Φ` is any additive, cyclic functional and the
symmetries are abstract. Nothing below asserts a value of `Φ`.

* `bond_transport_aut`, `bond_transport_anti` — a `Φ`-preserving automorphism (resp. a cyclic
  `Φ` and a `Φ`-preserving anti-automorphism) that fixes the interface letter `s` transports
  the bond `Φ (x * s)` to `Φ (ψ x * s)`. This is the only way a symmetry can equate two bonds.
* `exchange_forced` — if such a symmetry maps the `pn` word to the `np` word, the bonds agree.
* `placement_exchange_covariant` — if the right-hand block carries the *mirrored* nucleon
  (the half twist maps left block to right block with the in-block mirror `m`), the exchange
  is a symmetry, so `pn = np` is forced for every nucleon word. This is a statement about the
  placement convention, not about the nucleon.
* `interface_bond_difference`, `interface_rescues_iff` — with equal free terms, no interface
  `a + b • s` in the subalgebra generated by `s` changes whether `pn = np`, except the trivial
  `b = 0` (no interaction).
* `diag_conj_necessary` — the criterion the probe uses for "mirror-fixed up to the centraliser
  of `s`" in a 2-dim irrep: diagonal conjugation preserves the diagonal and the product of the
  off-diagonal entries. Its failure is what the probe measures for the corpus nucleons.
-/

namespace QOU.Mass.DeltaLambdaMirrorTransport

section Transport

variable {R A : Type*} [CommRing R] [Ring A]

/-- A `Φ`-preserving ring automorphism fixing the interface letter transports the bond. -/
theorem bond_transport_aut (Φ : A →+ R) (φ : A →+* A) (hΦ : ∀ a, Φ (φ a) = Φ a)
    (s : A) (hs : φ s = s) (x : A) : Φ (x * s) = Φ (φ x * s) := by
  rw [← hΦ (x * s), map_mul, hs]

/-- A `Φ`-preserving anti-automorphism fixing `s`, with `Φ` cyclic, transports the bond. -/
theorem bond_transport_anti (Φ : A →+ R) (hcyc : ∀ a b, Φ (a * b) = Φ (b * a))
    (ψ : A → A) (hanti : ∀ a b, ψ (a * b) = ψ b * ψ a) (hΦ : ∀ a, Φ (ψ a) = Φ a)
    (s : A) (hs : ψ s = s) (x : A) : Φ (x * s) = Φ (ψ x * s) := by
  rw [← hΦ (x * s), hanti, hs, hcyc]

/-- If a `Φ`-preserving automorphism fixing `s` maps the `pn` word to the `np` word, the two
bonds agree. -/
theorem exchange_forced (Φ : A →+ R) (φ : A →+* A) (hΦ : ∀ a, Φ (φ a) = Φ a)
    (s : A) (hs : φ s = s) (Xpn Xnp : A) (hX : φ Xpn = Xnp) :
    Φ (Xpn * s) = Φ (Xnp * s) := by
  rw [bond_transport_aut Φ φ hΦ s hs, hX]

/-- **Reflected placement is exchange-covariant.** Let `eL eR : B → A` be the two block
embeddings, commuting with each other, and let the half twist `F` send the left block to the
right block (and back) through the in-block mirror `m`, an involution. Put the *mirrored*
nucleon on the right: `X x y = eL x * eR (m y)`. Then `F (X x y) = X y x`, so the bonds agree
for every pair of nucleon words. -/
theorem placement_exchange_covariant {B : Type*} (Φ : A →+ R) (F : A →+* A)
    (hΦ : ∀ a, Φ (F a) = Φ a) (s : A) (hs : F s = s)
    (eL eR : B → A) (m : B → B) (hm : ∀ b, m (m b) = b)
    (hFL : ∀ b, F (eL b) = eR (m b)) (hFR : ∀ b, F (eR b) = eL (m b))
    (hcomm : ∀ b c, eL b * eR c = eR c * eL b) (x y : B) :
    Φ (eL x * eR (m y) * s) = Φ (eL y * eR (m x) * s) := by
  apply exchange_forced Φ F hΦ s hs
  rw [map_mul, hFL, hFR, hm, hcomm]

end Transport

section Interface

variable {R A : Type*} [CommRing R] [Ring A] [Algebra R A]

/-- With equal free terms, the bond difference for the interface `a + b • s` is `b` times the
bare-letter bond difference. -/
theorem interface_bond_difference (Φ : A →ₗ[R] R) (Wpn Wnp s : A) (a b : R)
    (hfree : Φ Wpn = Φ Wnp) :
    Φ (Wpn * (algebraMap R A a + b • s)) - Φ (Wnp * (algebraMap R A a + b • s))
      = b * (Φ (Wpn * s) - Φ (Wnp * s)) := by
  simp only [mul_add, mul_smul_comm, ← Algebra.commutes, ← Algebra.smul_def, map_add,
    map_smul, smul_eq_mul, hfree]
  ring

/-- Over a domain, an interface in the subalgebra generated by `s` gives `pn = np` iff it is
trivial (`b = 0`) or the bare-letter bonds already agree. -/
theorem interface_rescues_iff [IsDomain R] (Φ : A →ₗ[R] R) (Wpn Wnp s : A) (a b : R)
    (hfree : Φ Wpn = Φ Wnp) :
    Φ (Wpn * (algebraMap R A a + b • s)) = Φ (Wnp * (algebraMap R A a + b • s))
      ↔ b = 0 ∨ Φ (Wpn * s) = Φ (Wnp * s) := by
  rw [← sub_eq_zero, interface_bond_difference Φ Wpn Wnp s a b hfree, mul_eq_zero, sub_eq_zero]

end Interface

section DiagonalConjugation

variable {K : Type*} [Field K]

/-- Diagonal conjugation in a 2-dim representation preserves the diagonal and the product of
the off-diagonal entries. (In the irrep `(2,1)` of `H_3` with `σ_a` diagonal, the elements
commuting with the interface letter act diagonally, so these are necessary conditions for a
nucleon to be mirror-fixed up to that centraliser.) -/
theorem diag_conj_necessary (P Q : Matrix (Fin 2) (Fin 2) K) (d : Fin 2 → K)
    (hd0 : d 0 ≠ 0) (hd1 : d 1 ≠ 0) (h : P * Matrix.diagonal d = Matrix.diagonal d * Q) :
    P 0 0 = Q 0 0 ∧ P 1 1 = Q 1 1 ∧ P 0 1 * P 1 0 = Q 0 1 * Q 1 0 := by
  have e : ∀ i j, P i j * d j = d i * Q i j := fun i j => by
    have := congrFun (congrFun h i) j
    simpa [Matrix.mul_diagonal, Matrix.diagonal_mul] using this
  refine ⟨?_, ?_, ?_⟩
  · have := e 0 0
    exact mul_right_cancel₀ hd0 (by rw [this, mul_comm])
  · have := e 1 1
    exact mul_right_cancel₀ hd1 (by rw [this, mul_comm])
  · have h01 := e 0 1
    have h10 := e 1 0
    have hdd : d 0 * d 1 ≠ 0 := mul_ne_zero hd0 hd1
    apply mul_right_cancel₀ hdd
    calc P 0 1 * P 1 0 * (d 0 * d 1) = (P 0 1 * d 1) * (P 1 0 * d 0) := by ring
      _ = (d 0 * Q 0 1) * (d 1 * Q 1 0) := by rw [h01, h10]
      _ = Q 0 1 * Q 1 0 * (d 0 * d 1) := by ring

end DiagonalConjugation


section InterfaceZero

variable {R A : Type*} [CommRing R] [Ring A] [Algebra R A]

/-- **Zero-coefficient specialization of `interface_bond_difference` (`idt1`).**
When `b = 0` and `Φ Wpn = Φ Wnp`, the interface bond difference vanishes. -/
theorem interface_bond_difference_zero (Φ : A →ₗ[R] R) (Wpn Wnp s : A) (a : R)
    (hfree : Φ Wpn = Φ Wnp) :
    Φ (Wpn * (algebraMap R A a + (0 : R) • s)) - Φ (Wnp * (algebraMap R A a + (0 : R) • s)) = 0 := by
  rw [interface_bond_difference Φ Wpn Wnp s a 0 hfree, zero_mul]

end InterfaceZero

end QOU.Mass.DeltaLambdaMirrorTransport
