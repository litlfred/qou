import QOU.Mass.KZHolonomy.SmoothGauge
import QOU.Mass.KZHolonomy.BraidRep
import QOU.Mass.KZHolonomy.ConfConnected
import QOU.MathlibExt.LocalCocycleGenerated

/-!
# A smooth gauge to KZ from conjugacy of the braid generators

Let `ω₁ = kzForm ρ κ c` be the KZ form and `ω₂` another flat form on the ordered configuration
space `Conf_{m+1}(ℂ)`, equivariant for a representation `ρ₂` of `S_{m+1}`:

    ω₂(z ∘ π)(u ∘ π) = ρ₂(π)⁻¹ ω₂(z)(u) ρ₂(π).

Let `U₂_j` be the `ω₂`-transport along the half-turn `γ_j` (`genPath j`), and suppose a unit
`c₀` intertwines the images of the Artin generators:

    c₀ · kzBraidRep(σ_j) = ρ₂(s_j) U₂_j(1) · c₀          for every j.

Then (`kz_gauge_of_braid_conj`) there is a differentiable `g` on `Conf_{m+1}(ℂ)`, a unit at
every point, with `g(p₁) = c₀` at the base configuration `p₁ = (0, 1, …, m)` and

    dg = ω₂ g − g ω₁.

**Proof.**  Put `G(p_π) = ρ₂(π)⁻¹ c₀ ρ(π)` at the base configurations `p_π`.  Along a permuted
half-turn `γ_j ∘ π` (from `p_π` to `p_{s_j π}`) the two transports are `ρᵢ(π)⁻¹ T_jⁱ ρᵢ(π)`
(equivariance), and the hypothesis on `σ_j` is exactly `G(p_{s_j π}) T¹ = T² G(p_π)`.  Arrows
with this property form a subgroupoid of the fundamental groupoid
(`LocalCocycle.conjMonodromy_of_generated`), so the monodromies at `p₁` are conjugate by
`c₀`, and `FlatGauge` gives the gauge.  `Conf_{m+1}(ℂ)` is path-connected (`ConfConnected`).

**Hypothesis that stays named.**  `hgen`: every loop at `p₁` lies in the subgroupoid
generated by the permuted half-turns.  This is Artin's presentation of the braid group as
`π₁` of the unordered configuration space, read on the ordered cover.  It is not in Mathlib;
it is proved for `m ≥ 1` in `ArtinGeneration` (`artin_generation`, `kz_gauge_of_braid_conj'`).
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace QOU.Mass.KZHolonomy

open Set CategoryTheory QOU.MathlibExt QOU.MathlibExt.Braid

variable {m : ℕ} {A : Type*} [NormedRing A] [NormedAlgebra ℂ A] [CompleteSpace A]

/-- Transport of an equivariant form along a permuted path. -/
theorem IsTransport.comp_perm_of {ω : (Fin (m + 1) → ℂ) → (Fin (m + 1) → ℂ) →L[ℝ] A}
    {ρ₂ : Equiv.Perm (Fin (m + 1)) →* A}
    (hω : ∀ (π : Equiv.Perm (Fin (m + 1))) (z u : Fin (m + 1) → ℂ),
      ω (z ∘ π) (u ∘ π) = ρ₂ π⁻¹ * ω z u * ρ₂ π)
    (π : Equiv.Perm (Fin (m + 1))) {γ γ' : ℝ → Fin (m + 1) → ℂ} {U : ℝ → A}
    (hU : IsTransport ω γ γ' U) :
    IsTransport ω (fun t => γ t ∘ π) (fun t => γ' t ∘ π) (fun t => ρ₂ π⁻¹ * U t * ρ₂ π) := by
  have h1 : ρ₂ π⁻¹ * ρ₂ π = 1 := by rw [← map_mul, inv_mul_cancel, map_one]
  have h2 : ρ₂ π * ρ₂ π⁻¹ = 1 := by rw [← map_mul, mul_inv_cancel, map_one]
  refine ⟨?_, fun t ht => ?_⟩
  · simp only [hU.1, mul_one, h1]
  · refine (((hU.2 t ht).const_mul (ρ₂ π⁻¹)).mul_const (ρ₂ π)).congr_deriv ?_
    show ρ₂ π⁻¹ * (ω (γ t) (γ' t) * U t) * ρ₂ π =
      ω (γ t ∘ π) (γ' t ∘ π) * (ρ₂ π⁻¹ * U t * ρ₂ π)
    rw [hω]
    have h2' : ∀ x : A, ρ₂ π * (ρ₂ π⁻¹ * x) = x := fun x => by rw [← mul_assoc, h2, one_mul]
    simp only [mul_assoc, h2']

/-- The base configurations `p_π` determine `π`. -/
theorem basePt_injective : Function.Injective (basePt (n := m + 1)) := by
  intro σ τ h
  ext k
  have := congrFun h k
  simp only [basePt, Nat.cast_inj] at this
  exact congrArg Fin.val (Fin.ext this)

/-- The permuted half-turns: arrows of the fundamental groupoid of `Conf_{m+1}(ℂ)` given by
`t ↦ γ_j(t) ∘ π`. -/
def halfTurnArrows (m : ℕ) :
    ∀ c d : FundamentalGroupoid (confSet (m + 1)), Set (c ⟶ d) := fun c d =>
  {p | ∃ (j : Fin m) (π : Equiv.Perm (Fin (m + 1))) (γ : Path c.as d.as),
    (∀ t : unitInterval, (γ t : Fin (m + 1) → ℂ) = genPath j t ∘ π) ∧ p = ⟦γ⟧}

/-- The base configuration `p₁ = (0, 1, …, m)`. -/
def basePt₁ (m : ℕ) : confSet (m + 1) :=
  ⟨basePt 1, kzRegion_subset_injective _ (basePt_mem 1)⟩

lemma isUnit_conjAt (ρ ρ₂ : Equiv.Perm (Fin (m + 1)) →* A) (c₀ : Aˣ)
    (π : Equiv.Perm (Fin (m + 1))) : IsUnit (ρ₂ π⁻¹ * c₀ * ρ π) :=
  (((Group.isUnit π⁻¹).map ρ₂).mul c₀.isUnit).mul ((Group.isUnit π).map ρ)

/-- The candidate gauge at the base configurations, `G(p_π) = ρ₂(π)⁻¹ c₀ ρ(π)`. -/
noncomputable def baseGauge (ρ ρ₂ : Equiv.Perm (Fin (m + 1)) →* A) (c₀ : Aˣ)
    (z : confSet (m + 1)) : Aˣᵐᵒᵖ := by
  classical
  exact if h : ∃ π, (z : Fin (m + 1) → ℂ) = basePt π then
    opUnit (ρ₂ h.choose⁻¹ * c₀ * ρ h.choose) else 1

theorem baseGauge_val (ρ ρ₂ : Equiv.Perm (Fin (m + 1)) →* A) (c₀ : Aˣ)
    {z : confSet (m + 1)} {π : Equiv.Perm (Fin (m + 1))} (hz : (z : Fin (m + 1) → ℂ) = basePt π) :
    ((baseGauge ρ ρ₂ c₀ z).unop : A) = ρ₂ π⁻¹ * c₀ * ρ π := by
  have h : ∃ π, (z : Fin (m + 1) → ℂ) = basePt π := ⟨π, hz⟩
  have hc : h.choose = π := basePt_injective (h.choose_spec.symm.trans hz)
  rw [baseGauge, dif_pos h, opUnit_val (by rw [hc]; exact isUnit_conjAt ρ ρ₂ c₀ π), hc]

omit [NormedAlgebra ℂ A] [CompleteSpace A] in
lemma op_conj_of {a b g g' : Aˣᵐᵒᵖ}
    (h : ((b.unop : A) * (g.unop : A)) = (g'.unop : A) * (a.unop : A)) : a⁻¹ * g * b = g' := by
  have hgb : g * b = a * g' := by
    apply MulOpposite.unop_injective; apply Units.ext
    simpa [MulOpposite.unop_mul] using h
  rw [mul_assoc, hgb, ← mul_assoc, inv_mul_cancel, one_mul]

/-- **Smooth gauge to KZ from conjugacy of the braid generators.** -/
theorem kz_gauge_of_braid_conj (ρ : Equiv.Perm (Fin (m + 1)) →* A) (κ c : ℂ)
    (ρ₂ : Equiv.Perm (Fin (m + 1)) →* A)
    {ω₂ : (Fin (m + 1) → ℂ) → (Fin (m + 1) → ℂ) →L[ℝ] A}
    {ω₂' : (Fin (m + 1) → ℂ) → (Fin (m + 1) → ℂ) →L[ℝ] (Fin (m + 1) → ℂ) →L[ℝ] A}
    (h₂ : IsFlatOn ω₂ ω₂' (confSet (m + 1)))
    (hω₂ : ∀ (π : Equiv.Perm (Fin (m + 1))) (z u : Fin (m + 1) → ℂ),
      ω₂ (z ∘ π) (u ∘ π) = ρ₂ π⁻¹ * ω₂ z u * ρ₂ π)
    (U₂ : Fin m → ℝ → A) (hU₂ : ∀ j, IsTransport ω₂ (genPath j) (genPath' j) (U₂ j))
    (hgen : ∀ q : FundamentalGroupoid.mk (basePt₁ m) ⟶ FundamentalGroupoid.mk (basePt₁ m),
      q ∈ (Subgroupoid.generated (halfTurnArrows m)).arrows _ _)
    (c₀ : Aˣ) (hc : ∀ j, (c₀ : A) * (kzBraidRep ρ κ c (σ j) : A) = ρ₂ (adjSwap j) * U₂ j 1 * c₀) :
    ∃ g : (Fin (m + 1) → ℂ) → A, g (basePt 1) = c₀ ∧
      (∀ z ∈ confSet (m + 1), IsUnit (g z)) ∧ ∀ y ∈ confSet (m + 1),
        HasFDerivAt g ((ContinuousLinearMap.mul ℝ A).flip (g y) ∘L ω₂ y -
          (ContinuousLinearMap.mul ℝ A (g y)) ∘L kzForm ρ κ c y) y := by
  have hD := isOpen_confSet (m + 1)
  have h₁ := kzForm_isFlatOn ρ κ c (n := m + 1)
  set G := baseGauge ρ ρ₂ c₀
  have hconj : LocalCocycle.ConjMonodromy (flatCocycle hD h₁) (flatCocycle hD h₂) (basePt₁ m)
      (G (basePt₁ m)) := by
    refine LocalCocycle.conjMonodromy_of_generated (basePt₁ m) (halfTurnArrows m) ?_ hgen
    rintro x y _ ⟨j, π, γ, hγ, rfl⟩
    rw [LocalCocycle.transportQ_mk, LocalCocycle.transportQ_mk]
    have hd : ∀ t ∈ Icc (0:ℝ) 1, HasDerivWithinAt (fun s => genPath j s ∘ π)
        (genPath' j t ∘ π) (Icc 0 1) t := fun t _ =>
      (hasDerivAt_genPath_comp j π t).hasDerivWithinAt
    have hdc := (continuous_genPath'_comp j π).continuousOn (s := Icc (0:ℝ) 1)
    have e₁ := transport_flatCocycle_eq hD h₁ hd hdc ((genFund_spec ρ κ c j).comp_perm π) γ hγ
    have e₂ := transport_flatCocycle_eq hD h₂ hd hdc ((hU₂ j).comp_perm_of hω₂ π) γ hγ
    have hx : (x.as : Fin (m + 1) → ℂ) = basePt π := by
      rw [← γ.source, hγ 0]
      simp [genPath_zero, basePt_comp]
    have hy : (y.as : Fin (m + 1) → ℂ) = basePt (adjSwap j * π) := by
      rw [← γ.target, hγ 1]
      simp [genPath_one, basePt_comp, adjSwap]
    apply op_conj_of
    rw [e₁, e₂, baseGauge_val ρ ρ₂ c₀ hx, baseGauge_val ρ ρ₂ c₀ hy]
    have hcj := hc j
    rw [kzBraidRep_σ] at hcj
    have h1 : ∀ x : A, ρ π * (ρ π⁻¹ * x) = x := fun x => by
      rw [← mul_assoc, ← map_mul, mul_inv_cancel, map_one, one_mul]
    have h2 : ∀ x : A, ρ₂ π * (ρ₂ π⁻¹ * x) = x := fun x => by
      rw [← mul_assoc, ← map_mul, mul_inv_cancel, map_one, one_mul]
    have h3 : ∀ x : A, ρ₂ (adjSwap j)⁻¹ * (ρ₂ (adjSwap j) * x) = x := fun x => by
      rw [← mul_assoc, ← map_mul, inv_mul_cancel, map_one, one_mul]
    have hc' : ∀ x : A, (c₀ : A) * (ρ (adjSwap j) * (genFund ρ κ c j 1 * x)) =
        ρ₂ (adjSwap j) * (U₂ j 1 * (c₀ * x)) := fun x => by
      have := congrArg (· * x) hcj
      simpa only [mul_assoc] using this
    simp only [mul_inv_rev, map_mul, mul_assoc, h1, h2, h3, hc']
  refine ⟨flatGauge hD h₁ h₂ (basePt₁ m) (G (basePt₁ m)), ?_, fun z hz => isUnit_flatGauge hz,
    fun y hy => hasFDerivAt_flatGauge hconj ⟨y, hy⟩⟩
  change flatGauge hD h₁ h₂ (basePt₁ m) (G (basePt₁ m)) (basePt₁ m : Fin (m + 1) → ℂ) = _
  rw [flatGauge_of_mem (basePt₁ m).2, LocalCocycle.gauge_eq_along hconj (Path.refl _)]
  simp only [LocalCocycle.gaugeAlong, LocalCocycle.transport_refl, inv_one, one_mul, mul_one]
  rw [baseGauge_val ρ ρ₂ c₀ (π := 1) rfl]
  simp

end QOU.Mass.KZHolonomy
