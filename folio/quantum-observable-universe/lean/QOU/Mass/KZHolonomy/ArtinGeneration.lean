import QOU.Mass.KZHolonomy.ConfRegions
import QOU.Mass.KZHolonomy.ConfGeneric

/-!
# The permuted half-turns generate the fundamental groupoid of `Conf_{m+1}(ℂ)`

For `m ≥ 1`, every loop at the base configuration `p₁ = (0, 1, …, m)` lies in the subgroupoid
generated by the permuted half-turns `γ_j ∘ π` (`artin_generation`).  This is the generation half
of Artin's presentation of the braid group, read on the ordered configuration space.  It
discharges the hypothesis `hgen` of `kz_gauge_of_braid_conj` (`kz_gauge_of_braid_conj'`).

**Proof.**  Write `S` for the generated subgroupoid.

1. *Anchors.*  Every configuration `z` has a lexicographic order `σ_z`.  The segment from the
   base configuration `p_{σ_z⁻¹}` to `z` has strictly sorted real parts except at its end, so it
   lies in `Conf`, and it lies in every region `region τ j` that contains `z`
   (`anchorPath_mem_region`).
2. *Region-local paths.*  A path inside `region τ j` between the two base configurations
   `p_{τ⁻¹}`, `p_{(τ s_j)⁻¹}` is homotopic, in the simply connected region, to the half-turn,
   its inverse or a constant path, so its class is in `S` (`region_path_mem`).
3. *Generic paths.*  A configuration with at most one pair of equal real parts lies in some region
   (`generic_mem_some_region`).  Conjugating by the anchors and applying the Lebesgue lemma for
   subgroupoids over the cover by regions, every path through such configurations, closed up by
   anchors, lies in `S` (`generic_path_mem`).
4. *All paths.*  Near each configuration `x` choose a generic `x̂`.  A path inside a small ball
   around `c` is, after conjugation by the segments `x̂ → x`, homotopic in a convex ball to a
   two-segment path through generic configurations (`exists_generic_segments`).  The Lebesgue
   lemma over the cover by small balls finishes the proof.

No fibration of configuration spaces is used.
-/

set_option autoImplicit false
set_option linter.unusedSectionVars false

namespace QOU.Mass.KZHolonomy

open Set CategoryTheory QOU.MathlibExt QOU.MathlibExt.Braid Metric

variable {m : ℕ}

/-! ### Paths: composition, inverses, points -/

lemma pathHom_comp {Y : Type*} [TopologicalSpace Y] {a b c : Y} (p : Path a b) (q : Path b c) :
    pathHom p ≫ pathHom q = pathHom (p.trans q) := rfl

lemma pathHom_inv {Y : Type*} [TopologicalSpace Y] {a b : Y} (p : Path a b) :
    Groupoid.inv (pathHom p) = pathHom p.symm := rfl

lemma pathHom_eq {Y : Type*} [TopologicalSpace Y] {a b : Y} {p q : Path a b}
    (h : p.Homotopic q) : pathHom p = pathHom q := Quotient.sound h

lemma path_trans_mem {Y : Type*} [TopologicalSpace Y] {s : Set Y} {a b c : Y} {p : Path a b}
    {q : Path b c} (hp : ∀ t, p t ∈ s) (hq : ∀ t, q t ∈ s) (t : unitInterval) :
    (p.trans q) t ∈ s := by
  have : (p.trans q) t ∈ range (p.trans q) := mem_range_self t
  rw [Path.trans_range] at this
  rcases this with ⟨u, hu⟩ | ⟨u, hu⟩
  · rw [← hu]; exact hp u
  · rw [← hu]; exact hq u

lemma path_symm_mem {Y : Type*} [TopologicalSpace Y] {s : Set Y} {a b : Y} {p : Path a b}
    (hp : ∀ t, p t ∈ s) (t : unitInterval) : p.symm t ∈ s := by
  rw [Path.symm_apply]; exact hp _

/-! ### Segments -/

/-- The straight segment from `a` to `b`. -/
noncomputable def segMap (a b : Fin (m + 1) → ℂ) (t : ℝ) : Fin (m + 1) → ℂ := (1 - t) • a + t • b

lemma continuous_segMap (a b : Fin (m + 1) → ℂ) : Continuous (segMap a b) := by
  unfold segMap; fun_prop

lemma segMap_zero (a b : Fin (m + 1) → ℂ) : segMap a b 0 = a := by simp [segMap]

lemma segMap_one (a b : Fin (m + 1) → ℂ) : segMap a b 1 = b := by simp [segMap]

lemma segMap_self (a : Fin (m + 1) → ℂ) (t : ℝ) : segMap a a t = a := by
  simp only [segMap, ← add_smul, sub_add_cancel, one_smul]

lemma segMap_mem_ball {c a b : Fin (m + 1) → ℂ} {r : ℝ} (ha : a ∈ ball c r) (hb : b ∈ ball c r)
    {t : ℝ} (ht : t ∈ Icc (0 : ℝ) 1) : segMap a b t ∈ ball c r :=
  convex_ball c r ha hb (sub_nonneg.2 ht.2) ht.1 (by ring)

/-- A segment of `Conf` as a path. -/
noncomputable def segPathOf {a b : confSet (m + 1)}
    (h : ∀ t ∈ Icc (0 : ℝ) 1, segMap (a : Fin (m + 1) → ℂ) b t ∈ confSet (m + 1)) : Path a b :=
  pathOfMap (segMap (a : Fin (m + 1) → ℂ) b) (continuous_segMap _ _).continuousOn h
    (segMap_zero _ _) (segMap_one _ _)

lemma segPathOf_apply {a b : confSet (m + 1)}
    (h : ∀ t ∈ Icc (0 : ℝ) 1, segMap (a : Fin (m + 1) → ℂ) b t ∈ confSet (m + 1))
    (t : unitInterval) : (segPathOf h t : Fin (m + 1) → ℂ) = segMap a b t := rfl

/-! ### Sorted configurations -/

lemma LexSorted.re_le {z : Fin (m + 1) → ℂ} {σ : Equiv.Perm (Fin (m + 1))} (h : LexSorted z σ)
    {k l : Fin (m + 1)} (hkl : k ≤ l) : (z (σ k)).re ≤ (z (σ l)).re := by
  rcases hkl.lt_or_eq with h' | rfl
  · rcases (lexKey_lt_iff _ _ _).1 (h h') with h1 | h1
    · exact h1.le
    · exact h1.1.le
  · exact le_rfl

lemma ReSorted.mem_conf {z : Fin (m + 1) → ℂ} {σ : Equiv.Perm (Fin (m + 1))}
    (h : ReSorted z σ) : z ∈ confSet (m + 1) := by
  intro a b hab
  by_contra hne
  have hne' : σ.symm a ≠ σ.symm b := fun e => hne (σ.symm.injective e)
  rcases lt_or_gt_of_ne hne' with h1 | h1
  · have := h h1
    simp only [Equiv.apply_symm_apply] at this
    rw [hab] at this; exact lt_irrefl _ this
  · have := h h1
    simp only [Equiv.apply_symm_apply] at this
    rw [hab] at this; exact lt_irrefl _ this

lemma ReSorted.generic {z : Fin (m + 1) → ℂ} {σ : Equiv.Perm (Fin (m + 1))}
    (h : ReSorted z σ) : Generic z := by
  intro q hq
  obtain ⟨h1, -⟩ := hq
  obtain ⟨hab, -⟩ := q.2
  set a := q.1.1
  set b := q.1.2.1
  simp only [tieL_apply] at h1
  have e : (z (σ (σ.symm a))).re = (z (σ (σ.symm b))).re := by
    simp only [Equiv.apply_symm_apply]; linarith
  exact hab (σ.symm.injective (h.injective e))

lemma reSorted_seg {z : Fin (m + 1) → ℂ} {σ : Equiv.Perm (Fin (m + 1))} (h : LexSorted z σ)
    {t : ℝ} (ht0 : 0 ≤ t) (ht1 : t < 1) : ReSorted (segMap (basePt σ⁻¹) z t) σ := by
  intro k l hkl
  have hb := reSorted_basePt σ hkl
  have hz := h.re_le hkl.le
  simp only [segMap, Pi.add_apply, Pi.smul_apply, Complex.add_re, Complex.smul_re,
    smul_eq_mul] at hb ⊢
  nlinarith [mul_lt_mul_of_pos_left hb (sub_pos.2 ht1), mul_le_mul_of_nonneg_left hz ht0]

lemma basePt_mem_conf (π : Equiv.Perm (Fin (m + 1))) : basePt π ∈ confSet (m + 1) :=
  kzRegion_subset_injective _ (basePt_mem π)

/-- The base configuration `p_π` as a point of `Conf`. -/
def bp (π : Equiv.Perm (Fin (m + 1))) : confSet (m + 1) := ⟨basePt π, basePt_mem_conf π⟩

lemma mul_swap_swap (τ : Equiv.Perm (Fin (m + 1))) (j : Fin m) :
    τ * Equiv.swap j.castSucc j.succ * Equiv.swap j.castSucc j.succ = τ := by
  rw [mul_assoc, Equiv.swap_mul_self, mul_one]

lemma basePt_inv_mem_region (τ : Equiv.Perm (Fin (m + 1))) (j : Fin m) :
    basePt τ⁻¹ ∈ region τ j := (mem_region_of_reSorted (reSorted_basePt τ) j).1

lemma basePt_swap_inv_mem_region (τ : Equiv.Perm (Fin (m + 1))) (j : Fin m) :
    basePt (τ * Equiv.swap j.castSucc j.succ)⁻¹ ∈ region τ j := by
  have := (mem_region_of_reSorted (reSorted_basePt (τ * Equiv.swap j.castSucc j.succ)) j).2
  rwa [mul_swap_swap] at this

/-! ### Anchors -/

/-- The lexicographic order of a configuration. -/
noncomputable def lexPerm (z : confSet (m + 1)) : Equiv.Perm (Fin (m + 1)) :=
  (exists_lexSorted z.2).choose

lemma lexPerm_spec (z : confSet (m + 1)) : LexSorted (z : Fin (m + 1) → ℂ) (lexPerm z) :=
  (exists_lexSorted z.2).choose_spec

/-- The base configuration attached to `z`: `p_{σ_z⁻¹}`. -/
noncomputable def baseOf (z : confSet (m + 1)) : confSet (m + 1) := bp (lexPerm z)⁻¹

lemma anchor_seg_mem (z : confSet (m + 1)) :
    ∀ t ∈ Icc (0 : ℝ) 1, segMap ((baseOf z : confSet (m + 1)) : Fin (m + 1) → ℂ) z t ∈
      confSet (m + 1) := by
  intro t ht
  rcases ht.2.lt_or_eq with h1 | h1
  · exact (reSorted_seg (lexPerm_spec z) ht.1 h1).mem_conf
  · rw [h1, segMap_one]; exact z.2

/-- The anchor of `z`: the segment from `p_{σ_z⁻¹}` to `z`. -/
noncomputable def anchorPath (z : confSet (m + 1)) : Path (baseOf z) z :=
  segPathOf (anchor_seg_mem z)

lemma lexPerm_of_mem_region {τ : Equiv.Perm (Fin (m + 1))} {j : Fin m} (z : confSet (m + 1))
    (hz : (z : Fin (m + 1) → ℂ) ∈ region τ j) :
    lexPerm z = τ ∨ lexPerm z = τ * Equiv.swap j.castSucc j.succ := by
  rcases lexSorted_of_mem_region hz with h | h
  · exact Or.inl (lexSorted_unique (lexPerm_spec z) h.2)
  · exact Or.inr (lexSorted_unique (lexPerm_spec z) h.2)

theorem anchorPath_mem_region {τ : Equiv.Perm (Fin (m + 1))} {j : Fin m} (z : confSet (m + 1))
    (hz : (z : Fin (m + 1) → ℂ) ∈ region τ j) (t : unitInterval) :
    (anchorPath z t : Fin (m + 1) → ℂ) ∈ region τ j := by
  show segMap (basePt (lexPerm z)⁻¹) (z : Fin (m + 1) → ℂ) t ∈ region τ j
  rcases (t.2.2 : (t : ℝ) ≤ 1).lt_or_eq with ht | ht
  · obtain ⟨h1, h2⟩ := mem_region_of_reSorted (reSorted_seg (lexPerm_spec z) t.2.1 ht) j
    rcases lexPerm_of_mem_region z hz with e | e
    · rw [e] at h1 ⊢; exact h1
    · rw [e] at h2 ⊢; rwa [mul_swap_swap] at h2
  · rw [ht, segMap_one]; exact hz

/-! ### Region-local paths -/

/-- The permuted half-turn `γ_j ∘ τ⁻¹`, from `p_{τ⁻¹}` to `p_{(τ s_j)⁻¹}`. -/
noncomputable def halfTurn (τ : Equiv.Perm (Fin (m + 1))) (j : Fin m) :
    Path (bp τ⁻¹) (bp (τ * Equiv.swap j.castSucc j.succ)⁻¹) :=
  pathOfMap (fun t => genPath j t ∘ ⇑τ⁻¹)
    (fun t _ => (hasDerivAt_genPath_comp j τ⁻¹ t).continuousAt.continuousWithinAt)
    (fun _ ht => region_subset_conf τ j (genPath_comp_mem_region τ j ht))
    (by show genPath j 0 ∘ ⇑τ⁻¹ = basePt τ⁻¹; rw [genPath_zero, basePt_comp, one_mul])
    (by
      show genPath j 1 ∘ ⇑τ⁻¹ = basePt (τ * Equiv.swap j.castSucc j.succ)⁻¹
      rw [genPath_one, basePt_comp, mul_inv_rev, Equiv.swap_inv])

lemma halfTurn_mem_region (τ : Equiv.Perm (Fin (m + 1))) (j : Fin m) (t : unitInterval) :
    (halfTurn τ j t : Fin (m + 1) → ℂ) ∈ region τ j :=
  genPath_comp_mem_region τ j t.2

/-- The subgroupoid generated by the permuted half-turns. -/
abbrev halfTurnGen (m : ℕ) : Subgroupoid (FundamentalGroupoid (confSet (m + 1))) :=
  Subgroupoid.generated (halfTurnArrows m)

lemma halfTurn_mem (τ : Equiv.Perm (Fin (m + 1))) (j : Fin m) :
    pathHom (halfTurn τ j) ∈ (halfTurnGen m).arrows _ _ :=
  Subgroupoid.subset_generated _ _ _ ⟨j, τ⁻¹, halfTurn τ j, fun _ => rfl, rfl⟩

/-- A path in `region τ j` between the base configurations `p_{τ⁻¹}`, `p_{(τ s_j)⁻¹}` has its
class in the subgroupoid generated by the half-turns. -/
theorem region_path_mem {τ : Equiv.Perm (Fin (m + 1))} {j : Fin m} {a b : confSet (m + 1)}
    (r : Path a b) (hr : ∀ t, (r t : Fin (m + 1) → ℂ) ∈ region τ j)
    (ha : a = bp τ⁻¹ ∨ a = bp (τ * Equiv.swap j.castSucc j.succ)⁻¹)
    (hb : b = bp τ⁻¹ ∨ b = bp (τ * Equiv.swap j.castSucc j.succ)⁻¹) :
    pathHom r ∈ (halfTurnGen m).arrows _ _ := by
  have hH := halfTurn_mem τ j
  have hR := region_subset_conf τ j
  have h0 : ((bp τ⁻¹ : confSet (m + 1)) : Fin (m + 1) → ℂ) ∈ region τ j :=
    basePt_inv_mem_region τ j
  have h1 : ((bp (τ * Equiv.swap j.castSucc j.succ)⁻¹ : confSet (m + 1)) :
      Fin (m + 1) → ℂ) ∈ region τ j := basePt_swap_inv_mem_region τ j
  rcases ha with rfl | rfl <;> rcases hb with rfl | rfl
  · rw [pathHom_eq (homotopic_of_mem hR r (Path.refl _) hr fun _ => h0)]
    exact (halfTurnGen m).id_mem_of_src hH
  · rw [pathHom_eq (homotopic_of_mem hR r (halfTurn τ j) hr (halfTurn_mem_region τ j))]
    exact hH
  · rw [pathHom_eq (homotopic_of_mem hR r (halfTurn τ j).symm hr
      (path_symm_mem (s := Subtype.val ⁻¹' region τ j) (halfTurn_mem_region τ j))),
      ← pathHom_inv]
    exact (halfTurnGen m).inv hH
  · rw [pathHom_eq (homotopic_of_mem hR r (Path.refl _) hr fun _ => h1)]
    exact (halfTurnGen m).id_mem_of_tgt hH

/-! ### Generic paths -/

/-- A configuration with at most one pair of equal real parts lies in some region. -/
theorem generic_mem_some_region (hm : 0 < m) {z : Fin (m + 1) → ℂ} (hz : z ∈ confSet (m + 1))
    (hg : Generic z) : ∃ i : Equiv.Perm (Fin (m + 1)) × Fin m, z ∈ region i.1 i.2 := by
  obtain ⟨σ, hσ⟩ := exists_lexSorted hz
  by_cases ht : ∃ j : Fin m, (z (σ j.castSucc)).re = (z (σ j.succ)).re
  · obtain ⟨j, hj⟩ := ht
    refine ⟨(σ, j), fun k l hkl hns => ?_, fun hs => ?_⟩
    · rcases (hσ.re_le hkl.le).lt_or_eq with h | h
      · exact h
      exfalso
      refine hg ⟨(σ k, σ l, σ j.castSucc, σ j.succ), σ.injective.ne hkl.ne,
        σ.injective.ne (Fin.castSucc_lt_succ j).ne, ?_⟩ ⟨?_, ?_⟩
      · rintro (⟨e1, e2⟩ | ⟨e1, e2⟩)
        · exact hns ⟨σ.injective e1, σ.injective e2⟩
        · have e1' := σ.injective e1
          have e2' := σ.injective e2
          rw [e1', e2'] at hkl
          exact absurd hkl (not_lt.2 (Fin.castSucc_lt_succ j).le)
      · simp only [tieL_apply, h, sub_self]
      · simp only [tieL_apply, hj, sub_self]
    · have hlt := hσ (Fin.castSucc_lt_succ j)
      simp only [Function.comp_apply] at hlt
      rw [lexKey_lt_iff] at hlt
      rcases hlt with h | h
      · linarith
      · have := hs.2
        rw [Complex.sub_im] at this
        linarith [h.2]
  · push_neg at ht
    have hre : ReSorted z σ := Fin.strictMono_iff_lt_succ.2 fun j =>
      lt_of_le_of_ne (hσ.re_le (Fin.castSucc_lt_succ j).le) (ht j)
    exact ⟨(σ, ⟨0, hm⟩), (mem_region_of_reSorted hre _).1⟩

/-- Every path through configurations in general position, closed up by the anchors of its ends,
has its class in the subgroupoid generated by the half-turns. -/
theorem generic_path_mem (hm : 0 < m) {a b : confSet (m + 1)} (P : Path a b)
    (hP : ∀ t, Generic (P t : Fin (m + 1) → ℂ)) :
    pathHom (anchorPath a) ≫ pathHom P ≫ Groupoid.inv (pathHom (anchorPath b)) ∈
      (halfTurnGen m).arrows (FundamentalGroupoid.mk (baseOf a))
        (FundamentalGroupoid.mk (baseOf b)) := by
  have key := Subgroupoid.mem_of_locally
    (QOU.MathlibExt.Subgroupoid.conjAnchor (halfTurnGen m) (fun x => FundamentalGroupoid.mk (baseOf x.as))
      (fun x => pathHom (anchorPath x.as)))
    (fun i : Equiv.Perm (Fin (m + 1)) × Fin m =>
      (Subtype.val ⁻¹' region i.1 i.2 : Set (confSet (m + 1))))
    (fun i => (isOpen_region i.1 i.2).preimage continuous_subtype_val)
    (by
      intro i x y p hp
      show pathHom (anchorPath x) ≫ pathHom p ≫ Groupoid.inv (pathHom (anchorPath y)) ∈
        (halfTurnGen m).arrows _ _
      have hx : (x : Fin (m + 1) → ℂ) ∈ region i.1 i.2 := by
        have := hp 0; rwa [p.source] at this
      have hy : (y : Fin (m + 1) → ℂ) ∈ region i.1 i.2 := by
        have := hp 1; rwa [p.target] at this
      rw [pathHom_inv, pathHom_comp, pathHom_comp]
      refine region_path_mem _ (path_trans_mem (s := Subtype.val ⁻¹' region i.1 i.2)
        (anchorPath_mem_region x hx) (path_trans_mem hp
          (path_symm_mem (s := Subtype.val ⁻¹' region i.1 i.2)
            (anchorPath_mem_region y hy)))) ?_ ?_
      · rcases lexPerm_of_mem_region x hx with e | e
        · exact Or.inl (by rw [baseOf, e])
        · exact Or.inr (by rw [baseOf, e])
      · rcases lexPerm_of_mem_region y hy with e | e
        · exact Or.inl (by rw [baseOf, e])
        · exact Or.inr (by rw [baseOf, e]))
    P (fun t => generic_mem_some_region hm (P t).2 (hP t))
  exact key

/-! ### All paths -/

/-- The distance to the complement of `Conf`. -/
noncomputable def dC (x : Fin (m + 1) → ℂ) : ℝ := infDist x (confSet (m + 1))ᶜ

lemma conf_compl_nonempty (hm : 0 < m) : (confSet (m + 1))ᶜ.Nonempty :=
  ⟨fun _ => 0, fun h => by
    have := @h ⟨0, by omega⟩ ⟨1, by omega⟩ rfl
    simp [Fin.ext_iff] at this⟩

lemma dC_pos (hm : 0 < m) {x : Fin (m + 1) → ℂ} (hx : x ∈ confSet (m + 1)) : 0 < dC x :=
  ((isOpen_confSet (m + 1)).isClosed_compl.notMem_iff_infDist_pos
    (conf_compl_nonempty hm)).1 fun h => h hx

lemma ball_dC_subset (x : Fin (m + 1) → ℂ) : ball x (dC x) ⊆ confSet (m + 1) :=
  ball_infDist_compl_subset

lemma dC_quarter_pos (hm : 0 < m) (x : confSet (m + 1)) : 0 < dC (x : Fin (m + 1) → ℂ) / 4 := by
  have := dC_pos hm x.2; positivity

/-- A configuration in general position near `x` (equal to `x` if `x` is in general position). -/
noncomputable def hatPt (hm : 0 < m) (x : confSet (m + 1)) : Fin (m + 1) → ℂ := by
  classical
  exact if Generic (x : Fin (m + 1) → ℂ) then x else
    (exists_generic_mem_ball (x : Fin (m + 1) → ℂ) (dC_quarter_pos hm x)).choose

lemma hatPt_spec (hm : 0 < m) (x : confSet (m + 1)) :
    hatPt hm x ∈ ball (x : Fin (m + 1) → ℂ) (dC (x : Fin (m + 1) → ℂ) / 4) ∧
      Generic (hatPt hm x) := by
  unfold hatPt
  split_ifs with h
  · exact ⟨mem_ball_self (dC_quarter_pos hm x), h⟩
  · exact (exists_generic_mem_ball (x : Fin (m + 1) → ℂ) (dC_quarter_pos hm x)).choose_spec

lemma hatPt_of_generic (hm : 0 < m) {x : confSet (m + 1)} (h : Generic (x : Fin (m + 1) → ℂ)) :
    hatPt hm x = x := by
  unfold hatPt
  split_ifs
  rfl

lemma hatPt_mem_ball (hm : 0 < m) (x : confSet (m + 1)) :
    hatPt hm x ∈ ball (x : Fin (m + 1) → ℂ) (dC (x : Fin (m + 1) → ℂ)) :=
  ball_subset_ball (by have := dC_pos hm x.2; linarith) (hatPt_spec hm x).1

/-- `hatPt` as a point of `Conf`. -/
noncomputable def hatC (hm : 0 < m) (x : confSet (m + 1)) : confSet (m + 1) :=
  ⟨hatPt hm x, ball_dC_subset _ (hatPt_mem_ball hm x)⟩

/-- The segment from `x̂` to `x`. -/
noncomputable def hatSeg (hm : 0 < m) (x : confSet (m + 1)) : Path (hatC hm x) x :=
  segPathOf fun _ ht => ball_dC_subset _
    (segMap_mem_ball (hatPt_mem_ball hm x) (mem_ball_self (dC_pos hm x.2)) ht)

/-- The anchor of an arbitrary configuration: the anchor of `x̂`, then the segment to `x`. -/
noncomputable def anchor2 (hm : 0 < m) (x : confSet (m + 1)) :
    FundamentalGroupoid.mk (baseOf (hatC hm x)) ⟶ FundamentalGroupoid.mk x :=
  pathHom (anchorPath (hatC hm x)) ≫ pathHom (hatSeg hm x)

lemma anchor2_basePt₁_mem (hm : 0 < m) :
    anchor2 hm (basePt₁ m) ∈ (halfTurnGen m).arrows _ _ := by
  have hg : Generic ((basePt₁ m : confSet (m + 1)) : Fin (m + 1) → ℂ) := by
    have := reSorted_basePt (1 : Equiv.Perm (Fin (m + 1)))
    rw [inv_one] at this
    exact this.generic
  have hh : (hatC hm (basePt₁ m) : Fin (m + 1) → ℂ) = basePt 1 := hatPt_of_generic hm hg
  have hl : lexPerm (hatC hm (basePt₁ m)) = 1 := by
    have h1 := (reSorted_basePt (1 : Equiv.Perm (Fin (m + 1)))).lexSorted
    rw [inv_one, ← hh] at h1
    exact lexSorted_unique (lexPerm_spec _) h1
  have hmem : basePt (1 : Equiv.Perm (Fin (m + 1))) ∈ region 1 (⟨0, hm⟩ : Fin m) := by
    have := basePt_inv_mem_region (1 : Equiv.Perm (Fin (m + 1))) ⟨0, hm⟩
    rwa [inv_one] at this
  unfold anchor2
  rw [pathHom_comp]
  refine region_path_mem (τ := 1) (j := ⟨0, hm⟩) _ (path_trans_mem
    (s := Subtype.val ⁻¹' region 1 (⟨0, hm⟩ : Fin m)) (fun t => ?_) (fun t => ?_)) ?_ ?_
  · show segMap (basePt (lexPerm (hatC hm (basePt₁ m)))⁻¹)
      ((hatC hm (basePt₁ m) : confSet (m + 1)) : Fin (m + 1) → ℂ) t ∈
      region 1 (⟨0, hm⟩ : Fin m)
    rw [hl, hh, inv_one, segMap_self]; exact hmem
  · show segMap ((hatC hm (basePt₁ m) : confSet (m + 1)) : Fin (m + 1) → ℂ)
      ((basePt₁ m : confSet (m + 1)) : Fin (m + 1) → ℂ) t ∈
      region 1 (⟨0, hm⟩ : Fin m)
    rw [hh]; show segMap (basePt 1) (basePt 1) t ∈ region 1 (⟨0, hm⟩ : Fin m)
    rw [segMap_self]; exact hmem
  · left; apply Subtype.ext
    show basePt (lexPerm (hatC hm (basePt₁ m)))⁻¹ = basePt (1 : Equiv.Perm (Fin (m + 1)))⁻¹
    rw [hl]
  · left; apply Subtype.ext
    show basePt 1 = basePt (1 : Equiv.Perm (Fin (m + 1)))⁻¹
    rw [inv_one]

/-- **Generation half of Artin's presentation.**  For `m ≥ 1`, every loop at the base
configuration `p₁` lies in the subgroupoid generated by the permuted half-turns. -/
theorem artin_generation (hm : 0 < m)
    (q : FundamentalGroupoid.mk (basePt₁ m) ⟶ FundamentalGroupoid.mk (basePt₁ m)) :
    q ∈ (Subgroupoid.generated (halfTurnArrows m)).arrows _ _ := by
  refine Quotient.inductionOn q fun γ => ?_
  have key := Subgroupoid.mem_of_locally
    (QOU.MathlibExt.Subgroupoid.conjAnchor (halfTurnGen m) (fun x => FundamentalGroupoid.mk (baseOf (hatC hm x.as)))
      (fun x => anchor2 hm x.as))
    (fun c : confSet (m + 1) => (Subtype.val ⁻¹' ball (c : Fin (m + 1) → ℂ)
      (dC (c : Fin (m + 1) → ℂ) / 4) : Set (confSet (m + 1))))
    (fun c => isOpen_ball.preimage continuous_subtype_val)
    (by
      intro c x y p hp
      show anchor2 hm x ≫ pathHom p ≫ Groupoid.inv (anchor2 hm y) ∈
        (halfTurnGen m).arrows _ _
      set B := ball (c : Fin (m + 1) → ℂ) (dC (c : Fin (m + 1) → ℂ)) with hBdef
      have hc := dC_pos hm c.2
      have hB : B ⊆ confSet (m + 1) := ball_dC_subset _
      haveI : ContractibleSpace B :=
        (convex_ball _ _).contractibleSpace (nonempty_ball.2 hc)
      have hq : ∀ z : confSet (m + 1), (z : Fin (m + 1) → ℂ) ∈
          ball (c : Fin (m + 1) → ℂ) (dC (c : Fin (m + 1) → ℂ) / 4) →
          (z : Fin (m + 1) → ℂ) ∈ B ∧ hatPt hm z ∈ B := by
        intro z hz
        rw [mem_ball] at hz
        have h1 := (hatPt_spec hm z).1
        rw [mem_ball] at h1
        have h2 : dC (z : Fin (m + 1) → ℂ) ≤ dC (c : Fin (m + 1) → ℂ) +
            dist (z : Fin (m + 1) → ℂ) c := infDist_le_infDist_add_dist
        have h3 := dist_triangle (hatPt hm z) (z : Fin (m + 1) → ℂ) c
        refine ⟨mem_ball.2 (by linarith), mem_ball.2 (by linarith)⟩
      have hx0 : (x : Fin (m + 1) → ℂ) ∈
          ball (c : Fin (m + 1) → ℂ) (dC (c : Fin (m + 1) → ℂ) / 4) := by
        have := hp 0; rwa [p.source] at this
      have hy0 : (y : Fin (m + 1) → ℂ) ∈
          ball (c : Fin (m + 1) → ℂ) (dC (c : Fin (m + 1) → ℂ) / 4) := by
        have := hp 1; rwa [p.target] at this
      obtain ⟨hxB, hx'B⟩ := hq x hx0
      obtain ⟨hyB, hy'B⟩ := hq y hy0
      obtain ⟨p0, hp0, hs1, hs2⟩ := exists_generic_segments (hatPt_spec hm x).2
        (hatPt_spec hm y).2 (isOpen_ball (x := (c : Fin (m + 1) → ℂ))
          (ε := dC (c : Fin (m + 1) → ℂ))) ⟨_, mem_ball_self hc⟩
      let pc : confSet (m + 1) := ⟨p0, hB hp0⟩
      let P1 : Path (hatC hm x) pc :=
        segPathOf fun _ ht => hB (segMap_mem_ball hx'B hp0 ht)
      let P2 : Path pc (hatC hm y) :=
        segPathOf fun _ ht => hB (segMap_mem_ball hp0 hy'B ht)
      have hG := generic_path_mem hm (P1.trans P2)
        (path_trans_mem (s := {z : confSet (m + 1) | Generic (z : Fin (m + 1) → ℂ)})
          (fun t => hs1 t t.2) (fun t => hs2 t t.2))
      have hhom : ((hatSeg hm x).trans (p.trans (hatSeg hm y).symm)).Homotopic
          (P1.trans P2) := by
        refine homotopic_of_mem hB _ _ ?_ ?_
        · refine path_trans_mem (s := Subtype.val ⁻¹' B)
            (fun t => segMap_mem_ball hx'B hxB t.2) (path_trans_mem (s := Subtype.val ⁻¹' B)
              (fun t => ball_subset_ball (by linarith) (hp t))
              (path_symm_mem (s := Subtype.val ⁻¹' B)
                fun t => segMap_mem_ball hy'B hyB t.2))
        · exact path_trans_mem (s := Subtype.val ⁻¹' B)
            (fun t => segMap_mem_ball hx'B hp0 t.2) (fun t => segMap_mem_ball hp0 hy'B t.2)
      have e : anchor2 hm x ≫ pathHom p ≫ Groupoid.inv (anchor2 hm y) =
          pathHom (anchorPath (hatC hm x)) ≫ pathHom (P1.trans P2) ≫
            Groupoid.inv (pathHom (anchorPath (hatC hm y))) := by
        rw [← pathHom_eq hhom, ← pathHom_comp, ← pathHom_comp, ← pathHom_inv]
        unfold anchor2
        simp only [Groupoid.inv_eq_inv, IsIso.inv_comp, Category.assoc]
      rw [e]
      exact hG)
    γ (fun t => ⟨γ t, mem_ball_self (dC_quarter_pos hm (γ t))⟩)
  have hα := anchor2_basePt₁_mem hm
  have h1 := ((halfTurnGen m).mul_mem_cancel_left hα).1 key
  exact ((halfTurnGen m).mul_mem_cancel_right ((halfTurnGen m).inv hα)).1 h1

/-- **Smooth gauge to KZ from conjugacy of the braid generators**, with Artin's generation
proved (`m ≥ 1`). -/
theorem kz_gauge_of_braid_conj' {A : Type*} [NormedRing A] [NormedAlgebra ℂ A] [CompleteSpace A]
    (hm : 0 < m) (ρ : Equiv.Perm (Fin (m + 1)) →* A) (κ c : ℂ)
    (ρ₂ : Equiv.Perm (Fin (m + 1)) →* A)
    {ω₂ : (Fin (m + 1) → ℂ) → (Fin (m + 1) → ℂ) →L[ℝ] A}
    {ω₂' : (Fin (m + 1) → ℂ) → (Fin (m + 1) → ℂ) →L[ℝ] (Fin (m + 1) → ℂ) →L[ℝ] A}
    (h₂ : IsFlatOn ω₂ ω₂' (confSet (m + 1)))
    (hω₂ : ∀ (π : Equiv.Perm (Fin (m + 1))) (z u : Fin (m + 1) → ℂ),
      ω₂ (z ∘ π) (u ∘ π) = ρ₂ π⁻¹ * ω₂ z u * ρ₂ π)
    (U₂ : Fin m → ℝ → A) (hU₂ : ∀ j, IsTransport ω₂ (genPath j) (genPath' j) (U₂ j))
    (c₀ : Aˣ) (hc : ∀ j, (c₀ : A) * (kzBraidRep ρ κ c (σ j) : A) = ρ₂ (adjSwap j) * U₂ j 1 * c₀) :
    ∃ g : (Fin (m + 1) → ℂ) → A, g (basePt 1) = c₀ ∧
      (∀ z ∈ confSet (m + 1), IsUnit (g z)) ∧ ∀ y ∈ confSet (m + 1),
        HasFDerivAt g ((ContinuousLinearMap.mul ℝ A).flip (g y) ∘L ω₂ y -
          (ContinuousLinearMap.mul ℝ A (g y)) ∘L kzForm ρ κ c y) y :=
  kz_gauge_of_braid_conj ρ κ c ρ₂ h₂ hω₂ U₂ hU₂ (artin_generation hm) c₀ hc

