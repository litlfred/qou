import QOU.Information.OuterDerivationResidue
import Mathlib.RingTheory.Adjoin.Basic

/-!
# Weyl centre argument: zero commutator with the generator means scalar

Two algebraic facts behind "zero derivative means constant":

* **On a commutative algebra every inner derivation is zero** (`innerDerivation_eq_zero`), so a
  nonzero derivation of a commutative algebra is outer (`not_isInner_of_ne_zero`). A derivation
  `d` on functions therefore cannot be written as `[D, ·]` *inside* the function algebra.

* **In a bigger algebra it can.** If `A` is generated by a commutative family `F` together with
  one element `D` (the Weyl-type algebra `⟨F, D⟩`, where `[D, f] = d f`), then any `f ∈ F` with
  `[D, f] = 0` commutes with every generator and so is central (`mem_center_of_commute_gen`).
  If the centre of `A` is the scalars, `f` is a scalar (`eq_algebraMap_of_commute_gen`).

The last hypothesis, "the centre is the scalars", is the algebraic stand-in for connectedness:
it is the observability condition `Hom(1, Ad A) = 0`. Nothing here is analytic.
-/

namespace QOU.Information

section Commutative

variable {R : Type*} [CommRing R] {A : Type*} [CommRing A] [Algebra R A]

/-- **Inner derivations of a commutative algebra vanish.** -/
theorem innerDerivation_eq_zero (x : A) : innerDerivation (R := R) x = 0 := by
  ext a
  simp [innerDerivation_apply, mul_comm]

/-- **A nonzero derivation of a commutative algebra is outer.** -/
theorem not_isInner_of_ne_zero {δ : A →ₗ[R] A} (hδ : δ ≠ 0) :
    ¬ ∃ x : A, δ = innerDerivation (R := R) x := by
  rintro ⟨x, rfl⟩
  exact hδ (innerDerivation_eq_zero x)

end Commutative

section Weyl

variable {R : Type*} [CommRing R] {A : Type*} [Ring A] [Algebra R A]

/-- **Commuting with the generators means central.** -/
theorem mem_center_of_commute_gen {s : Set A} (hs : Algebra.adjoin R s = ⊤) {x : A}
    (hx : ∀ y ∈ s, Commute x y) : x ∈ Subalgebra.center R A := by
  have hle : Algebra.adjoin R s ≤ Subalgebra.centralizer R {x} := by
    rw [Algebra.adjoin_le_iff]
    intro y hy g hg
    rw [Set.mem_singleton_iff] at hg
    subst hg
    exact (hx y hy).eq
  rw [Subalgebra.mem_center_iff]
  intro z
  have hz : z ∈ Subalgebra.centralizer R {x} := hle (hs ▸ Algebra.mem_top)
  exact (hz x (Set.mem_singleton x)).symm

/-- **Weyl centre argument.** Let `A` be generated by a commutative set `F` and one element `D`.
If `f ∈ F` has `[D, f] = 0` and the centre of `A` is the scalars, then `f` is a scalar. -/
theorem eq_algebraMap_of_commute_gen {F : Set A} (hF : ∀ a ∈ F, ∀ b ∈ F, Commute a b) (D : A)
    (hgen : Algebra.adjoin R (insert D F) = ⊤)
    (hcentre : ∀ z ∈ Subalgebra.center R A, ∃ c : R, z = algebraMap R A c)
    {f : A} (hf : f ∈ F) (hD : D * f - f * D = 0) : ∃ c : R, f = algebraMap R A c := by
  refine hcentre f (mem_center_of_commute_gen hgen ?_)
  intro y hy
  rcases Set.mem_insert_iff.1 hy with rfl | hy
  · exact (sub_eq_zero.1 hD).symm
  · exact hF f hf y hy

end Weyl

end QOU.Information
