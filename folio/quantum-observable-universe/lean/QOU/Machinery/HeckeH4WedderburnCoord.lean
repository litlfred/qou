noncomputable def coordMInv (q : K) : Matrix (Fin 24) (Fin 24) K :=
  Matrix.of ![coordMInvRow0 q, coordMInvRow1 q, coordMInvRow2 q, coordMInvRow3 q, coordMInvRow4 q, coordMInvRow5 q, coordMInvRow6 q, coordMInvRow7 q, coordMInvRow8 q, coordMInvRow9 q, coordMInvRow10 q, coordMInvRow11 q, coordMInvRow12 q, coordMInvRow13 q, coordMInvRow14 q, coordMInvRow15 q, coordMInvRow16 q, coordMInvRow17 q, coordMInvRow18 q, coordMInvRow19 q, coordMInvRow20 q, coordMInvRow21 q, coordMInvRow22 q, coordMInvRow23 q]

/-- The stacked component vector of the Wedderburn target
    $(s, t, M_2, M_{31}, M_{211})$, in the row order of `coordM`. -/
def wvec (s t : K) (M2 : Matrix (Fin 2) (Fin 2) K)
    (M31 M211 : Matrix (Fin 3) (Fin 3) K) : Fin 24 → K :=
  ![s, t, M2 0 0, M2 0 1, M2 1 0, M2 1 1, M31 0 0, M31 0 1, M31 0 2, M31 1 0, M31 1 1, M31 1 2, M31 2 0, M31 2 1, M31 2 2, M211 0 0, M211 0 1, M211 0 2, M211 1 0, M211 1 1, M211 1 2, M211 2 0, M211 2 1, M211 2 2]

/-- The stacked coordinates of the assembled Wedderburn map
    $(\chi_+, \chi_-, \rho_{22}, \rho_{31}, \rho_{211})$ applied to `v`. -/
noncomputable def homVec (q : K) (v : Fin 24 → K) : Fin 24 → K :=
  wvec (chiNF₄ q v) (chiNF₄ (-q⁻¹) v) (blockOf22 q v) (blockOf31 q v)
    (blockOf211 q v)

/-- The inverse coordinate map, **defined** as the matrix action of the
    symbolic inverse on the stacked component vector; the left/right
    inverse identities are proved in `HeckeH4WedderburnInv.lean`. -/
noncomputable def wedderburnInvV₄ (q s t : K) (M2 : Matrix (Fin 2) (Fin 2) K)
    (M31 M211 : Matrix (Fin 3) (Fin 3) K) : Fin 24 → K :=
  (coordMInv q).mulVec (wvec s t M2 M31 M211)

/-- Definitional glue (`rfl`): the inverse formulas are the `coordMInv`
    action on the stacked component vector. -/
theorem wedderburnInvV₄_eq_mulVec (q s t : K) (M2 : Matrix (Fin 2) (Fin 2) K)
    (M31 M211 : Matrix (Fin 3) (Fin 3) K) :
    wedderburnInvV₄ q s t M2 M31 M211
      = (coordMInv q).mulVec (wvec s t M2 M31 M211) := rfl

