/-- Expansion of a `Fin 24` sum into numeral-indexed components — the
    index normal form every per-entry goal below uses (the
    `Fin.sum_univ_succ` towers do not match numeral atoms). -/
theorem sum_univ_24 {M : Type*} [AddCommMonoid M] (f : Fin 24 → M) :
    ∑ i, f i = f 0 + f 1 + f 2 + f 3 + f 4 + f 5 + f 6 + f 7 + f 8 + f 9 + f 10 + f 11 + f 12 + f 13 + f 14 + f 15 + f 16 + f 17 + f 18 + f 19 + f 20 + f 21 + f 22 + f 23 := by
  simp [Fin.sum_univ_succ, add_assoc]

