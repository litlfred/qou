theorem exists_pairing_ne_zero₄ (q z : K) (hq : q ≠ 0) (h2 : q ^ 2 + 1 ≠ 0)
    (h3 : q ^ 4 + q ^ 2 + 1 ≠ 0) (h4 : q ^ 4 + 1 ≠ 0)
    (hWp : markovWeightPlus q z ≠ 0) (hWm : markovWeightMinus q z ≠ 0)
    (hW22 : markovWeight22 q z ≠ 0) (hW31 : markovWeight31 q z ≠ 0)
    (hW211 : markovWeight211 q z ≠ 0)
    (y : Fin 24 → K) (hy : y ≠ 0) :
    ∃ w : Fin 24 → K, trM4 z (q - q⁻¹) (mulNF₄ (q - q⁻¹) y w) ≠ 0 := by
  -- the stacked image of a nonzero element is nonzero (coordM invertible)
  have hnz : homVec q y ≠ 0 := by
    intro hc
    apply hy
    have hmv := congrArg (fun u => (coordMInv q).mulVec u) hc
    simpa [homVec_eq_mulVec, Matrix.mulVec_mulVec,
      coordMInv_mul_coordM q hq h2 h3 h4, Matrix.one_mulVec,
      Matrix.mulVec_zero] using hmv
  obtain ⟨i, hi⟩ : ∃ i, homVec q y i ≠ 0 := by
    by_contra hall
    push_neg at hall
    exact hnz (funext fun i => hall i)
  fin_cases i
  · -- component: `chiNF₄ q y`
    refine ⟨wedderburnInvV₄ q 1 0 0 0 0, ?_⟩
    have hcomp : chiNF₄ q y ≠ 0 := by
      simpa only [homVec, wvec, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.head_cons, Matrix.cons_val, Fin.isValue] using hi
    rw [trM4_eq_blocks q z hq h2 h3 h4,
      chiNF₄_mulNF₄ (q - q⁻¹) q (root_q q hq),
      chiNF₄_mulNF₄ (q - q⁻¹) (-q⁻¹) (root_negInv q hq),
      blockOf22_mulNF₄ q hq h2, blockOf31_mulNF₄ q hq h2 h3,
      blockOf211_mulNF₄ q hq h2 h3,
      chiNF₄_wedderburnInvV₄_plus q hq h2 h3 h4,
      chiNF₄_wedderburnInvV₄_minus q hq h2 h3 h4,
      blockOf22_wedderburnInvV₄ q hq h2 h3 h4,
      blockOf31_wedderburnInvV₄ q hq h2 h3 h4,
      blockOf211_wedderburnInvV₄ q hq h2 h3 h4]
    simp only [mul_one, mul_zero, Matrix.mul_zero, Matrix.trace_zero,
      add_zero, zero_add]
    exact mul_ne_zero hWp hcomp
  · -- component: `chiNF₄ (-q⁻¹) y`
    refine ⟨wedderburnInvV₄ q 0 1 0 0 0, ?_⟩
