      Matrix.head_cons, Matrix.cons_val, Fin.isValue] using hi
    rw [trM4_eq_blocks q z hq h2 h3 h4,
      chiNF₄_mulNF₄ (q - q⁻¹) q (root_q q hq),
      chiNF₄_mulNF₄ (q - q⁻¹) (-q⁻¹) (root_negInv q hq),
      blockOf22_mulNF₄ q hq h2, blockOf31_mulNF₄ q hq h2 h3,
      blockOf211_mulNF₄ q hq h2 h3,
      chiNF₄_wedderburnInvV₄_plus q hq h2 h3 h4,
      chiNF₄_wedderburnInvV₄_minus q hq h2 h3 h4,
      blockOf22_wedderburnInvV₄ q hq h2 h3 h4,
      blockOf31_wedderburnInvV₄ q hq h2 h3 h4,
      blockOf211_wedderburnInvV₄ q hq h2 h3 h4]
    simp only [mul_one, mul_zero, Matrix.mul_zero, Matrix.trace_zero,
      add_zero, zero_add]
    exact mul_ne_zero hWm hcomp
