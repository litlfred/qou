/-- The unit $\gamma$ maps to the identity matrix — column 0 of $A$ is the
    identity block $(2,1,1)$-component (sorry-free). -/
theorem blockOf211_unit (q : K) : blockOf211 q (unitNF₄ (R := K)) = 1 := by
  ext i j
  fin_cases i <;> fin_cases j
  all_goals simp [blockOf211, unitNF₄]

set_option maxHeartbeats 6400000 in
/-- The block map intertwines the right `σ₀`-action with right
    multiplication by `S0_211` (9 scalar goals; each closed by
    `linear_combination` with the sympy-derived, exactly-verified SET-E
    cofactors — sorry-free). -/
theorem blockOf211_mulσ₀ (q : K) (hq : q ≠ 0)
    (u : Fin 24 → K) :
    blockOf211 q (mulσ₀ (q - q⁻¹) u) = blockOf211 q u * S0_211 q := by
  ext r c
  fin_cases r <;> fin_cases c
  · show blockOf211 q (mulσ₀ (q - q⁻¹) u) 0 0 =
        (blockOf211 q u * S0_211 q) 0 0
    simp only [blockOf211, S0_211, mulσ₀, Matrix.mul_apply,
      Fin.sum_univ_three, Matrix.of_apply, Matrix.cons_val, Fin.isValue]
    linear_combination (norm := ring1)
        (-u 1 - u 10*(q ^ 2 + 1)⁻¹ + u 12*(q ^ 2 + 1)⁻¹*q⁻¹ ^ 2 - u 13*(q ^ 2 + 1)⁻¹ + u 16*(q ^ 2 + 1)⁻¹*q⁻¹ + u 2*(q ^ 2 + 1)⁻¹ + u 5*(q ^ 2 + 1)⁻¹ + u 6 - u 7*(q ^ 2 + 1)⁻¹*q⁻¹ - u 9*(q ^ 2 + 1)⁻¹*q⁻¹) * mul_inv_cancel₀ hq
  · show blockOf211 q (mulσ₀ (q - q⁻¹) u) 0 1 =
        (blockOf211 q u * S0_211 q) 0 1
    simp only [blockOf211, S0_211, mulσ₀, Matrix.mul_apply,
      Fin.sum_univ_three, Matrix.of_apply, Matrix.cons_val, Fin.isValue]
    linear_combination (norm := ring1)
        (-q ^ 2*u 22*(q ^ 4 + q ^ 2 + 1)⁻¹*q⁻¹ - q ^ 2*u 23*(q ^ 4 + q ^ 2 + 1)⁻¹ + u 11*(q ^ 4 + q ^ 2 + 1)⁻¹*q⁻¹ + u 14*q⁻¹ + u 15*(q ^ 4 + q ^ 2 + 1)⁻¹ - u 18*(q ^ 4 + q ^ 2 + 1)⁻¹*q⁻¹ ^ 2 + u 19 - u 21*(q ^ 4 + q ^ 2 + 1)⁻¹*q⁻¹ - u 22*(q ^ 4 + q ^ 2 + 1)⁻¹*q⁻¹ - u 23*(q ^ 4 + q ^ 2 + 1)⁻¹ - u 3 + u 4) * mul_inv_cancel₀ hq
  · show blockOf211 q (mulσ₀ (q - q⁻¹) u) 0 2 =
        (blockOf211 q u * S0_211 q) 0 2
    simp only [blockOf211, S0_211, mulσ₀, Matrix.mul_apply,
      Fin.sum_univ_three, Matrix.of_apply, Matrix.cons_val, Fin.isValue]
    linear_combination (norm := ring1)
        (u 10 - u 11 + u 18*q⁻¹ + u 21 - u 22*q⁻¹ ^ 2 - u 23*q⁻¹) * mul_inv_cancel₀ hq
