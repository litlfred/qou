  · show blockOf211 q (c • a) 2 2 =
        (c • blockOf211 q a) 2 2
    simp only [blockOf211, Matrix.smul_apply, Matrix.of_apply,
      Matrix.cons_val, Fin.isValue, Pi.smul_apply, smul_eq_mul]
    ring

set_option maxHeartbeats 6400000 in
/-- Expansion of `blockOf211 ∘ mulNF₄` along the right basis: the block map
    of a product is the $v$-weighted sum of the block maps of the 24 word
    composites (pure bilinearity — the generator actions stay opaque). -/
private theorem blockOf211_mulNF₄_expand (q : K) (u v : Fin 24 → K) :
    blockOf211 q (mulNF₄ (q - q⁻¹) u v) =
        v 0 • blockOf211 q u
      + v 1 • blockOf211 q (mulσ₀ (q - q⁻¹) u)
      + v 2 • blockOf211 q (mulσ₁ (q - q⁻¹) u)
      + v 3 • blockOf211 q (mulσ₀ (q - q⁻¹) (mulσ₁ (q - q⁻¹) u))
      + v 4 • blockOf211 q (mulσ₁ (q - q⁻¹) (mulσ₀ (q - q⁻¹) u))
      + v 5 • blockOf211 q (mulσ₀ (q - q⁻¹) (mulσ₁ (q - q⁻¹) (mulσ₀ (q - q⁻¹) u)))
      + v 6 • blockOf211 q (mulσ₂ (q - q⁻¹) u)
      + v 7 • blockOf211 q (mulσ₂ (q - q⁻¹) (mulσ₁ (q - q⁻¹) u))
      + v 8 • blockOf211 q (mulσ₀ (q - q⁻¹) (mulσ₂ (q - q⁻¹) u))
      + v 9 • blockOf211 q (mulσ₁ (q - q⁻¹) (mulσ₂ (q - q⁻¹) u))
      + v 10 • blockOf211 q (mulσ₂ (q - q⁻¹) (mulσ₁ (q - q⁻¹) (mulσ₀ (q - q⁻¹) u)))
      + v 11 • blockOf211 q (mulσ₂ (q - q⁻¹) (mulσ₀ (q - q⁻¹) (mulσ₁ (q - q⁻¹) u)))
      + v 12 • blockOf211 q (mulσ₁ (q - q⁻¹) (mulσ₂ (q - q⁻¹) (mulσ₁ (q - q⁻¹) u)))
      + v 13 • blockOf211 q (mulσ₁ (q - q⁻¹) (mulσ₀ (q - q⁻¹) (mulσ₂ (q - q⁻¹) u)))
      + v 14 • blockOf211 q (mulσ₀ (q - q⁻¹) (mulσ₁ (q - q⁻¹) (mulσ₂ (q - q⁻¹) u)))
      + v 15 • blockOf211 q (mulσ₂ (q - q⁻¹) (mulσ₀ (q - q⁻¹) (mulσ₁ (q - q⁻¹) (mulσ₀ (q - q⁻¹) u))))
      + v 16 • blockOf211 q (mulσ₁ (q - q⁻¹) (mulσ₂ (q - q⁻¹) (mulσ₁ (q - q⁻¹) (mulσ₀ (q - q⁻¹) u))))
      + v 17 • blockOf211 q (mulσ₁ (q - q⁻¹) (mulσ₂ (q - q⁻¹) (mulσ₀ (q - q⁻¹) (mulσ₁ (q - q⁻¹) u))))
      + v 18 • blockOf211 q (mulσ₀ (q - q⁻¹) (mulσ₁ (q - q⁻¹) (mulσ₂ (q - q⁻¹) (mulσ₁ (q - q⁻¹) u))))
      + v 19 • blockOf211 q (mulσ₀ (q - q⁻¹) (mulσ₁ (q - q⁻¹) (mulσ₀ (q - q⁻¹) (mulσ₂ (q - q⁻¹) u))))
      + v 20 • blockOf211 q (mulσ₁ (q - q⁻¹) (mulσ₂ (q - q⁻¹) (mulσ₀ (q - q⁻¹) (mulσ₁ (q - q⁻¹) (mulσ₀ (q - q⁻¹) u)))))
      + v 21 • blockOf211 q (mulσ₀ (q - q⁻¹) (mulσ₁ (q - q⁻¹) (mulσ₂ (q - q⁻¹) (mulσ₁ (q - q⁻¹) (mulσ₀ (q - q⁻¹) u)))))
      + v 22 • blockOf211 q (mulσ₀ (q - q⁻¹) (mulσ₁ (q - q⁻¹) (mulσ₂ (q - q⁻¹) (mulσ₀ (q - q⁻¹) (mulσ₁ (q - q⁻¹) u)))))
      + v 23 • blockOf211 q (mulσ₀ (q - q⁻¹) (mulσ₁ (q - q⁻¹) (mulσ₂ (q - q⁻¹) (mulσ₀ (q - q⁻¹) (mulσ₁ (q - q⁻¹) (mulσ₀ (q - q⁻¹) u)))))) := by
  rw [mulNF₄_eq_pi_sum]
  simp only [blockOf211_add, blockOf211_smul]

set_option maxHeartbeats 6400000 in
/-- **Multiplicativity of the $(2,1,1)$ block map on the full NF product
    (sorry-free)** — expand along the right basis, peel every word composite
    with the three intertwiners (both for general `u` and for `u = γ`, which
    recovers the word-product decomposition of the explicit entries), and
    collect with associativity. -/
theorem blockOf211_mulNF₄ (q : K) (hq : q ≠ 0) (h2 : q ^ 2 + 1 ≠ 0) (h3 : q ^ 4 + q ^ 2 + 1 ≠ 0)
    (u v : Fin 24 → K) :
    blockOf211 q (mulNF₄ (q - q⁻¹) u v) = blockOf211 q u * blockOf211 q v := by
  have hu := blockOf211_mulNF₄_expand q u v
  have h1 := blockOf211_mulNF₄_expand q (unitNF₄ (R := K)) v
  rw [mulNF₄_one_left] at h1
  simp only [blockOf211_mulσ₀ q hq, blockOf211_mulσ₁ q hq h2 h3,
    blockOf211_mulσ₂ q hq h2 h3, blockOf211_unit q, one_mul] at hu h1
  rw [hu, h1]
  simp only [Matrix.mul_add, Matrix.mul_smul, Matrix.mul_one, Matrix.mul_assoc]

namespace H4A

set_option maxHeartbeats 12800000 in
/-- **The $(2,1,1)$ block representation (sorry-free).**  The algebra
    homomorphism `H₄(q) →ₐ M_3(K)` induced by the explicit-entry block map;
    with the two characters and the sibling blocks this is the block *data*
    of $H_4(q) \cong K \times K \times M_2 \times M_3 \times M_3$. -/
noncomputable def blockRep211 (q : K) (hq : q ≠ 0) (h2 : q ^ 2 + 1 ≠ 0) (h3 : q ^ 4 + q ^ 2 + 1 ≠ 0) :
    H4A K (q - q⁻¹) →ₐ[K] Matrix (Fin 3) (Fin 3) K where
  toFun x := blockOf211 q x.v
  map_one' := by
    show blockOf211 q (unitNF₄ (R := K)) = 1
    exact blockOf211_unit q
  map_mul' x y := blockOf211_mulNF₄ q hq h2 h3 x.v y.v
  map_zero' := by
    show blockOf211 q (0 : Fin 24 → K) = 0
    ext i j
    fin_cases i <;> fin_cases j
    all_goals simp [blockOf211]
  map_add' x y := by
    show blockOf211 q (x.v + y.v) = blockOf211 q x.v + blockOf211 q y.v
    ext i j
    fin_cases i <;> fin_cases j
    all_goals simp [blockOf211, Matrix.add_apply, Pi.add_apply]
    all_goals try ring
  commutes' c := by
    show blockOf211 q ((c • (1 : H4A K (q - q⁻¹))).v) = _
    rw [smul_v, one_v]
    ext i j
    fin_cases i <;> fin_cases j
    all_goals simp [blockOf211, unitNF₄, Matrix.algebraMap_matrix_apply,
      Pi.smul_apply, smul_eq_mul]

end H4A

end QOU.Machinery.H4
