import QOU.Machinery.QuantumTorus
import Mathlib.Algebra.Polynomial.Laurent

/-!
# The q-difference operator is inner, and its kernel is the constants

In the quantum torus `T = A[L^±; σ]` the q-difference operator `a ↦ σ a - a` is the twisted
commutator with `L`: `(L·a - a·L)·L⁻¹ = σ a - a` (`twistedComm_emb`). So "`d f = 0`" is
"`f` commutes with `L`", and its kernel on coefficients is the `σ`-invariants
(`twistedComm_emb_eq_zero_iff`).

For `A = R[M^±]` with `σ(M) = u·M` (`scaleAction u`), the `σ`-invariants are the constants as
soon as `R` is a domain and `u` is not a root of unity (`sigma_eq_self_iff`). This is the
algebraic form of "zero derivative means constant": no topology, only `u^n ≠ 1`.
-/

open LaurentPolynomial

namespace QOU.Machinery.QuantumTorus

open SkewMonoidAlgebra

section General

variable {A : Type*} [CommRing A] [MulSemiringAction Ldeg A]

theorem emb_injective : Function.Injective (emb : A →+* QuantumTorus A) := by
  intro a b h
  have := congrArg (fun x : QuantumTorus A => x.coeff (1 : Ldeg)) h
  simp only at this
  rwa [coeff_emb, coeff_emb, if_pos rfl, if_pos rfl] at this

/-- **The q-difference operator is inner (twisted).** `(L·a - a·L)·L⁻¹ = σ a - a`. -/
theorem twistedComm_emb (a : A) :
    (Lgen * emb a - emb a * Lgen) * Linv = (emb (sigma a - a) : QuantumTorus A) := by
  rw [Lgen_mul_emb, sub_mul, mul_assoc, mul_assoc, Lgen_mul_Linv, mul_one, mul_one, map_sub]

/-- **Kernel of the twisted commutator.** `a` commutes with `L` iff `σ a = a`. -/
theorem twistedComm_emb_eq_zero_iff (a : A) :
    (Lgen * emb a - emb a * Lgen : QuantumTorus A) = 0 ↔ sigma a = a := by
  constructor
  · intro h
    have h' := twistedComm_emb a
    rw [h, zero_mul, ← map_zero emb] at h'
    exact sub_eq_zero.1 (emb_injective h').symm
  · intro h
    have h' := twistedComm_emb a
    rw [h, sub_self, map_zero] at h'
    calc (Lgen * emb a - emb a * Lgen : QuantumTorus A)
        = ((Lgen * emb a - emb a * Lgen) * Linv) * Lgen := by
          rw [mul_assoc, Linv_mul_Lgen, mul_one]
      _ = 0 := by rw [h', zero_mul]

end General

section Laurent

variable {R : Type*} [CommRing R]

/-- The unit `u·M` of `R[M^±]`. -/
noncomputable def scaleUnit (u : Rˣ) : (R[T;T⁻¹])ˣ where
  val := C (u : R) * T 1
  inv := C ((u⁻¹ : Rˣ) : R) * T (-1)
  val_inv := by
    rw [mul_mul_mul_comm, ← map_mul, ← T_add]; simp
  inv_val := by
    rw [mul_mul_mul_comm, ← map_mul, ← T_add]; simp

theorem scaleUnit_zpow (u : Rˣ) (n : ℤ) :
    ((scaleUnit u ^ n : (R[T;T⁻¹])ˣ) : R[T;T⁻¹]) = C ((u ^ n : Rˣ) : R) * T n := by
  induction n using Int.induction_on with
  | zero => simp
  | succ n ih =>
    rw [zpow_add_one, Units.val_mul, ih, zpow_add_one, Units.val_mul, map_mul, T_add]
    simp only [scaleUnit]
    ring
  | pred n ih =>
    rw [zpow_sub_one, Units.val_mul, ih, zpow_sub_one, Units.val_mul, map_mul,
      sub_eq_add_neg, T_add]
    simp only [scaleUnit, Units.inv_mk]
    ring

/-- The scaling `M ↦ u·M` of `R[M^±]`, as an `R`-algebra map. -/
noncomputable def scaleAlgHom (u : Rˣ) : R[T;T⁻¹] →ₐ[R] R[T;T⁻¹] :=
  AddMonoidAlgebra.lift R ℤ R[T;T⁻¹] ((Units.coeHom _).comp (zpowersHom _ (scaleUnit u)))

theorem scaleAlgHom_T (u : Rˣ) (n : ℤ) :
    scaleAlgHom u (T n) = C ((u ^ n : Rˣ) : R) * T n := by
  rw [scaleAlgHom, T, AddMonoidAlgebra.lift_single]
  simp [scaleUnit_zpow]

theorem scaleAlgHom_C_mul_T (u : Rˣ) (a : R) (n : ℤ) :
    scaleAlgHom u (C a * T n) = C (a * ((u ^ n : Rˣ) : R)) * T n := by
  rw [map_mul, scaleAlgHom_T, C_eq_algebraMap, AlgHom.commutes, ← C_eq_algebraMap, map_mul,
    mul_assoc]

/-- `σ` scales the `n`-th coefficient by `uⁿ`. -/
theorem scaleAlgHom_apply (u : Rˣ) (f : R[T;T⁻¹]) (n : ℤ) :
    scaleAlgHom u f n = ((u ^ n : Rˣ) : R) * f n := by
  induction f using LaurentPolynomial.induction_on' with
  | add p q hp hq => rw [map_add, Finsupp.add_apply, Finsupp.add_apply, hp, hq, mul_add]
  | C_mul_T m a =>
    rw [scaleAlgHom_C_mul_T, ← single_eq_C_mul_T, ← single_eq_C_mul_T, Finsupp.single_apply,
      Finsupp.single_apply]
    split_ifs with h
    · subst h; ring
    · ring

theorem scaleAlgHom_scaleAlgHom_inv (u : Rˣ) (f : R[T;T⁻¹]) :
    scaleAlgHom u⁻¹ (scaleAlgHom u f) = f := by
  ext n
  rw [scaleAlgHom_apply, scaleAlgHom_apply, ← mul_assoc, ← Units.val_mul, ← mul_zpow,
    inv_mul_cancel, one_zpow, Units.val_one, one_mul]

/-- The scaling `M ↦ u·M` as an `R`-algebra automorphism of `R[M^±]`. -/
noncomputable def scaleEquiv (u : Rˣ) : R[T;T⁻¹] ≃ₐ[R] R[T;T⁻¹] :=
  AlgEquiv.ofAlgHom (scaleAlgHom u) (scaleAlgHom u⁻¹)
    (AlgHom.ext fun f => by simpa using scaleAlgHom_scaleAlgHom_inv u⁻¹ f)
    (AlgHom.ext fun f => scaleAlgHom_scaleAlgHom_inv u f)

/-- The `ℤ`-action on `R[M^±]` generated by `M ↦ u·M`. -/
noncomputable def scaleAction (u : Rˣ) : MulSemiringAction Ldeg R[T;T⁻¹] :=
  MulSemiringAction.compHom R[T;T⁻¹] (zpowersHom (R[T;T⁻¹] ≃ₐ[R] R[T;T⁻¹]) (scaleEquiv u))

theorem sigma_scaleAction (u : Rˣ) (f : R[T;T⁻¹]) :
    letI := scaleAction u
    sigma f = scaleAlgHom u f := by
  show (zpowersHom _ (scaleEquiv u) (Multiplicative.ofAdd (1 : ℤ))) f = _
  simp [zpowersHom_apply, scaleEquiv]

/-- **The `σ`-invariants of `R[M^±]` are the constants** (`R` a domain, `u` not a root of
unity). This is "q-difference zero ⇒ constant", proved by comparing coefficients. -/
theorem sigma_eq_self_iff [IsDomain R] (u : Rˣ) (hu : ∀ n : ℤ, n ≠ 0 → u ^ n ≠ 1)
    (f : R[T;T⁻¹]) :
    letI := scaleAction u
    sigma f = f ↔ f = C (f 0) := by
  letI := scaleAction u
  rw [sigma_scaleAction]
  constructor
  · intro h
    ext n
    rw [C_eq_algebraMap, ← C_eq_algebraMap, ← mul_one (C (f 0)), ← T_zero,
      ← single_eq_C_mul_T, Finsupp.single_apply]
    split_ifs with hn
    · rw [hn]
    · have hc := congrArg (fun g : R[T;T⁻¹] => g n) h
      simp only [scaleAlgHom_apply] at hc
      have h1 : (((u ^ n : Rˣ) : R) - 1) * f n = 0 := by rw [sub_mul, hc, one_mul, sub_self]
      rcases mul_eq_zero.1 h1 with h2 | h2
      · exact absurd (Units.val_eq_one.1 (sub_eq_zero.1 h2)) (hu n (Ne.symm hn))
      · exact h2
  · intro h
    rw [h, ← mul_one (C (f 0)), ← T_zero, scaleAlgHom_C_mul_T, zpow_zero, Units.val_one,
      mul_one]

/-- **Zero q-derivative means constant, algebraically.** In the quantum torus over `R[M^±]`
with `σ(M) = u·M`, an element of the coefficient ring commutes with `L` iff it is a constant. -/
theorem twistedComm_eq_zero_iff_const [IsDomain R] (u : Rˣ) (hu : ∀ n : ℤ, n ≠ 0 → u ^ n ≠ 1)
    (f : R[T;T⁻¹]) :
    letI := scaleAction u
    (Lgen * emb f - emb f * Lgen : QuantumTorus R[T;T⁻¹]) = 0 ↔ f = C (f 0) := by
  letI := scaleAction u
  rw [twistedComm_emb_eq_zero_iff]
  exact sigma_eq_self_iff u hu f

end Laurent

end QOU.Machinery.QuantumTorus
