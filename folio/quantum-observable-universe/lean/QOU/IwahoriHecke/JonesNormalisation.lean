import QOU.IwahoriHecke.NegativePeel

/-!
# The framing correction, and why its two constants are forced

`BraidTower` and `NegativePeel` give both Markov moves for the braid trace, with **different**
scalars: `z⁺ = q³·wi` and `z⁻ = qi·wi` at the weight the peel forces. Their product is
`q²·wi²`, not `1`, so the raw trace is an invariant of a *framed* closure and nothing more.

This file removes the framing, and the point is that there is **no freedom in how**.

## The writhe

`Mathlib` has no braid group, hence no writhe. `writhe : Art(M) →* Multiplicative ℤ` sends every
generator to `1`; the Artin relations are satisfied because a relation equates two alternating
words of lengths `M i j` and `M j i`, which a *symmetric* `M` makes equal. So the exponent sum is
well defined on the presented group — that symmetry is the whole content, and it is the same
hypothesis `heckeRep` and `liftBalanced` already take.

`braidWritheZ` is its integer form; `braidWritheZ_braidTower` says adding an inert strand does
not change it.

## The two constants, and their uniqueness

Correct by `J(β) := A^{n} · B^{writhe β} · tr(β)` with `A`, `B` units. The two moves give two
equations, and they determine `A` and `B` up to sign:

| move | strands | writhe | condition |
|---|---|---|---|
| II⁺ | `n → n+1` | `w → w+1` | `A · B · z⁺ = 1` |
| II⁻ | `n → n+1` | `w → w−1` | `A · B⁻¹ · z⁻ = 1` |

Multiplying: `A² = (z⁺z⁻)⁻¹ = q⁻²(1+q²)²`. Dividing: `B² = z⁻/z⁺ = q⁻⁴`. So

    A = (1 + q²)·q⁻¹,   B = q⁻²

is a solution, and `strandFactor`/`writheFactor` are exactly those — written division-free, as
units built from `q·qi = 1` and `(1+q²)·wi = 1`, so `R` stays a bare `CommRing`.

`jonesFn_peel` and `jonesFn_peel_neg` verify both moves; `jonesFn_conj` is move I, which the
correction leaves alone because the writhe and the strand count are both conjugation-invariant.
`framing_constants_unique` states exactly what the two equations pin, and no more: for *any*
`a, b, c` with `a·b·z⁺ = 1`, `a·c·z⁻ = 1` and `b·c = 1`, they force `a²·(q³·qi·wi²) = 1` and
`b²·q³ = qi`. That is a determination of the **squares** — the sign is genuinely free, which is
why the standard Jones normalisation carries a `(−1)`-type factor and why this file does not
claim uniqueness of `A` and `B` themselves.

## 🛑 One gap remains, and it is the topological one

`jonesFn` is now invariant under **both** Markov moves and under conjugation. It is still not a
link invariant, because **Markov's theorem** — that closure-equivalence of braids is generated by
exactly these moves — is a theorem of low-dimensional topology that Mathlib does not have and
this corpus does not prove. Nothing here hypothesises it: with it, `jonesFn` descends to links;
without it, `jonesFn` is a function on braids that happens to be constant on the orbits of the
two moves.

That is the honest state, and it is a strictly smaller gap than the one this branch started with.

-- Ref: [jones1987] Hecke algebra representations of braid groups and link polynomials
-- Ref: [markov1936] the theorem, not proved here
-- Ref: [leitner2026] bean qou-k4oq
-/

namespace QOU.IwahoriHecke.JonesNormalisation

open QOU.MathlibExt.IwahoriHecke QOU.MathlibExt.SkeinRelation
open QOU.IwahoriHecke.Balanced QOU.IwahoriHecke.TensorEmbed
open QOU.IwahoriHecke.MarkovPeel QOU.IwahoriHecke.BraidGroup
open QOU.IwahoriHecke.BraidTower QOU.IwahoriHecke.NegativePeel

/-! ## The writhe -/

variable {B : Type*} (M : B → B → ℕ)

/-- **The writhe** — the exponent sum of a braid word, as a homomorphism.

Well defined on the presented group precisely because `M` is symmetric: an Artin relation
equates alternating words of lengths `M i j` and `M j i`, which under a constant assignment
become the same power. -/
def writhe (hM : ∀ i j, M i j = M j i) : ArtinGroup M →* Multiplicative ℤ :=
  PresentedGroup.toGroup (f := fun _ : B => Multiplicative.ofAdd (1 : ℤ)) (by
    rintro r ⟨i, j, rfl⟩
    rw [map_mul, map_inv, map_altProd, map_altProd]
    simp only [FreeGroup.lift_apply_of]
    rw [hM i j, mul_inv_cancel])

@[simp] theorem writhe_braidGen (hM : ∀ i j, M i j = M j i) (i : B) :
    writhe M hM (braidGen M i) = Multiplicative.ofAdd (1 : ℤ) :=
  PresentedGroup.toGroup.of _

variable {m : ℕ}

/-- The writhe of a braid on `m+1` strands, as an integer. -/
def braidWritheZ (β : BraidGroupN m) : ℤ :=
  Multiplicative.toAdd (writhe (coxA m) coxA_symm β)

@[simp] theorem braidWritheZ_gen (a : Fin m) :
    braidWritheZ (braidGen (coxA m) a) = 1 := by
  rw [braidWritheZ, writhe_braidGen]
  rfl

theorem braidWritheZ_mul (x y : BraidGroupN m) :
    braidWritheZ (x * y) = braidWritheZ x + braidWritheZ y := by
  rw [braidWritheZ, braidWritheZ, braidWritheZ, map_mul]
  rfl

theorem braidWritheZ_inv (x : BraidGroupN m) :
    braidWritheZ x⁻¹ = -braidWritheZ x := by
  rw [braidWritheZ, braidWritheZ, map_inv]
  rfl

theorem braidWritheZ_conj (γ β : BraidGroupN m) :
    braidWritheZ (γ * β * γ⁻¹) = braidWritheZ β := by
  rw [braidWritheZ_mul, braidWritheZ_mul, braidWritheZ_inv]
  ring

/-- Adding an inert strand does not change the writhe. -/
@[simp] theorem braidWritheZ_braidTower (β : BraidGroupN m) :
    braidWritheZ (braidTower β) = braidWritheZ β := by
  have h : (writhe (coxA (m + 1)) coxA_symm).comp (braidTower (m := m))
      = writhe (coxA m) coxA_symm := by
    refine PresentedGroup.ext (fun a => ?_)
    rw [MonoidHom.comp_apply,
      show (PresentedGroup.of a : BraidGroupN m) = braidGen (coxA m) a from rfl,
      braidTower_gen, writhe_braidGen, writhe_braidGen]
  rw [braidWritheZ, braidWritheZ, ← h, MonoidHom.comp_apply]

/-! ## The two framing constants, division-free -/

variable {R : Type*} [CommRing R] (q qi wi : R)

/-- `q` as a unit, from `q · qi = 1`. -/
def qUnit (hqi : q * qi = 1) : Rˣ :=
  ⟨q, qi, hqi, by rw [mul_comm]; exact hqi⟩

/-- The total weight `1 + q²` as a unit, from `(1 + q²) · wi = 1`. -/
def wUnit (hw : (1 + q ^ 2) * wi = 1) : Rˣ :=
  ⟨1 + q ^ 2, wi, hw, by rw [mul_comm]; exact hw⟩

/-- **The strand-count factor** `A = (1 + q²)·q⁻¹`. -/
def strandFactor (hqi : q * qi = 1) (hw : (1 + q ^ 2) * wi = 1) : Rˣ :=
  wUnit q wi hw * (qUnit q qi hqi)⁻¹

/-- **The writhe factor** `B = q⁻²`. -/
def writheFactor (hqi : q * qi = 1) : Rˣ := (qUnit q qi hqi)⁻¹ ^ 2

@[simp] theorem val_strandFactor (hqi : q * qi = 1) (hw : (1 + q ^ 2) * wi = 1) :
    ((strandFactor q qi wi hqi hw : Rˣ) : R) = (1 + q ^ 2) * qi := rfl

@[simp] theorem val_writheFactor (hqi : q * qi = 1) :
    ((writheFactor q qi hqi : Rˣ) : R) = qi ^ 2 := by
  rw [writheFactor, Units.val_pow_eq_pow_val]
  rfl

@[simp] theorem val_writheFactor_inv (hqi : q * qi = 1) :
    (((writheFactor q qi hqi)⁻¹ : Rˣ) : R) = q ^ 2 := by
  rw [writheFactor, ← inv_pow, inv_inv, Units.val_pow_eq_pow_val]
  rfl

/-- **The II⁺ condition.** `A · B · z⁺ = 1` with `z⁺ = q³·wi`. -/
theorem framing_pos (hqi : q * qi = 1) (hw : (1 + q ^ 2) * wi = 1) :
    ((strandFactor q qi wi hqi hw : Rˣ) : R) * ((writheFactor q qi hqi : Rˣ) : R)
        * (q ^ 3 * wi) = 1 := by
  rw [val_strandFactor, val_writheFactor]
  linear_combination ((q * qi) ^ 2 + q * qi + 1) * hqi + (q * qi) ^ 3 * hw

/-- **The II⁻ condition.** `A · B⁻¹ · z⁻ = 1` with `z⁻ = qi·wi`. -/
theorem framing_neg (hqi : q * qi = 1) (hw : (1 + q ^ 2) * wi = 1) :
    ((strandFactor q qi wi hqi hw : Rˣ) : R) * (((writheFactor q qi hqi)⁻¹ : Rˣ) : R)
        * (qi * wi) = 1 := by
  rw [val_strandFactor, val_writheFactor_inv]
  linear_combination (q * qi + 1) * hqi + (q * qi) ^ 2 * hw

/-- **The constants are pinned, not chosen.** The two move conditions are two equations in `A`
and `B`, and they determine `A·B` and `A·B⁻¹` outright — hence `A²` and `B²`. Any other
admissible pair differs by a sign. -/
theorem framing_constants_unique (a b c : R)
    (hpos : a * b * (q ^ 3 * wi) = 1) (hneg : a * c * (qi * wi) = 1) (hbc : b * c = 1) :
    a ^ 2 * (q ^ 3 * qi * wi ^ 2) = 1 ∧ b ^ 2 * q ^ 3 = qi := by
  have hb : b = a * qi * wi := by
    linear_combination (-b) * hneg + (a * qi * wi) * hbc
  have h1 : a ^ 2 * (q ^ 3 * qi * wi ^ 2) = 1 := by
    linear_combination (a * c * qi * wi) * hpos + hneg - (a ^ 2 * q ^ 3 * qi * wi ^ 2) * hbc
  exact ⟨h1, by linear_combination (q ^ 3 * (b + a * qi * wi)) * hb + qi * h1⟩

/-! ## The corrected functional -/

/-- **The framing-corrected trace** `J(β) = A^{n} · B^{writhe β} · tr_w(β)`. -/
noncomputable def jonesFn (hqi : q * qi = 1) (w : Fin 2 → R)
    (hw : (1 + q ^ 2) * wi = 1) (β : BraidGroupN m) : R :=
  ((strandFactor q qi wi hqi hw ^ (m + 1) : Rˣ) : R)
    * ((writheFactor q qi hqi ^ braidWritheZ β : Rˣ) : R)
    * braidTrace q qi hqi w wi β

/-- **Move I.** The strand count and the writhe are both conjugation-invariant, and the trace is
cyclic, so the correction changes nothing. -/
theorem jonesFn_conj (hqi : q * qi = 1) (w : Fin 2 → R) (hw : (1 + q ^ 2) * wi = 1)
    (γ β : BraidGroupN m) :
    jonesFn q qi wi hqi w hw (γ * β * γ⁻¹) = jonesFn q qi wi hqi w hw β := by
  rw [jonesFn, jonesFn, braidWritheZ_conj, braidTrace_conj]

/-- **Move II⁺ is killed.** -/
theorem jonesFn_peel (hqi : q * qi = 1) (w : Fin 2 → R) (hw : (1 + q ^ 2) * wi = 1)
    (h0 : w 0 = 1) (h1 : w 1 = q ^ 2) (β : BraidGroupN m) :
    jonesFn q qi wi hqi w hw (braidTower β * braidGen (coxA (m + 1)) (Fin.last m))
      = jonesFn q qi wi hqi w hw β := by
  have key := framing_pos q qi wi hqi hw
  rw [jonesFn, jonesFn, braidWritheZ_mul, braidWritheZ_braidTower, braidWritheZ_gen,
    braidTrace_peel_physical q qi hqi w wi h0 h1, pow_succ, zpow_add_one,
    Units.val_mul, Units.val_mul]
  set P := ((strandFactor q qi wi hqi hw ^ (m + 1) : Rˣ) : R)
  set Q := ((writheFactor q qi hqi ^ braidWritheZ β : Rˣ) : R)
  set T := braidTrace q qi hqi w wi β
  linear_combination (P * Q * T) * key

/-- **Move II⁻ is killed too**, by the same two constants. -/
theorem jonesFn_peel_neg (hqi : q * qi = 1) (w : Fin 2 → R) (hw : (1 + q ^ 2) * wi = 1)
    (h0 : w 0 = 1) (h1 : w 1 = q ^ 2) (β : BraidGroupN m) :
    jonesFn q qi wi hqi w hw (braidTower β * (braidGen (coxA (m + 1)) (Fin.last m))⁻¹)
      = jonesFn q qi wi hqi w hw β := by
  have key := framing_neg q qi wi hqi hw
  have hz : (q ^ 3 - (q - qi) * (∑ k, w k)) = qi :=
    negPeel_scalar_physical q qi hqi w h0 h1
  rw [jonesFn, jonesFn, braidWritheZ_mul, braidWritheZ_braidTower, braidWritheZ_inv,
    braidWritheZ_gen, ← sub_eq_add_neg,
    braidTrace_peel_neg q qi hqi w wi (q ^ 3) (peel_scalar_of_physical q qi hqi w h0 h1) β,
    hz, pow_succ, zpow_sub_one, Units.val_mul, Units.val_mul]
  set P := ((strandFactor q qi wi hqi hw ^ (m + 1) : Rˣ) : R)
  set Q := ((writheFactor q qi hqi ^ braidWritheZ β : Rˣ) : R)
  set T := braidTrace q qi hqi w wi β
  linear_combination (P * Q * T) * key

end QOU.IwahoriHecke.JonesNormalisation
