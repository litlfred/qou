import QOU.Archimedean.SchurWeylTrace

/-!
# Quantum Schur–Weyl for the whole braid algebra on `V^{⊗r}`

`QOU.Archimedean.SchurWeylTrace` proves the trace split
`tr(X | V_m) = Σ_{j ≤ min(m, r−m)} tr(X | W_{r,j})` for every weight-preserving `X` that
commutes with the raising operator `Em`. It applies the split only to the torus braid `γ`.
This file supplies the hypotheses for **every** element of the algebra generated by the strand
braidings `S q N i` of `TensorMarkovModel`, and the quantum-trace form for general `X`.
Everything is over a generic field `R`. No new quantum-integer hypothesis is introduced: the
trace statements reuse `QIntNonzero` from `SchurWeylTrace`.

## What is proved (sorry-free)

* **The `U_q(sl₂)` coproduct on `V^{⊗n}`, built recursively by Kronecker products.**
  `E_{n+1} = E_n ⊗ k + 1 ⊗ e`, `F_{n+1} = F_n ⊗ 1 + K⁻¹_n ⊗ f`, `K_{n+1} = K_n ⊗ k`, with
  `e = E_{10}`, `f = (q − q⁻¹) E_{01}`, `k = diag(q⁻¹, q)`. Also `K K⁻¹ = 1`,
  `K E = q² E K` and `K⁻¹ E = q⁻² E K⁻¹`.
* **The strand braidings commute with the coproduct** (`S_comm_E`, `S_comm_F`, `S_comm_K`,
  `S_comm_Ki`), for every `N` and every strand `i`. The proof is by induction on `N`:
  * for `i < N` the braid is `S_N i ⊗ 1`;
  * for `i = N` it is `1 ⊗ Ř` on the last two sites;
  * the two-site cases reduce to `Ř` commuting with `Δ²(E)`, `Δ²(F)` and `Δ²(K)`.
* `braidAlg_spec`: every element of `braidAlg q N = adjoin (range (S q N))` commutes with `E`
  and `F` and preserves weight.
* **`E_eq_Em`**: the coproduct `E_{n+1}` equals `Em q n` of `RossoJonesMiddle`. The two
  constructions agree, as an identity of matrices.
* `braidAlg_comm_Em` and `braidAlg_wp`: the hypotheses of `SchurWeylTrace.trace_split`, for
  every element of the braid algebra.
* **`trace_W_split`** (any weight-preserving `X` with `X Em = Em X`):
  `tr(W X) = Σ_{2j ≤ r} (Σ_{m=j}^{r−j} q^{2m}) · tr(X | W_{r,j})`.
  This generalises `SchurWeylTrace.trace_W_gam_pow_split` from `γ^p` to arbitrary `X`.
* **`braidAlg_trace_split`** and **`braidAlg_trace_W_split`**: the weight-space and the
  quantum-trace forms of Schur–Weyl, for every element of the braid algebra.

The decomposition itself (`W_{r,j}`, `trace_split`, `dim W_{r,j} = C(r,j) − C(r,j−1)`) is
`SchurWeylTrace`'s. It is not restated here.

-- Ref: [jimbo1986] Jimbo, *Lett. Math. Phys.* 11 (1986); [kassel1995] Kassel, *Quantum
-- Groups*, GTM 155, Ch. VI–VII
-/

namespace QOU.IwahoriHecke.TensorSchurWeyl

open QOU.IwahoriHecke.TensorMarkovModel QOU.IwahoriHecke.TensorEmbed QOU.IwahoriHecke.RMatrix
open QOU.IwahoriHecke.MarkovPeel QOU.Archimedean.RossoJonesGeneral
open Matrix
open scoped Kronecker

variable {R : Type*} [Field R]

/-! ## Kronecker products along the last site -/

/-- Basis states of `V^{⊗n}`, `V = R²`. -/
abbrev St (n : ℕ) := Fin n → Fin 2

/-- Splitting off the last site. -/
def snocE (m : ℕ) : (St m × Fin 2) ≃ St (m + 1) :=
  (Equiv.prodComm _ _).trans (Fin.snocEquiv fun _ => Fin 2)

theorem snocE_symm_apply {m : ℕ} (a : St (m + 1)) :
    (snocE m).symm a = (Fin.init a, a (Fin.last m)) := rfl

/-- Splitting off the last two sites. -/
def snocE2 (m : ℕ) : (St m × (Fin 2 × Fin 2)) ≃ St (m + 2) :=
  (Equiv.prodAssoc _ _ _).symm.trans
    (((snocE m).prodCongr (Equiv.refl (Fin 2))).trans (snocE (m + 1)))

theorem snocE2_symm_apply {m : ℕ} (a : St (m + 2)) :
    (snocE2 m).symm a
      = (Fin.init (Fin.init a), (Fin.init a (Fin.last m), a (Fin.last (m + 1)))) := rfl

/-- `X ⊗ Y`, with `Y` acting on the last site. -/
def tens {m : ℕ} (X : Matrix (St m) (St m) R) (Y : Matrix (Fin 2) (Fin 2) R) :
    Matrix (St (m + 1)) (St (m + 1)) R :=
  (X ⊗ₖ Y).submatrix (snocE m).symm (snocE m).symm

/-- `X ⊗ M`, with `M` acting on the last two sites. -/
def tens2 {m : ℕ} (X : Matrix (St m) (St m) R) (M : Matrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) R) :
    Matrix (St (m + 2)) (St (m + 2)) R :=
  (X ⊗ₖ M).submatrix (snocE2 m).symm (snocE2 m).symm

section Tens

variable {m : ℕ}

theorem tens_apply (X : Matrix (St m) (St m) R) (Y : Matrix (Fin 2) (Fin 2) R) (a b : St (m + 1)) :
    tens X Y a b = X (Fin.init a) (Fin.init b) * Y (a (Fin.last m)) (b (Fin.last m)) := rfl

theorem tens2_apply (X : Matrix (St m) (St m) R) (M : Matrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) R)
    (a b : St (m + 2)) :
    tens2 X M a b = X (Fin.init (Fin.init a)) (Fin.init (Fin.init b))
      * M (Fin.init a (Fin.last m), a (Fin.last (m + 1)))
          (Fin.init b (Fin.last m), b (Fin.last (m + 1))) := rfl

theorem tens_mul (X X' : Matrix (St m) (St m) R) (Y Y' : Matrix (Fin 2) (Fin 2) R) :
    tens X Y * tens X' Y' = tens (X * X') (Y * Y') := by
  rw [tens, tens, submatrix_mul_equiv, ← mul_kronecker_mul]; rfl

theorem tens2_mul (X X' : Matrix (St m) (St m) R) (M M' : Matrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) R) :
    tens2 X M * tens2 X' M' = tens2 (X * X') (M * M') := by
  rw [tens2, tens2, submatrix_mul_equiv, ← mul_kronecker_mul]; rfl

theorem tens_add_left (X X' : Matrix (St m) (St m) R) (Y : Matrix (Fin 2) (Fin 2) R) :
    tens (X + X') Y = tens X Y + tens X' Y := by
  ext a b; simp [tens_apply, add_mul]

theorem tens_add_right (X : Matrix (St m) (St m) R) (Y Y' : Matrix (Fin 2) (Fin 2) R) :
    tens X (Y + Y') = tens X Y + tens X Y' := by
  ext a b; simp [tens_apply, mul_add]

theorem tens_sub_left (X X' : Matrix (St m) (St m) R) (Y : Matrix (Fin 2) (Fin 2) R) :
    tens (X - X') Y = tens X Y - tens X' Y := by
  ext a b; simp [tens_apply, sub_mul]

theorem tens_sub_right (X : Matrix (St m) (St m) R) (Y Y' : Matrix (Fin 2) (Fin 2) R) :
    tens X (Y - Y') = tens X Y - tens X Y' := by
  ext a b; simp [tens_apply, mul_sub]

theorem tens_smul_left (c : R) (X : Matrix (St m) (St m) R) (Y : Matrix (Fin 2) (Fin 2) R) :
    tens (c • X) Y = c • tens X Y := by
  ext a b; simp [tens_apply, mul_assoc]

theorem tens_smul_right (c : R) (X : Matrix (St m) (St m) R) (Y : Matrix (Fin 2) (Fin 2) R) :
    tens X (c • Y) = c • tens X Y := by
  ext a b; simp [tens_apply]; ring

theorem tens_zero_left (Y : Matrix (Fin 2) (Fin 2) R) : tens (0 : Matrix (St m) (St m) R) Y = 0 := by
  ext a b; simp [tens_apply]

theorem tens_one_one : tens (1 : Matrix (St m) (St m) R) (1 : Matrix (Fin 2) (Fin 2) R) = 1 := by
  rw [tens, one_kronecker_one, submatrix_one_equiv]

theorem tens2_add_right (X : Matrix (St m) (St m) R) (M M' : Matrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) R) :
    tens2 X (M + M') = tens2 X M + tens2 X M' := by
  ext a b; simp [tens2_apply, mul_add]

theorem tens2_add_left (X X' : Matrix (St m) (St m) R) (M : Matrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) R) :
    tens2 (X + X') M = tens2 X M + tens2 X' M := by
  ext a b; simp [tens2_apply, add_mul]

theorem tens_tens (X : Matrix (St m) (St m) R) (A B : Matrix (Fin 2) (Fin 2) R) :
    tens (tens X A) B = tens2 X (A ⊗ₖ B) := by
  ext a b; simp only [tens_apply, tens2_apply, kronecker_apply]; ring

theorem tens2_commute {X : Matrix (St m) (St m) R} {M M' : Matrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) R}
    (h : Commute M M') : Commute (tens2 1 M) (tens2 X M') := by
  show tens2 1 M * tens2 X M' = tens2 X M' * tens2 1 M
  rw [tens2_mul, tens2_mul, one_mul, mul_one, h.eq]

theorem tens_commute {X X' : Matrix (St m) (St m) R} (Y : Matrix (Fin 2) (Fin 2) R)
    (h : Commute X X') : Commute (tens X 1) (tens X' Y) := by
  show tens X 1 * tens X' Y = tens X' Y * tens X 1
  rw [tens_mul, tens_mul, one_mul, mul_one, h.eq]

end Tens

/-! ## The generators of `U_q(sl₂)` on one site -/

/-- `e : e₀ ↦ e₁`. -/
def e1 : Matrix (Fin 2) (Fin 2) R := !![0, 0; 1, 0]

/-- `f : e₁ ↦ (q − q⁻¹) e₀`. -/
noncomputable def f1 (q : R) : Matrix (Fin 2) (Fin 2) R := !![0, q - q⁻¹; 0, 0]

/-- `k = diag(q⁻¹, q)`. -/
noncomputable def k1 (q : R) : Matrix (Fin 2) (Fin 2) R := !![q⁻¹, 0; 0, q]

/-- `k⁻¹ = diag(q, q⁻¹)`. -/
noncomputable def ki1 (q : R) : Matrix (Fin 2) (Fin 2) R := !![q, 0; 0, q⁻¹]

/-! ## The coproduct: `E, F, K, K⁻¹` on `V^{⊗n}` -/

/-- `E_{n+1} = E_n ⊗ k + 1 ⊗ e`. -/
noncomputable def E (q : R) : (n : ℕ) → Matrix (St n) (St n) R
  | 0 => 0
  | n + 1 => tens (E q n) (k1 q) + tens 1 e1

/-- `K_{n+1} = K_n ⊗ k`. -/
noncomputable def K (q : R) : (n : ℕ) → Matrix (St n) (St n) R
  | 0 => 1
  | n + 1 => tens (K q n) (k1 q)

/-- `K⁻¹_{n+1} = K⁻¹_n ⊗ k⁻¹`. -/
noncomputable def Ki (q : R) : (n : ℕ) → Matrix (St n) (St n) R
  | 0 => 1
  | n + 1 => tens (Ki q n) (ki1 q)

/-- `F_{n+1} = F_n ⊗ 1 + K⁻¹_n ⊗ f`. -/
noncomputable def F (q : R) : (n : ℕ) → Matrix (St n) (St n) R
  | 0 => 0
  | n + 1 => tens (F q n) 1 + tens (Ki q n) (f1 q)

variable {q : R}

/-! ## One-site identities -/

section OneSite

variable (hq : q ≠ 0)
include hq

theorem k1_mul_ki1 : k1 q * ki1 q = 1 := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [k1, ki1, Matrix.mul_apply, Fin.sum_univ_two, hq]

theorem ki1_mul_k1 : ki1 q * k1 q = 1 := by
  ext i j; fin_cases i <;> fin_cases j <;> simp [k1, ki1, Matrix.mul_apply, Fin.sum_univ_two, hq]

theorem k1_mul_e1 : k1 q * e1 = q ^ 2 • (e1 * k1 q) := by
  ext i j; fin_cases i <;> fin_cases j <;>
    simp [k1, e1, Matrix.mul_apply, Fin.sum_univ_two] <;> field_simp

theorem ki1_mul_e1 : ki1 q * e1 = (q ^ 2)⁻¹ • (e1 * ki1 q) := by
  ext i j; fin_cases i <;> fin_cases j <;>
    simp [ki1, e1, Matrix.mul_apply, Fin.sum_univ_two] <;> field_simp

theorem f1_mul_k1 : f1 q * k1 q = q ^ 2 • (k1 q * f1 q) := by
  ext i j; fin_cases i <;> fin_cases j <;>
    simp [k1, f1, Matrix.mul_apply, Fin.sum_univ_two] <;> field_simp <;> ring

end OneSite

/-! ## The `U_q(sl₂)` relations on `V^{⊗n}` -/

theorem K_mul_Ki (hq : q ≠ 0) : ∀ n, K q n * Ki q n = 1
  | 0 => by simp [K, Ki]
  | n + 1 => by rw [K, Ki, tens_mul, K_mul_Ki hq n, k1_mul_ki1 hq, tens_one_one]

theorem Ki_mul_K (hq : q ≠ 0) : ∀ n, Ki q n * K q n = 1
  | 0 => by simp [K, Ki]
  | n + 1 => by rw [K, Ki, tens_mul, Ki_mul_K hq n, ki1_mul_k1 hq, tens_one_one]

theorem K_mul_E (hq : q ≠ 0) : ∀ n, K q n * E q n = q ^ 2 • (E q n * K q n)
  | 0 => by simp [K, E]
  | n + 1 => by
    simp only [K, E, mul_add, add_mul, tens_mul, one_mul, mul_one]
    rw [K_mul_E hq n, k1_mul_e1 hq, tens_smul_left, tens_smul_right, smul_add]

theorem Ki_mul_E (hq : q ≠ 0) : ∀ n, Ki q n * E q n = (q ^ 2)⁻¹ • (E q n * Ki q n)
  | 0 => by simp [Ki, E]
  | n + 1 => by
    simp only [Ki, E, mul_add, add_mul, tens_mul, one_mul, mul_one]
    rw [Ki_mul_E hq n, ki1_mul_e1 hq, tens_smul_left, tens_smul_right, smul_add,
      ki1_mul_k1 hq, k1_mul_ki1 hq]

/-! ## The two-site picture of the last strand -/

private theorem comm4 {M N : Matrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) R}
    (h : ∀ a b, (M * N) a b = (N * M) a b) : Commute M N := by
  show M * N = N * M; ext a b; exact h a b

section TwoSite

variable (hq : q ≠ 0)
include hq

theorem rCheck_comm_kk : Commute (rCheck q q⁻¹) (k1 q ⊗ₖ k1 q) := by
  refine comm4 fun ⟨a1, a2⟩ ⟨b1, b2⟩ => ?_
  fin_cases a1 <;> fin_cases a2 <;> fin_cases b1 <;> fin_cases b2 <;>
    simp [Matrix.mul_apply, Fintype.sum_prod_type, Fin.sum_univ_two, k1] <;> ring

theorem rCheck_comm_kiki : Commute (rCheck q q⁻¹) (ki1 q ⊗ₖ ki1 q) := by
  refine comm4 fun ⟨a1, a2⟩ ⟨b1, b2⟩ => ?_
  fin_cases a1 <;> fin_cases a2 <;> fin_cases b1 <;> fin_cases b2 <;>
    simp [Matrix.mul_apply, Fintype.sum_prod_type, Fin.sum_univ_two, ki1] <;> ring

theorem rCheck_comm_E2 : Commute (rCheck q q⁻¹) (e1 ⊗ₖ k1 q + 1 ⊗ₖ e1) := by
  refine comm4 fun ⟨a1, a2⟩ ⟨b1, b2⟩ => ?_
  fin_cases a1 <;> fin_cases a2 <;> fin_cases b1 <;> fin_cases b2 <;>
    simp [Matrix.mul_apply, Fintype.sum_prod_type, Fin.sum_univ_two, k1, e1, Matrix.one_apply] <;>
    field_simp <;> ring

theorem rCheck_comm_F2 : Commute (rCheck q q⁻¹) (f1 q ⊗ₖ 1 + ki1 q ⊗ₖ f1 q) := by
  refine comm4 fun ⟨a1, a2⟩ ⟨b1, b2⟩ => ?_
  fin_cases a1 <;> fin_cases a2 <;> fin_cases b1 <;> fin_cases b2 <;>
    simp [Matrix.mul_apply, Fintype.sum_prod_type, Fin.sum_univ_two, ki1, f1, Matrix.one_apply] <;>
    field_simp <;> ring

end TwoSite

theorem E_succ (q : R) (n : ℕ) : E q (n + 1) = tens (E q n) (k1 q) + tens 1 e1 := rfl
theorem F_succ (q : R) (n : ℕ) : F q (n + 1) = tens (F q n) 1 + tens (Ki q n) (f1 q) := rfl
theorem K_succ (q : R) (n : ℕ) : K q (n + 1) = tens (K q n) (k1 q) := rfl
theorem Ki_succ (q : R) (n : ℕ) : Ki q (n + 1) = tens (Ki q n) (ki1 q) := rfl

theorem E_two (q : R) (N : ℕ) :
    E q (N + 1 + 1) = tens2 (E q N) (k1 q ⊗ₖ k1 q) + tens2 1 (e1 ⊗ₖ k1 q + 1 ⊗ₖ e1) := by
  rw [E_succ, E_succ, tens_add_left, tens_tens, tens_tens, ← tens_one_one (R := R) (m := N),
    tens_tens, tens2_add_right]
  exact add_assoc _ _ _

theorem F_two (q : R) (N : ℕ) :
    F q (N + 1 + 1) = tens2 (F q N) 1 + tens2 (Ki q N) (f1 q ⊗ₖ 1 + ki1 q ⊗ₖ f1 q) := by
  rw [F_succ, F_succ, Ki_succ, tens_add_left, tens_tens, tens_tens, tens_tens, one_kronecker_one,
    tens2_add_right]
  exact add_assoc _ _ _

theorem K_two (q : R) (N : ℕ) : K q (N + 1 + 1) = tens2 (K q N) (k1 q ⊗ₖ k1 q) := by
  rw [K_succ, K_succ, tens_tens]

theorem Ki_two (q : R) (N : ℕ) : Ki q (N + 1 + 1) = tens2 (Ki q N) (ki1 q ⊗ₖ ki1 q) := by
  rw [Ki_succ, Ki_succ, tens_tens]

/-! ## The strand braidings in the Kronecker picture -/

theorem S_zero (q : R) (i : ℕ) : S q 0 i = 0 := by simp [S]

theorem S_of_ge (q : R) {N i : ℕ} (h : N ≤ i) : S q N i = 0 := by
  simp [S, not_lt.mpr h]

/-- A strand braiding not touching the last site is `σ ⊗ 1`. -/
theorem S_succ_lt (q : R) {N i : ℕ} (hi : i < N) : S q (N + 1) i = tens (S q N i) 1 := by
  rw [← extend_S q hi]
  ext a b
  rw [extendSiteHom_apply, tens_apply, Matrix.one_apply, mul_comm]
  rfl

/-- The last strand braiding is `1 ⊗ Ř` on the last two sites. -/
theorem S_last (q : R) (N : ℕ) : S q (N + 1) N = tens2 1 (rCheck q q⁻¹) := by
  classical
  ext a b
  rw [S_of_lt q (Nat.lt_succ_self N), strandBraid, braidAt, embedPair_apply, tens2_apply,
    Matrix.one_apply]
  have hI : ((⟨N, Nat.lt_succ_self N⟩ : Fin (N + 1)).castSucc : Fin (N + 2))
      = (Fin.last N).castSucc := rfl
  have hJ : ((⟨N, Nat.lt_succ_self N⟩ : Fin (N + 1)).succ : Fin (N + 2)) = Fin.last (N + 1) := by
    ext; simp
  rw [hI, hJ]
  have hoff : (∀ k : Fin (N + 2), k ≠ (Fin.last N).castSucc → k ≠ Fin.last (N + 1) → a k = b k)
      ↔ Fin.init (Fin.init a) = Fin.init (Fin.init b) := by
    constructor
    · intro h
      funext i
      exact h (i.castSucc.castSucc) (by simp [Fin.ext_iff]; omega) (by simp [Fin.ext_iff]; omega)
    · intro h k hk1 hk2
      induction k using Fin.lastCases with
      | last => exact absurd rfl hk2
      | cast k =>
        induction k using Fin.lastCases with
        | last => exact absurd rfl hk1
        | cast i => exact congrFun h i
  by_cases h : Fin.init (Fin.init a) = Fin.init (Fin.init b)
  · rw [if_pos (hoff.mpr h), if_pos h, one_mul]; rfl
  · rw [if_neg (fun h' => h (hoff.mp h')), if_neg h, zero_mul]

/-! ## The strand braidings commute with `E`, `F`, `K`, `K⁻¹` -/

theorem S_comm_K (hq : q ≠ 0) : ∀ N i, Commute (S q N i) (K q (N + 1))
  | 0, i => by rw [S_zero]; exact Commute.zero_left _
  | N + 1, i => by
    rcases lt_trichotomy i N with h | rfl | h
    · rw [S_succ_lt q h, K_succ]; exact tens_commute _ (S_comm_K hq N i)
    · rw [S_last, K_two]; exact tens2_commute (rCheck_comm_kk hq)
    · rw [S_of_ge q (by omega)]; exact Commute.zero_left _

theorem S_comm_Ki (hq : q ≠ 0) : ∀ N i, Commute (S q N i) (Ki q (N + 1))
  | 0, i => by rw [S_zero]; exact Commute.zero_left _
  | N + 1, i => by
    rcases lt_trichotomy i N with h | rfl | h
    · rw [S_succ_lt q h, Ki_succ]; exact tens_commute _ (S_comm_Ki hq N i)
    · rw [S_last, Ki_two]; exact tens2_commute (rCheck_comm_kiki hq)
    · rw [S_of_ge q (by omega)]; exact Commute.zero_left _

/-- **The strand braidings commute with `E`** on `V^{⊗(N+1)}`, for every `N` and every strand. -/
theorem S_comm_E (hq : q ≠ 0) : ∀ N i, Commute (S q N i) (E q (N + 1))
  | 0, i => by rw [S_zero]; exact Commute.zero_left _
  | N + 1, i => by
    rcases lt_trichotomy i N with h | rfl | h
    · rw [S_succ_lt q h, E_succ]
      exact (tens_commute _ (S_comm_E hq N i)).add_right (tens_commute _ (Commute.one_right _))
    · rw [S_last, E_two]
      exact (tens2_commute (rCheck_comm_kk hq)).add_right (tens2_commute (rCheck_comm_E2 hq))
    · rw [S_of_ge q (by omega)]; exact Commute.zero_left _

/-- **The strand braidings commute with `F`** on `V^{⊗(N+1)}`, for every `N` and every strand. -/
theorem S_comm_F (hq : q ≠ 0) : ∀ N i, Commute (S q N i) (F q (N + 1))
  | 0, i => by rw [S_zero]; exact Commute.zero_left _
  | N + 1, i => by
    rcases lt_trichotomy i N with h | rfl | h
    · rw [S_succ_lt q h, F_succ]
      exact (tens_commute _ (S_comm_F hq N i)).add_right (tens_commute _ (S_comm_Ki hq N i))
    · rw [S_last, F_two]
      exact (tens2_commute (Commute.one_right _)).add_right (tens2_commute (rCheck_comm_F2 hq))
    · rw [S_of_ge q (by omega)]; exact Commute.zero_left _

/-! ## Weights

`ones a` (from `RossoJonesGeneral`) is the number of `1`s in the state `a`. A matrix is
*graded of degree `d`* when it only moves a state with `w` ones to states with `w + d` ones. -/

theorem ones_snoc_val {n : ℕ} (a : St (n + 1)) :
    ones a = ones (Fin.init a) + (a (Fin.last n)).val := by
  unfold ones
  rw [Finset.card_filter, Finset.card_filter, Fin.sum_univ_castSucc]
  congr 1
  rcases Fin.exists_fin_two.mp ⟨a (Fin.last n), rfl⟩ with h | h <;> simp [h]

theorem ext_init {n : ℕ} {a b : St (n + 1)} (h1 : Fin.init a = Fin.init b)
    (h2 : a (Fin.last n) = b (Fin.last n)) : a = b := by
  rw [← Fin.snoc_init_self a, ← Fin.snoc_init_self b, h1, h2]

/-- `X` raises the number of ones by exactly `d`. -/
def Gr {n : ℕ} (d : ℤ) (X : Matrix (St n) (St n) R) : Prop :=
  ∀ a b, X a b ≠ 0 → (ones a : ℤ) = ones b + d

/-- One-site version of `Gr`. -/
def Gr1 (d : ℤ) (Y : Matrix (Fin 2) (Fin 2) R) : Prop :=
  ∀ x y, Y x y ≠ 0 → (x.val : ℤ) = y.val + d

/-- Two-site version of `Gr`. -/
def Gr2 (d : ℤ) (M : Matrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) R) : Prop :=
  ∀ x y, M x y ≠ 0 → ((x.1.val + x.2.val : ℕ) : ℤ) = ((y.1.val + y.2.val : ℕ) : ℤ) + d

section Graded

variable {n : ℕ} {d d' : ℤ} {X Y : Matrix (St n) (St n) R}

theorem Gr.add (hX : Gr d X) (hY : Gr d Y) : Gr d (X + Y) := by
  intro a b h
  by_cases hx : X a b = 0
  · exact hY a b (by simpa [hx] using h)
  · exact hX a b hx

theorem Gr.neg (hX : Gr d X) : Gr d (-X) := fun a b h => hX a b (by simpa using h)

theorem Gr.sub (hX : Gr d X) (hY : Gr d Y) : Gr d (X - Y) := by
  rw [sub_eq_add_neg]; exact hX.add hY.neg

theorem Gr.smul (c : R) (hX : Gr d X) : Gr d (c • X) := fun a b h =>
  hX a b (fun h' => h (by simp [h']))

theorem Gr.zero : Gr d (0 : Matrix (St n) (St n) R) := fun _ _ h => absurd rfl h

theorem Gr.one : Gr 0 (1 : Matrix (St n) (St n) R) := by
  intro a b h
  rw [Matrix.one_apply] at h
  split_ifs at h with hab
  · rw [hab]; ring
  · exact absurd rfl h

theorem Gr.mul (hX : Gr d X) (hY : Gr d' Y) : Gr (d + d') (X * Y) := by
  intro a b h
  rw [Matrix.mul_apply] at h
  obtain ⟨v, -, hv⟩ := Finset.exists_ne_zero_of_sum_ne_zero h
  rw [hX a v (left_ne_zero_of_mul hv), hY v b (right_ne_zero_of_mul hv)]; ring

theorem Gr.tens {m : ℕ} {X : Matrix (St m) (St m) R} {Y : Matrix (Fin 2) (Fin 2) R} {d'' : ℤ}
    (hX : Gr d X) (hY : Gr1 d' Y) (h : d + d' = d'') : Gr d'' (tens X Y) := by
  intro a b hab
  rw [tens_apply] at hab
  rw [ones_snoc_val a, ones_snoc_val b, ← h]
  have h1 := hX _ _ (left_ne_zero_of_mul hab)
  have h2 := hY _ _ (right_ne_zero_of_mul hab)
  push_cast; rw [h1, h2]; ring

theorem ones_two {m : ℕ} (a : St (m + 2)) :
    ones a = ones (Fin.init (Fin.init a))
      + ((Fin.init a (Fin.last m)).val + (a (Fin.last (m + 1))).val) := by
  rw [ones_snoc_val a, ones_snoc_val (Fin.init a)]; ring

theorem Gr.tens2 {m : ℕ} {X : Matrix (St m) (St m) R}
    {M : Matrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) R}
    {d'' : ℤ} (hX : Gr d X) (hM : Gr2 d' M) (h : d + d' = d'') : Gr d'' (tens2 X M) := by
  intro a b hab
  rw [tens2_apply] at hab
  rw [ones_two a, ones_two b, ← h]
  have h1 := hX _ _ (left_ne_zero_of_mul hab)
  have h2 := hM _ _ (right_ne_zero_of_mul hab)
  simp only at h2
  push_cast at h2 ⊢; rw [h1, h2]; ring

end Graded

theorem gr1_e1 : Gr1 1 (e1 : Matrix (Fin 2) (Fin 2) R) := by
  intro x y h; fin_cases x <;> fin_cases y <;> simp [e1] at h ⊢

theorem gr1_f1 : Gr1 (-1) (f1 q) := by
  intro x y h; fin_cases x <;> fin_cases y <;> simp [f1] at h ⊢

theorem gr1_k1 : Gr1 0 (k1 q) := by
  intro x y h; fin_cases x <;> fin_cases y <;> simp [k1] at h ⊢

theorem gr1_ki1 : Gr1 0 (ki1 q) := by
  intro x y h; fin_cases x <;> fin_cases y <;> simp [ki1] at h ⊢

theorem gr1_one : Gr1 0 (1 : Matrix (Fin 2) (Fin 2) R) := by
  intro x y h; fin_cases x <;> fin_cases y <;> simp at h ⊢

theorem gr2_rCheck : Gr2 0 (rCheck q q⁻¹) := by
  rintro ⟨a1, a2⟩ ⟨b1, b2⟩ h
  fin_cases a1 <;> fin_cases a2 <;> fin_cases b1 <;> fin_cases b2 <;> simp at h ⊢

theorem gr_E (q : R) : ∀ n, Gr 1 (E q n)
  | 0 => Gr.zero
  | n + 1 => (Gr.tens (gr_E q n) gr1_k1 (by ring)).add (Gr.tens Gr.one gr1_e1 (by ring))

theorem gr_Ki (q : R) : ∀ n, Gr 0 (Ki q n)
  | 0 => Gr.one
  | n + 1 => Gr.tens (gr_Ki q n) gr1_ki1 (by ring)

theorem gr_K (q : R) : ∀ n, Gr 0 (K q n)
  | 0 => Gr.one
  | n + 1 => Gr.tens (gr_K q n) gr1_k1 (by ring)

theorem gr_F (q : R) : ∀ n, Gr (-1) (F q n)
  | 0 => Gr.zero
  | n + 1 => (Gr.tens (gr_F q n) gr1_one (by ring)).add (Gr.tens (gr_Ki q n) gr1_f1 (by ring))

theorem gr_S (q : R) : ∀ N i, Gr 0 (S q N i)
  | 0, i => by rw [S_zero]; exact Gr.zero
  | N + 1, i => by
    rcases lt_trichotomy i N with h | rfl | h
    · rw [S_succ_lt q h]; exact Gr.tens (gr_S q N i) gr1_one (by ring)
    · rw [S_last]; exact Gr.tens2 Gr.one gr2_rCheck (by ring)
    · rw [S_of_ge q (by omega)]; exact Gr.zero

theorem Gr.congr_deg {n : ℕ} {d d' : ℤ} {X : Matrix (St n) (St n) R} (hX : Gr d X) (h : d = d') :
    Gr d' X := h ▸ hX

/-! ## The braid algebra commutes with `E`, `F` and preserves weight -/

/-- The subalgebra of `End(V^{⊗(N+1)})` generated by the strand braidings. -/
noncomputable def braidAlg (q : R) (N : ℕ) : Subalgebra R (Matrix (St (N + 1)) (St (N + 1)) R) :=
  Algebra.adjoin R (Set.range (S q N))

/-- **Every element of the braid algebra commutes with `E` and `F` and preserves weight.** -/
theorem braidAlg_spec (hq : q ≠ 0) {N : ℕ} {X : Matrix (St (N + 1)) (St (N + 1)) R}
    (hX : X ∈ braidAlg q N) :
    Commute X (E q (N + 1)) ∧ Commute X (F q (N + 1)) ∧ Gr 0 X := by
  induction hX using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨i, rfl⟩ := hx
    exact ⟨S_comm_E hq N i, S_comm_F hq N i, gr_S q N i⟩
  | algebraMap r =>
    refine ⟨Algebra.commutes r _, Algebra.commutes r _, ?_⟩
    rw [Algebra.algebraMap_eq_smul_one]; exact Gr.one.smul r
  | add x y _ _ hx hy => exact ⟨hx.1.add_left hy.1, hx.2.1.add_left hy.2.1, hx.2.2.add hy.2.2⟩
  | mul x y _ _ hx hy =>
    exact ⟨hx.1.mul_left hy.1, hx.2.1.mul_left hy.2.1, (hx.2.2.mul hy.2.2).congr_deg (by ring)⟩


/-! ## The coproduct `E` is the raising operator `Em` of `RossoJonesMiddle` -/

/-- One step of the coproduct, entrywise: splitting off the last site of `Em`. -/
theorem Em_snoc_snoc (q : R) {n : ℕ} (c' c : Fin (n + 1) → Fin 2) (y x : Fin 2) :
    Em q (n + 1) (Fin.snoc c' y) (Fin.snoc c x)
      = Em q n c' c * k1 q y x + (1 : Matrix (St (n + 1)) (St (n + 1)) R) c' c * e1 y x := by
  rw [QOU.Archimedean.SchurWeylTrace.Em_apply', QOU.Archimedean.SchurWeylTrace.Em_apply',
    Fin.sum_univ_castSucc, Finset.sum_mul]
  congr 1
  · refine Finset.sum_congr rfl fun k _ => ?_
    simp only [Fin.snoc_castSucc, ← Fin.snoc_update, Fin.snoc_inj,
      QOU.Archimedean.SchurWeylTrace.phiN_castSucc]
    by_cases hk : c k = 0
    · by_cases ha : c' = Function.update c k 1
      · by_cases hyx : y = x
        · subst hyx; fin_cases y <;> simp [hk, ha, k1, ki]
        · fin_cases y <;> fin_cases x <;> simp_all [k1]
      · simp [hk, ha]
    · simp [hk]
  · simp only [Fin.snoc_last, Fin.update_snoc_last, Fin.snoc_inj,
      QOU.Archimedean.SchurWeylTrace.phiN_last, Matrix.one_apply]
    fin_cases y <;> fin_cases x <;> by_cases h : c' = c <;> simp [h, e1]

/-- **The coproduct raising operator is `Em`**: `E_{n+1} = Em_n` on `V^{⊗(n+1)}`. -/
theorem E_eq_Em (q : R) : ∀ n, E q (n + 1) = Em q n
  | 0 => by
    ext a b
    rw [E_succ, Matrix.add_apply, tens_apply, tens_apply, QOU.Archimedean.SchurWeylTrace.Em_apply',
      Fin.sum_univ_one]
    simp only [E, Matrix.zero_apply, zero_mul, zero_add]
    rw [show Fin.init a = Fin.init b from Subsingleton.elim _ _, Matrix.one_apply_eq, one_mul]
    obtain ⟨y, rfl⟩ : ∃ y, a = fun _ => y := ⟨a 0, funext fun i => by rw [Fin.fin_one_eq_zero i]⟩
    obtain ⟨x, rfl⟩ : ∃ x, b = fun _ => x := ⟨b 0, funext fun i => by rw [Fin.fin_one_eq_zero i]⟩
    fin_cases y <;> fin_cases x <;>
      simp [e1, QOU.Archimedean.SchurWeylTrace.phiN, funext_iff, Fin.forall_fin_one]
  | n + 1 => by
    ext a b
    have h := Em_snoc_snoc q (Fin.init a) (Fin.init b) (a (Fin.last _)) (b (Fin.last _))
    rw [Fin.snoc_init_self, Fin.snoc_init_self] at h
    rw [h, E_succ, Matrix.add_apply, tens_apply, tens_apply, E_eq_Em q n]

/-! ## Schur–Weyl for the whole braid algebra -/

theorem Gr.wp {n : ℕ} {X : Matrix (St (n + 1)) (St (n + 1)) R} (hX : Gr 0 X) :
    QOU.Archimedean.SchurWeylTrace.WP X := fun a b h => by
  have := hX a b h; push_cast at this; omega

/-- Every element of the braid algebra is weight-preserving. -/
theorem braidAlg_wp (hq : q ≠ 0) {N : ℕ} {X : Matrix (St (N + 1)) (St (N + 1)) R}
    (hX : X ∈ braidAlg q N) : QOU.Archimedean.SchurWeylTrace.WP X :=
  (braidAlg_spec hq hX).2.2.wp

/-- **Every element of the braid algebra commutes with `Em`.** -/
theorem braidAlg_comm_Em (hq : q ≠ 0) {N : ℕ} {X : Matrix (St (N + 1)) (St (N + 1)) R}
    (hX : X ∈ braidAlg q N) : X * Em q N = Em q N * X := by
  rw [← E_eq_Em]; exact (braidAlg_spec hq hX).1.eq

/-- **The quantum trace over the standard modules**, for every weight-preserving `X`
commuting with `E` (`r = n + 1`, `[k]_q ≠ 0` for `1 ≤ k ≤ r`):
`tr(W X) = Σ_{2j ≤ r} (Σ_{m=j}^{r−j} q^{2m}) · tr(X | W_{r,j})`. -/
theorem trace_W_split (hq : q ≠ 0) {n : ℕ}
    (hqn : QOU.Archimedean.SchurWeylTrace.QIntNonzero q (n + 1))
    {X : Matrix (St (n + 1)) (St (n + 1)) R} (hX : QOU.Archimedean.SchurWeylTrace.WP X)
    (hc : X * Em q n = Em q n * X) :
    Matrix.trace (W q (n + 1) * X)
      = ∑ j ∈ Finset.range ((n + 1) / 2 + 1),
          (∑ m ∈ Finset.Icc j (n + 1 - j), (q ^ 2) ^ m) *
            QOU.Archimedean.SchurWeylTrace.trK q X hX hc (n + 1 - j) := by
  rw [trace_W_eq_sum_T]
  rw [Finset.sum_congr rfl fun m hm => by
    rw [QOU.Archimedean.SchurWeylTrace.T_eq_trace_blk,
      QOU.Archimedean.SchurWeylTrace.trace_split hq hqn hX hc m
        (by simpa [Nat.lt_succ_iff] using hm), Finset.mul_sum]]
  simp only [Finset.sum_mul]
  refine Finset.sum_comm' fun m j => ?_
  simp only [Finset.mem_range, Finset.mem_Icc, Nat.lt_succ_iff, le_min_iff]
  omega

/-- **Schur–Weyl for the braid algebra, weight-space form.** For every `X` in the algebra
generated by the strand braidings, `tr(X | V_m) = Σ_{j ≤ min(m, r − m)} tr(X | W_{r,j})`. -/
theorem braidAlg_trace_split (hq : q ≠ 0) {N : ℕ}
    (hqn : QOU.Archimedean.SchurWeylTrace.QIntNonzero q (N + 1))
    {X : Matrix (St (N + 1)) (St (N + 1)) R} (hX : X ∈ braidAlg q N) (m : ℕ) (hm : m ≤ N + 1) :
    T X m = ∑ j ∈ Finset.range (min m (N + 1 - m) + 1),
      QOU.Archimedean.SchurWeylTrace.trK q X (braidAlg_wp hq hX) (braidAlg_comm_Em hq hX)
        (N + 1 - j) := by
  rw [QOU.Archimedean.SchurWeylTrace.T_eq_trace_blk]
  exact QOU.Archimedean.SchurWeylTrace.trace_split hq hqn _ _ m hm

/-- **Schur–Weyl for the braid algebra, quantum-trace form.** For every `X` in the algebra
generated by the strand braidings,
`tr(W X) = Σ_{2j ≤ r} (Σ_{m=j}^{r−j} q^{2m}) · tr(X | W_{r,j})`. -/
theorem braidAlg_trace_W_split (hq : q ≠ 0) {N : ℕ}
    (hqn : QOU.Archimedean.SchurWeylTrace.QIntNonzero q (N + 1))
    {X : Matrix (St (N + 1)) (St (N + 1)) R} (hX : X ∈ braidAlg q N) :
    Matrix.trace (W q (N + 1) * X)
      = ∑ j ∈ Finset.range ((N + 1) / 2 + 1),
          (∑ m ∈ Finset.Icc j (N + 1 - j), (q ^ 2) ^ m) *
            QOU.Archimedean.SchurWeylTrace.trK q X (braidAlg_wp hq hX) (braidAlg_comm_Em hq hX)
              (N + 1 - j) :=
  trace_W_split hq hqn _ _

end QOU.IwahoriHecke.TensorSchurWeyl
