import QOU.IwahoriHecke.MarkovNormalized
import QOU.IwahoriHecke.NegativePeel
import QOU.IwahoriHecke.MarkovTransfer

/-!
# QOU.IwahoriHecke.TensorMarkovModel — a Markov trace with `z_D` at every level

`QOU.IwahoriHecke.MarkovTransfer` reduced the Rosso–Jones value `t(γ_r^s)` to a computation
in **one** algebra that carries a Hecke family and a Markov trace with `z = z_D`. The
`r = 4` case (`QOU.Archimedean.RossoJonesH4`) built such an algebra by hand. This file
builds one for **every** number of strands, uniformly, from the `sl₂` R-matrix
representation already in the tree:

* `V^{⊗(N+1)}`, `V = R²`, with `σ_i` acting as Jimbo's `Ř` on sites `i, i+1`
  (`QOU.IwahoriHecke.TensorEmbed.strandBraid`);
* the quantum trace `tr(W · x)`, `W = diag(∏ₘ w(aₘ))`, `w = (1, q²)`
  (`QOU.IwahoriHecke.QuantumTrace.siteWeight`), normalised by `(1 + q²)^{N+1}`.

## What is proved (sorry-free, over any field `R`, `q ≠ 0`, `q² + 1 ≠ 0`)

* `strand_heckeFamily` — the strand braidings `S q N i` form a `HeckeFamily N (q − q⁻¹) 1`
  in `Matrix (Fin (N+1) → Fin 2)`, for every `N`.
* `trace_markov` — **the Markov property at every level, not only the top one.** For every
  `k < N` and every `X` in the subalgebra generated by `S₀, …, S_{k−1}`:

      tr(W · X · S_k) = z_D · tr(W · X),   z_D = q³ / (q² + 1).

  `QOU.IwahoriHecke.MarkovPeel` proved the top-level peel `k = N − 1` for `X` in the image of
  the tower; the general level is an induction on `N` along the site extension
  `X ↦ X ⊗ 1` (`extendSiteHom`), using `trace_extendSite` and `trace_peel`.
* `model` — the subalgebra `A_N` (centraliser of `W`) with the Hecke family `sA q N` and the
  normalised trace `tau q N`; `tau_one`, `tau_cyc` (cyclic on all of `A_N`), `tau_markov`.
* `presTrace` — pulled back along `MarkovTransfer.lift`, a normalised, cyclic Markov trace with
  `z = z_D` on the **presented** Hecke algebra `Pres N (q − q⁻¹) 1`, for every `N`
  (`presTrace_one`, `presTrace_cyc`, `presTrace_markov`). This is the existence half
  (Ocneanu's trace) that `JonesNormalForm.markov_unique` lacked a partner for.
* `markov_cox_eq_quantumTrace` — **for every Hecke-family algebra and every Markov trace
  with `z = z_D`, the trace of the torus braid `γ_{n+1}^p` is the normalised quantum trace of
  `γ^p` on `V^{⊗(n+1)}`**:

      t((s₀ ⋯ s_{n−1})^p) = (1 + q²)^{−(n+1)} · tr(W · (S₀ ⋯ S_{n−1})^p),

  with the right-hand side at `n + 1` sites whatever the ambient `N ≥ n` is
  (`quantumTrace_cox_level`).

## What it does NOT prove

* The closed form of `tr(W · γ^p)` on `V^{⊗r}`. The right-hand side above is a finite sum
  over `2^r` basis states, but its value for general `r` (the Rosso–Jones formula
  `[r+1] q^{s(r−1)} − [r−1] q^{s(r−3)}` for `gcd(r, s) = 1`) needs the eigenvalue structure of
  `γ` on the irreducible summands, which is not formalised here. See
  `QOU.Archimedean.RossoJonesGeneral` for the reduction to weight spaces.
* That this trace equals `Σ_j [j+1] tr_{W_{r,j}} / [2]^r` on the Temperley–Lieb standard
  modules. That is quantum Schur–Weyl duality for `V^{⊗r}`; not proved.

-- Ref: [jones1987] Jones, *Hecke algebra representations of braid groups and link
--   polynomials*, Ann. of Math. 126 (1987)
-- Ref: [jimbo1986] Jimbo, *A q-difference analogue of U(g) and the Yang–Baxter equation*
-/

namespace QOU.IwahoriHecke.TensorMarkovModel

open QOU.IwahoriHecke.TensorEmbed QOU.IwahoriHecke.RMatrix QOU.IwahoriHecke.QuantumTrace
open QOU.IwahoriHecke.MarkovPeel QOU.IwahoriHecke.NegativePeel
open QOU.IwahoriHecke.JonesNormalForm QOU.MathlibExt.SkeinRelation

variable {R : Type*} [Field R]

/-! ## The strand braidings, ℕ-indexed -/

/-- The weight `w = (1, q²)`. -/
def wt (q : R) : Fin 2 → R := ![1, q ^ 2]

/-- The site weight `W` on `V^{⊗n}`. -/
noncomputable abbrev W (q : R) (n : ℕ) : Matrix (Fin n → Fin 2) (Fin n → Fin 2) R :=
  siteWeight (n := n) (wt q)

/-- Convention D's Markov parameter. -/
noncomputable def zD (q : R) : R := q ^ 3 / (q ^ 2 + 1)

/-- The strand braiding `σ_i` on `V^{⊗(N+1)}`, ℕ-indexed (`0` from `N` on). -/
noncomputable def S (q : R) (N : ℕ) (i : ℕ) :
    Matrix (Fin (N + 1) → Fin 2) (Fin (N + 1) → Fin 2) R :=
  if h : i < N then strandBraid q q⁻¹ (⟨i, h⟩ : Fin N) else 0

theorem S_of_lt (q : R) {N i : ℕ} (h : i < N) :
    S q N i = strandBraid q q⁻¹ (⟨i, h⟩ : Fin N) := by
  simp [S, h]

variable {q : R}

theorem sum_wt (q : R) : (∑ k, wt q k) = q ^ 2 + 1 := by
  simp [wt, Fin.sum_univ_two, add_comm]

private theorem cs_ne_succ' {N : ℕ} (a : Fin N) : a.castSucc ≠ a.succ := by
  simp [Fin.ext_iff]

/-- **The strand braidings form a Hecke family** with `a = q − q⁻¹`, `b = 1`, for every `N`. -/
theorem strand_heckeFamily (hq : q ≠ 0) (N : ℕ) : HeckeFamily N (q - q⁻¹) 1 (S q N) where
  quad i hi := by
    have h := (isHeckeGenerator_braidAt q q⁻¹ (cs_ne_succ' (⟨i, hi⟩ : Fin N))
      (mul_inv_cancel₀ hq))
    have h' : strandBraid q q⁻¹ (⟨i, hi⟩ : Fin N) * strandBraid q q⁻¹ (⟨i, hi⟩ : Fin N)
        = algebraMap R _ (q - q⁻¹) * strandBraid q q⁻¹ (⟨i, hi⟩ : Fin N) + 1 := h
    rw [S_of_lt q hi, h', one_smul, Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul]
  braid i hi := by
    rw [S_of_lt q (show i < N by omega), S_of_lt q hi]
    simp only [strandBraid]
    have e : ((⟨i + 1, hi⟩ : Fin N).castSucc : Fin (N + 1)) = (⟨i, by omega⟩ : Fin N).succ := by
      simp [Fin.ext_iff]
    rw [e]
    exact braidAt_braid q q⁻¹ (by simp [Fin.ext_iff]) (by simp [Fin.ext_iff] <;> omega)
      (by simp [Fin.ext_iff] <;> omega) (mul_inv_cancel₀ hq)
  comm i j hij hj := by
    rw [S_of_lt q (show i < N by omega), S_of_lt q hj]
    simp only [strandBraid]
    exact braidAt_commute q q⁻¹ (by simp [Fin.ext_iff]) (by simp [Fin.ext_iff])
      (by simp [Fin.ext_iff]; omega) (by simp [Fin.ext_iff]; omega)
      (by simp [Fin.ext_iff]; omega) (by simp [Fin.ext_iff]; omega)

/-! ## The tower: strand braidings extend along `X ↦ X ⊗ 1` -/

theorem extend_S (q : R) {N i : ℕ} (h : i < N) :
    extendSiteHom (R := R) (m := N) (S q N i) = S q (N + 1) i := by
  rw [S_of_lt q h, S_of_lt q (show i < N + 1 by omega), extendSite_strandBraid]
  rfl

/-- The subalgebra generated by the first `k ≤ N` generators one level up is the image of the
one at level `N` under the site extension. -/
theorem adjoin_succ_eq_map (q : R) {N k : ℕ} (hk : k ≤ N) :
    Algebra.adjoin R (S q (N + 1) '' Set.Iio k)
      = (Algebra.adjoin R (S q N '' Set.Iio k)).map (extendSiteHom (R := R) (m := N)) := by
  rw [AlgHom.map_adjoin, Set.image_image]
  congr 1
  refine Set.image_congr fun i hi => (extend_S q ?_).symm
  exact lt_of_lt_of_le (Set.mem_Iio.mp hi) hk

/-! ## The Markov property at every level -/

/-- **Markov property of the quantum trace at every level.** For `k < N` and `X` in the
subalgebra generated by `S₀, …, S_{k−1}` on `V^{⊗(N+1)}`,
`tr(W · (X · S_k)) = z_D · tr(W · X)`. -/
theorem trace_markov (hq : q ≠ 0) (hq1 : q ^ 2 + 1 ≠ 0) :
    ∀ N k, k < N → ∀ X ∈ Algebra.adjoin R (S q N '' Set.Iio k),
      Matrix.trace (W q (N + 1) * (X * S q N k)) = zD q * Matrix.trace (W q (N + 1) * X) := by
  intro N
  induction N with
  | zero => intro k hk; omega
  | succ N ih =>
    intro k hk X hX
    rw [adjoin_succ_eq_map q (by omega)] at hX
    obtain ⟨Y, hY, rfl⟩ := Subalgebra.mem_map.mp hX
    have hext : Matrix.trace (W q (N + 2) * extendSiteHom (R := R) (m := N) Y)
        = (q ^ 2 + 1) * Matrix.trace (W q (N + 1) * Y) := by
      rw [W, trace_extendSite, sum_wt]
    rcases Nat.lt_succ_iff_lt_or_eq.mp hk with hlt | heq
    · -- lower level: everything is extended from level `N`
      rw [← extend_S q hlt, ← map_mul, W, trace_extendSite, sum_wt, ← W, ih k hlt Y hY,
        ← W, hext]
      ring
    · -- top level: the peel
      subst heq
      have hS : S q (k + 1) k = strandBraid q q⁻¹ (Fin.last k) := by
        rw [S_of_lt q (by omega)]; rfl
      have hP := peel_scalar_of_physical q q⁻¹ (mul_inv_cancel₀ hq) (wt q) (by simp [wt])
        (by simp [wt])
      rw [hS, W, trace_peel q q⁻¹ (wt q) (q ^ 3) hP Y, ← W, hext, zD]
      field_simp

/-! ## The model algebra and its normalised trace -/

/-- The model algebra at level `N`: the centraliser of `W` in `End(V^{⊗(N+1)})`. -/
abbrev A (q : R) (N : ℕ) := weightCentralizer (m := N) (wt q)

theorem S_mem (q : R) (N i : ℕ) : S q N i ∈ A q N := by
  unfold S
  split_ifs with h
  · exact strandBraid_mem_weightCentralizer q q⁻¹ (wt q) _
  · exact Subalgebra.zero_mem _

/-- The Hecke family inside the model algebra. -/
noncomputable def sA (q : R) (N : ℕ) (i : ℕ) : A q N := ⟨S q N i, S_mem q N i⟩

@[simp] theorem sA_val (q : R) (N i : ℕ) : ((sA q N i : A q N) : Matrix _ _ R) = S q N i := rfl

theorem sA_heckeFamily (hq : q ≠ 0) (N : ℕ) : HeckeFamily N (q - q⁻¹) 1 (sA q N) where
  quad i hi := Subtype.ext (by simpa using (strand_heckeFamily hq N).quad i hi)
  braid i hi := Subtype.ext (by simpa using (strand_heckeFamily hq N).braid i hi)
  comm i j hij hj := Subtype.ext (by simpa using (strand_heckeFamily hq N).comm i j hij hj)

/-- The trace of the site weight is `(∑ w)^n`. -/
theorem trace_W (q : R) (n : ℕ) : Matrix.trace (W q n) = (q ^ 2 + 1) ^ n := by
  classical
  rw [W, siteWeight, Matrix.trace_diagonal, ← sum_wt q]
  rw [show ((∑ k, wt q k) ^ n) = ∏ _x : Fin n, ∑ k, wt q k by
    rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]]
  exact (Fintype.prod_sum (fun (_ : Fin n) (k : Fin 2) => wt q k)).symm

/-- **The normalised quantum trace** on the model algebra,
`τ(x) = (1 + q²)^{−(N+1)} · tr(W · x)`. -/
noncomputable def tau (q : R) (N : ℕ) : A q N →ₗ[R] R where
  toFun x := ((q ^ 2 + 1) ^ (N + 1))⁻¹ * Matrix.trace (W q (N + 1) * (x : Matrix _ _ R))
  map_add' x y := by
    simp only [Subalgebra.coe_add, mul_add, Matrix.trace_add]
  map_smul' c x := by
    simp only [Subalgebra.coe_smul, Matrix.mul_smul, Matrix.trace_smul, smul_eq_mul,
      RingHom.id_apply]
    ring

theorem tau_apply (q : R) (N : ℕ) (x : A q N) :
    tau q N x = ((q ^ 2 + 1) ^ (N + 1))⁻¹ * Matrix.trace (W q (N + 1) * (x : Matrix _ _ R)) :=
  rfl

theorem tau_one (hq1 : q ^ 2 + 1 ≠ 0) (N : ℕ) : tau q N 1 = 1 := by
  rw [tau_apply, OneMemClass.coe_one, mul_one, trace_W]
  exact inv_mul_cancel₀ (pow_ne_zero _ hq1)

theorem tau_cyc (q : R) (N : ℕ) (x y : A q N) : tau q N (x * y) = tau q N (y * x) := by
  have hc : W q (N + 1) * (x : Matrix _ _ R) = (x : Matrix _ _ R) * W q (N + 1) := by
    have h := (Subalgebra.mem_centralizer_iff R).mp x.2
    exact h _ rfl
  rw [tau_apply, tau_apply, Subalgebra.coe_mul, Subalgebra.coe_mul]
  congr 1
  set Wm := W q (N + 1)
  set X := x.1
  set Y := y.1
  calc Matrix.trace (Wm * (X * Y))
      = Matrix.trace (Wm * X * Y) := by rw [mul_assoc]
    _ = Matrix.trace (X * Wm * Y) := by rw [hc]
    _ = Matrix.trace (X * (Wm * Y)) := by rw [mul_assoc]
    _ = Matrix.trace (Wm * Y * X) := Matrix.trace_mul_comm _ _
    _ = Matrix.trace (Wm * (Y * X)) := by rw [mul_assoc]

/-- Elements of the generated subalgebra of the model are generated by the matrices `S`. -/
theorem val_mem_adjoin (q : R) (N k : ℕ) {x : A q N}
    (hx : x ∈ Algebra.adjoin R (sA q N '' Set.Iio k)) :
    (x : Matrix _ _ R) ∈ Algebra.adjoin R (S q N '' Set.Iio k) := by
  have h : (Algebra.adjoin R (sA q N '' Set.Iio k)).map (A q N).val
      = Algebra.adjoin R (S q N '' Set.Iio k) := by
    rw [AlgHom.map_adjoin, Set.image_image]
    rfl
  rw [← h]
  exact ⟨x, hx, rfl⟩

theorem tau_markov (hq : q ≠ 0) (hq1 : q ^ 2 + 1 ≠ 0) (N : ℕ) :
    ∀ k, k < N → ∀ x ∈ Algebra.adjoin R (sA q N '' Set.Iio k),
      tau q N (x * sA q N k) = zD q * tau q N x := by
  intro k hk x hx
  rw [tau_apply, tau_apply, Subalgebra.coe_mul, sA_val,
    trace_markov hq hq1 N k hk _ (val_mem_adjoin q N k hx)]
  ring

/-! ## Existence of the Markov trace on the presented Hecke algebra -/

/-- **Ocneanu's trace on the presented algebra**, for every `N`: the model trace pulled back
along `lift`. -/
noncomputable def presTrace (hq : q ≠ 0) (N : ℕ) : Pres N (q - q⁻¹) (1 : R) →ₗ[R] R :=
  tau q N ∘ₗ (lift (sA_heckeFamily hq N)).toLinearMap

theorem presTrace_one (hq : q ≠ 0) (hq1 : q ^ 2 + 1 ≠ 0) (N : ℕ) : presTrace hq N 1 = 1 := by
  simp [presTrace, tau_one hq1]

theorem presTrace_cyc (hq : q ≠ 0) (N : ℕ) (x y : Pres N (q - q⁻¹) (1 : R)) :
    presTrace hq N (x * y) = presTrace hq N (y * x) := by
  simp only [presTrace, LinearMap.coe_comp, Function.comp_apply, AlgHom.toLinearMap_apply,
    map_mul]
  exact tau_cyc q N _ _

theorem presTrace_markov (hq : q ≠ 0) (hq1 : q ^ 2 + 1 ≠ 0) (N : ℕ) :
    ∀ k, k < N → ∀ x ∈ Algebra.adjoin R (pgen N (q - q⁻¹) (1 : R) '' Set.Iio k),
      presTrace hq N (x * pgen N (q - q⁻¹) 1 k) = zD q * presTrace hq N x :=
  pullback_markov (sA_heckeFamily hq N) (zD q) (tau q N) (tau_markov hq hq1 N)

/-! ## Every Markov trace with `z_D` is the quantum trace on torus braids -/

theorem tau_cox_pow (q : R) (N n p : ℕ) :
    tau q N (cox (sA q N) n ^ p)
      = ((q ^ 2 + 1) ^ (N + 1))⁻¹ * Matrix.trace (W q (N + 1) * cox (S q N) n ^ p) := by
  rw [tau_apply]
  congr 3
  have h : ∀ n, ((cox (sA q N) n : A q N) : Matrix _ _ R) = cox (S q N) n := by
    intro n
    induction n with
    | zero => simp [cox]
    | succ m ih => rw [cox, cox, Subalgebra.coe_mul, ih, sA_val]
  rw [SubmonoidClass.coe_pow, h]

/-- **Transfer to the quantum trace.** Any normalised, cyclic Markov trace with `z = z_D` on any
algebra carrying a Hecke family `(N, q − q⁻¹, 1)` takes, on every torus braid
`(s₀ ⋯ s_{n−1})^p` with `n ≤ N`, the value of the normalised quantum trace on `V^{⊗(N+1)}`. -/
theorem markov_cox_eq_quantumTrace (hq : q ≠ 0) (hq1 : q ^ 2 + 1 ≠ 0)
    {B : Type*} [Ring B] [Algebra R B] {N : ℕ} {s : ℕ → B}
    (hs : HeckeFamily N (q - q⁻¹) 1 s) (t : B →ₗ[R] R) (ht1 : t 1 = 1)
    (hcyc : ∀ x y : B, t (x * y) = t (y * x))
    (hmark : ∀ k, k < N → ∀ x ∈ Algebra.adjoin R (s '' Set.Iio k), t (x * s k) = zD q * t x)
    {n : ℕ} (hn : n ≤ N) (p : ℕ) :
    t (cox s n ^ p)
      = ((q ^ 2 + 1) ^ (N + 1))⁻¹ * Matrix.trace (W q (N + 1) * cox (S q N) n ^ p) := by
  rw [← tau_cox_pow q N n p]
  exact markov_transfer_cox hs (sA_heckeFamily hq N) (zD q) t ht1 hcyc hmark
    (tau q N) (tau_one hq1 N) (tau_cyc q N) (tau_markov hq hq1 N) hn p

/-! ## Reduction to `n + 1` sites -/

theorem extend_cox (q : R) {N : ℕ} : ∀ n, n ≤ N →
    extendSiteHom (R := R) (m := N) (cox (S q N) n) = cox (S q (N + 1)) n := by
  intro n
  induction n with
  | zero => intro _; simp [cox]
  | succ m ih =>
    intro hm
    rw [cox, cox, map_mul, ih (by omega), extend_S q (by omega)]

/-- The normalised quantum trace of a torus braid does not depend on the number of spectator
sites: it may be computed at `n + 1` sites. -/
theorem quantumTrace_cox_level (q : R) (hq1 : q ^ 2 + 1 ≠ 0) (n p : ℕ) :
    ∀ N, n ≤ N →
      ((q ^ 2 + 1) ^ (N + 1))⁻¹ * Matrix.trace (W q (N + 1) * cox (S q N) n ^ p)
        = ((q ^ 2 + 1) ^ (n + 1))⁻¹ * Matrix.trace (W q (n + 1) * cox (S q n) n ^ p) := by
  intro N hN
  induction N, hN using Nat.le_induction with
  | base => rfl
  | succ N hN ih =>
    rw [← ih, ← extend_cox q n hN, ← map_pow, W, trace_extendSite, sum_wt, ← W]
    have h1 : (q ^ 2 + 1) ^ (N + 1) ≠ 0 := pow_ne_zero _ hq1
    rw [pow_succ (q ^ 2 + 1) (N + 1)]
    field_simp

/-- **The torus-braid value of every Markov trace with `z_D`, at `n + 1` sites.** -/
theorem markov_cox_eq_quantumTrace' (hq : q ≠ 0) (hq1 : q ^ 2 + 1 ≠ 0)
    {B : Type*} [Ring B] [Algebra R B] {N : ℕ} {s : ℕ → B}
    (hs : HeckeFamily N (q - q⁻¹) 1 s) (t : B →ₗ[R] R) (ht1 : t 1 = 1)
    (hcyc : ∀ x y : B, t (x * y) = t (y * x))
    (hmark : ∀ k, k < N → ∀ x ∈ Algebra.adjoin R (s '' Set.Iio k), t (x * s k) = zD q * t x)
    {n : ℕ} (hn : n ≤ N) (p : ℕ) :
    t (cox s n ^ p)
      = ((q ^ 2 + 1) ^ (n + 1))⁻¹ * Matrix.trace (W q (n + 1) * cox (S q n) n ^ p) := by
  rw [markov_cox_eq_quantumTrace hq hq1 hs t ht1 hcyc hmark hn p,
    quantumTrace_cox_level q hq1 n p N hn]

end QOU.IwahoriHecke.TensorMarkovModel
