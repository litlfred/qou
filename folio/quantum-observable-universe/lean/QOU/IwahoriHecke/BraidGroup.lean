import QOU.IwahoriHecke.MarkovNormalized
import Mathlib.GroupTheory.PresentedGroup

/-!
# The braid group, and its representation into the Hecke units

Everything in this arc so far has been about `H(M, q²)` and its matrix representation. The
object the Jones polynomial is actually a function *of* is a **braid**, and there has been no
braid group anywhere to speak of.

**Mathlib has none.** Measured at the pinned revision (`f897ebcf72`, a full 6996-file checkout,
not a partial one): `grep -rl "BraidGroup" Mathlib/` returns **nothing**, and the only
`*braid*` files in the whole tree are `CategoryTheory/Monoidal/Braided`,
`GradedObject/Braiding.lean` and `Rigid/Braided.lean` — *braided monoidal categories*, which
are a different object and supply no `B_n`. So this is built from the presentation, exactly as
the Hecke algebra was built from its own.

(The revision and file count are stated because a sibling branch had to retract a
"Mathlib has no Bruhat order" claim that turned out to be measuring its own incomplete
checkout. This one was re-measured against the pin for that reason.)

## What is here

* `artinRels M` — the Artin relations of a Coxeter matrix `M`, as a subset of `FreeGroup B`.
  They are written with the *same* `altProd` the Hecke algebra's `T_braid` and
  `Balanced.sigma_braid` use, so the two statements are literally the same alternating word in
  two different monoids, and `map_altProd` moves between them with no re-derivation.
* `ArtinGroup M := PresentedGroup (artinRels M)`, with `braidGen` its generators. The braid
  group on `m+1` strands is `BraidGroupN m := ArtinGroup (coxA m)`, `coxA` being the type-`A`
  Coxeter matrix already used for the Hecke action.
* `heckeRep` — the representation `Art(M) → H(M, q²)ˣ`, `σ_i ↦ σ_i`. The universal property of
  the presentation supplies it once the braid relation is checked in the *unit group*, which
  `sigmaUnit_braid` gets from `Balanced.sigma_braid` by pushing along `Units.coeHom`.

  This is the step the corpus's Hecke files kept gesturing at — `isUnit_sigma`'s docstring says
  invertibility is "what makes `H(M, q²)` a quotient of the *braid group* algebra rather than
  merely of the free algebra", and until now there was no braid group for that sentence to be
  about.

* `braidTrace` — the normalised Markov trace of a braid, and `braidTrace_conj`, which is
  **Markov move I** stated where it belongs: on braids, as invariance under conjugation.

## 🛑 Not a link invariant

Two things are missing and neither is small. The **tower** `B_n ↪ B_{n+1}` and move II on
braids are the next file's business. **Markov's theorem** — that closure-equivalence of braids
is generated by exactly these two moves — is a theorem of low-dimensional topology, is not in
Mathlib, and is not proved here; without it a Markov-invariant functional is a function on
braids, not on links.

-- Ref: [jones1987] Hecke algebra representations of braid groups and link polynomials
-- Ref: [leitner2026] bean qou-k4oq
-/

namespace QOU.IwahoriHecke.BraidGroup

open QOU.MathlibExt.IwahoriHecke QOU.MathlibExt.SkeinRelation
open QOU.IwahoriHecke.Balanced QOU.IwahoriHecke.TensorEmbed

variable {B : Type*} (M : B → B → ℕ)

/-! ## The presentation -/

/-- **The Artin relations** of a Coxeter matrix `M`: for each pair `i, j`, the alternating word
`i j i ⋯` of length `M i j` equals `j i j ⋯` of length `M j i`.

Written with the same `altProd` as the Hecke algebra's braid relation, so the two are one
statement in two monoids. -/
def artinRels : Set (FreeGroup B) :=
  {r | ∃ i j : B, r = altProd (FreeGroup.of i) (FreeGroup.of j) (M i j)
        * (altProd (FreeGroup.of j) (FreeGroup.of i) (M j i))⁻¹}

/-- **The Artin group** of `M` — the braid group of the corresponding Coxeter system. Mathlib
has no braid group, so this is built from `PresentedGroup`. -/
abbrev ArtinGroup : Type _ := PresentedGroup (artinRels M)

/-- The `i`-th Artin generator `σ_i`. -/
def braidGen (i : B) : ArtinGroup M := PresentedGroup.of i

/-- **The braid group on `m+1` strands**, as the Artin group of the type-`A` Coxeter matrix
already used by `heckeActionN`. -/
abbrev BraidGroupN (m : ℕ) : Type := ArtinGroup (coxA m)

/-! ## The representation into the Hecke units -/

variable {R : Type*} [CommRing R] {q qi : R}

/-- `altProd` of units is computed in the group and then coerced — `map_altProd` along
`Units.coeHom`. -/
theorem val_altProd {A : Type*} [Monoid A] (u v : Aˣ) (n : ℕ) :
    ((altProd u v n : Aˣ) : A) = altProd (u : A) (v : A) n :=
  map_altProd (Units.coeHom A) n u v

/-- **The braid relation holds among the `σ_i` as units.** `Balanced.sigma_braid` pushed along
`Units.coeHom`; nothing is re-derived. -/
theorem sigmaUnit_braid (hqi : q * qi = 1) (hM : ∀ i j, M i j = M j i) (i j : B) :
    altProd (sigmaUnit (M := M) (q := q) (qi := qi) hqi i) (sigmaUnit hqi j) (M i j)
      = altProd (sigmaUnit (M := M) hqi j) (sigmaUnit hqi i) (M j i) := by
  refine Units.ext ?_
  rw [val_altProd, val_altProd]
  exact sigma_braid hM i j

/-- **The braid representation** `Art(M) → H(M, q²)ˣ`, `σ_i ↦ σ_i`.

The universal property of the presentation does all the work: the only obligation is the braid
relation in the unit group, and `σ_i` is a unit because it satisfies the §7a quadratic. -/
noncomputable def heckeRep (hqi : q * qi = 1) (hM : ∀ i j, M i j = M j i) :
    ArtinGroup M →* (BalancedHecke M q)ˣ :=
  PresentedGroup.toGroup (f := fun i => sigmaUnit (M := M) (q := q) (qi := qi) hqi i) (by
    rintro r ⟨i, j, rfl⟩
    rw [map_mul, map_inv, map_altProd, map_altProd]
    simp only [FreeGroup.lift_apply_of]
    rw [sigmaUnit_braid M hqi hM i j, mul_inv_cancel])

@[simp] theorem heckeRep_braidGen (hqi : q * qi = 1) (hM : ∀ i j, M i j = M j i) (i : B) :
    heckeRep M hqi hM (braidGen M i) = sigmaUnit (M := M) hqi i :=
  PresentedGroup.toGroup.of _

/-- The value of a generator in the algebra, not the unit group. -/
theorem heckeRep_braidGen_val (hqi : q * qi = 1) (hM : ∀ i j, M i j = M j i) (i : B) :
    ((heckeRep M hqi hM (braidGen M i) : (BalancedHecke M q)ˣ) : BalancedHecke M q)
      = sigma M q qi i := by
  rw [heckeRep_braidGen]
  rfl

/-! ## The Markov trace of a braid, and move I -/

variable (q qi)

/-- **The normalised Markov trace of a braid**: represent it in `H_{m+1}(q)`, then take the
normalised site-weighted trace. -/
noncomputable def braidTrace (hqi : q * qi = 1) (w : Fin 2 → R) (wi : R) {m : ℕ}
    (β : BraidGroupN m) : R :=
  QOU.IwahoriHecke.MarkovNormalized.markovTr q qi hqi w wi
    ((heckeRep (coxA m) hqi coxA_symm β : (BalancedHecke (coxA m) q)ˣ)
      : BalancedHecke (coxA m) q)

/-- **Markov move I, on braids.** The trace is a conjugation invariant of the braid, so it is
already constant on the conjugacy classes that move I identifies.

This is `markovTr_mul_comm` transported through the representation; the representation being a
*group* hom is what lets `γ⁻¹` appear at all. -/
theorem braidTrace_conj (hqi : q * qi = 1) (w : Fin 2 → R) (wi : R) {m : ℕ}
    (γ β : BraidGroupN m) :
    braidTrace q qi hqi w wi (γ * β * γ⁻¹) = braidTrace q qi hqi w wi β := by
  rw [braidTrace, braidTrace, map_mul, map_mul, map_inv, Units.val_mul, Units.val_mul,
    QOU.IwahoriHecke.MarkovNormalized.markovTr_mul_comm q qi hqi w wi, ← mul_assoc,
    Units.inv_mul, one_mul]

/-- The trace of the trivial braid is `1` — the normalisation, restated on braids. -/
theorem braidTrace_one (hqi : q * qi = 1) (w : Fin 2 → R) (wi : R)
    (hw : (∑ k, w k) * wi = 1) {m : ℕ} :
    braidTrace q qi hqi w wi (1 : BraidGroupN m) = 1 := by
  rw [braidTrace, map_one, Units.val_one,
    QOU.IwahoriHecke.MarkovNormalized.markovTr_one q qi hqi w wi hw]

end QOU.IwahoriHecke.BraidGroup
