import QOU.IwahoriHecke.JonesNormalForm
import QOU.Hecke.HeckeSpanning

/-!
# QOU.IwahoriHecke.JonesNormalFormQuot — Markov uniqueness on the presented `H_{N+1}(q)`

Instantiates `QOU.IwahoriHecke.JonesNormalForm` on the presented Iwahori–Hecke algebra
`QOU.Hecke.IwahoriHecke K q N` (`RingQuot` of the free algebra on `N` generators, quadratic
relation `σᵢ² = (q − 1)σᵢ + q`). The generators `σ₀, …, σ_{N-1}` satisfy the type-`A`
relations (`heckeFamily`) and generate the algebra (`adjoin_gen_eq_top`), so:

* `markov_unique_quot` — two normalised, cyclic `K`-linear functionals on `H_{N+1}(q)` that
  satisfy the Markov property `t (x · σ_k) = z · t x` (for `x` generated by `σ₀, …, σ_{k-1}`,
  every `k < N`) with the same `z` are **equal**.

Sorry-free; no axioms beyond `propext`, `Classical.choice`, `Quot.sound`. The cross-level
Markov hypothesis is essential: the former `QOU.Hecke.markov_trace_unique_axiom`, which
omitted it, was false (`QOU.Hecke.MarkovTraceClassNotUnique.markov_trace_unique_axiom_false`)
and has been replaced by the theorem `QOU.Hecke.markov_trace_unique` (bean `qou-q425`).
-/

namespace QOU.IwahoriHecke.JonesNormalForm

open QOU.Hecke

variable (K : Type*) [CommRing K] (q : K) (N : ℕ)

/-- The generators of `H_{N+1}(q)`, ℕ-indexed (`0` above the top). -/
noncomputable def gen (i : ℕ) : IwahoriHecke K q N :=
  if h : i < N then IwahoriHecke.σ K q N ⟨i, h⟩ else 0

theorem heckeFamily : HeckeFamily N (q - 1) q (gen K q N) where
  quad i hi := by
    simp only [gen, dif_pos hi]
    exact IwahoriHecke.σ_quadratic K q N ⟨i, hi⟩
  braid i hi := by
    simp only [gen, dif_pos (show i < N by omega), dif_pos hi]
    exact IwahoriHecke.σ_braid K q N ⟨i, by omega⟩ hi
  comm i j hij hj := by
    simp only [gen, dif_pos hj, dif_pos (show i < N by omega)]
    exact (IwahoriHecke.σ_commute K q N ⟨j, hj⟩ ⟨i, by omega⟩ hij).symm

theorem image_gen_eq_range : gen K q N '' Set.Iio N = Set.range (IwahoriHecke.σ K q N) := by
  ext x
  constructor
  · rintro ⟨i, hi, rfl⟩
    exact ⟨⟨i, hi⟩, by simp [gen, dif_pos (Set.mem_Iio.mp hi)]⟩
  · rintro ⟨i, rfl⟩
    exact ⟨i, Set.mem_Iio.mpr i.isLt, by simp [gen]⟩

theorem adjoin_gen_eq_top : Algebra.adjoin K (gen K q N '' Set.Iio N) = ⊤ := by
  rw [image_gen_eq_range]
  exact IwahoriHecke.adjoin_range_σ K q N

/-- **Markov-trace uniqueness on `H_{N+1}(q)`, every `N`.** -/
theorem markov_unique_quot (z : K) (t t' : IwahoriHecke K q N →ₗ[K] K)
    (ht1 : t 1 = 1) (hcyc : ∀ x y, t (x * y) = t (y * x))
    (hmark : ∀ k, k < N → ∀ x ∈ Algebra.adjoin K (gen K q N '' Set.Iio k),
      t (x * gen K q N k) = z * t x)
    (ht1' : t' 1 = 1) (hcyc' : ∀ x y, t' (x * y) = t' (y * x))
    (hmark' : ∀ k, k < N → ∀ x ∈ Algebra.adjoin K (gen K q N '' Set.Iio k),
      t' (x * gen K q N k) = z * t' x) :
    t = t' :=
  markov_unique_of_adjoin_eq_top (heckeFamily K q N) (adjoin_gen_eq_top K q N) z t t'
    ht1 hcyc hmark ht1' hcyc' hmark'

end QOU.IwahoriHecke.JonesNormalForm
