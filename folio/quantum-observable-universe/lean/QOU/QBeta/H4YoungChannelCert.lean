    2*q^5*(q - 1)*(q + 1)/((q^2 + 1)*(q^4 + 1)), q^2*(q - 1)^2*(q + 1)^2/(q^4 + 1), q*(q - 1)*(q + 1)*(q^6 + q^4 - q^2 + 1)/((q^2 + 1)*(q^4 + 1)), q*(q - 1)*(q + 1)*(q^6 + q^4 - q^2 + 1)/((q^2 + 1)*(q^4 + 1)), (q^10 + q^8 - 2*q^6 + 4*q^4 - q^2 + 1)/((q^2 + 1)*(q^4 + 1)), q^3*(q - 1)*(q + 1)*(q^6 + q^4 - q^2 + 1)/((q^2 + 1)*(q^4 + 1));
    q^2*(q - 1)^2*(q + 1)^2/(q^4 + 1), q*(q - 1)*(q + 1)*(q^6 + q^4 - q^2 + 1)/((q^2 + 1)*(q^4 + 1)), q^2*(q - 1)*(q + 1)*(q^6 + q^4 - q^2 + 1)/((q^2 + 1)*(q^4 + 1)), q^2*(q - 1)*(q + 1)*(q^6 + q^4 - q^2 + 1)/((q^2 + 1)*(q^4 + 1)), q^3*(q - 1)*(q + 1)*(q^6 + q^4 - q^2 + 1)/((q^2 + 1)*(q^4 + 1)), (q^10 - q^8 + 2*q^4 - q^2 + 1)/(q^4 + 1)]

variable (q : R) (hq : q ≠ 0) (hq2 : q ^ 2 + 1 ≠ 0) (hq4 : q ^ 4 + 1 ≠ 0)
  (h4 : q ^ 4 - 1 ≠ 0) (h8 : q ^ 8 - 1 ≠ 0) (h12 : q ^ 12 - 1 ≠ 0)

/-- `h = q - q⁻¹`. -/
abbrev hh : R := q - q⁻¹

include hq in
theorem D_eq : s1 q (hh q) * s2 q (hh q) * s3 q (hh q) = Dm q := by
  (ext i j; fin_cases i <;> fin_cases j <;>
    simp [Dm, D2m, Fm, F2m, F3m, Wm, s1, s2, s3, Matrix.mul_apply, Fin.sum_univ_succ] <;>
    field_simp <;> ring)

include hq hq2 hq4 in
theorem D2_eq : Dm q * Dm q = D2m q := by
  (ext i j; fin_cases i <;> fin_cases j <;>
    simp [Dm, D2m, Fm, F2m, F3m, Wm, s1, s2, s3, Matrix.mul_apply, Fin.sum_univ_succ] <;>
    field_simp <;> ring)

include hq hq2 hq4 in
theorem F_eq : D2m q * D2m q = Fm q := by
  (ext i j; fin_cases i <;> fin_cases j <;>
    simp [Dm, D2m, Fm, F2m, F3m, Wm, s1, s2, s3, Matrix.mul_apply, Fin.sum_univ_succ] <;>
    field_simp <;> ring)

include hq hq2 hq4 in
theorem F2_eq : Fm q * Fm q = F2m q := by
  (ext i j; fin_cases i <;> fin_cases j <;>
    simp [Dm, D2m, Fm, F2m, F3m, Wm, s1, s2, s3, Matrix.mul_apply, Fin.sum_univ_succ] <;>
    field_simp <;> ring)

include hq hq2 hq4 in
theorem F3_eq : Fm q * F2m q = F3m q := by
  (ext i j; fin_cases i <;> fin_cases j <;>
    simp [Dm, D2m, Fm, F2m, F3m, Wm, s1, s2, s3, Matrix.mul_apply, Fin.sum_univ_succ] <;>
    field_simp <;> ring)

include hq hq2 hq4 in
theorem F_minpoly :
    F3m q - (q ^ 12 + q ^ 4 + 1) • F2m q + (q ^ 16 + q ^ 12 + q ^ 4) • Fm q
      - (q ^ 16) • (1 : Matrix (Fin 6) (Fin 6) R) = 0 := by
  ext i j; fin_cases i <;> fin_cases j <;>
    simp [F3m, F2m, Fm, Matrix.one_apply] <;> field_simp <;> ring

include hq hq2 hq4 h4 h8 h12 in
theorem W_eq :
    Wm q =
      (q ^ 6 / ((q ^ 12 - q ^ 4) * (q ^ 12 - 1))) •
          (F2m q - (q ^ 4 + 1) • Fm q + (q ^ 4) • (1 : Matrix (Fin 6) (Fin 6) R)) +
      (q ^ 2 / ((q ^ 4 - q ^ 12) * (q ^ 4 - 1))) •
          (F2m q - (q ^ 12 + 1) • Fm q + (q ^ 12) • (1 : Matrix (Fin 6) (Fin 6) R)) +
      (1 / ((1 - q ^ 12) * (1 - q ^ 4))) •
          (F2m q - (q ^ 12 + q ^ 4) • Fm q + (q ^ 16) • (1 : Matrix (Fin 6) (Fin 6) R)) := by
  have e1 : q ^ 12 - q ^ 4 ≠ 0 := by
    have : q ^ 12 - q ^ 4 = q ^ 4 * (q ^ 8 - 1) := by ring
    rw [this]; exact mul_ne_zero (pow_ne_zero _ hq) h8
  have e2 : q ^ 4 - q ^ 12 ≠ 0 := by
    have : q ^ 4 - q ^ 12 = -(q ^ 12 - q ^ 4) := by ring
    rw [this]; exact neg_ne_zero.mpr e1
  have e3 : 1 - q ^ 12 ≠ 0 := by
    have : 1 - q ^ 12 = -(q ^ 12 - 1) := by ring
    rw [this]; exact neg_ne_zero.mpr h12
  have e4 : 1 - q ^ 4 ≠ 0 := by
    have : 1 - q ^ 4 = -(q ^ 4 - 1) := by ring
    rw [this]; exact neg_ne_zero.mpr h4
  have e5 : 1 - q ^ 8 ≠ 0 := by
    have : 1 - q ^ 8 = -(q ^ 8 - 1) := by ring
    rw [this]; exact neg_ne_zero.mpr h8
  ext i j; fin_cases i <;> fin_cases j <;>
    simp [Wm, F2m, Fm, Matrix.one_apply] <;> field_simp <;> ring

include hq hq2 hq4 in
theorem W_init_sum : Wm q 2 2 + Wm q 4 4 + Wm q 5 5 =
    (q ^ 12 + q ^ 10 + 2 * q ^ 8 + 5 * q ^ 4 + q ^ 2 + 2) / ((q ^ 2 + 1) * (q ^ 4 + 1)) := by
  simp [Wm]; field_simp; ring

include hq hq2 hq4 in
theorem W_final_sum : Wm q 0 0 + Wm q 1 1 + Wm q 3 3 =
    2 * q ^ 2 * (q ^ 6 + 3 * q ^ 4 + 2) / ((q ^ 2 + 1) * (q ^ 4 + 1)) := by
  simp [Wm]; field_simp; ring

include hq hq2 hq4 in
theorem D2_init_sum :
    (Wm q * bBor q (hh q)) 2 2 + (Wm q * bBor q (hh q)) 4 4 + (Wm q * bBor q (hh q)) 5 5 =
      -(q^20 - 4*q^18 + 4*q^16 - 10*q^14 + 10*q^12 - 15*q^10 + 9*q^8 - 10*q^6 + 5*q^4 - 3*q^2 + 1)/(q^6*(q^2 + 1)*(q^4 + 1)) := by
  simp [Wm, bBor, ma, ma2, Matrix.mul_apply, Fin.sum_univ_succ]; field_simp; ring

include hq hq2 hq4 in
theorem D2_final_sum :
    (Wm q * bBor q (hh q)) 0 0 + (Wm q * bBor q (hh q)) 1 1 + (Wm q * bBor q (hh q)) 3 3 =
      -2*(q^16 - 3*q^14 + 3*q^12 - 8*q^10 + 6*q^8 - 7*q^6 + 4*q^4 - 3*q^2 + 1)/(q^4*(q^2 + 1)*(q^4 + 1)) := by
  simp [Wm, bBor, ma, ma2, Matrix.mul_apply, Fin.sum_univ_succ]; field_simp; ring

end QOU.QBeta.H4YoungChannelCert
