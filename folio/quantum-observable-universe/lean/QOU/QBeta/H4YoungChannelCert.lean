    q^5*(q - 1)*(q + 1)*(q^4 - q^2 + 1)*(q^20 + q^18 - q^16 - q^14 + q^12 + q^10 + 1), q^2*(q - 1)^2*(q + 1)^2*(q^2 + 1)*(q^4 - q^2 + 1)*(q^20 + q^18 + q^12 + q^10 + q^8 + q^6 + q^4 + q^2 + 1), q*(q - 1)*(q + 1)*(q^4 - q^2 + 1)*(q^26 + q^24 - q^22 - q^20 + q^18 + q^16 + 1), q*(q - 1)*(q + 1)*(q^4 - q^2 + 1)*(q^26 + q^24 - q^22 - q^20 + q^18 + q^16 + 1), q^34 - q^32 - q^30 + 2*q^28 - 2*q^24 + q^22 + q^20 - q^18 + q^12 - q^10 + 2*q^8 - 3*q^6 + 3*q^4 - 2*q^2 + 1, q^3*(q - 1)*(q + 1)*(q^4 - q^2 + 1)*(q^26 + q^24 - q^22 - q^20 + q^18 + q^16 + 1);
