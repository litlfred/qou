    (canonicalHelicityLinkingParity 3).isValid = true ∧
    (canonicalHelicityLinkingParity 3).netSignedLinking = 0 ∧
    (canonicalAlgebraicK3DilogTorsion 3 5).isValid = true ∧
    canonicalHorizonHigherSpinPole.isValid = true ∧
    canonicalStrangeIdentityResurgenceScope.isScopeHonest = true := by
