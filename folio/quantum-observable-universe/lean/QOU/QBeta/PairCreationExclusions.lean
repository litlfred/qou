-- Ref: [kassel2008] https://doi.org/10.1007/978-0-387-68548-9
-/
import QOU.Mass.BorromeanPhotonFactorisation
import QOU.Mass.GammaGammaWordSelection
import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.LinearAlgebra.Matrix.Trace
import Mathlib.Tactic.Module
import Mathlib.Tactic.Ring

namespace QOU.QBeta.PairCreationExclusions

/-! ## §1 Element level -/

section Element

open QOU.Photon (photon Colour)
open QOU.Mass.BorromeanPhotonFactorisation (HeckeH3Rel vertex vertex_eq photon_vertex_eq)

variable {R : Type*} [CommRing R] {A : Type*} [Ring A] [Algebra R A] {h : R} {a b : A}

/-- The mirror vertex `σ₀⁻¹σ₁ = (a − h)·b`. -/
def mirror (h : R) (a b : A) : A := (a - h • 1) * b

theorem mirror_eq_vertex_add (h : R) (a b : A) :
    mirror h a b = vertex h a b + h • a - h • b := by
  rw [mirror, vertex_eq, sub_mul, smul_mul_assoc, one_mul]; abel

/-- **The mirror vertex is a photon:** `1 + c·σ₀⁻¹σ₁ = γ(hc, −hc, c)`. -/
theorem one_add_mirror_eq_photon (H : HeckeH3Rel h a b) (c : R) :
    1 + c • mirror h a b = photon a H.unitB (⟨h * c, -(h * c), c⟩ : Colour R) := by
  rw [mirror_eq_vertex_add]
  simp only [photon, photon_vertex_eq H, HeckeH3Rel.unitB_val]
  rw [smul_sub, smul_add, smul_smul, smul_smul, neg_smul]
  rw [mul_comm c h]; abel

/-- `[2]·P_L(σ₁) = σ₁ + q⁻¹` is the scalar photon `q⁻¹·γ(0, q, 0)`. -/
theorem leftProjector_eq_photon (H : HeckeH3Rel h a b) {q q' : R} (hq : q * q' = 1) :
    b + q' • (1 : A) = q' • photon a H.unitB (⟨0, q, 0⟩ : Colour R) := by
  simp only [photon, HeckeH3Rel.unitB_val, zero_smul, add_zero, smul_add, smul_smul]
  rw [mul_comm q' q, hq, one_smul]; abel

theorem photon_sub_one_a (H : HeckeH3Rel h a b) :
    photon a H.unitB (⟨1, 0, 0⟩ : Colour R) - 1 = a := by
  simp [photon]

theorem photon_sub_one_b (H : HeckeH3Rel h a b) :
    photon a H.unitB (⟨0, 1, 0⟩ : Colour R) - 1 = b := by
  simp [photon]

/-- **Element-level γγ is vacuous:** the subalgebra generated by all photons is the subalgebra
generated by `σ₀, σ₁`. -/
theorem photon_adjoin_eq (H : HeckeH3Rel h a b) :
    Algebra.adjoin R (Set.range (photon a H.unitB : Colour R → A)) = Algebra.adjoin R {a, b} := by
  apply le_antisymm
  · rw [Algebra.adjoin_le_iff]
    rintro _ ⟨c, rfl⟩
    have ha : a ∈ Algebra.adjoin R ({a, b} : Set A) := Algebra.subset_adjoin (by simp)
    have hb : b ∈ Algebra.adjoin R ({a, b} : Set A) := Algebra.subset_adjoin (by simp)
    simp only [photon, QOU.Photon.vertex, HeckeH3Rel.unitB_val, HeckeH3Rel.unitB_inv]
    refine Subalgebra.add_mem _ (Subalgebra.add_mem _ (Subalgebra.add_mem _
      (Subalgebra.one_mem _) (Subalgebra.smul_mem _ ha _)) (Subalgebra.smul_mem _ hb _))
      (Subalgebra.smul_mem _ (Subalgebra.mul_mem _ ha (Subalgebra.sub_mem _ hb
        (Subalgebra.smul_mem _ (Subalgebra.one_mem _) _))) _)
  · rw [Algebra.adjoin_le_iff]
    intro x hx
    rw [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with hx | hx <;> rw [hx]
    · have hm : photon a H.unitB (⟨1, 0, 0⟩ : Colour R) - 1 ∈
          Algebra.adjoin R (Set.range (photon a H.unitB : Colour R → A)) :=
        Subalgebra.sub_mem _ (Algebra.subset_adjoin ⟨_, rfl⟩) (Subalgebra.one_mem _)
      rwa [photon_sub_one_a H] at hm
    · have hm : photon a H.unitB (⟨0, 1, 0⟩ : Colour R) - 1 ∈
          Algebra.adjoin R (Set.range (photon a H.unitB : Colour R → A)) :=
        Subalgebra.sub_mem _ (Algebra.subset_adjoin ⟨_, rfl⟩) (Subalgebra.one_mem _)
      rwa [photon_sub_one_b H] at hm

end Element

/-! ## §2 Word level -/

section Words

open QOU.Mass.GammaGammaWordSelection

/-- The mirror vertex word `σᵢ⁻¹σᵢ₊₁`. -/
def mirrorW (i : ℕ) : Word := [⟨i, false⟩, ⟨i + 1, true⟩]

/-- Word-level bar involution: every crossing changes sign. -/
def barW (w : Word) : Word := w.map fun c => ⟨c.gen, !c.pos⟩

theorem barW_vertex (i : ℕ) : barW (vertex i) = mirrorW i := by
  simp [barW, vertex, mirrorW]

theorem gammaGamma_head {w : Word} (hw : GammaGammaWord w) :
    w = [] ∨ ∃ i t, w = (⟨i, true⟩ : Crossing) :: t := by
  cases hw with
  | nil => exact Or.inl rfl
  | cons i hw => exact Or.inr ⟨i, _, rfl⟩

theorem mirrorW_not_gammaGamma (i : ℕ) : ¬ GammaGammaWord (mirrorW i) := by
  intro h
  rcases gammaGamma_head h with h0 | ⟨j, t, ht⟩
  · simp [mirrorW] at h0
  · simp [mirrorW] at ht

theorem writhe_mirrorW (i : ℕ) : writhe (mirrorW i) = 0 := by
  simp [writhe, mirrorW, sign]

theorem altChar_mirrorW {R : Type*} [Field R] {q : R} (hq : q ≠ 0) (i : ℕ) :
    altChar q (mirrorW i) = 1 := by
  simp [altChar, mirrorW]
  field_simp

/-- The ruled grammar is not closed under the bar involution. -/
theorem gammaGamma_not_bar_closed : ¬ ∀ w, GammaGammaWord w → GammaGammaWord (barW w) := by
  intro h
  have := h (vertex 0) (by simpa using GammaGammaWord.cons 0 GammaGammaWord.nil)
  rw [barW_vertex] at this
  exact mirrorW_not_gammaGamma 0 this

/-- `V₁³ · σ₀σ₁σ₂` (candidate A followed by the passage, B). -/
def aThenPassage : Word :=
  vertex 1 ++ vertex 1 ++ vertex 1 ++ [⟨0, true⟩, ⟨1, true⟩, ⟨2, true⟩]

theorem A_passage_not_gammaGamma : ¬ GammaGammaWord aThenPassage :=
  fun hg => absurd (writhe_eq_zero hg) (by decide)

/-! ## §3 Closure components -/

/-- Swap the strand labels at positions `i, i+1`. -/
def swapAt (L : List ℕ) (i : ℕ) : List ℕ :=
  (L.set i (L.getD (i + 1) 0)).set (i + 1) (L.getD i 0)

/-- Strand labels by position after the word (letters left to right). -/
def track (w : Word) (L : List ℕ) : List ℕ := w.foldl (fun L c => swapAt L c.gen) L

/-- Signed number of crossings between strands `s t`. -/
def linkCount (w : Word) (s t : ℕ) : ℤ :=
  (w.foldl (fun (p : List ℕ × ℤ) c =>
    let L := p.1
    let x := L.getD c.gen 0
    let y := L.getD (c.gen + 1) 0
    (swapAt L c.gen, if (x = s ∧ y = t) ∨ (x = t ∧ y = s) then p.2 + sign c else p.2))
    ([0, 1, 2, 3], 0)).2

/-- `β_Bor = (σ₀σ₁⁻¹)³` on strands 0–2. -/
def betaBor : Word := vertex 0 ++ vertex 0 ++ vertex 0
/-- `V₁³` on strands 1–3. -/
def candA : Word := vertex 1 ++ vertex 1 ++ vertex 1
def candB : Word := [⟨0, true⟩, ⟨1, true⟩, ⟨2, true⟩]
def candC : Word := [⟨2, true⟩]

/-- Process word A is a pure braid: every strand, the lepton included, closes on itself. -/
theorem trackA : track (candA ++ betaBor) [0, 1, 2, 3] = [0, 1, 2, 3] := by decide

/-- Process word B is a single 4-cycle: one closure component on all four strands. -/
theorem trackB : track (candB ++ betaBor) [0, 1, 2, 3] = [1, 2, 3, 0] := by decide

/-- Process word C transposes strands 2 and 3: the lepton and nucleon strand 2 form one component. -/
theorem trackC : track (candC ++ betaBor) [0, 1, 2, 3] = [0, 1, 3, 2] := by decide

/-- …with one positive crossing between them: the component is `T(2,1)`. -/
theorem linkCountC : linkCount (candC ++ betaBor) 2 3 = 1 := by decide

/-- A: the lepton has zero net signed crossings with every nucleon strand. -/
theorem linkCountA : linkCount (candA ++ betaBor) 1 3 = 0 ∧ linkCount (candA ++ betaBor) 2 3 = 0 ∧
    linkCount (candA ++ betaBor) 0 3 = 0 := by decide

end Words

/-! ## §4 C: the cross term vanishes on `span{1, σ_{n−1}}` -/

section Markov

variable {K : Type*} [CommRing K] {A : Type*} [Ring A] [Algebra K A]

/-- **Markov factorisation.** If `tr(x·s) = z·tr x` for `x ∈ S`, `tr s = z` and `tr 1 = 1`, then
`tr(x·y) = tr x · tr y` for every `x ∈ S` and every `y = α + β·s`. -/
theorem crossTerm_lastLetter_eq_zero (tr : A →ₗ[K] K) (z : K) (s : A) (S : Set A)
    (hM : ∀ x ∈ S, tr (x * s) = z * tr x) (hs : tr s = z) (h1 : tr 1 = 1)
    (x : A) (hx : x ∈ S) (α β : K) :
    tr (x * (α • (1 : A) + β • s)) - tr x * tr (α • (1 : A) + β • s) = 0 := by
  rw [mul_add, mul_smul_comm, mul_smul_comm, mul_one, map_add, map_smul, map_smul, map_add,
    map_smul, map_smul, hM x hx, hs, h1, smul_eq_mul, smul_eq_mul, smul_eq_mul, smul_eq_mul]
  ring

end Markov

/-! ## §5 The two-term all-pairs insertion -/

section Charges

/-- Three times the charge of a strand state: `false = u`, `true = d`; `lep` = lepton strand
(premise L: `ν = u`, `e⁻ = d`). Quark `(2, −1)`, lepton `(0, −3)`. -/
def ch3 (lep : Bool) (x : Bool) : ℤ :=
  if lep then (if x then -3 else 0) else (if x then -1 else 2)

/-- Nine times the all-pairs charge `Σ_{i<j} QᵢQⱼ` of a basis state, species per position. -/
def allPairs9 : List Bool → List Bool → ℤ
  | s :: ss, x :: xs => ch3 s x * ((List.zipWith ch3 ss xs).sum) + allPairs9 ss xs
  | _, _ => 0

/-- Number of `d`s. -/
def countD (xs : List Bool) : ℕ := xs.count true

/-- Sum of the charges of a homogeneous (all-quark) state. -/
theorem sum_quark (xs : List Bool) :
    (List.zipWith ch3 (List.replicate xs.length false) xs).sum =
      2 * ((xs.length : ℤ) - countD xs) - countD xs := by
  induction xs with
  | nil => simp [countD]
  | cons x xs ih =>
    simp only [List.length_cons, List.replicate_succ, List.zipWith_cons_cons, List.sum_cons, ih,
      countD, List.count_cons] at *
    cases x <;> simp [ch3] <;> push_cast <;> ring

/-- **The covariant all-pairs charge depends only on the number of `d`s, for every number of
strands.** Closed form `(2u − d)² − 4u − d = 2·(9·allPairs)` with `u = n − #d`. -/
theorem twoTerm_allPairs_formula (xs : List Bool) :
    2 * allPairs9 (List.replicate xs.length false) xs =
      (2 * ((xs.length : ℤ) - countD xs) - countD xs) ^ 2
        - (4 * ((xs.length : ℤ) - countD xs) + countD xs) := by
  induction xs with
  | nil => simp [allPairs9, countD]
  | cons x xs ih =>
    have hs := sum_quark xs
    simp only [List.length_cons, List.replicate_succ, allPairs9] at *
    rw [mul_add, ih, hs]
    simp only [countD, List.count_cons] at *
    cases x <;> simp [ch3] <;> push_cast <;> ring

theorem twoTerm_allPairs_scalar (xs ys : List Bool) (hl : xs.length = ys.length)
    (hc : countD xs = countD ys) :
    allPairs9 (List.replicate xs.length false) xs = allPairs9 (List.replicate ys.length false) ys := by
  have h1 := twoTerm_allPairs_formula xs
  have h2 := twoTerm_allPairs_formula ys
  rw [hl, hc] at h1
  rw [hl]
  linarith

/-- With the lepton charge on strand 3 the insertion is not a scalar on the charge-0 weight space
(two `d`s): `uudd` and `uddu` (n⊗ν) differ. -/
theorem lepton_allPairs_not_scalar :
    allPairs9 [false, false, false, true] [false, false, true, true] ≠
      allPairs9 [false, false, false, true] [false, true, true, false] := by decide

/-- A scalar insertion has zero connected trace against every operator. -/
theorem trace_scalar_insertion_connected {K ι : Type*} [CommRing K] [Fintype ι] [DecidableEq ι]
    (d : ι → K) (c : K) (hd : ∀ i, d i = c) (M : Matrix ι ι K) :
    Matrix.trace (Matrix.diagonal d * M) - c * Matrix.trace M = 0 := by
  have : Matrix.diagonal d = c • (1 : Matrix ι ι K) := by
    ext i j; by_cases h : i = j <;> simp [Matrix.diagonal_apply, h, hd]
  rw [this, Matrix.smul_mul, Matrix.one_mul, Matrix.trace_smul, smul_eq_mul, sub_self]

end Charges

end QOU.QBeta.PairCreationExclusions
