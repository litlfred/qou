import Mathlib.Tactic
import Mathlib.LinearAlgebra.Determinant
import QOU.BringConeSplitChirality

/-!
# Two elements with a non-degenerate commutator span the split quaternions

Bean `qou-pu2x`, item 1; issue #7783. `QOU.BringConeSplitChirality.commutes_span_scalar`
assumes that the span of Bring's surface group `Γ₄ ⊂ SL(2,ℝ)` contains `i` and `j`. The bean
attributed this to Borel density, which is neither in the corpus nor in `library/`. This
file replaces Borel density by a direct algebraic argument.

## 1. The algebraic criterion (generic `[CommRing R]`, §7c)

Write `N` for the reduced norm (`= det` on `M₂(R)`) and `T` for the reduced trace
(`= 2·re`). For any `x, y` in the split quaternions `M₂(R)`:

* `det_one_x_y_xy`: the determinant, in the basis `1, i, j, k`, of the four vectors
  `1, x, y, xy` times `−4` equals `N(xy − yx)`. This identity is exact.
* `span_eq_top_of_isUnit_rnorm_comm`: if `N(xy − yx)` is a unit, then `1, x, y, xy` span
  the whole algebra.
* `rnorm_comm_eq` (Fricke): `N(xy − yx) = 4NₓN_y − N_yTₓ² − NₓT_y² − T_{xy}² + TₓT_yT_{xy}`.
  On `SL₂` this is `2 − tr(xyx⁻¹y⁻¹)`. Over a field, `N(xy − yx) = 0` holds exactly when
  `x` and `y` have a common eigenvector. That standard fact is not formalised here and is
  not needed.

## 2. Powers of a hyperbolic element keep the criterion

`pow_succ_eq`: `x^(n+1) = −N·bₙ + b_{n+1}·x`, where `b` is the Chebyshev-type sequence of
`(T, N)`. `seqB_succ_pos`: if `N = 1` and `T > 2` (hyperbolic) then `bₙ > 0` for all `n ≥ 1`.
Also `comm_affine`: `[α + βx, γ + δy] = βδ[x, y]`. Together these give
`span_eq_top_of_hyperbolic_powers`. If a multiplicatively closed `S` contains a positive power
of each of two hyperbolic elements with `N(xy − yx) ≠ 0`, then `S` spans. A finite-index
normal subgroup contains `g^index` of every `g` (Mathlib `Subgroup.pow_index_mem`), so this
is the shape the lattice question needs.

## 3. Bring's triangle group

Bring's surface is `ℍ/K`, with `K` the kernel of the epimorphism `Γ(2,5,4) → S₅` of index
120 (Kattan–Singerman, `kattan2024`, `library/arxiv-2402.08782v1`, §1). Lift a realisation of `Γ(2,5,4)`
to `SL(2,ℝ)` with generators `s, u`. The lift has `tr s = 0`, `tr u = 2cos(π/5) = φ` and
`tr su = 2cos(π/4) = √2`, so in the split model `T s = 0`, `T u = φ`, `T(su) = r`,
`N s = N u = 1`, `φ² = φ + 1`, `r² = 2`.

* `bring_relations`: these trace data force `s² = −1`, `u⁵ = −1`, `(su)⁴ = −1`. These are
  the `(2,5,4)` relations in `PSL(2)`.
* `bring_x_y`: `x = s·u²` and `y = u²·s` are hyperbolic (`T = φr > 2`). They satisfy
  `N(xy − yx) = 1 − φ ≠ 0`.
* `bring_span_eq_top`: hence any multiplicatively closed `S` that contains a positive power
  of every element of the monoid generated by `s, u` spans `M₂(R)`.
* `bring_left_mul_scalar`: a left multiplication `L_v` commuting with such an `S` is a
  scalar. This is `commutes_span_scalar` with its spanning hypothesis discharged.
* `bring_realisation`: an explicit `s, u` over `ℝ` satisfies every hypothesis, so they are
  not vacuous.

## What is still assumed

The theorems hold for any `(s, u)` with these traces, over any ordered field. Nothing here
proves that the lift of Bring's `Γ₄` is the subgroup they describe. That `Γ₄` has finite
index in a group generated by such `s, u` is the classical uniformisation of Bring's curve
by `Γ(2,5,4)` (Poincaré polygon theorem + Kattan–Singerman §1). The corpus does not define
`Γ₄` as a matrix group, so this is cited, not formalised. In the final theorems it enters as
the explicit hypothesis `hS`. Borel density is no longer needed.
-/

namespace QOU.Tetraplectic.Split

open Module

section CommRing

variable {R : Type*} [CommRing R]

/-- The reduced norm of the split quaternions (`= det` under `M₂(R)`). -/
def rnorm (x : SplitBringCone R) : R :=
  x.re * x.re + x.imI * x.imI - x.imJ * x.imJ - x.imK * x.imK

/-- The reduced trace (`= tr` under `M₂(R)`). -/
def rtr (x : SplitBringCone R) : R := 2 * x.re

theorem rnorm_mul (x y : SplitBringCone R) : rnorm (x * y) = rnorm x * rnorm y := by
  simp only [rnorm, QuaternionAlgebra.re_mul, QuaternionAlgebra.imI_mul,
    QuaternionAlgebra.imJ_mul, QuaternionAlgebra.imK_mul]
  ring

theorem rnorm_smul (c : R) (x : SplitBringCone R) : rnorm (c • x) = c ^ 2 * rnorm x := by
  simp only [rnorm, QuaternionAlgebra.re_smul, QuaternionAlgebra.imI_smul,
    QuaternionAlgebra.imJ_smul, QuaternionAlgebra.imK_smul, smul_eq_mul]
  ring

/-- **Cayley–Hamilton**: `x² = T(x)·x − N(x)`. -/
theorem mul_self_eq (x : SplitBringCone R) :
    x * x = rtr x • x - ((rnorm x : R) : SplitBringCone R) := by
  ext <;> simp [rtr, rnorm] <;> ring

/-- The reduced trace is cyclic. -/
theorem rtr_mul_comm (x y : SplitBringCone R) : rtr (x * y) = rtr (y * x) := by
  simp only [rtr, QuaternionAlgebra.re_mul]
  ring

/-- `T(x²) = T(x)² − 2N(x)`. -/
theorem rtr_mul_self (x : SplitBringCone R) :
    rtr (x * x) = rtr x ^ 2 - 2 * rnorm x := by
  simp only [rtr, rnorm, QuaternionAlgebra.re_mul]
  ring

/-- `T(a·b²) = T(b)·T(ab) − N(b)·T(a)`. -/
theorem rtr_mul_mul_self (a b : SplitBringCone R) :
    rtr (a * (b * b)) = rtr b * rtr (a * b) - rnorm b * rtr a := by
  simp only [rtr, rnorm, QuaternionAlgebra.re_mul, QuaternionAlgebra.imI_mul,
    QuaternionAlgebra.imJ_mul, QuaternionAlgebra.imK_mul]
  ring

/-- `T(a·B·a) = T(a)·T(Ba) − N(a)·T(B)`. -/
theorem rtr_conj (a B : SplitBringCone R) :
    rtr (a * B * a) = rtr a * rtr (B * a) - rnorm a * rtr B := by
  simp only [rtr, rnorm, QuaternionAlgebra.re_mul, QuaternionAlgebra.imI_mul,
    QuaternionAlgebra.imJ_mul, QuaternionAlgebra.imK_mul]
  ring

/-- **Fricke identity** for the split quaternions. On `SL₂` (`N = 1`) the right-hand side is
`2 − tr(xyx⁻¹y⁻¹)`. -/
theorem rnorm_comm_eq (x y : SplitBringCone R) :
    rnorm (x * y - y * x) =
      4 * rnorm x * rnorm y - rnorm y * rtr x ^ 2 - rnorm x * rtr y ^ 2
        - rtr (x * y) ^ 2 + rtr x * rtr y * rtr (x * y) := by
  simp only [rtr, rnorm, QuaternionAlgebra.re_mul, QuaternionAlgebra.imI_mul,
    QuaternionAlgebra.imJ_mul, QuaternionAlgebra.imK_mul, QuaternionAlgebra.re_sub,
    QuaternionAlgebra.imI_sub, QuaternionAlgebra.imJ_sub, QuaternionAlgebra.imK_sub]
  ring

/-- **The determinant of `1, x, y, xy` is `−N(xy − yx)/4`.** In the basis `1, i, j, k`, the
determinant of the four vectors `1, x, y, xy`, times `−4`, is the reduced norm of the
additive commutator. This is an exact identity in any commutative ring. -/
theorem det_one_x_y_xy (x y : SplitBringCone R) :
    (QuaternionAlgebra.basisOneIJK (-1 : R) 0 1).det ![1, x, y, x * y] * (-4)
      = rnorm (x * y - y * x) := by
  rw [Basis.det_apply, Matrix.det_succ_row_zero]
  simp only [Fin.sum_univ_succ, Matrix.det_fin_three, Basis.toMatrix_apply,
    QuaternionAlgebra.coe_basisOneIJK_repr, Fin.succAbove, Matrix.submatrix_apply]
  simp [rnorm, QuaternionAlgebra.re_mul, QuaternionAlgebra.imI_mul,
    QuaternionAlgebra.imJ_mul, QuaternionAlgebra.imK_mul, Fin.lt_def]
  ring

/-- **Spanning criterion.** If `N(xy − yx)` is a unit, then `1, x, y, xy` span `M₂(R)` (and
are a basis). -/
theorem span_eq_top_of_isUnit_rnorm_comm {x y : SplitBringCone R}
    (h : IsUnit (rnorm (x * y - y * x))) :
    Submodule.span R (Set.range ![1, x, y, x * y]) = ⊤ := by
  have hdet : IsUnit ((QuaternionAlgebra.basisOneIJK (-1 : R) 0 1).det ![1, x, y, x * y]) := by
    rw [← det_one_x_y_xy] at h
    exact isUnit_of_mul_isUnit_left h
  exact ((QuaternionAlgebra.basisOneIJK (-1 : R) 0 1).is_basis_iff_det.mpr hdet).2

/-- A submonoid containing `x, y` with `N(xy − yx)` a unit spans `M₂(R)`. -/
theorem span_submonoid_eq_top {S : Submonoid (SplitBringCone R)} {x y : SplitBringCone R}
    (hx : x ∈ S) (hy : y ∈ S) (h : IsUnit (rnorm (x * y - y * x))) :
    Submodule.span R (S : Set (SplitBringCone R)) = ⊤ := by
  apply eq_top_iff.mpr
  rw [← span_eq_top_of_isUnit_rnorm_comm h]
  apply Submodule.span_mono
  rintro _ ⟨i, rfl⟩
  fin_cases i
  · exact S.one_mem
  · exact hx
  · exact hy
  · exact S.mul_mem hx hy

/-- `[α + βx, γ + δy] = βδ·[x, y]`. -/
theorem comm_affine (α β γ δ : R) (x y : SplitBringCone R) :
    ((α : SplitBringCone R) + β • x) * ((γ : SplitBringCone R) + δ • y)
        - ((γ : SplitBringCone R) + δ • y) * ((α : SplitBringCone R) + β • x)
      = (β * δ) • (x * y - y * x) := by
  ext <;> simp <;> ring

/-- The coefficient sequence of powers: `b₀ = 0`, `b₁ = 1`, `b_{n+2} = T·b_{n+1} − N·bₙ`. -/
def seqB (T N : R) : ℕ → R
  | 0 => 0
  | 1 => 1
  | n + 2 => T * seqB T N (n + 1) - N * seqB T N n

/-- **Powers.** `x^(n+1) = −N(x)·bₙ + b_{n+1}·x`. -/
theorem pow_succ_eq (x : SplitBringCone R) (n : ℕ) :
    x ^ (n + 1) = ((-(rnorm x) * seqB (rtr x) (rnorm x) n : R) : SplitBringCone R)
      + seqB (rtr x) (rnorm x) (n + 1) • x := by
  induction n with
  | zero => simp [seqB]
  | succ n ih =>
    rw [pow_succ, ih, add_mul, smul_mul_assoc, mul_self_eq]
    have hb : seqB (rtr x) (rnorm x) (n + 2)
        = rtr x * seqB (rtr x) (rnorm x) (n + 1) - rnorm x * seqB (rtr x) (rnorm x) n := rfl
    rw [hb]
    ext <;> simp <;> ring

end CommRing

section Ordered

variable {R : Type*} [Field R] [LinearOrder R] [IsStrictOrderedRing R]

/-- For a hyperbolic trace `T > 2` with `N = 1`, the sequence is nonnegative and strictly
increasing. -/
theorem seqB_mono {T : R} (hT : 2 < T) (n : ℕ) :
    0 ≤ seqB T 1 n ∧ seqB T 1 n < seqB T 1 (n + 1) := by
  induction n with
  | zero => simp [seqB]
  | succ n ih =>
    obtain ⟨h0, h1⟩ := ih
    have hb : seqB T 1 (n + 2) = T * seqB T 1 (n + 1) - 1 * seqB T 1 n := rfl
    refine ⟨by linarith, ?_⟩
    rw [hb]
    nlinarith

/-- `b_{n+1} > 0` for a hyperbolic trace. -/
theorem seqB_succ_pos {T : R} (hT : 2 < T) (n : ℕ) : 0 < seqB T 1 (n + 1) := by
  obtain ⟨h0, h1⟩ := seqB_mono hT n
  linarith

/-- **Positive powers of two hyperbolic elements with a non-degenerate commutator span.**
Let `x, y` have `N = 1`, `T > 2`, and `N(xy − yx) ≠ 0`. If a submonoid `S` contains some
positive power of `x` and some positive power of `y`, then `S` spans `M₂(R)`. -/
theorem span_eq_top_of_hyperbolic_powers {S : Submonoid (SplitBringCone R)}
    {x y : SplitBringCone R} (hNx : rnorm x = 1) (hNy : rnorm y = 1)
    (hTx : 2 < rtr x) (hTy : 2 < rtr y) (hxy : rnorm (x * y - y * x) ≠ 0)
    {m n : ℕ} (hm : x ^ (m + 1) ∈ S) (hn : y ^ (n + 1) ∈ S) :
    Submodule.span R (S : Set (SplitBringCone R)) = ⊤ := by
  apply span_submonoid_eq_top hm hn
  rw [pow_succ_eq x m, pow_succ_eq y n, comm_affine, rnorm_smul, hNx, hNy]
  have hβ := seqB_succ_pos hTx m
  have hδ := seqB_succ_pos hTy n
  refine IsUnit.mk0 _ ?_
  exact mul_ne_zero (pow_ne_zero _ (mul_ne_zero hβ.ne' hδ.ne')) hxy

end Ordered

section Bring

/-! ## 3. Bring's `(2,5,4)` triangle group

Hypotheses of this section: `s, u` are unit-norm and `T s = 0`, `T u = φ`, `T(su) = r`, with
`φ² = φ + 1` and `r² = 2`. These are the traces of a lift to `SL(2)` of the generators
`X ↦ s`, `Y ↦ u` of `Γ(2,5,4)` (Kattan–Singerman's presentation, `XYZ = 1`). -/

variable {R : Type*} [Field R] [LinearOrder R] [IsStrictOrderedRing R]

/-- **The trace data force the `(2,5,4)` relations**: `s² = −1`, `u⁵ = −1`, `(su)⁴ = −1`,
i.e. `X² = Y⁵ = (XY)⁴ = 1` in `PSL(2)`. Generic `[CommRing K]`. -/
theorem bring_relations {K : Type*} [CommRing K] {s u : SplitBringCone K} {φ r : K}
    (hφ : φ * φ = φ + 1) (hr : r * r = 2)
    (hNs : rnorm s = 1) (hNu : rnorm u = 1)
    (hTs : rtr s = 0) (hTu : rtr u = φ) (hTsu : rtr (s * u) = r) :
    s * s = -1 ∧ u ^ 5 = -1 ∧ (s * u) ^ 4 = -1 := by
  refine ⟨?_, ?_, ?_⟩
  · rw [mul_self_eq, hTs, hNs, zero_smul, zero_sub]
    simp
  · rw [show (5 : ℕ) = 4 + 1 from rfl, pow_succ_eq, hTu, hNu]
    have h4 : seqB φ (1 : K) 4 = 1 := by
      simp only [seqB]; linear_combination (φ + 1) * hφ
    have h5 : seqB φ (1 : K) (4 + 1) = 0 := by
      simp only [seqB]; linear_combination (φ * φ + φ - 1) * hφ
    rw [h4, h5, zero_smul, add_zero]
    simp
  · have hN : rnorm (s * u) = 1 := by rw [rnorm_mul, hNs, hNu, one_mul]
    rw [show (4 : ℕ) = 3 + 1 from rfl, pow_succ_eq, hTsu, hN]
    have h3 : seqB r (1 : K) 3 = 1 := by
      simp only [seqB]; linear_combination hr
    have h4 : seqB r (1 : K) (3 + 1) = 0 := by
      simp only [seqB]; linear_combination r * hr
    rw [h3, h4, zero_smul, add_zero]
    simp

/-- **Two hyperbolic elements of the triangle group with a non-degenerate commutator.**
`x = s·u²` and `y = u²·s` have `N = 1`, `T = φr > 2`, `T(xy) = φ` and
`N(xy − yx) = 1 − φ ≠ 0`. -/
theorem bring_x_y {s u : SplitBringCone R} {φ r : R}
    (hφ : φ * φ = φ + 1) (hr : r * r = 2) (hφ0 : 0 < φ) (hr0 : 0 < r)
    (hNs : rnorm s = 1) (hNu : rnorm u = 1)
    (hTs : rtr s = 0) (hTu : rtr u = φ) (hTsu : rtr (s * u) = r) :
    rnorm (s * (u * u)) = 1 ∧ rnorm ((u * u) * s) = 1
      ∧ rtr (s * (u * u)) = φ * r ∧ rtr ((u * u) * s) = φ * r ∧ 2 < φ * r
      ∧ rnorm (s * (u * u) * ((u * u) * s) - (u * u) * s * (s * (u * u))) = 1 - φ
      ∧ 1 - φ ≠ 0 := by
  have hNA : rnorm (u * u) = 1 := by rw [rnorm_mul, hNu, one_mul]
  have hNx : rnorm (s * (u * u)) = 1 := by rw [rnorm_mul, hNs, hNA, one_mul]
  have hNy : rnorm ((u * u) * s) = 1 := by rw [rnorm_mul, hNs, hNA, one_mul]
  have hTx : rtr (s * (u * u)) = φ * r := by
    rw [rtr_mul_mul_self, hTu, hTsu, hNu, hTs]; ring
  have hTy : rtr ((u * u) * s) = φ * r := by rw [← rtr_mul_comm, hTx]
  have hTA : rtr (u * u) = φ * φ - 2 := by rw [rtr_mul_self, hTu, hNu]; ring
  have hTxy : rtr (s * (u * u) * ((u * u) * s)) = φ := by
    have e : s * (u * u) * ((u * u) * s) = s * ((u * u) * (u * u)) * s := by
      simp only [mul_assoc]
    rw [e, rtr_conj, hTs, hNs, rtr_mul_self, hTA, hNA]
    linear_combination (-(φ * φ + φ - 2)) * hφ
  have hgt : 2 < φ * r := by
    have hφ1 : 1 < φ := by nlinarith
    have hsq : (φ * r) * (φ * r) = 2 * φ + 2 := by linear_combination 2 * hφ + (φ * φ) * hr
    nlinarith [mul_pos hφ0 hr0]
  refine ⟨hNx, hNy, hTx, hTy, hgt, ?_, ?_⟩
  · rw [rnorm_comm_eq, hNx, hNy, hTx, hTy, hTxy]
    linear_combination (φ * φ * φ - 2 * φ * φ) * hr + (2 * φ - 3) * hφ
  · intro h
    have : φ = 1 := by linear_combination -h
    rw [this] at hφ
    norm_num at hφ

/-- **Bring's triangle group spans.** Let `s, u` be as in `bring_relations`, with `φ, r > 0`.
Let `S` be multiplicatively closed and contain some positive power of every element of
the monoid generated by `s` and `u`. That holds when `S` is a finite-index normal subgroup,
such as the lift of Bring's `Γ₄`, by Mathlib `Subgroup.pow_index_mem`. Then `S` spans
`M₂(R)`. -/
theorem bring_span_eq_top {s u : SplitBringCone R} {φ r : R}
    (hφ : φ * φ = φ + 1) (hr : r * r = 2) (hφ0 : 0 < φ) (hr0 : 0 < r)
    (hNs : rnorm s = 1) (hNu : rnorm u = 1)
    (hTs : rtr s = 0) (hTu : rtr u = φ) (hTsu : rtr (s * u) = r)
    {S : Submonoid (SplitBringCone R)}
    (hS : ∀ g ∈ Submonoid.closure ({s, u} : Set (SplitBringCone R)), ∃ n : ℕ, g ^ (n + 1) ∈ S) :
    Submodule.span R (S : Set (SplitBringCone R)) = ⊤ := by
  obtain ⟨hNx, hNy, hTx, hTy, hgt, hcomm, hne⟩ := bring_x_y hφ hr hφ0 hr0 hNs hNu hTs hTu hTsu
  have hs : s ∈ Submonoid.closure ({s, u} : Set (SplitBringCone R)) :=
    Submonoid.subset_closure (by simp)
  have hu : u ∈ Submonoid.closure ({s, u} : Set (SplitBringCone R)) :=
    Submonoid.subset_closure (by simp)
  obtain ⟨m, hm⟩ := hS _ (Submonoid.mul_mem _ hs (Submonoid.mul_mem _ hu hu))
  obtain ⟨n, hn⟩ := hS _ (Submonoid.mul_mem _ (Submonoid.mul_mem _ hu hu) hs)
  exact span_eq_top_of_hyperbolic_powers hNx hNy (hTx ▸ hgt) (hTy ▸ hgt)
    (by rw [hcomm]; exact hne) hm hn

/-- **`commutes_span_scalar` with its spanning hypothesis discharged.** Under the hypotheses
of `bring_span_eq_top`, a left multiplication `L_v` that commutes with every element of
`S` is a scalar. So on a quotient by such an `S`, the second complex structure of the Hopf
model does not descend. -/
theorem bring_left_mul_scalar {s u : SplitBringCone R} {φ r : R}
    (hφ : φ * φ = φ + 1) (hr : r * r = 2) (hφ0 : 0 < φ) (hr0 : 0 < r)
    (hNs : rnorm s = 1) (hNu : rnorm u = 1)
    (hTs : rtr s = 0) (hTu : rtr u = φ) (hTsu : rtr (s * u) = r)
    {S : Submonoid (SplitBringCone R)}
    (hS : ∀ g ∈ Submonoid.closure ({s, u} : Set (SplitBringCone R)), ∃ n : ℕ, g ^ (n + 1) ∈ S)
    {v : SplitBringCone R} (hv : ∀ γ ∈ S, v * γ = γ * v) :
    v.imI = 0 ∧ v.imJ = 0 ∧ v.imK = 0 := by
  have htop := bring_span_eq_top hφ hr hφ0 hr0 hNs hNu hTs hTu hTsu hS
  refine commutes_span_scalar (S := (S : Set (SplitBringCone R)))
    (fun x hx => by linarith) hv (by rw [htop]; trivial) (by rw [htop]; trivial)

end Bring

/-- **The hypotheses are not vacuous.** Over `ℝ`, with `φ = 2cos(π/5)` and `r = 2cos(π/4)`,
the elements `s = i` and `u = φ/2 − (r/2)·i + (√(φ−1)/2)·j` satisfy every hypothesis of
`bring_span_eq_top`. -/
theorem bring_realisation :
    ∃ (s u : SplitBringCone ℝ) (φ r : ℝ),
      φ = 2 * Real.cos (Real.pi / 5) ∧ r = 2 * Real.cos (Real.pi / 4)
      ∧ φ * φ = φ + 1 ∧ r * r = 2 ∧ 0 < φ ∧ 0 < r
      ∧ rnorm s = 1 ∧ rnorm u = 1 ∧ rtr s = 0 ∧ rtr u = φ ∧ rtr (s * u) = r := by
  set φ : ℝ := (1 + Real.sqrt 5) / 2 with hφdef
  set r : ℝ := Real.sqrt 2 with hrdef
  have h5 : Real.sqrt 5 * Real.sqrt 5 = 5 := Real.mul_self_sqrt (by norm_num)
  have h2 : r * r = 2 := Real.mul_self_sqrt (by norm_num)
  have hφ : φ * φ = φ + 1 := by rw [hφdef]; linear_combination h5 / 4
  have hφ0 : 0 < φ := by rw [hφdef]; positivity
  have hr0 : 0 < r := by rw [hrdef]; positivity
  have hφ1 : 0 ≤ φ - 1 := by nlinarith
  set w : ℝ := Real.sqrt (φ - 1) with hwdef
  have hw : w * w = φ - 1 := Real.mul_self_sqrt hφ1
  refine ⟨⟨0, 1, 0, 0⟩, ⟨φ / 2, -(r / 2), w / 2, 0⟩, φ, r, ?_, ?_, hφ, h2, hφ0, hr0,
    ?_, ?_, ?_, ?_, ?_⟩
  · rw [Real.cos_pi_div_five, hφdef]; ring
  · rw [Real.cos_pi_div_four, hrdef]; ring
  · simp [rnorm]
  · simp only [rnorm]; linear_combination hφ / 4 + h2 / 4 - hw / 4
  · simp [rtr]
  · simp [rtr]; ring
  · simp [rtr]; ring

end QOU.Tetraplectic.Split
