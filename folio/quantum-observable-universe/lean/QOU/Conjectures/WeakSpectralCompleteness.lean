import Mathlib.Tactic

/-!
# QOU.Conjectures.WeakSpectralCompleteness — EW idempotent decomposition

Formalisation of `prop:weak-spectral-completeness`
(`folio/quantum-observable-universe/mass-theory/weak-spectral-completeness.md`).

## What is proved, and what is conjectural

The EW carriers `{T(2,4), T(2,6), T(2,8)}` are assigned to the three
far-commuting generators `σ₁, σ₃, σ₅` of `H₆(q)` (strand pairs 1–2, 3–4,
5–6).  Each generator satisfies the Hecke quadratic
`σ² = (q − q⁻¹) σ + 1`.

* **Per carrier** (one copy of `H₂(q) ≅ R ⊕ R`): the two idempotents
  `e⁺(σ) = (σ + q⁻¹)/[2]_q`, `e⁻(σ) = (q − σ)/[2]_q` satisfy
  `e⁺ + e⁻ = 1`, `e⁺ e⁻ = 0`.  `H₂(q)` has exactly these two primitive
  idempotents, so the six per-carrier projectors `e_X^±` are **three
  copies of the same pair**, one copy per generator — they are *not*
  pairwise orthogonal (`e_W⁺ e_Z⁺ ≠ 0` in general).
* **Joint** (the commutative parabolic subalgebra
  `H₂(q)^{⊗3} ≅ R⁸` generated by `σ₁, σ₃, σ₅`): the eight products
  `E(a,b,c) = e^a(σ₁) e^b(σ₃) e^c(σ₅)` are idempotent, pairwise
  orthogonal, and sum to `1`.  This is **proved** below
  (`joint_idempotent`, `joint_orthogonal`, `joint_sum_eq_one`), over a
  generic commutative `R`-algebra (§7c); it is applied to the
  commutative subalgebra generated by the three commuting generators.
* **Exhaustion — proved** (`carrierAlgebra_le_adjoin`,
  `adjoin_le_carrierAlgebra`, `weak_spectral_completeness`).  The EW-sector
  content is the subalgebra `carrierAlgebra` generated by the carriers
  `σ₁⁴, σ₃⁶, σ₅⁸` of `thm:hoefsmit-ew-cell-content`.  It lies in
  `Algebra.adjoin R {σ₁, σ₃, σ₅}` with no hypothesis, and equals it when each
  `σ` is a Hecke generator and `q^{2k} − q^{-2k}` is a unit (`k = 2, 3, 4`):
  `σⁿ = aₙ σ + bₙ` with `aₙ (q + q⁻¹) = qⁿ − (−q⁻¹)ⁿ`, so `σ` is recovered
  from `σ^{2k}`.  The former conjecture class `WeakSpectralCompleteness` is
  kept as a predicate and now has a derived instance for `carrierAlgebra`.
* **Not proved here**: the joint ranks `11, 9×6, 11` on `⊕_{λ⊢6} V_λ`
  (checked by exact computation over `ℚ(q)`, not in Lean), and the physical
  identification `W ↔ σ₁⁴, Z ↔ σ₃⁶, H ↔ σ₅⁸`, which is an input from
  `thm:hoefsmit-ew-cell-content`.

The cell-content trace `cellTrace` is the trace of `σ₁⁴σ₃⁶σ₅⁸` over the
20 *pure* seminormal vectors only (multiplicities `(4,2,1,3,3,1,2,4)`),
a partial trace; its bar-self-duality is proved.

LaTeX label: `prop:weak-spectral-completeness`

## References

- [leitner2026] §"Weak-sector spectral completeness — Hoefsmit n=6 form"
-/

namespace QOU.Conjectures

section CellTrace

variable {R : Type*} [Field R]

/-- The eight pure-pattern cell-content multiplicities of the EW sector
    `(4, 2, 1, 3, 3, 1, 2, 4)`: the number of *pure* seminormal basis
    vectors (all of `σ₁, σ₃, σ₅` diagonal) in each sym/alt pattern. -/
def cellMultiplicities : List ℕ := [4, 2, 1, 3, 3, 1, 2, 4]

/-- The pure multiplicities sum to `20` (out of the
    `∑_{λ⊢6} f_λ = 76` seminormal-basis vectors). -/
theorem cellMultiplicities_sum : cellMultiplicities.sum = 20 := by decide

/-- The pure (partial) cell-content trace of `σ₁⁴ σ₃⁶ σ₅⁸`:
    `4(q¹⁸+q⁻¹⁸) + 2(q¹⁰+q⁻¹⁰) + (q⁶+q⁻⁶) + 3(q²+q⁻²)`. -/
noncomputable def cellTrace (q : R) : R :=
  4 * (q ^ 18 + q ^ (-18 : ℤ)) +
  2 * (q ^ 10 + q ^ (-10 : ℤ)) +
  1 * (q ^ 6 + q ^ (-6 : ℤ)) +
  3 * (q ^ 2 + q ^ (-2 : ℤ))

/-- **Bar T-duality at the trace level.**  The pure cell-content trace is
    invariant under `ι : q ↦ q⁻¹`. -/
theorem cellTrace_bar_self_dual (q : R) (hq : q ≠ 0) :
    cellTrace q⁻¹ = cellTrace q := by
  unfold cellTrace
  rw [inv_eq_one_div]
  field_simp
  ring

end CellTrace

section HeckeDefs

variable {R : Type*} [CommRing R] {A : Type*} [Ring A] [Algebra R A]

/-- Hecke data: `qi = q⁻¹` and `d = [2]_q⁻¹ = (q + q⁻¹)⁻¹` in `R`. -/
structure HeckeScalars (R : Type*) [CommRing R] where
  q : R
  qi : R
  d : R
  q_mul_qi : q * qi = 1
  d_mul_two : d * (q + qi) = 1

/-- `s` satisfies the Hecke quadratic `s² = (q − q⁻¹) s + 1`. -/
def IsHeckeGen (h : HeckeScalars R) (s : A) : Prop :=
  s * s = algebraMap R A (h.q - h.qi) * s + 1

/-- The two per-carrier idempotents of one copy of `H₂(q)`:
    `e true = (s + q⁻¹)/[2]_q` (sym), `e false = (q − s)/[2]_q` (alt). -/
def perCarrier (h : HeckeScalars R) (s : A) : Bool → A
  | true => algebraMap R A h.d * (s + algebraMap R A h.qi)
  | false => algebraMap R A h.d * (algebraMap R A h.q - s)

/-- The eight joint projectors `E(a,b,c) = e^a(s₁) e^b(s₃) e^c(s₅)`. -/
def joint (h : HeckeScalars R) (s₁ s₃ s₅ : A) (p : Bool × Bool × Bool) : A :=
  perCarrier h s₁ p.1 * perCarrier h s₃ p.2.1 * perCarrier h s₅ p.2.2

end HeckeDefs

section Idempotents

variable {R : Type*} [CommRing R] {A : Type*} [CommRing A] [Algebra R A]

theorem perCarrier_add (h : HeckeScalars R) (s : A) :
    perCarrier h s true + perCarrier h s false = 1 := by
  simp only [perCarrier]
  have := congrArg (algebraMap R A) h.d_mul_two
  simp only [map_mul, map_add, map_one] at this
  linear_combination this

theorem perCarrier_mul_zero (h : HeckeScalars R) {s : A}
    (hs : IsHeckeGen h s) :
    perCarrier h s true * perCarrier h s false = 0 := by
  simp only [perCarrier]
  unfold IsHeckeGen at hs
  have hq := congrArg (algebraMap R A) h.q_mul_qi
  simp only [map_mul, map_one, map_sub] at hq hs
  linear_combination (-(algebraMap R A h.d) ^ 2) * hs
    + (algebraMap R A h.d) ^ 2 * hq

theorem perCarrier_mul (h : HeckeScalars R) {s : A} (hs : IsHeckeGen h s)
    (a b : Bool) :
    perCarrier h s a * perCarrier h s b =
      if a = b then perCarrier h s a else 0 := by
  have hadd := perCarrier_add h s
  have h0 := perCarrier_mul_zero h hs
  cases a <;> cases b <;> simp
  · -- false * false
    linear_combination perCarrier h s false * hadd - h0
  · rw [mul_comm]; exact h0
  · exact h0
  · linear_combination perCarrier h s true * hadd - h0

theorem joint_mul (h : HeckeScalars R) {s₁ s₃ s₅ : A}
    (h₁ : IsHeckeGen h s₁) (h₃ : IsHeckeGen h s₃) (h₅ : IsHeckeGen h s₅)
    (p p' : Bool × Bool × Bool) :
    joint h s₁ s₃ s₅ p * joint h s₁ s₃ s₅ p' =
      if p = p' then joint h s₁ s₃ s₅ p else 0 := by
  obtain ⟨a, b, c⟩ := p
  obtain ⟨a', b', c'⟩ := p'
  have e : joint h s₁ s₃ s₅ (a, b, c) * joint h s₁ s₃ s₅ (a', b', c') =
      (perCarrier h s₁ a * perCarrier h s₁ a') *
      (perCarrier h s₃ b * perCarrier h s₃ b') *
      (perCarrier h s₅ c * perCarrier h s₅ c') := by
    simp only [joint]; ring
  rw [e, perCarrier_mul h h₁, perCarrier_mul h h₃, perCarrier_mul h h₅]
  by_cases ha : a = a' <;> by_cases hb : b = b' <;> by_cases hc : c = c' <;>
    simp [ha, hb, hc, joint]

/-- Each joint projector is idempotent. -/
theorem joint_idempotent (h : HeckeScalars R) {s₁ s₃ s₅ : A}
    (h₁ : IsHeckeGen h s₁) (h₃ : IsHeckeGen h s₃) (h₅ : IsHeckeGen h s₅)
    (p : Bool × Bool × Bool) :
    joint h s₁ s₃ s₅ p * joint h s₁ s₃ s₅ p = joint h s₁ s₃ s₅ p := by
  rw [joint_mul h h₁ h₃ h₅, if_pos rfl]

/-- Distinct joint projectors are orthogonal. -/
theorem joint_orthogonal (h : HeckeScalars R) {s₁ s₃ s₅ : A}
    (h₁ : IsHeckeGen h s₁) (h₃ : IsHeckeGen h s₃) (h₅ : IsHeckeGen h s₅)
    {p p' : Bool × Bool × Bool} (hne : p ≠ p') :
    joint h s₁ s₃ s₅ p * joint h s₁ s₃ s₅ p' = 0 := by
  rw [joint_mul h h₁ h₃ h₅, if_neg hne]

/-- The eight joint projectors sum to `1` (no Hecke relation needed). -/
theorem joint_sum_eq_one (h : HeckeScalars R) (s₁ s₃ s₅ : A) :
    ∑ p : Bool × Bool × Bool, joint h s₁ s₃ s₅ p = 1 := by
  simp only [Fintype.sum_prod_type, Fintype.sum_bool, joint]
  have h1 := perCarrier_add h s₁
  have h3 := perCarrier_add h s₃
  have h5 := perCarrier_add h s₅
  linear_combination
    (perCarrier h s₃ true + perCarrier h s₃ false) *
      (perCarrier h s₅ true + perCarrier h s₅ false) * h1
    + (perCarrier h s₅ true + perCarrier h s₅ false) * h3 + h5

end Idempotents

section Exhaustion

/-! ### Exhaustion: the EW carrier subalgebra

`thm:hoefsmit-ew-cell-content` realises the EW carriers as the powers
`σ₁⁴, σ₃⁶, σ₅⁸` on the three disjoint strand pairs.  The **EW-sector
content** is taken to be the subalgebra they generate,
`carrierAlgebra = adjoin R {σ₁⁴, σ₃⁶, σ₅⁸}`.

* `carrierAlgebra_le_adjoin`: it lies in `adjoin R {σ₁, σ₃, σ₅}` (no
  hypotheses: each carrier is a power of its generator).
* `adjoin_le_carrierAlgebra`: conversely, if each `σ` satisfies the Hecke
  quadratic and `q^{2k} − q^{-2k}` is a unit for `k = 2, 3, 4`, each
  generator is a polynomial in its carrier, so the two subalgebras are
  equal.  The mechanism is the two-eigenvalue reduction
  `σⁿ = aₙ σ + bₙ` with `aₙ · [2]_q = qⁿ − (−q⁻¹)ⁿ`. -/

variable {R : Type*} [CommRing R] {A : Type*} [Ring A] [Algebra R A]

/-- Coefficients `(aₙ, bₙ)` with `σⁿ = aₙ σ + bₙ` for a Hecke generator. -/
def heckeCoeff (h : HeckeScalars R) : ℕ → R × R
  | 0 => (0, 1)
  | n + 1 => ((h.q - h.qi) * (heckeCoeff h n).1 + (heckeCoeff h n).2,
      (heckeCoeff h n).1)

/-- Two-eigenvalue reduction: `σⁿ = aₙ • σ + bₙ • 1`. -/
theorem pow_eq_heckeCoeff (h : HeckeScalars R) {s : A} (hs : IsHeckeGen h s)
    (n : ℕ) :
    s ^ n = (heckeCoeff h n).1 • s + (heckeCoeff h n).2 • (1 : A) := by
  unfold IsHeckeGen at hs
  rw [← Algebra.smul_def] at hs
  induction n with
  | zero => simp [heckeCoeff]
  | succ n ih =>
    rw [pow_succ, ih]
    simp only [heckeCoeff, add_mul, smul_mul_assoc, one_mul, hs, add_smul,
      mul_smul, smul_add]
    module

/-- Closed form of the leading coefficient: `aₙ (q + q⁻¹) = qⁿ − (−q⁻¹)ⁿ`
    (and `bₙ (q + q⁻¹) = q⁻¹ qⁿ + q (−q⁻¹)ⁿ`). -/
theorem heckeCoeff_closed (h : HeckeScalars R) (n : ℕ) :
    (heckeCoeff h n).1 * (h.q + h.qi) = h.q ^ n - (-h.qi) ^ n ∧
    (heckeCoeff h n).2 * (h.q + h.qi) = h.qi * h.q ^ n + h.q * (-h.qi) ^ n := by
  induction n with
  | zero => simp [heckeCoeff]; ring
  | succ n ih =>
    obtain ⟨ha, hb⟩ := ih
    refine ⟨?_, ?_⟩
    · simp only [heckeCoeff]
      linear_combination (h.q - h.qi) * ha + hb
    · simp only [heckeCoeff]
      linear_combination ha - (h.q ^ n - (-h.qi) ^ n) * h.q_mul_qi

/-- If `q^{2k} − q^{-2k}` is a unit, the leading coefficient `a_{2k}` is a unit. -/
theorem heckeCoeff_even_isUnit (h : HeckeScalars R) (k : ℕ)
    (hu : IsUnit (h.q ^ (2 * k) - h.qi ^ (2 * k))) :
    IsUnit (heckeCoeff h (2 * k)).1 := by
  have e := (heckeCoeff_closed h (2 * k)).1
  rw [show (-h.qi) ^ (2 * k) = h.qi ^ (2 * k) by rw [pow_mul, pow_mul, neg_sq]] at e
  rw [← e] at hu
  exact isUnit_of_mul_isUnit_left hu

/-- A Hecke generator lies in the subalgebra generated by its even power
    `σ^{2k}`, provided `q^{2k} − q^{-2k}` is a unit. -/
theorem gen_mem_adjoin_pow (h : HeckeScalars R) {s : A} (hs : IsHeckeGen h s)
    (k : ℕ) (hu : IsUnit (h.q ^ (2 * k) - h.qi ^ (2 * k))) :
    s ∈ Algebra.adjoin R {s ^ (2 * k)} := by
  obtain ⟨u, hu'⟩ := heckeCoeff_even_isUnit h k hu
  have hp := pow_eq_heckeCoeff h hs (2 * k)
  rw [← hu'] at hp
  have hsol : s = (↑u⁻¹ : R) • (s ^ (2 * k) - (heckeCoeff h (2 * k)).2 • (1 : A)) := by
    rw [hp, add_sub_cancel_right, smul_smul, Units.inv_mul, one_smul]
  have hm : (↑u⁻¹ : R) • (s ^ (2 * k) - (heckeCoeff h (2 * k)).2 • (1 : A)) ∈
      Algebra.adjoin R {s ^ (2 * k)} :=
    Subalgebra.smul_mem _ (Subalgebra.sub_mem _
      (Algebra.subset_adjoin (Set.mem_singleton _))
      (Subalgebra.smul_mem _ (Subalgebra.one_mem _) _)) _
  rwa [← hsol] at hm

variable (R) in
/-- The EW carrier subalgebra `adjoin R {σ₁⁴, σ₃⁶, σ₅⁸}`
    (carriers `T(2,4), T(2,6), T(2,8)` of `thm:hoefsmit-ew-cell-content`). -/
def carrierAlgebra (s₁ s₃ s₅ : A) : Subalgebra R A :=
  Algebra.adjoin R {s₁ ^ 4, s₃ ^ 6, s₅ ^ 8}

/-- **Exhaustion.** The carrier subalgebra lies in `adjoin R {σ₁, σ₃, σ₅}`. -/
theorem carrierAlgebra_le_adjoin (s₁ s₃ s₅ : A) :
    carrierAlgebra R s₁ s₃ s₅ ≤ Algebra.adjoin R {s₁, s₃, s₅} := by
  refine Algebra.adjoin_le ?_
  have m : ∀ x ∈ ({s₁, s₃, s₅} : Set A), x ∈ Algebra.adjoin R {s₁, s₃, s₅} :=
    fun x hx => Algebra.subset_adjoin hx
  intro x hx
  rcases hx with rfl | rfl | rfl
  · exact Subalgebra.pow_mem _ (m _ (by simp)) _
  · exact Subalgebra.pow_mem _ (m _ (by simp)) _
  · exact Subalgebra.pow_mem _ (m _ (by simp)) _

/-- **Converse.** Under the Hecke quadratic and the unit conditions
    `q^{2k} − q^{-2k} ∈ Rˣ` (`k = 2, 3, 4`), each generator is recovered
    from its carrier. -/
theorem adjoin_le_carrierAlgebra (h : HeckeScalars R) {s₁ s₃ s₅ : A}
    (h₁ : IsHeckeGen h s₁) (h₃ : IsHeckeGen h s₃) (h₅ : IsHeckeGen h s₅)
    (u₂ : IsUnit (h.q ^ 4 - h.qi ^ 4)) (u₃ : IsUnit (h.q ^ 6 - h.qi ^ 6))
    (u₄ : IsUnit (h.q ^ 8 - h.qi ^ 8)) :
    Algebra.adjoin R {s₁, s₃, s₅} ≤ carrierAlgebra R s₁ s₃ s₅ := by
  refine Algebra.adjoin_le ?_
  intro x hx
  rcases hx with rfl | rfl | rfl
  · exact Algebra.adjoin_mono (by simp) (gen_mem_adjoin_pow h h₁ 2 u₂)
  · exact Algebra.adjoin_mono (by simp) (gen_mem_adjoin_pow h h₃ 3 u₃)
  · exact Algebra.adjoin_mono (by simp) (gen_mem_adjoin_pow h h₅ 4 u₄)

/-- The joint projectors lie in `adjoin R {σ₁, σ₃, σ₅}`. -/
theorem joint_mem_adjoin (h : HeckeScalars R) (s₁ s₃ s₅ : A)
    (p : Bool × Bool × Bool) :
    joint h s₁ s₃ s₅ p ∈ Algebra.adjoin R {s₁, s₃, s₅} := by
  have m : ∀ x ∈ ({s₁, s₃, s₅} : Set A), x ∈ Algebra.adjoin R {s₁, s₃, s₅} :=
    fun x hx => Algebra.subset_adjoin hx
  have pc : ∀ (s : A), s ∈ Algebra.adjoin R {s₁, s₃, s₅} → ∀ b : Bool,
      perCarrier h s b ∈ Algebra.adjoin R {s₁, s₃, s₅} := by
    intro s hs b
    cases b
    · exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
        (Subalgebra.sub_mem _ (Subalgebra.algebraMap_mem _ _) hs)
    · exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _)
        (Subalgebra.add_mem _ hs (Subalgebra.algebraMap_mem _ _))
  exact Subalgebra.mul_mem _ (Subalgebra.mul_mem _ (pc _ (m _ (by simp)) _)
    (pc _ (m _ (by simp)) _)) (pc _ (m _ (by simp)) _)

/-- **`prop:weak-spectral-completeness`.**  The EW carrier subalgebra lies in
    `adjoin R {σ₁, σ₃, σ₅}`; under the Hecke quadratic and the unit conditions
    it *equals* it; and the eight joint projectors lie in the carrier algebra. -/
theorem weak_spectral_completeness (h : HeckeScalars R) {s₁ s₃ s₅ : A}
    (h₁ : IsHeckeGen h s₁) (h₃ : IsHeckeGen h s₃) (h₅ : IsHeckeGen h s₅)
    (u₂ : IsUnit (h.q ^ 4 - h.qi ^ 4)) (u₃ : IsUnit (h.q ^ 6 - h.qi ^ 6))
    (u₄ : IsUnit (h.q ^ 8 - h.qi ^ 8)) :
    carrierAlgebra R s₁ s₃ s₅ = Algebra.adjoin R {s₁, s₃, s₅} ∧
    ∀ p, joint h s₁ s₃ s₅ p ∈ carrierAlgebra R s₁ s₃ s₅ := by
  have e := le_antisymm (carrierAlgebra_le_adjoin s₁ s₃ s₅)
    (adjoin_le_carrierAlgebra h h₁ h₃ h₅ u₂ u₃ u₄)
  exact ⟨e, fun p => e ▸ joint_mem_adjoin h s₁ s₃ s₅ p⟩

end Exhaustion

/-- Exhaustion predicate: a subalgebra `ew` lies in `adjoin R {σ₁, σ₃, σ₅}`.
Formerly the open conjecture class of `conj:weak-spectral-completeness`;
for the corpus EW content `ew = carrierAlgebra R σ₁ σ₃ σ₅` it is now the
theorem `carrierAlgebra_le_adjoin`, recorded as the instance below. -/
class WeakSpectralCompleteness (R : Type*) [CommRing R]
    (A : Type*) [Ring A] [Algebra R A]
    (s₁ s₃ s₅ : A) (ew : Subalgebra R A) : Prop where
  /-- Exhaustion. -/
  exhausts : ew ≤ Algebra.adjoin R {s₁, s₃, s₅}

/-- Derived, not assumed: exhaustion for the EW carrier subalgebra. -/
instance carrierAlgebra_weakSpectralCompleteness {R : Type*} [CommRing R]
    {A : Type*} [Ring A] [Algebra R A] (s₁ s₃ s₅ : A) :
    WeakSpectralCompleteness R A s₁ s₃ s₅ (carrierAlgebra R s₁ s₃ s₅) :=
  ⟨carrierAlgebra_le_adjoin s₁ s₃ s₅⟩

end QOU.Conjectures
