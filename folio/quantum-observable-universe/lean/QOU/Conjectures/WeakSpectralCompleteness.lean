import Mathlib.Tactic

/-!
# QOU.Conjectures.WeakSpectralCompleteness — EW idempotent decomposition

Formalisation of `conj:weak-spectral-completeness`
(`folio/quantum-observable-universe/mass-theory/weak-spectral-completeness.md`).

## What is proved, and what is conjectural

The EW carriers `{T(2,4), T(2,6), T(2,8)}` are assigned to the three
far-commuting generators `σ₁, σ₃, σ₅` of `H₆(q)` (strand pairs 1–2, 3–4,
5–6).  Each generator satisfies the Hecke quadratic
`σ² = (q − q⁻¹) σ + 1`.

* **Per carrier** (one copy of `H₂(q) ≅ R ⊕ R`): the two idempotents
  `e⁺(σ) = (σ + q⁻¹)/[2]_q`, `e⁻(σ) = (q − σ)/[2]_q` satisfy
  `e⁺ + e⁻ = 1`, `e⁺ e⁻ = 0`.  `H₂(q)` has exactly these two primitive
  idempotents, so the six per-carrier projectors `e_X^±` are **three
  copies of the same pair**, one copy per generator — they are *not*
  pairwise orthogonal (`e_W⁺ e_Z⁺ ≠ 0` in general).
* **Joint** (the commutative parabolic subalgebra
  `H₂(q)^{⊗3} ≅ R⁸` generated by `σ₁, σ₃, σ₅`): the eight products
  `E(a,b,c) = e^a(σ₁) e^b(σ₃) e^c(σ₅)` are idempotent, pairwise
  orthogonal, and sum to `1`.  This is **proved** below
  (`joint_idempotent`, `joint_orthogonal`, `joint_sum_eq_one`), over a
  generic commutative `R`-algebra (§7c); it is applied to the
  commutative subalgebra generated by the three commuting generators.
* **Conjectural** (class `WeakSpectralCompleteness`, no instance): that
  the EW-sector content of the Hecke action is *exhausted* by this
  subalgebra, i.e. lies in `Algebra.adjoin R {σ₁, σ₃, σ₅}`.  The
  EW-sector subalgebra is model data supplied as a parameter.

The cell-content trace `cellTrace` is the trace of `σ₁⁴σ₃⁶σ₅⁸` over the
20 *pure* seminormal vectors only (multiplicities `(4,2,1,3,3,1,2,4)`),
a partial trace; its bar-self-duality is proved.

LaTeX label: `conj:weak-spectral-completeness`

## References

- [leitner2026] §"Weak-sector spectral completeness — Hoefsmit n=6 form"
-/

namespace QOU.Conjectures

section CellTrace

variable {R : Type*} [Field R]

/-- The eight pure-pattern cell-content multiplicities of the EW sector
    `(4, 2, 1, 3, 3, 1, 2, 4)`: the number of *pure* seminormal basis
    vectors (all of `σ₁, σ₃, σ₅` diagonal) in each sym/alt pattern. -/
def cellMultiplicities : List ℕ := [4, 2, 1, 3, 3, 1, 2, 4]

/-- The pure multiplicities sum to `20` (out of the
    `∑_{λ⊢6} f_λ = 76` seminormal-basis vectors). -/
theorem cellMultiplicities_sum : cellMultiplicities.sum = 20 := by decide

/-- The pure (partial) cell-content trace of `σ₁⁴ σ₃⁶ σ₅⁸`:
    `4(q¹⁸+q⁻¹⁸) + 2(q¹⁰+q⁻¹⁰) + (q⁶+q⁻⁶) + 3(q²+q⁻²)`. -/
noncomputable def cellTrace (q : R) : R :=
  4 * (q ^ 18 + q ^ (-18 : ℤ)) +
  2 * (q ^ 10 + q ^ (-10 : ℤ)) +
  1 * (q ^ 6 + q ^ (-6 : ℤ)) +
  3 * (q ^ 2 + q ^ (-2 : ℤ))

/-- **Bar T-duality at the trace level.**  The pure cell-content trace is
    invariant under `ι : q ↦ q⁻¹`. -/
theorem cellTrace_bar_self_dual (q : R) (hq : q ≠ 0) :
    cellTrace q⁻¹ = cellTrace q := by
  unfold cellTrace
  rw [inv_eq_one_div]
  field_simp
  ring

end CellTrace

section Idempotents

variable {R : Type*} [CommRing R] {A : Type*} [CommRing A] [Algebra R A]

/-- Hecke data: `qi = q⁻¹` and `d = [2]_q⁻¹ = (q + q⁻¹)⁻¹` in `R`. -/
structure HeckeScalars (R : Type*) [CommRing R] where
  q : R
  qi : R
  d : R
  q_mul_qi : q * qi = 1
  d_mul_two : d * (q + qi) = 1

/-- `s` satisfies the Hecke quadratic `s² = (q − q⁻¹) s + 1`. -/
def IsHeckeGen (h : HeckeScalars R) (s : A) : Prop :=
  s * s = algebraMap R A (h.q - h.qi) * s + 1

/-- The two per-carrier idempotents of one copy of `H₂(q)`:
    `e true = (s + q⁻¹)/[2]_q` (sym), `e false = (q − s)/[2]_q` (alt). -/
def perCarrier (h : HeckeScalars R) (s : A) : Bool → A
  | true => algebraMap R A h.d * (s + algebraMap R A h.qi)
  | false => algebraMap R A h.d * (algebraMap R A h.q - s)

theorem perCarrier_add (h : HeckeScalars R) (s : A) :
    perCarrier h s true + perCarrier h s false = 1 := by
  simp only [perCarrier]
  have := congrArg (algebraMap R A) h.d_mul_two
  simp only [map_mul, map_add, map_one] at this
  linear_combination this

theorem perCarrier_mul_zero (h : HeckeScalars R) {s : A}
    (hs : IsHeckeGen h s) :
    perCarrier h s true * perCarrier h s false = 0 := by
  simp only [perCarrier]
  unfold IsHeckeGen at hs
  have hq := congrArg (algebraMap R A) h.q_mul_qi
  simp only [map_mul, map_one, map_sub] at hq hs
  linear_combination (-(algebraMap R A h.d) ^ 2) * hs
    + (algebraMap R A h.d) ^ 2 * hq

theorem perCarrier_mul (h : HeckeScalars R) {s : A} (hs : IsHeckeGen h s)
    (a b : Bool) :
    perCarrier h s a * perCarrier h s b =
      if a = b then perCarrier h s a else 0 := by
  have hadd := perCarrier_add h s
  have h0 := perCarrier_mul_zero h hs
  cases a <;> cases b <;> simp
  · -- false * false
    linear_combination perCarrier h s false * hadd - h0
  · rw [mul_comm]; exact h0
  · exact h0
  · linear_combination perCarrier h s true * hadd - h0

/-- The eight joint projectors `E(a,b,c) = e^a(s₁) e^b(s₃) e^c(s₅)`. -/
def joint (h : HeckeScalars R) (s₁ s₃ s₅ : A) (p : Bool × Bool × Bool) : A :=
  perCarrier h s₁ p.1 * perCarrier h s₃ p.2.1 * perCarrier h s₅ p.2.2

theorem joint_mul (h : HeckeScalars R) {s₁ s₃ s₅ : A}
    (h₁ : IsHeckeGen h s₁) (h₃ : IsHeckeGen h s₃) (h₅ : IsHeckeGen h s₅)
    (p p' : Bool × Bool × Bool) :
    joint h s₁ s₃ s₅ p * joint h s₁ s₃ s₅ p' =
      if p = p' then joint h s₁ s₃ s₅ p else 0 := by
  obtain ⟨a, b, c⟩ := p
  obtain ⟨a', b', c'⟩ := p'
  have e : joint h s₁ s₃ s₅ (a, b, c) * joint h s₁ s₃ s₅ (a', b', c') =
      (perCarrier h s₁ a * perCarrier h s₁ a') *
      (perCarrier h s₃ b * perCarrier h s₃ b') *
      (perCarrier h s₅ c * perCarrier h s₅ c') := by
    simp only [joint]; ring
  rw [e, perCarrier_mul h h₁, perCarrier_mul h h₃, perCarrier_mul h h₅]
  by_cases ha : a = a' <;> by_cases hb : b = b' <;> by_cases hc : c = c' <;>
    simp [ha, hb, hc, joint]

/-- Each joint projector is idempotent. -/
theorem joint_idempotent (h : HeckeScalars R) {s₁ s₃ s₅ : A}
    (h₁ : IsHeckeGen h s₁) (h₃ : IsHeckeGen h s₃) (h₅ : IsHeckeGen h s₅)
    (p : Bool × Bool × Bool) :
    joint h s₁ s₃ s₅ p * joint h s₁ s₃ s₅ p = joint h s₁ s₃ s₅ p := by
  rw [joint_mul h h₁ h₃ h₅, if_pos rfl]

/-- Distinct joint projectors are orthogonal. -/
theorem joint_orthogonal (h : HeckeScalars R) {s₁ s₃ s₅ : A}
    (h₁ : IsHeckeGen h s₁) (h₃ : IsHeckeGen h s₃) (h₅ : IsHeckeGen h s₅)
    {p p' : Bool × Bool × Bool} (hne : p ≠ p') :
    joint h s₁ s₃ s₅ p * joint h s₁ s₃ s₅ p' = 0 := by
  rw [joint_mul h h₁ h₃ h₅, if_neg hne]

/-- The eight joint projectors sum to `1` (no Hecke relation needed). -/
theorem joint_sum_eq_one (h : HeckeScalars R) (s₁ s₃ s₅ : A) :
    ∑ p : Bool × Bool × Bool, joint h s₁ s₃ s₅ p = 1 := by
  simp only [Fintype.sum_prod_type, Fintype.sum_bool, joint]
  have h1 := perCarrier_add h s₁
  have h3 := perCarrier_add h s₃
  have h5 := perCarrier_add h s₅
  linear_combination
    (perCarrier h s₃ true + perCarrier h s₃ false) *
      (perCarrier h s₅ true + perCarrier h s₅ false) * h1
    + (perCarrier h s₅ true + perCarrier h s₅ false) * h3 + h5

end Idempotents

/-- **Conjecture class** (`conj:weak-spectral-completeness`).

For the EW-sector content `ew` of the Hecke action (model data: the
subalgebra carried by the EW carriers `W ↔ σ₁⁴, Z ↔ σ₃⁶, H ↔ σ₅⁸` inside
`End_R(V^{⊗6})`), the conjecture asserts that `ew` is **exhausted** by
the subalgebra generated by the three far-commuting generators — hence
by the span of the eight joint projectors, whose completeness is proved
above.  `ew` is a parameter, not a field, so an instance cannot choose
it.  This is a **primary** conjecture; no instance is provided. -/
class WeakSpectralCompleteness (R : Type*) [CommRing R]
    (A : Type*) [Ring A] [Algebra R A]
    (s₁ s₃ s₅ : A) (ew : Subalgebra R A) : Prop where
  /-- **Conjectural exhaustion.** -/
  exhausts : ew ≤ Algebra.adjoin R {s₁, s₃, s₅}

-- No instance: OPEN primary conjecture (AGENTS.md §3b-tax).

end QOU.Conjectures
