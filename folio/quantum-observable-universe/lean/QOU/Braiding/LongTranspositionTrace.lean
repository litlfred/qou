import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.Ring

/-!
# The Markov trace of the long transposition `T_(1 n)`

Let `A` be an algebra over a commutative ring `R` with elements `σ₀, σ₁, …` satisfying the Hecke
quadratic relation `σᵢ² = h·σᵢ + 1`, and `tr : A → R` linear with `tr 1 = 1` and the Markov
property

`tr(x · σᵢ · y) = z · tr(x · y)`  for `x, y` in the subalgebra generated by `σ₀, …, σ_{i-1}`.

The long transposition in `H_n` is `T_(1 n) = σ₀ σ₁ ⋯ σ_{n-2} ⋯ σ₁ σ₀` (reduced, length `2n − 3`).
This file proves, from those axioms alone,

`tr T_(1 n) = z · (1 + h z)^{n−2}`   (`trace_longTransposition`),

and at convention D (`h = q − q⁻¹`, `z = z_D = q³/(q² + 1)`) the ratio is
`1 + h z_D = (q⁴ + 1)/(q² + 1)` (`one_add_h_zD`), so `tr T_(1 n) = z_D · ((q⁴+1)/(q²+1))^{n−2}`.

Proof: with `Gₘ = σ₀⋯σ_{m−1} σ_{m−1}⋯σ₀`, the quadratic relation gives
`G_{m+1} = h·T_m + Gₘ` and the Markov property gives `tr T_m = z·tr Gₘ`, so `tr Gₘ = (1 + h z)^m`.

What is assumed: the existence of such a trace on the Hecke tower (Ocneanu) is not proved here; the
statement is a derivation from the Markov axioms, so it applies to any trace satisfying them,
including the convention-D trace of `SchurWeyl.MarkovConventionD`.

Bean `qou-078y` (Hecke cost bound: `(1 n)` is the transposition that attains the per-length
maximum `M_n` below the thresholds `q*_n`).

Base ring (§7c): generic `[CommRing R]`, `[Ring A] [Algebra R A]`; the convention-D value needs
`[Field R]`.
-/

namespace QOU.Braiding.LongTransposition

variable {R A : Type*} [CommRing R] [Ring A] [Algebra R A]

/-- `σ₀ σ₁ ⋯ σ_{m−1}`. -/
def up (s : ℕ → A) : ℕ → A
  | 0 => 1
  | m + 1 => up s m * s m

/-- `σ_{m−1} ⋯ σ₁ σ₀`. -/
def down (s : ℕ → A) : ℕ → A
  | 0 => 1
  | m + 1 => s m * down s m

/-- The long transposition in `H_{m+2}`: `σ₀ ⋯ σ_{m−1} σ_m σ_{m−1} ⋯ σ₀`. -/
def longT (s : ℕ → A) (m : ℕ) : A := up s m * s m * down s m

/-- `σ₀ ⋯ σ_{m−1} σ_{m−1} ⋯ σ₀`. -/
def G (s : ℕ → A) (m : ℕ) : A := up s m * down s m

/-- The subalgebra generated by `σⱼ`, `j < i` (the image of `H_i`). -/
def H (s : ℕ → A) (i : ℕ) : Subalgebra R A := Algebra.adjoin R (s '' Set.Iio i)

theorem s_mem_H (s : ℕ → A) {j i : ℕ} (h : j < i) : s j ∈ H (R := R) s i :=
  Algebra.subset_adjoin ⟨j, h, rfl⟩

theorem H_mono (s : ℕ → A) {i i' : ℕ} (h : i ≤ i') : H (R := R) s i ≤ H s i' :=
  Algebra.adjoin_mono (Set.image_subset _ (Set.Iio_subset_Iio h))

theorem up_mem (s : ℕ → A) : ∀ m, up s m ∈ H (R := R) s m
  | 0 => by simp [up, Subalgebra.one_mem]
  | m + 1 => Subalgebra.mul_mem _ (H_mono s (Nat.le_succ m) (up_mem s m)) (s_mem_H s (by omega))

theorem down_mem (s : ℕ → A) : ∀ m, down s m ∈ H (R := R) s m
  | 0 => by simp [down, Subalgebra.one_mem]
  | m + 1 => Subalgebra.mul_mem _ (s_mem_H s (by omega)) (H_mono s (Nat.le_succ m) (down_mem s m))

variable (h z : R) (s : ℕ → A) (tr : A →ₗ[R] R)

theorem G_succ (hquad : ∀ i, s i * s i = h • s i + 1) (m : ℕ) :
    G s (m + 1) = h • longT s m + G s m := by
  simp only [G, longT, up, down]
  calc up s m * s m * (s m * down s m) = up s m * (s m * s m) * down s m := by
        simp only [mul_assoc]
    _ = h • (up s m * s m * down s m) + up s m * down s m := by
        rw [hquad, mul_add, add_mul, mul_one, Algebra.mul_smul_comm, Algebra.smul_mul_assoc]

theorem trace_G (hquad : ∀ i, s i * s i = h • s i + 1) (h1 : tr 1 = 1)
    (hmarkov : ∀ i x y, x ∈ H (R := R) s i → y ∈ H (R := R) s i →
      tr (x * s i * y) = z * tr (x * y)) (m : ℕ) :
    tr (G s m) = (1 + h * z) ^ m := by
  induction m with
  | zero => simp [G, up, down, h1]
  | succ m ih =>
    rw [G_succ h s hquad, map_add, map_smul, smul_eq_mul, longT,
      hmarkov m _ _ (up_mem s m) (down_mem s m), ← G, ih, pow_succ]
    ring

/-- **The long transposition.** `tr T_(1, m+2) = z · (1 + h z)^m`. -/
theorem trace_longTransposition (hquad : ∀ i, s i * s i = h • s i + 1) (h1 : tr 1 = 1)
    (hmarkov : ∀ i x y, x ∈ H (R := R) s i → y ∈ H (R := R) s i →
      tr (x * s i * y) = z * tr (x * y)) (m : ℕ) :
    tr (longT s m) = z * (1 + h * z) ^ m := by
  rw [longT, hmarkov m _ _ (up_mem s m) (down_mem s m), ← G, trace_G h z s tr hquad h1 hmarkov]

/-- At convention D, `1 + h z_D = (q⁴ + 1)/(q² + 1)`. -/
theorem one_add_h_zD {K : Type*} [Field K] (q : K) (hq : q ≠ 0) (hq2 : q ^ 2 + 1 ≠ 0) :
    1 + (q - q⁻¹) * (q ^ 3 / (q ^ 2 + 1)) = (q ^ 4 + 1) / (q ^ 2 + 1) := by
  field_simp; ring

end QOU.Braiding.LongTransposition
