import Mathlib.Tactic
import QOU.Mathlib.RamifiedShiftCalculus

/-!
# QOU.Mathlib.RamifiedShiftCalculusSum — the sum case of the ramified shift calculus

`QOU.Mathlib.RamifiedShiftCalculus` (#6474) pruned **single-shift** derivative-like
prolongations of shift 1 or 2 at a ramified pole `z = z_c + t²`: they annihilate
constants, so the residue slot `t^{−2}` is dead at every jet level. Its audit left
the general q-D-module element — a finite sum `Σ_k c_k σ^k` — explicitly open:
"its residue slot is the sum of the slots and could in principle cancel or
survive".

This module settles that case, and the answer is **not** the one the single-shift
result suggests.

## 1. Mixed shifts revive the residue — without any cancellation

For the two-term operator `twoOp c₁ c₂ = shiftOp 2 c₂ + shiftOp 1 c₁` with **both**
terms annihilating constants (`c₁(−1) = 0`, `c₂(−2) = 0`), the residue slot at jet
level `n + 2` is

  `(twoOp c₁ c₂)^[n+2] f (−2) = c₁(−2) · c₂(−1) · (twoOp c₁ c₂)^[n] f (1)`

(`twoOp_iterate_residue`). The mechanism is a **jump**, not a cancellation: the
word "shift 1 then shift 2" reads `t^{−2}` from `t^{−1}` and `t^{−1}` from `t^{+1}`,
never landing on the constant slot `t⁰` where every derivative's multiplier
vanishes. Every other word of length 2 does land there and dies. So the residue
at level `n + 2` is the `t¹` coefficient of the level-`n` jet — the leading
square-root coefficient of the branch, which is nonzero for a genuine branch.

This is not a q-phenomenon: for the classical `d/dt` (shift 1, `e+1`) and
`(1/t)d/dt` (shift 2, `e+2`) the weight is `(−1)·(1) = −1`
(`classicalTwo_iterate_residue`), and the Jackson `[e+1]_q` + q-deformed `[e+2]_q`
pair gives the same `−1` (`jacksonPlusQddz_iterate_residue`).

**Consequence for the single-shift prune.** Its clause "a residue needs a
non-derivative component" was proved for single-shift operators and does **not**
extend to sums: two derivatives of different shifts suffice. What the residue
does need, among shifts `≤ 2`, is the **odd (shift-1) component** — a pure shift-2
sum is a single shift-2 operator and stays dead.

## 2. The `(−1)^n` residual kills it again

An operator `D = E + O` whose even part `E` commutes with the covering monodromy
`t ↦ −t` and whose odd part `O` anti-commutes with it satisfies the **parity
twist** `mono (D f) = E (mono f) − O (mono f)`. If a jet tower from a fixed-parity
seed `X` carries the full Door-v residual `mono (Dⁿ X) = (−1)ⁿ ε · Dⁿ X` for all
`n`, then (char ≠ 2, no zero divisors) the even part **annihilates every level of
the tower** and the tower is generated by `O` alone (`residual_tower_is_odd_part`).

For the two-term derivative-like operator this closes the loop: the residual
forces `Dⁿ X = (shiftOp 1 c₁)ⁿ X`, and the single-shift prune then kills the
residue slot (`twoOp_residual_kills_residue`). **The residue and the residual are
mutually exclusive for derivative-like sums of shifts `≤ 2`** — the single-shift
conclusion "odd shift *and* a non-derivative component" survives for sums, but
by a different mechanism: the residue admits mixed derivatives, the residual
does not.

## Ground ring

Generic `[CommRing R]`; `[CharZero R] [NoZeroDivisors R]` only for the residual
theorem (the step `2·y = 0 ⇒ y = 0`); `[Field K]` only where q-integers are
instantiated, with the hypothesis `q − q⁻¹ ≠ 0` that `[1]_q = 1` needs.

## References

- [leitner2026] docs/audits/2026-07-20-zgeometric-prolongation-symbol-scoping.md
- [leitner2026] docs/audits/2026-09-03-ramified-shift-calculus-w1-prune.md

LaTeX label: (library module — no content block)
-/

namespace QOU.Mathlib.RamifiedShiftCalculusSum

open QOU.Brings.RamificationParityMonodromy QOU.Mathlib.RamifiedShiftCalculus Finset

variable {R : Type*} [CommRing R]

/-! ## The monodromy is linear -/

theorem mono_add (f g : ℤ → R) : mono (f + g) = mono f + mono g := by
  funext e; simp only [mono, Pi.add_apply]; split_ifs <;> ring

theorem mono_smul (r : R) (f : ℤ → R) : mono (r • f) = r • mono f := by
  funext e; simp only [mono, Pi.smul_apply, smul_eq_mul]; split_ifs <;> ring

theorem mono_sum {ι : Type*} (s : Finset ι) (g : ι → ℤ → R) :
    mono (∑ i ∈ s, g i) = ∑ i ∈ s, mono (g i) := by
  classical
  induction s using Finset.induction_on with
  | empty => funext e; simp [mono]
  | insert a s ha ih => rw [sum_insert ha, sum_insert ha, mono_add, ih]

/-! ## Finite sums of shift operators -/

/-- A finite sum of shift operators — the general q-D-module element on the
coefficient model: shifts `ks`, multiplier `c k` for the term of shift `k`. -/
def sumOp (ks : Finset ℤ) (c : ℤ → ℤ → R) (f : ℤ → R) : ℤ → R :=
  fun e => ∑ k ∈ ks, shiftOp k (c k) f e

theorem sumOp_apply (ks : Finset ℤ) (c : ℤ → ℤ → R) (f : ℤ → R) (e : ℤ) :
    sumOp ks c f e = ∑ k ∈ ks, c k e * f (e + k) := rfl

/-- The residue slot of a sum is the sum of the slots. -/
theorem sumOp_residue_slot (ks : Finset ℤ) (c : ℤ → ℤ → R) (f : ℤ → R) :
    sumOp ks c f (-2) = ∑ k ∈ ks, c k (-2) * f (-2 + k) := rfl

theorem sumOp_smul (ks : Finset ℤ) (c : ℤ → ℤ → R) (r : R) (f : ℤ → R) :
    sumOp ks c (r • f) = r • sumOp ks c f := by
  funext e
  simp only [sumOp_apply, Pi.smul_apply, smul_eq_mul, mul_sum]
  apply sum_congr rfl; intro k _; ring

/-- **Sums compose**: the composite of two sums is the double sum of the composed
symbols `shiftOp (k + l) (c k · d l (· + k))`. -/
theorem sumOp_comp (ks ls : Finset ℤ) (c d : ℤ → ℤ → R) (f : ℤ → R) :
    sumOp ks c (sumOp ls d f)
      = fun e => ∑ k ∈ ks, ∑ l ∈ ls, shiftOp (k + l) (fun e => c k e * d l (e + k)) f e := by
  funext e
  simp only [sumOp_apply, shiftOp, mul_sum]
  apply sum_congr rfl; intro k _
  apply sum_congr rfl; intro l _
  rw [add_assoc]; ring

/-- A sum of even shifts commutes with the covering monodromy. -/
theorem sumOp_comm_mono_of_even (ks : Finset ℤ) (hks : ∀ k ∈ ks, Even k)
    (c : ℤ → ℤ → R) (f : ℤ → R) :
    sumOp ks c (mono f) = mono (sumOp ks c f) := by
  have : sumOp ks c f = ∑ k ∈ ks, shiftOp k (c k) f := by funext e; simp [sumOp_apply, shiftOp]
  rw [this, mono_sum]
  funext e
  simp only [sumOp_apply, sum_apply]
  apply sum_congr rfl; intro k hk
  have := congrFun (shiftOp_comm_mono_of_even k (hks k hk) (c k) f) e
  simpa [shiftOp] using this

/-- A sum of odd shifts anti-commutes with the covering monodromy. -/
theorem sumOp_anticomm_mono_of_odd (ks : Finset ℤ) (hks : ∀ k ∈ ks, Odd k)
    (c : ℤ → ℤ → R) (f : ℤ → R) :
    sumOp ks c (mono f) = -mono (sumOp ks c f) := by
  have : sumOp ks c f = ∑ k ∈ ks, shiftOp k (c k) f := by funext e; simp [sumOp_apply, shiftOp]
  rw [this, mono_sum]
  funext e
  simp only [sumOp_apply, Pi.neg_apply, sum_apply, ← sum_neg_distrib]
  apply sum_congr rfl; intro k hk
  have := congrFun (shiftOp_anticomm_mono_of_odd k (hks k hk) (c k) f) e
  simpa [shiftOp] using this

/-! ## The two-term derivative-like candidate: shift 2 (even) + shift 1 (odd) -/

/-- `twoOp c₁ c₂ = shiftOp 2 c₂ + shiftOp 1 c₁`: an even and an odd derivative-like
component. Written even-part-first so that it is literally `E f + O f`. -/
def twoOp (c₁ c₂ : ℤ → R) (f : ℤ → R) : ℤ → R := shiftOp 2 c₂ f + shiftOp 1 c₁ f

theorem twoOp_apply (c₁ c₂ : ℤ → R) (f : ℤ → R) (e : ℤ) :
    twoOp c₁ c₂ f e = c₂ e * f (e + 2) + c₁ e * f (e + 1) := rfl

/-- At levels `0` and `1` the residue slot is still dead on a power-series seed. -/
theorem twoOp_residue_zero (c₁ c₂ : ℤ → R) (f : ℤ → R) (hf : PowerSeriesSupported f) :
    (twoOp c₁ c₂)^[0] f (-2) = 0 := by
  simp [hf (-2) (by norm_num)]

theorem twoOp_residue_one (c₁ c₂ : ℤ → R) (hc₂ : AnnihilatesConstants 2 c₂)
    (f : ℤ → R) (hf : PowerSeriesSupported f) :
    (twoOp c₁ c₂)^[1] f (-2) = 0 := by
  have h2 : c₂ (-2) = 0 := hc₂
  simp [twoOp_apply, hf (-1) (by norm_num), h2]

/-- **The residue revives at level 2 and beyond.** With both components
annihilating constants, the residue slot at level `n + 2` is the `t¹` coefficient
of the level-`n` jet, weighted by `c₁(−2) · c₂(−1)`. No hypothesis on the seed is
needed: the killing slot `t⁰` is jumped over by the word (shift 1, then shift 2). -/
theorem twoOp_iterate_residue (c₁ c₂ : ℤ → R)
    (hc₁ : AnnihilatesConstants 1 c₁) (hc₂ : AnnihilatesConstants 2 c₂)
    (f : ℤ → R) (n : ℕ) :
    (twoOp c₁ c₂)^[n + 2] f (-2) = c₁ (-2) * c₂ (-1) * (twoOp c₁ c₂)^[n] f 1 := by
  rw [Function.iterate_succ_apply', Function.iterate_succ_apply']
  have h1 : c₁ (-1) = 0 := hc₁
  have h2 : c₂ (-2) = 0 := hc₂
  simp only [twoOp_apply]
  norm_num [h1, h2]
  ring

/-- Classical instance: `(1/t)d/dt` (shift 2, `e + 2`) plus `d/dt` (shift 1, `e + 1`).
Weight `(−2 + 1)·(−1 + 2) = −1`. The revival is not a q-phenomenon. -/
theorem classicalTwo_iterate_residue (f : ℤ → R) (n : ℕ) :
    (twoOp (fun e => ((e + 1 : ℤ) : R)) (fun e => ((e + 2 : ℤ) : R)))^[n + 2] f (-2)
      = -((twoOp (fun e => ((e + 1 : ℤ) : R)) (fun e => ((e + 2 : ℤ) : R)))^[n] f 1) := by
  rw [twoOp_iterate_residue _ _ (by simp [AnnihilatesConstants]) (by simp [AnnihilatesConstants])]
  norm_num

section QDeformed
variable {K : Type*} [Field K]
open QOU.QInteger

/-- Jackson `D_{q,t}` (shift 1, `[e+1]_q`) plus the q-deformed `d/dz` (shift 2, `[e+2]_q`). -/
noncomputable def jacksonPlusQddz (q : K) (f : ℤ → K) : ℤ → K :=
  twoOp (fun e => qIntBalZ q (e + 1)) (fun e => qIntBalZ q (e + 2)) f

theorem qIntBalZ_one_of (q : K) (hq : q - q⁻¹ ≠ 0) : qIntBalZ q 1 = 1 := by
  simp only [qIntBalZ_def, zpow_one, zpow_neg_one]; exact div_self hq

/-- The same `−1` weight: `[−1]_q · [1]_q = −1` whenever `[1]_q = 1`. -/
theorem jacksonPlusQddz_iterate_residue (q : K) (hq : q - q⁻¹ ≠ 0) (f : ℤ → K) (n : ℕ) :
    (jacksonPlusQddz q)^[n + 2] f (-2) = -((jacksonPlusQddz q)^[n] f 1) := by
  unfold jacksonPlusQddz
  rw [twoOp_iterate_residue _ _ (by simp [AnnihilatesConstants]) (by simp [AnnihilatesConstants])]
  have h1 : qIntBalZ q (-2 + 1) = -1 := by
    rw [show (-2 + 1 : ℤ) = -1 by norm_num, qIntBalZ_neg, qIntBalZ_one_of q hq]
  have h2 : qIntBalZ q (-1 + 2) = 1 := by
    rw [show (-1 + 2 : ℤ) = 1 by norm_num, qIntBalZ_one_of q hq]
  rw [h1, h2]; ring

end QDeformed

/-! ## The parity twist, and what the `(−1)^n` residual forces -/

section Residual
variable [CharZero R] [NoZeroDivisors R]

/-- **Core step.** If `Z` has monodromy eigenvalue `ε' ≠ 0` and `(E + O) Z` has
eigenvalue `−ε'`, then `E Z = 0`: the even part contributes `+ε' · E Z` to
`mono ((E + O) Z)` and the odd part `−ε' · O Z`, so flipping the sign needs
`2ε' · E Z = 0`. -/
theorem even_part_dead_of_flip (E O : (ℤ → R) → (ℤ → R))
    (hE : ∀ f, E (mono f) = mono (E f)) (hO : ∀ f, O (mono f) = -mono (O f))
    (hEs : ∀ (r : R) f, E (r • f) = r • E f) (hOs : ∀ (r : R) f, O (r • f) = r • O f)
    (Z : ℤ → R) (ε' : R) (hε' : ε' ≠ 0)
    (hZ : mono Z = ε' • Z) (hflip : mono (E Z + O Z) = (-ε') • (E Z + O Z)) : E Z = 0 := by
  have hOZ : mono (O Z) = -O (mono Z) := by rw [hO Z, neg_neg]
  have h1 : mono (E Z + O Z) = ε' • E Z + -(ε' • O Z) := by
    rw [mono_add, ← hE, hOZ, hZ, hEs, hOs]
  rw [h1, smul_add, neg_smul, neg_smul] at hflip
  have h3 : ε' • E Z = -(ε' • E Z) := add_right_cancel hflip
  rw [eq_neg_iff_add_eq_zero] at h3
  funext e
  have h4 := congrFun h3 e
  simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply] at h4
  have h5 : (2 * ε') * E Z e = 0 := by linear_combination h4
  rcases mul_eq_zero.mp h5 with h | h
  · exact absurd h (mul_ne_zero two_ne_zero hε')
  · exact h

/-- **A tower carrying the full `(−1)^n` residual is generated by its odd part
alone.** For `D = E + O` with `E` monodromy-even and `O` monodromy-odd, both
homogeneous, if `mono (Dⁿ X) = (−1)ⁿ ε · Dⁿ X` for every `n` (with `ε ≠ 0`), then
at every level `Dⁿ X = Oⁿ X` and `E (Oⁿ X) = 0`. -/
theorem residual_tower_is_odd_part (E O : (ℤ → R) → (ℤ → R))
    (hE : ∀ f, E (mono f) = mono (E f)) (hO : ∀ f, O (mono f) = -mono (O f))
    (hEs : ∀ (r : R) f, E (r • f) = r • E f) (hOs : ∀ (r : R) f, O (r • f) = r • O f)
    (X : ℤ → R) (ε : R) (hε : ε ≠ 0)
    (halt : ∀ n, mono ((fun f => E f + O f)^[n] X)
      = ((-1 : R) ^ n * ε) • (fun f => E f + O f)^[n] X) (n : ℕ) :
    (fun f => E f + O f)^[n] X = O^[n] X ∧ E (O^[n] X) = 0 := by
  induction n with
  | zero =>
    refine ⟨rfl, ?_⟩
    have hX : mono X = ε • X := by simpa using halt 0
    have h1 : mono (E X + O X) = (-ε) • (E X + O X) := by
      have := halt 1
      simpa using this
    exact even_part_dead_of_flip E O hE hO hEs hOs X ε hε hX h1
  | succ n ih =>
    obtain ⟨hD, hEd⟩ := ih
    have hD' : (fun f => E f + O f)^[n + 1] X = O^[n + 1] X := by
      rw [Function.iterate_succ_apply', hD, Function.iterate_succ_apply']
      show E (O^[n] X) + O (O^[n] X) = _
      rw [hEd, zero_add]
    refine ⟨hD', ?_⟩
    have hZ : mono (O^[n + 1] X) = ((-1 : R) ^ (n + 1) * ε) • O^[n + 1] X := by
      rw [← hD']; exact halt (n + 1)
    have hflip : mono (E (O^[n + 1] X) + O (O^[n + 1] X))
        = (-((-1 : R) ^ (n + 1) * ε)) • (E (O^[n + 1] X) + O (O^[n + 1] X)) := by
      have := halt (n + 2)
      rw [Function.iterate_succ_apply', hD'] at this
      have hpow : ((-1 : R) ^ (n + 2) * ε) = -((-1 : R) ^ (n + 1) * ε) := by ring
      rw [hpow] at this
      exact this
    exact even_part_dead_of_flip E O hE hO hEs hOs (O^[n + 1] X) _
      (mul_ne_zero (pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero)) hε) hZ hflip

/-- **The residual kills the residue.** For the two-term derivative-like operator
(shift-1 component annihilating constants) on a power-series fixed-parity seed, a
tower carrying the full `(−1)^n` residual is the pure shift-1 tower, and its
residue slot is dead at every level. Residue and residual are mutually exclusive. -/
theorem twoOp_residual_kills_residue (c₁ c₂ : ℤ → R) (hc₁ : AnnihilatesConstants 1 c₁)
    (X : ℤ → R) (hX : PowerSeriesSupported X) (ε : R) (hε : ε ≠ 0)
    (halt : ∀ n, mono ((twoOp c₁ c₂)^[n] X) = ((-1 : R) ^ n * ε) • (twoOp c₁ c₂)^[n] X)
    (n : ℕ) :
    (twoOp c₁ c₂)^[n] X (-2) = 0 := by
  have h := residual_tower_is_odd_part (shiftOp 2 c₂) (shiftOp 1 c₁)
    (fun f => shiftOp_comm_mono_of_even 2 even_two c₂ f)
    (fun f => shiftOp_anticomm_mono_of_odd 1 odd_one c₁ f)
    (shiftOp_smul 2 c₂) (shiftOp_smul 1 c₁) X ε hε halt n
  have hodd : (twoOp c₁ c₂)^[n] X = (shiftOp 1 c₁)^[n] X := h.1
  rw [hodd]
  exact residue_slot_zero_shift_one c₁ hc₁ X hX n

/-! ### The residual demanded only from a level `n₀` on

The corpus's Door-v residual is *asymptotic*: the sign alternation of the GGM
carrier's growing solution sets in only once its recurrence coefficient
`2 − q^{m+1}` turns negative (`conj:c1-ggm-bar-parity-faces`, "for
`m+1 < log 2 / log q` … no sign change occurs"). So the hypothesis that matters
is alternation for `n ≥ n₀`, not for all `n`. The theorem survives with the
same proof, applied to the level-`n₀` jet as the seed: from `n₀` on the tower
is the odd part's, and — because a shift-1 iterate of length `≥ 2` reads
`t^{−2}` through `t^{−1}` with the dead weight `c₁(−1)` — the residue slot is
dead at every level `≥ n₀ + 2`, **with no hypothesis on the seed**. Levels
`2 … n₀ + 1` are untouched: there the residue formula `twoOp_iterate_residue`
still applies and the slot is alive. -/

theorem residual_from_level_tower_is_odd_part (E O : (ℤ → R) → (ℤ → R))
    (hE : ∀ f, E (mono f) = mono (E f)) (hO : ∀ f, O (mono f) = -mono (O f))
    (hEs : ∀ (r : R) f, E (r • f) = r • E f) (hOs : ∀ (r : R) f, O (r • f) = r • O f)
    (X : ℤ → R) (ε : R) (hε : ε ≠ 0) (n₀ : ℕ)
    (halt : ∀ n, n₀ ≤ n → mono ((fun f => E f + O f)^[n] X)
      = ((-1 : R) ^ n * ε) • (fun f => E f + O f)^[n] X) (k : ℕ) :
    (fun f => E f + O f)^[n₀ + k] X = O^[k] ((fun f => E f + O f)^[n₀] X)
      ∧ E (O^[k] ((fun f => E f + O f)^[n₀] X)) = 0 := by
  have hε' : (-1 : R) ^ n₀ * ε ≠ 0 :=
    mul_ne_zero (pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero)) hε
  have halt' : ∀ m, mono ((fun f => E f + O f)^[m] ((fun f => E f + O f)^[n₀] X))
      = ((-1 : R) ^ m * ((-1 : R) ^ n₀ * ε)) •
        (fun f => E f + O f)^[m] ((fun f => E f + O f)^[n₀] X) := by
    intro m
    have h := halt (m + n₀) (Nat.le_add_left _ _)
    rw [Function.iterate_add_apply, pow_add, mul_assoc] at h
    exact h
  have := residual_tower_is_odd_part E O hE hO hEs hOs _ _ hε' halt' k
  rw [add_comm, Function.iterate_add_apply]
  exact this

omit [CharZero R] [NoZeroDivisors R] in
/-- A shift-1 iterate of length `≥ 2` has a dead residue slot for **every**
seed — the `i = 1` factor of the iterate is `c₁(−1) = 0`. (The `#6474` lemma
`residue_slot_zero_shift_one` needs a power-series seed only for lengths `0`
and `1`.) -/
theorem shiftOne_iterate_residue_zero_of_two_le (c₁ : ℤ → R)
    (hc₁ : AnnihilatesConstants 1 c₁) (Y : ℤ → R) (k : ℕ) :
    (shiftOp 1 c₁)^[k + 2] Y (-2) = 0 := by
  rw [shiftOp_iterate]
  have h1 : c₁ (-1) = 0 := hc₁
  have : ∏ i ∈ range (k + 2), c₁ (-2 + (i : ℤ) * 1) = 0 := by
    apply Finset.prod_eq_zero (i := 1) (Finset.mem_range.mpr (by omega))
    norm_num [h1]
  rw [this, zero_mul]

/-- **Asymptotic residual, per-level exclusivity.** If the two-term derivative-like
tower alternates only from level `n₀` on, the residue slot is dead at every
level `≥ n₀ + 2` — no seed hypothesis — while levels `2 … n₀ + 1` keep the
`twoOp_iterate_residue` formula and are generically alive. -/
theorem twoOp_residual_from_level_kills_residue_beyond (c₁ c₂ : ℤ → R)
    (hc₁ : AnnihilatesConstants 1 c₁) (X : ℤ → R) (ε : R) (hε : ε ≠ 0) (n₀ : ℕ)
    (halt : ∀ n, n₀ ≤ n → mono ((twoOp c₁ c₂)^[n] X)
      = ((-1 : R) ^ n * ε) • (twoOp c₁ c₂)^[n] X) (k : ℕ) :
    (twoOp c₁ c₂)^[n₀ + (k + 2)] X (-2) = 0 := by
  have h := residual_from_level_tower_is_odd_part (shiftOp 2 c₂) (shiftOp 1 c₁)
    (fun f => shiftOp_comm_mono_of_even 2 even_two c₂ f)
    (fun f => shiftOp_anticomm_mono_of_odd 1 odd_one c₁ f)
    (shiftOp_smul 2 c₂) (shiftOp_smul 1 c₁) X ε hε n₀ halt (k + 2)
  have hodd : (twoOp c₁ c₂)^[n₀ + (k + 2)] X
      = (shiftOp 1 c₁)^[k + 2] ((twoOp c₁ c₂)^[n₀] X) := h.1
  rw [hodd]
  exact shiftOne_iterate_residue_zero_of_two_le c₁ hc₁ _ k

/-- The general-sum form: for any finite sum split into even and odd shifts, the
residual forces the even part off the tower. -/
theorem sumOp_residual_even_part_dead (ks : Finset ℤ) (c : ℤ → ℤ → R)
    (X : ℤ → R) (ε : R) (hε : ε ≠ 0)
    (halt : ∀ n, mono ((fun f => sumOp (ks.filter Even) c f + sumOp (ks.filter (¬ Even ·)) c f)^[n] X)
      = ((-1 : R) ^ n * ε) •
        (fun f => sumOp (ks.filter Even) c f + sumOp (ks.filter (¬ Even ·)) c f)^[n] X)
    (n : ℕ) :
    sumOp (ks.filter Even) c ((sumOp (ks.filter (¬ Even ·)) c)^[n] X) = 0 :=
  (residual_tower_is_odd_part (sumOp (ks.filter Even) c) (sumOp (ks.filter (¬ Even ·)) c)
    (fun f => sumOp_comm_mono_of_even _ (fun _ hk => (mem_filter.mp hk).2) c f)
    (fun f => sumOp_anticomm_mono_of_odd _
      (fun _ hk => (Int.not_even_iff_odd).mp (mem_filter.mp hk).2) c f)
    (sumOp_smul _ c) (sumOp_smul _ c) X ε hε halt n).2

end Residual

end QOU.Mathlib.RamifiedShiftCalculusSum
