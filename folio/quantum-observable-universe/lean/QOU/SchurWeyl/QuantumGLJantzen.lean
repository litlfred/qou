import QOU.SchurWeyl.QuantumGLAction

/-!
# `raiseOp` and `lowerOp` are Jantzen-coproduct images

G3.4 open item (2) of bean `qou-gl34`: are the operators `raiseOp`, `lowerOp` of
`QuantumGLAction` the images of the Chevalley generators of `U_q(gl_d)` under a standard
iterated coproduct?

Take Jantzen's coproduct (Lectures on Quantum Groups, §3.1),

  `Δ(E) = E ⊗ 1 + K ⊗ E`,   `Δ(F) = F ⊗ K⁻¹ + 1 ⊗ F`,   `Δ(K) = K ⊗ K`,

with `K_i = q^{ε_i − ε_{i+1}}`, acting on `V = R^d` by `q` on `e_i`, `q⁻¹` on `e_{i+1}`, `1`
elsewhere, `E_i : e_{i+1} ↦ e_i` and `F_i : e_i ↦ e_{i+1}`. Its iteration is

  `Δ⁽ⁿ⁾(A) = Σ_s K^{⊗s} ⊗ A ⊗ B^{⊗(n−s−1)}`   (`jDelta A B K` below).

Note the naming: `raiseOp` sends `e_i ↦ e_{i+1}`, which *lowers* the weight, so it is the
standard `F_i`; `lowerOp` is the standard `E_i` up to a Cartan factor.

* `raiseOp_eq_jDelta` — `raiseOp i = Δ⁽ⁿ⁾(F_i)`, exactly.
* `lowerOp_eq_smul_cartan_mul_jDelta` — `lowerOp i = q · Δ⁽ⁿ⁾(K_i)⁻¹ · Δ⁽ⁿ⁾(E_i)`.
* `jDelta_E_eq` — equivalently `Δ⁽ⁿ⁾(E_i) = q⁻¹ · Δ⁽ⁿ⁾(K_i) · lowerOp i`.
* `cartan_mul_cartan` — `Δ⁽ⁿ⁾(K_i)` and `Δ⁽ⁿ⁾(K_i)⁻¹` are inverse `cartan` elements.

So the algebra generated by `raiseOp`, `lowerOp` and the `cartan` torus contains the iterated
Jantzen coproduct images of `E_i`, `F_i`, `K_i^{±1}`, and conversely.

Checked first by an exact sympy computation over `ℚ(q)` (`d = 2, 3`, `n = 2, 3`, every `i`);
proved here for every `d`, `n`. Generic `[CommRing R]`, `q · qi = 1` (§7c).

Reference: J. C. Jantzen, Lectures on Quantum Groups, AMS GSM 6 (1996), §3.1.
-/

namespace QOU.SchurWeyl.QuantumGL

open Matrix

variable {R : Type*} [CommRing R] {d n : ℕ}

/-- `K` on every site before `s`, `A` at `s`, `B` on every later site. -/
def jTerm (A : Matrix (Fin d) (Fin d) R) (B K : Fin d → R) (s : Fin n) :
    Matrix (Fin n → Fin d) (Fin n → Fin d) R :=
  Matrix.of fun a b =>
    if (∀ k, k ≠ s → a k = b k) then
      (∏ k ∈ Finset.Iio s, K (b k)) * A (a s) (b s) * ∏ k ∈ Finset.Ioi s, B (b k)
    else 0

/-- **The iterated coproduct** `Δ⁽ⁿ⁾(A) = Σ_s K^{⊗s} ⊗ A ⊗ B^{⊗(n−s−1)}` for
`Δ(A) = A ⊗ B + K ⊗ A`. -/
def jDelta (A : Matrix (Fin d) (Fin d) R) (B K : Fin d → R) :
    Matrix (Fin n → Fin d) (Fin n → Fin d) R :=
  ∑ s, jTerm A B K s

/-- The Cartan weight of `K_i = q^{ε_i − ε_{i+1}}`: `q` on `e_i`, `qi` on `e_j`, `1` elsewhere.
Its pointwise inverse is the tail weight `kap q qi i j` of `QuantumGLAction`. -/
def kK (q qi : R) (i j : Fin d) (x : Fin d) : R := if x = i then q else if x = j then qi else 1

theorem kK_mul_kap {q qi : R} (hqi : q * qi = 1) {i j : Fin d} (hij : i ≠ j) (x : Fin d) :
    kK q qi i j x * kap q qi i j x = 1 := by
  unfold kK kap
  by_cases hi : x = i
  · subst hi; simp [hij, hqi]
  · by_cases hj : x = j
    · subst hj; simp [hi, mul_comm, hqi]
    · simp [hi, hj]

theorem cartan_mul_cartan (c c' : Fin d → R) :
    (cartan c : Matrix (Fin n → Fin d) (Fin n → Fin d) R) * cartan c'
      = cartan fun x => c x * c' x := by
  unfold cartan
  rw [Matrix.diagonal_mul_diagonal]
  congr 1
  funext a
  rw [← Finset.prod_mul_distrib]

/-- `Δ⁽ⁿ⁾(K_i) · Δ⁽ⁿ⁾(K_i)⁻¹ = 1`. -/
theorem cartan_kK_mul_cartan_kap {q qi : R} (hqi : q * qi = 1) {i j : Fin d} (hij : i ≠ j) :
    (cartan (kK q qi i j) : Matrix (Fin n → Fin d) (Fin n → Fin d) R)
      * cartan (kap q qi i j) = 1 := by
  rw [cartan_mul_cartan]
  unfold cartan
  simp only [kK_mul_kap hqi hij, Finset.prod_const_one, Matrix.diagonal_one]

theorem prod_Iio_eq (s : Fin n) (f : Fin n → R) :
    ∏ k ∈ Finset.Iio s, f k = ∏ k, if k < s then f k else 1 := by
  rw [← Finset.prod_filter]
  congr 1
  ext k
  simp

theorem prod_Ioi_eq (s : Fin n) (f : Fin n → R) :
    ∏ k ∈ Finset.Ioi s, f k = ∏ k, if s < k then f k else 1 := by
  rw [← Finset.prod_filter]
  congr 1
  ext k
  simp

/-- **`raiseOp i = Δ⁽ⁿ⁾(F_i)`** for Jantzen's `Δ(F) = F ⊗ K⁻¹ + 1 ⊗ F`. -/
theorem raiseOp_eq_jDelta (q qi : R) (i j : Fin d) :
    (raiseOp q qi i j : Matrix (Fin n → Fin d) (Fin n → Fin d) R)
      = jDelta (Matrix.single j i 1) (kap q qi i j) (fun _ => 1) := by
  unfold raiseOp siteOp jDelta
  refine Finset.sum_congr rfl fun s _ => ?_
  ext a b
  simp only [siteTerm, jTerm, Matrix.of_apply, Finset.prod_const_one, one_mul]

/-- **`lowerOp i = q · Δ⁽ⁿ⁾(K_i)⁻¹ · Δ⁽ⁿ⁾(E_i)`** for Jantzen's `Δ(E) = E ⊗ 1 + K ⊗ E`. -/
theorem lowerOp_eq_smul_cartan_mul_jDelta {q qi : R} (hqi : q * qi = 1) {i j : Fin d}
    (hij : i ≠ j) :
    (lowerOp q qi i j : Matrix (Fin n → Fin d) (Fin n → Fin d) R)
      = q • (cartan (kap q qi i j) * jDelta (Matrix.single i j 1) (fun _ => 1) (kK q qi i j)) := by
  classical
  unfold lowerOp siteOp jDelta
  rw [Matrix.mul_sum, Finset.smul_sum]
  refine Finset.sum_congr rfl fun s _ => ?_
  ext a b
  rw [Matrix.smul_apply, cartan, Matrix.diagonal_mul]
  simp only [siteTerm, jTerm, Matrix.of_apply, Finset.prod_const_one, mul_one, smul_eq_mul]
  by_cases hab : ∀ k, k ≠ s → a k = b k
  · rw [if_pos hab, if_pos hab]
    by_cases hs : a s = i ∧ b s = j
    · obtain ⟨has, hbs⟩ := hs
      have hsingle : (Matrix.single i j (1 : R)) (a s) (b s) = 1 := by
        rw [has, hbs]; simp
      rw [hsingle, one_mul, mul_one, prod_Iio_eq, prod_Ioi_eq]
      -- pair `kap (a k)` with the `kK` prefix site by site; only site `s` survives, as `qi`
      have key : ∀ k, kap q qi i j (a k) * (if k < s then kK q qi i j (b k) else 1)
          = (if k = s then qi else 1) * (if s < k then kap q qi i j (b k) else 1) := by
        intro k
        rcases lt_trichotomy k s with h | rfl | h
        · rw [hab k h.ne, if_pos h, if_neg h.ne, if_neg (not_lt.mpr h.le), mul_comm,
            kK_mul_kap hqi hij, one_mul]
        · rw [has, if_neg (lt_irrefl _), if_pos rfl, if_neg (lt_irrefl _)]
          unfold kap; simp [hij]
        · rw [hab k h.ne', if_neg (not_lt.mpr h.le), if_neg h.ne', if_pos h, mul_one, one_mul]
      rw [← Finset.prod_mul_distrib, Finset.prod_congr rfl (fun k _ => key k),
        Finset.prod_mul_distrib, Finset.prod_ite_eq' Finset.univ s (fun _ => qi),
        if_pos (Finset.mem_univ s), ← mul_assoc, hqi, one_mul]
    · have hsingle : (Matrix.single i j (1 : R)) (a s) (b s) = 0 := by
        rw [single_apply', if_neg hs]
      rw [hsingle]; ring
  · rw [if_neg hab, if_neg hab, mul_zero, mul_zero]

/-- **`Δ⁽ⁿ⁾(E_i) = qi · Δ⁽ⁿ⁾(K_i) · lowerOp i`.** -/
theorem jDelta_E_eq {q qi : R} (hqi : q * qi = 1) {i j : Fin d} (hij : i ≠ j) :
    (jDelta (Matrix.single i j 1) (fun _ => 1) (kK q qi i j) :
        Matrix (Fin n → Fin d) (Fin n → Fin d) R)
      = qi • (cartan (kK q qi i j) * lowerOp q qi i j) := by
  rw [lowerOp_eq_smul_cartan_mul_jDelta hqi hij, Matrix.mul_smul, ← Matrix.mul_assoc,
    cartan_kK_mul_cartan_kap hqi hij, Matrix.one_mul, smul_smul, mul_comm qi q, hqi, one_smul]

end QOU.SchurWeyl.QuantumGL
