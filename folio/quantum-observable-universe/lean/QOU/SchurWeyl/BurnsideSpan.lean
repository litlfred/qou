import QOU.SchurWeyl.Irreducibility

/-!
# QOU.SchurWeyl — Burnside spanning for the (2,1) seminormal rep (SW-6, concrete)

For `q ≠ 0` the four matrices `1, S0, S1, S0·S1` admit **no nontrivial linear
relation** over `ℝ` (`seminormal21_no_linear_relation`) — i.e. they are linearly
independent.  Since `dim_ℝ M₂(ℝ) = 4`, they therefore span `M₂(ℝ)`, so the
ℝ-subalgebra generated by the generator images `S0, S1` is the whole matrix
algebra: the **Burnside surjectivity** of the `(2,1)` seminormal representation,
obtained by an explicit entry computation rather than a general density theorem.

This is the concrete `d_λ = 2` half of SW-6 (bean `qou-jfr8`/`qou-j377`): the
surjective side of the Wedderburn block map for the `(2,1)` factor.  The full
`H_3(q) ≅ ℝ × ℝ × M₂(ℝ)` isomorphism additionally needs `dim H_3(q) = 6` (the
Iwahori–Hecke basis theorem `{T_w : w ∈ S_3}`), which is **not** proved here.

Base ring `ℝ` (§7c).  LaTeX label: `prop:seminormal21-spans-M2`.
-/

namespace QOU.SchurWeyl

open Matrix

section BurnsideSpan21

variable (q : ℝ)

/-- `q + q⁻¹ ≠ 0` for real `q ≠ 0` (local copy; the eigenvalues of `S0` are distinct). -/
private theorem q_add_inv_ne' (hq : q ≠ 0) : q + q⁻¹ ≠ 0 := by
  intro h
  have h2 : q * q + 1 = 0 := by
    have hc := congrArg (· * q) h
    simp only [zero_mul, add_mul, inv_mul_cancel₀ hq] at hc
    linarith [hc]
  nlinarith [mul_self_nonneg q, h2]

/-- The `(1,0)` entry of `S1` is strictly positive (local copy). -/
private theorem S1_c10_pos' : (0 : ℝ) < (q ^ 4 + q ^ 2 + 1) / (q ^ 2 + 1) ^ 2 := by
  positivity

/-- **No nontrivial linear relation among `1, S0, S1, S0·S1`** (`q ≠ 0`): the
generator images of the `(2,1)` seminormal representation are linearly
independent, hence span `M₂(ℝ)` (Burnside surjectivity). -/
theorem seminormal21_no_linear_relation (hq : q ≠ 0)
    (a b c d : ℝ)
    (h : a • (1 : Matrix (Fin 2) (Fin 2) ℝ) + b • S0 q + c • S1 q
        + d • (S0 q * S1 q) = 0) :
    a = 0 ∧ b = 0 ∧ c = 0 ∧ d = 0 := by
  have hqi : q + q⁻¹ ≠ 0 := q_add_inv_ne' q hq
  have hK : (q ^ 4 + q ^ 2 + 1) / (q ^ 2 + 1) ^ 2 ≠ 0 := ne_of_gt (S1_c10_pos' q)
  have e01 := congrFun (congrFun h 0) 1
  have e10 := congrFun (congrFun h 1) 0
  have e00 := congrFun (congrFun h 0) 0
  have e11 := congrFun (congrFun h 1) 1
  simp only [S0, S1, Matrix.add_apply, Matrix.smul_apply, Matrix.one_apply,
    Matrix.mul_apply, Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.of_apply, Matrix.zero_apply, smul_eq_mul,
    Fin.reduceEq, reduceIte, mul_zero, zero_mul, add_zero, zero_add,
    mul_one] at e01 e10 e00 e11
  -- e01 : c + d * q = 0
  -- e10 : c * K + d * (-q⁻¹ * K) = 0            (K = (q⁴+q²+1)/(q²+1)²)
  -- e00 : a + b * q + c * (-1/(q³+q)) + d * (q * (-1/(q³+q))) = 0
  -- e11 : a + b * -q⁻¹ + c * (q³/(q²+1)) + d * (-q⁻¹ * (q³/(q²+1))) = 0
  -- Off-diagonals force d = 0, c = 0.
  have hd : d = 0 := by
    have h10 : (q ^ 4 + q ^ 2 + 1) / (q ^ 2 + 1) ^ 2 * (c - d * q⁻¹) = 0 := by
      linear_combination e10
    rcases mul_eq_zero.mp h10 with hk | hcd
    · exact absurd hk hK
    · have : d * (q + q⁻¹) = 0 := by linear_combination e01 - hcd
      rcases mul_eq_zero.mp this with h' | h'
      · exact h'
      · exact absurd h' hqi
  have hc : c = 0 := by linear_combination e01 - q * hd
  -- Diagonals then force b = 0, a = 0.
  rw [hc, hd] at e00 e11
  have h00 : a + b * q = 0 := by linear_combination e00
  have h11 : a - b * q⁻¹ = 0 := by linear_combination e11
  have hb : b = 0 := by
    have : b * (q + q⁻¹) = 0 := by linear_combination h00 - h11
    rcases mul_eq_zero.mp this with h' | h'
    · exact h'
    · exact absurd h' hqi
  have ha : a = 0 := by linear_combination h00 - q * hb
  exact ⟨ha, hb, hc, hd⟩

end BurnsideSpan21

end QOU.SchurWeyl
