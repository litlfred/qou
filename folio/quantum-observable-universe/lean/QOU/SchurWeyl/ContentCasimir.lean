import QOU.SchurWeyl.QJucysMurphy

/-!
# `QOU.SchurWeyl.ContentCasimir` — a central element whose block eigenvalue is `Σ [c][c+1]`

`q-heat-kernel-peter-weyl` asserts that the Reeb-spin Laplacian `Δ_ξ` acts on the Wedderburn block
`V_λ` of `H_n(q)` by `Σ_{□ ∈ λ} [c(□)]_q [c(□)+1]_q`.  This file proves the **algebraic half** of that
claim and nothing more.

## What is proved

With symmetric quantum integers `[m] = (q^m − q^{−m})/(q − q⁻¹)`, and `a = q^c`, `b = q^{−c}`,
the cleared-denominator per-cell value is

    (q − q⁻¹)² · [c][c+1] = (a − b)(q·a − q⁻¹·b) = q·a² + q⁻¹·b² − (q + q⁻¹)        (ab = 1)

(`cell_identity`).  The right-hand side is a Laurent polynomial in `a² = q^{2c}`, which is the
Murphy-element eigenvalue in the QOU skein normalisation (`QJucysMurphy`, § Convention).  So

    C_n := q · Σ_k L_k + q⁻¹ · Σ_k L_k⁻¹ − (n+1)(q + q⁻¹)

* is **central** in `H_{n+1}(q)` (`contentCasimir_comm_σ`, from the centrality of `Σ L_k` and
  `Σ L_k⁻¹` already proved in `QJucysMurphy`), and
* acts on any Jucys–Murphy weight vector `v` (`L_k · v = a_k² · v` with `a_k b_k = 1`) by
  `Σ_k (a_k − b_k)(q·a_k − q⁻¹·b_k)` (`contentCasimir_smul_of_weight`), i.e. by
  `(q − q⁻¹)² · Σ_k [c_k][c_k+1]` when `a_k = q^{c_k}`.

The eigenvalue of `L_k⁻¹` on `v` is **derived** from that of `L_k` (via `qJMInv_mul_qJM`), not
assumed.

## What is NOT proved, and why it matters

1. **That every `V_λ` has such a weight vector** with `a_k² = q^{2 c_k}` is the seminormal form
   ([ram1997] Thm 4.1).  The theorem below takes the weight vector as a hypothesis.  *Update
   2026-11-16:* that hypothesis is now discharged for every shape.  `QJucysMurphyEigen.seminormalRep_qJM`
   proves Ram 4.1 on every seminormal block, and `SeminormalContentCasimir` combines it with this file:
   `seminormalRep_contentCasimir` (every `ρ_λ`) and `heckeWedderburn_contentCasimir` (every Wedderburn
   block of `H_{n+1}(q)`, char 0, `q` not a root of unity).  The trivial-representation instance is
   still checked independently in `contentCasimir_rhoTriv`.
2. **That `Δ_ξ` acts through `C_n` at all.**  `Δ_ξ` is defined geometrically, from the contact form
   and the Reeb field, with no `q` in it; nothing in the corpus puts an `H_n(q)`-action on the space
   it acts on.  This file says nothing about `Δ_ξ`.
3. **The Jackson-integer form printed in the statement is not covered.**  `[c]_J = (1 − q^c)/(1 − q)`
   needs `q^c` itself, which is not a Laurent polynomial in the Murphy eigenvalue `q^{2c}`; only the
   symmetric-integer form is the eigenvalue of an element generated by the `L_k^{±1}`.

Everything is over a generic `[CommRing K]` (AGENTS.md §7c); `qi` is the inverse of `q` by hypothesis.

Refs: [ram1997] Theorem 4.1; [murphy1992]; [hoefsmit1974].
-/

namespace QOU.SchurWeyl

open Hecke

section ContentCasimir

variable (K : Type*) [CommRing K] (q qi : K) (n : ℕ)

/-- **Per-cell identity.**  With `a·b = 1` and `q·qi = 1`, the cleared symmetric product
`(a − b)(q·a − qi·b)` — that is `(q − q⁻¹)² [c][c+1]` at `a = q^c` — equals `q·a² + qi·b² − (q + qi)`,
a Laurent polynomial in the Murphy eigenvalue `a²`. -/
theorem cell_identity (a b : K) (hab : a * b = 1) :
    (a - b) * (q * a - qi * b) = q * a ^ 2 + qi * b ^ 2 - (q + qi) := by
  linear_combination (-(q + qi)) * hab

/-- **The content Casimir** (denominators cleared by `(q − qi)²`):
`C_n = q·Σ_{k≤n} L_k + qi·Σ_{k≤n} L_k⁻¹ − (n+1)(q + qi)` in `H_{n+1}(q)`. -/
noncomputable def contentCasimir : Hecke K q qi n :=
  q • (∑ k ∈ Finset.range (n + 1), qJM K q qi n k)
    + qi • (∑ k ∈ Finset.range (n + 1), qJMInv K q qi n k)
    - algebraMap K (Hecke K q qi n) (((n + 1 : ℕ) : K) * (q + qi))

/-- **`C_n` is central**: it commutes with every Hecke generator. -/
theorem contentCasimir_comm_σ (hqi : q * qi = 1) (i : Fin n) :
    σ K q qi n i * contentCasimir K q qi n = contentCasimir K q qi n * σ K q qi n i := by
  unfold contentCasimir
  rw [mul_sub, sub_mul, mul_add, add_mul, mul_smul_comm, mul_smul_comm, smul_mul_assoc,
    smul_mul_assoc, qJM_sum_comm_sigma' K q qi n hqi i, qJMInv_sum_comm_sigma K q qi n hqi i,
    ← Algebra.commutes]

variable {K q qi n}
variable {V : Type*} [AddCommGroup V] [Module K V] [Module (Hecke K q qi n) V]
  [IsScalarTower K (Hecke K q qi n) V]

/-- The inverse Murphy element acts on a weight vector by the inverse eigenvalue: derived from
`qJMInv_mul_qJM`, not assumed. -/
theorem qJMInv_smul_of_qJM_smul (hqi : q * qi = 1) {k : ℕ} (hk : k ≤ n) (v : V) (a b : K)
    (hab : a * b = 1) (hv : qJM K q qi n k • v = a ^ 2 • v) :
    qJMInv K q qi n k • v = b ^ 2 • v := by
  have h1 : qJMInv K q qi n k • (qJM K q qi n k • v) = v := by
    rw [← mul_smul, qJMInv_mul_qJM K q qi n hqi k hk, one_smul]
  rw [hv, smul_comm] at h1
  -- h1 : a² • (L⁻¹ • v) = v
  have hb : b ^ 2 * a ^ 2 = 1 := by rw [← mul_pow, mul_comm, hab, one_pow]
  calc qJMInv K q qi n k • v
      = (b ^ 2 * a ^ 2) • qJMInv K q qi n k • v := by rw [hb, one_smul]
    _ = b ^ 2 • (a ^ 2 • qJMInv K q qi n k • v) := by rw [mul_smul]
    _ = b ^ 2 • v := by rw [h1]

/-- **Block eigenvalue of the content Casimir.**  If every Murphy element `L_k` (`k ≤ n`) acts on
`v` by `a_k²`, with `a_k b_k = 1`, then `C_n` acts on `v` by `Σ_k (a_k − b_k)(q·a_k − qi·b_k)`,
which is `(q − q⁻¹)² Σ_k [c_k][c_k+1]` when `a_k = q^{c_k}`. -/
theorem contentCasimir_smul_of_weight (hqi : q * qi = 1) (v : V) (a b : ℕ → K)
    (hab : ∀ k, a k * b k = 1)
    (hw : ∀ k, k ≤ n → qJM K q qi n k • v = a k ^ 2 • v) :
    contentCasimir K q qi n • v
      = (∑ k ∈ Finset.range (n + 1), (a k - b k) * (q * a k - qi * b k)) • v := by
  have hinv : ∀ k ∈ Finset.range (n + 1), qJMInv K q qi n k • v = b k ^ 2 • v := fun k hk =>
    qJMInv_smul_of_qJM_smul hqi (Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)) v (a k) (b k)
      (hab k) (hw k (Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)))
  have hfwd : ∀ k ∈ Finset.range (n + 1), qJM K q qi n k • v = a k ^ 2 • v := fun k hk =>
    hw k (Nat.lt_succ_iff.mp (Finset.mem_range.mp hk))
  have hcell : ∀ k ∈ Finset.range (n + 1),
      (a k - b k) * (q * a k - qi * b k) = q * a k ^ 2 + qi * b k ^ 2 - (q + qi) :=
    fun k _ => cell_identity K q qi (a k) (b k) (hab k)
  rw [Finset.sum_congr rfl hcell, Finset.sum_smul]
  have hterm : ∀ k ∈ Finset.range (n + 1),
      (q * a k ^ 2 + qi * b k ^ 2 - (q + qi)) • v
        = q • (a k ^ 2 • v) + qi • (b k ^ 2 • v) - (q + qi) • v := fun k _ => by
    rw [sub_smul, add_smul, mul_smul, mul_smul]
  unfold contentCasimir
  rw [Finset.sum_congr rfl hterm, Finset.sum_sub_distrib, Finset.sum_add_distrib,
    ← Finset.smul_sum, ← Finset.smul_sum, Finset.sum_const, Finset.card_range,
    sub_smul, add_smul, smul_assoc, smul_assoc, Finset.sum_smul, Finset.sum_smul,
    Finset.sum_congr rfl hfwd, Finset.sum_congr rfl hinv, algebraMap_smul, mul_smul,
    Nat.cast_smul_eq_nsmul]

end ContentCasimir

/-! ## Non-vacuity: the trivial representation

On `ρ_triv` the Murphy element `L_k` acts by `q^{2k}` (`qJM_rhoTriv`), the one-row contents
`c = 0, …, n`.  The content Casimir there is `Σ_k (q^k − qi^k)(q^{k+1} − qi^{k+1})`, the cleared form of
`(q − q⁻¹)² Σ_{c=0}^{n} [c][c+1]` — computed directly in the representation, independently of the
weight-vector theorem above. -/

section Trivial

variable (K : Type*) [CommRing K] (q qi : K) (n : ℕ)

theorem contentCasimir_rhoTriv (hqi : q * qi = 1) :
    rhoTriv K q qi n (contentCasimir K q qi n)
      = ∑ k ∈ Finset.range (n + 1), (q ^ k - qi ^ k) * (q ^ (k + 1) - qi ^ (k + 1)) := by
  unfold contentCasimir
  rw [map_sub, map_add, map_smul, map_smul, map_sum, map_sum, AlgHom.commutes,
    Algebra.algebraMap_self_apply]
  have hfwd : ∀ k ∈ Finset.range (n + 1), rhoTriv K q qi n (qJM K q qi n k) = q ^ (2 * k) :=
    fun k hk => qJM_rhoTriv K q qi n k (Nat.lt_succ_iff.mp (Finset.mem_range.mp hk))
  have hinv : ∀ k ∈ Finset.range (n + 1), rhoTriv K q qi n (qJMInv K q qi n k) = qi ^ (2 * k) :=
    fun k hk => qJMInv_rhoTriv K q qi n k (Nat.lt_succ_iff.mp (Finset.mem_range.mp hk))
  rw [Finset.sum_congr rfl hfwd, Finset.sum_congr rfl hinv, smul_eq_mul, smul_eq_mul,
    Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
  have hcard : (((n + 1 : ℕ) : K) * (q + qi)) = ∑ _k ∈ Finset.range (n + 1), (q + qi) := by
    rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
  rw [hcard, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun k _ => ?_
  have hk : q ^ k * qi ^ k = 1 := by rw [← mul_pow, hqi, one_pow]
  linear_combination (q + qi) * hk

end Trivial

end QOU.SchurWeyl
