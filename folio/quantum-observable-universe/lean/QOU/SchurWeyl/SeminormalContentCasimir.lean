import QOU.SchurWeyl.ContentCasimir
import QOU.SchurWeyl.QJucysMurphyEigen
import QOU.SchurWeyl.HeckeWedderburnGeneral

/-!
# `QOU.SchurWeyl.SeminormalContentCasimir` — the content Casimir on every Wedderburn block

`ContentCasimir.contentCasimir_smul_of_weight` computes the action of the central element

    C_n = q·Σ_k L_k + q⁻¹·Σ_k L_k⁻¹ − (n+1)(q + q⁻¹)

on a Jucys–Murphy weight vector, and takes the weight vector **as a hypothesis**: its header says
the seminormal form (Ram 1997, Thm 4.1) is known only for the trivial, sign and `(2,1)`
representations.  That note is stale.  `QJucysMurphyEigen.seminormalRep_qJM` proves Ram 4.1 for the
seminormal representation `ρ_μ` of **every** Young diagram `μ`, over any field, at any `q ≠ 0` that
is not a root of unity, and `HeckeWedderburnGeneral.heckeWedderburn` proves that these `ρ_λ`,
`λ ⊢ n+1`, are **all** the Wedderburn blocks of `H_{n+1}(q)` (char 0).

This file joins the two.  Nothing is assumed.

* `seminormalRep_contentCasimir` — `ρ_μ(C_n)` is the scalar matrix
  `Σ_{c ∈ μ} (q^c − q^{−c})(q^{c+1} − q^{−(c+1)})`, i.e. `(q − q⁻¹)² Σ_{c∈μ} [c]_q [c+1]_q` with
  symmetric quantum integers, `c` the content `col − row` of the cell.
* `heckeWedderburn_contentCasimir` — under the Wedderburn isomorphism
  `H_{n+1}(q) ≃ ∏_{λ ⊢ n+1} M_{d_λ}(K)`, `C_n` goes to the tuple of these scalars: the block
  eigenvalue on **every** block, with no weight vector supplied by hand.

## What this does NOT give

It says nothing about the Reeb-spin Laplacian `Δ_ξ`.  Whether `Δ_ξ` acts through `C_n` is gap 2 of
`ContentCasimir` (and of the binding `μ_λ` question), and it is untouched here.  The Jackson-integer
form of the eigenvalue is still not the eigenvalue of any element generated by the `L_k^{±1}`.

Base ring (§7c): any field for the block statement; `CharZero` for the Wedderburn statement, which
is what `heckeWedderburn` needs.  `q ≠ 0` and `NotRootOfUnity q` are the genericity Ram 4.1
presupposes.

Refs: [ram1997] Theorem 4.1; [murphy1992]; [hoefsmit1974].
-/

namespace QOU.SchurWeyl

open QOU.Mathlib (StandardYoungTableau)
open TableauCells SeminormalRep

section Block

variable {μ : YoungDiagram}

/-- The per-cell eigenvalue, denominators cleared: `(q^c − q^{−c})(q·q^c − q⁻¹·q^{−c})`, which is
`(q − q⁻¹)² [c]_q [c+1]_q` with symmetric quantum integers. -/
noncomputable def cellCasimirVal {K : Type*} [Field K] (q : K) (c : ℕ × ℕ) : K :=
  (q ^ cellContent c - q ^ (-cellContent c)) * (q * q ^ cellContent c - q⁻¹ * q ^ (-cellContent c))

/-- The same value written as a Laurent polynomial in the Murphy eigenvalue `q^{2c}`. -/
theorem cellCasimirVal_eq {K : Type*} [Field K] (q : K) (hq0 : q ≠ 0) (c : ℕ × ℕ) :
    cellCasimirVal q c
      = q * q ^ (2 * cellContent c) + q⁻¹ * q ^ (-(2 * cellContent c)) - (q + q⁻¹) := by
  have hab : q ^ cellContent c * q ^ (-cellContent c) = 1 := by
    rw [← zpow_add₀ hq0, add_neg_cancel, zpow_zero]
  have h := cell_identity K q q⁻¹ (q ^ cellContent c) (q ^ (-cellContent c)) hab
  rw [cellCasimirVal, h, ← zpow_natCast, ← zpow_natCast, ← zpow_mul, ← zpow_mul]
  push_cast
  ring_nf

/-- **Ram 4.1 applied to the content Casimir, on every seminormal block.**  `ρ_μ(C_n)` is the
scalar `Σ_{c ∈ μ} (q − q⁻¹)² [c][c+1]` (cleared form). -/
theorem seminormalRep_contentCasimir {K : Type*} [Field K] (q : K) (hq0 : q ≠ 0)
    (hq2 : QOU.SchurWeyl.GenericParameter.NotRootOfUnity q) (n : ℕ) (hN : μ.cells.card = n + 1) :
    seminormalRep q hq0 hq2 n hN (contentCasimir K q q⁻¹ n)
      = (∑ c ∈ μ.cells, cellCasimirVal q c)
          • (1 : Matrix (StandardYoungTableau μ) (StandardYoungTableau μ) K) := by
  classical
  have hfwd : ∀ k ∈ Finset.range (n + 1),
      seminormalRep q hq0 hq2 n hN (qJM K q q⁻¹ n k) = jmDiagVal q (k + 1) := fun k hk =>
    seminormalRep_qJM q hq0 hq2 n hN k (Nat.lt_succ_iff.mp (Finset.mem_range.mp hk))
  have hinv : ∀ k ∈ Finset.range (n + 1),
      seminormalRep q hq0 hq2 n hN (qJMInv K q q⁻¹ n k) = jmDiagValInv q (k + 1) := fun k hk =>
    seminormalRep_qJMInv q hq0 hq2 n hN k (Nat.lt_succ_iff.mp (Finset.mem_range.mp hk))
  rw [contentCasimir, map_sub, map_add, map_smul, map_smul, map_sum, map_sum,
    Finset.sum_congr rfl hfwd, Finset.sum_congr rfl hinv, AlgHom.commutes,
    Algebra.algebraMap_eq_smul_one]
  ext T U
  simp only [Matrix.sub_apply, Matrix.add_apply, Matrix.smul_apply, Matrix.sum_apply,
    Matrix.one_apply, smul_eq_mul, jmDiagVal, jmDiagValInv]
  by_cases h : T = U
  · subst h
    simp only [Matrix.diagonal_apply_eq, if_pos, mul_one]
    have hsum := sum_cellOf_range T hN (fun c => cellCasimirVal q c)
    rw [← hsum, Finset.sum_congr rfl (fun k _ => cellCasimirVal_eq q hq0 (cellOf T (k + 1))),
      Finset.sum_sub_distrib, Finset.sum_add_distrib, Finset.sum_const, Finset.card_range,
      ← Finset.mul_sum, ← Finset.mul_sum, nsmul_eq_mul]
  · simp only [Matrix.diagonal_apply_ne _ h, if_neg h, Finset.sum_const_zero, mul_zero,
      sub_zero, add_zero]

end Block

section Wedderburn

/-- **The content Casimir on the Wedderburn decomposition of `H_{n+1}(q)`.**  Under
`heckeWedderburn : H_{n+1}(q) ≃ ∏_{λ ⊢ n+1} M_{d_λ}(K)`, `C_n` is the tuple of block scalars
`Σ_{c ∈ λ} (q − q⁻¹)² [c][c+1]`.  Every block is covered, and no weight vector is assumed. -/
theorem heckeWedderburn_contentCasimir {K : Type*} [Field K] [CharZero K] (q : K) (hq0 : q ≠ 0)
    (hq2 : QOU.SchurWeyl.GenericParameter.NotRootOfUnity q) (n : ℕ) (lam : Partition (n + 1)) :
    heckeWedderburn q hq0 hq2 n (contentCasimir K q q⁻¹ n) lam
      = (∑ c ∈ (QOU.Mathlib.partitionShape lam).cells, cellCasimirVal q c) • 1 := by
  show heckeProduct q hq0 hq2 n (contentCasimir K q q⁻¹ n) lam = _
  rw [heckeProduct_apply]
  exact seminormalRep_contentCasimir q hq0 hq2 n (partitionShape_card_succ lam)

end Wedderburn

end QOU.SchurWeyl
