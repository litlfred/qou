import QOU.SchurWeyl.QuantumGLCommutant

/-!
# Weight projectors are polynomials in the Cartan elements (G3.4 follow-up 1, bean `qou-gl34`)

At generic `q` (`q ≠ 0`, not a root of unity) the weight projector `weightProj μ` on
`V^{⊗n}` lies in the subalgebra generated by the Cartan elements `cartan c`. Concretely, with
`K_x = cartan (q on e_x, 1 elsewhere)`, which acts on `e_a` by `q^{content a x}`,

  `weightProj μ = ∏_x ∏_{t ≤ n, t ≠ μ x} (q^{μ x} − q^t)⁻¹ (K_x − q^t)`

(Lagrange interpolation on the eigenvalues `q^0, …, q^n`, which are distinct at generic `q`).

Consequence: the commutant of Stream 14's `uqGens` (raising, lowering, Cartan, weight projectors)
equals the commutant of the generators **without** the weight projectors, so
`range_jimbo_eq_commutant` holds for `{E_i, lowerOp, Cartan}` alone
(`range_jimbo_eq_commutant_cartan`). Any field for the projector lemma; the restated G3.4
inherits the ordered-field hypothesis of `range_jimbo_eq_commutant`.
-/

namespace QOU.SchurWeyl.QuantumGL

open Matrix

variable {K : Type*} [Field K] {d n : ℕ}

/-- `K_x`: `q` on `e_x`, `1` on the other basis vectors, acting diagonally on `V^{⊗n}`. -/
def cartanAt (q : K) (x : Fin d) : Matrix (Fin n → Fin d) (Fin n → Fin d) K :=
  cartan fun y => if y = x then q else 1

theorem cartanAt_eq (q : K) (x : Fin d) :
    (cartanAt q x : Matrix (Fin n → Fin d) (Fin n → Fin d) K)
      = diagonal fun a => q ^ content a x := by
  unfold cartanAt cartan content
  congr 1
  funext a
  rw [Finset.prod_ite, Finset.prod_const_one, mul_one, Finset.prod_const]

theorem content_le (a : Fin n → Fin d) (x : Fin d) : content a x ≤ n := by
  unfold content
  exact (Finset.card_filter_le _ _).trans (by simp)

/-- The Cartan elements. -/
def cartanSet : Set (Matrix (Fin n → Fin d) (Fin n → Fin d) K) := {X | ∃ c : Fin d → K, X = cartan c}

/-- **Weight projectors are Cartan polynomials** at generic `q`. -/
theorem weightProj_mem_adjoin_cartan (q : K) (hq : q ≠ 0)
    (hq2 : GenericParameter.NotRootOfUnity q) (μ : Fin d → ℕ) :
    (weightProj μ : Matrix (Fin n → Fin d) (Fin n → Fin d) K)
      ∈ Algebra.adjoin K (cartanSet (K := K) (d := d) (n := n)) := by
  classical
  have hinj := GenericParameter.pow_left_injective hq hq2
  -- the generators, as functions on words
  let g : Fin d → ((Fin n → Fin d) → K) := fun x a => q ^ content a x
  -- the interpolating function
  let p : (Fin n → Fin d) → K := ∏ x : Fin d, ∏ t ∈ (Finset.range (n + 1)).erase (μ x),
      (q ^ μ x - q ^ t)⁻¹ • (g x - algebraMap K _ (q ^ t))
  have hpmem : p ∈ Algebra.adjoin K (Set.range g) := by
    refine Subalgebra.prod_mem _ fun x _ => Subalgebra.prod_mem _ fun t _ => ?_
    refine Subalgebra.smul_mem _ (Subalgebra.sub_mem _ ?_ (Subalgebra.algebraMap_mem _ _)) _
    exact Algebra.subset_adjoin ⟨x, rfl⟩
  have hval : diagonalAlgHom K p = weightProj μ := by
    rw [diagonalAlgHom_apply, weightProj]
    congr 1
    funext a
    simp only [p, g, Finset.prod_apply, Pi.smul_apply, Pi.sub_apply, smul_eq_mul,
      Pi.algebraMap_apply, Algebra.algebraMap_self, RingHom.id_apply]
    by_cases ha : content a = μ
    · rw [if_pos ha]
      refine Finset.prod_eq_one fun x _ => Finset.prod_eq_one fun t ht => ?_
      have htx : t ≠ μ x := Finset.ne_of_mem_erase ht
      have hne : q ^ μ x - q ^ t ≠ 0 := sub_ne_zero.2 fun h => htx (hinj h).symm
      rw [ha, inv_mul_cancel₀ hne]
    · rw [if_neg ha]
      obtain ⟨x, hx⟩ : ∃ x, content a x ≠ μ x := by
        by_contra h; push_neg at h; exact ha (funext h)
      refine Finset.prod_eq_zero (Finset.mem_univ x) (Finset.prod_eq_zero (i := content a x) ?_ ?_)
      · exact Finset.mem_erase.2 ⟨hx, Finset.mem_range.2 (Nat.lt_succ_of_le (content_le a x))⟩
      · rw [sub_self, mul_zero]
  rw [← hval]
  have himg : (Algebra.adjoin K (Set.range g)).map (diagonalAlgHom K)
      ≤ Algebra.adjoin K (cartanSet (K := K) (d := d) (n := n)) := by
    rw [AlgHom.map_adjoin]
    refine Algebra.adjoin_mono ?_
    rintro _ ⟨_, ⟨x, rfl⟩, rfl⟩
    refine ⟨fun y => if y = x then q else 1, ?_⟩
    rw [diagonalAlgHom_apply, ← cartanAt_eq q x, cartanAt]
  exact himg ⟨p, hpmem, rfl⟩

/-! ### Dropping the weight projectors from the generators -/

/-- Stream 14's generators without the weight projectors: raising, lowering, Cartan. -/
def uqGensCartan (q : K) (m : ℕ) : Set (Matrix (Fin (m + 1) → Fin d) (Fin (m + 1) → Fin d) K) :=
  {X | (∃ i j : Fin d, (j : ℕ) = i + 1 ∧
        (X = raiseOp q q⁻¹ i j ∨ X = lowerOp q q⁻¹ i j)) ∨ ∃ c : Fin d → K, X = cartan c}

theorem uqGensCartan_subset (q : K) (m : ℕ) :
    uqGensCartan (d := d) q m ⊆ uqGens q m := by
  rintro X (h | h)
  · exact Or.inl h
  · exact Or.inr (Or.inl h)

/-- **The commutant does not see the weight projectors** at generic `q`. -/
theorem commutant_uqGens_eq_cartan (q : K) (hq : q ≠ 0)
    (hq2 : GenericParameter.NotRootOfUnity q) (m : ℕ) :
    commutant (uqGens (d := d) q m) = commutant (uqGensCartan q m) := by
  apply le_antisymm
  · intro Y hY X hX
    exact hY X (uqGensCartan_subset q m hX)
  · intro Y hY X hX
    rcases hX with h | h | ⟨μ, rfl⟩
    · exact hY X (Or.inl h)
    · exact hY X (Or.inr h)
    · -- `Y` commutes with every Cartan element, hence with the algebra they generate
      have hle : Algebra.adjoin K (cartanSet (K := K) (d := d) (n := m + 1))
          ≤ Subalgebra.centralizer K {Y} := by
        refine Algebra.adjoin_le ?_
        rintro _ ⟨c, rfl⟩
        rw [SetLike.mem_coe, Subalgebra.mem_centralizer_iff]
        rintro _ rfl
        exact (hY _ (Or.inr ⟨c, rfl⟩))
      have h := (Subalgebra.mem_centralizer_iff K).1
        (hle (weightProj_mem_adjoin_cartan q hq hq2 μ)) Y rfl
      exact h

/-- **G3.4 with the smaller generator set** `{E_i, lowerOp, Cartan}` (ordered field, generic
`q`): the Jimbo image of `H_{m+1}(q)` is the commutant of the raising, lowering and Cartan
operators. -/
theorem range_jimbo_eq_commutant_cartan {L : Type*} [Field L] [LinearOrder L]
    [IsStrictOrderedRing L] [NeZero d] (q : L) (hq : q ≠ 0)
    (hq2 : GenericParameter.NotRootOfUnity q) (m : ℕ) :
    LinearMap.range (JimboGL.jimbo d q hq m).toLinearMap = commutant (uqGensCartan q m) := by
  rw [range_jimbo_eq_commutant q hq hq2 m, commutant_uqGens_eq_cartan q hq hq2 m]

end QOU.SchurWeyl.QuantumGL
