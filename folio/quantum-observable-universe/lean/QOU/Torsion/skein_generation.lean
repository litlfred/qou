import Mathlib.Algebra.Algebra.Basic
import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.Data.Set.Basic
import Mathlib.Data.Finset.Basic

/-!
# QOU.Torsion.skein_generation — Skein generation, DERIVED from a terminating resolution

**Proposition** ([`prop:skein-generation`](../../../quantum-observable-universe/mass-theory/skein-generation.md)).

*Let `R` be a commutative ring in which `s = q^{1/2} - q^{-1/2}` is a unit, and let `𝓢_q(S³)` be the HOMFLYPT skein module of `S³` over `R`. Then `𝓢_q(S³)` is a free `R`-module with a basis indexed by unordered finite multisets of nontrivial prime knots (see [przytycki1991]).*

**Note (2026-11-16 alignment):** This module formalises abstract generation of an `R`-algebra from a terminating resolution of every element into a finite polynomial in a specified generating set (`fundamentalKnot` and `hopfLink`). For the updated HOMFLYPT freeness statement and why torus knots + Hopf link alone do not generate hyperbolic knots (e.g. `4₁`), see `folio/quantum-observable-universe/mass-theory/skein-generation.md`.

## What changed, and why (bean `qou-skgn`)

This file previously carried `generation_top : Algebra.adjoin R G = ⊤` as a
**class field** and proved the proposition by `rw [ctx.generation_top]; exact
Algebra.mem_top`. That is the vacuous self-assuming projection AGENTS.md
§3b-cond item 5 defines: the class carried the block's own conclusion and the
"theorem" projected it, so the Lean derived nothing.

The remedy taken here is §3b-cond item 5's own: the class now carries the
**inputs** — a terminating resolution — and generation is **derived** from
them.

The mathematical content of "the skein relations generate" is exactly that: a
skein move rewrites an element in terms of strictly simpler ones, and the
rewriting terminates. So the honest hypotheses are

* `complexity` — a `ℕ`-valued measure (crossing number, in the intended model);
* `base` — an element of complexity `0` is already in the generated subalgebra;
* `resolve` — an element of positive complexity lies in the subalgebra generated
  by the generators **together with finitely many strictly simpler elements**.

`skein_generation` is then a genuine strong induction on `complexity`, and it
would be **false** for a context whose resolution did not terminate. That is
what distinguishes it from the projection it replaces: the conclusion now
depends on the hypotheses.

The `Finset` in `resolve` is deliberate — it encodes the narrative's *"finite
polynomial"*, which the previous encoding dropped.

## What is still NOT formalised

Stated so the formalisation is not read as stronger than it is. The narrative
sentence has four content words and this file carries two of them:

* **no hadron restriction** — the conclusion is for every `h : Skein`, whereas
  the prose says *"every **hadron**"*. `QOU/scratch_skein.lean` carries a
  `Hadron : Skein → Prop` restriction and is closer on this point.
* **no `ℤ[q^{±1}]` coefficient ring** — `R` is an arbitrary `CommRing`.

Both are recorded in bean `qou-skgn` as route (3), a strictly harder
formalisation than either copy in the corpus has.

-- Ref: [leitner2026] quantum-observable-universe/mass-theory/skein-generation.md
-/

open Set

namespace QOU.Torsion

/-- Abstract context for the Skein-module generation claim.

    The fields are the **inputs** to generation, not generation itself: a
    complexity measure, a base case, and a resolution step that strictly
    decreases it. See the module docstring for why (bean `qou-skgn`). -/
class SkeinGenerationContext (R Skein FundamentalKnotIndex : Type*)
    [CommRing R] [Ring Skein] [Algebra R Skein] where
  /-- The fundamental knot embeddings `K_i ∈ 𝓢_q`. -/
  fundamentalKnot : FundamentalKnotIndex → Skein
  /-- The Hopf-link generator `𝓛_Hopf`. -/
  hopfLink : Skein
  /-- Complexity of a Skein element — crossing number, in the intended model.
      Well-foundedness of `ℕ` is what makes the resolution terminate. -/
  complexity : Skein → ℕ
  /-- **Base case.** An element of complexity `0` is irreducible: it already
      lies in the subalgebra generated by the fundamentals and the Hopf link. -/
  base : ∀ s : Skein, complexity s = 0 →
    s ∈ Algebra.adjoin R (range fundamentalKnot ∪ {hopfLink})
  /-- **Resolution step.** An element of positive complexity is expressible
      using the generators together with *finitely many* strictly simpler
      elements — one application of the skein relations.

      The `Finset` carries the narrative's "finite polynomial"; the strict
      decrease is what makes the induction terminate. -/
  resolve : ∀ s : Skein, 0 < complexity s →
    ∃ t : Finset Skein, (∀ x ∈ t, complexity x < complexity s) ∧
      s ∈ Algebra.adjoin R ((↑t : Set Skein) ∪ (range fundamentalKnot ∪ {hopfLink}))

/-- The generating set: fundamental knots together with the Hopf link. -/
def skeinGenerators (R Skein FundamentalKnotIndex : Type*)
    [CommRing R] [Ring Skein] [Algebra R Skein]
    [ctx : SkeinGenerationContext R Skein FundamentalKnotIndex] : Set Skein :=
  range ctx.fundamentalKnot ∪ {ctx.hopfLink}

/-- **Every element of bounded complexity is generated.** The induction that
    does the work: strong recursion on the complexity measure. -/
theorem mem_adjoin_of_complexity_eq {R Skein FundamentalKnotIndex : Type*}
    [CommRing R] [Ring Skein] [Algebra R Skein]
    [ctx : SkeinGenerationContext R Skein FundamentalKnotIndex] :
    ∀ n : ℕ, ∀ s : Skein, ctx.complexity s = n →
      s ∈ Algebra.adjoin R (range ctx.fundamentalKnot ∪ {ctx.hopfLink}) := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro s hs
    rcases Nat.eq_zero_or_pos n with h0 | hpos
    · exact ctx.base s (hs.trans h0)
    · obtain ⟨t, hlt, hmem⟩ := ctx.resolve s (hs ▸ hpos)
      refine Algebra.adjoin_le ?_ hmem
      rintro x (hx | hx)
      · exact ih (ctx.complexity x) (hs ▸ hlt x hx) x rfl
      · exact Algebra.subset_adjoin hx

/-- **Skein-module generation** ([`prop:skein-generation`]).

    Every Skein element lies in the subalgebra generated by the fundamental
    torus knots and the Hopf link.

    **Derived, not assumed.** The proof is the strong induction above; the
    context supplies a terminating resolution, and the conclusion follows from
    it. A context whose `resolve` did not strictly decrease `complexity` would
    not yield this. -/
-- Ref: [leitner2026] quantum-observable-universe/mass-theory/skein-generation.md
theorem skein_generation {R Skein FundamentalKnotIndex : Type*}
    [CommRing R] [Ring Skein] [Algebra R Skein]
    [ctx : SkeinGenerationContext R Skein FundamentalKnotIndex]
    (h : Skein) :
    h ∈ Algebra.adjoin R (range ctx.fundamentalKnot ∪ {ctx.hopfLink}) :=
  mem_adjoin_of_complexity_eq (ctx.complexity h) h rfl

/-- The generation statement in `= ⊤` form — the shape the previous encoding
    took as a hypothesis. It is now a **consequence**. -/
theorem skein_generation_top {R Skein FundamentalKnotIndex : Type*}
    [CommRing R] [Ring Skein] [Algebra R Skein]
    [SkeinGenerationContext R Skein FundamentalKnotIndex] :
    Algebra.adjoin R (range (SkeinGenerationContext.fundamentalKnot (R := R)
        (Skein := Skein) (FundamentalKnotIndex := FundamentalKnotIndex)) ∪
      {SkeinGenerationContext.hopfLink (R := R) (Skein := Skein)
        (FundamentalKnotIndex := FundamentalKnotIndex)}) = ⊤ :=
  eq_top_iff.mpr fun h _ => skein_generation h

/-! ## Non-vacuity

`skein_generation` is conditional on `SkeinGenerationContext`. A conditional
theorem is worthless if its hypotheses cannot be jointly met, so the interface
is exhibited inhabited below.

**This is deliberately NOT an `instance`.** Declared as one it would apply to
*every* `Skein` by instance resolution, silently discharging the hypothesis
everywhere and making `skein_generation` trivially available for all — which is
precisely the defect this file was restructured to remove. It is a `def`, used
only to witness satisfiability. -/

/-- A trivial context: every element is its own fundamental knot, so the
    generating set is everything and all complexities are `0`.

    Trivial as a *resolution* — `resolve` is never reached — but it establishes
    that the four fields are jointly satisfiable, which is what non-vacuity
    requires. It says nothing about the intended Skein-module model. -/
def trivialSkeinGenerationContext (R Skein : Type*)
    [CommRing R] [Ring Skein] [Algebra R Skein] :
    SkeinGenerationContext R Skein Skein where
  fundamentalKnot := id
  hopfLink := 0
  complexity := fun _ => 0
  base := by
    intro s _
    exact Algebra.subset_adjoin (Or.inl ⟨s, rfl⟩)
  resolve := by
    intro _ hs
    exact absurd hs (lt_irrefl 0)

/-! ## Route (3), hadron half — the narrative's actual quantifier

`skein_generation` above concludes for **every** `h : Skein`, while the
narrative says *"every **hadron** admits a terminal Skein resolution"*. Those
are different claims, and the unrestricted one is not automatically the more
useful: it demands a resolution for elements the physics never asks about.

The class below is the honest restriction. Its hypotheses are **strictly
weaker** — only hadrons need resolve, and a resolution must stay within
hadrons — and its conclusion is correspondingly restricted. It is not a
specialisation of the above; neither implies the other.

This supersedes `QOU/scratch_skein.lean`, which carried the `Hadron`
restriction but did so as a projection: its `hadron_is_polynomial` field *was*
the conclusion. The restriction was the only thing in that file worth keeping,
and here it is derived rather than assumed (beans `qou-skgn`, `qou-scrx`). -/

/-- Hadron-relative terminating resolution.

    Weaker than `SkeinGenerationContext`: `base` and `resolve` are required
    only of hadrons, and `resolve` must produce hadrons, so the induction stays
    inside the restricted class. -/
class HadronSkeinResolution (R Skein FundamentalKnotIndex : Type*)
    [CommRing R] [Ring Skein] [Algebra R Skein] where
  /-- The fundamental knot embeddings `K_i ∈ 𝓢_q`. -/
  fundamentalKnot : FundamentalKnotIndex → Skein
  /-- The Hopf-link generator `𝓛_Hopf`. -/
  hopfLink : Skein
  /-- The hadron predicate — the narrative's quantifier. -/
  Hadron : Skein → Prop
  /-- Complexity measure; crossing number in the intended model. -/
  complexity : Skein → ℕ
  /-- Base case, required only of hadrons. -/
  base : ∀ s : Skein, Hadron s → complexity s = 0 →
    s ∈ Algebra.adjoin R (range fundamentalKnot ∪ {hopfLink})
  /-- Resolution step, required only of hadrons and **producing** hadrons —
      without that the induction could leave the restricted class. -/
  resolve : ∀ s : Skein, Hadron s → 0 < complexity s →
    ∃ t : Finset Skein, (∀ x ∈ t, Hadron x ∧ complexity x < complexity s) ∧
      s ∈ Algebra.adjoin R ((↑t : Set Skein) ∪ (range fundamentalKnot ∪ {hopfLink}))

/-- The hadron-restricted induction. -/
theorem hadron_mem_adjoin_of_complexity_eq {R Skein FundamentalKnotIndex : Type*}
    [CommRing R] [Ring Skein] [Algebra R Skein]
    [ctx : HadronSkeinResolution R Skein FundamentalKnotIndex] :
    ∀ n : ℕ, ∀ s : Skein, ctx.Hadron s → ctx.complexity s = n →
      s ∈ Algebra.adjoin R (range ctx.fundamentalKnot ∪ {ctx.hopfLink}) := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro s hh hs
    rcases Nat.eq_zero_or_pos n with h0 | hpos
    · exact ctx.base s hh (hs.trans h0)
    · obtain ⟨t, hlt, hmem⟩ := ctx.resolve s hh (hs ▸ hpos)
      refine Algebra.adjoin_le ?_ hmem
      rintro x (hx | hx)
      · exact ih (ctx.complexity x) (hs ▸ (hlt x hx).2) x (hlt x hx).1 rfl
      · exact Algebra.subset_adjoin hx

/-- **Skein generation, hadron-restricted** — the narrative's own statement.

    *Every hadron admits a terminal Skein resolution into a finite polynomial
    in the fundamental knots and the Hopf link.*

    Derived from a hadron-relative terminating resolution, not assumed. The
    `Finset` in `resolve` is the "finite polynomial"; the strict decrease is
    the "terminal". -/
-- Ref: [leitner2026] quantum-observable-universe/mass-theory/skein-generation.md
theorem skein_generation_hadron {R Skein FundamentalKnotIndex : Type*}
    [CommRing R] [Ring Skein] [Algebra R Skein]
    [ctx : HadronSkeinResolution R Skein FundamentalKnotIndex]
    (h : Skein) (hh : ctx.Hadron h) :
    h ∈ Algebra.adjoin R (range ctx.fundamentalKnot ∪ {ctx.hopfLink}) :=
  hadron_mem_adjoin_of_complexity_eq (ctx.complexity h) h hh rfl

/-- Non-vacuity for the hadron-relative interface. A `def`, not an `instance`,
    for the reason given above. -/
def trivialHadronSkeinResolution (R Skein : Type*)
    [CommRing R] [Ring Skein] [Algebra R Skein] :
    HadronSkeinResolution R Skein Skein where
  fundamentalKnot := id
  hopfLink := 0
  Hadron := fun _ => True
  complexity := fun _ => 0
  base := by
    intro s _ _
    exact Algebra.subset_adjoin (Or.inl ⟨s, rfl⟩)
  resolve := by
    intro _ _ hs
    exact absurd hs (lt_irrefl 0)

end QOU.Torsion
