namespace QOU.Torsion


/-- Abstract context for the `mass_decomposition_categorical` claim — manuscript-named
    typed fields below; the `holds` field carries the `Prop`-valued
    claim of the lemma. -/
class MassDecompositionCategoricalContext where
  /-- The substrate parameter `q : ℝ`. -/
  q : ℝ
  /-- The brane-tower depth `N`. -/
  N : ℕ
  /-- Total categorical mass `𝔪(ρ)`. -/
  mass : ℝ
  /-- Per-level mass contribution `𝔪_n(ρ_n)`. -/
  mass_level : ℕ → ℝ
  /-- Proposition: the mass decomposes categorially. -/
  mass_decomposes : Prop
  /-- Hypothesis that the mass decomposition is active. -/
  decomposition_active : mass_decomposes
  /-- Manuscript identity: tower decomposition
      `𝔪(ρ) = Σ_{n=0..N-1} 𝔪_n(ρ_n)`. -/
  impl_mass_decomposition_categorical :
    mass_decomposes →
    mass = (Finset.range N).sum (fun n => mass_level n)

/-- **Content statement** (from manuscript):

Let $(\mathbf{C}, A, \tau)$ be a
([quantum observable universe](#def\:quantum-observable-universe)); let $q$
denote the substrate parameter.  Let
$\varrho \colon \mathbf{1} \to A$ be a morphism (a "closed cycle" in $A$,
[mass identity](#def\:mass-identity)) whose categorical support is
generated by $N$ consecutive extensions along the brane tower
$\{A_n\}_{n \geq 0}$
([recursive brane tower](#def\:recursive-brane-tower)), applied to a
base-level morphism $\varrho_0 \colon \mathbf{1} \to A_0$.

