import QOU.BraidsAndKnots.RationalAssociator.GRTAction
import QOU.BraidsAndKnots.RationalAssociator.UniversalDK

/-!
# The transported family is Drinfeld–Kohno, given one far relation; the universal action theorem

Bean `qou-3fdg` (stage 3c of the rational-associator plan, epic `qou-dk7p`). Builds on
`GRTAction.lean`.

* `dk4_of_locals`: ten commutations, each local to one bracketing of four strands, together with
  `[s₁₃, s₂₄] = 0`, imply all fifteen `DK4` relations. The ±1 coefficients were generated by
  `computations/rational_associator/grt_far_relation/gen.py`.
* `locals_of_dk4`, `commute_total`: the matching facts for a `DK4` family `t`.
* `transported_dk4`: the transported family of `GRTAction.lean`, completed by
  `s₁₄ = t₁₄ + t₂₄ + t₃₄ − s₂₄ − s₃₄`, is `DK4` given `hfar : [s₁₃, s₂₄] = 0`. It uses only the
  pentagon of `g`.
* `Fil`: the word-length filtration of `U4 N`. `word_eq_zero_of_Fil_one`: a word of length `N`
  in elements of `Fil N 1` vanishes.
* `pentagon_act_universal`: in `U4 N`, the pentagons of `φ` and `g` and `hfar` imply the pentagon
  of `φ̃ = φ(g A g⁻¹, B) · g`.

**`hfar` is a genuine hypothesis and is not derivable from the pentagon of `g`.** Exact
computation over `ℚ` (`deg4q.py`): if the degree-2 part of `g` is `[X, Y]`, which is compatible
with the pentagon and with `g(X,Y) g(Y,X) = 1`, then `[s₁₃, s₂₄]` has a nonzero degree-4 part in
`U(𝔱₄)`. Drinfeld's associators with `μ ≠ 0` are pentagon solutions of exactly this kind. The
μ = 0 hexagon (5.14) of `GRT` excludes a degree-2 part. At degree 5 (mod p), the grt element
`σ₃` gives `[s₁₃, s₂₄] = 0`. Deriving `hfar` from (5.13)/(5.14) in Lean is open; see
`docs/audits/2026-11-27-grt-action-pentagon-derivation.md` §5. Nothing analytic is used.
-/

namespace QOU.BraidsAndKnots.RationalAssociator

section Locals

variable {R : Type*} [Ring R]

/-- A six-tuple satisfying ten bracketing-local commutations and the far relation `[s₁₃, s₂₄] = 0`
is a `DK4` family. (Pure linear algebra on commutators; the coefficients are `±1`.) -/
theorem dk4_of_locals {s12 s13 s14 s23 s24 s34 : R}
    (h0 : Commute s12 (s13 + s23))
    (h1 : Commute s12 (s14 + s24 + s34))
    (h2 : Commute (s13 + s23) (s14 + s24 + s34))
    (h3 : Commute s23 (s12 + s13))
    (h4 : Commute s23 (s14 + s24 + s34))
    (h6 : Commute s23 (s24 + s34))
    (h8 : Commute (s24 + s34) (s12 + s13 + s14))
    (h9 : Commute s34 (s23 + s24))
    (h10 : Commute s34 (s12 + s13 + s14))
    (h12 : Commute s12 s34)
    (h15 : Commute s13 s24) :
    DK4 s12 s13 s14 s23 s24 s34 := by
  have z0 : s12 * (s13 + s23) - (s13 + s23) * s12 = 0 := sub_eq_zero.mpr h0.eq
  have z1 : s12 * (s14 + s24 + s34) - (s14 + s24 + s34) * s12 = 0 := sub_eq_zero.mpr h1.eq
  have z2 : (s13 + s23) * (s14 + s24 + s34) - (s14 + s24 + s34) * (s13 + s23) = 0 := sub_eq_zero.mpr h2.eq
  have z3 : s23 * (s12 + s13) - (s12 + s13) * s23 = 0 := sub_eq_zero.mpr h3.eq
  have z4 : s23 * (s14 + s24 + s34) - (s14 + s24 + s34) * s23 = 0 := sub_eq_zero.mpr h4.eq
  have z6 : s23 * (s24 + s34) - (s24 + s34) * s23 = 0 := sub_eq_zero.mpr h6.eq
  have z8 : (s24 + s34) * (s12 + s13 + s14) - (s12 + s13 + s14) * (s24 + s34) = 0 := sub_eq_zero.mpr h8.eq
  have z9 : s34 * (s23 + s24) - (s23 + s24) * s34 = 0 := sub_eq_zero.mpr h9.eq
  have z10 : s34 * (s12 + s13 + s14) - (s12 + s13 + s14) * s34 = 0 := sub_eq_zero.mpr h10.eq
  have z12 : s12 * s34 - s34 * s12 = 0 := sub_eq_zero.mpr h12.eq
  have z15 : s13 * s24 - s24 * s13 = 0 := sub_eq_zero.mpr h15.eq
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · show s12 * s34 = s34 * s12
    rw [← sub_eq_zero, show s12 * s34 - s34 * s12 = (s12 * s34 - s34 * s12) by noncomm_ring, z12]; try simp
  · show s13 * s24 = s24 * s13
    rw [← sub_eq_zero, show s13 * s24 - s24 * s13 = (s13 * s24 - s24 * s13) by noncomm_ring, z15]; try simp
  · show s14 * s23 = s23 * s14
    rw [← sub_eq_zero, show s14 * s23 - s23 * s14 = - (s23 * (s14 + s24 + s34) - (s14 + s24 + s34) * s23) + (s23 * (s24 + s34) - (s24 + s34) * s23) by noncomm_ring, z4, z6]; try simp
  · show s12 * (s13 + s23) = (s13 + s23) * s12
    rw [← sub_eq_zero, show s12 * (s13 + s23) - (s13 + s23) * s12 = (s12 * (s13 + s23) - (s13 + s23) * s12) by noncomm_ring, z0]; try simp
  · show s13 * (s12 + s23) = (s12 + s23) * s13
    rw [← sub_eq_zero, show s13 * (s12 + s23) - (s12 + s23) * s13 = - (s12 * (s13 + s23) - (s13 + s23) * s12) - (s23 * (s12 + s13) - (s12 + s13) * s23) by noncomm_ring, z0, z3]; try simp
  · show s23 * (s12 + s13) = (s12 + s13) * s23
    rw [← sub_eq_zero, show s23 * (s12 + s13) - (s12 + s13) * s23 = (s23 * (s12 + s13) - (s12 + s13) * s23) by noncomm_ring, z3]; try simp
  · show s12 * (s14 + s24) = (s14 + s24) * s12
    rw [← sub_eq_zero, show s12 * (s14 + s24) - (s14 + s24) * s12 = (s12 * (s14 + s24 + s34) - (s14 + s24 + s34) * s12) - (s12 * s34 - s34 * s12) by noncomm_ring, z1, z12]; try simp
  · show s14 * (s12 + s24) = (s12 + s24) * s14
    rw [← sub_eq_zero, show s14 * (s12 + s24) - (s12 + s24) * s14 = - (s12 * (s14 + s24 + s34) - (s14 + s24 + s34) * s12) - ((s24 + s34) * (s12 + s13 + s14) - (s12 + s13 + s14) * (s24 + s34)) + (s34 * (s12 + s13 + s14) - (s12 + s13 + s14) * s34) + (s12 * s34 - s34 * s12) - (s13 * s24 - s24 * s13) by noncomm_ring, z1, z8, z10, z12, z15]; try simp
  · show s24 * (s12 + s14) = (s12 + s14) * s24
    rw [← sub_eq_zero, show s24 * (s12 + s14) - (s12 + s14) * s24 = ((s24 + s34) * (s12 + s13 + s14) - (s12 + s13 + s14) * (s24 + s34)) - (s34 * (s12 + s13 + s14) - (s12 + s13 + s14) * s34) + (s13 * s24 - s24 * s13) by noncomm_ring, z8, z10, z15]; try simp
  · show s13 * (s14 + s34) = (s14 + s34) * s13
    rw [← sub_eq_zero, show s13 * (s14 + s34) - (s14 + s34) * s13 = ((s13 + s23) * (s14 + s24 + s34) - (s14 + s24 + s34) * (s13 + s23)) - (s23 * (s14 + s24 + s34) - (s14 + s24 + s34) * s23) - (s13 * s24 - s24 * s13) by noncomm_ring, z2, z4, z15]; try simp
  · show s14 * (s13 + s34) = (s13 + s34) * s14
    rw [← sub_eq_zero, show s14 * (s13 + s34) - (s13 + s34) * s14 = - ((s13 + s23) * (s14 + s24 + s34) - (s14 + s24 + s34) * (s13 + s23)) + (s23 * (s14 + s24 + s34) - (s14 + s24 + s34) * s23) - (s34 * (s12 + s13 + s14) - (s12 + s13 + s14) * s34) - (s12 * s34 - s34 * s12) + (s13 * s24 - s24 * s13) by noncomm_ring, z2, z4, z10, z12, z15]; try simp
  · show s34 * (s13 + s14) = (s13 + s14) * s34
    rw [← sub_eq_zero, show s34 * (s13 + s14) - (s13 + s14) * s34 = (s34 * (s12 + s13 + s14) - (s12 + s13 + s14) * s34) + (s12 * s34 - s34 * s12) by noncomm_ring, z10, z12]; try simp
  · show s23 * (s24 + s34) = (s24 + s34) * s23
    rw [← sub_eq_zero, show s23 * (s24 + s34) - (s24 + s34) * s23 = (s23 * (s24 + s34) - (s24 + s34) * s23) by noncomm_ring, z6]; try simp
  · show s24 * (s23 + s34) = (s23 + s34) * s24
    rw [← sub_eq_zero, show s24 * (s23 + s34) - (s23 + s34) * s24 = - (s23 * (s24 + s34) - (s24 + s34) * s23) - (s34 * (s23 + s24) - (s23 + s24) * s34) by noncomm_ring, z6, z9]; try simp
  · show s34 * (s23 + s24) = (s23 + s24) * s34
    rw [← sub_eq_zero, show s34 * (s23 + s24) - (s23 + s24) * s34 = (s34 * (s23 + s24) - (s23 + s24) * s34) by noncomm_ring, z9]; try simp

/-- The bracketing-local commutations of a `DK4` family. -/
theorem locals_of_dk4 {t12 t13 t14 t23 t24 t34 : R} (h : DK4 t12 t13 t14 t23 t24 t34) :
    Commute t12 (t13 + t23) ∧
    Commute t12 (t14 + t24 + t34) ∧
    Commute (t13 + t23) (t14 + t24 + t34) ∧
    Commute t23 (t12 + t13) ∧
    Commute t23 (t14 + t24 + t34) ∧
    Commute t23 (t24 + t34) ∧
    Commute (t24 + t34) (t12 + t13 + t14) ∧
    Commute t34 (t23 + t24) ∧
    Commute t34 (t12 + t13 + t14) ∧
    Commute t12 t34 := by
  have z0 : t12 * t34 - t34 * t12 = 0 := sub_eq_zero.mpr h.f12_34.eq
  have z1 : t13 * t24 - t24 * t13 = 0 := sub_eq_zero.mpr h.f13_24.eq
  have z2 : t14 * t23 - t23 * t14 = 0 := sub_eq_zero.mpr h.f14_23.eq
  have z3 : t12 * (t13 + t23) - (t13 + t23) * t12 = 0 := sub_eq_zero.mpr h.n12_3.eq
  have z4 : t13 * (t12 + t23) - (t12 + t23) * t13 = 0 := sub_eq_zero.mpr h.n13_2.eq
  have z5 : t23 * (t12 + t13) - (t12 + t13) * t23 = 0 := sub_eq_zero.mpr h.n23_1.eq
  have z6 : t12 * (t14 + t24) - (t14 + t24) * t12 = 0 := sub_eq_zero.mpr h.n12_4.eq
  have z7 : t14 * (t12 + t24) - (t12 + t24) * t14 = 0 := sub_eq_zero.mpr h.n14_2.eq
  have z8 : t24 * (t12 + t14) - (t12 + t14) * t24 = 0 := sub_eq_zero.mpr h.n24_1.eq
  have z9 : t13 * (t14 + t34) - (t14 + t34) * t13 = 0 := sub_eq_zero.mpr h.n13_4.eq
  have z10 : t14 * (t13 + t34) - (t13 + t34) * t14 = 0 := sub_eq_zero.mpr h.n14_3.eq
  have z11 : t34 * (t13 + t14) - (t13 + t14) * t34 = 0 := sub_eq_zero.mpr h.n34_1.eq
  have z12 : t23 * (t24 + t34) - (t24 + t34) * t23 = 0 := sub_eq_zero.mpr h.n23_4.eq
  have z13 : t24 * (t23 + t34) - (t23 + t34) * t24 = 0 := sub_eq_zero.mpr h.n24_3.eq
  have z14 : t34 * (t23 + t24) - (t23 + t24) * t34 = 0 := sub_eq_zero.mpr h.n34_2.eq
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · show t12 * (t13 + t23) = (t13 + t23) * t12
    rw [← sub_eq_zero, show t12 * (t13 + t23) - (t13 + t23) * t12 = (t12 * (t13 + t23) - (t13 + t23) * t12) by noncomm_ring, z3]; try simp
  · show t12 * (t14 + t24 + t34) = (t14 + t24 + t34) * t12
    rw [← sub_eq_zero, show t12 * (t14 + t24 + t34) - (t14 + t24 + t34) * t12 = (t12 * t34 - t34 * t12) + (t12 * (t14 + t24) - (t14 + t24) * t12) by noncomm_ring, z0, z6]; try simp
  · show (t13 + t23) * (t14 + t24 + t34) = (t14 + t24 + t34) * (t13 + t23)
    rw [← sub_eq_zero, show (t13 + t23) * (t14 + t24 + t34) - (t14 + t24 + t34) * (t13 + t23) = (t13 * t24 - t24 * t13) - (t14 * t23 - t23 * t14) + (t13 * (t14 + t34) - (t14 + t34) * t13) + (t23 * (t24 + t34) - (t24 + t34) * t23) by noncomm_ring, z1, z2, z9, z12]; try simp
  · show t23 * (t12 + t13) = (t12 + t13) * t23
    rw [← sub_eq_zero, show t23 * (t12 + t13) - (t12 + t13) * t23 = - (t12 * (t13 + t23) - (t13 + t23) * t12) - (t13 * (t12 + t23) - (t12 + t23) * t13) by noncomm_ring, z3, z4]; try simp
  · show t23 * (t14 + t24 + t34) = (t14 + t24 + t34) * t23
    rw [← sub_eq_zero, show t23 * (t14 + t24 + t34) - (t14 + t24 + t34) * t23 = - (t14 * t23 - t23 * t14) + (t23 * (t24 + t34) - (t24 + t34) * t23) by noncomm_ring, z2, z12]; try simp
  · show t23 * (t24 + t34) = (t24 + t34) * t23
    rw [← sub_eq_zero, show t23 * (t24 + t34) - (t24 + t34) * t23 = (t23 * (t24 + t34) - (t24 + t34) * t23) by noncomm_ring, z12]; try simp
  · show (t24 + t34) * (t12 + t13 + t14) = (t12 + t13 + t14) * (t24 + t34)
    rw [← sub_eq_zero, show (t24 + t34) * (t12 + t13 + t14) - (t12 + t13 + t14) * (t24 + t34) = - (t12 * t34 - t34 * t12) - (t13 * t24 - t24 * t13) - (t12 * (t14 + t24) - (t14 + t24) * t12) - (t14 * (t12 + t24) - (t12 + t24) * t14) - (t13 * (t14 + t34) - (t14 + t34) * t13) - (t14 * (t13 + t34) - (t13 + t34) * t14) by noncomm_ring, z0, z1, z6, z7, z9, z10]; try simp
  · show t34 * (t23 + t24) = (t23 + t24) * t34
    rw [← sub_eq_zero, show t34 * (t23 + t24) - (t23 + t24) * t34 = - (t23 * (t24 + t34) - (t24 + t34) * t23) - (t24 * (t23 + t34) - (t23 + t34) * t24) by noncomm_ring, z12, z13]; try simp
  · show t34 * (t12 + t13 + t14) = (t12 + t13 + t14) * t34
    rw [← sub_eq_zero, show t34 * (t12 + t13 + t14) - (t12 + t13 + t14) * t34 = - (t12 * t34 - t34 * t12) - (t13 * (t14 + t34) - (t14 + t34) * t13) - (t14 * (t13 + t34) - (t13 + t34) * t14) by noncomm_ring, z0, z9, z10]; try simp
  · show t12 * t34 = t34 * t12
    rw [← sub_eq_zero, show t12 * t34 - t34 * t12 = (t12 * t34 - t34 * t12) by noncomm_ring, z0]; try simp

/-- In a `DK4` family each generator commutes with the total `c₄ = Σ tᵢⱼ`. -/
theorem commute_total {t12 t13 t14 t23 t24 t34 : R} (h : DK4 t12 t13 t14 t23 t24 t34) :
    Commute t12 (t12 + t13 + t14 + t23 + t24 + t34) ∧
    Commute t13 (t12 + t13 + t14 + t23 + t24 + t34) ∧
    Commute t14 (t12 + t13 + t14 + t23 + t24 + t34) ∧
    Commute t23 (t12 + t13 + t14 + t23 + t24 + t34) ∧
    Commute t24 (t12 + t13 + t14 + t23 + t24 + t34) ∧
    Commute t34 (t12 + t13 + t14 + t23 + t24 + t34) := by
  have z0 : t12 * t34 - t34 * t12 = 0 := sub_eq_zero.mpr h.f12_34.eq
  have z1 : t13 * t24 - t24 * t13 = 0 := sub_eq_zero.mpr h.f13_24.eq
  have z2 : t14 * t23 - t23 * t14 = 0 := sub_eq_zero.mpr h.f14_23.eq
  have z3 : t12 * (t13 + t23) - (t13 + t23) * t12 = 0 := sub_eq_zero.mpr h.n12_3.eq
  have z4 : t13 * (t12 + t23) - (t12 + t23) * t13 = 0 := sub_eq_zero.mpr h.n13_2.eq
  have z5 : t23 * (t12 + t13) - (t12 + t13) * t23 = 0 := sub_eq_zero.mpr h.n23_1.eq
  have z6 : t12 * (t14 + t24) - (t14 + t24) * t12 = 0 := sub_eq_zero.mpr h.n12_4.eq
  have z7 : t14 * (t12 + t24) - (t12 + t24) * t14 = 0 := sub_eq_zero.mpr h.n14_2.eq
  have z8 : t24 * (t12 + t14) - (t12 + t14) * t24 = 0 := sub_eq_zero.mpr h.n24_1.eq
  have z9 : t13 * (t14 + t34) - (t14 + t34) * t13 = 0 := sub_eq_zero.mpr h.n13_4.eq
  have z10 : t14 * (t13 + t34) - (t13 + t34) * t14 = 0 := sub_eq_zero.mpr h.n14_3.eq
  have z11 : t34 * (t13 + t14) - (t13 + t14) * t34 = 0 := sub_eq_zero.mpr h.n34_1.eq
  have z12 : t23 * (t24 + t34) - (t24 + t34) * t23 = 0 := sub_eq_zero.mpr h.n23_4.eq
  have z13 : t24 * (t23 + t34) - (t23 + t34) * t24 = 0 := sub_eq_zero.mpr h.n24_3.eq
  have z14 : t34 * (t23 + t24) - (t23 + t24) * t34 = 0 := sub_eq_zero.mpr h.n34_2.eq
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · show t12 * (t12 + t13 + t14 + t23 + t24 + t34) = (t12 + t13 + t14 + t23 + t24 + t34) * t12
    rw [← sub_eq_zero, show t12 * (t12 + t13 + t14 + t23 + t24 + t34) - (t12 + t13 + t14 + t23 + t24 + t34) * t12 = (t12 * t34 - t34 * t12) + (t12 * (t13 + t23) - (t13 + t23) * t12) + (t12 * (t14 + t24) - (t14 + t24) * t12) by noncomm_ring, z0, z3, z6]; try simp
  · show t13 * (t12 + t13 + t14 + t23 + t24 + t34) = (t12 + t13 + t14 + t23 + t24 + t34) * t13
    rw [← sub_eq_zero, show t13 * (t12 + t13 + t14 + t23 + t24 + t34) - (t12 + t13 + t14 + t23 + t24 + t34) * t13 = (t13 * t24 - t24 * t13) + (t13 * (t12 + t23) - (t12 + t23) * t13) + (t13 * (t14 + t34) - (t14 + t34) * t13) by noncomm_ring, z1, z4, z9]; try simp
  · show t14 * (t12 + t13 + t14 + t23 + t24 + t34) = (t12 + t13 + t14 + t23 + t24 + t34) * t14
    rw [← sub_eq_zero, show t14 * (t12 + t13 + t14 + t23 + t24 + t34) - (t12 + t13 + t14 + t23 + t24 + t34) * t14 = (t14 * t23 - t23 * t14) + (t14 * (t12 + t24) - (t12 + t24) * t14) + (t14 * (t13 + t34) - (t13 + t34) * t14) by noncomm_ring, z2, z7, z10]; try simp
  · show t23 * (t12 + t13 + t14 + t23 + t24 + t34) = (t12 + t13 + t14 + t23 + t24 + t34) * t23
    rw [← sub_eq_zero, show t23 * (t12 + t13 + t14 + t23 + t24 + t34) - (t12 + t13 + t14 + t23 + t24 + t34) * t23 = - (t14 * t23 - t23 * t14) - (t12 * (t13 + t23) - (t13 + t23) * t12) - (t13 * (t12 + t23) - (t12 + t23) * t13) + (t23 * (t24 + t34) - (t24 + t34) * t23) by noncomm_ring, z2, z3, z4, z12]; try simp
  · show t24 * (t12 + t13 + t14 + t23 + t24 + t34) = (t12 + t13 + t14 + t23 + t24 + t34) * t24
    rw [← sub_eq_zero, show t24 * (t12 + t13 + t14 + t23 + t24 + t34) - (t12 + t13 + t14 + t23 + t24 + t34) * t24 = - (t13 * t24 - t24 * t13) - (t12 * (t14 + t24) - (t14 + t24) * t12) - (t14 * (t12 + t24) - (t12 + t24) * t14) + (t24 * (t23 + t34) - (t23 + t34) * t24) by noncomm_ring, z1, z6, z7, z13]; try simp
  · show t34 * (t12 + t13 + t14 + t23 + t24 + t34) = (t12 + t13 + t14 + t23 + t24 + t34) * t34
    rw [← sub_eq_zero, show t34 * (t12 + t13 + t14 + t23 + t24 + t34) - (t12 + t13 + t14 + t23 + t24 + t34) * t34 = - (t12 * t34 - t34 * t12) - (t13 * (t14 + t34) - (t14 + t34) * t13) - (t14 * (t13 + t34) - (t13 + t34) * t14) - (t23 * (t24 + t34) - (t24 + t34) * t23) - (t24 * (t23 + t34) - (t23 + t34) * t24) by noncomm_ring, z0, z9, z10, z12, z13]; try simp

end Locals

section Transport

variable {R : Type*} [Ring R] [Algebra ℚ R]

/-- The fourth-strand member of the transported family, `s₁₄ = (t₁₄ + t₂₄ + t₃₄) − s₂₄ − s₃₄`:
the outer local `t₁₄ + t₂₄ + t₃₄` of `((12)3)4` is not moved. -/
noncomputable def transported14 (t14 t24 t34 : R) (s : R × R × R × R × R) : R :=
  t14 + t24 + t34 - s.2.2.2.1 - s.2.2.2.2

/-- **The transported family is a `DK4` family, given the far relation.** Under the hypotheses of
`pentagon_act` on `g`, the transported family `(s₁₂, s₁₃, s₁₄, s₂₃, s₂₄, s₃₄)` is a `DK4` family
as soon as `[s₁₃, s₂₄] = 0` (`hfar`). The other ten relations needed are proved, each as the
conjugate of a commutation between local operators of one bracketing of four strands. -/
theorem transported_dk4 (g : FreeAlgebra ℚ (Fin 2)) {t12 t13 t14 t23 t24 t34 : R}
    (hDK : DK4 t12 t13 t14 t23 t24 t34) (Ga Gb Gc Gd Ge : Rˣ)
    (ha : (Ga : R) = eval t12 t23 g) (hb : (Gb : R) = eval (t13 + t23) t34 g)
    (hc : (Gc : R) = eval t12 (t23 + t24) g) (hd : (Gd : R) = eval (t12 + t13) (t24 + t34) g)
    (he : (Ge : R) = eval t23 t34 g)
    (hg : Pentagon g t12 t13 t23 t24 t34)
    (hfar : let s := transported t12 t13 t23 t24 t34 Ga Gb Gc
      Commute s.2.1 s.2.2.2.1) :
    let s := transported t12 t13 t23 t24 t34 Ga Gb Gc
    DK4 s.1 s.2.1 (transported14 t14 t24 t34 s) s.2.2.1 s.2.2.2.1 s.2.2.2.2 := by
  have d0 := transported_d0 g hDK Ga Gb Gc Gd Ge ha hb hc hd he hg
  simp only [transported, transported14] at hfar d0 ⊢
  obtain ⟨l0, l1, l2, l3, l4, l6, l8, l9, l10, l12⟩ := locals_of_dk4 hDK
  obtain ⟨c12, c13, c14, c23, c24, c34⟩ := commute_total hDK
  set c4 := t12 + t13 + t14 + t23 + t24 + t34 with hc4
  set s23 := (↑Ga⁻¹ : R) * t23 * Ga with hs23
  set s34 := (↑Gb⁻¹ : R) * t34 * Gb with hs34
  set w := (↑(Gc * Gb)⁻¹ : R) * (t23 + t24) * ↑(Gc * Gb) with hw
  -- every `G` and its inverse commutes with the total `c₄`
  have cG : ∀ (G : Rˣ) (a b : R), (G : R) = eval a b g → Commute a c4 → Commute b c4 →
      Commute (G : R) c4 ∧ Commute (↑G⁻¹ : R) c4 := fun G a b h h1 h2 =>
    ⟨h ▸ commute_eval h1 h2 g, (h ▸ commute_eval h1 h2 g).units_inv_left⟩
  obtain ⟨ca, ca'⟩ := cG Ga _ _ ha c12 c23
  obtain ⟨cb, cb'⟩ := cG Gb _ _ hb (c13.add_left c23) c34
  obtain ⟨cc, cc'⟩ := cG Gc _ _ hc c12 (c23.add_left c24)
  have cs23 : Commute s23 c4 := (ca'.mul_left c23).mul_left ca
  have cs34 : Commute s34 c4 := (cb'.mul_left c34).mul_left cb
  have cw : Commute w c4 := by
    have : Commute (↑(Gc * Gb)⁻¹ : R) c4 := by
      simp only [mul_inv_rev, Units.val_mul]; exact cb'.mul_left cc'
    have h2 : Commute (↑(Gc * Gb) : R) c4 := by
      simp only [Units.val_mul]; exact cc.mul_left cb
    exact (this.mul_left (c23.add_left c24)).mul_left h2
  -- commutations of `G`s with locals
  have cb12 : Commute (Gb : R) t12 := hb ▸ commute_eval hDK.n12_3.symm hDK.f12_34.symm g
  have cad : Commute (Ga : R) (t14 + t24 + t34) := ha ▸ commute_eval l1 l4 g
  have ca3 : Commute (Ga : R) (t12 + t13 + t23) := by
    rw [ha]
    refine commute_eval ?_ ?_ g
    · rw [show t12 + t13 + t23 = t12 + (t13 + t23) by abel]
      exact (Commute.refl t12).add_right hDK.n12_3
    · rw [show t12 + t13 + t23 = (t12 + t13) + t23 by abel]
      exact hDK.n23_1.add_right (Commute.refl t23)
  have a1 : (↑Ga⁻¹ : R) * (t12 + t13) * Ga = t12 + (t13 + t23 - s23) := by
    have : (↑Ga⁻¹ : R) * (t12 + t13) * Ga =
        (↑Ga⁻¹ : R) * (t12 + t13 + t23) * Ga - (↑Ga⁻¹ : R) * t23 * Ga := by noncomm_ring
    rw [this, conj_of_commute ca3]; abel
  have Ed : t14 + t24 + t34 - (w - s23) - s34 + (w - s23) + s34 = t14 + t24 + t34 := by abel
  have E123 : t12 + (t13 + t23 - s23) + (t14 + t24 + t34 - (w - s23) - s34) =
      c4 - s23 - (w - s23 + s34) := by rw [hc4]; abel
  apply dk4_of_locals
  · rw [show t13 + t23 - s23 + s23 = t13 + t23 by abel]; exact l0
  · rw [Ed]; exact l1
  · rw [show t13 + t23 - s23 + s23 = t13 + t23 by abel, Ed]; exact l2
  · rw [← a1]; exact Commute.unitsConj Ga l3
  · rw [Ed]; have := Commute.unitsConj Ga l4; rwa [conj_of_commute cad] at this
  · exact d0.n12_3
  · rw [E123]
    have hx : Commute (w - s23 + s34) c4 := (cw.sub_left cs23).add_left cs34
    exact (hx.sub_right d0.n12_3.symm).sub_right (Commute.refl _)
  · exact d0.n23_1
  · rw [E123]
    rw [show c4 - s23 - (w - s23 + s34) = c4 - (s23 + (w - s23)) - s34 by abel]
    exact (cs34.sub_right d0.n23_1).sub_right (Commute.refl _)
  · have := Commute.unitsConj Gb l12; rwa [conj_of_commute cb12] at this
  · exact hfar

end Transport

section Universal

/-- Evaluation commutes with algebra maps. -/
theorem map_eval {A B : Type*} [Ring A] [Algebra ℚ A] [Ring B] [Algebra ℚ B] (f : A →ₐ[ℚ] B)
    (a b : A) (p : FreeAlgebra ℚ (Fin 2)) : f (eval a b p) = eval (f a) (f b) p := by
  have : f.comp (eval a b) = eval (f a) (f b) := by
    apply FreeAlgebra.hom_ext
    funext i
    fin_cases i <;> simp [eval]
  exact congrArg (fun h : FreeAlgebra ℚ (Fin 2) →ₐ[ℚ] B => h p) this

variable {N : ℕ}

/-- The degree filtration of `U4 N`: the span of the words of length at least `k`. -/
def Fil (N k : ℕ) : Submodule ℚ (U4 N) :=
  Submodule.span ℚ {x | ∃ w : List (Fin 6), k ≤ w.length ∧ x = (w.map (t N)).prod}

theorem word_mem_Fil {k : ℕ} (w : List (Fin 6)) (hw : k ≤ w.length) :
    (w.map (t N)).prod ∈ Fil N k :=
  Submodule.subset_span ⟨w, hw, rfl⟩

theorem mul_mem_Fil {a b : ℕ} {x y : U4 N} (hx : x ∈ Fil N a) (hy : y ∈ Fil N b) :
    x * y ∈ Fil N (a + b) := by
  have h := Submodule.mul_mem_mul hx hy
  rw [Fil, Fil, Submodule.span_mul_span] at h
  refine Submodule.span_le.mpr ?_ h
  rintro _ ⟨u, ⟨w1, h1, rfl⟩, v, ⟨w2, h2, rfl⟩, rfl⟩
  refine Submodule.subset_span ⟨w1 ++ w2, by simp; omega, ?_⟩
  simp [List.map_append, List.prod_append]

/-- Every element of `U4 N` lies in `Fil N 0`. -/
theorem mem_Fil_zero (x : U4 N) : x ∈ Fil N 0 := by
  obtain ⟨f, rfl⟩ := RingQuot.mkAlgHom_surjective ℚ (Rel4 N) x
  induction f using FreeAlgebra.induction with
  | grade0 r =>
    rw [AlgHom.commutes, Algebra.algebraMap_eq_smul_one]
    exact Submodule.smul_mem _ r (by simpa using word_mem_Fil (N := N) [] le_rfl)
  | grade1 i => simpa [t] using word_mem_Fil (N := N) (k := 0) [i] (by simp)
  | mul a b ha hb => simpa [map_mul] using mul_mem_Fil ha hb
  | add a b ha hb => simpa [map_add] using add_mem ha hb

/-- `Fil N N = 0`: a word of length at least `N` vanishes. -/
theorem eq_zero_of_mem_Fil {x : U4 N} (hx : x ∈ Fil N N) : x = 0 := by
  have : Fil N N = ⊥ := by
    rw [Fil, Submodule.span_eq_bot]
    rintro _ ⟨w, hw, rfl⟩
    rw [← List.take_append_drop N w, List.map_append, List.prod_append,
      word_eq_zero N (w.take N) (by simp; omega), zero_mul]
  rw [this] at hx
  exact (Submodule.mem_bot ℚ).mp hx

theorem t_mem_Fil_one (i : Fin 6) : t N i ∈ Fil N 1 := by
  simpa using word_mem_Fil (N := N) [i] (by simp)

theorem conj_mem_Fil_one (u : (U4 N)ˣ) {x : U4 N} (hx : x ∈ Fil N 1) :
    (↑u⁻¹ : U4 N) * x * u ∈ Fil N 1 := by
  simpa using mul_mem_Fil (mul_mem_Fil (mem_Fil_zero (↑u⁻¹ : U4 N)) hx) (mem_Fil_zero (u : U4 N))

/-- A word of length `N` in elements of `Fil N 1` vanishes. -/
theorem word_eq_zero_of_Fil_one (s : Fin 6 → U4 N) (hs : ∀ i, s i ∈ Fil N 1)
    (w : List (Fin 6)) (hw : w.length = N) : (w.map s).prod = 0 := by
  apply eq_zero_of_mem_Fil
  have : ∀ w : List (Fin 6), (w.map s).prod ∈ Fil N w.length := by
    intro w
    induction w with
    | nil => simpa using mem_Fil_zero (1 : U4 N)
    | cons i w ih =>
      simpa [Nat.add_comm] using mul_mem_Fil (hs i) ih
  simpa [hw] using this w

/-- **The `GRT` action preserves the pentagon in the universal truncated algebra, modulo the far
relation.** In `U4 N`, let `g` satisfy the pentagon, and let its five coface evaluations be units.
If `φ` satisfies the pentagon and the transported family satisfies `[s₁₃, s₂₄] = 0` (`hfar`), then
`φ̃(A, B) = φ(g A g⁻¹, B) · g` satisfies the pentagon. -/
theorem pentagon_act_universal (φ g : FreeAlgebra ℚ (Fin 2)) (Ga Gb Gc Gd Ge : (U4 N)ˣ)
    (ha : (Ga : U4 N) = eval (t N 0) (t N 3) g)
    (hb : (Gb : U4 N) = eval (t N 1 + t N 3) (t N 5) g)
    (hc : (Gc : U4 N) = eval (t N 0) (t N 3 + t N 4) g)
    (hd : (Gd : U4 N) = eval (t N 0 + t N 1) (t N 4 + t N 5) g)
    (he : (Ge : U4 N) = eval (t N 3) (t N 5) g)
    (hg : Pentagon g (t N 0) (t N 1) (t N 3) (t N 4) (t N 5))
    (hφ : Pentagon φ (t N 0) (t N 1) (t N 3) (t N 4) (t N 5))
    (hfar : let s := transported (t N 0) (t N 1) (t N 3) (t N 4) (t N 5) Ga Gb Gc
      Commute s.2.1 s.2.2.2.1) :
    actEval φ (t N 0) (t N 3 + t N 4) Gc * actEval φ (t N 1 + t N 3) (t N 5) Gb =
      actEval φ (t N 3) (t N 5) Ge * actEval φ (t N 0 + t N 1) (t N 4 + t N 5) Gd *
        actEval φ (t N 0) (t N 3) Ga := by
  have hDK := dk4 N
  refine pentagon_act φ g hDK Ga Gb Gc Gd Ge ha hb hc hd he hg ?_
  intro s
  have hs := transported_dk4 g hDK Ga Gb Gc Gd Ge ha hb hc hd he hg hfar
  set sf : Fin 6 → U4 N := ![s.1, s.2.1, transported14 (t N 2) (t N 4) (t N 5) s, s.2.2.1,
    s.2.2.2.1, s.2.2.2.2] with hsf
  have hdk : DK4 (sf 0) (sf 1) (sf 2) (sf 3) (sf 4) (sf 5) := hs
  have hmem : ∀ i, sf i ∈ Fil N 1 := by
    have T := t_mem_Fil_one (N := N)
    have c := conj_mem_Fil_one (N := N)
    intro i
    fin_cases i <;>
      simp only [hsf, s, transported, transported14, Fin.zero_eta, Fin.mk_one, Fin.reduceFinMk,
        Matrix.cons_val, Matrix.cons_val_zero, Matrix.cons_val_one] <;>
      first
      | exact T 0
      | exact sub_mem (add_mem (T 1) (T 3)) (c _ (T 3))
      | exact c _ (T 3)
      | exact c _ (T 5)
      | exact sub_mem (c _ (add_mem (T 3) (T 4))) (c _ (T 3))
      | exact sub_mem (sub_mem (add_mem (add_mem (T 2) (T 4)) (T 5))
          (sub_mem (c _ (add_mem (T 3) (T 4))) (c _ (T 3)))) (c _ (T 5))
  have hw := word_eq_zero_of_Fil_one sf hmem
  have key := congrArg (lift N sf hdk hw) hφ
  simp only [map_mul, map_eval, map_add, lift_t] at key
  exact key

end Universal

