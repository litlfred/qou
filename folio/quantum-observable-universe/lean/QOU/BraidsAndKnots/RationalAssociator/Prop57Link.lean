import Mathlib.Algebra.Lie.OfAssociative
import Mathlib.Algebra.Lie.Subalgebra
import QOU.BraidsAndKnots.RationalAssociator.Prop57Cocycle

/-!
# Drinfeld Prop. 5.7: the link from `u = 0` to (5.19)

Bean `qou-3fdg` (epic `qou-dk7p`), gap (B2), audit §16a.

`Prop57Cocycle` proves `u = 0` in `U4 N` from the linearised (5.17), (5.18), (5.20), and
`Prop57` proves that a symmetric `LieLike` polynomial whose cocycle (5.24) lies in `FF3 N` lies
in `FF N`. This file joins them, for a **Lie element** `y`:

* `IsLieElt y`: `y` lies in the Lie subalgebra of `ℚ⟨X, Y⟩` (bracket `pq − qp`) generated by
  `X` and `Y`. This is the only place a Lie hypothesis enters.
* `shift_left`, `shift_right` (**central shift**): if `z` commutes with `a` and `b` then
  `y(a + z, b) = y(a, b) + α z` and `y(a, b + z) = y(a, b) + β z` for some `α, β ∈ ℚ`.
* `S_eq_eval_sPoly`: at a `DK3` triple `(A, B, C)`,
  `[B, y(A, B)] + [C, y(A, C)] = s(B, C)`, with `s = sPoly y`. So `u = cocycle(s)(t₁₄, t₂₄, t₃₄)`.
* `retract`: an algebra map `U4 N → End(ℚ⟨Y₁, Y₂, Y₃⟩ ⧸ FF3 N)`, with `t_{i4}` acting by left
  multiplication by `Yᵢ` and `t₁₂, t₁₃, t₂₃` by Leibniz maps. Evaluated at `1` it turns
  `cocycle(s)(t₁₄, t₂₄, t₃₄) = 0` into `cocycle(s) ∈ FF3 N`.
* `lin514_of_lie`: for a Lie `y` with the `lin512`, `lin513`, `lin515` conditions of `GrtU4`, the
  `lin514` condition holds at every `DK3` triple of `Fil N 1`; `grtU4_of_lie` assembles
  `GrtU4 N y` from the other three conditions.

Everything is algebraic: free algebras, quotients, and finite identities checked by
`noncomm_ring`.
-/

namespace QOU.BraidsAndKnots.RationalAssociator

local notation "F2" => FreeAlgebra ℚ (Fin 2)
local notation "F3" => FreeAlgebra ℚ (Fin 3)

/-! ### Lie elements and the central shift -/

section CentralShift

/-- `y` is a **Lie element** of `ℚ⟨X, Y⟩`: it lies in the Lie subalgebra (bracket
`⁅p, q⁆ = p q − q p`) generated by `X = ι 0` and `Y = ι 1`. -/
def IsLieElt (y : F2) : Prop :=
  y ∈ LieSubalgebra.lieSpan ℚ F2 {FreeAlgebra.ι ℚ 0, FreeAlgebra.ι ℚ 1}

variable {R : Type*} [Ring R] [Algebra ℚ R]

theorem bracket_add_commuting {P Q E F : R} (h1 : Commute E Q) (h2 : Commute F P)
    (h3 : Commute E F) : (P + E) * (Q + F) - (Q + F) * (P + E) = P * Q - Q * P := by
  simp only [add_mul, mul_add]
  rw [h1.eq, h2.eq, h3.eq]
  abel

/-- **The central shift.** For a Lie element `y`, shifting the arguments by elements `z, w`
that commute with both arguments and with each other changes `y(a, b)` by a fixed linear
combination of `z` and `w`. -/
theorem central_shift {y : F2} (hy : IsLieElt y) {a b z w : R} (hza : Commute z a)
    (hzb : Commute z b) (hwa : Commute w a) (hwb : Commute w b) (hzw : Commute z w) :
    ∃ α β : ℚ, eval (a + z) (b + w) y = eval a b y + α • z + β • w := by
  unfold IsLieElt at hy
  induction hy using LieSubalgebra.lieSpan_induction with
  | mem x hx =>
    rcases hx with rfl | rfl
    · exact ⟨1, 0, by simp⟩
    · exact ⟨0, 1, by simp⟩
  | zero => exact ⟨0, 0, by simp⟩
  | add x x' _ _ hx hx' =>
    obtain ⟨α, β, h⟩ := hx
    obtain ⟨α', β', h'⟩ := hx'
    exact ⟨α + α', β + β', by rw [map_add, map_add, h, h', add_smul, add_smul]; abel⟩
  | smul r x _ hx =>
    obtain ⟨α, β, h⟩ := hx
    exact ⟨r * α, r * β, by rw [map_smul, map_smul, h, smul_add, smul_add, smul_smul, smul_smul]⟩
  | lie x x' _ _ hx hx' =>
    obtain ⟨α, β, h⟩ := hx
    obtain ⟨α', β', h'⟩ := hx'
    refine ⟨0, 0, ?_⟩
    have cz : ∀ p : F2, Commute z (eval a b p) := fun p => (commute_eval hza.symm hzb.symm p).symm
    have cw : ∀ p : F2, Commute w (eval a b p) := fun p => (commute_eval hwa.symm hwb.symm p).symm
    have cE : ∀ (s t : ℚ) (p : F2), Commute (s • z + t • w) (eval a b p) := fun s t p =>
      ((cz p).smul_left s).add_left ((cw p).smul_left t)
    have cEF : ∀ s t s' t' : ℚ, Commute (s • z + t • w) (s' • z + t' • w) := by
      intro s t s' t'
      refine Commute.add_left ?_ ?_
      · exact ((Commute.refl z).smul_left s |>.smul_right s').add_right ((hzw.smul_left s).smul_right t')
      · exact ((hzw.symm.smul_left t).smul_right s').add_right ((Commute.refl w).smul_left t |>.smul_right t')
    rw [Ring.lie_def, map_sub, map_sub, map_mul, map_mul, map_mul, map_mul, h, h', add_assoc,
      add_assoc, bracket_add_commuting (cE α β x') (cE α' β' x) (cEF α β α' β')]
    simp

theorem shift_left {y : F2} (hy : IsLieElt y) {a b z : R} (hza : Commute z a)
    (hzb : Commute z b) : ∃ α : ℚ, eval (a + z) b y = eval a b y + α • z := by
  obtain ⟨α, β, h⟩ := central_shift (w := 0) hy hza hzb (Commute.zero_left a)
    (Commute.zero_left b) (Commute.zero_right z)
  exact ⟨α, by simpa using h⟩

theorem shift_right {y : F2} (hy : IsLieElt y) {a b z : R} (hza : Commute z a)
    (hzb : Commute z b) : ∃ β : ℚ, eval a (b + z) y = eval a b y + β • z := by
  obtain ⟨α, β, h⟩ := central_shift (z := 0) hy (Commute.zero_left a)
    (Commute.zero_left b) hza hzb (Commute.zero_left z)
  exact ⟨β, by simpa using h⟩

/-- A Lie element has no constant term. -/
theorem IsLieElt.const {y : F2} (hy : IsLieElt y) : FreeAlgebra.algebraMapInv y = 0 := by
  unfold IsLieElt at hy
  induction hy using LieSubalgebra.lieSpan_induction with
  | mem x hx => rcases hx with rfl | rfl <;> simp [FreeAlgebra.algebraMapInv]
  | zero => simp
  | add x x' _ _ hx hx' => rw [map_add, hx, hx', add_zero]
  | smul r x _ hx => rw [map_smul, hx, smul_zero]
  | lie x x' _ _ hx hx' => rw [Ring.lie_def, map_sub, map_mul, map_mul, hx, hx']; simp

/-- At a `DK3` triple, `z = A + B + C` commutes with each member. -/
theorem DK3.commute_sum {A B C : R} (h : DK3 A B C) :
    Commute (A + B + C) A ∧ Commute (A + B + C) B ∧ Commute (A + B + C) C := by
  refine ⟨?_, ?_, ?_⟩
  · rw [add_assoc]; exact (Commute.refl A).add_left h.n12_3.symm
  · rw [show A + B + C = B + (A + C) by abel]; exact (Commute.refl B).add_left h.n13_2.symm
  · exact h.n23_1.symm.add_left (Commute.refl C)

/-- **Drinfeld's `S` is `s` at a `DK3` triple.** For a Lie element `y` and a `DK3` triple
`(A, B, C)`, `[B, y(A, B)] + [C, y(A, C)] = s(B, C)`, where `s = sPoly y` uses `−B − C` in
place of `A`. -/
theorem S_eq_eval_sPoly {y : F2} (hy : IsLieElt y) {A B C : R} (h : DK3 A B C) :
    (B * eval A B y - eval A B y * B) + (C * eval A C y - eval A C y * C) =
      eval B C (sPoly y) := by
  obtain ⟨-, hzB, hzC⟩ := h.commute_sum
  have hzN : Commute (A + B + C) (-(B + C)) := (hzB.add_right hzC).neg_right
  have e : -(B + C) + (A + B + C) = A := by abel
  obtain ⟨α, h1⟩ := shift_left hy hzN hzB
  obtain ⟨β, h2⟩ := shift_left hy hzN hzC
  rw [e] at h1 h2
  simp only [sPoly, map_add, map_sub, map_mul, map_neg, map_eval, eval_X, eval_Y]
  rw [h1, h2, mul_add, add_mul, mul_add, add_mul, ((hzB.smul_left α).eq : _ = B * _),
    ((hzC.smul_left β).eq : _ = C * _)]
  abel

end CentralShift

/-! ### The word filtration of `ℚ⟨Y₁, Y₂, Y₃⟩` -/

section FF3Lemmas

/-- The generators of `ℚ⟨Y₁, Y₂, Y₃⟩`. -/
noncomputable abbrev Yg (i : Fin 3) : F3 := FreeAlgebra.ι ℚ i

theorem word_mem_FF3 {m : ℕ} (w : List (Fin 3)) (hw : m ≤ w.length) :
    (w.map (FreeAlgebra.ι ℚ)).prod ∈ FF3 m :=
  Submodule.subset_span ⟨w, hw, rfl⟩

theorem FF3_anti {m n : ℕ} (h : m ≤ n) : FF3 n ≤ FF3 m :=
  Submodule.span_mono fun _ ⟨w, hw, e⟩ => ⟨w, le_trans h hw, e⟩

theorem mul_mem_FF3 {a b : ℕ} {p q : F3} (hp : p ∈ FF3 a) (hq : q ∈ FF3 b) :
    p * q ∈ FF3 (a + b) := by
  have h := Submodule.mul_mem_mul hp hq
  rw [FF3, FF3, Submodule.span_mul_span] at h
  refine Submodule.span_le.mpr ?_ h
  rintro _ ⟨u, ⟨w1, h1, rfl⟩, v, ⟨w2, h2, rfl⟩, rfl⟩
  refine Submodule.subset_span ⟨w1 ++ w2, by simp; omega, ?_⟩
  simp [List.map_append, List.prod_append]

theorem mul_mem_FF3' {a b c : ℕ} (h : a + b = c) {p q : F3} (hp : p ∈ FF3 a)
    (hq : q ∈ FF3 b) : p * q ∈ FF3 c := h ▸ mul_mem_FF3 hp hq

theorem mem_FF3_zero (p : F3) : p ∈ FF3 0 := by
  induction p using FreeAlgebra.induction with
  | grade0 r =>
    rw [Algebra.algebraMap_eq_smul_one]
    exact Submodule.smul_mem _ r (by simpa using word_mem_FF3 (m := 0) [] le_rfl)
  | grade1 i => simpa using word_mem_FF3 (m := 0) [i] (by simp)
  | mul a b ha hb => simpa using mul_mem_FF3 ha hb
  | add a b ha hb => exact add_mem ha hb

theorem Yg_mem_FF3 (i : Fin 3) : Yg i ∈ FF3 1 := by
  simpa using word_mem_FF3 (m := 1) [i] (by simp)

theorem comm_mem_FF3_two (i j : Fin 3) : Yg i * Yg j - Yg j * Yg i ∈ FF3 2 := by
  have h1 : Yg i * Yg j ∈ FF3 (1 + 1) := mul_mem_FF3 (Yg_mem_FF3 i) (Yg_mem_FF3 j)
  have h2 : Yg j * Yg i ∈ FF3 (1 + 1) := mul_mem_FF3 (Yg_mem_FF3 j) (Yg_mem_FF3 i)
  exact sub_mem h1 h2

end FF3Lemmas

/-! ### Leibniz maps of `ℚ⟨Y₁, Y₂, Y₃⟩` with prescribed values on the generators -/

section Der3

/-- The algebra map `p ↦ [[p, D p], [0, p]]` with `D (Yᵢ) = d i`. -/
noncomputable def triHom3 (d : Fin 3 → F3) : F3 →ₐ[ℚ] Matrix (Fin 2) (Fin 2) F3 :=
  FreeAlgebra.lift ℚ (fun i => !![FreeAlgebra.ι ℚ i, d i; 0, FreeAlgebra.ι ℚ i])

/-- The Leibniz map with `D (Yᵢ) = d i`: the upper-right entry of `triHom3 d`. -/
noncomputable def der3 (d : Fin 3 → F3) (p : F3) : F3 := triHom3 d p 0 1

theorem triHom3_entries (d : Fin 3 → F3) (p : F3) :
    triHom3 d p 0 0 = p ∧ triHom3 d p 1 0 = 0 ∧ triHom3 d p 1 1 = p := by
  induction p using FreeAlgebra.induction with
  | grade0 r => simp [Matrix.algebraMap_matrix_apply]
  | grade1 i => simp [triHom3]
  | mul p q hp hq =>
    obtain ⟨p0, p1, p2⟩ := hp
    obtain ⟨q0, q1, q2⟩ := hq
    simp only [map_mul, Matrix.mul_apply, Fin.sum_univ_two, p0, p1, p2, q0, q1, q2]
    simp
  | add p q hp hq =>
    obtain ⟨p0, p1, p2⟩ := hp
    obtain ⟨q0, q1, q2⟩ := hq
    simp [map_add, p0, p1, p2, q0, q1, q2]

theorem der3_mul (d : Fin 3 → F3) (p q : F3) :
    der3 d (p * q) = p * der3 d q + der3 d p * q := by
  obtain ⟨p0, -, -⟩ := triHom3_entries d p
  obtain ⟨-, -, q2⟩ := triHom3_entries d q
  simp only [der3, map_mul, Matrix.mul_apply, Fin.sum_univ_two, p0, q2]

theorem der3_add (d : Fin 3 → F3) (p q : F3) : der3 d (p + q) = der3 d p + der3 d q := by
  simp [der3, map_add]

theorem der3_smul (d : Fin 3 → F3) (r : ℚ) (p : F3) : der3 d (r • p) = r • der3 d p := by
  simp [der3, map_smul]

theorem der3_algebraMap (d : Fin 3 → F3) (r : ℚ) : der3 d (algebraMap ℚ F3 r) = 0 := by
  simp [der3, Matrix.algebraMap_matrix_apply]

theorem der3_ι (d : Fin 3 → F3) (i : Fin 3) : der3 d (FreeAlgebra.ι ℚ i) = d i := by
  simp [der3, triHom3]

theorem der3_zero (d : Fin 3 → F3) : der3 d 0 = 0 := by simp [der3]

theorem der3_sub (d : Fin 3 → F3) (p q : F3) : der3 d (p - q) = der3 d p - der3 d q := by
  simp [der3, map_sub]

/-- The Leibniz map is additive in its prescribed values. -/
theorem der3_add_dir (d e : Fin 3 → F3) (p : F3) : der3 (d + e) p = der3 d p + der3 e p := by
  induction p using FreeAlgebra.induction with
  | grade0 r => simp [der3_algebraMap]
  | grade1 i => simp [der3_ι]
  | mul p q hp hq => rw [der3_mul, der3_mul, der3_mul, hp, hq]; noncomm_ring
  | add p q hp hq => rw [der3_add, der3_add, der3_add, hp, hq]; abel

/-- Two Leibniz maps commute if their commutator vanishes on the generators. -/
theorem der3_comm (d e : Fin 3 → F3) (h : ∀ i, der3 d (e i) = der3 e (d i)) (p : F3) :
    der3 d (der3 e p) = der3 e (der3 d p) := by
  induction p using FreeAlgebra.induction with
  | grade0 r => simp [der3_algebraMap, der3_zero]
  | grade1 i => rw [der3_ι, der3_ι, h]
  | mul p q hp hq =>
    simp only [der3_mul, der3_add]
    rw [hp, hq]; abel
  | add p q hp hq => rw [der3_add, der3_add, der3_add, der3_add, hp, hq]

/-- A Leibniz map whose values on the generators lie in `FF3 2` raises the word filtration. -/
theorem der3_mem_FF3 (d : Fin 3 → F3) (hd : ∀ i, d i ∈ FF3 2) {k : ℕ} {p : F3}
    (hp : p ∈ FF3 k) : der3 d p ∈ FF3 (k + 1) := by
  have hw : ∀ w : List (Fin 3), der3 d (w.map (FreeAlgebra.ι ℚ)).prod ∈ FF3 (w.length + 1) := by
    intro w
    induction w with
    | nil => simpa [der3_zero] using (show der3 d 1 = 0 by simpa using der3_algebraMap d 1) ▸
        zero_mem (FF3 1)
    | cons i w ih =>
      simp only [List.map_cons, List.prod_cons, der3_mul, der3_ι, List.length_cons]
      exact add_mem (mul_mem_FF3' (by omega) (Yg_mem_FF3 i) ih)
        (mul_mem_FF3' (by omega) (hd i) (word_mem_FF3 w le_rfl))
  induction hp using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨w, hw', rfl⟩ := hx
    exact FF3_anti (by omega) (hw w)
  | zero => rw [der3_zero]; exact zero_mem _
  | add x y _ _ hx hy => rw [der3_add]; exact add_mem hx hy
  | smul r x _ hx => rw [der3_smul]; exact Submodule.smul_mem _ r hx

/-- `der3 d` as a linear map. -/
noncomputable def derL (d : Fin 3 → F3) : F3 →ₗ[ℚ] F3 where
  toFun := der3 d
  map_add' := der3_add d
  map_smul' r p := der3_smul d r p

@[simp] theorem derL_apply (d : Fin 3 → F3) (p : F3) : derL d p = der3 d p := rfl

end Der3

/-! ### The retraction `U4 N → End(ℚ⟨Y₁, Y₂, Y₃⟩ ⧸ FF3 N)` -/

section Retract

variable (N : ℕ)

/-- `ℚ⟨Y₁, Y₂, Y₃⟩` modulo the words of length at least `N`. -/
abbrev M3 : Type := F3 ⧸ FF3 N

/-- A linear map raising the word filtration by one. -/
def Raises (f : F3 →ₗ[ℚ] F3) : Prop := ∀ k p, p ∈ FF3 k → f p ∈ FF3 (k + 1)

variable {N}

theorem Raises.add {f g : F3 →ₗ[ℚ] F3} (hf : Raises f) (hg : Raises g) : Raises (f + g) :=
  fun k p hp => add_mem (hf k p hp) (hg k p hp)

theorem raises_derL (d : Fin 3 → F3) (hd : ∀ i, d i ∈ FF3 2) : Raises (derL d) :=
  fun _ _ hp => der3_mem_FF3 d hd hp

theorem raises_mulLeft (i : Fin 3) : Raises (LinearMap.mulLeft ℚ (Yg i)) :=
  fun k _ hp => mul_mem_FF3' (by omega) (Yg_mem_FF3 i) hp

variable (N) in
/-- A filtration-raising linear map, acting on `M3 N`. -/
noncomputable def qop (f : F3 →ₗ[ℚ] F3) (hf : Raises f) : Module.End ℚ (M3 N) :=
  (FF3 N).mapQ (FF3 N) f (fun p hp => FF3_anti (Nat.le_succ N) (hf N p hp))

theorem qop_mk (f : F3 →ₗ[ℚ] F3) (hf : Raises f) (p : F3) :
    qop N f hf (Submodule.Quotient.mk p) = Submodule.Quotient.mk (f p) := rfl

theorem qop_add (f g : F3 →ₗ[ℚ] F3) (hf : Raises f) (hg : Raises g) :
    qop N f hf + qop N g hg = qop N (f + g) (hf.add hg) := by
  apply Submodule.linearMap_qext
  refine LinearMap.ext fun p => ?_
  simp only [LinearMap.comp_apply, LinearMap.add_apply, Submodule.mkQ_apply, qop_mk,
    Submodule.Quotient.mk_add]

theorem commute_qop {f g : F3 →ₗ[ℚ] F3} (hf : Raises f) (hg : Raises g)
    (h : ∀ p, f (g p) = g (f p)) : Commute (qop N f hf) (qop N g hg) := by
  show qop N f hf * qop N g hg = qop N g hg * qop N f hf
  apply Submodule.linearMap_qext
  refine LinearMap.ext fun p => ?_
  simp only [LinearMap.comp_apply, Module.End.mul_apply, Submodule.mkQ_apply, qop_mk, h]

/-- The commutator `[Yᵢ, Yⱼ]`. -/
noncomputable abbrev cY (i j : Fin 3) : F3 := Yg i * Yg j - Yg j * Yg i

/-- The values of the Leibniz map `t₁₂`: `Y₁ ↦ [Y₁, Y₂]`, `Y₂ ↦ [Y₂, Y₁]`, `Y₃ ↦ 0`. -/
noncomputable def d12 : Fin 3 → F3 := ![cY 0 1, cY 1 0, 0]
/-- The values of the Leibniz map `t₁₃`: `Y₁ ↦ [Y₁, Y₃]`, `Y₂ ↦ 0`, `Y₃ ↦ [Y₃, Y₁]`. -/
noncomputable def d13 : Fin 3 → F3 := ![cY 0 2, 0, cY 2 0]
/-- The values of the Leibniz map `t₂₃`: `Y₁ ↦ 0`, `Y₂ ↦ [Y₂, Y₃]`, `Y₃ ↦ [Y₃, Y₂]`. -/
noncomputable def d23 : Fin 3 → F3 := ![0, cY 1 2, cY 2 1]

theorem d12_mem (i : Fin 3) : d12 i ∈ FF3 2 := by
  fin_cases i <;> simp [d12, comm_mem_FF3_two]
theorem d13_mem (i : Fin 3) : d13 i ∈ FF3 2 := by
  fin_cases i <;> simp [d13, comm_mem_FF3_two]
theorem d23_mem (i : Fin 3) : d23 i ∈ FF3 2 := by
  fin_cases i <;> simp [d23, comm_mem_FF3_two]

variable (N) in
/-- The Leibniz map acting on `M3 N`. -/
noncomputable def qD (d : Fin 3 → F3) (hd : ∀ i, d i ∈ FF3 2) : Module.End ℚ (M3 N) :=
  qop N (derL d) (raises_derL d hd)

variable (N) in
/-- Left multiplication by `Yᵢ` on `M3 N`. -/
noncomputable def qL (i : Fin 3) : Module.End ℚ (M3 N) :=
  qop N (LinearMap.mulLeft ℚ (Yg i)) (raises_mulLeft i)

theorem qL_mk (i : Fin 3) (p : F3) :
    qL N i (Submodule.Quotient.mk p) = Submodule.Quotient.mk (Yg i * p) := rfl

theorem comm_DL1 (d : Fin 3 → F3) (hd : ∀ i, d i ∈ FF3 2) (i : Fin 3) (h : d i = 0) :
    Commute (qD N d hd) (qL N i) := by
  refine commute_qop _ _ fun p => ?_
  simp only [derL_apply, LinearMap.mulLeft_apply, der3_mul, der3_ι, h, zero_mul, add_zero]

theorem comm_DL (d : Fin 3 → F3) (hd : ∀ i, d i ∈ FF3 2) (i j : Fin 3) (h : d i + d j = 0) :
    Commute (qD N d hd) (qL N i + qL N j) := by
  rw [qL, qL, qop_add]
  refine commute_qop _ _ fun p => ?_
  simp only [derL_apply, LinearMap.add_apply, LinearMap.mulLeft_apply, der3_add, der3_mul, der3_ι]
  rw [eq_neg_of_add_eq_zero_right h]
  noncomm_ring

theorem comm_LD (d : Fin 3 → F3) (hd : ∀ i, d i ∈ FF3 2) (i j : Fin 3) (h : d i = cY i j) :
    Commute (qL N i) (qD N d hd + qL N j) := by
  rw [qL, qL, qD, qop_add]
  refine commute_qop _ _ fun p => ?_
  simp only [derL_apply, LinearMap.add_apply, LinearMap.mulLeft_apply, der3_mul, der3_ι, h]
  noncomm_ring

theorem comm_DD (d e f : Fin 3 → F3) (hd : ∀ i, d i ∈ FF3 2) (he : ∀ i, e i ∈ FF3 2)
    (hf : ∀ i, f i ∈ FF3 2) (h : ∀ i, der3 d ((e + f) i) = der3 (e + f) (d i)) :
    Commute (qD N d hd) (qD N e he + qD N f hf) := by
  rw [qD, qD, qD, qop_add]
  refine commute_qop _ _ fun p => ?_
  simp only [derL_apply, LinearMap.add_apply]
  rw [← der3_add_dir, ← der3_add_dir]
  exact der3_comm _ _ h p

theorem der3_cY (d : Fin 3 → F3) (i j : Fin 3) :
    der3 d (cY i j) = Yg i * d j + d i * Yg j - (Yg j * d i + d j * Yg i) := by
  simp only [cY, der3_sub, der3_mul, der3_ι]

/-- Generator checks for the Leibniz map–Leibniz map relations. -/
local macro "dd_check" : tactic =>
  `(tactic| (intro i; fin_cases i <;>
    simp only [Pi.add_apply, der3_add_dir, d12, d13, d23, Fin.zero_eta, Fin.mk_one,
      Fin.reduceFinMk, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons, Matrix.cons_val, der3_add, der3_zero, der3_cY,
      add_zero, zero_add] <;>
    simp only [cY, Fin.isValue, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons, Matrix.cons_val, mul_zero, zero_mul, add_zero,
      zero_add, sub_zero, zero_sub] <;>
    noncomm_ring))

variable (N) in
/-- The six generators: `t₁₂, t₁₃, t₂₃` act by Leibniz maps, `t₁₄, t₂₄, t₃₄` by left
multiplication by `Y₁, Y₂, Y₃`. -/
noncomputable def gen : Fin 6 → Module.End ℚ (M3 N) :=
  ![qD N d12 d12_mem, qD N d13 d13_mem, qL N 0, qD N d23 d23_mem, qL N 1, qL N 2]

/-- **The Drinfeld–Kohno relations hold for the retraction family.** -/
theorem gen_dk4 : DK4 (gen N 0) (gen N 1) (gen N 2) (gen N 3) (gen N 4) (gen N 5) where
  f12_34 := comm_DL1 d12 d12_mem 2 rfl
  f13_24 := comm_DL1 d13 d13_mem 1 rfl
  f14_23 := (comm_DL1 d23 d23_mem 0 rfl).symm
  n12_3 := comm_DD d12 d13 d23 d12_mem d13_mem d23_mem (by dd_check)
  n13_2 := comm_DD d13 d12 d23 d13_mem d12_mem d23_mem (by dd_check)
  n23_1 := comm_DD d23 d12 d13 d23_mem d12_mem d13_mem (by dd_check)
  n12_4 := comm_DL d12 d12_mem 0 1 (by simp [d12])
  n14_2 := comm_LD d12 d12_mem 0 1 rfl
  n24_1 := comm_LD d12 d12_mem 1 0 rfl
  n13_4 := comm_DL d13 d13_mem 0 2 (by simp [d13])
  n14_3 := comm_LD d13 d13_mem 0 2 rfl
  n34_1 := comm_LD d13 d13_mem 2 0 rfl
  n23_4 := comm_DL d23 d23_mem 1 2 (by simp [d23])
  n24_3 := comm_LD d23 d23_mem 1 2 rfl
  n34_2 := comm_LD d23 d23_mem 2 1 rfl

theorem gen_eq_qop (i : Fin 6) : ∃ f hf, gen N i = qop N f hf := by
  fin_cases i
  exacts [⟨_, raises_derL d12 d12_mem, rfl⟩, ⟨_, raises_derL d13 d13_mem, rfl⟩,
    ⟨_, raises_mulLeft 0, rfl⟩, ⟨_, raises_derL d23 d23_mem, rfl⟩,
    ⟨_, raises_mulLeft 1, rfl⟩, ⟨_, raises_mulLeft 2, rfl⟩]

/-- Every word of length `N` in the generators vanishes on `M3 N`. -/
theorem gen_word_eq_zero (w : List (Fin 6)) (hw : w.length = N) : (w.map (gen N)).prod = 0 := by
  have key : ∀ (w : List (Fin 6)) (k : ℕ) (p : F3), p ∈ FF3 k →
      ∃ q ∈ FF3 (k + w.length), (w.map (gen N)).prod (Submodule.Quotient.mk p) =
        Submodule.Quotient.mk q := by
    intro w
    induction w with
    | nil => intro k p hp; exact ⟨p, by simpa using hp, by simp⟩
    | cons i w ih =>
      intro k p hp
      obtain ⟨q, hq, e⟩ := ih k p hp
      obtain ⟨f, hf, hi⟩ := gen_eq_qop (N := N) i
      refine ⟨f q, ?_, ?_⟩
      · rw [List.length_cons, ← add_assoc]; exact hf _ q hq
      · rw [List.map_cons, List.prod_cons, Module.End.mul_apply, e, hi, qop_mk]
  refine LinearMap.ext fun x => ?_
  induction x using Submodule.Quotient.induction_on with
  | H p =>
    obtain ⟨q, hq, e⟩ := key w 0 p (mem_FF3_zero p)
    rw [e, LinearMap.zero_apply, Submodule.Quotient.mk_eq_zero]
    simpa [hw] using hq

variable (N) in
/-- **The retraction** `U4 N → End(ℚ⟨Y₁, Y₂, Y₃⟩ ⧸ FF3 N)`. -/
noncomputable def retract : U4 N →ₐ[ℚ] Module.End ℚ (M3 N) :=
  lift N (gen N) gen_dk4 gen_word_eq_zero

/-- On the image of `ℚ⟨Y₁, Y₂, Y₃⟩` under `Yᵢ ↦ t_{i4}`, the retraction is left multiplication. -/
theorem retract_lift_apply (c q : F3) :
    retract N (FreeAlgebra.lift ℚ ![t N 2, t N 4, t N 5] c) (Submodule.Quotient.mk q) =
      Submodule.Quotient.mk (c * q) := by
  have hcomp : (retract N).comp (FreeAlgebra.lift ℚ ![t N 2, t N 4, t N 5]) =
      FreeAlgebra.lift ℚ ![qL N 0, qL N 1, qL N 2] := by
    apply FreeAlgebra.hom_ext
    funext i
    fin_cases i <;> simp [retract, gen]
  have h := congrArg (fun φ : F3 →ₐ[ℚ] Module.End ℚ (M3 N) => φ c) hcomp
  simp only [AlgHom.comp_apply] at h
  rw [h]
  clear h hcomp
  induction c using FreeAlgebra.induction generalizing q with
  | grade0 r =>
    rw [AlgHom.commutes, Module.algebraMap_end_apply, ← Submodule.Quotient.mk_smul,
      Algebra.smul_def]
  | grade1 i => fin_cases i <;> simp [qL_mk]
  | mul a b ha hb => rw [map_mul, Module.End.mul_apply, hb, ha, mul_assoc]
  | add a b ha hb => rw [map_add, LinearMap.add_apply, ha, hb, add_mul, Submodule.Quotient.mk_add]

/-- **Pulling back.** If an element of `ℚ⟨Y₁, Y₂, Y₃⟩` vanishes at `(t₁₄, t₂₄, t₃₄)` in `U4 N`,
it lies in `FF3 N`. -/
theorem mem_FF3_of_lift_eq_zero {c : F3} (h : FreeAlgebra.lift ℚ ![t N 2, t N 4, t N 5] c = 0) :
    c ∈ FF3 N := by
  have := retract_lift_apply (N := N) c 1
  rw [h, map_zero, LinearMap.zero_apply, mul_one] at this
  exact (Submodule.Quotient.mk_eq_zero _).1 this.symm

end Retract

/-! ### The link: `u = 0` forces `s ∈ FF N`, and (5.14) follows -/

section Link

variable {N : ℕ} {y : F2}

/-- (5.24) from (5.17), (5.18), (5.20) with the conditions as explicit hypotheses
(`GrtU4.uDefect_eq_zero` without its `lin514` field). -/
theorem uDefect_eq_zero_of_lin
    (h512 : ∀ a b : U4 N, a ∈ Fil N 1 → b ∈ Fil N 1 → eval a b y + eval b a y = 0)
    (h513 : eval (t N 1) (t N 0) y + eval (t N 3) (t N 1) y + eval (t N 0) (t N 3) y = 0)
    (h515 : eval (t N 0) (t N 3 + t N 4) y + eval (t N 1 + t N 3) (t N 5) y =
      eval (t N 3) (t N 5) y + eval (t N 0 + t N 1) (t N 4 + t N 5) y + eval (t N 0) (t N 3) y) :
    uDefect (fun a b => eval a b y) (t N 0) (t N 1) (t N 2) (t N 3) (t N 4) (t N 5) = 0 := by
  have T := t_mem_Fil_one (N := N)
  have h := dk4 N
  have hex : ∀ a b c : U4 N, a ∈ Fil N 1 → b ∈ Fil N 1 → c ∈ Fil N 1 → DK3 a b c →
      eval b a y + eval c b y + eval a c y = 0 := by
    intro a b c ha hb hc hd
    have := congrArg (liftU3 a b c hd ha hb hc) h513
    simpa only [map_add, map_zero, map_eval, liftU3_t0, liftU3_t1, liftU3_t3] using this
  have hd2 : DK4 (t N 0) (t N 2) (t N 1) (t N 4) (t N 3) (t N 5) :=
    ⟨h.f12_34, h.f14_23, h.f13_24, h.n12_4, h.n14_2, h.n24_1, h.n12_3, h.n13_2, h.n23_1,
      h.n14_3, h.n13_4, by rw [add_comm]; exact h.n34_1, h.n24_3, h.n23_4,
      by rw [add_comm]; exact h.n34_2⟩
  have hd3 : DK4 (t N 2) (t N 0) (t N 1) (t N 4) (t N 5) (t N 3) :=
    ⟨h.f14_23, h.f12_34, h.f13_24, h.n14_2, h.n12_4, by rw [add_comm]; exact h.n24_1,
      h.n14_3, h.n13_4, by rw [add_comm]; exact h.n34_1, h.n12_3, h.n13_2, h.n23_1,
      by rw [add_comm]; exact h.n24_3, by rw [add_comm]; exact h.n34_2, h.n23_4⟩
  have hw (s : Fin 6 → U4 N) (hs : ∀ i, s i ∈ Fil N 1) := word_eq_zero_of_Fil_one s hs
  have p2 := congrArg (lift N ![t N 0, t N 2, t N 1, t N 4, t N 3, t N 5] (by simpa using hd2)
    (hw _ (by intro i; fin_cases i <;> simp [T]))) h515
  have p3 := congrArg (lift N ![t N 2, t N 0, t N 1, t N 4, t N 5, t N 3] (by simpa using hd3)
    (hw _ (by intro i; fin_cases i <;> simp [T]))) h515
  simp only [map_add, map_eval, lift_t, Matrix.cons_val, Fin.isValue] at p2 p3
  refine RationalAssociator.uDefect_eq_zero (fun a b => eval a b y) (Fil N 1) h (T 0) (T 1)
    (T 2) (T 3) (T 4) (T 5) h512 hex (fun m a b ha hb => (commute_eval ha.symm hb.symm y).symm)
    ?_ ?_ ?_
  · simp only [linPentDefect]; rw [h515]; abel
  · simp only [linPentDefect]; rw [p2]; abel
  · simp only [linPentDefect]; rw [p3]; abel

/-- **`u` is the cocycle of `s`, pushed to `(t₁₄, t₂₄, t₃₄)`.** For a Lie element `y`, each of
the four `S` terms of `u` is `s` at a pair of the `t_{i4}`, so `u` is the image of
`cocycle (sPoly y)` under `Y₁, Y₂, Y₃ ↦ t₁₄, t₂₄, t₃₄`. -/
theorem uDefect_eq_lift_cocycle (hy : IsLieElt y) :
    uDefect (fun a b => eval a b y) (t N 0) (t N 1) (t N 2) (t N 3) (t N 4) (t N 5) =
      FreeAlgebra.lift ℚ ![t N 2, t N 4, t N 5] (cocycle (sPoly y)) := by
  have h := dk4 N
  have hA : DK3 (t N 0) (t N 2) (t N 4) := ⟨h.n12_4, h.n14_2, h.n24_1⟩
  have e1 := S_eq_eval_sPoly hy hA
  have e2 := S_eq_eval_sPoly hy h.d2
  have e3 := S_eq_eval_sPoly hy h.d1
  have e4 := S_eq_eval_sPoly hy h.d0
  simp only [cocycle, map_sub, map_add, map_eval, FreeAlgebra.lift_ι_apply, Matrix.cons_val_zero,
    Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons]
  rw [← e1, ← e2, ← e3, ← e4]
  simp only [uDefect]

/-- **Drinfeld's Prop. 5.7, the missing link.** For a Lie element `y` satisfying the linearised
(5.17), (5.18), (5.20) in `U4 N`, the polynomial `s = sPoly y` lies in `FF N`. -/
theorem sPoly_mem_FF_of_lin (hy : IsLieElt y)
    (h512 : ∀ a b : U4 N, a ∈ Fil N 1 → b ∈ Fil N 1 → eval a b y + eval b a y = 0)
    (h513 : eval (t N 1) (t N 0) y + eval (t N 3) (t N 1) y + eval (t N 0) (t N 3) y = 0)
    (h515 : eval (t N 0) (t N 3 + t N 4) y + eval (t N 1 + t N 3) (t N 5) y =
      eval (t N 3) (t N 5) y + eval (t N 0 + t N 1) (t N 4 + t N 5) y + eval (t N 0) (t N 3) y) :
    sPoly y ∈ FF N := by
  have hu := uDefect_eq_zero_of_lin h512 h513 h515
  rw [uDefect_eq_lift_cocycle hy] at hu
  exact vanishing_of_cocycle (sPoly_lieLike y) (sPoly_symm y) (mem_FF3_of_lift_eq_zero hu)

/-- **(5.14) from (5.17), (5.18), (5.20) for a Lie element**, at every `DK3` triple of
`Fil N 1`, in the form `GrtU4` asks for. Zero-sum triples come from (5.19), which follows from
`s ∈ FF N`; a triple with nonzero central sum `z = u + v + w` is reduced to the zero-sum triple
`(−(v + w), v, w)` by the central shift, the two shifts cancelling by (5.17). -/
theorem lin514_of_lie (hy : IsLieElt y)
    (h512 : ∀ a b : U4 N, a ∈ Fil N 1 → b ∈ Fil N 1 → eval a b y + eval b a y = 0)
    (h513 : eval (t N 1) (t N 0) y + eval (t N 3) (t N 1) y + eval (t N 0) (t N 3) y = 0)
    (h515 : eval (t N 0) (t N 3 + t N 4) y + eval (t N 1 + t N 3) (t N 5) y =
      eval (t N 3) (t N 5) y + eval (t N 0 + t N 1) (t N 4 + t N 5) y + eval (t N 0) (t N 3) y)
    (u v w : U4 N) (hu : u ∈ Fil N 1) (hv : v ∈ Fil N 1) (hw : w ∈ Fil N 1) (h : DK3 u v w) :
    eval v w y * v + v * eval w v y = eval u w y * (v + w) + (v + w) * eval w u y := by
  have hs := sPoly_mem_FF_of_lin hy h512 h513 h515
  have h519 : ∀ A B : U4 N, A ∈ Fil N 1 → B ∈ Fil N 1 →
      (B * eval A B y - eval A B y * B) + (-(A + B) * eval A (-(A + B)) y -
        eval A (-(A + B)) y * -(A + B)) = 0 := by
    intro A B hA hB
    rw [S_eq_eval_sPoly hy (dk3_of_sum_zero (show A + B + -(A + B) = 0 by abel))]
    exact eq_zero_of_mem_Fil (eval_mem_Fil hB (neg_mem (add_mem hA hB)) hs)
  set u' : U4 N := -(v + w) with hu'def
  have hu' : u' ∈ Fil N 1 := neg_mem (add_mem hv hw)
  have base := lin514_of_drinfeld519 h512 h519 hu' hv hw (by rw [hu'def]; abel)
  obtain ⟨hzu, hzv, hzw⟩ := h.commute_sum
  set z : U4 N := u + v + w with hz
  have hzu' : Commute z u' := (hzv.add_right hzw).neg_right
  have eu : u = u' + z := by rw [hu'def, hz]; abel
  obtain ⟨α, hα⟩ := shift_left hy hzu' hzw
  obtain ⟨β, hβ⟩ := shift_right hy hzw hzu'
  rw [← eu] at hα hβ
  have a1 := h512 u w hu hw
  have a2 := h512 u' w hu' hw
  have hab : (α + β) • z = 0 := by
    rw [hα, hβ] at a1
    rw [add_smul]
    have : eval u' w y + α • z + (eval w u' y + β • z) = eval u' w y + eval w u' y +
      (α • z + β • z) := by abel
    rw [this, a2, zero_add] at a1
    exact a1
  have key : (v + w) * (β • z) = (β • z) * (v + w) := ((hzv.add_right hzw).smul_left β).eq.symm
  have h0 : (α • z) * (v + w) + (β • z) * (v + w) = 0 := by
    rw [← add_mul, ← add_smul, hab, zero_mul]
  rw [base, hα, hβ, mul_add (v + w) _ (β • z), key]
  generalize α • z = Az at h0 ⊢
  generalize β • z = Bz at h0 ⊢
  rw [← sub_eq_zero]
  convert (congrArg Neg.neg h0).trans neg_zero using 1
  noncomm_ring

/-- **`GrtU4` from the three conditions (5.17), (5.18), (5.20) for a Lie element.** -/
theorem grtU4_of_lie (hy : IsLieElt y)
    (h512 : ∀ a b : U4 N, a ∈ Fil N 1 → b ∈ Fil N 1 → eval a b y + eval b a y = 0)
    (h513 : eval (t N 1) (t N 0) y + eval (t N 3) (t N 1) y + eval (t N 0) (t N 3) y = 0)
    (h515 : eval (t N 0) (t N 3 + t N 4) y + eval (t N 1 + t N 3) (t N 5) y =
      eval (t N 3) (t N 5) y + eval (t N 0 + t N 1) (t N 4 + t N 5) y + eval (t N 0) (t N 3) y) :
    GrtU4 N y where
  const := hy.const
  lin512 := h512
  lin513 := h513
  lin514 := lin514_of_lie hy h512 h513 h515
  lin515 := h515

end Link

end QOU.BraidsAndKnots.RationalAssociator
