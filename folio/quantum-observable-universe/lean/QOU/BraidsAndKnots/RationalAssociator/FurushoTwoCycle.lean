import QOU.BraidsAndKnots.RationalAssociator.FurushoReduction
import QOU.BraidsAndKnots.RationalAssociator.Homogeneity
import QOU.BraidsAndKnots.RationalAssociator.Friedrichs

/-!
# Furusho's Lie-algebra theorem, part 1: Lie evaluation and the 2-cycle relation

Bean `qou-3fdg` (epic `qou-dk7p`). Furusho (*Pentagon and hexagon equations*, Ann. of Math. 171
(2010), Theorem 3) proves that a Lie element `φ` of degree `≥ 3` satisfying the pentagon also
satisfies the 2-cycle and 3-cycle (hexagon) relations. This file proves two ingredients, both
algebraic over `ℚ`.

1. **Lie elements of degree `≥ 2` do not see commuting shifts** (`eval_shift_of_mem_lieSpan`,
   `eval_add_left`, `eval_add_right`, `eval_smul_smul_eq_zero`). For a Lie element `ℓ` and `c`
   commuting with `a` and `b`, `ℓ(a + αc, b + βc) = ℓ(a, b) + ℓ(α, β)·c`, where `ℓ(α, β) ∈ ℚ`.
   For a homogeneous primitive `h` of degree `d ≥ 2` the scalar `h(α, β)` is `0`.
2. **The 2-cycle relation from the pentagon** (`add_swap_eq_zero_of_pentagon`). Map `U4 (d + 1)`
   to `ℚ⟨X, Y⟩ ⧸ FF (d + 1)` by `t₁₂, t₃₄ ↦ X`, `t₁₄, t₂₃ ↦ Y`, `t₁₃, t₂₄ ↦ −X − Y` (Furusho's
   projection `X_{i5} = 0`, the pure sphere braid algebra on four points). The linearised
   pentagon (5.20) goes to `h(X, Y) + h(Y, X)` plus three terms evaluated at proportional
   pairs, which vanish by item 1. So `h + h(Y, X) = 0` in `ℚ⟨X, Y⟩`.

No analysis and no numerical value is used.
-/

namespace QOU.BraidsAndKnots.RationalAssociator

open Friedrichs

local notation "F2" => FreeAlgebra ℚ (Fin 2)

/-! ### 1. Lie elements and commuting shifts -/

section Shift

variable {R : Type*} [Ring R] [Algebra ℚ R]

/-- **Commuting shifts of a Lie element.** For `ℓ` in the Lie subalgebra generated by `X, Y` and
`c` commuting with `a, b`: `ℓ(a + αc, b + βc) = ℓ(a, b) + ℓ(α, β)·c`, with `ℓ(α, β) ∈ ℚ`. -/
theorem eval_shift_of_mem_lieSpan {ℓ : F2} (hℓ : ℓ ∈ LieSpanXY) {a b c : R}
    (ha : Commute c a) (hb : Commute c b) (α β : ℚ) :
    eval (a + α • c) (b + β • c) ℓ = eval a b ℓ + (eval α β ℓ) • c := by
  induction hℓ using LieSubalgebra.lieSpan_induction with
  | mem x hx =>
    rcases hx with rfl | rfl
    · simp [eval]
    · simp [eval]
  | zero => simp
  | add x y _ _ hx hy => rw [map_add, map_add, map_add, hx, hy, add_smul]; abel
  | smul r x _ hx => rw [map_smul, map_smul, map_smul, hx, smul_add, smul_smul, smul_eq_mul]
  | lie x y _ _ hx hy =>
    have c1 := (commute_eval ha.symm hb.symm x).eq
    have c2 := (commute_eval ha.symm hb.symm y).eq
    rw [Ring.lie_def, map_sub, map_mul, map_mul, map_sub, map_mul, map_mul, map_sub, map_mul,
      map_mul, hx, hy, mul_comm (eval α β y) (eval α β x), sub_self, zero_smul, add_zero]
    simp only [mul_add, add_mul, smul_mul_assoc, mul_smul_comm, c1, c2]
    module

variable {d : ℕ} {h : F2}

/-- For a homogeneous primitive `h` of degree `d ≥ 2`, the commutative values `h(α, β)` vanish. -/
theorem evalQ_eq_zero (hd : 2 ≤ d) (hh : Homog d h) (hp : IsPrimitive h) (α β : ℚ) :
    eval α β h = 0 := by
  have hL := mem_lieSpanXY_of_primitive hp
  have h0 : eval (0 : ℚ) 0 h = 0 := by
    have := eval_smul_of_homog hh 0 α β
    rw [zero_smul, zero_smul, zero_pow (by omega), zero_smul] at this
    exact this
  have key : ∀ r : ℚ, r ^ d * eval α β h = eval α β h * r := by
    intro r
    have e1 := eval_smul_of_homog hh r α β
    have e2 := eval_shift_of_mem_lieSpan hL (Commute.all r 0) (Commute.all r 0) α β
    rw [zero_add, zero_add, h0, zero_add, smul_eq_mul, smul_eq_mul, mul_comm α r,
      mul_comm β r] at e2
    rw [smul_eq_mul, smul_eq_mul, smul_eq_mul, e2] at e1
    rw [← e1, smul_eq_mul]
  obtain ⟨k, rfl⟩ : ∃ k, d = k + 2 := ⟨d - 2, by omega⟩
  have e := key 2
  have hk : (1 : ℚ) ≤ 2 ^ k := one_le_pow₀ (by norm_num)
  have : (2 ^ k * 4 - 2 : ℚ) * eval α β h = 0 := by rw [pow_add] at e; linarith
  rcases mul_eq_zero.1 this with h1 | h1
  · linarith
  · exact h1

/-- Shifting the first argument by a commuting element. -/
theorem eval_add_left (hd : 2 ≤ d) (hh : Homog d h) (hp : IsPrimitive h) {a b c : R}
    (ha : Commute c a) (hb : Commute c b) : eval (a + c) b h = eval a b h := by
  have := eval_shift_of_mem_lieSpan (mem_lieSpanXY_of_primitive hp) ha hb 1 0
  rwa [one_smul, zero_smul, add_zero, evalQ_eq_zero hd hh hp, zero_smul, add_zero] at this

/-- Shifting the second argument by a commuting element. -/
theorem eval_add_right (hd : 2 ≤ d) (hh : Homog d h) (hp : IsPrimitive h) {a b c : R}
    (ha : Commute c a) (hb : Commute c b) : eval a (b + c) h = eval a b h := by
  have := eval_shift_of_mem_lieSpan (mem_lieSpanXY_of_primitive hp) ha hb 0 1
  rwa [one_smul, zero_smul, add_zero, evalQ_eq_zero hd hh hp, zero_smul, add_zero] at this

/-- `h` vanishes on proportional pairs. -/
theorem eval_smul_smul_eq_zero (hd : 2 ≤ d) (hh : Homog d h) (hp : IsPrimitive h) (c : R)
    (α β : ℚ) : eval (α • c) (β • c) h = 0 := by
  have := eval_shift_of_mem_lieSpan (mem_lieSpanXY_of_primitive hp) (Commute.zero_right c)
    (Commute.zero_right c) α β
  rw [zero_add, zero_add, evalQ_eq_zero hd hh hp, zero_smul, add_zero] at this
  rw [this]
  have := eval_smul_of_homog hh 0 (0 : R) 0
  rwa [zero_smul, zero_pow (by omega), zero_smul] at this

end Shift

/-! ### 2. The 2-cycle relation from the linearised pentagon -/

section TwoCycle

/-- A four-strand family with every triangle summing to zero: `t₁₂ = t₃₄ = x`,
`t₁₄ = t₂₃ = y`, `t₁₃ = t₂₄ = −x − y`. -/
theorem dk4_sphere {S : Type*} [Ring S] (x y : S) : DK4 x (-x - y) y y (-x - y) x := by
  have s1 : DK3 x (-x - y) y := dk3_of_sum_zero (by abel)
  have s2 : DK3 x y (-x - y) := dk3_of_sum_zero (by abel)
  have s3 : DK3 (-x - y) y x := dk3_of_sum_zero (by abel)
  have s4 : DK3 y (-x - y) x := dk3_of_sum_zero (by abel)
  exact ⟨Commute.refl x, Commute.refl _, Commute.refl y, s1.n12_3, s1.n13_2, s1.n23_1,
    s2.n12_3, s2.n13_2, s2.n23_1, s3.n12_3, s3.n13_2, s3.n23_1, s4.n12_3, s4.n13_2, s4.n23_1⟩

/-- The values of the sphere family in `ℚ⟨X, Y⟩`. -/
noncomputable def sphVals : Fin 6 → F2 :=
  ![FreeAlgebra.ι ℚ 0, -FreeAlgebra.ι ℚ 0 - FreeAlgebra.ι ℚ 1, FreeAlgebra.ι ℚ 1,
    FreeAlgebra.ι ℚ 1, -FreeAlgebra.ι ℚ 0 - FreeAlgebra.ι ℚ 1, FreeAlgebra.ι ℚ 0]

theorem sphVals_mem (i : Fin 6) : sphVals i ∈ FF 1 := by
  fin_cases i <;> simp [sphVals, ι_mem_FF_one, sub_mem]

theorem prod_sphVals_mem (w : List (Fin 6)) : (w.map sphVals).prod ∈ FF w.length := by
  induction w with
  | nil => simpa using mem_FF_zero (1 : F2)
  | cons i w ih => simpa [Nat.add_comm] using mul_mem_FF (sphVals_mem i) ih

theorem dk4_sphVals {S : Type*} [Ring S] [Algebra ℚ S] (f : F2 →ₐ[ℚ] S) :
    DK4 (f (sphVals 0)) (f (sphVals 1)) (f (sphVals 2)) (f (sphVals 3)) (f (sphVals 4))
      (f (sphVals 5)) := by
  simpa [sphVals, map_sub, map_neg] using
    dk4_sphere (f (FreeAlgebra.ι ℚ 0)) (f (FreeAlgebra.ι ℚ 1))

/-- `U4 (d + 1)` acting on `ℚ⟨X, Y⟩ ⧸ FF (d + 1)` through the sphere family. -/
noncomputable def toSph (d : ℕ) : U4 (d + 1) →ₐ[ℚ] Module.End ℚ (F2 ⧸ FF (d + 1)) :=
  lift (d + 1) (fun i => lmQ (FF (d + 1)) (ff_mul_left d) (sphVals i))
    (dk4_sphVals (lmQ (FF (d + 1)) (ff_mul_left d))) fun w hw => by
      have : (w.map fun i => lmQ (FF (d + 1)) (ff_mul_left d) (sphVals i)).prod =
          lmQ (FF (d + 1)) (ff_mul_left d) (w.map sphVals).prod := by
        rw [map_list_prod, List.map_map]; rfl
      rw [this]
      exact lmQ_eq_zero _ (ff_mul_right d) (hw ▸ prod_sphVals_mem w)

theorem toSph_t (d : ℕ) (i : Fin 6) :
    toSph d (t (d + 1) i) = lmQ (FF (d + 1)) (ff_mul_left d) (sphVals i) := by
  simp [toSph, lift_t]

theorem toSph_eval {d : ℕ} {A B : U4 (d + 1)} {a b : F2} (h : F2)
    (hA : toSph d A = lmQ (FF (d + 1)) (ff_mul_left d) a)
    (hB : toSph d B = lmQ (FF (d + 1)) (ff_mul_left d) b) :
    toSph d (eval A B h) = lmQ (FF (d + 1)) (ff_mul_left d) (eval a b h) := by
  rw [map_eval, hA, hB, ← map_eval]

theorem toSph_t_add (d : ℕ) (i j : Fin 6) :
    toSph d (t (d + 1) i + t (d + 1) j) =
      lmQ (FF (d + 1)) (ff_mul_left d) (sphVals i + sphVals j) := by
  rw [map_add, toSph_t, toSph_t, map_add]

/-- **The 2-cycle relation.** A homogeneous primitive `h` of degree `d ≥ 2` whose linearised
pentagon (5.20) vanishes in `U4 (d + 1)` satisfies `h(X, Y) + h(Y, X) = 0` in `ℚ⟨X, Y⟩`. -/
theorem add_swap_eq_zero_of_pentagon {d : ℕ} (hd : 2 ≤ d) {h : F2} (hh : Homog d h)
    (hp : IsPrimitive h) (hpent : lin515Expr (d + 1) h = 0) : h + swapPoly h = 0 := by
  have e := congrArg (toSph d) hpent
  rw [map_zero, lin515Expr, map_sub, map_sub, map_add, map_add,
    toSph_eval h (toSph_t d 3) (toSph_t d 5),
    toSph_eval h (toSph_t_add d 0 1) (toSph_t_add d 4 5),
    toSph_eval h (toSph_t d 0) (toSph_t d 3),
    toSph_eval h (toSph_t d 0) (toSph_t_add d 3 4),
    toSph_eval h (toSph_t_add d 1 3) (toSph_t d 5),
    ← map_add, ← map_add, ← map_sub, ← map_sub] at e
  have hP := mem_of_lmQ_eq_zero _ e
  set X : F2 := FreeAlgebra.ι ℚ 0
  set Y : F2 := FreeAlgebra.ι ℚ 1
  have z1 : eval (sphVals 0 + sphVals 1) (sphVals 4 + sphVals 5) h = 0 := by
    rw [show sphVals 0 + sphVals 1 = (-1 : ℚ) • Y by simp [sphVals, X, Y]; abel,
      show sphVals 4 + sphVals 5 = (-1 : ℚ) • Y by simp [sphVals, X, Y]; abel]
    exact eval_smul_smul_eq_zero hd hh hp Y _ _
  have z2 : eval (sphVals 0) (sphVals 3 + sphVals 4) h = 0 := by
    rw [show sphVals 0 = (1 : ℚ) • X by simp [sphVals, X],
      show sphVals 3 + sphVals 4 = (-1 : ℚ) • X by simp [sphVals, X, Y]]
    exact eval_smul_smul_eq_zero hd hh hp X _ _
  have z3 : eval (sphVals 1 + sphVals 3) (sphVals 5) h = 0 := by
    rw [show sphVals 1 + sphVals 3 = (-1 : ℚ) • X by simp [sphVals, X, Y],
      show sphVals 5 = (1 : ℚ) • X by simp [sphVals, X]]
    exact eval_smul_smul_eq_zero hd hh hp X _ _
  have z4 : eval (sphVals 3) (sphVals 5) h = swapPoly h := by
    have : sphVals 3 = Y ∧ sphVals 5 = X := by simp [sphVals, X, Y]
    rw [this.1, this.2, ← eval_swapPoly, eval_ι_ι]
  have z5 : eval (sphVals 0) (sphVals 3) h = h := by
    have : sphVals 0 = X ∧ sphVals 3 = Y := by simp [sphVals, X, Y]
    rw [this.1, this.2, eval_ι_ι]
  rw [z1, z2, z3, z4, z5, add_zero, sub_zero, sub_zero, add_comm (swapPoly h)] at hP
  exact eq_zero_of_homog_mem_FF (hh.add hh.swap) hP

end TwoCycle

end QOU.BraidsAndKnots.RationalAssociator
