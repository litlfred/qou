import Mathlib.Algebra.Lie.OfAssociative
import Mathlib.Algebra.Lie.Subalgebra
import Mathlib.RingTheory.TensorProduct.Basic
import Mathlib.Algebra.FreeAlgebra
import Mathlib.Data.Matrix.Mul
import Mathlib.Tactic.NoncommRing
import QOU.BraidsAndKnots.RationalAssociator.Prop57Link

/-!
# The Friedrichs criterion for `ℚ⟨X, Y⟩`

Bean `qou-3fdg` (epic `qou-dk7p`), audit §17a.

`isLieElt_of_primitive`: an element `h` of the free algebra `ℚ⟨X, Y⟩ = FreeAlgebra ℚ (Fin 2)`
that is **primitive** for the shuffle coproduct, `Δ h = h ⊗ 1 + 1 ⊗ h`, is a Lie element
(`IsLieElt`, from `Prop57Link`). No homogeneity is assumed, and the constant term of a primitive
element is zero automatically (`algebraMapInv_eq_zero_of_primitive`).

The proof is the Dynkin–Specht–Wever argument, done purely algebraically:

* `cop` is the shuffle coproduct, `anti` the antipode (`ι i ↦ -ι i`, anti-multiplicative), and
  `eulerD` the Euler derivation (`ι i ↦ ι i`, so a word of length `n` is scaled by `n`).
* `dS_cop_mem`: the convolution `D ⋆ S = m ∘ (D ⊗ S) ∘ Δ` maps **every** element into the Lie span
  of `X, Y`. On `ι i · w` it equals `ε(w) ι i + [ι i, (D ⋆ S)(w)]`; this uses the antipode
  identity `m ∘ (id ⊗ S) ∘ Δ = η ε` (`idS_cop`). So `D ⋆ S` is the right-normed Dynkin bracketing.
* On a primitive `p`, `(D ⋆ S)(p) = D p · S 1 + D 1 · S p = D p`, so `D p` is Lie.
* `cop_eulerD`: `D` is a coderivation, so `D` preserves primitives.
* `G N` is the span of the words of length `≤ N`; `D - (N + 1)` maps `G (N + 1)` into `G N`
  (`eulerD_sub_mem_G`), and a primitive element of `G 0` (a constant) is `0`. Induction on `N`:
  `(N + 1) p = D p - (D - (N + 1)) p` is a difference of Lie elements.

The three identities on `ℚ⟨X, Y⟩ ⊗ ℚ⟨X, Y⟩` (`idS_cop_g_mul`, `dS_cop_g_mul`,
`dTensor_cop_g_mul`) are checked on pure tensors; every statement about `ℚ⟨X, Y⟩` is then proved by
induction on left multiplication by a generator (`induction_left`).
-/

namespace QOU.BraidsAndKnots.RationalAssociator.Friedrichs

open TensorProduct

local notation "F2" => FreeAlgebra ℚ (Fin 2)

/-- The generator `ι i` of `ℚ⟨X, Y⟩`. -/
noncomputable abbrev g (i : Fin 2) : F2 := FreeAlgebra.ι ℚ i

/-- The Lie subalgebra of `ℚ⟨X, Y⟩` generated by `X` and `Y`. -/
abbrev LieSpanXY : LieSubalgebra ℚ F2 := LieSubalgebra.lieSpan ℚ F2 {g 0, g 1}

/-! ### An induction principle: left multiplication by generators -/

/-- A predicate that holds at `1`, is preserved by left multiplication with a generator, and is
closed under sums and scalar multiples holds everywhere on `ℚ⟨X, Y⟩`. -/
theorem induction_left {M : F2 → Prop} (h1 : M 1) (hg : ∀ i y, M y → M (g i * y))
    (hadd : ∀ x y, M x → M y → M (x + y)) (hsmul : ∀ (c : ℚ) y, M y → M (c • y)) (x : F2) :
    M x := by
  have key : ∀ x y, M y → M (x * y) := by
    intro x
    induction x using FreeAlgebra.induction with
    | grade0 r => intro y hy; rw [← Algebra.smul_def]; exact hsmul r y hy
    | grade1 i => exact hg i
    | mul a b ha hb => intro y hy; rw [mul_assoc]; exact ha _ (hb y hy)
    | add a b ha hb => intro y hy; rw [add_mul]; exact hadd _ _ (ha y hy) (hb y hy)
  simpa using key x 1 h1

/-! ### The shuffle coproduct and primitive elements -/

/-- The shuffle coproduct: the algebra map with `Δ (ι i) = ι i ⊗ 1 + 1 ⊗ ι i`. -/
noncomputable def cop : F2 →ₐ[ℚ] F2 ⊗[ℚ] F2 :=
  FreeAlgebra.lift ℚ (fun i => g i ⊗ₜ 1 + 1 ⊗ₜ g i)

/-- `h` is **primitive**: `Δ h = h ⊗ 1 + 1 ⊗ h`. -/
def IsPrimitive (h : F2) : Prop := cop h = h ⊗ₜ 1 + 1 ⊗ₜ h

theorem cop_g_mul (i : Fin 2) (y : F2) : cop (g i * y) = (g i ⊗ₜ 1 + 1 ⊗ₜ g i) * cop y := by
  simp [cop]

theorem cop_one : cop 1 = (1 : F2) ⊗ₜ (1 : F2) := by rw [map_one]; rfl

theorem IsPrimitive.sub {p q : F2} (hp : IsPrimitive p) (hq : IsPrimitive q) :
    IsPrimitive (p - q) := by
  unfold IsPrimitive at *
  rw [map_sub, hp, hq, sub_tmul, tmul_sub]; abel

theorem IsPrimitive.smul {p : F2} (hp : IsPrimitive p) (c : ℚ) : IsPrimitive (c • p) := by
  unfold IsPrimitive at *
  rw [map_smul, hp, smul_add, smul_tmul', tmul_smul]

/-! ### The Euler (degree) derivation -/

/-- The algebra map `p ↦ [[p, D p], [0, p]]` with `D (ι i) = ι i`. -/
noncomputable def triE : F2 →ₐ[ℚ] Matrix (Fin 2) (Fin 2) F2 :=
  FreeAlgebra.lift ℚ (fun i => !![g i, g i; 0, g i])

theorem triE_entries (p : F2) : triE p 0 0 = p ∧ triE p 1 0 = 0 ∧ triE p 1 1 = p := by
  induction p using FreeAlgebra.induction with
  | grade0 r => simp [Matrix.algebraMap_matrix_apply]
  | grade1 i => simp [triE]
  | mul p q hp hq =>
    obtain ⟨p0, p1, p2⟩ := hp
    obtain ⟨q0, q1, q2⟩ := hq
    simp only [map_mul, Matrix.mul_apply, Fin.sum_univ_two, p0, p1, p2, q0, q1, q2]
    simp
  | add p q hp hq =>
    obtain ⟨p0, p1, p2⟩ := hp
    obtain ⟨q0, q1, q2⟩ := hq
    simp [map_add, p0, p1, p2, q0, q1, q2]

/-- The **Euler derivation** `D`: the derivation of `ℚ⟨X, Y⟩` with `D (ι i) = ι i`, so a word of
length `n` is multiplied by `n`. -/
noncomputable def eulerD : F2 →ₗ[ℚ] F2 where
  toFun p := triE p 0 1
  map_add' p q := by simp [map_add]
  map_smul' r p := by simp [map_smul]

theorem eulerD_mul (p q : F2) : eulerD (p * q) = p * eulerD q + eulerD p * q := by
  obtain ⟨p0, -, -⟩ := triE_entries p
  obtain ⟨-, -, q2⟩ := triE_entries q
  simp only [eulerD, LinearMap.coe_mk, AddHom.coe_mk, map_mul, Matrix.mul_apply,
    Fin.sum_univ_two, p0, q2]

theorem eulerD_one : eulerD (1 : F2) = 0 := by
  simp [eulerD]

theorem eulerD_g (i : Fin 2) : eulerD (g i) = g i := by
  simp [eulerD, triE]

theorem eulerD_g_mul (i : Fin 2) (y : F2) : eulerD (g i * y) = g i * y + g i * eulerD y := by
  rw [eulerD_mul, eulerD_g]; abel

/-! ### The antipode -/

/-- The antipode as an algebra map to the opposite algebra: `ι i ↦ -ι i`. -/
noncomputable def antiOp : F2 →ₐ[ℚ] F2ᵐᵒᵖ :=
  FreeAlgebra.lift ℚ (fun i => MulOpposite.op (-g i))

/-- The **antipode** `S`: the anti-automorphism with `S (ι i) = -ι i`. -/
noncomputable def anti : F2 →ₗ[ℚ] F2 :=
  (MulOpposite.opLinearEquiv ℚ).symm.toLinearMap ∘ₗ antiOp.toLinearMap

theorem anti_apply (p : F2) : anti p = MulOpposite.unop (antiOp p) := rfl

theorem anti_one : anti (1 : F2) = 1 := by
  simp [anti_apply]

theorem anti_g_mul (i : Fin 2) (y : F2) : anti (g i * y) = anti y * (-g i) := by
  simp [anti_apply, antiOp]

/-! ### Three identities on `ℚ⟨X, Y⟩ ⊗ ℚ⟨X, Y⟩` -/

/-- `m ∘ (id ⊗ S)`. -/
noncomputable def idS : F2 ⊗[ℚ] F2 →ₗ[ℚ] F2 := LinearMap.mul' ℚ F2 ∘ₗ map LinearMap.id anti

/-- `m ∘ (D ⊗ S)`. -/
noncomputable def dS : F2 ⊗[ℚ] F2 →ₗ[ℚ] F2 := LinearMap.mul' ℚ F2 ∘ₗ map eulerD anti

/-- `D ⊗ id + id ⊗ D`. -/
noncomputable def dTensor : F2 ⊗[ℚ] F2 →ₗ[ℚ] F2 ⊗[ℚ] F2 :=
  map eulerD LinearMap.id + map LinearMap.id eulerD

theorem idS_tmul (a b : F2) : idS (a ⊗ₜ b) = a * anti b := by
  simp [idS]

theorem dS_tmul (a b : F2) : dS (a ⊗ₜ b) = eulerD a * anti b := by
  simp [dS]

theorem dTensor_tmul (a b : F2) : dTensor (a ⊗ₜ b) = eulerD a ⊗ₜ b + a ⊗ₜ eulerD b := by
  simp [dTensor]

theorem idS_cop_g_mul (i : Fin 2) (t : F2 ⊗[ℚ] F2) :
    idS ((g i ⊗ₜ 1 + 1 ⊗ₜ g i) * t) = g i * idS t - idS t * g i := by
  induction t using TensorProduct.induction_on with
  | zero => simp
  | tmul a b =>
    rw [add_mul, Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul,
      one_mul, one_mul, map_add, idS_tmul, idS_tmul, idS_tmul, anti_g_mul]
    noncomm_ring
  | add x y hx hy =>
    rw [mul_add, map_add, hx, hy, map_add]; noncomm_ring

theorem dS_cop_g_mul (i : Fin 2) (t : F2 ⊗[ℚ] F2) :
    dS ((g i ⊗ₜ 1 + 1 ⊗ₜ g i) * t) = g i * idS t + g i * dS t - dS t * g i := by
  induction t using TensorProduct.induction_on with
  | zero => simp
  | tmul a b =>
    rw [add_mul, Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul,
      one_mul, one_mul, map_add, dS_tmul, dS_tmul, dS_tmul, idS_tmul, anti_g_mul, eulerD_g_mul]
    noncomm_ring
  | add x y hx hy =>
    rw [mul_add, map_add, hx, hy, map_add, map_add]; noncomm_ring

theorem dTensor_cop_g_mul (i : Fin 2) (t : F2 ⊗[ℚ] F2) :
    dTensor ((g i ⊗ₜ 1 + 1 ⊗ₜ g i) * t) =
      (g i ⊗ₜ 1 + 1 ⊗ₜ g i) * t + (g i ⊗ₜ 1 + 1 ⊗ₜ g i) * dTensor t := by
  induction t using TensorProduct.induction_on with
  | zero => simp
  | tmul a b =>
    simp only [add_mul, Algebra.TensorProduct.tmul_mul_tmul, one_mul, map_add, dTensor_tmul,
      eulerD_g_mul, mul_add, add_tmul, tmul_add]
    abel
  | add x y hx hy =>
    rw [mul_add, map_add, hx, hy, map_add, mul_add]; abel

/-! ### The antipode identity and the Dynkin map -/

/-- **Antipode identity**: `m (id ⊗ S) Δ = η ε`. -/
theorem idS_cop (w : F2) :
    idS (cop w) = algebraMap ℚ F2 (FreeAlgebra.algebraMapInv w) := by
  induction w using induction_left with
  | h1 => simp [cop_one, idS_tmul, anti_one]
  | hg i y hy =>
    rw [cop_g_mul, idS_cop_g_mul, hy, Algebra.commutes, sub_self, map_mul]
    simp [FreeAlgebra.algebraMapInv]
  | hadd x y hx hy => rw [map_add, map_add, hx, hy, map_add, map_add]
  | hsmul c y hy =>
    rw [map_smul, map_smul, hy, map_smul, smul_eq_mul, map_mul, Algebra.smul_def]

theorem g_mem_lieSpanXY (i : Fin 2) : g i ∈ LieSpanXY := by
  apply LieSubalgebra.subset_lieSpan
  fin_cases i <;> simp

/-- The **Dynkin map** `m (D ⊗ S) Δ` lands in the Lie span of the generators: on a word it is the
right-normed bracket `[x_{i₁}, [x_{i₂}, …, x_{iₙ}]]`. -/
theorem dS_cop_mem (w : F2) : dS (cop w) ∈ LieSpanXY := by
  induction w using induction_left with
  | h1 => simp [cop_one, dS_tmul, eulerD_one]
  | hg i y hy =>
    rw [cop_g_mul, dS_cop_g_mul, idS_cop, ← Algebra.commutes, ← Algebra.smul_def,
      add_sub_assoc, ← Ring.lie_def]
    exact add_mem (LieSubalgebra.smul_mem _ _ (g_mem_lieSpanXY i))
      (LieSubalgebra.lie_mem _ (g_mem_lieSpanXY i) hy)
  | hadd x y hx hy => rw [map_add, map_add]; exact add_mem hx hy
  | hsmul c y hy => rw [map_smul, map_smul]; exact LieSubalgebra.smul_mem _ c hy

theorem eulerD_mem_of_primitive {p : F2} (hp : IsPrimitive p) : eulerD p ∈ LieSpanXY := by
  have h := dS_cop_mem p
  rwa [hp, map_add, dS_tmul, dS_tmul, anti_one, eulerD_one, zero_mul, mul_one, add_zero] at h

/-- `D` is a **coderivation**: `Δ ∘ D = (D ⊗ id + id ⊗ D) ∘ Δ`. -/
theorem cop_eulerD (p : F2) : cop (eulerD p) = dTensor (cop p) := by
  induction p using induction_left with
  | h1 => simp [cop_one, dTensor_tmul, eulerD_one]
  | hg i y hy => rw [eulerD_g_mul, map_add, cop_g_mul, cop_g_mul, hy, dTensor_cop_g_mul]
  | hadd x y hx hy => rw [map_add, map_add, hx, hy, map_add, map_add]
  | hsmul c y hy => rw [map_smul, map_smul, hy, map_smul, map_smul]

theorem IsPrimitive.eulerD {p : F2} (hp : IsPrimitive p) : IsPrimitive (eulerD p) := by
  unfold IsPrimitive at *
  rw [cop_eulerD, hp, map_add, dTensor_tmul, dTensor_tmul, eulerD_one, tmul_zero, zero_tmul]
  abel

/-! ### The word-length filtration -/

/-- The word `x_{i₁} ⋯ x_{iₙ}`. -/
noncomputable def word (l : List (Fin 2)) : F2 := (l.map g).prod

/-- The span of the words of length at most `N`. -/
noncomputable def G (N : ℕ) : Submodule ℚ F2 :=
  Submodule.span ℚ {x | ∃ l : List (Fin 2), l.length ≤ N ∧ word l = x}

theorem word_mem_G {N : ℕ} {l : List (Fin 2)} (hl : l.length ≤ N) : word l ∈ G N :=
  Submodule.subset_span ⟨l, hl, rfl⟩

theorem G_mono {N M : ℕ} (h : N ≤ M) : G N ≤ G M :=
  Submodule.span_mono fun _ ⟨l, hl, e⟩ => ⟨l, hl.trans h, e⟩

theorem eulerD_word (l : List (Fin 2)) : eulerD (word l) = (l.length : ℚ) • word l := by
  induction l with
  | nil => simp [word, eulerD_one]
  | cons i l ih =>
    simp only [word, List.map_cons, List.prod_cons] at ih ⊢
    rw [eulerD_g_mul, ih, mul_smul_comm, List.length_cons, Nat.cast_succ, add_smul, one_smul]
    abel

theorem g_mul_mem_G (i : Fin 2) {N : ℕ} {y : F2} (hy : y ∈ G N) : g i * y ∈ G (N + 1) := by
  induction hy using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨l, hl, rfl⟩ := hx
    exact word_mem_G (l := i :: l) (by simp; omega)
  | zero => simp
  | add x y _ _ hx hy => rw [mul_add]; exact add_mem hx hy
  | smul r x _ hx => rw [mul_smul_comm]; exact Submodule.smul_mem _ r hx

theorem exists_mem_G (x : F2) : ∃ N, x ∈ G N := by
  induction x using induction_left with
  | h1 => exact ⟨0, word_mem_G (l := []) le_rfl⟩
  | hg i y hy => obtain ⟨N, hN⟩ := hy; exact ⟨N + 1, g_mul_mem_G i hN⟩
  | hadd x y hx hy =>
    obtain ⟨N, hN⟩ := hx
    obtain ⟨M, hM⟩ := hy
    exact ⟨max N M, add_mem (G_mono (le_max_left _ _) hN) (G_mono (le_max_right _ _) hM)⟩
  | hsmul c y hy => obtain ⟨N, hN⟩ := hy; exact ⟨N, Submodule.smul_mem _ c hN⟩

/-- `D - (N + 1)` lowers the filtration: it maps `G (N + 1)` into `G N`. -/
theorem eulerD_sub_mem_G {N : ℕ} {p : F2} (hp : p ∈ G (N + 1)) :
    eulerD p - ((N : ℚ) + 1) • p ∈ G N := by
  induction hp using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨l, hl, rfl⟩ := hx
    rw [eulerD_word, ← sub_smul]
    rcases Nat.lt_or_ge l.length (N + 1) with h | h
    · exact Submodule.smul_mem _ _ (word_mem_G (by omega))
    · have : l.length = N + 1 := by omega
      rw [this, Nat.cast_succ, sub_self, zero_smul]; exact zero_mem _
  | zero => simp
  | add x y _ _ hx hy =>
    have e : eulerD (x + y) - ((N : ℚ) + 1) • (x + y) =
        (eulerD x - ((N : ℚ) + 1) • x) + (eulerD y - ((N : ℚ) + 1) • y) := by
      rw [map_add, smul_add]; abel
    rw [e]; exact add_mem hx hy
  | smul r x _ hx =>
    have e : eulerD (r • x) - ((N : ℚ) + 1) • (r • x) = r • (eulerD x - ((N : ℚ) + 1) • x) := by
      rw [map_smul, smul_sub, smul_comm r ((N : ℚ) + 1) x]
    rw [e]; exact Submodule.smul_mem _ r hx

theorem eq_algebraMap_of_mem_G_zero {p : F2} (hp : p ∈ G 0) : ∃ c : ℚ, p = algebraMap ℚ F2 c := by
  induction hp using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨l, hl, rfl⟩ := hx
    rw [List.length_eq_zero_iff.mp (Nat.le_zero.mp hl)]
    exact ⟨1, by simp [word]⟩
  | zero => exact ⟨0, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨a, rfl⟩ := hx
    obtain ⟨b, rfl⟩ := hy
    exact ⟨a + b, by simp⟩
  | smul r x _ hx =>
    obtain ⟨a, rfl⟩ := hx
    exact ⟨r * a, by simp [Algebra.smul_def]⟩

/-- A primitive constant vanishes. -/
theorem eq_zero_of_primitive_algebraMap {c : ℚ} (h : IsPrimitive (algebraMap ℚ F2 c)) :
    algebraMap ℚ F2 c = 0 := by
  have e := congrArg (LinearMap.mul' ℚ F2) h
  rw [AlgHom.commutes, Algebra.TensorProduct.algebraMap_apply, LinearMap.mul'_apply,
    map_add, LinearMap.mul'_apply, LinearMap.mul'_apply, mul_one, one_mul] at e
  simpa using e

/-! ### The Friedrichs criterion -/

theorem mem_lieSpanXY_of_primitive_of_mem_G (N : ℕ) :
    ∀ p ∈ G N, IsPrimitive p → p ∈ LieSpanXY := by
  induction N with
  | zero =>
    intro p hp hprim
    obtain ⟨c, rfl⟩ := eq_algebraMap_of_mem_G_zero hp
    rw [eq_zero_of_primitive_algebraMap hprim]; exact zero_mem _
  | succ N ih =>
    intro p hp hprim
    have hq := ih _ (eulerD_sub_mem_G hp) (hprim.eulerD.sub (hprim.smul _))
    have hD := eulerD_mem_of_primitive hprim
    have hN : ((N : ℚ) + 1) ≠ 0 := by positivity
    have e : p = ((N : ℚ) + 1)⁻¹ • (eulerD p - (eulerD p - ((N : ℚ) + 1) • p)) := by
      rw [sub_sub_cancel, smul_smul, inv_mul_cancel₀ hN, one_smul]
    rw [e]
    exact LieSubalgebra.smul_mem _ _ (sub_mem hD hq)

/-- **Friedrichs criterion** for `ℚ⟨X, Y⟩`: a primitive element of the shuffle coproduct lies in the
Lie subalgebra generated by `X` and `Y`. -/
theorem mem_lieSpanXY_of_primitive {h : F2} (hh : IsPrimitive h) : h ∈ LieSpanXY := by
  obtain ⟨N, hN⟩ := exists_mem_G h
  exact mem_lieSpanXY_of_primitive_of_mem_G N h hN hh

end QOU.BraidsAndKnots.RationalAssociator.Friedrichs

namespace QOU.BraidsAndKnots.RationalAssociator

open Friedrichs

/-- **Friedrichs criterion.** A primitive element of `ℚ⟨X, Y⟩` for the shuffle coproduct
(`Δ (ι i) = ι i ⊗ 1 + 1 ⊗ ι i`) is a Lie element. -/
theorem isLieElt_of_primitive {h : FreeAlgebra ℚ (Fin 2)} (hh : IsPrimitive h) : IsLieElt h :=
  mem_lieSpanXY_of_primitive hh

/-- A primitive element has zero constant term. -/
theorem algebraMapInv_eq_zero_of_primitive {h : FreeAlgebra ℚ (Fin 2)} (hh : IsPrimitive h) :
    FreeAlgebra.algebraMapInv h = 0 :=
  (isLieElt_of_primitive hh).const

end QOU.BraidsAndKnots.RationalAssociator
