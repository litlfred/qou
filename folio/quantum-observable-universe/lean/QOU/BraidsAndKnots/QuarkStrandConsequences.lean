import Mathlib.Algebra.Order.Field.Basic
import Mathlib.Data.ZMod.Basic
import Mathlib.Tactic.Ring
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.Positivity
import Mathlib.Tactic.LinearCombination

/-!
# QOU.SchurWeyl.QuarkStrandConsequences — what "quark = strand" forces

Bean `qou-qs1d` / `qou-qs4c` (epic `qou-qs0e`). Owner, 2026-11-15: *"try quark = strand,
explore downstream implications. what can we prove. does it match physics?"*
Audit: `docs/audits/2026-11-15-quark-equals-strand-implications.md`.

Reading: each strand of a braid word is one quark, carrying an internal space `V`. A
three-quark state lives in `V ⊗ V ⊗ V`; a Young channel `λ` describes the three strands
together. If the quark carries colour, spin and flavour, then `V = A ⊗ B ⊗ ⋯` is a tensor
product of factor spaces.

## Result 1 — a factorised strand space is not a Hecke representation at `q ≠ 1`

On two strands, `V ⊗ V = (A ⊗ A) ⊗ (B ⊗ B)` and the crossing acts factor-wise, `R = R_A ⊗ R_B`.
If each factor satisfies the Hecke relation (eigenvalues `q`, `-q⁻¹`), the product has
eigenvalues `q², -1, q⁻²` (`q · q`, `q · (-q⁻¹)`, `(-q⁻¹)(-q⁻¹)`).

* `tensor_eigenvalue_not_hecke` — `q²` is a Hecke eigenvalue at parameter `q` only if `q = 1` or
  `q³ = -1` (generic field).
* `three_eigenvalues_no_quadratic` — three pairwise distinct numbers are never all roots of one
  monic quadratic, so `R_A ⊗ R_B` satisfies the Hecke relation at **no** parameter.
* `tensor_hecke_eigenvalues_distinct` — for `1 < q` in an ordered field, `q², -1, q⁻²` are
  pairwise distinct.

Consequence: under quark = strand, at most **one** internal factor can carry the `q`-deformed
Hecke braiding of a single word; every other factor must braid classically (`q = 1`) or the
algebra generated by the crossings is strictly larger than `H_n(q)`. At `q = 1` all three
eigenvalues are `±1` and the factorisation is consistent, which is why the classical
quark model (SU(6), `ColourChannelSpinStatistics`) works.

## Result 2 — integer charge ⟺ triality zero (bookkeeping, imported charges)

With the imported Standard-Model charges `3Q = 2, -1` for `u, d` and `-2, 1` for `ū, d̄`,
`charge3_sum_mod_three`: the total `3Q` of any list of strands is `≡ −(n_q − n_q̄) (mod 3)`, so
the total charge is an integer iff `3 ∣ n_q − n_q̄` — the colour `ℤ/3` triality. The charges are
INPUTS (comparison boundary); the content is that, once a quark is one strand, the integrality
of observed charges and the triality of the strand count are the same condition.

## Base ring (§7c)

Results 1a/1b over a generic field; 1c needs an order (`1 < q`). Result 2 over `ℤ` / `ZMod 3`.

LaTeX label: `prop:quark-strand-consequences`
-/

namespace QOU.SchurWeyl.QuarkStrandConsequences

section Generic

variable {K : Type*} [Field K]

/-- The product eigenvalue `q²` is a Hecke eigenvalue at `q` (i.e. `q` or `-q⁻¹`) only if
`q = 1` or `q³ = -1`. -/
theorem tensor_eigenvalue_not_hecke (q : K) (hq : q ≠ 0)
    (h : q ^ 2 = q ∨ q ^ 2 = -q⁻¹) : q = 1 ∨ q ^ 3 = -1 := by
  rcases h with h | h
  · left
    have h' : q * (q - 1) = 0 := by ring_nf; ring_nf at h; linear_combination h
    rcases mul_eq_zero.mp h' with h0 | h1
    · exact absurd h0 hq
    · exact sub_eq_zero.mp h1
  · right
    have : q ^ 3 = q * q ^ 2 := by ring
    rw [this, h, mul_neg, mul_inv_cancel₀ hq]

/-- Three pairwise distinct elements cannot all satisfy one monic quadratic `x² = a x + b`. -/
theorem three_eigenvalues_no_quadratic (e₁ e₂ e₃ a b : K)
    (h₁₂ : e₁ ≠ e₂) (h₁₃ : e₁ ≠ e₃) (h₂₃ : e₂ ≠ e₃)
    (r₁ : e₁ ^ 2 = a * e₁ + b) (r₂ : e₂ ^ 2 = a * e₂ + b) (r₃ : e₃ ^ 2 = a * e₃ + b) :
    False := by
  have k₁₂ : (e₁ - e₂) * (e₁ + e₂ - a) = 0 := by linear_combination r₁ - r₂
  have k₁₃ : (e₁ - e₃) * (e₁ + e₃ - a) = 0 := by linear_combination r₁ - r₃
  have a₁ : e₁ + e₂ - a = 0 :=
    (mul_eq_zero.mp k₁₂).resolve_left (sub_ne_zero.mpr h₁₂)
  have a₂ : e₁ + e₃ - a = 0 :=
    (mul_eq_zero.mp k₁₃).resolve_left (sub_ne_zero.mpr h₁₃)
  exact h₂₃ (by linear_combination a₁ - a₂)

end Generic

section Ordered

variable {K : Type*} [Field K] [LinearOrder K] [IsStrictOrderedRing K]

/-- For `1 < q`, the three eigenvalues `q², -1, q⁻²` of `R_A ⊗ R_B` are pairwise distinct. -/
theorem tensor_hecke_eigenvalues_distinct (q : K) (hq : 1 < q) :
    q ^ 2 ≠ -1 ∧ q ^ 2 ≠ (q⁻¹) ^ 2 ∧ (-1 : K) ≠ (q⁻¹) ^ 2 := by
  have hq0 : 0 < q := lt_trans zero_lt_one hq
  refine ⟨?_, ?_, ?_⟩
  · have : 0 < q ^ 2 := by positivity
    intro h; linarith
  · intro h
    have hi : q⁻¹ < 1 := inv_lt_one_of_one_lt₀ hq
    have hi0 : 0 < q⁻¹ := inv_pos.mpr hq0
    have : (q⁻¹) ^ 2 < 1 := by nlinarith
    have : 1 < q ^ 2 := by nlinarith
    linarith
  · have : 0 < (q⁻¹) ^ 2 := by positivity
    intro h; linarith

/-- **The factor-wise crossing on a two-factor strand space obeys no Hecke relation for
`1 < q`**: no `a, b` make all three eigenvalues `q², -1, q⁻²` roots of `x² = a x + b`. -/
theorem tensor_crossing_not_hecke (q : K) (hq : 1 < q) (a b : K)
    (r₁ : (q ^ 2) ^ 2 = a * q ^ 2 + b) (r₂ : (-1 : K) ^ 2 = a * (-1) + b)
    (r₃ : ((q⁻¹) ^ 2) ^ 2 = a * (q⁻¹) ^ 2 + b) : False := by
  obtain ⟨h₁₂, h₁₃, h₂₃⟩ := tensor_hecke_eigenvalues_distinct q hq
  exact three_eigenvalues_no_quadratic _ _ _ a b h₁₂ h₁₃ h₂₃ r₁ r₂ r₃

end Ordered

/-! ### Result 2: integer charge and triality -/

/-- Strand labels: two flavours of quark and their antiquarks. -/
inductive Strand
  | u | d | ubar | dbar
  deriving DecidableEq, Repr

open Strand

/-- Three times the electric charge (imported SM values). -/
def charge3 : Strand → ℤ
  | u => 2 | d => -1 | ubar => -2 | dbar => 1

/-- `+1` for a quark strand, `-1` for an antiquark strand. -/
def quarkNumber : Strand → ℤ
  | u => 1 | d => 1 | ubar => -1 | dbar => -1

theorem charge3_mod_three (s : Strand) :
    ((charge3 s : ℤ) : ZMod 3) = -((quarkNumber s : ℤ) : ZMod 3) := by
  cases s <;> decide

/-- Total `3Q ≡ −(n_q − n_q̄) (mod 3)` for any list of strands. -/
theorem charge3_sum_mod_three (l : List Strand) :
    (((l.map charge3).sum : ℤ) : ZMod 3) = -(((l.map quarkNumber).sum : ℤ) : ZMod 3) := by
  induction l with
  | nil => simp
  | cons s l ih =>
    simp only [List.map_cons, List.sum_cons, Int.cast_add, ih, charge3_mod_three]
    ring

/-- **Integer total charge ⟺ zero triality**: `3 ∣ 3Q` iff `3 ∣ n_q − n_q̄`. -/
theorem integer_charge_iff_triality (l : List Strand) :
    (3 : ℤ) ∣ (l.map charge3).sum ↔ (3 : ℤ) ∣ (l.map quarkNumber).sum := by
  rw [show (3 : ℤ) = ((3 : ℕ) : ℤ) from rfl, ← ZMod.intCast_zmod_eq_zero_iff_dvd,
    ← ZMod.intCast_zmod_eq_zero_iff_dvd, charge3_sum_mod_three, neg_eq_zero]

/-- Example: the proton `uud` has charge `1`, the `Δ⁺⁺` `uuu` charge `2`, the `Δ⁻` `ddd`
charge `-1`, and a single `u` is fractional. -/
example : ([u, u, d].map charge3).sum = 3 ∧ ([u, u, u].map charge3).sum = 6 ∧
    ([d, d, d].map charge3).sum = -3 ∧ ¬ (3 : ℤ) ∣ ([u].map charge3).sum := by decide

end QOU.SchurWeyl.QuarkStrandConsequences
