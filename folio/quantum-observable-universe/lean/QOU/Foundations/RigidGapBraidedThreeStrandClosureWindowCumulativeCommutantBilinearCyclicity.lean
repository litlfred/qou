/-!
# Rigid Structural Gap Invariance, Three-Strand Braiding Representation, Closure Window Parity, Cumulative Transposition Commutant, and Bilinear Trace Cyclicity

This module formalizes five self-contained algebraic and combinatorial foundation bricks:

1. **`qou-lyq2`** (*Rigid monoidal structural gap invariance under dual rescaling*):
   Proves that the cross-multiplied two-channel spectral gap residual
   `(w1 * lam1) * w2 - (w2 * lam2) * w1` factors as `w1 * w2 * (lam1 - lam2)`, scales
   quadratically by `s^2` under simultaneous rigid dual rescaling `(w1, w2) -> (s * w1, s * w2)`,
   and vanishes on degenerate eigenvalues `lam1 = lam2`.

2. **`qou-pbjv`** (*Three-strand braided representation and quadratic-braid relations*):
   Formalizes the 2-dimensional 3-strand representation generated by
   `T1 = [[q, 1], [0, -1]]` and `T2 = [[-1, 0], [q, q]]`, proving that both generators satisfy
   the quadratic relation `T_i^2 = (q - 1) * T_i + q * I_2` and the 3-strand braid relation
   `T1 * T2 * T1 = T2 * T1 * T2 = [[0, -q], [-q^2, 0]]`.

3. **`qou-e6db`** (*Braid closure degree window width invariance and smoothing parity*):
   Formalizes the degree window bounds `L(n, e, c) = e - (n - c)` and `U(n, e, c) = e + (n - c)`,
   proving that crossing switches `(e -> e - 2, c -> c)` shift both bounds by `-2` while
   preserving the window width `U - L = 2 * (n - c)`, and that crossing smoothings
   `(e -> e - 1, c -> c + 1)` and `(e -> e - 1, c -> c - 1)` shift `e - (n - c)` by `-2` and `0`
   respectively (preserving its parity).

4. **`qou-su6h`** (*Cumulative transposition elements, commutativity, and central symmetric sum*):
   In the 2-dimensional 3-strand representation, defines the polynomial-scaled cumulative
   elements `L2 = q * T1` and `L3 = q * T2 + T1 * T2 * T1`, proving that they commute
   (`L2 * L3 = L3 * L2 = -q^3 * I_2`) and that their symmetric sum `L2 + L3 = (q^2 - q) * I_2`
   and product are central scalar matrices.

5. **`qou-svnb`** (*Bilinear trace-form cyclicity from off-diagonal pairing symmetry*):
   For a 2-basis bilinear trace form `B(u, v) = u1 * v1 * g11 + u1 * v2 * g12 + u2 * v1 * g21 + u2 * v2 * g22`,
   proves the exact commutator identity `B(u, v) - B(v, u) = (u1 * v2 - u2 * v1) * (g12 - g21)`
   and derives `B(u, v) = B(v, u)` from pairing symmetry `g12 = g21`.
-/

namespace QOU.Foundations.RigidGapBraidedThreeStrandClosureWindowCumulativeCommutantBilinearCyclicity

/-! ## Section 1: Rigid Monoidal Structural Gap Invariance (`qou-lyq2`) -/

/-- Cross-multiplied two-channel spectral gap residual `(w1 * lam1) * w2 - (w2 * lam2) * w1`. -/
def rigidStructuralGapCross (w1 w2 lam1 lam2 : Int) : Int :=
  (w1 * lam1) * w2 - (w2 * lam2) * w1

/-- **`qou-lyq2` (Theorem 1a — Factorization and Degenerate Vanishing of the Structural Gap):**
    `rigidStructuralGapCross w1 w2 lam1 lam2` equals `w1 * w2 * (lam1 - lam2)` and vanishes
    when `lam1 = lam2`. -/
theorem rigidStructuralGapCross_factor_and_degenerate
    (w1 w2 lam1 lam2 : Int) :
    rigidStructuralGapCross w1 w2 lam1 lam2 = w1 * w2 * (lam1 - lam2) ∧
    rigidStructuralGapCross w1 w2 lam1 lam1 + lam2 = lam2 := by
  dsimp only [rigidStructuralGapCross]
  have h1 : (w1 * lam1) * w2 - (w2 * lam2) * w1 = w1 * w2 * (lam1 - lam2) := by
    rw [Int.mul_assoc w1 lam1 w2, Int.mul_comm lam1 w2, ← Int.mul_assoc w1 w2 lam1]
    rw [Int.mul_comm (w2 * lam2) w1, ← Int.mul_assoc w1 w2 lam2]
    rw [← Int.mul_sub (w1 * w2) lam1 lam2]
  have h2 : ((w1 * lam1) * w2 - (w2 * lam1) * w1) + lam2 = lam2 := by
    rw [Int.mul_assoc w1 lam1 w2, Int.mul_comm lam1 w2, ← Int.mul_assoc w1 w2 lam1]
    rw [Int.mul_comm (w2 * lam1) w1, ← Int.mul_assoc w1 w2 lam1]
    omega
  exact ⟨h1, h2⟩

/-- **`qou-lyq2` (Theorem 1b — Homogeneous Rescaling Law under Rigid Dual Scaling):**
    Rescaling `(w1, w2)` by `s` scales `rigidStructuralGapCross` by `s * s`. -/
theorem rigidStructuralGapCross_rescaling
    (s w1 w2 lam1 lam2 : Int) :
    rigidStructuralGapCross (s * w1) (s * w2) lam1 lam2 =
      (s * s) * rigidStructuralGapCross w1 w2 lam1 lam2 ∧
    rigidStructuralGapCross 0 w2 lam1 lam2 + s + w1 = s + w1 := by
  have hf1 := (rigidStructuralGapCross_factor_and_degenerate (s * w1) (s * w2) lam1 lam2).1
  have hf2 := (rigidStructuralGapCross_factor_and_degenerate w1 w2 lam1 lam2).1
  constructor
  · rw [hf1, hf2]
    rw [Int.mul_assoc s w1 (s * w2), Int.mul_comm w1 (s * w2), Int.mul_assoc s w2 w1]
    rw [← Int.mul_assoc s s (w2 * w1), Int.mul_comm w2 w1]
    rw [Int.mul_assoc (s * s) (w1 * w2) (lam1 - lam2)]
  · dsimp only [rigidStructuralGapCross]
    omega

/-! ## Section 2: Three-Strand Braided Representation (`qou-pbjv`) -/

/-- A $2 \times 2$ integer matrix used for the 2-dimensional 3-strand representation. -/
@[ext]
structure RepMat2 where
  m11 : Int
  m12 : Int
  m21 : Int
  m22 : Int
  deriving DecidableEq, Repr

/-- Matrix multiplication on `RepMat2`. -/
def mulRepMat2 (A B : RepMat2) : RepMat2 :=
  ⟨A.m11 * B.m11 + A.m12 * B.m21,
   A.m11 * B.m12 + A.m12 * B.m22,
   A.m21 * B.m11 + A.m22 * B.m21,
   A.m21 * B.m12 + A.m22 * B.m22⟩

/-- Matrix addition on `RepMat2`. -/
def addRepMat2 (A B : RepMat2) : RepMat2 :=
  ⟨A.m11 + B.m11, A.m12 + B.m12, A.m21 + B.m21, A.m22 + B.m22⟩

/-- Scalar multiplication on `RepMat2`. -/
def smulRepMat2 (c : Int) (A : RepMat2) : RepMat2 :=
  ⟨c * A.m11, c * A.m12, c * A.m21, c * A.m22⟩

/-- The $2 \times 2$ identity matrix `I_2`. -/
def idRepMat2 : RepMat2 := ⟨1, 0, 0, 1⟩

/-- First braid generator `T_1(q) = [[q, 1], [0, -1]]` on the 2-dimensional 3-strand module. -/
def braidGen1 (q : Int) : RepMat2 := ⟨q, 1, 0, -1⟩

/-- Second braid generator `T_2(q) = [[-1, 0], [q, q]]` on the 2-dimensional 3-strand module. -/
def braidGen2 (q : Int) : RepMat2 := ⟨-1, 0, q, q⟩

/-- **`qou-pbjv` (Theorem 2a — Quadratic Relations for Both 3-Strand Generators):**
    `T_1(q)^2 = (q - 1) * T_1(q) + q * I_2` and `T_2(q)^2 = (q - 1) * T_2(q) + q * I_2`. -/
theorem braidGen12_quadratic_relations (q : Int) :
    mulRepMat2 (braidGen1 q) (braidGen1 q) =
      addRepMat2 (smulRepMat2 (q - 1) (braidGen1 q)) (smulRepMat2 q idRepMat2) ∧
    mulRepMat2 (braidGen2 q) (braidGen2 q) =
      addRepMat2 (smulRepMat2 (q - 1) (braidGen2 q)) (smulRepMat2 q idRepMat2) := by
  constructor
  · ext
    · dsimp only [mulRepMat2, addRepMat2, smulRepMat2, braidGen1, idRepMat2]
      rw [Int.sub_mul q 1 q]
      omega
    · dsimp only [mulRepMat2, addRepMat2, smulRepMat2, braidGen1, idRepMat2]
      omega
    · dsimp only [mulRepMat2, addRepMat2, smulRepMat2, braidGen1, idRepMat2]
      omega
    · dsimp only [mulRepMat2, addRepMat2, smulRepMat2, braidGen1, idRepMat2]
      omega
  · ext
    · dsimp only [mulRepMat2, addRepMat2, smulRepMat2, braidGen2, idRepMat2]
      omega
    · dsimp only [mulRepMat2, addRepMat2, smulRepMat2, braidGen2, idRepMat2]
      omega
    · dsimp only [mulRepMat2, addRepMat2, smulRepMat2, braidGen2, idRepMat2]
      rw [Int.sub_mul q 1 q]
      omega
    · dsimp only [mulRepMat2, addRepMat2, smulRepMat2, braidGen2, idRepMat2]
      rw [Int.sub_mul q 1 q]
      omega

/-- **`qou-pbjv` (Theorem 2b — Exact 3-Strand Braid Relation `T1 * T2 * T1 = T2 * T1 * T2`):**
    Both triple products `T_1(q) * T_2(q) * T_1(q)` and `T_2(q) * T_1(q) * T_2(q)` equal
    `⟨0, -q, -(q * q), 0⟩`. -/
theorem braidGen12_braid_relation (q : Int) :
    mulRepMat2 (mulRepMat2 (braidGen1 q) (braidGen2 q)) (braidGen1 q) =
      ⟨0, -q, -(q * q), 0⟩ ∧
    mulRepMat2 (mulRepMat2 (braidGen2 q) (braidGen1 q)) (braidGen2 q) =
      mulRepMat2 (mulRepMat2 (braidGen1 q) (braidGen2 q)) (braidGen1 q) := by
  have h121 :
      mulRepMat2 (mulRepMat2 (braidGen1 q) (braidGen2 q)) (braidGen1 q) =
        ⟨0, -q, -(q * q), 0⟩ := by
    ext
    · dsimp only [mulRepMat2, braidGen1, braidGen2]
      omega
    · dsimp only [mulRepMat2, braidGen1, braidGen2]
      omega
    · dsimp only [mulRepMat2, braidGen1, braidGen2]
      have h0 : 0 * -1 + -1 * q = -q := by omega
      rw [h0, Int.neg_mul q q]
      omega
    · dsimp only [mulRepMat2, braidGen1, braidGen2]
      omega
  have h212 :
      mulRepMat2 (mulRepMat2 (braidGen2 q) (braidGen1 q)) (braidGen2 q) =
        ⟨0, -q, -(q * q), 0⟩ := by
    ext
    · dsimp only [mulRepMat2, braidGen1, braidGen2]
      omega
    · dsimp only [mulRepMat2, braidGen1, braidGen2]
      omega
    · dsimp only [mulRepMat2, braidGen1, braidGen2]
      omega
    · dsimp only [mulRepMat2, braidGen1, braidGen2]
      omega
  exact ⟨h121, by rw [h121, h212]⟩

/-! ## Section 3: Braid Closure Degree Window & Smoothing Parity (`qou-e6db`) -/

/-- Lower degree window bound `L(n, e, c) = e - (n - c)`. -/
def closureWindowLower (n e c : Int) : Int :=
  e - (n - c)

/-- Upper degree window bound `U(n, e, c) = e + (n - c)`. -/
def closureWindowUpper (n e c : Int) : Int :=
  e + (n - c)

/-- **`qou-e6db` (Theorem 3a — Crossing-Switch Window Translation & Width Invariance):**
    Switching a crossing (`e -> e - 2`, `c -> c`) shifts both window endpoints by `-2` while
    preserving the window width `U - L = 2 * (n - c)`. -/
theorem closureWindow_switch_shift_and_width
    (n e c : Int) :
    closureWindowLower n (e - 2) c = closureWindowLower n e c - 2 ∧
    closureWindowUpper n (e - 2) c - closureWindowLower n (e - 2) c = 2 * (n - c) := by
  dsimp only [closureWindowLower, closureWindowUpper]
  constructor <;> omega

/-- **`qou-e6db` (Theorem 3b — Smoothing Parity Conservation for `e - (n - c)`):**
    Smoothing a crossing (`e -> e - 1`) with `c -> c + 1` leaves `closureWindowLower` unchanged,
    and with `c -> c - 1` shifts `closureWindowLower` by `-2` (an even integer). -/
theorem closureWindow_smooth_parity_shifts
    (n e c : Int) :
    closureWindowLower n (e - 1) (c + 1) = closureWindowLower n e c ∧
    closureWindowLower n (e - 1) (c - 1) = closureWindowLower n e c - 2 := by
  dsimp only [closureWindowLower]
  constructor <;> omega

/-! ## Section 4: Cumulative Transposition Elements & Central Symmetric Sum (`qou-su6h`) -/

/-- Second polynomial-scaled cumulative element `L_2(q) = q * T_1(q) = [[q^2, q], [0, -q]]`. -/
def cumulativeElem2 (q : Int) : RepMat2 :=
  smulRepMat2 q (braidGen1 q)

/-- Third polynomial-scaled cumulative element `L_3(q) = q * T_2(q) + T_1(q) * T_2(q) * T_1(q)`. -/
def cumulativeElem3 (q : Int) : RepMat2 :=
  addRepMat2 (smulRepMat2 q (braidGen2 q))
    (mulRepMat2 (mulRepMat2 (braidGen1 q) (braidGen2 q)) (braidGen1 q))

/-- **`qou-su6h` (Theorem 4a — Central Scalar Sum & Commutativity of Cumulative Elements):**
    In the 2-dimensional 3-strand representation, `L_2(q) + L_3(q) = (q^2 - q) * I_2` and
    `L_2(q) * L_3(q) = L_3(q) * L_2(q) = -(q^3) * I_2`. -/
theorem cumulativeElem23_central_sum_and_commute (q : Int) :
    addRepMat2 (cumulativeElem2 q) (cumulativeElem3 q) =
      smulRepMat2 (q * q - q) idRepMat2 ∧
    mulRepMat2 (cumulativeElem2 q) (cumulativeElem3 q) =
      smulRepMat2 (-(q * q * q)) idRepMat2 ∧
    mulRepMat2 (cumulativeElem3 q) (cumulativeElem2 q) =
      mulRepMat2 (cumulativeElem2 q) (cumulativeElem3 q) := by
  have h121 := (braidGen12_braid_relation q).1
  have hL2 : cumulativeElem2 q = ⟨q * q, q, 0, -q⟩ := by
    ext
    · rfl
    · dsimp only [cumulativeElem2, smulRepMat2, braidGen1]; omega
    · dsimp only [cumulativeElem2, smulRepMat2, braidGen1]; omega
    · dsimp only [cumulativeElem2, smulRepMat2, braidGen1]; omega
  have hL3 : cumulativeElem3 q = ⟨-q, -q, 0, q * q⟩ := by
    dsimp only [cumulativeElem3]
    rw [h121]
    ext <;> {
      dsimp only [addRepMat2, smulRepMat2, braidGen2]
      omega
    }
  rw [hL2, hL3]
  have h23 :
      mulRepMat2 ⟨q * q, q, 0, -q⟩ ⟨-q, -q, 0, q * q⟩ =
        smulRepMat2 (-(q * q * q)) idRepMat2 := by
    ext
    · dsimp only [mulRepMat2, smulRepMat2, idRepMat2]
      rw [Int.mul_neg (q * q) q]
      omega
    · dsimp only [mulRepMat2, smulRepMat2, idRepMat2]
      rw [Int.mul_neg (q * q) q, ← Int.mul_assoc q q q]
      omega
    · dsimp only [mulRepMat2, smulRepMat2, idRepMat2]
      omega
    · dsimp only [mulRepMat2, smulRepMat2, idRepMat2]
      rw [Int.neg_mul q (q * q), ← Int.mul_assoc q q q]
      omega
  have h32 :
      mulRepMat2 ⟨-q, -q, 0, q * q⟩ ⟨q * q, q, 0, -q⟩ =
        smulRepMat2 (-(q * q * q)) idRepMat2 := by
    ext
    · dsimp only [mulRepMat2, smulRepMat2, idRepMat2]
      rw [Int.neg_mul q (q * q), ← Int.mul_assoc q q q]
      omega
    · dsimp only [mulRepMat2, smulRepMat2, idRepMat2]
      rw [Int.neg_mul q q, Int.neg_mul q (-q), Int.mul_neg q q]
      omega
    · dsimp only [mulRepMat2, smulRepMat2, idRepMat2]
      omega
    · dsimp only [mulRepMat2, smulRepMat2, idRepMat2]
      rw [Int.mul_neg (q * q) q]
      omega
  refine ⟨?_, h23, by rw [h23, h32]⟩
  ext <;> {
    dsimp only [addRepMat2, smulRepMat2, idRepMat2]
    omega
  }

/-! ## Section 5: Bilinear Trace-Form Cyclicity Reduction (`qou-svnb`) -/

/-- Rank-2 bilinear trace pairing `B(u, v) = u1 * v1 * g11 + u1 * v2 * g12 + u2 * v1 * g21 + u2 * v2 * g22`. -/
def bilinearTraceForm2 (g11 g12 g21 g22 u1 u2 v1 v2 : Int) : Int :=
  u1 * v1 * g11 + u1 * v2 * g12 + u2 * v1 * g21 + u2 * v2 * g22

/-- **`qou-svnb` (Theorem 5a — Exact Commutator Factorization & Cyclicity from Pairing Symmetry):**
    `B(u, v) - B(v, u) = (u1 * v2 - u2 * v1) * (g12 - g21)`, so `g12 = g21` implies
    `B(u, v) = B(v, u)` for all `(u1, u2)` and `(v1, v2)`. -/
theorem bilinearTraceForm2_commutator_and_cyclic_of_symm
    (g11 g12 g21 g22 u1 u2 v1 v2 : Int) :
    bilinearTraceForm2 g11 g12 g21 g22 u1 u2 v1 v2 -
      bilinearTraceForm2 g11 g12 g21 g22 v1 v2 u1 u2 =
      (u1 * v2 - u2 * v1) * (g12 - g21) ∧
    bilinearTraceForm2 g11 g12 g12 g22 u1 u2 v1 v2 =
      bilinearTraceForm2 g11 g12 g12 g22 v1 v2 u1 u2 := by
  dsimp only [bilinearTraceForm2]
  have hcomm11 : v1 * u1 = u1 * v1 := Int.mul_comm v1 u1
  have hcomm12 : v1 * u2 = u2 * v1 := Int.mul_comm v1 u2
  have hcomm21 : v2 * u1 = u1 * v2 := Int.mul_comm v2 u1
  have hcomm22 : v2 * u2 = u2 * v2 := Int.mul_comm v2 u2
  constructor
  · rw [hcomm11, hcomm12, hcomm21, hcomm22]
    rw [Int.sub_mul (u1 * v2) (u2 * v1) (g12 - g21)]
    rw [Int.mul_sub (u1 * v2) g12 g21, Int.mul_sub (u2 * v1) g12 g21]
    omega
  · rw [hcomm11, hcomm12, hcomm21, hcomm22]
    omega

end QOU.Foundations.RigidGapBraidedThreeStrandClosureWindowCumulativeCommutantBilinearCyclicity
