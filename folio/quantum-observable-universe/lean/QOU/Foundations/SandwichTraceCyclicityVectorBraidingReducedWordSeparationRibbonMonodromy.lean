/-!
# Sandwich Trace Cyclicity, Vector Braiding Block, Reduced-Word Coordinate Separation, Character Separation, and Ribbon Monodromy

This module formalizes five self-contained algebraic foundation bricks in the `qou-59vq` / `qou-rtxm` lane:

1. **`qou-sx5r`** (*Two-generator sandwich reduction and trace cyclicity*):
   In the 2-dimensional 3-strand representation generated by `f = [[q, 1], [0, -1]]` and
   `g = [[-1, 0], [q, q]]`, proves that `tr(f * g) = tr(g * f) = -q`,
   `tr(g * f * g) = tr(f * g * f) = 0`, the quadratic reduction `g^2 = (q - 1) * g + q * I_2`,
   and the sandwich braid identity `g * f * g = f * g * f`.

2. **`qou-slck`** (*Vector representation mixed-weight braiding block, trace, and determinant*):
   For the $2 \times 2$ mixed-weight braiding block `R_mix(q) = [[q - 1, q], [1, 0]]`, proves
   that `tr(R_mix(q)) = q - 1`, `det(R_mix(q)) = -q`, and the quadratic characteristic identity
   `R_mix(q)^2 = (q - 1) * R_mix(q) + q * I_2`.

3. **`qou-dgsw`** (*Reduced-word coordinate extraction and linear independence*):
   For the 3-generator linear combination `W(q, c0, c1, c2) = c0 * I_2 + c1 * f + c2 * g`,
   proves the exact entrywise recovery formulas `m12 = c1`, `m21 = q * c2`, and
   `m11 - q * m12 + c2 = c0`, and shows that vanishing of `W(1, c0, c1, c2)` forces
   `c0 = 0 ∧ c1 = 0 ∧ c2 = 0`.

4. **`qou-jfr8`** (*Pairwise character separation and degree-squared sum for 3-strand blocks*):
   For the three 3-strand block characters evaluated at a single generator — trivial `q`,
   2-dimensional standard `q - 1`, and sign `-1` — proves the exact separation identities
   `chiTriv - chiStd = 1`, `chiStd - chiSign = q`, `chiTriv - chiSign = q + 1`, and the
   total degree-squared sum `1 * 1 + 2 * 2 + 1 * 1 = 6`.

5. **`qou-zoyv`** (*Double-braiding ribbon monodromy and quadratic trace invariant*):
   For the double-braiding monodromy `M(q) = R_mix(q)^2`, proves the linear-quadratic ribbon
   relation `M(q) = (q - 1) * R_mix(q) + q * I_2` and shows that the monodromy trace equals
   `q^2 + 1`.
-/

namespace QOU.Foundations.SandwichTraceCyclicityVectorBraidingReducedWordSeparationRibbonMonodromy

/-- A $2 \times 2$ integer matrix representing an endomorphism on a 2-dimensional block. -/
@[ext]
structure BlockMat2 where
  m11 : Int
  m12 : Int
  m21 : Int
  m22 : Int
  deriving DecidableEq, Repr

/-- Matrix multiplication on `BlockMat2`. -/
def mulBlockMat2 (A B : BlockMat2) : BlockMat2 :=
  ⟨A.m11 * B.m11 + A.m12 * B.m21,
   A.m11 * B.m12 + A.m12 * B.m22,
   A.m21 * B.m11 + A.m22 * B.m21,
   A.m21 * B.m12 + A.m22 * B.m22⟩

/-- Matrix addition on `BlockMat2`. -/
def addBlockMat2 (A B : BlockMat2) : BlockMat2 :=
  ⟨A.m11 + B.m11, A.m12 + B.m12, A.m21 + B.m21, A.m22 + B.m22⟩

/-- Scalar multiplication on `BlockMat2`. -/
def smulBlockMat2 (c : Int) (A : BlockMat2) : BlockMat2 :=
  ⟨c * A.m11, c * A.m12, c * A.m21, c * A.m22⟩

/-- Matrix trace `m11 + m22` on `BlockMat2`. -/
def trBlockMat2 (A : BlockMat2) : Int :=
  A.m11 + A.m22

/-- Matrix determinant `m11 * m22 - m12 * m21` on `BlockMat2`. -/
def detBlockMat2 (A : BlockMat2) : Int :=
  A.m11 * A.m22 - A.m12 * A.m21

/-- The $2 \times 2$ identity matrix `I_2`. -/
def idBlockMat2 : BlockMat2 := ⟨1, 0, 0, 1⟩

/-- First 3-strand generator `f(q) = [[q, 1], [0, -1]]`. -/
def genF (q : Int) : BlockMat2 := ⟨q, 1, 0, -1⟩

/-- Second 3-strand generator `g(q) = [[-1, 0], [q, q]]`. -/
def genG (q : Int) : BlockMat2 := ⟨-1, 0, q, q⟩

/-! ## Section 1: Two-Generator Sandwich Reduction & Trace Cyclicity (`qou-sx5r`) -/

/-- **`qou-sx5r` (Theorem 1a — Single- and Double-Generator Trace Cyclicity):**
    `tr(f(q) * g(q)) = tr(g(q) * f(q)) = -q` and
    `tr(g(q) * f(q) * g(q)) = tr(f(q) * g(q) * f(q)) = 0`. -/
theorem genFG_trace_cyclicity_and_zero (q : Int) :
    trBlockMat2 (mulBlockMat2 (genF q) (genG q)) = -q ∧
    trBlockMat2 (mulBlockMat2 (genG q) (genF q)) = -q ∧
    trBlockMat2 (mulBlockMat2 (mulBlockMat2 (genG q) (genF q)) (genG q)) + q = q ∧
    trBlockMat2 (mulBlockMat2 (mulBlockMat2 (genF q) (genG q)) (genF q)) + q = q := by
  dsimp only [trBlockMat2, mulBlockMat2, genF, genG]
  refine ⟨?_, ?_, ?_, ?_⟩ <;> omega

/-- **`qou-sx5r` (Theorem 1b — Two-Generator Quadratic & Sandwich Reduction):**
    The second generator satisfies `g(q)^2 = (q - 1) * g(q) + q * I_2` and the sandwich
    braid identity `g(q) * f(q) * g(q) = f(q) * g(q) * f(q)`. -/
theorem genG_sandwich_coset_reduction (q : Int) :
    mulBlockMat2 (genG q) (genG q) =
      addBlockMat2 (smulBlockMat2 (q - 1) (genG q)) (smulBlockMat2 q idBlockMat2) ∧
    mulBlockMat2 (mulBlockMat2 (genG q) (genF q)) (genG q) =
      mulBlockMat2 (mulBlockMat2 (genF q) (genG q)) (genF q) := by
  constructor
  · ext
    · dsimp only [mulBlockMat2, addBlockMat2, smulBlockMat2, genG, idBlockMat2]
      omega
    · dsimp only [mulBlockMat2, addBlockMat2, smulBlockMat2, genG, idBlockMat2]
      omega
    · dsimp only [mulBlockMat2, addBlockMat2, smulBlockMat2, genG, idBlockMat2]
      rw [Int.sub_mul q 1 q]
      omega
    · dsimp only [mulBlockMat2, addBlockMat2, smulBlockMat2, genG, idBlockMat2]
      rw [Int.sub_mul q 1 q]
      omega
  · ext
    · dsimp only [mulBlockMat2, genF, genG]
      omega
    · dsimp only [mulBlockMat2, genF, genG]
      omega
    · dsimp only [mulBlockMat2, genF, genG]
      have h0 : 0 * -1 + -1 * q = -q := by omega
      rw [h0, Int.neg_mul q q]
      omega
    · dsimp only [mulBlockMat2, genF, genG]
      omega

/-! ## Section 2: Vector Representation Mixed-Weight Braiding Block (`qou-slck`) -/

/-- Mixed-weight $2 \times 2$ braiding matrix `R_mix(q) = [[q - 1, q], [1, 0]]`. -/
def vectorBraidingMix (q : Int) : BlockMat2 := ⟨q - 1, q, 1, 0⟩

/-- **`qou-slck` (Theorem 2a — Trace, Determinant, and Quadratic Relation of `R_mix(q)`):**
    `tr(R_mix(q)) = q - 1`, `det(R_mix(q)) = -q`, and
    `R_mix(q)^2 = (q - 1) * R_mix(q) + q * I_2`. -/
theorem vectorBraidingMix_trace_det_and_quadratic (q : Int) :
    trBlockMat2 (vectorBraidingMix q) = q - 1 ∧
    detBlockMat2 (vectorBraidingMix q) = -q ∧
    mulBlockMat2 (vectorBraidingMix q) (vectorBraidingMix q) =
      addBlockMat2 (smulBlockMat2 (q - 1) (vectorBraidingMix q)) (smulBlockMat2 q idBlockMat2) := by
  refine ⟨?_, ?_, ?_⟩
  · dsimp only [trBlockMat2, vectorBraidingMix]
    omega
  · dsimp only [detBlockMat2, vectorBraidingMix]
    omega
  · ext
    · dsimp only [mulBlockMat2, addBlockMat2, smulBlockMat2, vectorBraidingMix, idBlockMat2]
    · dsimp only [mulBlockMat2, addBlockMat2, smulBlockMat2, vectorBraidingMix, idBlockMat2]
    · dsimp only [mulBlockMat2, addBlockMat2, smulBlockMat2, vectorBraidingMix, idBlockMat2]
      omega
    · dsimp only [mulBlockMat2, addBlockMat2, smulBlockMat2, vectorBraidingMix, idBlockMat2]
      omega

/-! ## Section 3: Reduced-Word Coordinate Extraction & Linear Independence (`qou-dgsw`) -/

/-- Linear combination `c0 * I_2 + c1 * f(q) + c2 * g(q)` of the three reduced words `(I_2, f, g)`. -/
def reducedWordCombo3 (q c0 c1 c2 : Int) : BlockMat2 :=
  addBlockMat2 (addBlockMat2 (smulBlockMat2 c0 idBlockMat2) (smulBlockMat2 c1 (genF q)))
    (smulBlockMat2 c2 (genG q))

/-- **`qou-dgsw` (Theorem 3a — Exact Entrywise Coordinate Extraction & Independence at `q != 0`):**
    From `W = reducedWordCombo3 q c0 c1 c2`, the coefficients satisfy `W.m12 = c1`,
    `W.m21 = q * c2`, and `W.m11 - q * W.m12 + c2 = c0`. -/
theorem reducedWordCombo3_coordinate_recovery (q c0 c1 c2 : Int) :
    (reducedWordCombo3 q c0 c1 c2).m12 = c1 ∧
    (reducedWordCombo3 q c0 c1 c2).m21 = q * c2 ∧
    (reducedWordCombo3 q c0 c1 c2).m11 - q * (reducedWordCombo3 q c0 c1 c2).m12 + c2 = c0 := by
  dsimp only [reducedWordCombo3, addBlockMat2, smulBlockMat2, idBlockMat2, genF, genG]
  refine ⟨?_, ?_, ?_⟩
  · omega
  · rw [Int.mul_comm c2 q]
    omega
  · have hq : q * (c0 * 0 + c1 * 1 + c2 * 0) = c1 * q := by
      have hc1 : c0 * 0 + c1 * 1 + c2 * 0 = c1 := by omega
      rw [hc1, Int.mul_comm q c1]
    rw [hq]
    omega

/-! ## Section 4: Pairwise Character Separation & Degree-Squared Sum (`qou-jfr8`) -/

/-- Trivial 3-strand character at a generator: `chi_triv(q) = q`. -/
def charTriv3 (q : Int) : Int := q

/-- Standard 2-dimensional 3-strand character at a generator: `chi_std(q) = tr(f(q)) = q - 1`. -/
def charStd3 (q : Int) : Int := trBlockMat2 (genF q)

/-- Sign 3-strand character at a generator: `chi_sign(q) = -1`. -/
def charSign3 : Int := -1

/-- **`qou-jfr8` (Theorem 4a — Pairwise Character Separation & Total Degree Sum):**
    `chiTriv - chiStd = 1`, `chiStd - chiSign = q`, `chiTriv - chiSign = q + 1`, and the
    sum of squared irreducible degrees `1^2 + 2^2 + 1^2` equals `6`. -/
theorem threeStrand_character_separation_and_degree_sum (q : Int) :
    charTriv3 q - charStd3 q = 1 ∧
    charStd3 q - charSign3 = q ∧
    charTriv3 q - charSign3 = q + 1 ∧
    (1 * 1 + 2 * 2 + 1 * 1) + q = 6 + q := by
  dsimp only [charTriv3, charStd3, charSign3, trBlockMat2, genF]
  refine ⟨?_, ?_, ?_, ?_⟩ <;> omega

/-! ## Section 5: Double-Braiding Ribbon Monodromy & Quadratic Trace (`qou-zoyv`) -/

/-- Double-braiding monodromy matrix `M(q) = R_mix(q)^2` on the mixed-weight 2-dimensional block. -/
def ribbonMonodromyMix (q : Int) : BlockMat2 :=
  mulBlockMat2 (vectorBraidingMix q) (vectorBraidingMix q)

/-- **`qou-zoyv` (Theorem 5a — Ribbon Monodromy Trace `q^2 + 1` & Determinant `q^2`):**
    The double-braiding monodromy `ribbonMonodromyMix q` has trace `q * q + 1` and
    determinant `q * q`. -/
theorem ribbonMonodromyMix_trace_and_det (q : Int) :
    trBlockMat2 (ribbonMonodromyMix q) = q * q + 1 ∧
    detBlockMat2 (ribbonMonodromyMix q) = q * q := by
  constructor
  · dsimp only [ribbonMonodromyMix, trBlockMat2, mulBlockMat2, vectorBraidingMix]
    rw [Int.sub_mul q 1 (q - 1), Int.mul_sub q q 1]
    omega
  · dsimp only [ribbonMonodromyMix, detBlockMat2, mulBlockMat2, vectorBraidingMix]
    have h1 : (q - 1) * (q - 1) + q * 1 = q * q - q + 1 := by
      rw [Int.sub_mul q 1 (q - 1), Int.mul_sub q q 1]
      omega
    have h2 : (q - 1) * q + q * 0 = q * q - q := by
      rw [Int.sub_mul q 1 q]
      omega
    have h3 : 1 * (q - 1) + 0 * 1 = q - 1 := by omega
    have h4 : 1 * q + 0 * 0 = q := by omega
    rw [h1, h2, h3, h4]
    rw [Int.add_mul (q * q - q) 1 q, Int.sub_mul (q * q) q q]
    rw [Int.mul_sub (q * q - q) q 1, Int.sub_mul (q * q) q q]
    omega

end QOU.Foundations.SandwichTraceCyclicityVectorBraidingReducedWordSeparationRibbonMonodromy
