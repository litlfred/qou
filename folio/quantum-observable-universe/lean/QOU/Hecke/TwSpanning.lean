import QOU.Hecke.TwBasis

/-!
# QOU.Hecke.TwSpanning — the orbit of `T_1` is everything

The spanning half of the Bourbaki route to the `T_w` basis (bean `qou-twwf`).
`QOU.Hecke.TwBasis` builds the right-multiplication operators `Rs i` on
`W →₀ R`; this file shows that starting from the single basis vector `T_1` and
applying them repeatedly reaches every `T_w`.

Unlike the braid relation, this half needs no type-`A` specialisation: Mathlib
has right descents (`CoxeterSystem.exists_rightDescent_of_ne_one`,
`isRightDescent_iff`), which is exactly what the induction on length wants.

## What is proved

* `single_mem_of_closed` — any submodule containing `T_1` and closed under every
  `Rs i` contains every `T_w`.
* `span_orbit_eq_top` — the smallest such submodule is `⊤`.

Together with the algebra map of `QOU.Hecke.TwRep` this says the module is a
**cyclic** `H_n(q)`-module generated by `T_1`; the independence of the `T_w` is
the other half and is not proved here.
-/

open Classical
namespace QOU.Hecke.TwBasis

variable {B W : Type*} [Group W] {M : CoxeterMatrix B} (cs : CoxeterSystem M W)
variable {R : Type*} [CommRing R] (q : R)

/-- **Every `T_w` is reachable from `T_1`.**  A submodule holding `T_1` and
    closed under every `Rs i` holds every basis vector. -/
theorem single_mem_of_closed {N : Submodule R (W →₀ R)}
    (h1 : Finsupp.single (1 : W) (1 : R) ∈ N)
    (hclosed : ∀ (i : B) (x : W →₀ R), x ∈ N → Rs cs q i x ∈ N) (w : W) :
    Finsupp.single w (1 : R) ∈ N := by
  generalize hn : cs.length w = m
  induction m using Nat.strong_induction_on generalizing w with
  | _ m ih =>
    by_cases hw : w = 1
    · subst hw; exact h1
    · obtain ⟨i, hi⟩ := cs.exists_rightDescent_of_ne_one hw
      have hlen : cs.length (w * cs.simple i) + 1 = cs.length w :=
        cs.isRightDescent_iff.mp hi
      have hmem : Finsupp.single (w * cs.simple i) (1 : R) ∈ N :=
        ih (cs.length (w * cs.simple i)) (by omega) _ rfl
      have hcancel : w * cs.simple i * cs.simple i = w := by
        rw [mul_assoc, cs.simple_mul_simple_self, mul_one]
      have hup : cs.length (w * cs.simple i * cs.simple i)
          = cs.length (w * cs.simple i) + 1 := by
        rw [hcancel]; omega
      have hstep := hclosed i _ hmem
      rw [Rs_single] at hstep
      unfold rsFun at hstep
      rw [if_pos hup, hcancel] at hstep
      exact hstep

omit [Group W] in
/-- A submodule containing every basis vector `T_w` is everything. -/
theorem eq_top_of_singles {N : Submodule R (W →₀ R)}
    (h : ∀ w : W, Finsupp.single w (1 : R) ∈ N) : N = ⊤ := by
  refine eq_top_iff.mpr ?_
  intro x _
  have hx : x = x.sum (fun w r => r • Finsupp.single w (1 : R)) := by
    simp [Finsupp.smul_single]
  rw [hx]
  exact Submodule.sum_mem _ (fun w _ => Submodule.smul_mem _ _ (h w))

/-- **The module is generated by `T_1` as an `Rs`-module.** -/
theorem span_orbit_eq_top :
    (sInf {N : Submodule R (W →₀ R) | Finsupp.single (1 : W) (1 : R) ∈ N ∧
        ∀ (i : B) (x : W →₀ R), x ∈ N → Rs cs q i x ∈ N}) = ⊤ :=
  eq_top_of_singles (fun w => by
    rw [Submodule.mem_sInf]
    intro N hN
    exact single_mem_of_closed cs q hN.1 hN.2 w)

end QOU.Hecke.TwBasis
