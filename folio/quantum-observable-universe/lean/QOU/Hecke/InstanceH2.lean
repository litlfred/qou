import QOU.Hecke.Algebra
import Mathlib.RingTheory.AdjoinRoot

/-!
# `QOU.Hecke.InstanceH2` — a genuine `HeckeAlgebra` instance at `n = 2`

Until now **no concrete instance of `QOU.Hecke.HeckeAlgebra` existed anywhere in
the tree** (nor of `QOU.Hecke.MarkovTrace`, nor of
`QOU.Shared.MarkovTraceContext`). Both appeared only in hypothesis position,
`[HeckeAlgebra R n q A]`, so every result quantified over them was conditional
on infrastructure that had never been shown to exist.

This file supplies the `n = 2` case, and only that case, honestly.

## What is here

`H2 R q := R[X] / (X² − (q − q⁻¹)·X − 1)`, via `AdjoinRoot`. The single Hecke
generator is the image of `X`, and the defining relation *is* the Hecke
quadratic relation
`σ² = (q − q⁻¹)·σ + 1` (AGENTS.md §7a convention).

## Why `n = 2` is the honest stopping point, not a shortcut

`Generator n` carries `idx : Fin (n - 1)`, so `Generator 2` has exactly **one**
index. `BraidRelation` quantifies over *adjacent* pairs and `FarCommutativity`
over pairs differing by `≥ 2`; with a single index neither predicate is ever
satisfiable, so both hold vacuously. That is a real fact about `n = 2`, not a
gap being papered over — the two-strand Hecke algebra genuinely has no braid
relation to satisfy.

It also means **this instance is not evidence for `n ≥ 3`.** At `n = 3` the
braid relation becomes non-vacuous and is the actual open infrastructure work
the manuscript keeps citing. Nothing here touches it.

## Contrast with the degenerate witness

A `MarkovTraceContext` can also be built at `n = 0`, where `Generator 0` is
*empty* and every axiom holds because there is nothing to check. That witness
is useful for refuting over-general statements (bean qou-octr) and is worth
nothing as mathematics. This one is different in kind: the generator exists,
the quadratic relation is genuinely imposed, and `spans` genuinely holds
because `AdjoinRoot` is generated by its root.
-/

namespace QOU.Hecke.InstanceH2

open Polynomial

universe u

variable (R : Type u) [Field R] (q : R)

/-- The Hecke parameter `h = q − q⁻¹` of the §7a convention. -/
def heckeParam : R := q - q⁻¹

/-- The defining polynomial `X² − h·X − 1`. -/
noncomputable def heckePoly : R[X] :=
  X ^ 2 - C (heckeParam R q) * X - 1

/-- **The two-strand Hecke algebra** `H₂(q) = R[X]/(X² − (q − q⁻¹)X − 1)`.

    `abbrev`, not `def`: the `AdjoinRoot` ring and algebra instances must stay
    visible to instance search, and the type must be reducibly equal to
    `AdjoinRoot (heckePoly R q)` so `algebraMap R (H2 R q)` elaborates to the
    same term the `AdjoinRoot` lemmas produce. -/
noncomputable abbrev H2 : Type u := AdjoinRoot (heckePoly R q)

/-- The generator `σ₁ ∈ H₂(q)`, the image of `X`. -/
noncomputable def sigma : H2 R q := AdjoinRoot.root (heckePoly R q)

/-- The quadratic relation, stated over an abstract carrier so that no
    unfolding of the `AdjoinRoot` *type* is ever needed — that is what made the
    direct proof fight `rw`'s motive check. -/
theorem aeval_quadratic {A : Type u} [CommRing A] [Algebra R A] (x : A) (h : R)
    (hx : (aeval x) (X ^ 2 - C h * X - 1 : R[X]) = 0) :
    x * x = h • x + 1 := by
  simp only [map_sub, map_pow, map_mul, map_one, aeval_X, aeval_C] at hx
  rw [Algebra.smul_def]
  linear_combination hx

/-- The defining relation, in the form the Hecke class wants. -/
theorem sigma_sq :
    sigma R q * sigma R q = (heckeParam R q) • sigma R q + 1 :=
  aeval_quadratic R (sigma R q) (heckeParam R q) <| by
    rw [sigma, AdjoinRoot.aeval_eq]
    exact AdjoinRoot.mk_self

/-- `Generator 2` has a single index, so no two generators are ever adjacent. -/
theorem not_adjacent (i j : Generator 2) : ¬ Generator.adjacent i j := by
  have hi := i.idx.isLt
  have hj := j.idx.isLt
  simp only [Generator.adjacent]
  omega

/-- …and none are ever far-commuting either. -/
theorem not_farCommuting (i j : Generator 2) : ¬ Generator.farCommuting i j := by
  rintro ⟨hne, -⟩
  refine hne ?_
  obtain ⟨⟨iv, hi⟩⟩ := i
  obtain ⟨⟨jv, hj⟩⟩ := j
  simp only [Generator.mk.injEq, Fin.mk.injEq]
  omega

/-- **`H₂(q)` is a Hecke algebra.** All four axioms discharged: the quadratic
    relation from the defining polynomial, braid and far-commutativity
    vacuously (one generator), and spanning from `AdjoinRoot`. -/
noncomputable instance instHeckeAlgebraH2 : HeckeAlgebra R 2 q (H2 R q) where
  embed := fun _ => sigma R q
  quadratic := fun _ => sigma_sq R q
  braid := fun i j hij => absurd hij (not_adjacent i j)
  farCommute := fun i j hij => absurd hij (not_farCommuting i j)
  spans := by
    have : (Set.range fun _ : Generator 2 => sigma R q)
        ⊆ ({AdjoinRoot.root (heckePoly R q)} : Set (H2 R q)) := by
      rintro x ⟨_, rfl⟩; rfl
    refine le_antisymm le_top ?_
    rw [← AdjoinRoot.adjoinRoot_eq_top (f := heckePoly R q)]
    refine Algebra.adjoin_mono ?_
    rintro x rfl
    exact ⟨⟨0, by omega⟩, rfl⟩

/-! ## What this instance does NOT establish

`HeckeAlgebra` as stated asks for a generator map, the three relations, and
spanning. It does **not** ask that `A` be free of rank `n!` over `R`, and
without that it does not characterise `H_n(q)` — it is satisfied by algebras
far too small.

Concretely, at `q = 1` the parameter `h = q - q⁻¹` is `0`, so `x = 1` solves
`x² = h·x + 1`; braid and far-commutativity are automatic in a commutative
ring; and `spans` holds because `Subalgebra ℚ ℚ` is a subsingleton. Hence: -/

/-- **The class admits a rank-1 model at every `n`.** `ℚ` itself is a
    `HeckeAlgebra ℚ n 1 ℚ` for all `n` — including `n` where `H_n(1)` has
    dimension `n! = 6, 24, 120, …`.

    So a hypothesis `[HeckeAlgebra R n q A]` is much weaker than "`A` is the
    Hecke algebra": anything proved from it also holds of `ℚ` at `q = 1`. The
    missing axiom is the **Iwahori basis** — `A` free of rank `n!` over `R` on
    `{T_w}_{w ∈ S_n}`. See bean qou-ghak / the H3–H4 roadmap. -/
instance rankOneModel (n : ℕ) : HeckeAlgebra ℚ n 1 ℚ where
  embed := fun _ => 1
  quadratic := by intro i; norm_num
  braid := by intro i j _; simp
  farCommute := by intro i j _; simp
  spans := Subsingleton.elim _ _

/-- `H2 R q` above *is* of the right rank (`AdjoinRoot` of a monic quadratic is
    free of rank `2 = 2!`), but the class cannot see that — which is exactly the
    point of `rankOneModel`. -/
example : HeckeAlgebra ℚ 3 1 ℚ := inferInstance

end QOU.Hecke.InstanceH2
