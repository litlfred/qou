import QOU.Hecke.MarkovTraceH2
import QOU.Hecke.MarkovTraceOnH3A
import QOU.Hecke.MarkovTraceClassNotUnique

/-!
# `QOU.Hecke.MarkovTraceIsMarkov` — the concrete Markov traces satisfy (M3)

`QOU.Hecke.markov_trace_unique` proves that two `MarkovTrace`s with the same Markov
parameter agree **provided both satisfy the cross-level Markov property**
`MarkovTrace.IsMarkov`:

    tr(x · σᵢ) = z · tr(x)   for every x in the subalgebra generated by σ_j, j < i.

Until this file no trace in the tree was shown to satisfy that hypothesis, so the
uniqueness theorem had no application. Here the three concrete traces are shown to
satisfy it, for **every** Markov parameter `z`:

* `isMarkov_H2` — `MarkovTraceH2.markovTraceH2` on `H₂(q)`;
* `isMarkov_H3A` — `MarkovTraceOnH3A.markovTraceH3A` on the tree's `H₃(q)`;
* `isMarkov_H4A` — `MarkovTraceOnH4A.markovTraceH4A` on the tree's `H₄(q)`.

`z` is a free parameter throughout. That is the mathematics, not a gap: Ocneanu's
trace exists for every `z` (it is the two-variable HOMFLYPT trace); convention D,
`z = q³/(q² + 1)`, is one specialisation and every statement below holds there.

## The method: one closure lemma, then the existing peel lemmas

`mem_of_mem_adjoin_of_mul_mem`: if a submodule `W` contains `1` and is closed under
right multiplication by every element of `S`, it contains `Algebra.adjoin R S`. (The
elements `y` with `W · y ⊆ W` form a subalgebra containing `S`; apply it to `1 ∈ W`.)
So the lower subalgebra at each level is confined to an explicit coordinate subspace,
with no word enumeration:

| level | `W` | Markov peel used |
|---|---|---|
| `i = 0` (every `n`) | `R · 1` | `tr(c·σ₀) = c·z` |
| `H₃`, `i = 1` | coordinates `2..5` vanish | `H3.trM_markov_σ₁` |
| `H₄`, `i = 2` | image of `iota34 : H₃ ↪ H₄` | `H4.trM4_markov_σ₂` + `trM4_iota34_stabilizes` |
| `H₄`, `i = 1` | `iota34` of the `H₃`, `i = 1` subspace | `iota34_mulσ₁` + `H3.trM_markov_σ₁` |

The closure steps are the intertwining identities `iota34_mulσ₀/₁` of
`QOU.Machinery.HeckeH4StabilizationRung` and one six-coordinate check of `H3.mulσ₀`.

## The payoff

* `markovTraceH4A_unique` (and the `H₂`, `H₃` analogues): **any** `MarkovTrace` on the
  tree's `H₄(q)` satisfying (M3) is the Ocneanu trace `markovTraceH4A K q z` at its own
  `z_param`. This is the first application of `markov_trace_unique`.
* `mixMarkov_not_isMarkov`: the counterexample trace `t_Z` of
  `QOU.Hecke.MarkovTraceClassNotUnique` (which satisfies every field of the class) is
  **not** a Markov trace in the sense of (M3). So `IsMarkov` is exactly the condition
  the class was missing: it excludes `t_Z` and admits the Ocneanu trace.

## What this does not establish

* Existence of a Markov trace on `H_n(q)` for `n ≥ 5` (Ocneanu) — nothing in the tree
  constructs one; only `n = 2, 3, 4` are concrete here.
* Anything about which `z` is physical: every `z` works.

-- Ref: [jones1987] Jones, *Hecke algebra representations of braid groups and link
--      polynomials*, Ann. Math. 126 (1987), §5 (the Markov trace, existence and (M3)).
-/

namespace QOU.Hecke.MarkovTraceIsMarkov

open QOU.Hecke

universe u

/-! ## The closure lemma -/

/-- **A submodule containing `1` and closed under right multiplication by `S` contains
the subalgebra generated by `S`.** -/
theorem mem_of_mem_adjoin_of_mul_mem {R A : Type*} [CommRing R] [Ring A] [Algebra R A]
    {S : Set A} (W : Submodule R A) (h1 : (1 : A) ∈ W)
    (hS : ∀ x ∈ W, ∀ s ∈ S, x * s ∈ W) {y : A} (hy : y ∈ Algebra.adjoin R S) : y ∈ W := by
  let M : Subalgebra R A :=
    { carrier := {y | ∀ x ∈ W, x * y ∈ W}
      mul_mem' := fun {a b} ha hb x hx => by
        rw [← mul_assoc]; exact hb _ (ha x hx)
      one_mem' := fun x hx => by rwa [mul_one]
      add_mem' := fun {a b} ha hb x hx => by
        rw [mul_add]; exact W.add_mem (ha x hx) (hb x hx)
      zero_mem' := fun x _ => by rw [mul_zero]; exact W.zero_mem
      algebraMap_mem' := fun r x hx => by
        rw [← Algebra.commutes, ← Algebra.smul_def]; exact W.smul_mem r hx }
  have hle : Algebra.adjoin R S ≤ M := Algebra.adjoin_le fun s hs x hx => hS x hx s hs
  have := hle hy 1 h1
  rwa [one_mul] at this

/-- The level-`0` case at every `n`: the subalgebra generated by no generators is
`R · 1`. -/
theorem mem_span_one_of_mem_adjoin_empty {R A : Type*} [CommRing R] [Ring A] [Algebra R A]
    {S : Set A} (hS : S = ∅) {y : A} (hy : y ∈ Algebra.adjoin R S) :
    y ∈ Submodule.span R {(1 : A)} :=
  mem_of_mem_adjoin_of_mul_mem _ (Submodule.mem_span_singleton_self 1)
    (fun _ _ s hs => by simp [hS] at hs) hy

/-! ## `H₂(q)` -/

section H2

open QOU.Hecke.InstanceH2 QOU.Hecke.MarkovTraceH2

variable (R : Type u) [Field R] (q : R)

/-- **The `H₂(q)` trace satisfies (M3)**, for every `z`. There is one generator, so the
only condition is at `i = 0`, on `R · 1`. -/
theorem isMarkov_H2 (z : R) : (markovTraceH2 R q z).IsMarkov := by
  intro i x hx
  have hS : (HeckeAlgebra.embed (R := R) (q := q) (A := H2 R q) ''
      {j : Generator 2 | j.idx.val < i.idx.val}) = ∅ := by
    have := i.idx.isLt
    ext y; simp only [Set.mem_image, Set.mem_setOf_eq, Set.mem_empty_iff_false, iff_false]
    rintro ⟨j, hj, -⟩; omega
  obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp (mem_span_one_of_mem_adjoin_empty hS hx)
  show traceMap R q z (c • 1 * sigma R q) = z * traceMap R q z (c • 1)
  rw [smul_mul_assoc, one_mul, map_smul, map_smul, traceMap_sigma, traceMap_one, smul_eq_mul,
    smul_eq_mul]
  ring

/-- **Uniqueness on `H₂(q)`.** Every `MarkovTrace` satisfying (M3) is `markovTraceH2` at its
own Markov parameter. -/
theorem markovTraceH2_unique (MT : MarkovTrace 2 q (H2 R q)) (hM : MT.IsMarkov) :
    MT.trace = (markovTraceH2 R q MT.z_param).trace :=
  markov_trace_unique MT _ rfl hM (isMarkov_H2 R q _)

end H2

/-! ## `H₃(q)` -/

section H3

open QOU.Machinery.H3 QOU.Hecke.InstanceOnH3A QOU.Hecke.MarkovTraceOnH3A

variable (K : Type u) [Field K] (q : K)

theorem mul_s0_v (x : H3A K (q - q⁻¹)) : (x * s0 K q).v = mulσ₀ (q - q⁻¹) x.v := by
  funext i; simp [mulNF, s0]

theorem mul_s1_v (x : H3A K (q - q⁻¹)) : (x * s1 K q).v = mulσ₁ (q - q⁻¹) x.v := by
  funext i; simp [mulNF, s1]

/-- The subalgebra generated by `σ₀` lies in the span of `{1, σ₀}`: the coordinates on
`σ₁, σ₁σ₀, σ₀σ₁, σ₀σ₁σ₀` vanish. -/
def lowH3 : Submodule K (H3A K (q - q⁻¹)) where
  carrier := {x | x.v 2 = 0 ∧ x.v 3 = 0 ∧ x.v 4 = 0 ∧ x.v 5 = 0}
  add_mem' := by
    rintro x y ⟨h2, h3, h4, h5⟩ ⟨k2, k3, k4, k5⟩
    simp [h2, h3, h4, h5, k2, k3, k4, k5]
  zero_mem' := by simp
  smul_mem' := by
    rintro c x ⟨h2, h3, h4, h5⟩
    simp [h2, h3, h4, h5]

theorem mem_lowH3_of_mem_adjoin {x : H3A K (q - q⁻¹)}
    (hx : x ∈ Algebra.adjoin K (HeckeAlgebra.embed (R := K) (q := q) (A := H3A K (q - q⁻¹)) ''
      {j : Generator 3 | j.idx.val < 1})) : x ∈ lowH3 K q := by
  refine mem_of_mem_adjoin_of_mul_mem _ ?_ ?_ hx
  · show (unitNF : Fin 6 → K) 2 = 0 ∧ _
    simp [unitNF]
  · rintro y ⟨h2, h3, h4, h5⟩ s ⟨j, hj, rfl⟩
    rcases generator_three_cases j with rfl | rfl
    · show (y * s0 K q).v 2 = 0 ∧ (y * s0 K q).v 3 = 0 ∧ (y * s0 K q).v 4 = 0
        ∧ (y * s0 K q).v 5 = 0
      rw [mul_s0_v]
      simp [mulσ₀, h2, h3, h4, h5]
    · exact absurd hj (by decide)

/-- **The `H₃(q)` trace satisfies (M3)**, for every `z`. At `i = 1` the lower subalgebra
is `lowH3`, where `H3.trM_markov_σ₁` is exactly the peel. -/
theorem isMarkov_H3A (z : K) : (markovTraceH3A K q z).IsMarkov := by
  intro i x hx
  rcases generator_three_cases i with rfl | rfl
  · have hS : (HeckeAlgebra.embed (R := K) (q := q) (A := H3A K (q - q⁻¹)) ''
        {j : Generator 3 | j.idx.val < (⟨0⟩ : Generator 3).idx.val}) = ∅ := by
      ext y; simp
    obtain ⟨c, rfl⟩ :=
      Submodule.mem_span_singleton.mp (mem_span_one_of_mem_adjoin_empty hS hx)
    show traceMap K q z (c • 1 * s0 K q) = z * traceMap K q z (c • 1)
    rw [smul_mul_assoc, one_mul, map_smul, map_smul, traceMap_s0, traceMap_one, smul_eq_mul,
      smul_eq_mul]
    ring
  · obtain ⟨h2, h3, h4, h5⟩ := mem_lowH3_of_mem_adjoin K q hx
    show trM z (q - q⁻¹) (x * s1 K q).v = z * trM z (q - q⁻¹) x.v
    rw [mul_s1_v]
    exact trM_markov_σ₁ z (q - q⁻¹) x.v h2 h3 h4 h5

/-- **Uniqueness on `H₃(q)`.** Every `MarkovTrace` on the tree's `H₃(q)` satisfying (M3)
is `markovTraceH3A` at its own Markov parameter. -/
theorem markovTraceH3A_unique (MT : MarkovTrace 3 q (H3A K (q - q⁻¹))) (hM : MT.IsMarkov) :
    MT.trace = (markovTraceH3A K q MT.z_param).trace :=
  markov_trace_unique MT _ rfl hM (isMarkov_H3A K q _)

end H3

/-! ## `H₄(q)` -/

section H4

open QOU.Machinery.H4 QOU.Hecke.InstanceOnH4A QOU.Hecke.MarkovTraceOnH4A

variable (K : Type u) [Field K] (q : K)

theorem iota34_add (v w : Fin 6 → K) : iota34 (v + w) = iota34 v + iota34 w := by
  funext i; fin_cases i <;> simp [iota34]

theorem iota34_smul (c : K) (v : Fin 6 → K) : iota34 (c • v) = c • iota34 v := by
  funext i; fin_cases i <;> simp [iota34]

theorem iota34_zero : iota34 (0 : Fin 6 → K) = 0 := by
  funext i; fin_cases i <;> simp [iota34]

theorem iota34_unit : iota34 (QOU.Machinery.H3.unitNF : Fin 6 → K) = unitNF₄ := by
  funext i; fin_cases i <;> simp [iota34, unitNF₄, QOU.Machinery.H3.unitNF]

/-- `H₃(q)` inside `H₄(q)`: the elements whose coordinates are `iota34` of an `H₃`
vector, cut down further by a predicate on that vector closed under the linear
operations. -/
def iotaSub (P : Submodule K (Fin 6 → K)) : Submodule K (H4A K (q - q⁻¹)) where
  carrier := {x | ∃ v ∈ P, x.v = iota34 v}
  add_mem' := by
    rintro x y ⟨v, hv, hx⟩ ⟨w, hw, hy⟩
    exact ⟨v + w, P.add_mem hv hw, by simp [hx, hy, iota34_add]⟩
  zero_mem' := ⟨0, P.zero_mem, by simp [iota34_zero]⟩
  smul_mem' := by
    rintro c x ⟨v, hv, hx⟩
    exact ⟨c • v, P.smul_mem c hv, by simp [hx, iota34_smul]⟩

/-- The `H₃` coordinates of the span of `{1, σ₀}`. -/
def low3 : Submodule K (Fin 6 → K) where
  carrier := {v | v 2 = 0 ∧ v 3 = 0 ∧ v 4 = 0 ∧ v 5 = 0}
  add_mem' := by
    rintro x y ⟨h2, h3, h4, h5⟩ ⟨k2, k3, k4, k5⟩
    simp [h2, h3, h4, h5, k2, k3, k4, k5]
  zero_mem' := by simp
  smul_mem' := by
    rintro c x ⟨h2, h3, h4, h5⟩
    simp [h2, h3, h4, h5]

theorem one_mem_iotaSub (P : Submodule K (Fin 6 → K))
    (hP : (QOU.Machinery.H3.unitNF : Fin 6 → K) ∈ P) : (1 : H4A K (q - q⁻¹)) ∈ iotaSub K q P :=
  ⟨_, hP, by rw [iota34_unit]; rfl⟩

theorem mul_s0_mem_iotaSub (P : Submodule K (Fin 6 → K))
    (hP : ∀ v ∈ P, QOU.Machinery.H3.mulσ₀ (q - q⁻¹) v ∈ P)
    {x : H4A K (q - q⁻¹)} (hx : x ∈ iotaSub K q P) : x * s0 K q ∈ iotaSub K q P := by
  obtain ⟨v, hv, hxv⟩ := hx
  refine ⟨_, hP v hv, ?_⟩
  rw [mul_s0]; show mulσ₀ (q - q⁻¹) x.v = _
  rw [hxv, iota34_mulσ₀]

theorem mul_s1_mem_iotaSub (P : Submodule K (Fin 6 → K))
    (hP : ∀ v ∈ P, QOU.Machinery.H3.mulσ₁ (q - q⁻¹) v ∈ P)
    {x : H4A K (q - q⁻¹)} (hx : x ∈ iotaSub K q P) : x * s1 K q ∈ iotaSub K q P := by
  obtain ⟨v, hv, hxv⟩ := hx
  refine ⟨_, hP v hv, ?_⟩
  rw [mul_s1]; show mulσ₁ (q - q⁻¹) x.v = _
  rw [hxv, iota34_mulσ₁]

/-- **The `H₄(q)` trace satisfies (M3)**, for every `z`.

* `i = 0`: the lower subalgebra is `K · 1`.
* `i = 1`: it lies in `iota34` of the `H₃` span of `{1, σ₀}`; the trace of `x·σ₁` is
  carried to `H₃` by `iota34_mulσ₁` and `trM4_iota34_stabilizes`, and peeled by
  `H3.trM_markov_σ₁`.
* `i = 2`: it lies in `iota34 (H₃)`, and `trM4_markov_σ₂` is exactly the peel. -/
theorem isMarkov_H4A (z : K) : (markovTraceH4A K q z).IsMarkov := by
  intro i x hx
  rcases generator_four_cases i with rfl | rfl | rfl
  · have hS : (HeckeAlgebra.embed (R := K) (q := q) (A := H4A K (q - q⁻¹)) ''
        {j : Generator 4 | j.idx.val < (⟨0⟩ : Generator 4).idx.val}) = ∅ := by
      ext y; simp
    obtain ⟨c, rfl⟩ :=
      Submodule.mem_span_singleton.mp (mem_span_one_of_mem_adjoin_empty hS hx)
    show traceMap K q z (c • 1 * s0 K q) = z * traceMap K q z (c • 1)
    rw [smul_mul_assoc, one_mul, map_smul, map_smul, traceMap_s0, traceMap_one, smul_eq_mul,
      smul_eq_mul]
    ring
  · have hmem : x ∈ iotaSub K q (low3 K) := by
      refine mem_of_mem_adjoin_of_mul_mem _
        (one_mem_iotaSub K q _ (by simp [low3, QOU.Machinery.H3.unitNF])) ?_ hx
      rintro y hy s ⟨j, hj, rfl⟩
      rcases generator_four_cases j with rfl | rfl | rfl
      · refine mul_s0_mem_iotaSub K q _ ?_ hy
        rintro v ⟨h2, h3, h4, h5⟩
        simp [low3, QOU.Machinery.H3.mulσ₀, h2, h3, h4, h5]
      · exact absurd hj (by decide)
      · exact absurd hj (by decide)
    obtain ⟨v, ⟨h2, h3, h4, h5⟩, hxv⟩ := hmem
    show trM4 z (q - q⁻¹) (x * s1 K q).v = z * trM4 z (q - q⁻¹) x.v
    rw [mul_s1]
    show trM4 z (q - q⁻¹) (mulσ₁ (q - q⁻¹) x.v) = z * trM4 z (q - q⁻¹) x.v
    rw [hxv, iota34_mulσ₁, trM4_iota34_stabilizes, trM4_iota34_stabilizes]
    exact QOU.Machinery.H3.trM_markov_σ₁ z (q - q⁻¹) v h2 h3 h4 h5
  · have hmem : x ∈ iotaSub K q ⊤ := by
      refine mem_of_mem_adjoin_of_mul_mem _ (one_mem_iotaSub K q _ Submodule.mem_top) ?_ hx
      rintro y hy s ⟨j, hj, rfl⟩
      rcases generator_four_cases j with rfl | rfl | rfl
      · exact mul_s0_mem_iotaSub K q _ (fun _ _ => Submodule.mem_top) hy
      · exact mul_s1_mem_iotaSub K q _ (fun _ _ => Submodule.mem_top) hy
      · exact absurd hj (by decide)
    obtain ⟨v, -, hxv⟩ := hmem
    show trM4 z (q - q⁻¹) (x * s2 K q).v = z * trM4 z (q - q⁻¹) x.v
    rw [mul_s2]
    show trM4 z (q - q⁻¹) (mulσ₂ (q - q⁻¹) x.v) = z * trM4 z (q - q⁻¹) x.v
    rw [hxv, trM4_markov_σ₂, trM4_iota34_stabilizes]

/-- **Uniqueness on `H₄(q)` — the first application of `markov_trace_unique`.** Every
`MarkovTrace` on the tree's `H₄(q)` satisfying (M3) is the Ocneanu trace
`markovTraceH4A` at its own Markov parameter. -/
theorem markovTraceH4A_unique (MT : MarkovTrace 4 q (H4A K (q - q⁻¹))) (hM : MT.IsMarkov) :
    MT.trace = (markovTraceH4A K q MT.z_param).trace :=
  markov_trace_unique MT _ rfl hM (isMarkov_H4A K q _)

/-- **(M3) has teeth.** The signed Ocneanu mixture `t_Z` of
`QOU.Hecke.MarkovTraceClassNotUnique` satisfies every field of the `MarkovTrace` class
but is **not** a Markov trace in the sense of (M3): if it were, `markovTraceH4A_unique`
would force it to equal `markovTraceH4A K q Z`, which it does not (they differ by `6` on
`σ₀σ₁σ₂`). Over any field with `6 ≠ 0`. -/
theorem mixMarkov_not_isMarkov (h6 : (6 : K) ≠ 0) (Z : K) :
    ¬ (QOU.Hecke.MarkovTraceClassNotUnique.mixMarkov K q Z).IsMarkov := fun hM =>
  (QOU.Hecke.MarkovTraceClassNotUnique.mixMarkov_trace_ne K q h6 Z).2
    (markovTraceH4A_unique K q _ hM)

end H4

end QOU.Hecke.MarkovTraceIsMarkov
