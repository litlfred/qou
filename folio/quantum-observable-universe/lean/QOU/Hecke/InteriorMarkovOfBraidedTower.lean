import QOU.Hecke.MarkovInteriorBond
import QOU.MathlibExt.HeckeSandwichReduces
import QOU.MathlibExt.BraidedTowerInstances
import Mathlib.Tactic

/-!
# `InteriorMarkov` is a theorem of every braided tower — the `qou-gr3t` gap closes onto `qou-301d`

Bean `qou-gr3t`. `QOU.Hecke.MarkovInteriorBond` proves the general-`A` bond product for the
canonical non-monotone atom word **conditionally on `InteriorMarkov`** — the rule
`tr (a σ_g b) = z · tr (a b)` for `a` below the bond `g` and `b` generated by the letters
strictly above it — and shows by counter-model (`cmTower`) that `InteriorMarkov` does not
follow from the `MarkovTower` axioms alone. The bean's stated next step was to prove
`InteriorMarkov` for a tower that carries the Hecke relations.

Meanwhile `qou-301d` landed the chain

    BraidedTower T  ⟹  SandwichReduces  ⟹  TowerSpan  ⟹  DisjointBlockMultiplicative T

(`QOU.MathlibExt.HeckeSandwichReduces.disjointBlock_of_braided`), where `BraidedTower` is the
three defining relations of the Iwahori–Hecke algebra — quadratic, far-commutation, braid —
and nothing about the trace. This file closes the loop:

* `interiorMarkov_of_disjointBlock` — `InteriorMarkov` **follows from** the disjoint-block law
  (plus `tr 1 = 1`). With `b` above the bond, `σ_g · b` is generated by the letters at level
  `≥ g`, so `tr (a σ_g b) = tr a · tr (σ_g b)`; `σ_g ∈ H (g+1)` and `b` is at level `≥ g+1`,
  so `tr (σ_g b) = tr σ_g · tr b = z · tr b`; and `tr (a b) = tr a · tr b`. Three
  applications of the block law and the top-of-tower Markov axiom at `a = 1`.
* `toTower` — an Ocneanu `MarkovTrace` with far-commuting generators is a `MarkovTower`
  (forget `ginv`, `zinv`, `markov_inv`; keep everything else); `toTowerB` is the same for a
  `BraidedTower`, whose `far` field supplies the commutation.
* `interiorMarkov_of_braided` — **`InteriorMarkov` holds on every braided tower.** The
  bespoke hypothesis of `qou-gr3t` is a theorem of the Hecke relations.
* `tr_bondWord_of_braided` — hence the general-`A` bond product
  `tr (bondWord) = (∏ (z + d_k)) · tr (freeWord)` holds on every braided tower, with no
  trace hypothesis beyond the Markov axioms; in particular on the presented Hecke tower
  `heckeTowerMarkovTrace h z hz` with `h ≠ 0` (`tr_bondWord_heckeTower`) and on the
  symmetric-group tower (`tr_bondWord_symTrace`), the two `BraidedTower` instances the
  corpus carries.

## 🛑 What is NOT established — the remaining distance is a bridge, not a theorem

The bond product is now a theorem for **every** Markov trace on **every** braided tower. The
trace the corpus computes with — the Ocneanu trace of `H_n(q)` with `z = q³/(q²+1)` — is
constructed and proved unique in `SchurWeyl/MarkovTraceInstance.lean` /
`MarkovTraceUnique.lean` (`ocneanuMarkovTrace`, `markovTrace_unique`), but as a
`HeckeCoset.MarkovTraceFamily`, a *different* abstraction from the `OcneanuTrace.MarkovTrace`
this file and the `qou-301d` chain consume; nothing in the tree yet packages that family as
an `OcneanuTrace.MarkovTrace` on the presented tower (PR #7258's correction of `qou-301d`;
bean `qou-0fmb`). The only `OcneanuTrace.MarkovTrace` on the presented tower in the tree,
`heckeTowerMarkovTrace`, factors through the rank-2 quotient and is not faithful. So: the
bond product holds for the production trace **once that bridge is built**, and the bridge is
a packaging statement, not new mathematics. This file removes the bespoke hypothesis
`qou-gr3t` carried; what is left is the one packaging gap the corpus already names. The
`InteriorMarkov` counter-model `cmTower` is unaffected: it is not braided (`σ_n = 1` for
`n ≥ 3` and `X 2 * X 1 * X 2 ≠ X 1 * X 2 * X 1`), which is why it could refute the rule.

Base ring: generic `R`, `A` throughout; no `ℝ`.
-/

namespace QOU.Hecke.InteriorMarkovOfBraidedTower

open QOU.MathlibExt.MarkovUnusedGenerator
open QOU.Hecke.MarkovInteriorBond
open QOU.MathlibExt.OcneanuTrace QOU.MathlibExt.DisjointBlockTrace
  QOU.MathlibExt.TowerSpanReduction QOU.MathlibExt.HeckeSandwichReduces

variable {R : Type*} [CommRing R] {A : Type*} [Ring A] [Algebra R A]

section Tower

variable (T : MarkovTower R A)

/-- The subalgebra generated by the generators at level **`≥ g`**: `σ_g, σ_{g+1}, …`.
`upper T g` (strictly above `g`) is `from_ T (g + 1)` by definition. -/
def from_ (g : ℕ) : Subalgebra R A :=
  Algebra.adjoin R (Set.range fun k : ℕ => T.σ (g + k))

theorem upper_eq_from (g : ℕ) : upper T g = from_ T (g + 1) := rfl

theorem σ_mem_from (g : ℕ) : T.σ g ∈ from_ T g :=
  Algebra.subset_adjoin ⟨0, by simp⟩

theorem from_anti {g g' : ℕ} (h : g ≤ g') : from_ T g' ≤ from_ T g := by
  unfold from_
  apply Algebra.adjoin_mono
  rintro _ ⟨k, rfl⟩
  exact ⟨g' + k - g, by
    show T.σ (g + (g' + k - g)) = T.σ (g' + k)
    rw [Nat.add_sub_cancel' (by omega : g ≤ g' + k)]⟩

/-- **The disjoint-block trace law**, in the tower's own vocabulary: for `a` at level `≤ g`
and `b` generated by the letters at level `≥ g`, the trace is multiplicative. -/
def DisjointBlock : Prop :=
  ∀ g : ℕ, ∀ a ∈ T.H g, ∀ b ∈ from_ T g, T.tr (a * b) = T.tr a * T.tr b

/-- `tr σ_g = z` when `tr 1 = 1`: the Markov axiom at `a = 1`. -/
theorem tr_σ (h1 : T.tr 1 = 1) (g : ℕ) : T.tr (T.σ g) = T.z := by
  have := T.markov g 1 ((T.H g).one_mem)
  rwa [one_mul, h1, mul_one] at this

/-- **`InteriorMarkov` follows from the disjoint-block law.** -/
theorem interiorMarkov_of_disjointBlock (h1 : T.tr 1 = 1) (hD : DisjointBlock T) :
    InteriorMarkov T := by
  intro g a ha b hb
  have hb1 : b ∈ from_ T (g + 1) := hb
  have hbg : b ∈ from_ T g := from_anti T (Nat.le_succ g) hb1
  have hσb : T.σ g * b ∈ from_ T g := (from_ T g).mul_mem (σ_mem_from T g) hbg
  have e1 : T.tr (a * T.σ g * b) = T.tr a * T.tr (T.σ g * b) := by
    rw [mul_assoc]; exact hD g a ha _ hσb
  have e2 : T.tr (T.σ g * b) = T.z * T.tr b := by
    rw [hD (g + 1) (T.σ g) (T.σ_mem g) b hb1, tr_σ T h1]
  have e3 : T.tr (a * b) = T.tr a * T.tr b := hD g a ha b hbg
  rw [e1, e2, e3]; ring

end Tower

section Transfer

variable (S : MarkovTrace R A)

/-- An Ocneanu `MarkovTrace` whose generators far-commute is a `MarkovTower`: forget the
inverse generator and its Markov parameter, keep the filtration, trace and `z`. -/
def toTower (hfar : ∀ i j : ℕ, i + 2 ≤ j → S.g i * S.g j = S.g j * S.g i) :
    MarkovTower R A where
  H := S.H
  H_mono := S.H_mono
  σ := S.g
  σ_mem := S.g_mem
  far_comm := hfar
  tr := S.tr
  tr_comm := S.tr_mul_comm
  z := S.z
  markov := S.markov

variable (hfar : ∀ i j : ℕ, i + 2 ≤ j → S.g i * S.g j = S.g j * S.g i)

/-- The tower-vocabulary block subalgebra sits inside the corpus's `shifted`. -/
theorem from_le_shifted (g : ℕ) : from_ (toTower S hfar) g ≤ shifted S g := by
  unfold from_
  apply Algebra.adjoin_le
  rintro _ ⟨k, rfl⟩
  exact g_mem_shifted S g k

/-- The corpus's `DisjointBlockMultiplicative` gives the tower-vocabulary `DisjointBlock`. -/
theorem disjointBlock_of_multiplicative (hD : DisjointBlockMultiplicative S) :
    DisjointBlock (toTower S hfar) :=
  fun g a ha b hb => hD g a ha b (from_le_shifted S hfar g hb)

/-- **`InteriorMarkov` for every far-commuting Ocneanu tower satisfying the disjoint-block
law.** -/
theorem interiorMarkov_of_disjointBlockMultiplicative (hD : DisjointBlockMultiplicative S) :
    InteriorMarkov (toTower S hfar) :=
  interiorMarkov_of_disjointBlock _ S.tr_one (disjointBlock_of_multiplicative S hfar hD)

end Transfer

section Braided

variable (S : MarkovTrace R A) [hbt : BraidedTower S]

/-- The far-commutation of a braided tower, in the `MarkovTower` orientation. -/
theorem far_of_braided (i j : ℕ) (h : i + 2 ≤ j) : S.g i * S.g j = S.g j * S.g i :=
  (hbt.far j i (by omega)).symm

/-- A braided Ocneanu tower as a `MarkovTower`. -/
def toTowerB : MarkovTower R A := toTower S (far_of_braided S)

/-- **`InteriorMarkov` is a theorem of every braided tower.** The hypothesis `qou-gr3t`
carried as a bespoke `Prop` is discharged by the Hecke relations alone, through
`HeckeSandwichReduces.disjointBlock_of_braided`. -/
theorem interiorMarkov_of_braided : InteriorMarkov (toTowerB S) :=
  interiorMarkov_of_disjointBlockMultiplicative S (far_of_braided S)
    (disjointBlock_of_braided S)

/-- **The general-`A` bond product on every braided tower**: for a chain with strictly
increasing bonds, blocks between them and `x` below the first bond,
`tr (bondWord) = (∏ (z + d_k)) · tr (freeWord)`. No hypothesis beyond the tower's
defining relations and the Markov axioms. -/
theorem tr_bondWord_of_braided (l : List (ℕ × R × A)) (x : A)
    (hc : ChainOK (toTowerB S) l) (hx : x ∈ (toTowerB S).H (headBond l)) :
    (toTowerB S).tr (bondWord (toTowerB S) x l)
      = (l.map fun p => (toTowerB S).z + p.2.1).prod
        * (toTowerB S).tr (freeWord x l) :=
  tr_bondWord_of_interiorMarkov _ (interiorMarkov_of_braided S) l x hc hx

end Braided

section Instances

open QOU.MathlibExt.HeckeTowerWitness QOU.MathlibExt.BraidedTowerInstances
  QOU.MathlibExt.SymmetricGroupTowerWitness

/-- The bond product on the presented infinite Hecke tower, for any `h` and any root `z` of
the Hecke quadratic `z² = h z + 1`. -/
theorem tr_bondWord_heckeTower {R : Type*} [CommRing R] (h z : R) (hz : z * z = h * z + 1)
    (l : List (ℕ × R × HeckeTower R h)) (x : HeckeTower R h)
    (hc : ChainOK (toTowerB (heckeTowerMarkovTrace h z hz)) l)
    (hx : x ∈ (toTowerB (heckeTowerMarkovTrace h z hz)).H (headBond l)) :
    (toTowerB (heckeTowerMarkovTrace h z hz)).tr
        (bondWord (toTowerB (heckeTowerMarkovTrace h z hz)) x l)
      = (l.map fun p => (toTowerB (heckeTowerMarkovTrace h z hz)).z + p.2.1).prod
        * (toTowerB (heckeTowerMarkovTrace h z hz)).tr
            (freeWord x l) :=
  tr_bondWord_of_braided _ l x hc hx

/-- The bond product on the symmetric-group tower (`q = 1`), the corpus's other
`BraidedTower` instance. -/
theorem tr_bondWord_symTrace {R : Type*} [CommRing R]
    (l : List (ℕ × R × ((MonoidAlgebra R G))))
    (x : (MonoidAlgebra R G))
    (hc : ChainOK (toTowerB (symTrace R)) l)
    (hx : x ∈ (toTowerB (symTrace R)).H (headBond l)) :
    (toTowerB (symTrace R)).tr (bondWord (toTowerB (symTrace R)) x l)
      = (l.map fun p => (toTowerB (symTrace R)).z + p.2.1).prod
        * (toTowerB (symTrace R)).tr (freeWord x l) :=
  tr_bondWord_of_braided _ l x hc hx

end Instances

end QOU.Hecke.InteriorMarkovOfBraidedTower
