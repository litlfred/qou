import QOU.MathlibExt.HeckeSandwichReduces

/-!
# QOU.Hecke.MarkovBondLetter — a generator used once contributes `c z + d` to any Markov trace

Let `tr` be a Markov trace with parameter `z` on a braided (Iwahori–Hecke) tower, and let
`a, b` lie in the subalgebra generated by the generators `g_t` with `t ≠ i`. Then

  `tr (a * g_i * b) = z * tr (a * b)`,   hence
  `tr (a * (c • g_i + d • 1) * b) = (c * z + d) * tr (a * b)`.

This is the general-`z` form of `QOU.Hecke.TwBasis.tau_bond_letter` (the canonical trace
`τ`, `z = 0`). Unlike `QOU.Hecke.MarkovInteriorBond.InteriorMarkov` (where `a` is *below*
the bond and `b` *above* it), here **both** `a` and `b` may mix generators from both sides
of `i`, in any order — the shape of an inter-nucleon bond inside a closed atom word.

## Carrier, and why

The statement lives on `QOU.MathlibExt.OcneanuTrace.MarkovTrace` with the
`HeckeSandwichReduces.BraidedTower` relations, because that is where the corpus has
already **proved** the disjoint-block law `tr (a * b) = tr a * tr b` for `a ∈ H n` and
`b ∈ shifted n` (`disjointBlock_of_braided`). The proof here is three applications of that
law plus cyclicity; nothing about a basis is needed. The concrete `H_n(q)` of
`QOU.Hecke.TwBasis` carries only the canonical trace `τ`, not a general-`z` Markov trace
object, so the statement could not be made there without first building that bridge
(bean `qou-0fmb` names the same packaging gap for the Ocneanu trace).

## Proof

1. `avoiding i` (generated by `g_t`, `t ≠ i`) is contained in the submodule product
   `below i * above i`, where `below i = ⟨g_t : t < i⟩` and `above i = ⟨g_t : t > i⟩`;
   the two commute elementwise by far-commutation (`t < i < t'` gives `t + 1 < t'`), so
   the product is closed under multiplication and contains every generator.
2. For `l ∈ below i ⊆ H i` and `r ∈ above i ⊆ shifted (i+1)`:
   `tr (l r g_i) = tr l · tr (r g_i) = tr l · tr (g_i r) = tr l · z · tr r = z · tr (l r)`.
3. `tr (a g_i b) = tr ((b a) g_i)` by cyclicity and `b a ∈ avoiding i`.

The core theorem `tr_mul_g_mul_of_disjointBlock` takes far-commutation and the
disjoint-block law as hypotheses; `tr_mul_g_mul` discharges both from `BraidedTower`.

Base ring: generic `[CommRing R]`, generic `R`-algebra `A`; no `ℝ`, no ordering. `z` is an
abstract ring element, so nothing here fixes a Markov convention.

-- Ref: [jones1987] https://doi.org/10.2307/1971403
-/

namespace QOU.Hecke.MarkovBondLetter

open QOU.MathlibExt.OcneanuTrace QOU.MathlibExt.DisjointBlockTrace
  QOU.MathlibExt.HeckeSandwichReduces

variable {R : Type*} [CommRing R] {A : Type*} [Ring A] [Algebra R A]
variable (T : MarkovTrace R A)

/-- The subalgebra generated by every generator `g_t` with `t ≠ i`. -/
def avoiding (i : ℕ) : Subalgebra R A :=
  Algebra.adjoin R {x | ∃ t : ℕ, t ≠ i ∧ x = T.g t}

/-- The subalgebra generated by the generators strictly below `i`. -/
def below (i : ℕ) : Subalgebra R A :=
  Algebra.adjoin R {x | ∃ t : ℕ, t < i ∧ x = T.g t}

/-- The subalgebra generated by the generators strictly above `i`. -/
def above (i : ℕ) : Subalgebra R A :=
  Algebra.adjoin R {x | ∃ t : ℕ, i < t ∧ x = T.g t}

theorem g_mem_shifted_of_le {n t : ℕ} (h : n ≤ t) : T.g t ∈ shifted T n := by
  have := g_mem_shifted T n (t - n)
  rwa [Nat.add_sub_cancel' h] at this

theorem below_le_H (i : ℕ) : below T i ≤ T.H i := by
  refine Algebra.adjoin_le ?_
  rintro _ ⟨t, ht, rfl⟩
  exact T.H_mono (show t + 1 ≤ i by omega) (T.g_mem t)

theorem above_le_shifted (i : ℕ) : above T i ≤ shifted T (i + 1) := by
  refine Algebra.adjoin_le ?_
  rintro _ ⟨t, ht, rfl⟩
  exact g_mem_shifted_of_le T (by omega)

theorem above_le_shifted' (i : ℕ) : above T i ≤ shifted T i := by
  refine Algebra.adjoin_le ?_
  rintro _ ⟨t, ht, rfl⟩
  exact g_mem_shifted_of_le T (by omega)

section Core

variable (hfar : ∀ m k : ℕ, k + 1 < m → T.g m * T.g k = T.g k * T.g m)
include hfar

/-- Everything below `i` commutes with everything above `i`. -/
theorem commute_below_above {i : ℕ} {l r : A} (hl : l ∈ below T i) (hr : r ∈ above T i) :
    Commute l r := by
  refine Algebra.commute_of_mem_adjoin_of_forall_mem_commute hr ?_
  rintro _ ⟨t', ht', rfl⟩
  refine (Algebra.commute_of_mem_adjoin_of_forall_mem_commute hl ?_).symm
  rintro _ ⟨t, ht, rfl⟩
  exact hfar t' t (by omega)

/-- The submodule product `below i * above i` is closed under multiplication. -/
theorem mul_mem_belowAbove {i : ℕ} {x y : A}
    (hx : x ∈ Subalgebra.toSubmodule (below T i) * Subalgebra.toSubmodule (above T i))
    (hy : y ∈ Subalgebra.toSubmodule (below T i) * Subalgebra.toSubmodule (above T i)) :
    x * y ∈ Subalgebra.toSubmodule (below T i) * Subalgebra.toSubmodule (above T i) := by
  refine Submodule.mul_induction_on hx (fun l hl r hr => ?_)
    (fun u v hu hv => by rw [add_mul]; exact Submodule.add_mem _ hu hv)
  refine Submodule.mul_induction_on hy (fun l' hl' r' hr' => ?_)
    (fun u v hu hv => by rw [mul_add]; exact Submodule.add_mem _ hu hv)
  have hc : r * l' = l' * r := (commute_below_above T hfar hl' hr).eq.symm
  have : l * r * (l' * r') = (l * l') * (r * r') := by
    rw [mul_assoc, ← mul_assoc r, hc, mul_assoc l', ← mul_assoc]
  rw [this]
  exact Submodule.mul_mem_mul (show l * l' ∈ Subalgebra.toSubmodule (below T i) from
    (below T i).mul_mem hl hl') (show r * r' ∈ Subalgebra.toSubmodule (above T i) from
    (above T i).mul_mem hr hr')

/-- `avoiding i ⊆ below i * above i`. -/
theorem avoiding_le_belowAbove (i : ℕ) :
    Subalgebra.toSubmodule (avoiding T i)
      ≤ Subalgebra.toSubmodule (below T i) * Subalgebra.toSubmodule (above T i) := by
  have h1b : (1 : A) ∈ Subalgebra.toSubmodule (below T i) := (below T i).one_mem
  have h1a : (1 : A) ∈ Subalgebra.toSubmodule (above T i) := (above T i).one_mem
  have h1 : (1 : A) ∈ Subalgebra.toSubmodule (below T i) * Subalgebra.toSubmodule (above T i) := by
    simpa using Submodule.mul_mem_mul h1b h1a
  let P : Subalgebra R A :=
    Submodule.toSubalgebra
      (Subalgebra.toSubmodule (below T i) * Subalgebra.toSubmodule (above T i)) h1
      (fun x y hx hy => mul_mem_belowAbove T hfar hx hy)
  have hle : avoiding T i ≤ P := by
    refine Algebra.adjoin_le ?_
    rintro _ ⟨t, ht, rfl⟩
    show T.g t ∈ Subalgebra.toSubmodule (below T i) * Subalgebra.toSubmodule (above T i)
    rcases Nat.lt_or_gt_of_ne ht with h | h
    · have := Submodule.mul_mem_mul
        (show T.g t ∈ Subalgebra.toSubmodule (below T i) from Algebra.subset_adjoin ⟨t, h, rfl⟩)
        (show (1 : A) ∈ Subalgebra.toSubmodule (above T i) from (above T i).one_mem)
      simpa using this
    · have := Submodule.mul_mem_mul
        (show (1 : A) ∈ Subalgebra.toSubmodule (below T i) from (below T i).one_mem)
        (show T.g t ∈ Subalgebra.toSubmodule (above T i) from Algebra.subset_adjoin ⟨t, h, rfl⟩)
      simpa using this
  intro x hx
  exact hle hx

variable (hD : DisjointBlockMultiplicative T)
include hD

/-- `tr (x * g_i) = z * tr x` for every `x` avoiding `g_i`. -/
theorem tr_mul_g_of_mem_avoiding {i : ℕ} {x : A} (hx : x ∈ avoiding T i) :
    T.tr (x * T.g i) = T.z * T.tr x := by
  have hx' := avoiding_le_belowAbove T hfar i hx
  refine Submodule.mul_induction_on hx' (fun l hl r hr => ?_)
    (fun u v hu hv => by rw [add_mul, map_add, map_add, hu, hv, mul_add])
  have hlH : l ∈ T.H i := below_le_H T i hl
  have hrS : r ∈ shifted T (i + 1) := above_le_shifted T i hr
  have hrS' : r ∈ shifted T i := above_le_shifted' T i hr
  have hgS : T.g i ∈ shifted T i := g_mem_shifted_of_le T le_rfl
  have e1 : T.tr (l * r * T.g i) = T.tr l * T.tr (r * T.g i) := by
    rw [mul_assoc]; exact hD i l hlH _ ((shifted T i).mul_mem hrS' hgS)
  have e2 : T.tr (r * T.g i) = T.z * T.tr r := by
    rw [T.tr_mul_comm, hD (i + 1) (T.g i) (T.g_mem i) r hrS, MarkovTrace.tr_gen]
  have e3 : T.tr (l * r) = T.tr l * T.tr r := hD i l hlH r hrS'
  rw [e1, e2, e3]; ring

/-- **The bond letter, core form.** For `a, b` avoiding `g_i`,
`tr (a * g_i * b) = z * tr (a * b)`, given far-commutation and the disjoint-block law. -/
theorem tr_mul_g_mul_of_disjointBlock {i : ℕ} {a b : A}
    (ha : a ∈ avoiding T i) (hb : b ∈ avoiding T i) :
    T.tr (a * T.g i * b) = T.z * T.tr (a * b) := by
  rw [T.tr_mul_comm, ← mul_assoc, tr_mul_g_of_mem_avoiding T hfar hD
    ((avoiding T i).mul_mem hb ha), T.tr_mul_comm]

end Core

section Braided

variable [hbt : BraidedTower T]

theorem far_of_braided (m k : ℕ) (h : k + 1 < m) : T.g m * T.g k = T.g k * T.g m :=
  hbt.far m k h

/-- **The bond letter on every braided tower.** For a Markov trace with parameter `z` on a
tower satisfying the Iwahori–Hecke relations, and `a, b` generated by the `g_t` with
`t ≠ i`: `tr (a * g_i * b) = z * tr (a * b)`. -/
theorem tr_mul_g_mul {i : ℕ} {a b : A} (ha : a ∈ avoiding T i) (hb : b ∈ avoiding T i) :
    T.tr (a * T.g i * b) = T.z * T.tr (a * b) :=
  tr_mul_g_mul_of_disjointBlock T (far_of_braided T) (disjointBlock_of_braided T) ha hb

/-- **A letter `c • g_i + d • 1` on a generator used nowhere else contributes `c z + d`:**
`tr (a * (c • g_i + d • 1) * b) = (c * z + d) * tr (a * b)`. At `z = 0` this is the
`τ` statement `QOU.Hecke.TwBasis.tau_bond_letter`. -/
theorem tr_bond_letter {i : ℕ} {a b : A} (ha : a ∈ avoiding T i) (hb : b ∈ avoiding T i)
    (c d : R) :
    T.tr (a * (c • T.g i + d • (1 : A)) * b) = (c * T.z + d) * T.tr (a * b) := by
  have hlin : a * (c • T.g i + d • (1 : A)) * b = c • (a * T.g i * b) + d • (a * b) := by
    rw [mul_add, add_mul, mul_smul_comm, smul_mul_assoc, mul_smul_comm, mul_one,
      smul_mul_assoc]
  rw [hlin, map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul, tr_mul_g_mul T ha hb]
  ring

end Braided

end QOU.Hecke.MarkovBondLetter
