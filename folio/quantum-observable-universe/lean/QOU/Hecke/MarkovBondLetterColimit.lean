import QOU.Hecke.MarkovBondLetter
import QOU.SchurWeyl.HeckeColimitFamilyTrace
import QOU.SchurWeyl.MarkovTraceInstance

/-!
# The bond-letter law on the Hecke colimit, at every `z` for which a Markov family is given

Bean `qou-5zl1`, step 2.  `MarkovBondLetter.tr_bond_letter` proves, for any Markov
trace with parameter `z` on any braided tower and `a, b` generated by the `g_t`
with `t ≠ i`,

    tr (a * (c • g_i + d • 1) * b) = (c z + d) * tr (a * b).

`HeckeColimitFamilyTrace.ocneanuMarkovTraceAt` supplies the braided tower: the
`heckeIncl` colimit of `Hecke K q qi n`, carrying the lift of any
`MarkovTraceFamily` at parameter `z`.  This file instantiates the law there.

| declaration | content |
|---|---|
| `tr_bond_letter_colimit` | the law on the colimit, for any family at any `z` |
| `tr_bond_letter_colimit_of_z_eq_zero` | at `z = 0` the factor is `d` |
| `tr_bare_bond_colimit_of_z_eq_zero` | at `z = 0` a bare `g_i` used once gives trace `0` |
| `tr_bond_letter_conventionD` | the law for the proved convention-D Ocneanu trace: factor `c · q³/(q²+1) + d` |

## The `z = 0` check

At `z = 0` the factor `c z + d` is `d`, and a bare generator (`c = 1, d = 0`)
gives `0`.  These are exactly the statements `TauBondLetter.tau_bond_letter` and
`tau_bare_bond_eq_zero` prove for the canonical trace `τ` (`τ(T_w) = δ_{w,1}`) on
`QOU.Hecke.IwahoriHecke`.  The two agree **in form**: the general law specialised
to `z = 0` returns the `τ` law's scalar.  They are proved on **different
carriers** — `τ` lives on `QOU.Hecke.IwahoriHecke`, the colimit is built from
`QOU.SchurWeyl.Hecke` — and this file does not build a `z = 0`
`MarkovTraceFamily` on the SchurWeyl tower, so the agreement is a consistency
check of the formula, not a transport of `τ`.  The `z = 0` statements here hold
for whatever family at `z = 0` is supplied.

## What is NOT claimed

The bond scalars `c, d` are inputs.  Which letters the production atom word uses
is not derived here (bean `qou-qqm4`).

Base ring: generic `[CommRing K]` for the general statements; the convention-D
corollary is over a generic `[Field K]`.  No `ℝ`.

-- Ref: [jones1987] https://doi.org/10.2307/1971403
-- Ref: [leitner2026] beans qou-5zl1 / qou-slz5 / qou-qqm4.
-/

namespace QOU.Hecke.MarkovBondLetterColimit

open QOU.Hecke.MarkovBondLetter QOU.SchurWeyl.HeckeColimitFamilyTrace
open QOU.SchurWeyl QOU.SchurWeyl.HeckeColimit QOU.MathlibExt.OcneanuTrace

section General

variable {K : Type*} [CommRing K] {q qi z : K}
variable (U : HeckeCoset.MarkovTraceFamily K q qi z) (hqi : q * qi = 1)

/-- **The bond-letter law on the Hecke colimit.** -/
theorem tr_bond_letter_colimit {i : ℕ} {a b : HeckeLim K q qi}
    (ha : a ∈ avoiding (ocneanuMarkovTraceAt U hqi) i)
    (hb : b ∈ avoiding (ocneanuMarkovTraceAt U hqi) i) (c d : K) :
    trFam U (a * (c • gLim K q qi i + d • (1 : HeckeLim K q qi)) * b)
      = (c * z + d) * trFam U (a * b) :=
  tr_bond_letter (ocneanuMarkovTraceAt U hqi) ha hb c d

/-- **`z = 0`: the letter contributes `d`**, the scalar of `TauBondLetter.tau_bond_letter`. -/
theorem tr_bond_letter_colimit_of_z_eq_zero (hz : z = 0) {i : ℕ} {a b : HeckeLim K q qi}
    (ha : a ∈ avoiding (ocneanuMarkovTraceAt U hqi) i)
    (hb : b ∈ avoiding (ocneanuMarkovTraceAt U hqi) i) (c d : K) :
    trFam U (a * (c • gLim K q qi i + d • (1 : HeckeLim K q qi)) * b)
      = d * trFam U (a * b) := by
  rw [tr_bond_letter_colimit U hqi ha hb c d]
  simp [hz]

/-- **`z = 0`: a bare generator used once kills the trace**, the colimit form of
`TauBondLetter.tau_bare_bond_eq_zero`. -/
theorem tr_bare_bond_colimit_of_z_eq_zero (hz : z = 0) {i : ℕ} {a b : HeckeLim K q qi}
    (ha : a ∈ avoiding (ocneanuMarkovTraceAt U hqi) i)
    (hb : b ∈ avoiding (ocneanuMarkovTraceAt U hqi) i) :
    trFam U (a * gLim K q qi i * b) = 0 := by
  have := tr_bond_letter_colimit_of_z_eq_zero U hqi hz ha hb 1 0
  rwa [one_smul, zero_smul, add_zero, zero_mul] at this

end General

section ConventionD

variable {K : Type*} [Field K] (q : K) (hq0 : q ≠ 0)
  (hq2 : GenericParameter.NotRootOfUnity q) (hq21 : q ^ 2 + 1 ≠ 0)
  (hgen : ∀ i : ℕ, 0 < i → (q ^ 2 : K) ^ i ≠ 1)

/-- The proved convention-D Ocneanu trace, as a braided-tower Markov trace on the
colimit, over any field. -/
noncomputable abbrev conventionDColimit : MarkovTrace K (HeckeLim K q q⁻¹) :=
  ocneanuMarkovTraceAt (SeminormalRep.ocneanuMarkovTrace q hq0 hq2 hq21 hgen)
    (mul_inv_cancel₀ hq0)

/-- **The bond-letter law for the convention-D Ocneanu trace**: a letter
`c • g_i + d • 1` on a generator used once contributes `c · q³/(q²+1) + d`. -/
theorem tr_bond_letter_conventionD {i : ℕ} {a b : HeckeLim K q q⁻¹}
    (ha : a ∈ avoiding (conventionDColimit q hq0 hq2 hq21 hgen) i)
    (hb : b ∈ avoiding (conventionDColimit q hq0 hq2 hq21 hgen) i) (c d : K) :
    (conventionDColimit q hq0 hq2 hq21 hgen).tr
        (a * (c • gLim K q q⁻¹ i + d • (1 : HeckeLim K q q⁻¹)) * b)
      = (c * (q ^ 3 / (q ^ 2 + 1)) + d)
          * (conventionDColimit q hq0 hq2 hq21 hgen).tr (a * b) :=
  tr_bond_letter (conventionDColimit q hq0 hq2 hq21 hgen) ha hb c d

end ConventionD

end QOU.Hecke.MarkovBondLetterColimit
