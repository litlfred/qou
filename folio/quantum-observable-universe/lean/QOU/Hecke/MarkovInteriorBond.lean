import Mathlib.Algebra.MvPolynomial.CommRing
import Mathlib.Algebra.MvPolynomial.Supported
import Mathlib.Algebra.MvPolynomial.Variables
import Mathlib.Algebra.BigOperators.Ring.Finset
import Mathlib.LinearAlgebra.Finsupp.LinearCombination
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.Ring
import QOU.MathlibExt.MarkovUnusedGenerator

/-!
# The interior-bond rule for NON-monotone block words: what the Markov axioms
# do and do not give

`QOU.MathlibExt.MarkovUnusedGenerator.tr_wordProd_mul_sigma` derives the bond
rule `tr (W * σ_g) = z * tr W` from the Markov-tower axioms for a **monotone**
word `W` omitting `g`.  `QOU.Hecke.MarkovBondFactor` records that the general
`A`-bond factorisation "needs the cross-level Markov axiom (or a word-induction
principle) that the class does not yet carry".  Bean `qou-gr3t` asks for the
statement the compute actually measured (route C step 3, `n = 9`, exact in `q`):
with `a` a word on the strands **below** an interior bond generator `σ_g` and `b`
an arbitrary — in particular non-monotone — word on the strands **above** it,

  `tr (a * σ_g * b) = z * tr (a * b)`.                                   (S1)

This file settles what the tower axioms can and cannot say about (S1).

## Results

* `InteriorMarkov T` — (S1) as a **`Prop` about a tower**, with `a ∈ H g` and
  `b` in the subalgebra generated by `σ_{g+1}, σ_{g+2}, …` (the block above the
  bond starts at `σ_{g+1}`, adjacent to the bond — this is the nucleon geometry
  of the probe, where nucleon `k` uses `σ_{3k}, σ_{3k+1}` and the bond is
  `σ_{3k+2}`).  It is a hypothesis, never a field and never an axiom.
* `tr_bond_of_interiorMarkov` — **(S2)**: the `(z + d)` bond letter, conditional
  on `InteriorMarkov`.  Pure linearity on top of (S1).
* `tr_bondWord_of_interiorMarkov` — **(S3)**: the `A`-bond product
  `tr (x₀ (σ_{g₀}+d₀) x₁ (σ_{g₁}+d₁) ⋯ x_A) = ∏ (z + d_k) · tr (x₀ x₁ ⋯ x_A)`
  for strictly increasing bonds with blocks in between, conditional on
  `InteriorMarkov`, by induction on the number of bonds.  This is the identity
  the probe measured, at full generality of the blocks.
* `interiorMarkov_ascending` — the axioms **do** give (S1) when `b` is an
  ascending word `σ_{g+1} σ_{g+2} ⋯ σ_{g+k}` (iterated stabilisation), for an
  arbitrary `a ∈ H g`.  This is the monotone case of `qou-g8i1` in the
  `a * σ_g * b` shape.
* `exists_not_interiorMarkov` — **the axioms do NOT give (S1) in general.**  A
  Markov tower is exhibited in which `tr (σ_0 * σ_2 ^ 2) = 0` while
  `z * tr (σ_2 ^ 2) = z = 1`.  The witness `b = σ_2²` even lies in
  `⟨σ_{g+2}, …⟩`, i.e. commutes with `σ_g` by far-commutation, so the stronger
  "commuting-`b`" form of (S1) fails too (`exists_not_interiorMarkovFar`).

## What the counter-model shows

The interior-bond rule for non-monotone `b` is **not** a consequence of the
trace axioms (tower, far-commutation, cyclicity, Markov at the top).  Every
model in which it holds — the Iwahori–Hecke tower first among them — holds it
because of structure the tower axioms do not carry: the quadratic relation
`σ² = h σ + 1` (which is exactly what kills the monomial `σ_2²` in the
counter-model) together with the braid relation and the resulting spanning
`H_{n+1} = H_n + H_n σ_n H_n`, i.e. Ocneanu's uniqueness argument.  The
"cross-level Markov axiom" named in `MarkovBondFactor` is therefore not
derivable at the trace-axiom level: it is either an additional hypothesis (as
`InteriorMarkov` is stated here) or a theorem of the Hecke algebra proved
through its basis.  That theorem is not in this file and is not claimed.

The counter-model is commutative and degenerate as a model of braids — the point
is only that the axioms admit it.  Its trace is the monomial functional
`f(μ) = z^{|μ|}` on squarefree monomials, `f(X₂²) = 1`, and `0` otherwise; the
Markov property at every level is checked by cases on the level.

## Base ring

Generic `[CommRing R]`, generic `R`-algebra `A`; the counter-model needs
`[Nontrivial R]` only so that `1 ≠ 0`.  No `ℝ`, no ordering, no archimedean
content.  `z` is an abstract ring element throughout, so nothing here is a
convention-C or convention-D statement.

-- Ref: [jones1987] https://doi.org/10.2307/1971403
-- Ref: [wenzl1988] https://doi.org/10.1007/BF01393699
-- Ref: [leitner2026] docs/audits/2026-09-07-route-c-step3-and-kz-level-plans.md §0b
-/

namespace QOU.Hecke.MarkovInteriorBond

open QOU.MathlibExt.MarkovUnusedGenerator

variable {R : Type*} [CommRing R]
variable {A : Type*} [Ring A] [Algebra R A]
variable (T : MarkovTower R A)

/-! ## The subalgebra above a bond, and the interior-Markov statement -/

/-- The subalgebra generated by the generators **strictly above** the bond `g`:
`σ_{g+1}, σ_{g+2}, …`.  A word for the nucleon block above the bond lives here;
it need not be monotone and need not commute with `σ_g`. -/
def upper (g : ℕ) : Subalgebra R A :=
  Algebra.adjoin R (Set.range fun k : ℕ => T.σ (g + 1 + k))

theorem σ_mem_upper {g m : ℕ} (h : g < m) : T.σ m ∈ upper T g :=
  Algebra.subset_adjoin ⟨m - (g + 1), by
    show T.σ (g + 1 + (m - (g + 1))) = T.σ m
    rw [Nat.add_sub_cancel' (by omega : g + 1 ≤ m)]⟩

/-- `upper` is antitone: a word above a higher bond is above every lower bond. -/
theorem upper_anti {g g' : ℕ} (h : g ≤ g') : upper T g' ≤ upper T g := by
  unfold upper
  apply Algebra.adjoin_mono
  rintro _ ⟨k, rfl⟩
  refine ⟨g' + 1 + k - (g + 1), ?_⟩
  show T.σ (g + 1 + (g' + 1 + k - (g + 1))) = T.σ (g' + 1 + k)
  rw [Nat.add_sub_cancel' (by omega : g + 1 ≤ g' + 1 + k)]

/-- **(S1) — the interior-Markov statement**, as a `Prop` about a tower.

For every bond `g`, every `a` below it and every `b` above it,
`tr (a * σ_g * b) = z * tr (a * b)`.  This is the statement the route-C probe
measured on the canonical non-monotone nucleon word.  It is *not* a field of
`MarkovTower`: `exists_not_interiorMarkov` below shows it is independent of the
tower axioms. -/
def InteriorMarkov : Prop :=
  ∀ g : ℕ, ∀ a ∈ T.H g, ∀ b ∈ upper T g, T.tr (a * T.σ g * b) = T.z * T.tr (a * b)

/-- The weaker "commuting" form: `b` generated by `σ_{g+2}, …` only, so that
`b` commutes with `σ_g` by far-commutation.  Implied by `InteriorMarkov`. -/
def InteriorMarkovFar : Prop :=
  ∀ g : ℕ, ∀ a ∈ T.H g, ∀ b ∈ upper T (g + 1),
    T.tr (a * T.σ g * b) = T.z * T.tr (a * b)

theorem InteriorMarkov.far (h : InteriorMarkov T) : InteriorMarkovFar T :=
  fun g a ha b hb => h g a ha b (upper_anti T (Nat.le_succ g) hb)

/-! ## (S2): the `(z + d)` bond letter, conditional on (S1) -/

/-- **(S2)** `tr (a * (σ_g + d • 1) * b) = (z + d) * tr (a * b)`, for `a` below
and `b` above the bond, **conditional on `InteriorMarkov`**.  Linearity only. -/
theorem tr_bond_of_interiorMarkov (hT : InteriorMarkov T) {g : ℕ} {a b : A}
    (ha : a ∈ T.H g) (hb : b ∈ upper T g) (d : R) :
    T.tr (a * (T.σ g + d • (1 : A)) * b) = (T.z + d) * T.tr (a * b) := by
  have hlin : a * (T.σ g + d • (1 : A)) * b = a * T.σ g * b + d • (a * b) := by
    rw [mul_add, add_mul, mul_smul_comm, mul_one, smul_mul_assoc]
  rw [hlin, map_add, map_smul, smul_eq_mul, hT g a ha b hb]
  ring

/-! ## (S3): the `A`-bond product, conditional on (S1)

A chain is a first block `x` followed by a list of `(bond generator, bond
offset, next block)` triples.  `bondWord` inserts the bond letters,
`freeWord` omits them. -/

/-- `x * (σ_{g₀} + d₀) * y₀ * (σ_{g₁} + d₁) * y₁ * ⋯`, associated as
`x * ℓ₀ * (y₀ * ℓ₁ * (y₁ * ⋯))`. -/
def bondWord : A → List (ℕ × R × A) → A
  | x, [] => x
  | x, (g, d, y) :: rest => x * (T.σ g + d • (1 : A)) * bondWord y rest

/-- The same chain with every bond letter deleted: `x * y₀ * y₁ * ⋯`. -/
def freeWord : A → List (ℕ × R × A) → A
  | x, [] => x
  | x, (_, _, y) :: rest => x * freeWord y rest

/-- The chain hypotheses: bonds strictly increase along the chain, each block
lies above the bond preceding it, and each block that is followed by a bond lies
below that bond. -/
def ChainOK : List (ℕ × R × A) → Prop
  | [] => True
  | [(g, _, y)] => y ∈ upper T g
  | (g, _, y) :: (g', d', y') :: rest =>
      y ∈ upper T g ∧ y ∈ T.H g' ∧ g < g' ∧ ChainOK ((g', d', y') :: rest)

/-- The bond generator at the head of a chain (`0` for the empty chain, in which
case the hypothesis mentioning it is vacuous). -/
def headBond : List (ℕ × R × A) → ℕ
  | [] => 0
  | (g, _, _) :: _ => g

omit [CommRing R] [Algebra R A] in
theorem freeWord_cons (x : A) (g : ℕ) (d : R) (y : A) (rest : List (ℕ × R × A)) :
    freeWord x ((g, d, y) :: rest) = x * freeWord y rest := rfl

theorem bondWord_cons (x : A) (g : ℕ) (d : R) (y : A) (rest : List (ℕ × R × A)) :
    bondWord T x ((g, d, y) :: rest) = x * (T.σ g + d • (1 : A)) * bondWord T y rest :=
  rfl

omit [CommRing R] [Algebra R A] in
theorem freeWord_mul (x y : A) (l : List (ℕ × R × A)) :
    freeWord (x * y) l = x * freeWord y l := by
  cases l with
  | nil => rfl
  | cons p rest =>
    obtain ⟨g, d, y'⟩ := p
    simp only [freeWord_cons, mul_assoc]

theorem bondWord_mul (x y : A) (l : List (ℕ × R × A)) :
    bondWord T (x * y) l = x * bondWord T y l := by
  cases l with
  | nil => rfl
  | cons p rest =>
    obtain ⟨g, d, y'⟩ := p
    simp only [bondWord_cons, mul_assoc]

/-- Everything from a chain's first block onward lies above every bond `g` at or
below the chain's head bond. -/
theorem bondWord_mem_upper :
    ∀ (l : List (ℕ × R × A)) (g₀ : ℕ) (d₀ : R) (y : A), ChainOK T ((g₀, d₀, y) :: l) →
      ∀ g ≤ g₀, bondWord T y l ∈ upper T g := by
  intro l
  induction l with
  | nil =>
    intro g₀ d₀ y hc g hg
    exact upper_anti T hg hc
  | cons p rest ih =>
    intro g₀ d₀ y hc g hg
    obtain ⟨g₁, d₁, y₁⟩ := p
    obtain ⟨hy, -, hlt, hc'⟩ := hc
    rw [bondWord_cons]
    refine (upper T g).mul_mem ((upper T g).mul_mem (upper_anti T hg hy) ?_)
      (ih g₁ d₁ y₁ hc' g (by omega))
    exact (upper T g).add_mem (σ_mem_upper T (by omega))
      ((upper T g).smul_mem (upper T g).one_mem d₁)

/-- **(S3) — the `A`-bond product**, conditional on `InteriorMarkov`.

For a chain `x * (σ_{g₀}+d₀) * y₀ * (σ_{g₁}+d₁) * y₁ * ⋯ * y_{A}` with strictly
increasing bonds, blocks between them, and `x` below the first bond,

  `tr (bondWord) = (∏_k (z + d_k)) * tr (freeWord)`.

Induction on the number of bonds; each step is (S2) at the leading bond with
`a := x` and `b :=` the entire remainder of the chain, then the remainder is
re-associated so that the next block joins the prefix. -/
theorem tr_bondWord_of_interiorMarkov (hT : InteriorMarkov T) :
    ∀ (l : List (ℕ × R × A)) (x : A), ChainOK T l → x ∈ T.H (headBond l) →
      T.tr (bondWord T x l)
        = (l.map fun p => T.z + p.2.1).prod * T.tr (freeWord x l) := by
  intro l
  induction l with
  | nil => intro x _ _; simp [bondWord, freeWord]
  | cons p rest ih =>
    intro x hc hx
    obtain ⟨g, d, y⟩ := p
    have hx' : x ∈ T.H g := hx
    have hb : bondWord T y rest ∈ upper T g := bondWord_mem_upper T rest g d y hc g le_rfl
    rw [bondWord_cons, tr_bond_of_interiorMarkov T hT hx' hb d, List.map_cons,
      List.prod_cons, freeWord_cons, mul_assoc (T.z + d)]
    congr 1
    cases rest with
    | nil => simp [bondWord, freeWord]
    | cons p' rest' =>
      obtain ⟨g', d', y'⟩ := p'
      obtain ⟨-, hyH, hlt, hc'⟩ := hc
      have hxy : x * y ∈ T.H g' := (T.H g').mul_mem (T.H_mono (le_of_lt hlt) hx') hyH
      have := ih (x * y) hc' hxy
      rw [bondWord_mul, freeWord_mul] at this
      exact this

/-! ## What the axioms DO give: ascending words above the bond -/

/-- The ascending word `σ_n * σ_{n+1} * ⋯ * σ_{n+k-1}`. -/
def asc (n : ℕ) : ℕ → A
  | 0 => 1
  | k + 1 => asc n k * T.σ (n + k)

theorem asc_mem (n k : ℕ) : asc T n k ∈ T.H (n + k) := by
  induction k with
  | zero => simp [asc]
  | succ k ih =>
    exact (T.H (n + (k + 1))).mul_mem (T.H_mono (by omega) ih)
      (T.H_mono (by omega) (T.σ_mem (n + k)))

theorem asc_mem_upper (g n k : ℕ) (h : g < n) : asc T n k ∈ upper T g := by
  induction k with
  | zero => simp [asc]
  | succ k ih => exact (upper T g).mul_mem ih (σ_mem_upper T (by omega))

/-- Iterated stabilisation: `tr (a * asc n k) = z ^ k * tr a` for `a ∈ H n`. -/
theorem tr_mul_asc (n : ℕ) : ∀ (k : ℕ) (a : A), a ∈ T.H n →
    T.tr (a * asc T n k) = T.z ^ k * T.tr a := by
  intro k
  induction k with
  | zero => intro a _; simp [asc]
  | succ k ih =>
    intro a ha
    have hmem : a * asc T n k ∈ T.H (n + k) :=
      (T.H (n + k)).mul_mem (T.H_mono (Nat.le_add_right n k) ha) (asc_mem T n k)
    rw [show asc T n (k + 1) = asc T n k * T.σ (n + k) from rfl, ← mul_assoc,
      T.markov (n + k) _ hmem, ih a ha, pow_succ]
    ring

/-- **(S1) holds for ascending `b`.**  For `a ∈ H g` and `b = σ_{g+1} ⋯ σ_{g+k}`,
`tr (a * σ_g * b) = z * tr (a * b)`, from the Markov axioms alone.  This is the
monotone case, and it is the whole of what the axioms give. -/
theorem interiorMarkov_ascending (g k : ℕ) (a : A) (ha : a ∈ T.H g) :
    T.tr (a * T.σ g * asc T (g + 1) k) = T.z * T.tr (a * asc T (g + 1) k) := by
  have h1 : a * T.σ g ∈ T.H (g + 1) :=
    (T.H (g + 1)).mul_mem (T.H_mono (Nat.le_succ g) ha) (T.σ_mem g)
  rw [tr_mul_asc T (g + 1) k _ h1, T.markov g a ha,
    tr_mul_asc T (g + 1) k a (T.H_mono (Nat.le_succ g) ha)]
  ring

/-! ## What the axioms do NOT give: a counter-model

`A = R[X₀, X₁, X₂]`, `σ_i = X_i` for `i < 3` and `σ_n = z • 1` for `n ≥ 3`,
`H n` the polynomials in the variables of index `< n`, `z = 1`, and the trace
the monomial functional `f` below.  Markov at every level holds; the interior
rule fails at `g = 0`, `a = 1`, `b = X₂²`. -/

section CounterModel

open MvPolynomial

variable (R) in
/-- The monomial functional: `z^{|μ|}` on squarefree monomials, `1` on `X₂²`,
`0` otherwise.  Only `z = 1` is used below, but the Markov check goes through for
every `z`. -/
noncomputable def cmF (z : R) (μ : Fin 3 →₀ ℕ) : R :=
  if μ = Finsupp.single 2 2 then 1
  else if μ 0 ≤ 1 ∧ μ 1 ≤ 1 ∧ μ 2 ≤ 1 then z ^ (μ 0 + μ 1 + μ 2) else 0

/-- The trace of the counter-model: the linear extension of `cmF`. -/
noncomputable def cmTr (z : R) : MvPolynomial (Fin 3) R →ₗ[R] R :=
  Finsupp.linearCombination R (cmF R z)

theorem cmTr_monomial (z : R) (μ : Fin 3 →₀ ℕ) (c : R) :
    cmTr z (monomial μ c) = c * cmF R z μ := by
  unfold cmTr
  rw [← single_eq_monomial]
  exact (Finsupp.linearCombination_single _ _ _).trans (smul_eq_mul _ _)

/-- A monomial in the support of a polynomial supported on `{i | i < n}` has
zero exponent at every index `≥ n`. -/
theorem exponent_eq_zero_of_mem_supported {n : ℕ} {p : MvPolynomial (Fin 3) R}
    (hp : p ∈ supported R {i : Fin 3 | (i : ℕ) < n}) {μ : Fin 3 →₀ ℕ}
    (hμ : μ ∈ p.support) {i : Fin 3} (hi : n ≤ (i : ℕ)) : μ i = 0 := by
  by_contra h
  have hi' : i ∈ p.vars := (mem_vars i).mpr ⟨μ, hμ, Finsupp.mem_support_iff.mpr h⟩
  have := (mem_supported.mp hp) hi'
  simp only [Set.mem_setOf_eq] at this
  omega

/-- The single-monomial Markov step: for `n < 3` and `μ` with zero exponents at
indices `≥ n`, `cmF (μ + e_n) = z * cmF μ`. -/
theorem cmF_add_single (z : R) (n : Fin 3) (μ : Fin 3 →₀ ℕ)
    (hμ : ∀ i : Fin 3, (n : ℕ) ≤ (i : ℕ) → μ i = 0) :
    cmF R z (μ + Finsupp.single n 1) = z * cmF R z μ := by
  have hne : ∀ ν : Fin 3 →₀ ℕ, ν 2 ≠ 2 → ν ≠ Finsupp.single 2 2 := by
    intro ν hν h
    apply hν
    rw [h]
    simp
  have h2 : μ 2 = 0 := hμ 2 (by have := n.isLt; simp; omega)
  have hA : μ + Finsupp.single n 1 ≠ Finsupp.single 2 2 := by
    apply hne
    simp only [Finsupp.add_apply, Finsupp.single_apply, h2]
    split_ifs <;> omega
  have hB : μ ≠ Finsupp.single 2 2 := hne μ (by simp [h2])
  unfold cmF
  rw [if_neg hA, if_neg hB]
  fin_cases n
  · have h0 : μ 0 = 0 := hμ 0 (by simp)
    have h1 : μ 1 = 0 := hμ 1 (by simp)
    simp +decide [h0, h1, h2]
  · have h1 : μ 1 = 0 := hμ 1 (by simp)
    simp +decide [h1, h2]
    split_ifs <;> ring
  · simp +decide [h2]
    split_ifs <;> ring

/-- Markov at a genuine variable: for `a` supported below `n`,
`cmTr (a * X n) = z * cmTr a`. -/
theorem cmTr_mul_X (z : R) (n : Fin 3) (a : MvPolynomial (Fin 3) R)
    (ha : a ∈ supported R {i : Fin 3 | (i : ℕ) < (n : ℕ)}) :
    cmTr z (a * X n) = z * cmTr z a := by
  conv_lhs => rw [as_sum a]
  conv_rhs => rw [as_sum a]
  rw [Finset.sum_mul, map_sum, map_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl fun μ hμ => ?_
  have hX : X n = monomial (Finsupp.single n 1) (1 : R) := rfl
  rw [hX, monomial_mul, cmTr_monomial, cmTr_monomial, mul_one,
    cmF_add_single z n μ (fun i hi => exponent_eq_zero_of_mem_supported ha hμ hi)]
  ring

variable (R) in
/-- The counter-model tower: `σ_i = X_i` for `i < 3`, `σ_n = 1` above, `z = 1`,
`H n` = polynomials in the variables of index `< n`, trace `cmTr 1`. -/
noncomputable def cmTower [Nontrivial R] : MarkovTower R (MvPolynomial (Fin 3) R) where
  H := fun n => supported R {i : Fin 3 | (i : ℕ) < n}
  H_mono := fun _ _ h => supported_mono fun i hi => by
    simp only [Set.mem_setOf_eq] at hi ⊢; omega
  σ := fun n => if h : n < 3 then X ⟨n, h⟩ else 1
  σ_mem := fun n => by
    by_cases h : n < 3
    · rw [dif_pos h]
      exact (X_mem_supported (R := R)).mpr (by simp)
    · rw [dif_neg h]
      exact (supported R _).one_mem
  far_comm := fun _ _ _ => mul_comm _ _
  tr := cmTr 1
  tr_comm := fun a b => by rw [mul_comm]
  z := 1
  markov := fun n a ha => by
    by_cases h : n < 3
    · rw [dif_pos h]
      exact cmTr_mul_X 1 ⟨n, h⟩ a ha
    · rw [dif_neg h, mul_one, one_mul]

variable [Nontrivial R]

theorem cmTower_σ_two : (cmTower R).σ 2 = X 2 := by
  show (if h : (2 : ℕ) < 3 then X ⟨2, h⟩ else (1 : MvPolynomial (Fin 3) R)) = X 2
  rw [dif_pos (by norm_num : (2 : ℕ) < 3)]
  rfl

theorem cmTower_σ_zero : (cmTower R).σ 0 = X 0 := by
  show (if h : (0 : ℕ) < 3 then X ⟨0, h⟩ else (1 : MvPolynomial (Fin 3) R)) = X 0
  rw [dif_pos (by norm_num : (0 : ℕ) < 3)]
  rfl

omit [Nontrivial R] in
/-- The value the interior rule would need: `tr (X₀ * X₂²) = 0`. -/
theorem cmTr_X0_X2_sq : cmTr (1 : R) (X 0 * X 2 ^ 2) = 0 := by
  have hX : X (0 : Fin 3) = monomial (Finsupp.single 0 1) (1 : R) := rfl
  rw [X_pow_eq_monomial, hX, monomial_mul, cmTr_monomial, mul_one]
  have h1 : (Finsupp.single (0 : Fin 3) 1 + Finsupp.single 2 2 : Fin 3 →₀ ℕ)
      ≠ Finsupp.single 2 2 := by
    intro h
    have := DFunLike.congr_fun h 0
    simp at this
  simp [cmF, h1]

omit [Nontrivial R] in
/-- The other side: `tr (X₂²) = 1`. -/
theorem cmTr_X2_sq : cmTr (1 : R) (X 2 ^ 2) = 1 := by
  rw [X_pow_eq_monomial, cmTr_monomial, one_mul]
  simp [cmF]

/-- **The commuting form of (S1) is not a consequence of the tower axioms.**
In `cmTower`, with `g = 0`, `a = 1` and `b = σ_2² ∈ ⟨σ_2, …⟩`,
`tr (a * σ_0 * b) = 0` but `z * tr (a * b) = 1`. -/
theorem not_interiorMarkovFar_cmTower : ¬ InteriorMarkovFar (cmTower R) := by
  intro h
  have hb : (cmTower R).σ 2 ^ 2 ∈ upper (cmTower R) (0 + 1) :=
    (upper _ _).pow_mem (σ_mem_upper _ (by norm_num)) 2
  have := h 0 1 ((cmTower R).H 0).one_mem _ hb
  rw [cmTower_σ_two, cmTower_σ_zero, one_mul, one_mul] at this
  change cmTr (1 : R) (X 0 * X 2 ^ 2) = 1 * cmTr (1 : R) (X 2 ^ 2) at this
  rw [cmTr_X0_X2_sq, cmTr_X2_sq, mul_one] at this
  exact zero_ne_one this

/-- **(S1) is not a consequence of the tower axioms.** -/
theorem not_interiorMarkov_cmTower : ¬ InteriorMarkov (cmTower R) :=
  fun h => not_interiorMarkovFar_cmTower (h.far)

/-- Existence form, for citation: some Markov tower violates the interior rule
even in its commuting form. -/
theorem exists_not_interiorMarkovFar :
    ∃ T : MarkovTower R (MvPolynomial (Fin 3) R), ¬ InteriorMarkovFar T :=
  ⟨cmTower R, not_interiorMarkovFar_cmTower⟩

theorem exists_not_interiorMarkov :
    ∃ T : MarkovTower R (MvPolynomial (Fin 3) R), ¬ InteriorMarkov T :=
  ⟨cmTower R, not_interiorMarkov_cmTower⟩

