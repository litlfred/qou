import QOU.Core.QuantaleCut
import UGB.GrobnerShirshov.NormalFormBasisProof

/-!
# QOU.Core.GroebnerErrorNear — a Gröbner–Shirshov normal form decides "agree to order `n`"

Companion to `QOU.Core.ErrorFiltration`. There the error of order `n` is membership in the
`n`-th ideal of a filtration. Here the filtration is an ideal **of words**: each level is
the two-sided ideal `systemIdeal (sys n)` of the free algebra `k⟨G⟩` generated by a
rewriting system `sys n`, and the near relation is the adic one of the cut core
(`submoduleNear`, the module form of `adicNear`).

When `sys n` is a Gröbner–Shirshov basis (every S-polynomial, overlap and inclusion,
reduces to zero) with unit leading coefficients, the normal-form map `nfMap` of
`UGB.GrobnerShirshov.NFBasis` decides membership:

* `mem_systemIdeal_iff_nfMap_eq_zero`: `x ∈ (sys) ↔ nf x = 0`;
* `GSTower.near_iff`: `x` and `y` agree to order `n` iff `nf_n (x − y) = 0`;
* `GSTower.near_iff_nf_eq`: equivalently `nf_n x = nf_n y`, so the normal form is a
  canonical representative of a value up to an error of order `n`.

Both directions come from two facts proved in `UGB`: the normal-form map kills the
ideal (`ideal_le_ker`), and every element is congruent to its normal form
(`sub_nfMap_mem`).

**S-polynomial iterates.** Passing from level `n` to `n + 1` adds rules; by
`UGB.GrobnerShirshov.jet_stratified_gs_criterion` only S-polynomials involving a new rule
need checking. That completion is what supplies the hypothesis `gs` level by level.

**Local versus global order.** Infinitesimal error lives in a local ring, where the
dominant term is the *lowest* order and that order is not a well-order. Including the
truncation `F (N + 1)` in each `sys n` makes the quotient finite-dimensional, so an
ordinary admissible (well-founded) order and Gröbner–Shirshov reduction apply; without
truncation one needs Mora-type standard bases instead.

No `sorry`, no axiom beyond Lean's three, no empirical value.
-/

namespace QOU.Core.GroebnerErrorNear

open QOU.Core.LawvereCut UGB.GrobnerShirshov UGB.GrobnerShirshov.NFBasis

/-- The adic near system of an antitone tower of submodules: `x − y ∈ I n`. -/
def submoduleNear {k M : Type*} [Ring k] [AddCommGroup M] [Module k M]
    (I : ℕ → Submodule k M) (hI : Antitone I) : NearSystem AdicLevel M where
  near ε x y := x - y ∈ I ε.n
  mono {ε δ x y} h hxy := hI (show δ.n ≤ ε.n from h) hxy
  symm {ε x y} h := by
    have := neg_mem h
    rwa [neg_sub] at this
  tri {ε δ x y z} h₁ h₂ := by
    show x - z ∈ I (min ε.n δ.n)
    have := add_mem (hI (min_le_left ε.n δ.n) h₁) (hI (min_le_right ε.n δ.n) h₂)
    rwa [sub_add_sub_cancel] at this

universe u v

variable {G : Type u} [DecidableEq G] {k : Type v} [CommRing k] {ord : AdmissibleOrder G}

/-- **Gröbner–Shirshov membership test.** For a Gröbner–Shirshov basis with unit leading
coefficients, an element lies in the ideal iff its normal form is zero. -/
theorem mem_systemIdeal_iff_nfMap_eq_zero {sys : RewritingSystem G k}
    (hgs : IsGrobnerShirshovBasis G k ord sys) (hlc : ∀ r ∈ sys.rules, IsUnit (r.lc ord))
    (x : FreeAlg G k) : x ∈ systemIdeal sys ↔ nfMap hgs hlc x = 0 := by
  constructor
  · intro hx
    exact ideal_le_ker hgs hlc hx
  · intro h
    have := sub_nfMap_mem hgs hlc x
    rwa [h, sub_zero] at this

/-- A descending tower of error ideals of words, each presented by a Gröbner–Shirshov
basis with unit leading coefficients. -/
structure GSTower (G : Type u) [DecidableEq G] (k : Type v) [CommRing k]
    (ord : AdmissibleOrder G) where
  sys : ℕ → RewritingSystem G k
  gs : ∀ n, IsGrobnerShirshovBasis G k ord (sys n)
  lc : ∀ n, ∀ r ∈ (sys n).rules, IsUnit (r.lc ord)
  anti : Antitone fun n => systemIdeal (sys n)

namespace GSTower

variable (T : GSTower G k ord)

/-- "Agree to order `n`" on the free algebra. -/
def near : NearSystem AdicLevel (FreeAlg G k) :=
  submoduleNear (fun n => systemIdeal (T.sys n)) T.anti

/-- The order-`n` normal form. -/
noncomputable def nf (n : ℕ) : FreeAlg G k →ₗ[k] FreeAlg G k := nfMap (T.gs n) (T.lc n)

/-- **The normal form decides the near relation.** -/
theorem near_iff {n : ℕ} {x y : FreeAlg G k} :
    T.near.near ⟨n⟩ x y ↔ T.nf n (x - y) = 0 :=
  mem_systemIdeal_iff_nfMap_eq_zero (T.gs n) (T.lc n) (x - y)

/-- Equivalently, `x` and `y` have the same order-`n` normal form. -/
theorem near_iff_nf_eq {n : ℕ} {x y : FreeAlg G k} :
    T.near.near ⟨n⟩ x y ↔ T.nf n x = T.nf n y := by
  rw [near_iff, map_sub, sub_eq_zero]

/-- Every value agrees with its own order-`n` normal form to order `n`. -/
theorem near_nf (n : ℕ) (x : FreeAlg G k) : T.near.near ⟨n⟩ x (T.nf n x) :=
  sub_nfMap_mem (T.gs n) (T.lc n) x

end GSTower

end QOU.Core.GroebnerErrorNear
