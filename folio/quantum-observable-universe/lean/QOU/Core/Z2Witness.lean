import QOU.Core.CategoricalFoundations
import QOU.Core.FreeFinRigid
import Mathlib.CategoryTheory.Action.Monoidal
import Mathlib.CategoryTheory.Action.Limits
import Mathlib.Algebra.Category.ModuleCat.EpiMono

/-!
# A non-trivial quantum observable universe over any ring with `2` a unit

**Bean `qou-aawz`.**  Until this file the only `FrobeniusHopfData` built in the
corpus was the trivial one at `A = 𝟙` (`QOU.TrivialWitness`), which cannot carry
a `QuantumObservableUniverse` because its augmentation ideal is zero.  So it
was open whether the observable-universe axioms are consistent with a
non-trivial `A` at all.  They are:

* `C = Rep_R(ℤ/2)` on free `R`-modules of finite rank:
  `Action (FreeFinModuleCat R) (Multiplicative (ZMod 2))`.  Rigid
  (`QOU.Core.FreeFinRigid`), symmetric, hence balanced with `θ = 𝟙`,
  `R`-linear, `End(𝟙) ≅ R`.  The unit does not generate, so the obstruction
  `QOU.WitnessObstruction.qou_needs_nongenerating_unit` is avoided.
* `A = Fun(ℤ/2, R) = R²` with the regular (translation) action, pointwise
  product, the Haar sum `∫_A f = f(0) + f(1)` as Frobenius form and counit,
  `Δ(e_g) = e_g ⊗ e_g`, and antipode `S` the translation by the generator.
  All fifteen `FrobeniusHopfData` axioms hold over any commutative ring
  (`frobHopfA`).
* `Ad(A) = ker ε`, the sign line `R·(e₀ − e₁)`.  `Hom(𝟙, Ad(A)) = 0` uses `2`
  a unit.
* `Ω¹(A) = ker μ` is the off-diagonal part of `A ⊗ A`, split by
  `ι∘π + Δ∘μ = 𝟙`.
* `V = 𝟙 ⊕ 𝟙`, `Λ²V = 𝟙` via the determinant.

Main result: `nonempty_qou_z2 : Nontrivial R → IsUnit 2 → Nonempty (QOU R)`.

## Scope, and what this is NOT (owner ruling 2026-11-27)

This is a **consistency theorem**, not the proof of
`QuantumObservableUniverse.exists_instance`.  The witness does not see `q`:
the braiding is the symmetric flip and `θ = 𝟙`, i.e. it sits at the classical
point `q = 1` that `CategoricalFoundations` describes as a member of the class.
The owner chose to keep the `exists_instance` sorry until a q-faithful witness
exists (Rep(U_q(sl₂))).  Note for that witness: the snake identities make `A`
dualizable, so `A` must be a finite object; `O_q(SU(2))` itself cannot serve,
and the natural candidate is `A = End(V)`.

Pure algebra: no empirical value, no field, no analytic input.
-/

open CategoryTheory MonoidalCategory TensorProduct Module

universe w

namespace QOU.Z2Witness
open QOU.FreeFin

variable (R : Type w) [CommRing R]

abbrev G := Multiplicative (ZMod 2)
abbrev Cat := Action (FreeFinModuleCat R) G

noncomputable example : RigidCategory (Cat R) := inferInstance
noncomputable example : BraidedCategory (Cat R) := inferInstance
noncomputable example : Preadditive (Cat R) := inferInstance
noncomputable example : Linear R (Cat R) := inferInstance

variable {R}

/-- Free finite object from a type. -/
def ff (M : Type w) [AddCommGroup M] [Module R M] [Module.Free R M] [Module.Finite R M] :
    FreeFinModuleCat R := ⟨ModuleCat.of R M, ‹_›, ‹_›⟩

/-- The `ℤ/2`-action generated by an involution. -/
def invRep (X : FreeFinModuleCat R) (σ : X ⟶ X) (hσ : σ ≫ σ = 𝟙 X) : G →* End X where
  toFun g := if Multiplicative.toAdd g = 0 then 𝟙 X else σ
  map_one' := by simp
  map_mul' a b := by
    induction a using Multiplicative.rec with | ofAdd a => ?_
    induction b using Multiplicative.rec with | ofAdd b => ?_
    fin_cases a <;> fin_cases b <;> simp [End.mul_def, hσ] <;> first | rfl | (intro h; exact absurd (by decide) h)

def mkAct (M : Type w) [AddCommGroup M] [Module R M] [Module.Free R M] [Module.Finite R M]
    (σ : M →ₗ[R] M) (hσ : σ ∘ₗ σ = LinearMap.id) : Cat R :=
  ⟨ff M, invRep (ff M) (fh σ) (by ext x; exact congrArg (· x) hσ)⟩

/-- The swap on `Fin 2 → R`. -/
def swapL : (Fin 2 → R) →ₗ[R] (Fin 2 → R) := LinearMap.funLeft R R (fun i : Fin 2 => i + 1)

lemma swapL_apply (f : Fin 2 → R) (i : Fin 2) : swapL f i = f (i + 1) := rfl

lemma swapL_swapL : (swapL : (Fin 2 → R) →ₗ[R] _) ∘ₗ swapL = LinearMap.id := by
  ext f i; fin_cases i <;> simp [swapL_apply]

/-- `A = Fun(ℤ/2, R)` with the regular (translation) action. -/
noncomputable def A : Cat R := mkAct (Fin 2 → R) swapL swapL_swapL

/-- The sign representation. -/
noncomputable def Sgn : Cat R := mkAct R (-LinearMap.id) (by ext; simp)


abbrev g0 : G := Multiplicative.ofAdd 1

lemma mkAct_ρ_g0 (M : Type w) [AddCommGroup M] [Module R M] [Module.Free R M] [Module.Finite R M]
    (σ : M →ₗ[R] M) (hσ) : (mkAct M σ hσ).ρ g0 = fh (X := ff M) (Y := ff M) σ := by
  simp only [mkAct, invRep, MonoidHom.coe_mk, OneHom.coe_mk, toAdd_ofAdd]
  rw [if_neg (by decide)]

/-- Build an equivariant map by checking the generator only. -/
def homMk {X Y : Cat R} (f : X.V ⟶ Y.V) (h : X.ρ g0 ≫ f = f ≫ Y.ρ g0) : X ⟶ Y :=
  ⟨f, fun g => by
    induction g using Multiplicative.rec with | ofAdd a => ?_
    fin_cases a
    · change X.ρ 1 ≫ f = f ≫ Y.ρ 1
      simp only [map_one, End.one_def, Category.id_comp, Category.comp_id]
    · exact h⟩


abbrev F2 (R : Type w) [CommRing R] := Fin 2 → R

noncomputable def e (i : Fin 2) : F2 R := Pi.single i 1

noncomputable def mulL : F2 R ⊗[R] F2 R →ₗ[R] F2 R := LinearMap.mul' R (F2 R)
noncomputable def unitL : R →ₗ[R] F2 R := Algebra.linearMap R (F2 R)
noncomputable def comulL : F2 R →ₗ[R] F2 R ⊗[R] F2 R where
  toFun x := x 0 • (e 0 ⊗ₜ[R] e 0) + x 1 • (e 1 ⊗ₜ[R] e 1)
  map_add' x y := by simp only [Pi.add_apply, add_smul]; abel
  map_smul' r x := by simp only [Pi.smul_apply, smul_eq_mul, mul_smul, RingHom.id_apply, smul_add]
noncomputable def counitL : F2 R →ₗ[R] R where
  toFun x := x 0 + x 1
  map_add' x y := by simp only [Pi.add_apply]; abel
  map_smul' r x := by simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply, mul_add]
noncomputable def coevL : R →ₗ[R] F2 R ⊗[R] F2 R :=
  LinearMap.toSpanSingleton R _ (e 0 ⊗ₜ[R] e 0 + e 1 ⊗ₜ[R] e 1)

@[simp] lemma comulL_apply (x : F2 R) : comulL x = x 0 • (e 0 ⊗ₜ[R] e 0) + x 1 • (e 1 ⊗ₜ[R] e 1) := rfl
@[simp] lemma counitL_apply (x : F2 R) : counitL x = x 0 + x 1 := rfl
@[simp] lemma coevL_apply (r : R) : coevL r = r • (e 0 ⊗ₜ[R] e 0 + e 1 ⊗ₜ[R] e 1) := rfl
@[simp] lemma mulL_apply (x y : F2 R) : mulL (x ⊗ₜ y) = x * y := rfl
@[simp] lemma unitL_apply (r : R) : unitL r = algebraMap R (F2 R) r := rfl
@[simp] lemma swapL_apply' (x : F2 R) : swapL x = ![x 1, x 0] := by
  ext i; fin_cases i <;> rfl

/-- every vector is a combination of the idempotents -/
lemma F2_eq (x : F2 R) : x = x 0 • e 0 + x 1 • e 1 := by
  ext i; fin_cases i <;> simp [e]

lemma tmul_expand (x y : F2 R) : x ⊗ₜ[R] y =
    (x 0 * y 0) • (e 0 ⊗ₜ e 0) + (x 0 * y 1) • (e 0 ⊗ₜ e 1)
      + (x 1 * y 0) • (e 1 ⊗ₜ e 0) + (x 1 * y 1) • (e 1 ⊗ₜ e 1) := by
  conv_lhs => rw [F2_eq x, F2_eq y]
  simp only [TensorProduct.add_tmul, TensorProduct.tmul_add, TensorProduct.smul_tmul_smul]
  abel

lemma mulL_swap : mulL ∘ₗ TensorProduct.map (swapL (R := R)) swapL = swapL ∘ₗ mulL := by
  apply TensorProduct.ext'
  intro x y
  ext i
  fin_cases i <;> simp


section identities
open TensorProduct
variable (R)

lemma e_mul (i j : Fin 2) : (e i : F2 R) * e j = if i = j then e i else 0 := by
  ext k; fin_cases i <;> fin_cases j <;> fin_cases k <;> simp [e]

@[simp] lemma e00 : (e 0 : F2 R) 0 = 1 := by simp [e]
@[simp] lemma e01 : (e 0 : F2 R) 1 = 0 := by simp [e]
@[simp] lemma e10 : (e 1 : F2 R) 0 = 0 := by simp [e]
@[simp] lemma e11 : (e 1 : F2 R) 1 = 1 := by simp [e]

