section extra
variable {R}

/-- off-diagonal coordinates of `A ⊗ A` -/
noncomputable def offL : F2 R ⊗[R] F2 R →ₗ[R] F2 R :=
  TensorProduct.lift
    { toFun := fun x =>
        { toFun := fun y => ![x 0 * y 1, x 1 * y 0]
          map_add' := fun y y' => by ext k; fin_cases k <;> simp [mul_add]
          map_smul' := fun r y => by ext k; fin_cases k <;> simp <;> ring }
      map_add' := fun x x' => by ext y k; fin_cases k <;> simp [add_mul]
      map_smul' := fun r x => by ext y k; fin_cases k <;> simp <;> ring }

@[simp] lemma offL_apply (x y : F2 R) : offL (x ⊗ₜ y) = ![x 0 * y 1, x 1 * y 0] := rfl

noncomputable def incKL : F2 R →ₗ[R] F2 R ⊗[R] F2 R where
  toFun f := f 0 • (e 0 ⊗ₜ[R] e 1) + f 1 • (e 1 ⊗ₜ[R] e 0)
  map_add' x y := by simp only [Pi.add_apply, add_smul]; abel
  map_smul' r x := by simp only [Pi.smul_apply, smul_eq_mul, mul_smul, RingHom.id_apply, smul_add]

@[simp] lemma incKL_apply (f : F2 R) : incKL f = f 0 • (e 0 ⊗ₜ[R] e 1) + f 1 • (e 1 ⊗ₜ[R] e 0) := rfl

lemma off_inc_lin : offL ∘ₗ incKL = (LinearMap.id : F2 R →ₗ[R] F2 R) := by
  apply LinearMap.ext; intro f; ext k; fin_cases k <;> simp

lemma split_lin : incKL ∘ₗ offL + comulL ∘ₗ mulL = (LinearMap.id : F2 R ⊗[R] F2 R →ₗ[R] _) := by
  apply TensorProduct.ext'; intro x y
  simp only [LinearMap.add_apply, LinearMap.coe_comp, Function.comp_apply, offL_apply,
    incKL_apply, mulL_apply, comulL_apply, LinearMap.id_apply, Pi.mul_apply,
    Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
  rw [tmul_expand x y]; abel

lemma inc_mul_lin : mulL ∘ₗ incKL = (0 : F2 R →ₗ[R] F2 R) := by
  apply LinearMap.ext; intro f
  simp [e_mul]

lemma inc_equiv_lin : incKL ∘ₗ swapL = TensorProduct.map swapL swapL ∘ₗ (incKL : F2 R →ₗ[R] _) := by
  apply LinearMap.ext; intro x
  simp only [LinearMap.coe_comp, Function.comp_apply, incKL_apply, map_add,
    map_smul, TensorProduct.map_tmul, swap_e0, swap_e1, swapL_apply]
  have h0 : ((0 : Fin 2) + 1) = 1 := rfl
  have h1 : ((1 : Fin 2) + 1) = 0 := rfl
  rw [h0, h1, add_comm]

lemma off_equiv_lin : offL ∘ₗ TensorProduct.map swapL swapL = swapL ∘ₗ (offL : F2 R ⊗[R] F2 R →ₗ[R] _) := by
  apply TensorProduct.ext'; intro x y; ext k; fin_cases k <;> simp [mul_comm]

lemma trace_sym_lin (φ : F2 R →ₗ[R] F2 R) :
    counitL ∘ₗ mulL ∘ₗ φ.rTensor (F2 R) ∘ₗ coevL = counitL ∘ₗ mulL ∘ₗ φ.lTensor (F2 R) ∘ₗ coevL := by
  apply LinearMap.ext; intro r
  simp only [LinearMap.coe_comp, Function.comp_apply, coevL_apply, map_smul, map_add,
    LinearMap.rTensor_tmul, LinearMap.lTensor_tmul, mulL_apply, mul_comm]

/-- `Ad(A)`: the augmentation line `r ↦ r(e₀ − e₁)`. -/
noncomputable def adL : R →ₗ[R] F2 R := LinearMap.toSpanSingleton R _ (e 0 - e 1)

@[simp] lemma adL_apply (r : R) : adL r = r • (e 0 - e 1) := rfl

lemma ad_equiv_lin : adL ∘ₗ (-LinearMap.id) = swapL ∘ₗ (adL : R →ₗ[R] F2 R) := by
  apply LinearMap.ext; intro r; ext k; fin_cases k <;> simp [e]

lemma ad_counit_lin : counitL ∘ₗ adL = (0 : R →ₗ[R] R) := by
  apply LinearMap.ext; intro r; simp

lemma adL_injective : Function.Injective (adL : R →ₗ[R] F2 R) := by
  intro r s h
  have := congrFun h 0
  simpa using this

/-- the determinant `V ⊗ V → 𝟙` -/
noncomputable def detL : F2 R ⊗[R] F2 R →ₗ[R] R :=
  TensorProduct.lift
    { toFun := fun x =>
        { toFun := fun y => x 0 * y 1 - x 1 * y 0
          map_add' := fun y y' => by simp; ring
          map_smul' := fun r y => by simp; ring }
      map_add' := fun x x' => by ext y; simp; ring
      map_smul' := fun r x => by ext y; simp; ring }

lemma detL_surjective : Function.Surjective (detL : F2 R ⊗[R] F2 R →ₗ[R] R) := by
  intro r
  refine ⟨(r • e 0) ⊗ₜ e 1, ?_⟩
  simp [detL]

end extra

end identities

lemma A_ρ_g0 : (A (R := R)).ρ g0 = fh (X := A.V) (Y := A.V) swapL := mkAct_ρ_g0 _ _ _

noncomputable def mulA : A (R := R) ⊗ A ⟶ A :=
  homMk (fh mulL) (by
    change (A.ρ g0 ⊗ₘ A.ρ g0) ≫ _ = _
    rw [A_ρ_g0, fh_tensorHom, fh_comp, fh_comp]
    exact fh_inj mulL_swap)


@[simp] lemma homMk_hom {X Y : Cat R} (f : X.V ⟶ Y.V) (h) : (homMk f h).hom = f := rfl

lemma one_ρ_g0 : (𝟙_ (Cat R)).ρ g0 = 𝟙 _ := rfl

noncomputable def unitA : 𝟙_ (Cat R) ⟶ A :=
  homMk (fh (X := (𝟙_ (Cat R)).V) (Y := A.V) unitL) (by
    rw [one_ρ_g0, A_ρ_g0, Category.id_comp, fh_comp]; exact fh_inj (unit_equiv_lin R))

noncomputable def comulA : A (R := R) ⟶ A ⊗ A :=
  homMk (fh (X := A.V) (Y := (A ⊗ A).V) comulL) (by
    change _ = _ ≫ (A.ρ g0 ⊗ₘ A.ρ g0)
    rw [A_ρ_g0, fh_tensorHom, fh_comp, fh_comp]; exact fh_inj (comul_equiv_lin R))

noncomputable def counitA : A (R := R) ⟶ 𝟙_ (Cat R) :=
  homMk (fh (X := A.V) (Y := (𝟙_ (Cat R)).V) counitL) (by
    rw [one_ρ_g0, A_ρ_g0, Category.comp_id, fh_comp]; exact fh_inj (anti_counit_lin R))

noncomputable def antipodeA : A (R := R) ⟶ A :=
  homMk (fh (X := A.V) (Y := A.V) swapL) (by rw [A_ρ_g0])

noncomputable def coevA : 𝟙_ (Cat R) ⟶ A ⊗ A :=
  homMk (fh (X := (𝟙_ (Cat R)).V) (Y := (A ⊗ A).V) coevL) (by
    change _ = _ ≫ (A.ρ g0 ⊗ₘ A.ρ g0)
    rw [one_ρ_g0, A_ρ_g0, fh_tensorHom, fh_comp, Category.id_comp]
    exact fh_inj (coev_equiv_lin R).symm)


macro "lin_reduce" : tactic => `(tactic| (
  apply Action.Hom.ext
  simp only [Action.comp_hom, Action.id_hom, Action.tensorHom_hom, Action.whiskerLeft_hom,
    Action.whiskerRight_hom, Action.associator_hom_hom, Action.associator_inv_hom,
    Action.leftUnitor_hom_hom, Action.leftUnitor_inv_hom, Action.rightUnitor_hom_hom,
    Action.rightUnitor_inv_hom, Action.β_hom_hom, homMk_hom, mulA, unitA, comulA, counitA,
    antipodeA, coevA]
  simp only [assoc_hom_eq, assoc_inv_eq, leftUnitor_hom_eq, leftUnitor_inv_eq,
    rightUnitor_hom_eq, rightUnitor_inv_eq, braiding_hom_eq, id_eq, fh_comp, fh_tensorHom,
    fh_whiskerLeft, fh_whiskerRight]
  apply fh_inj))

noncomputable def frobHopfA : QOU.FrobeniusHopfData (Cat R) where
  obj := A
  mul := mulA
  unit := unitA
  comul := comulA
  counit := counitA
  antipode := antipodeA
  frobeniusForm := counitA
  coevaluation := coevA
  pairing_snake_left := by lin_reduce; exact snake_left_lin R
  pairing_snake_right := by lin_reduce; exact snake_right_lin R
  frobenius_relation := by lin_reduce; exact frob_lin R
  one_mul := by lin_reduce; exact one_mul_lin R
  mul_one := by lin_reduce; exact mul_one_lin R
  mul_assoc := by lin_reduce; exact mul_assoc_lin R
  counit_comul := by lin_reduce; exact counit_comul_lin R
  comul_counit := by lin_reduce; exact comul_counit_lin R
  comul_assoc := by lin_reduce; exact comul_assoc_lin R
  antipode_anti_mul := by lin_reduce; exact anti_mul_lin R
  antipode_anti_comul := by lin_reduce; exact anti_comul_lin R
  antipode_unit := by lin_reduce; exact anti_unit_lin R
  antipode_counit := by lin_reduce; exact anti_counit_lin R
  antipode_involutive := by lin_reduce; exact swapL_swapL
  antipode_frobeniusForm := by lin_reduce; exact anti_counit_lin R


lemma fh_add {X Y : FreeFinModuleCat R} (f g : X.obj →ₗ[R] Y.obj) : fh f + fh g = fh (f + g) := rfl
lemma fh_zero {X Y : FreeFinModuleCat R} : (0 : X ⟶ Y) = fh 0 := rfl
lemma fh_hom {X Y : FreeFinModuleCat R} (f : X ⟶ Y) : f = fh f.hom := rfl

/-- the kernel object `Ω¹(A) ≅ A` (off-diagonal part of `A ⊗ A`) -/
noncomputable def incK : A (R := R) ⟶ A ⊗ A :=
  homMk (fh (X := A.V) (Y := (A ⊗ A).V) incKL) (by
    change _ = _ ≫ (A.ρ g0 ⊗ₘ A.ρ g0)
    rw [A_ρ_g0, fh_tensorHom, fh_comp, fh_comp]; exact fh_inj inc_equiv_lin)

noncomputable def offK : A (R := R) ⊗ A ⟶ A :=
  homMk (fh (X := (A ⊗ A).V) (Y := A.V) offL) (by
    change (A.ρ g0 ⊗ₘ A.ρ g0) ≫ _ = _
    rw [A_ρ_g0, fh_tensorHom, fh_comp, fh_comp]; exact fh_inj off_equiv_lin)

lemma incK_mul : incK ≫ mulA (R := R) = 0 := by
  apply Action.Hom.ext
  simp only [Action.comp_hom, homMk_hom, incK, mulA, Action.zero_hom, fh_comp]
  rw [fh_zero]; exact fh_inj inc_mul_lin

lemma incK_offK : incK ≫ offK (R := R) = 𝟙 _ := by
  apply Action.Hom.ext
  simp only [Action.comp_hom, homMk_hom, incK, offK, Action.id_hom, fh_comp]
  show _ = fh LinearMap.id; exact fh_inj off_inc_lin

lemma split_cat : offK ≫ incK + mulA ≫ comulA = 𝟙 (A (R := R) ⊗ A) := by
  apply Action.Hom.ext
  simp only [Action.add_hom, Action.comp_hom, homMk_hom, incK, offK, mulA, comulA,
    Action.id_hom, fh_comp, fh_add]
  show _ = fh LinearMap.id; exact fh_inj split_lin

noncomputable def kernelForkA : Limits.KernelFork (mulA (R := R)) :=
  Limits.KernelFork.ofι incK incK_mul

noncomputable def kernelForkA_isLimit : Limits.IsLimit (kernelForkA (R := R)) :=
  Limits.KernelFork.IsLimit.ofι _ incK_mul
    (fun g _ => g ≫ offK)
    (fun {W} g hg => by
      have : g = g ≫ (offK ≫ incK + mulA ≫ comulA) := by rw [split_cat, Category.comp_id]
      conv_rhs => rw [this]
      rw [Preadditive.comp_add, ← Category.assoc g mulA, hg, Limits.zero_comp, add_zero,
        Category.assoc])
    (fun {W} g _ m hm => by
      show m = g ≫ offK
      rw [← hm, Category.assoc, incK_offK, Category.comp_id])


lemma Sgn_ρ_g0 : (Sgn (R := R)).ρ g0 = fh (X := Sgn.V) (Y := Sgn.V) (-LinearMap.id) :=
  mkAct_ρ_g0 _ _ _

/-- `Ad(A) ↪ A`: the sign line `r ↦ r(e₀ − e₁)`, the augmentation ideal. -/
noncomputable def adIncl : Sgn (R := R) ⟶ A :=
  homMk (fh (X := Sgn.V) (Y := A.V) adL) (by
    rw [Sgn_ρ_g0, A_ρ_g0, fh_comp, fh_comp]; exact fh_inj ad_equiv_lin)

lemma adIncl_counit : adIncl ≫ counitA (R := R) = 0 := by
  apply Action.Hom.ext
  simp only [Action.comp_hom, homMk_hom, adIncl, counitA, Action.zero_hom, fh_comp]
  rw [fh_zero]; exact fh_inj ad_counit_lin

lemma adIncl_hom_apply (r : R) : (adIncl (R := R)).hom.hom r = adL r := rfl

lemma adIncl_ne_zero [Nontrivial R] : adIncl (R := R) ≠ 0 := by
  intro h
  have := congrArg (fun f : Sgn (R := R) ⟶ A => (f.hom.hom (1 : R) : F2 R) 0) h
  simp [adIncl_hom_apply, e] at this
  exact one_ne_zero this

lemma adIncl_mono : Mono (adIncl (R := R)) := by
  apply (Action.forget (FreeFinModuleCat R) G ⋙ (isFreeFin R).ι).mono_of_mono_map
  exact (ModuleCat.mono_iff_injective (R := R) _).mpr (adL_injective (R := R))

lemma unit_to_Sgn_subsingleton (h2 : IsUnit (2 : R)) : Subsingleton (𝟙_ (Cat R) ⟶ Sgn) := by
  constructor
  intro f g
  have key : ∀ f : 𝟙_ (Cat R) ⟶ Sgn, f = 0 := by
    intro f
    have hc := f.comm g0
    rw [Sgn_ρ_g0, one_ρ_g0, Category.id_comp] at hc
    apply Action.Hom.ext
    apply ModuleCat.hom_ext
    apply LinearMap.ext_ring
    have h1 := congrArg (fun φ : (𝟙_ (Cat R)).V ⟶ Sgn.V => (φ.hom (1 : R) : R)) hc
    simp only [fh, ModuleCat.hom_comp, ModuleCat.hom_ofHom, LinearMap.comp_apply,
      LinearMap.neg_apply, LinearMap.id_apply] at h1
    set v : R := f.hom.hom (1 : R) with hv
    have h2v : (2 : R) * v = 0 := by
      have : v + v = 0 := by nth_rewrite 1 [h1]; exact neg_add_cancel _
      rw [two_mul]; exact this
    have hv0 : v = 0 := by
      obtain ⟨u, hu⟩ := h2
      have := congrArg (fun t => (↑u⁻¹ : R) * t) h2v
      simpa [← hu, ← mul_assoc] using this
    show f.hom.hom (1 : R) = (0 : 𝟙_ (Cat R) ⟶ Sgn).hom.hom (1 : R)
    rw [← hv, hv0]; rfl
  rw [key f, key g]

/-- `V = 𝟙 ⊕ 𝟙`, the fundamental object of dimension 2. -/
noncomputable def Vf : Cat R := mkAct (Fin 2 → R) LinearMap.id (by ext; simp)

lemma Vf_ρ_g0 : (Vf (R := R)).ρ g0 = fh (X := Vf.V) (Y := Vf.V) LinearMap.id := mkAct_ρ_g0 _ _ _

/-- the determinant `Λ²V ≅ 𝟙`, presented as `V ⊗ V ↠ 𝟙` -/
noncomputable def detA : Vf (R := R) ⊗ Vf ⟶ 𝟙_ (Cat R) :=
  homMk (fh (X := (Vf ⊗ Vf).V) (Y := (𝟙_ (Cat R)).V) detL) (by
    change (Vf.ρ g0 ⊗ₘ Vf.ρ g0) ≫ _ = _
    rw [Vf_ρ_g0, one_ρ_g0, fh_tensorHom, fh_comp, Category.comp_id]
    exact fh_inj (by rw [TensorProduct.map_id]; rfl))

lemma detA_epi : Epi (detA (R := R)) := by
  apply (Action.forget (FreeFinModuleCat R) G ⋙ (isFreeFin R).ι).epi_of_epi_map
  exact (ModuleCat.epi_iff_surjective (R := R) _).mpr (detL_surjective (R := R))

lemma detL_comm :
    (detL : F2 R ⊗[R] F2 R →ₗ[R] R) ∘ₗ (TensorProduct.comm R (F2 R) (F2 R)).toLinearMap =
      -detL := by
  apply TensorProduct.ext'
  intro x y
  simp [detL]
  ring

lemma detA_antisym :
    (β_ (Vf (R := R)) Vf).hom ≫ detA = (-1 : R) • detA := by
  apply Action.Hom.ext
  rw [neg_one_smul]
  simp only [Action.comp_hom, Action.β_hom_hom, Action.neg_hom, homMk_hom, detA,
    braiding_hom_eq, fh_comp]
  change fh (X := (Vf (R := R) ⊗ Vf).V) (Y := (𝟙_ (Cat R)).V)
      (detL (R := R) ∘ₗ (TensorProduct.comm R (F2 R) (F2 R)).toLinearMap) =
    fh (X := (Vf (R := R) ⊗ Vf).V) (Y := (𝟙_ (Cat R)).V) (-detL (R := R))
  exact fh_inj detL_comm

lemma frobenius_symmetric_A (f : A (R := R) ⟶ A) :
    frobHopfA.leftTrace f = frobHopfA.rightTrace f := by
  simp only [QOU.FrobeniusHopfData.leftTrace, QOU.FrobeniusHopfData.rightTrace,
    QOU.FrobeniusHopfData.ev, frobHopfA]
  apply Action.Hom.ext
  simp only [Action.comp_hom, Action.whiskerLeft_hom, Action.whiskerRight_hom, homMk_hom,
    coevA, mulA, counitA]
  rw [fh_hom f.hom]
  simp only [fh_comp, fh_whiskerLeft, fh_whiskerRight]
  exact fh_inj (trace_sym_lin f.hom.hom)


/-- `End(𝟙) ≅ R` in `Rep_R(ℤ/2)`. -/
noncomputable def unitEndEquivZ2 : R ≃+* CategoryTheory.End (𝟙_ (Cat R)) where
  toFun r := r • 𝟙 (𝟙_ (Cat R))
  invFun f := show R from f.hom.hom (1 : R)
  left_inv r := by
    show ModuleCat.Hom.hom (r • (𝟙 (𝟙_ (ModuleCat R)))) (1 : R) = r
    rw [ModuleCat.hom_smul]
    simp
  right_inv f := by
    apply Action.Hom.ext
    apply ModuleCat.hom_ext; apply LinearMap.ext_ring
    show ModuleCat.Hom.hom ((show R from f.hom.hom (1 : R)) • (𝟙 (𝟙_ (ModuleCat R)))) (1 : R) =
      f.hom.hom (1 : R)
    rw [ModuleCat.hom_smul]
    simp
  map_mul' a b := by
    rw [mul_smul, End.mul_def, Linear.smul_comp, Linear.comp_smul, Category.id_comp,
      smul_smul, smul_smul, mul_comm]
  map_add' a b := by rw [add_smul]

/-- **The `ℤ/2` quantum observable universe.**  `C = Rep_R(ℤ/2)` on free finite
`R`-modules, `A = Fun(ℤ/2, R)` with the Haar sum as Frobenius form,
`Ad(A) = ` the sign line, `V = 𝟙 ⊕ 𝟙`, `Λ²V = 𝟙` via the determinant. -/
noncomputable def z2QOU [Nontrivial R] (h2 : IsUnit (2 : R)) :
    QOU.QuantumObservableUniverse.{w + 1, w, w} R where
  C := Cat R
  frobHopf := frobHopfA
  fibreFunctor := Action.forget (FreeFinModuleCat R) G ⋙ (isFreeFin R).ι
  frobenius_symmetric := frobenius_symmetric_A
  unitEndEquiv := unitEndEquivZ2
  blocks := PUnit
  centralIdem _ := 𝟙 _
  centralIdem_idem _ := by simp
  centralIdem_orthogonal := by rintro ⟨⟩ ⟨⟩ h; exact absurd rfl h
  centralIdem_complete := by simp
  frobWeight _ := 1
  frobWeight_isUnit _ := isUnit_one
  dimQ _ := 1
  dimQ_isUnit _ := isUnit_one
  differentialForms := kernelForkA
  differentialForms_isLimit := kernelForkA_isLimit
  adjointObj := Sgn
  adjointIncl := adIncl
  adjoint_mono := adIncl_mono
  adjoint_augmented := adIncl_counit
  adjoint_nontrivial := adIncl_ne_zero
  adjoint_vanishing := unit_to_Sgn_subsingleton h2
  fundamentalObj := Vf
  exteriorSquare := 𝟙_ (Cat R)
  exteriorSquareProj := detA
  exteriorSquare_epi := detA_epi
  volumeIso := Iso.refl _
  twistScalar := 1
  twistScalarInv := 1
  twistScalar_mul_inv := one_mul 1
  twist_fundamental := by
    show 𝟙 Vf = (1 : R) • 𝟙 Vf
    rw [one_smul]
  exteriorSquare_antisym := detA_antisym

theorem nonempty_qou_z2 [Nontrivial R] (h2 : IsUnit (2 : R)) :
    Nonempty (QOU.QuantumObservableUniverse.{w + 1, w, w} R) := ⟨z2QOU h2⟩

end QOU.Z2Witness
