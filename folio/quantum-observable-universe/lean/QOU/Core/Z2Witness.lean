@[simp] lemma e_mul_left (i : Fin 2) (y : F2 R) : (e i : F2 R) * y = y i • e i := by
  ext k; fin_cases i <;> fin_cases k <;> simp [e]
@[simp] lemma e_mul_right (i : Fin 2) (y : F2 R) : y * (e i : F2 R) = y i • e i := by
