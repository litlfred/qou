import Mathlib.Data.Multiset.Bind
import Mathlib.Tactic.Ring
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.IntervalCases

/-!
# QOU.Eightfold.FibreFunctorDimensionNotCategorical — a fibre functor changes
dimensions, not fusion rules

Bean `qou-yjwg` (front 2 of PR #6458), epic `qou-8lxd`.

## The mathematical situation this formalises

The single-fibre category of a quantum observable universe is the tensor
category generated by one object `V` with `Λ²V ≅ 𝟙`; the corpus identifies it
with `Rep(SL_q(2))` at generic `q` (`def:quantum-gauge-group`,
`ex:tannaka-krein-su2`).  In that category the Clebsch–Gordan rule is

  `V ⊗ V_j ≅ V_{j+1/2} ⊕ V_{j−1/2}`   (and `V ⊗ V_0 ≅ V_{1/2}`),

so the simple summands of `V^{⊗k}` are the `V_j` with `2j ≡ k (mod 2)`.

A **fibre functor** `τ' : C → R-Mod` is monoidal and exact, so it carries this
decomposition to a decomposition of `τ'(V)^{⊗k}` and the dimensions
`d_j := dim τ'(V_j)` satisfy the same recursion with `d_{1/2} = n := dim τ'(V)`:

  `d_0 = 1, d_{1/2} = n, d_{(k+2)/2} = n · d_{(k+1)/2} − d_{k/2}`.

The eightfold way's baryon decomposition `𝟑 ⊗ 𝟑 ⊗ 𝟑 = 𝟏𝟎 ⊕ 𝟖 ⊕ 𝟖 ⊕ 𝟏` contains
a one-dimensional summand (the totally antisymmetric channel).  This file
proves that **no fibre functor of the single-fibre category, of any
dimension `n ≥ 2`, produces a one-dimensional summand of `V^{⊗3}`**: by parity
the spin-`0` object does not occur in `V^{⊗3}` at all, and every other summand
has dimension at least `n`.  Dimension is a property of `τ'`; the fusion rules
are a property of `C`, and only the latter carries the eightfold way.

## What is and is not formalised

* Formalised: the Clebsch–Gordan spin bookkeeping (`cgSpins`), its parity
  invariant, the dimension recursion (`dimSeq`) and its consequences.
* Cited, not formalised: that the single-fibre category has the
  `Rep(SL_q(2))` fusion rules at the substrate `q₀` (generic, not a root of
  unity), and that a monoidal exact fibre functor preserves the decomposition.
  These are the hypotheses under which the theorems below say anything about
  QOU; the theorems themselves are unconditional combinatorics.
* Cited, not formalised: the existence of fibre functors of every dimension
  `n ≥ 2` on `Rep(SL_q(2))` (Bichon 2003, `B(E)` for `E ∈ GL_n` with
  `tr(E⁻¹Eᵗ) = −q − q⁻¹`).  Their existence is what makes the theorem
  non-vacuous: a 3-dimensional fibre functor *does* exist, and it still gives
  `V^{⊗3} ≅ 21 ⊕ 3 ⊕ 3`, never `10 ⊕ 8 ⊕ 8 ⊕ 1`.

Base ring: everything here is integer combinatorics (§7c: no `ℝ`).
-/

namespace QOU.Eightfold.FibreFunctorDimension

/-- Twice-spins `2j` of the simple summands of `V^{⊗k}` in `Rep(SL_q(2))`,
with multiplicity, by the Clebsch–Gordan rule `V ⊗ V_j ≅ V_{j+1/2} ⊕ V_{j−1/2}`
(`V ⊗ V_0 ≅ V_{1/2}`). -/
def cgSpins : ℕ → Multiset ℕ
  | 0 => {0}
  | k + 1 => (cgSpins k).bind fun s => if s = 0 then {1} else {s - 1, s + 1}

/-- `V^{⊗3} ≅ V_{3/2} ⊕ V_{1/2} ⊕ V_{1/2}`: twice-spins `{3, 1, 1}`. -/
theorem cgSpins_three : cgSpins 3 = {3, 1, 1} := by decide

/-- Parity invariant: every summand of `V^{⊗k}` has `2j ≡ k (mod 2)`. -/
theorem cgSpins_parity : ∀ k, ∀ s ∈ cgSpins k, s % 2 = k % 2 := by
  intro k
  induction k with
  | zero =>
    intro s hs
    simp [cgSpins] at hs
    simp [hs]
  | succ k ih =>
    intro s hs
    simp only [cgSpins, Multiset.mem_bind] at hs
    obtain ⟨t, ht, hs⟩ := hs
    have hp := ih t ht
    split_ifs at hs with h0
    · simp at hs
      subst hs
      subst h0
      omega
    · simp at hs
      rcases hs with rfl | rfl <;> omega

/-- The spin-`0` object (the only one-dimensional simple) does not occur in
`V^{⊗3}`.  This is the categorical form of "`Λ³V = 0`": the singlet the
eightfold way needs is absent, under every fibre functor. -/
theorem zero_not_mem_cgSpins_three : 0 ∉ cgSpins 3 := by
  intro h
  have := cgSpins_parity 3 0 h
  norm_num at this

/-- Dimensions `d_{k/2} = dim τ'(V_{k/2})` under a fibre functor with
`dim τ'(V) = n`, by monoidality applied to the Clebsch–Gordan rule. -/
def dimSeq (n : ℤ) : ℕ → ℤ
  | 0 => 1
  | 1 => n
  | k + 2 => n * dimSeq n (k + 1) - dimSeq n k

theorem dimSeq_zero (n : ℤ) : dimSeq n 0 = 1 := rfl
theorem dimSeq_one (n : ℤ) : dimSeq n 1 = n := rfl
theorem dimSeq_two (n : ℤ) : dimSeq n 2 = n ^ 2 - 1 := by
  simp [dimSeq]; ring

/-- `dim τ'(V_{3/2}) = n³ − 2n`: `4` at `n = 2`, `21` at `n = 3`. -/
theorem dimSeq_three (n : ℤ) : dimSeq n 3 = n ^ 3 - 2 * n := by
  simp [dimSeq]; ring

/-- The dimensions of the three summands of `V^{⊗3}` add up to `n³`. -/
theorem cube_total (n : ℤ) : dimSeq n 3 + 2 * dimSeq n 1 = n ^ 3 := by
  simp [dimSeq]; ring

/-- Under a **three**-dimensional fibre functor `V^{⊗3}` has dimensions
`{21, 3, 3}` — the same total `27` as `10 + 8 + 8 + 1`, a different split. -/
theorem dims_cube_at_three : (cgSpins 3).map (dimSeq 3) = {21, 3, 3} := by
  rw [cgSpins_three]
  decide

/-- No fibre functor gives `V_{3/2}` the decuplet dimension `10`. -/
theorem dimSeq_three_ne_ten (n : ℕ) : dimSeq (n : ℤ) 3 ≠ 10 := by
  rw [dimSeq_three]
  rcases le_or_gt n 2 with h | h
  · interval_cases n <;> norm_num
  · have h3 : (3 : ℤ) ≤ n := by exact_mod_cast h
    -- `n³ − 9n = n(n − 3)(n + 3) ≥ 0`, so `n³ = 2n + c` with `c ≤ 10` forces `7n ≤ 10`.
    have h9 : (9 : ℤ) * n ≤ (n : ℤ) ^ 3 := by
      nlinarith [mul_nonneg (mul_nonneg (by linarith : (0 : ℤ) ≤ n)
        (by linarith : (0 : ℤ) ≤ (n : ℤ) - 3)) (by linarith : (0 : ℤ) ≤ (n : ℤ) + 3)]
    intro hc
    linarith

/-- No fibre functor gives `V_{3/2}` the octet dimension `8` either. -/
theorem dimSeq_three_ne_eight (n : ℕ) : dimSeq (n : ℤ) 3 ≠ 8 := by
  rw [dimSeq_three]
  rcases le_or_gt n 2 with h | h
  · interval_cases n <;> norm_num
  · have h3 : (3 : ℤ) ≤ n := by exact_mod_cast h
    -- `n³ − 9n = n(n − 3)(n + 3) ≥ 0`, so `n³ = 2n + c` with `c ≤ 10` forces `7n ≤ 10`.
    have h9 : (9 : ℤ) * n ≤ (n : ℤ) ^ 3 := by
      nlinarith [mul_nonneg (mul_nonneg (by linarith : (0 : ℤ) ≤ n)
        (by linarith : (0 : ℤ) ≤ (n : ℤ) - 3)) (by linarith : (0 : ℤ) ≤ (n : ℤ) + 3)]
    intro hc
    linarith

/-- For `n ≥ 2` the dimension sequence is positive and non-decreasing. -/
theorem dimSeq_ge (n : ℤ) (hn : 2 ≤ n) :
    ∀ k, 1 ≤ dimSeq n k ∧ dimSeq n k ≤ dimSeq n (k + 1) := by
  intro k
  induction k with
  | zero =>
    simp [dimSeq]
    linarith
  | succ k ih =>
    obtain ⟨h1, h2⟩ := ih
    refine ⟨by linarith, ?_⟩
    have e : dimSeq n (k + 2) = n * dimSeq n (k + 1) - dimSeq n k := by
      simp [dimSeq]
    rw [show k + 1 + 1 = k + 2 from rfl, e]
    nlinarith [mul_nonneg (sub_nonneg.mpr hn) (by linarith : (0 : ℤ) ≤ dimSeq n (k + 1))]

/-- Every summand of positive spin has dimension at least `n`. -/
theorem dimSeq_succ_ge_n (n : ℤ) (hn : 2 ≤ n) : ∀ k, n ≤ dimSeq n (k + 1) := by
  intro k
  induction k with
  | zero => simp [dimSeq]
  | succ k ih => exact le_trans ih (dimSeq_ge n hn (k + 1)).2

/-- **The theorem.**  Under a fibre functor of any dimension `n ≥ 2`, no summand
of `V^{⊗3}` is one-dimensional.  The eightfold decomposition
`𝟏𝟎 ⊕ 𝟖 ⊕ 𝟖 ⊕ 𝟏` therefore cannot be the image of `V^{⊗3}` under any fibre
functor of the single-fibre category: changing `τ'` changes `n`, and only `n`.
The obstruction is the fusion rule (the parity invariant above), which is a
property of the category. -/
theorem no_one_dimensional_summand_of_cube (n : ℤ) (hn : 2 ≤ n) :
    ∀ s ∈ cgSpins 3, dimSeq n s ≠ 1 := by
  intro s hs
  have hs0 : s ≠ 0 := fun h => zero_not_mem_cgSpins_three (h ▸ hs)
  obtain ⟨k, rfl⟩ : ∃ k, s = k + 1 := ⟨s - 1, by omega⟩
  have := dimSeq_succ_ge_n n hn k
  linarith

/-- Restated for the eightfold multiset: `1 ∉ dims(V^{⊗3})` for every `n ≥ 2`. -/
theorem one_not_mem_dims_cube (n : ℤ) (hn : 2 ≤ n) :
    (1 : ℤ) ∉ (cgSpins 3).map (dimSeq n) := by
  intro h
  rw [Multiset.mem_map] at h
  obtain ⟨s, hs, hd⟩ := h
  exact no_one_dimensional_summand_of_cube n hn s hs hd

end QOU.Eightfold.FibreFunctorDimension
