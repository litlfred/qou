-- Ref: [leitner2026] conj:binding-manybody-eq-jet-filtration (jet tower); def:tannaka-dual
-- Ref: rank-1 ⟹ one fundamental weight ⟹ one ⊗-generator (highest-weight theory):
--   Fulton–Harris, *Representation Theory*, GTM 129, §11–§14 & §23 (fundamental reps,
--   `SL₂`/rank-1: simples are `Sym^k(std)`); Bourbaki, *Groupes et algèbres de Lie*,
--   Ch. VIII (roots, fundamental weights) — standard, not in Mathlib.
-/

namespace QOU.Atomicity.RankOneToSingleObject

/-! ## The free tensor-generation order (local, decoupled copy) -/

/-- **Free tensor-generation order** on the weight monoid `S → ℕ` of a category with
    fundamental-object index set `S`: `genLe f g` says every fundamental multiplicity of
    `f` is `≤` that of `g` — i.e. the simple with weight `f` is a tensor factor of the
    one with weight `g`. This is the local, self-contained copy of the landed
    `QOU.Atomicity.piGenLe` (PR #4285); kept here so this file does not import the
    unmerged branch. -/
def genLe {S : Type*} (f g : S → ℕ) : Prop := ∀ s, f s ≤ g s

/-- **Single fundamental object ⟹ tensor-generation order is total (a chain).**
    If the fundamental-object index set `S` is a subsingleton (one generator), the free
    tensor-generation order on `S → ℕ` is total. A local sorry-free re-proof of the
    landed `subsingleton_forces_freeGen_total` (PR #4285), so the chain step is genuinely
    closed inside this file (not merely assumed). -/
theorem singleGenerator_forces_genTotal {S : Type*} (h : Subsingleton S) :
    IsTotal (S → ℕ) genLe := by
  refine ⟨fun f g => ?_⟩
  rcases isEmpty_or_nonempty S with hemp | hne
  · exact Or.inl fun s => (hemp.false s).elim
  · obtain ⟨s0⟩ := hne
    rcases Nat.le_total (f s0) (g s0) with hle | hle
    · exact Or.inl fun s => by rw [Subsingleton.elim s s0]; exact hle
    · exact Or.inr fun s => by rw [Subsingleton.elim s s0]; exact hle

/-! ## The open premise — rank-1 ⟹ single fundamental object (uninhabited class) -/

/-- **Conditional class (§3b-cond): rank-1 Lie algebra ⟹ single fundamental object.**
    The standard reductive fact that a rank-1 root datum has a single fundamental weight,
    so `Rep(G)` is tensor-generated by one fundamental object — **absent from Mathlib**
    (see survey). Axiomatized as a `Prop`-valued class whose single field is the
    **genuine implication** `LieAlgebra.rank R L ≤ 1 → Subsingleton S`, where `S` indexes
    the fundamental objects generating `Rep(G)` for the group `G` with Lie algebra `L`.

    The field is *not* `True` and *not* the file's own conclusion (the chain): it is the
    load-bearing rep-theory step `rank-1 ⟹ one generator`. `S` is fixed independently of
    `L`, so an instance must actually *prove* that a rank-1 Lie algebra forces the
    fundamental-object set to a single element — the whole content of the highest-weight
    classification in rank 1.

    **OPEN PREMISE — no instance is provided.** Per `AGENTS.md §"Axiomatization is NOT a
    Proof"`, declaring this class does **not** prove `rank-1 ⟹ single object`; the
    theorem is mathematically open in this corpus. Downstream results depending on it are
    *rigorous conditionals*, never unconditional claims.

    -- Ref: Fulton–Harris §11–§14, §23; Bourbaki, Lie VIII (see file docstring). -/
class RankOneImpliesSingleGenerator (R L : Type*) [CommRing R] [Nontrivial R] [LieRing L]
    [LieAlgebra R L] [Module.Finite R L] [Module.Free R L] (S : Type*) : Prop where
  /-- The genuine content: a rank-`≤1` Lie algebra forces a single fundamental object
      (subsingleton generating set). This is the open premise. -/
  single_generator_of_rankOne : LieAlgebra.rank R L ≤ 1 → Subsingleton S

/-! ## The bridge to the landed order separation (PROVED, modulo the open class) -/

/-- **Decoupled tie: single generator ⟹ tensor-generation chain.** Given the landed
    subsingleton⟹total lemma `subsingleton_forces_total` **threaded as an explicit
    hypothesis** (so this file does not import the unmerged PR #4285 branch) and a single
    fundamental object `hgen : Subsingleton S`, the free tensor-generation order on
    `S → ℕ` is total. Proved sorry-free; it is the concrete rep-theory→order composition
    step. (The threaded hypothesis is discharged by the landed
    `QOU.Atomicity.subsingleton_forces_freeGen_total`, or locally by
    `singleGenerator_forces_genTotal` above.) -/
theorem singleGenerator_gives_chain {S : Type*}
    (subsingleton_forces_total : Subsingleton S → IsTotal (S → ℕ) genLe)
    (hgen : Subsingleton S) :
    IsTotal (S → ℕ) genLe :=
  subsingleton_forces_total hgen

/-- **Full composition (PROVED, modulo the one open class): rank-1 ⟹ jet-tower chain.**
    Threads together the open rep-theory premise `RankOneImpliesSingleGenerator` and the
    landed order lemma (as the explicit hypothesis `subsingleton_forces_total`): *if* the
    Lie algebra has rank `≤ 1`, then the tensor-generation order on the fundamental weight
    monoid `S → ℕ` is **total — the jet tower is a chain**.

    This is the exact tie between representation theory and the landed order-theoretic
    separation `atomicity_is_jet_tower_totality` (PR #4285): rank-1 (rep side) collapses
    the tensor-generation order to a chain (order side). The **only** unproved input is the
    open class `RankOneImpliesSingleGenerator`; the implication itself is sorry-free. -/
theorem rankOne_gives_jetTowerChain {R L : Type*} [CommRing R] [Nontrivial R] [LieRing L]
    [LieAlgebra R L] [Module.Finite R L] [Module.Free R L] {S : Type*}
    [C : RankOneImpliesSingleGenerator R L S]
    (subsingleton_forces_total : Subsingleton S → IsTotal (S → ℕ) genLe)
    (hrank : LieAlgebra.rank R L ≤ 1) :
    IsTotal (S → ℕ) genLe :=
  subsingleton_forces_total (C.single_generator_of_rankOne hrank)

/-- **Fully self-contained variant.** Same composition, but the subsingleton⟹total step is
    discharged *internally* by the local sorry-free `singleGenerator_forces_genTotal`
    instead of being threaded. This exhibits that the chain half really closes with no
    hidden gap: the sole unproved input remains the open class
    `RankOneImpliesSingleGenerator`. -/
theorem rankOne_gives_jetTowerChain' {R L : Type*} [CommRing R] [Nontrivial R] [LieRing L]
    [LieAlgebra R L] [Module.Finite R L] [Module.Free R L] {S : Type*}
    [C : RankOneImpliesSingleGenerator R L S]
    (hrank : LieAlgebra.rank R L ≤ 1) :
    IsTotal (S → ℕ) genLe :=
  singleGenerator_forces_genTotal (C.single_generator_of_rankOne hrank)

/-! ## The jet-tower chain axiom is a CONCLUSION, not a fourth premise

The corpus atomicity target — *the jet-tower simple-object order is a chain* — is often
stated as if it were an independent axiom. This file, together with the landed pieces,
shows it is instead the **conclusion** of three inputs already present in the development:

1. `{G ↪ Sp(V)}` — the Tannaka dual `G` of the self-dual rank-2 object embeds in a
   symplectic group (categorical input; `def:tannaka-dual`).
2. `{landed rank ≤ 1}` — `LieAlgebra.rank K 𝔤 ≤ 1` for `𝔤 ⊆ 𝔰𝔩₂`, proved sorry-free in
   `QOU/ParticleInteractions/AtomicityLieRank.lean` (PR #4285).
3. `{this file}` — rank-1 ⟹ single fundamental object (open class) ⟹ tensor-generation
   chain (`rankOne_gives_jetTowerChain'`, sorry-free modulo (2) and the open class).

So the "jet-tower chain axiom" is *derived* from `(1) + (2) + (3)`; it is **not** a
4th independent premise. The one genuinely-open link is the rep-theory step (3)'s class.

### Direct Tannakian-reconstruction route (sketched, OPEN — uninhabited class)

An alternative to routing through `LieAlgebra.rank` is the direct Tannakian statement:
the neutral Tannakian category `(Rep(G), ⊗, τ)` with a rank-1 dual `G` is
`⊗`-reconstructed from a single fundamental object. We record this as a **second open
premise** — an uninhabited class carrying its real content, no instance, no `sorry` —
so the route is visible without being overclaimed. It is deliberately *not* wired to the
bridge above; it is an independent attack on the same conclusion. -/

/-- **Direct Tannakian-reconstruction premise (OPEN — uninhabited class).** For a neutral
    Tannakian category whose Tannaka dual `G` (a `Prop`-flagged rank-1 datum
    `hRankOne`) reconstructs `Rep(G)`, the fundamental-object generating set `S` is a
    subsingleton — `Rep(G)` is `⊗`-generated by one object, *without* passing through the
    Lie-algebra rank. The field is the genuine implication (`hRankOne → Subsingleton S`),
    not `True`. **No instance is provided** — this is the honest open state of the direct
    route (Tannakian reconstruction + rank-1 highest-weight classification, absent from
    Mathlib). Kept separate from `RankOneImpliesSingleGenerator` as an independent
    (duplicate-permitted) angle.

    -- Ref: Deligne–Milne, *Tannakian Categories*, LNM 900; Fulton–Harris §23 (rank-1). -/
class TannakianRankOneSingleGenerator (S : Type*) (hRankOne : Prop) : Prop where
  /-- Direct reconstruction content: a rank-1 Tannaka dual `⊗`-generates `Rep(G)` from a
      single fundamental object. Open — no instance. -/
  single_generator_of_tannaka_rankOne : hRankOne → Subsingleton S

/-- **Direct-route bridge (PROVED, modulo the open Tannakian class).** If the direct
    Tannakian reconstruction premise holds and the rank-1 flag `hRankOne` is given, the
    tensor-generation order is total — the jet-tower chain, obtained without the
    `LieAlgebra.rank` detour. Sorry-free; the sole open input is
    `TannakianRankOneSingleGenerator`. -/
theorem tannaka_rankOne_gives_jetTowerChain {S : Type*} {hRankOne : Prop}
    [T : TannakianRankOneSingleGenerator S hRankOne]
    (hrank : hRankOne) :
    IsTotal (S → ℕ) genLe :=
  singleGenerator_forces_genTotal (T.single_generator_of_tannaka_rankOne hrank)

end QOU.Atomicity.RankOneToSingleObject
