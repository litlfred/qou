import QOU.Basic
import QOU.BraidKnot.CrystalGraphRealization

/-!
# QOU.BraidKnot.SymmetricCrystalPairProduction — type B folding (conjecture)

Class axiomatisation of [conj:symmetric-crystal-pair-production]:
folding the `𝔰𝔩_n` Cartan datum into Type B forces every Kashiwara
descent step to occur as a pair `(f̃_i, f̃_{ī})` whose two
descendants are bar-conjugate.  Single chiral excitations are
unreachable; matter and antimatter are produced together as
bar-conjugate pairs.

Takes `[CrystalGraphRealization R q]` as upstream input.

LaTeX: `\label{conj:symmetric-crystal-pair-production}`

References:
- Kashiwara, M. (1991).
- Lecouvey, C. (2007).
- Khovanov, M. & Lauda, A. D. (2009).
- Brundan, J. & Kleshchev, A. (2009).
-/

namespace QOU.BraidKnot

universe u

/-- **Symmetric-crystal pair production (conjecture).**

    Encodes Type-B folding of the `𝔰𝔩_n` crystal: every transition
    `v_0 → v_- ⊔ v_+` from a bar-invariant source produces a
    bar-conjugate pair, and every normal form generated by the GS
    engine is bar-invariant. -/
-- Ref: [kashiwara1991] Kashiwara, "On crystal bases of the q-analogue of universal enveloping algebras," Duke Math. J. 63 (1991)
-- Ref: [lecouvey2007] Lecouvey, "Combinatorics of crystal graphs for the root systems of types A_n, B_n, C_n, D_n and G_2," Combinatorial Aspect of Integrable Systems (MSJ Memoirs 17, 2007)
-- Ref: [khovanovlauda2009] Khovanov & Lauda, "A diagrammatic approach to categorification of quantum groups," Repr. Theory 13 (2009), arXiv:0803.4121
-- Ref: [brundankleshchev2009] Brundan & Kleshchev, "Blocks of cyclotomic Hecke algebras and Khovanov-Lauda algebras," Invent. Math. 178 (2009), arXiv:0808.2032
class SymmetricCrystalPairProduction (R : Type u) [CommRing R] (q : R)
    [C : CrystalGraphRealization R q] where
  /-- Bar-involution on normal forms `T_w ↦ T̄_w` (sends `q ↦ q⁻¹`
      and reverses crossings). -/
  barInvolution : C.NormalForm → C.NormalForm
  /-- Bar-involution is involutive. -/
  bar_involutive : ∀ T : C.NormalForm,
    barInvolution (barInvolution T) = T
  /-- **The conjecture itself**: every GS normal form is
      bar-invariant.  Plays the role of `sorry`. -/
  bar_invariant : ∀ T : C.NormalForm, barInvolution T = T

namespace SymmetricCrystalPairProduction

/-- Unconditional structural lemma: bar-involution acts as the
    identity on every normal form.  Direct from `bar_invariant`. -/
-- Ref: [leitner2026] braids-and-knots/symmetric-crystal-pair-production
theorem barInvolution_eq_self
    {R : Type u} [CommRing R] {q : R}
    [C : CrystalGraphRealization R q]
    [S : SymmetricCrystalPairProduction R q]
    (T : C.NormalForm) :
    S.barInvolution T = T :=
  S.bar_invariant T

/-- Bar-involution-twice is the identity (corollary of involutivity). -/
-- Ref: [leitner2026] braids-and-knots/symmetric-crystal-pair-production
theorem barInvolution_idem
    {R : Type u} [CommRing R] {q : R}
    [C : CrystalGraphRealization R q]
    [S : SymmetricCrystalPairProduction R q]
    (T : C.NormalForm) :
    S.barInvolution (S.barInvolution T) = T :=
  S.bar_involutive T

/-- **Conditional theorem (CPT pairing on highest-weight vectors).**

    Assuming both `[CrystalGraphRealization R q]` and
    `[SymmetricCrystalPairProduction R q]`: the bar-image of any GS
    normal form has the same crystal node as the original, and is
    therefore also a Kashiwara highest-weight vector.  This is the
    Lean shadow of the bar-conjugate det-law identity and the
    structural CPT-pairing observation. -/
-- Ref: [leitner2026] braids-and-knots/symmetric-crystal-pair-production
theorem nodeOf_barInvolution_highest_weight
    {R : Type u} [CommRing R] {q : R}
    [C : CrystalGraphRealization R q]
    [S : SymmetricCrystalPairProduction R q]
    (T : C.NormalForm) (i : ℕ) :
    C.raising i (C.nodeOf (S.barInvolution T)) = none := by
  rw [S.bar_invariant T]
  exact C.crystal_realises T i

/-- **The trivial model — a `def`, not an `instance`, and not "faithful".**

    Its docstring said *"Faithful instance. Carries the explicit research-grade
    conjecture as a sorry."* Neither half was true. There is no `sorry`: it sets
    `barInvolution T := T`, so `bar_invariant` is discharged by `rfl` on
    `T = T`. Every normal form is bar-invariant because the bar involution is
    the identity map — nothing here sends `q ↦ q⁻¹` or reverses a crossing, and
    `bar_involutive` is `rfl` for the same reason. A `sorry` would at least be
    visible to `#print axioms`; this was not.

    As an unconditional `instance` it made `barInvolution_eq_self` and
    `nodeOf_barInvolution_highest_weight` unconditional theorems about the
    identity map, so `conj:symmetric-crystal-pair-production` asserted nothing.

    Demoted the same way as `ConfinementGradingCorrespondence.canonical`
    (bean `qou-fngs`). Nothing consumed it: the class has no users outside this
    file.

    **Still open:** that the GS-generated normal forms are fixed by the genuine
    bar involution, and the Type-B folding statement that a transition
    `v₀ → v₋ ⊔ v₊` out of a bar-invariant source produces a bar-conjugate
    pair — which no field of this class states. -/
def canonical (R : Type u) [CommRing R] (q : R)
    [C : CrystalGraphRealization R q] :
    SymmetricCrystalPairProduction R q where
  barInvolution T := T
  bar_involutive _ := rfl
  -- Ref: [leitner2026] conj:symmetric-crystal-pair-production (§3b-cond conjectural class;
  --      discharged here by `barInvolution := id`, not by a `sorry` and not by the conjecture)
  bar_invariant _ := rfl

end SymmetricCrystalPairProduction

end QOU.BraidKnot
