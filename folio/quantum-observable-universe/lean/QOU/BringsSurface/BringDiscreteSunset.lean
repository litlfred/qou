/-! ## The vertex graph, read off the map -/

/-- The representative of vertex `i`. -/
def rv (i : ℕ) : Perm (Fin 5) := repV.getD i 1

def idx : List ℕ := List.range 30

/-- Neighbour `k` of vertex `i`. -/
def nbr (i k : ℕ) : ℕ := (nbrT.getD i []).getD k 0

def aS (i : ℕ) : ℕ := actST.getD i 0
def aA (i : ℕ) : ℕ := actAT.getD i 0
def aC (i : ℕ) : ℕ := actCT.getD i 0
def aR (r : Fin 7) (i : ℕ) : ℕ := (actRT.getD r []).getD i 0

/-- The 30 representatives lie in distinct cosets of `⟨S⟩`. Since `|S₅| = 120 = 30 · 4`, the
cosets are all the vertices. -/
theorem cosets_distinct :
    (idx.all fun i => idx.all fun j => i == j || decide ((rv i)⁻¹ * rv j ∉ vStab)) = true := by
  decide +kernel

/-- The neighbour table is the edge involution: `rv i · S^k · A` lies in the coset `nbr i k`. -/
theorem nbr_correct :
    (idx.all fun i => (List.range 4).all fun k =>
      decide ((rv (nbr i k))⁻¹ * (rv i * S ^ k * A) ∈ vStab)) = true := by
  decide +kernel

/-- The action tables are the left actions of `S`, `A` (which generate `S₅`, `closure_S_A`)
and the right action of `T` (the reflection `c`). -/
theorem actions_correct :
    (idx.all fun i => decide ((rv (aS i))⁻¹ * (S * rv i) ∈ vStab) &&
      decide ((rv (aA i))⁻¹ * (A * rv i) ∈ vStab) &&
      decide ((rv (aC i))⁻¹ * (rv i * T) ∈ vStab)) = true := by
  decide +kernel

/-- The class representatives `rep r` act by the table `actRT`. -/
theorem class_actions_correct :
    ((List.finRange 7).all fun r => idx.all fun i =>
      decide ((rv (aR r i))⁻¹ * (rep r * rv i) ∈ vStab)) = true := by
  decide +kernel

/-! ## Integer matrices as lists of rows -/

def entry (M : List (List ℤ)) (i j : ℕ) : ℤ := (M.getD i []).getD j 0

def ofFn (f : ℕ → ℕ → ℤ) : List (List ℤ) := idx.map fun i => idx.map fun j => f i j

def dot (r c : List ℤ) : ℤ := (List.zipWith (· * ·) r c).sum

def mulM (M N : List (List ℤ)) : List (List ℤ) :=
  let Nt := ofFn fun i j => entry N j i
  M.map fun r => Nt.map fun c => dot r c

def smulM (a : ℤ) (M : List (List ℤ)) : List (List ℤ) := M.map (·.map (a * ·))

def addM (M N : List (List ℤ)) : List (List ℤ) := List.zipWith (List.zipWith (· + ·)) M N

def eyeM (a : ℤ) : List (List ℤ) := ofFn fun i j => if i = j then a else 0

def zeroM : List (List ℤ) := ofFn fun _ _ => 0

def traceM (M : List (List ℤ)) : ℤ := (idx.map fun i => entry M i i).sum

/-- The graph Laplacian `Δ = 4 I − Adj` of the vertex graph: every vertex has degree 4, and
`Adj i j` counts the edges from `i` to `j`. -/
def lapM : List (List ℤ) :=
  ofFn fun i j => (if i = j then 4 else 0) - (((List.range 4).filter fun k => nbr i k = j).length : ℤ)

/-! ## The seven typed projectors -/

/-- The seven `S₅ × C₂` types occurring on vertices, as (type, parity):
`triv⁺, std⁺, [2,1,1,1]⁻, [3,2]⁺, [2,2,1]⁺, [2,2,1]⁻, [3,1,1]⁻`. -/
def ty : Fin 7 → Fin 7 := ![0, 2, 3, 4, 5, 5, 6]
def par : Fin 7 → Bool := ![false, false, true, false, false, true, true]

/-- The Laplace eigenvalue on each type. -/
def lam : Fin 7 → ℤ := ![0, 5, 7, 2, 6, 4, 2]

def qOf : Fin 7 → List (List ℤ) := ![qTriv, qStd, qS2111, qS32, qS221p, qS221m, qS311]

/-- `Σ_k P_k = I`. -/
theorem projectors_sum :
    addM (addM (addM (addM (addM (addM qTriv qStd) qS2111) qS32) qS221p) qS221m) qS311 =
      eyeM 120 := by decide +kernel

