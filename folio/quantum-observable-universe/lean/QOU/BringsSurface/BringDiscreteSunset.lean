/-- Each `P_k` commutes with the generators `S`, `A` of `S₅` and with the reflection `c`. -/
theorem projectors_equivariant :
    ∀ k : Fin 7, ofFn (fun i j => entry (qOf k) (aS i) (aS j)) = qOf k ∧
      ofFn (fun i j => entry (qOf k) (aA i) (aA j)) = qOf k ∧
      ofFn (fun i j => entry (qOf k) (aC i) (aC j)) = qOf k := by
  decide +kernel

/-- **The image of `P_k` is the type `ρ_k^±`.** On each class representative `g`, the trace of
`g` and of `g c` on the image of `P_k` is `χ_{ρ_k}(g)` and `± χ_{ρ_k}(g)`. -/
theorem projectors_characters :
    ∀ k r : Fin 7, (idx.map fun j => entry (qOf k) j (aR r j)).sum = 120 * irr (ty k) r ∧
      (idx.map fun j => entry (qOf k) j (aR r (aC j))).sum =
        120 * (if par k then -1 else 1) * irr (ty k) r := by
  decide +kernel

theorem laplacian_0 : mulM lapM qTriv = smulM 0 qTriv := by decide +kernel

theorem laplacian_1 : mulM lapM qStd = smulM 5 qStd := by decide +kernel

theorem laplacian_2 : mulM lapM qS2111 = smulM 7 qS2111 := by decide +kernel

theorem laplacian_3 : mulM lapM qS32 = smulM 2 qS32 := by decide +kernel

theorem laplacian_4 : mulM lapM qS221p = smulM 6 qS221p := by decide +kernel

theorem laplacian_5 : mulM lapM qS221m = smulM 4 qS221m := by decide +kernel

theorem laplacian_6 : mulM lapM qS311 = smulM 2 qS311 := by decide +kernel

/-- **Each type is one Laplace eigenspace** (multiplicity one, so Schur): `Δ P_k = λ_k P_k`. -/
theorem laplacian_on_types : ∀ k : Fin 7, mulM lapM (qOf k) = smulM (lam k) (qOf k) := by
  intro k; fin_cases k
  exacts [laplacian_0, laplacian_1, laplacian_2, laplacian_3, laplacian_4, laplacian_5, laplacian_6]

/-! ## The Green function and the sunset -/

/-- `50400 · G`, with `G = Σ_{k ≠ triv} P_k / λ_k`. -/
def gInt : List (List ℤ) :=
  addM (addM (addM (addM (addM (smulM 84 qStd) (smulM 60 qS2111)) (smulM 210 qS32))
    (smulM 70 qS221p)) (smulM 105 qS221m)) (smulM 210 qS311)

/-- **`G` is the Green function**: `Δ G = I − J/30`, the identity on mean-zero functions. -/
theorem green_function :
    mulM lapM gInt = addM (eyeM 50400) (ofFn fun _ _ => -1680) := by decide +kernel

/-- The typed partial sunset, scaled: `Σ_{x,y} (120 P_a)(120 P_b)(120 P_c)`. -/
def cube (a b c : Fin 7) : ℤ :=
  (idx.map fun i => (idx.map fun j =>
    entry (qOf a) i j * entry (qOf b) i j * entry (qOf c) i j).sum).sum

theorem selection_0 : ∀ b c : Fin 7,
    allowedParity (ty 0) (ty b) (ty c) (par 0) (par b) (par c) = false → cube 0 b c = 0 := by
  decide +kernel

theorem selection_1 : ∀ b c : Fin 7,
    allowedParity (ty 1) (ty b) (ty c) (par 1) (par b) (par c) = false → cube 1 b c = 0 := by
  decide +kernel

theorem selection_2 : ∀ b c : Fin 7,
    allowedParity (ty 2) (ty b) (ty c) (par 2) (par b) (par c) = false → cube 2 b c = 0 := by
  decide +kernel

theorem selection_3 : ∀ b c : Fin 7,
    allowedParity (ty 3) (ty b) (ty c) (par 3) (par b) (par c) = false → cube 3 b c = 0 := by
  decide +kernel

theorem selection_4 : ∀ b c : Fin 7,
    allowedParity (ty 4) (ty b) (ty c) (par 4) (par b) (par c) = false → cube 4 b c = 0 := by
  decide +kernel

theorem selection_5 : ∀ b c : Fin 7,
    allowedParity (ty 5) (ty b) (ty c) (par 5) (par b) (par c) = false → cube 5 b c = 0 := by
  decide +kernel

theorem selection_6 : ∀ b c : Fin 7,
    allowedParity (ty 6) (ty b) (ty c) (par 6) (par b) (par c) = false → cube 6 b c = 0 := by
  decide +kernel

/-- **The selection rule holds on the graph.** A typed triple forbidden by `allowedParity`
(no invariant in `ρ_a ⊗ ρ_b ⊗ ρ_c`, or an odd number of reflection-odd factors) contributes
exactly zero. -/
theorem sunset_selection :
    ∀ a b c : Fin 7, allowedParity (ty a) (ty b) (ty c) (par a) (par b) (par c) = false →
      cube a b c = 0 := by
  intro a; fin_cases a
  exacts [selection_0, selection_1, selection_2, selection_3, selection_4, selection_5, selection_6]

/-- **The rule is necessary, not sufficient.** `std⁺ ⊗ std⁺ ⊗ [3,2]⁺` is allowed
(`N = 1`, all even), yet its partial sunset on the graph vanishes. -/
theorem allowed_but_zero : allowedParity 2 2 4 false false false = true ∧ cube 1 1 3 = 0 := by
  decide +kernel

/-- `Σ_{x,y} (50400 G(x,y))³`. -/
def sunsetInt : ℤ := (gInt.map fun r => (r.map fun x => x ^ 3).sum).sum

theorem sunsetInt_eq : sunsetInt = 103662241804800 := by decide +kernel

/-- **The exact discrete sunset** of the Bring vertex graph:
`Σ_{x,y} G(x,y)³ = 18364201 / 22680000`. -/
theorem discrete_sunset :
    (sunsetInt : ℚ) / 50400 ^ 3 = 18364201 / 22680000 := by
  rw [sunsetInt_eq]; norm_num

/-- **The graph spectrum.** Multiplicities from the traces: `λ = 0, 5, 7, 2, 6, 4, 2` with
`dim = 1, 4, 4, 5, 5, 5, 6`. So `spec Δ = {0¹, 2¹¹, 4⁵, 5⁴, 6⁵, 7⁴}`, and the eigenvalue `2`
carries two types, `[3,2]⁺ ⊕ [3,1,1]⁻`. -/
theorem graph_spectrum : ∀ k : Fin 7, traceM (qOf k) = 120 * irr (ty k) 0 := by decide +kernel

end QOU.Brings.DiscreteSunset
