import QOU.BringsSurface.BringRegularMap
import MathlibExt.CombinatorialMapEuler
import MathlibExt.MapGenusNonneg
import MathlibExt.VoltageLift
import Mathlib.GroupTheory.SpecificGroups.Alternating
import BraidKnotOctonion.HeckeMapFaceSize

/-!
# `QOU.BringsSurface.BringMapChain` — the `χ = −6` chain, starting from the Bring map

Bean `qou-qhcr` (with `qou-m3tr`, `qou-yslf`). Owner ruling 2026-11-27 ("Start from the finite
map", `docs/coordination/owner-rulings.md`): the `χ = −6` chain starts from the regular map
`{5,4}` of `QOU.BringRegularMap`, not from a compact Riemann surface. The smooth surface is a
model of this map. So the chain needs no triangulation theorem (Radó), no covering theory and no
Riemann–Hurwitz: every step below is finite group theory.

## The map

Darts are the 120 elements of `S₅`. The rotation is `σ = (· * S)`, the edge involution is
`α = (· * A)`, with `S = (1 2 3 4)` and `A = (0 1)` from `BringRegularMap`. Faces are the cycles of
`σ * α = (· * (A * S))`.

## What is proved (sorry-free)

* `numCycles_mulRight`: the cycles of `(· * g)` are the left cosets of `⟨g⟩`, so their number is
  the index of `⟨g⟩`.
* `bring_chi`: `|V| − |E| + |F| = 30 − 60 + 24 = −6`, counted on the map itself.
* `bring_isMap`, `bring_connected`: `(σ, α)` is a connected combinatorial map (`α` a
  fixed-point-free involution; connected because `S` and `A` generate `S₅`).
* `bring_genus`: its genus, defined from the cycle counts, is `4`.
* `bring_S5_equivariant`, `bring_S5_free`: `S₅` acts on the left, commuting with `σ` and `α` and
  freely on darts. Hence (`VoltageLift.cycle_stabilizer_isCyclic`) every vertex, edge and face
  stabiliser is cyclic.
* `bring_A5_edges_free`: `A₅` acts freely on the edges. An element fixing an edge is a conjugate
  of the transposition `A`, which is odd.
* `agrees_with_regularMap`, `dual_agrees_with_VEF`: the map is the tessellation already in the
  corpus. Its cycle counts are the coset indices of `BringRegularMap.euler`. Its dual (faces and
  vertices exchanged) has the counts `(24, 60, 30)` that `HeckeMapFaceSize.bring_VEF` derives in
  the Kattan–Singerman convention, where `{5,4}` means quadrilateral faces. The Python model
  `computations/probes/bring54_map.py` builds the same map (darts `S₅`, `g ↦ g·y`, `g ↦ g·t`).

## The Riemann model, when needed

Gluing 24 regular hyperbolic pentagons with angles `π/2` along this map, or equivalently taking the
`(2,4,5)` triangle-group quotient of the hyperbolic plane (Belyi / dessin), gives a compact Riemann
surface whose cell structure is this map. That direction is analysis and is not used by the chain;
if it is formalised it belongs in `QOU/Transcendental/`. The converse (a given Riemann surface *is*
this map) is the backup route, beans `qou-0nr6` and `qou-gu23`.

## What this does not settle

* The map is an input. Why QOU selects this map (rather than another `A₅`- or `S₅`-map of the same
  Euler characteristic) is not derived here; `A5LeastHyperbolicChi` and `S5StrongSymmetricGenus`
  say it is extremal among such maps, and the extremality is a selection principle no axiom
  supplies yet (owner card 2026-11-27, "Look for an axiom that gives it").
* `A₅` does **not** act freely on the faces of this map: the face stabilisers are generated by
  conjugates of the 5-cycle `A * S`, which are even. So `chi_le_neg_six_of_A5_map` (free on faces)
  does not apply to it directly.
* The smooth Riemann surface is a model of the map. Proving that a given compact Riemann surface
  with an `A₅`-action *is* this map is the backup route, beans `qou-0nr6` (Radó) and `qou-gu23`
  (monodromy).

No `sorry`, no axiom, no `native_decide`.

Ref: [edge1978] Edge, Bring's curve, J. London Math. Soc. 1978 (the identification with Bring's
curve, not used in any proof here).
-/

namespace QOU.BringsSurface.BringMapChain

open Equiv Relation QOU.BringRegularMap QOU.RiemannSurface.CombinatorialMapEuler
  QOU.RiemannSurface.CombinatorialMapQuotient
open QOU.RiemannSurface.MapGenusNonneg (orbits orbitSetoid)

/-- Darts of the Bring map. -/
abbrev Dart := Perm (Fin 5)

/-- Vertex rotation: right multiplication by `S`. -/
def σ : Perm Dart := Equiv.mulRight S
/-- Edge involution: right multiplication by `A`. -/
def α : Perm Dart := Equiv.mulRight A

/-! ## Cycles of a right multiplication are cosets -/

theorem sameCycle_mulRight_iff {G : Type*} [Group G] (g x y : G) :
    (Equiv.mulRight g).SameCycle x y ↔ QuotientGroup.leftRel (Subgroup.zpowers g) x y := by
  rw [QuotientGroup.leftRel_apply, Subgroup.mem_zpowers_iff]
  constructor
  · rintro ⟨k, hk⟩
    refine ⟨k, ?_⟩
    rw [zpow_mulRight, Equiv.coe_mulRight] at hk
    rw [← hk, inv_mul_cancel_left]
  · rintro ⟨k, hk⟩
    refine ⟨k, ?_⟩
    rw [zpow_mulRight, Equiv.coe_mulRight, hk]
    exact mul_inv_cancel_left x y

/-- **The cycles of `(· * g)` are the left cosets of `⟨g⟩`.** -/
theorem numCycles_mulRight {G : Type*} [Group G] (g : G) :
    numCycles (Equiv.mulRight g) = (Subgroup.zpowers g).index := by
  rw [Subgroup.index_eq_card, numCycles]
  exact Nat.card_congr (Quotient.congr (Equiv.refl G) (sameCycle_mulRight_iff g))

theorem orderOf_AS : orderOf (A * S) = 5 := orderOf_eq_prime (by decide) (by decide)

theorem σα_eq : σ * α = Equiv.mulRight (A * S) := by
  rw [σ, α, mulRight_mul]

/-! ## The counts and `χ = −6` -/

theorem numCycles_σ : numCycles σ = 30 := by rw [σ, numCycles_mulRight, index_S]
theorem numCycles_α : numCycles α = 60 := by rw [α, numCycles_mulRight, index_A]
theorem numCycles_σα : numCycles (σ * α) = 24 := by
  rw [σα_eq, numCycles_mulRight, index_of_order (A * S) orderOf_AS (by norm_num)]

/-- **`χ = −6`, counted on the map.** -/
theorem bring_chi : (numCycles σ : ℤ) - numCycles α + numCycles (σ * α) = -6 := by
  rw [numCycles_σ, numCycles_α, numCycles_σα]; norm_num

/-- **Genus 4.** -/
theorem bring_genus : (numCycles σ : ℤ) - numCycles α + numCycles (σ * α) = 2 - 2 * 4 := by
  rw [bring_chi]; norm_num

/-! ## It is a connected combinatorial map -/

theorem A_mul_A : A * A = 1 := by decide

theorem bring_isMap : α * α = 1 ∧ ∀ x, α x ≠ x := by
  refine ⟨?_, ?_⟩
  · rw [α, ← mulRight_mul, A_mul_A]; rfl
  · intro x h
    have : x * A = x * 1 := by rw [mul_one]; exact h
    exact absurd (mul_left_cancel this) (by decide)

/-- Left multiplication preserves the generating steps, so it preserves the orbit relation. -/
theorem rel_mul_left (g : Dart) {u v : Dart} (h : (orbitSetoid σ α) u v) :
    (orbitSetoid σ α) (g * u) (g * v) := by
  induction h with
  | rel a b hab =>
    refine EqvGen.rel _ _ ?_
    rcases hab with rfl | rfl
    · left; simp [σ, mul_assoc]
    · right; simp [α, mul_assoc]
  | refl => exact EqvGen.refl _
  | symm _ _ _ ih => exact EqvGen.symm _ _ ih
  | trans _ _ _ _ _ ih1 ih2 => exact EqvGen.trans _ _ _ ih1 ih2

theorem rel_one (x : Dart) : (orbitSetoid σ α) 1 x := by
  have hx : x ∈ Subgroup.closure ({S, A} : Set Dart) := by rw [closure_S_A]; trivial
  induction hx using Subgroup.closure_induction with
  | mem y hy =>
    refine EqvGen.rel _ _ ?_
    rcases hy with rfl | rfl
    · left; simp [σ]
    · right; simp [α]
  | one => exact EqvGen.refl _
  | mul y z _ _ hy hz =>
    have := rel_mul_left y hz
    rw [mul_one] at this
    exact EqvGen.trans _ _ _ hy this
  | inv y _ hy =>
    have := rel_mul_left y⁻¹ hy
    rw [mul_one, inv_mul_cancel] at this
    exact EqvGen.symm _ _ this

/-- **Connected.** -/
theorem bring_connected : orbits σ α = 1 := by
  rw [orbits, Nat.card_eq_one_iff_unique]
  refine ⟨⟨fun a b => ?_⟩, ⟨Quotient.mk _ 1⟩⟩
  induction a using Quotient.inductionOn with
  | h x =>
  induction b using Quotient.inductionOn with
  | h y =>
  exact Quotient.sound (EqvGen.trans _ _ _ (EqvGen.symm _ _ (rel_one x)) (rel_one y))

/-! ## The `S₅` and `A₅` actions -/

theorem bring_S5_equivariant :
    Equivariant σ (Perm (Fin 5)) ∧ Equivariant α (Perm (Fin 5)) := by
  refine ⟨fun g x => ?_, fun g x => ?_⟩ <;> simp [σ, α, smul_eq_mul, mul_assoc]

theorem bring_S5_free (g x : Dart) (h : g • x = x) : g = 1 := by
  rw [smul_eq_mul] at h
  have := congrArg (· * x⁻¹) h
  simpa using this

/-- Every cell stabiliser of `S₅` is cyclic: vertices, edges and faces. -/
theorem bring_S5_stabilizers_cyclic :
    (∀ v : Cycles σ, letI := cycleAction bring_S5_equivariant.1;
      IsCyclic (MulAction.stabilizer (Perm (Fin 5)) v)) ∧
    (∀ f : Cycles (σ * α), letI := cycleAction (bring_S5_equivariant.1.mul bring_S5_equivariant.2);
      IsCyclic (MulAction.stabilizer (Perm (Fin 5)) f)) :=
  ⟨fun v => QOU.RiemannSurface.VoltageLift.cycle_stabilizer_isCyclic _ bring_S5_free v,
   fun f => QOU.RiemannSurface.VoltageLift.cycle_stabilizer_isCyclic _ bring_S5_free f⟩

/-- **`A₅` acts freely on the edges.** If an even `h` fixes the edge through `x`, then `h • x` is
`x` or `x * A`; the second would make `h = x A x⁻¹`, which is odd. -/
theorem bring_A5_edges_free (h : alternatingGroup (Fin 5)) (x : Dart)
    (hx : α.SameCycle x ((h : Perm (Fin 5)) * x)) : h = 1 := by
  rcases QOU.RiemannSurface.VoltageLift.sameCycle_involution bring_isMap.1 hx with h1 | h1
  · exact Subtype.ext (bring_S5_free _ _ h1)
  · exfalso
    have hh : (h : Perm (Fin 5)) = x * A * x⁻¹ := by
      have h1' : (h : Perm (Fin 5)) * x = x * A := h1
      rw [← h1', mul_inv_cancel_right]
    have hs := h.2
    rw [Equiv.Perm.mem_alternatingGroup, hh, Perm.sign_mul, Perm.sign_mul, Perm.sign_inv] at hs
    have hA : Perm.sign A = -1 := by decide
    rw [hA] at hs
    have := Int.units_eq_one_or (Perm.sign x)
    rcases this with h2 | h2 <;> rw [h2] at hs <;> exact absurd hs (by decide)

/-! ## Agreement with the other Bring tessellations in the corpus -/

/-- **Agreement with `BringRegularMap.euler`.** The cycle counts of the map are exactly the coset
indices that file counts, so the two `χ = −6` statements are the same statement. -/
theorem agrees_with_regularMap :
    numCycles σ = (Subgroup.zpowers S).index ∧ numCycles α = (Subgroup.zpowers A).index ∧
      numCycles (σ * α) = (Subgroup.zpowers (S * A)).index := by
  refine ⟨by rw [σ, numCycles_mulRight], by rw [α, numCycles_mulRight], ?_⟩
  rw [numCycles_σα, index_SA]

/-- The dual map: vertices and faces exchanged (`σ' = σ * α`, same edges). -/
theorem dual_faces : σ * α * α = σ := by
  rw [mul_assoc, bring_isMap.1, mul_one]

/-- **Agreement with `HeckeMapFaceSize.bring_VEF`.** That file uses the Kattan–Singerman
convention, in which `{5,4}` means quadrilateral faces and vertices of valency 5, and gets
`(V, E, F) = (24, 60, 30)`. This map uses the Schläfli convention (pentagonal faces, valency 4),
`(30, 60, 24)`. They are dual maps: the dual of this map has exactly the counts and incidences
`bring_VEF` assumes, so both describe the same tessellation of the same surface. -/
theorem dual_agrees_with_VEF :
    (numCycles (σ * α) : ℤ) = 24 ∧ (numCycles α : ℤ) = 60 ∧ (numCycles (σ * α * α) : ℤ) = 30 := by
  have hV : (numCycles (σ * α) : ℤ) = 24 := by rw [numCycles_σα]; rfl
  have hE : (numCycles α : ℤ) = 60 := by rw [numCycles_α]; rfl
  have hF : (numCycles (σ * α * α) : ℤ) = 30 := by rw [dual_faces, numCycles_σ]; rfl
  exact QOU.Brings.bring_VEF _ _ _ (by rw [hF, hE]; norm_num)
    (by rw [hV, hE]; norm_num) (by rw [hV, hE, hF]; norm_num)

end QOU.BringsSurface.BringMapChain
