/-- Joint tracking: the permutation and both `q = 1` products of any letter word lie in the table
at a common index. -/
theorem joint (l : List Gen) : ∃ k : Fin 24, ⇑((l.map Gen.perm).prod) = F k ∧
    (l.map (fun g => P31 g.base)).prod = T31 k ∧ (l.map (fun g => P22 g.base)).prod = T22 k := by
  induction l using List.reverseRecOn with
  | nil => exact ⟨0, by simp [F_zero], by simp [T31_zero], by simp [T22_zero]⟩
  | append_singleton l x ih =>
    obtain ⟨k, h1, h2, h3⟩ := ih
    refine ⟨nxt k x.base, ?_, ?_, ?_⟩
    · simp only [List.map_append, List.prod_append, List.map_cons, List.map_nil, List.prod_cons,
        List.prod_nil, mul_one, Equiv.Perm.coe_mul, h1]
      exact F_step k x.base
    · simp only [List.map_append, List.prod_append, List.map_cons, List.map_nil, List.prod_cons,
        List.prod_nil, mul_one, h2]
      exact T31_step k x.base
    · simp only [List.map_append, List.prod_append, List.map_cons, List.map_nil, List.prod_cons,
        List.prod_nil, mul_one, h3]
      exact T22_step k x.base

/-! ### Norm helpers (`ℓ∞` operator norm) -/

theorem norm_le_of_rows {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) (r : ℝ) (hr : 0 ≤ r)
    (h : ∀ i, ∑ j, |A i j| ≤ r) : ‖A‖ ≤ r := by
  rw [Matrix.linfty_opNorm_def]
  have : (Finset.univ.sup fun i => ∑ j, ‖A i j‖₊) ≤ (⟨r, hr⟩ : NNReal) := by
    refine Finset.sup_le fun i _ => ?_
    rw [← NNReal.coe_le_coe]
    push_cast
    simpa [Real.norm_eq_abs] using h i
  exact_mod_cast this

theorem abs_entry_le_norm {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) (i j : Fin n) :
    |A i j| ≤ ‖A‖ := by
  rw [Matrix.linfty_opNorm_def]
  have h1 : ‖A i j‖₊ ≤ ∑ k, ‖A i k‖₊ :=
    Finset.single_le_sum (f := fun k => ‖A i k‖₊) (fun _ _ => zero_le _) (Finset.mem_univ j)
  have h2 : ∑ k, ‖A i k‖₊ ≤ Finset.univ.sup fun i => ∑ k, ‖A i k‖₊ :=
    Finset.le_sup (f := fun i => ∑ k, ‖A i k‖₊) (Finset.mem_univ i)
  have h3 := h1.trans h2
  rw [← NNReal.coe_le_coe] at h3
  simpa [Real.norm_eq_abs] using h3

theorem frac_bound {N D p c t : ℝ} (hD : 0 < D) (hu : N - p * D ≤ c * t * D)
    (hl : -(c * t * D) ≤ N - p * D) : |N / D - p| ≤ c * t := by
  have e : N / D - p = (N - p * D) / D := by field_simp
  rw [e, abs_div, abs_of_pos hD, div_le_iff₀ hD, abs_le]
  constructor <;> linarith

theorem poly_bound {N p c t : ℝ} (hu : N - p ≤ c * t) (hl : -(c * t) ≤ N - p) :
    |N - p| ≤ c * t := abs_le.mpr ⟨by linarith, by linarith⟩

theorem tb {q : ℝ} (h0 : 1 ≤ q) (h1 : q ≤ 11 / 10) (k : ℕ) :
    0 ≤ (q - 1) ^ k ∧ (q - 1) ^ (k + 1) ≤ (q - 1) ^ k / 10 := by
  have a : 0 ≤ q - 1 := by linarith
  refine ⟨pow_nonneg a k, ?_⟩
  have := pow_nonneg a k
  rw [pow_succ]
  nlinarith

