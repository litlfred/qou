/-
# Which block-weighted traces on `H₃` kill the right line?

Bean `qou-hlx7` (epic `qou-qs0e`), owner decision 2026-11-15 (route 2, after D-H3): turn
the weak-knot negative of `WeakVertexLeftProjector.lean` into a statement about every
trace of the shape convention D has.

## Setting

`H₃(q)` acts on three blocks: the trivial block (every generator acts by `q`), the
two-dimensional block `(2,1)`, and the sign block (every generator acts by `−q⁻¹`). We
work in the product ring `Blk K := K × Matrix (Fin 2) (Fin 2) K × K` with the explicit
images `S1`, `S2` of the generators. They satisfy the Hecke relation (`S1_letter`,
`S2_letter`) and the braid relation (`braid_rel`), so `σᵢ ↦ Sᵢ` defines an algebra map
from `H₃(q)`. That this map is an isomorphism for generic `q` (Wedderburn) is cited and
is NOT used below: the necessity direction only evaluates the trace on the images of
`1` and `σ₂`.

A block-weighted trace is `τ_y(t, M, s) = y₃·t + y₂₁·tr M + y₁₁₁·s`. Convention D is
`y₁₁₁ = 0`, `y₂₁ = q²/(q²+1)²`.

## What this file proves

* `Pm_S1`: the right-line projector of `σ₁` is `(0, !![0,0; −[2]⁻¹, 1], 1)`. It is zero
  on the trivial block.
* `trace_kills_right_of`: if `y₂₁ = y₁₁₁ = 0`, then `τ_y(x·P_R) = 0` for EVERY block
  element `x`.
* `weights_zero_of_kills_right`: if `τ_y(P_R) = 0` and `τ_y(σ₂·P_R) = 0`, then
  `y₂₁ = y₁₁₁ = 0`, provided `q⁴ + q² + 1 ≠ 0` (that is, `[3]_q ≠ 0`).
* `kills_right_iff`: for every set of block elements containing the images of `1` and
  `σ₂`, in particular the image of `H₃(q)`, the trace kills every `x·P_R` iff
  `y₂₁ = y₁₁₁ = 0`. With the normalisation `τ(1) = 1` the trace is then the trivial
  character `x ↦ x.1` (`normalised_eq_augmentation`), which is the augmentation.
* `conventionD_not_kills_right`: convention D has `y₂₁ = q²/(q²+1)² ≠ 0`, so it does not
  kill the right line.

So "every word is left-supported" singles out the augmentation and nothing else. The
obstruction is that the ideal generated by `P_R` meets the `(2,1)` block. This file
does not propose changing the owner-ruled trace (`z_D`, 2026-09-08). Choosing a trace to
recover one-sidedness would be selection against a target.

Base ring (§7c): generic `[Field K]`. No `ℝ`. No `sorry`, no axiom.

-- Ref: [jones1987] https://doi.org/10.2307/1971403
-/
import QOU.QuarkState.HelicityCommonSource
import Mathlib.LinearAlgebra.Matrix.Trace
import Mathlib.Data.Matrix.Mul

namespace QOU.QuarkState.RightLineTraceObstruction

open QOU.QuarkState.Helicity Matrix

variable {K : Type*} [Field K] {q : K}

/-- The three Wedderburn blocks of `H₃`, as a product ring. -/
abbrev Blk (K : Type*) [Field K] := K × Matrix (Fin 2) (Fin 2) K × K

/-- Image of `σ₁`. -/
def S1 (q : K) : Blk K := (q, !![q, 0; 1, -q⁻¹], -q⁻¹)

/-- Image of `σ₂`. -/
def S2 (q : K) : Blk K := (q, !![-q⁻¹, 1; 0, q], -q⁻¹)

theorem S1_letter (hq : q ≠ 0) : IsLetter q (S1 q) := by
  unfold IsLetter S1
  refine Prod.ext ?_ (Prod.ext ?_ ?_)
  · simp
    all_goals first | ring1 | (field_simp; ring1) | (left; ring1) | (left; field_simp; ring1) | simp [hq]
  · ext i j
    fin_cases i <;> fin_cases j <;> simp
    all_goals first | ring1 | (field_simp; ring1) | (left; ring1) | (left; field_simp; ring1) | simp [hq]
  · simp
    all_goals first | ring1 | (field_simp; ring1) | (left; ring1) | (left; field_simp; ring1) | simp [hq]

theorem S2_letter (hq : q ≠ 0) : IsLetter q (S2 q) := by
  unfold IsLetter S2
  refine Prod.ext ?_ (Prod.ext ?_ ?_)
  · simp
    all_goals first | ring1 | (field_simp; ring1) | (left; ring1) | (left; field_simp; ring1) | simp [hq]
  · ext i j
    fin_cases i <;> fin_cases j <;> simp
    all_goals first | ring1 | (field_simp; ring1) | (left; ring1) | (left; field_simp; ring1) | simp [hq]
  · simp
    all_goals first | ring1 | (field_simp; ring1) | (left; ring1) | (left; field_simp; ring1) | simp [hq]

theorem braid_rel (hq : q ≠ 0) : S1 q * S2 q * S1 q = S2 q * S1 q * S2 q := by
  unfold S1 S2
  refine Prod.ext ?_ (Prod.ext ?_ ?_)
  · simp
    all_goals first | ring1 | (field_simp; ring1) | (left; ring1) | (left; field_simp; ring1) | simp [hq]
  · ext i j
    fin_cases i <;> fin_cases j <;> simp
    all_goals first | ring1 | (field_simp; ring1) | (left; ring1) | (left; field_simp; ring1) | simp [hq]
  · simp
    all_goals first | ring1 | (field_simp; ring1) | (left; ring1) | (left; field_simp; ring1) | simp [hq]

/-- The block-weighted trace. -/
def tau (y3 y21 y111 : K) (x : Blk K) : K := y3 * x.1 + y21 * trace x.2.1 + y111 * x.2.2

/-- The explicit right-line projector of `σ₁`. -/
noncomputable def PR (q : K) : Blk K := (0, !![0, 0; -(q + q⁻¹)⁻¹, 1], 1)

theorem Pm_S1 (hq : q ≠ 0) (hq2 : q + q⁻¹ ≠ 0) : Pm q (S1 q) = PR q := by
  have h' : q ^ 2 + 1 ≠ 0 := by
    intro h; apply hq2
    rw [show q + q⁻¹ = q⁻¹ * (q ^ 2 + 1) by field_simp, h, mul_zero]
  unfold Pm S1 PR
  refine Prod.ext ?_ (Prod.ext ?_ ?_)
  · simp
  · ext i j
    fin_cases i <;> fin_cases j <;> simp
    all_goals field_simp
  · simp
    field_simp

/-- **Sufficiency.** With `y₂₁ = y₁₁₁ = 0`, every `x·P_R` has trace zero. -/
theorem trace_kills_right_of (y3 : K) (x : Blk K) :
    tau y3 0 0 (x * PR q) = 0 := by
  simp [tau, PR]

theorem tau_PR (y3 y21 y111 : K) : tau y3 y21 y111 (PR q) = y21 + y111 := by
  simp [tau, PR, trace_fin_two]

theorem tau_S2_PR (y3 y21 y111 : K) :
    tau y3 y21 y111 (S2 q * PR q) = y21 * (q - (q + q⁻¹)⁻¹) - y111 * q⁻¹ := by
  simp [tau, PR, S2, trace_fin_two]
  ring

/-- **Necessity.** Killing `P_R` and `σ₂·P_R` forces `y₂₁ = y₁₁₁ = 0`, when `[3]_q ≠ 0`. -/
theorem weights_zero_of_kills_right (hq : q ≠ 0) (hq2 : q + q⁻¹ ≠ 0)
    (h3 : q ^ 4 + q ^ 2 + 1 ≠ 0) {y3 y21 y111 : K}
    (h1 : tau y3 y21 y111 (PR q) = 0) (h2 : tau y3 y21 y111 (S2 q * PR q) = 0) :
    y21 = 0 ∧ y111 = 0 := by
  rw [tau_PR] at h1
  rw [tau_S2_PR] at h2
  have hy : y111 = -y21 := by linear_combination h1
  rw [hy] at h2
  have hq2' : q ^ 2 + 1 ≠ 0 := by
    intro h; apply hq2; field_simp; linear_combination h
  have key : y21 * (q ^ 4 + q ^ 2 + 1) = 0 := by
    field_simp at h2
    linear_combination h2
  have : y21 = 0 := by
    rcases mul_eq_zero.mp key with h | h
    · exact h
    · exact absurd h h3
  exact ⟨this, by rw [hy, this, neg_zero]⟩

/-- **The characterisation.** For any set of block elements containing the images of `1`
and `σ₂` (for instance the image of `H₃(q)`), the trace kills every `x·P_R` iff
`y₂₁ = y₁₁₁ = 0`. -/
theorem kills_right_iff (hq : q ≠ 0) (hq2 : q + q⁻¹ ≠ 0) (h3 : q ^ 4 + q ^ 2 + 1 ≠ 0)
    (S : Set (Blk K)) (h1S : (1 : Blk K) ∈ S) (h2S : S2 q ∈ S) (y3 y21 y111 : K) :
    (∀ x ∈ S, tau y3 y21 y111 (x * PR q) = 0) ↔ y21 = 0 ∧ y111 = 0 := by
  constructor
  · intro h
    have a := h 1 h1S
    rw [one_mul] at a
    exact weights_zero_of_kills_right hq hq2 h3 a (h _ h2S)
  · rintro ⟨rfl, rfl⟩ x _
    exact trace_kills_right_of y3 x

/-- With `τ(1) = 1`, a trace that kills the right line is the trivial character, i.e. the
augmentation `σᵢ ↦ q`. -/
theorem normalised_eq_augmentation {y3 : K} (hn : tau y3 0 0 (1 : Blk K) = 1) (x : Blk K) :
    tau y3 0 0 x = x.1 := by
  simp [tau] at hn ⊢
  rw [hn, one_mul]

/-- **Convention D does not kill the right line**: `y₂₁ = q²/(q²+1)² ≠ 0`. -/
theorem conventionD_not_kills_right (hq : q ≠ 0) (hq2' : q ^ 2 + 1 ≠ 0) :
    q ^ 2 / (q ^ 2 + 1) ^ 2 ≠ 0 :=
  div_ne_zero (pow_ne_zero 2 hq) (pow_ne_zero 2 hq2')

/-- Convention D, explicitly: `τ_D(P_R) = q²/(q²+1)²`. -/
theorem conventionD_tau_PR (y3 : K) :
    tau y3 (q ^ 2 / (q ^ 2 + 1) ^ 2) 0 (PR q) = q ^ 2 / (q ^ 2 + 1) ^ 2 := by
  rw [tau_PR, add_zero]

/-! ### The torus words `(σ₁σ₂)^N` at `n = 3` -/

/-- `σ₁σ₂` on the blocks. -/
theorem S1_mul_S2 (hq : q ≠ 0) :
    S1 q * S2 q = (q ^ 2, !![-1, q; -q⁻¹, 0], q⁻¹ ^ 2) := by
  unfold S1 S2
  refine Prod.ext ?_ (Prod.ext ?_ ?_)
  · simp; ring
  · ext i j
    fin_cases i <;> fin_cases j <;> simp
    all_goals first | ring1 | (field_simp; ring1) | field_simp
  · simp; ring

/-- **The full twist** `(σ₁σ₂)³` is `q⁶` on the trivial block, the identity on `(2,1)`,
and `q⁻⁶` on the sign block. -/
theorem twist (hq : q ≠ 0) :
    (S1 q * S2 q) ^ 3 = (q ^ 6, 1, q⁻¹ ^ 6) := by
  rw [S1_mul_S2 hq]
  refine Prod.ext ?_ (Prod.ext ?_ ?_)
  · simp; ring
  · ext i j
    fin_cases i <;> fin_cases j <;> simp [pow_succ]
    all_goals first | ring1 | (field_simp; ring1) | (left; ring1) | (field_simp; left; ring1) | field_simp
  · simp; ring

/-- **Periodicity.** Under any trace with `y₁₁₁ = 0` (convention D among them), the
right-line part of `(σ₁σ₂)^N` depends only on `N mod 3`. -/
theorem tau_torus_PR_periodic (hq : q ≠ 0) (y3 y21 : K) (m r : ℕ) :
    tau y3 y21 0 ((S1 q * S2 q) ^ (3 * m + r) * PR q) =
      tau y3 y21 0 ((S1 q * S2 q) ^ r * PR q) := by
  rw [pow_add, pow_mul, twist hq]
  simp [tau, PR]

end QOU.QuarkState.RightLineTraceObstruction
