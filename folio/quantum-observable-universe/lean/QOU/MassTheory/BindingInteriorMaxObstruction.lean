/-
# Binding ladder-miss interior-maximum obstruction (R11-b)

Formalizes the Farkas certificate of
`docs/audits/2026-07-18-r11b-interior-max-monotone-cone-certificate.md`
(bean `z2bn`, round-11): the `(kα)+X` binding ladder-miss has a strict *interior*
maximum at `k = 3`, and therefore cannot be written as a non-negative combination of
functions non-decreasing in `k`.  Consequently the missing binding channel is
necessarily **non-monotone** in `k` — a resonance.

This is the elementary order lemma named as the formalize-first target of the R11-b
audit.  It is scope-(b): a proved structural exclusion of the *whole* monotone additive
cone, via the invariant "monotone ⇒ evaluate-at-4 minus evaluate-at-3 is ≥ 0".

Every ingredient is generic (`OrderedAddCommMonoid` / `ℝ`); no `sorry`, no `axiom`.
-/
import Mathlib.Algebra.Order.BigOperators.Group.Finset
import Mathlib.Order.Monotone.Basic
import Mathlib.Data.Real.Basic

namespace QOU.Mass

open Finset

/-- **A non-negative combination of monotone functions is monotone.**
The additive cone generated by functions non-decreasing in `k` consists of
non-decreasing functions. -/
theorem monotone_nonneg_combo {ι : Type*} (s : Finset ι)
    (c : ι → ℝ) (f : ι → ℕ → ℝ)
    (hc : ∀ i ∈ s, 0 ≤ c i) (hf : ∀ i ∈ s, Monotone (f i)) :
    Monotone (fun k => ∑ i ∈ s, c i * f i k) := by
  intro a b hab
  refine Finset.sum_le_sum ?_
  intro i hi
  exact mul_le_mul_of_nonneg_left (hf i hi hab) (hc i hi)

/-- **The Farkas functional `φ = e₄ − e₃`.**  For a monotone `g`, `g 3 ≤ g 4`;
equivalently a strict decrease `g 4 < g 3` forces `g` to be non-monotone. -/
theorem strict_decrease_not_monotone (g : ℕ → ℝ) (h : g 4 < g 3) :
    ¬ Monotone g := by
  intro hg
  exact absurd (hg (by decide : (3 : ℕ) ≤ 4)) (not_le.mpr h)

/-- **Interior-maximum obstruction (the certificate).**
Any function `miss` with a strict decrease from `k=3` to `k=4` is **not** a
non-negative combination of functions non-decreasing in `k`: no such representation
exists.  This is the scope-(b) exclusion of the monotone additive cone. -/
theorem miss_not_in_monotone_cone {ι : Type*} (s : Finset ι)
    (c : ι → ℝ) (f : ι → ℕ → ℝ)
    (hc : ∀ i ∈ s, 0 ≤ c i) (hf : ∀ i ∈ s, Monotone (f i))
    (miss : ℕ → ℝ) (hmiss : miss 4 < miss 3)
    (hrepr : ∀ k, miss k = ∑ i ∈ s, c i * f i k) : False := by
  have hmono : Monotone miss := by
    have := monotone_nonneg_combo s c f hc hf
    intro a b hab
    simpa [hrepr] using this hab
  exact strict_decrease_not_monotone miss hmiss hmono

/-- **The interior maximum is genuine on the merged 3-ladder data.**
The neutron/deuteron/triton ladder misses each strictly exceed their `k=4` value at
`k=3` (the witnessed facts `miss 4 < miss 3`, MeV values in the R10 witness and the
R11-b audit), so each is non-monotone — a resonance. -/
theorem ladder_miss_interior_max_nonmonotone
    (missN missD missT : ℕ → ℝ)
    (hN : missN 4 < missN 3) (hD : missD 4 < missD 3) (hT : missT 4 < missT 3) :
    ¬ Monotone missN ∧ ¬ Monotone missD ∧ ¬ Monotone missT :=
  ⟨strict_decrease_not_monotone missN hN,
   strict_decrease_not_monotone missD hD,
   strict_decrease_not_monotone missT hT⟩

end QOU.Mass
