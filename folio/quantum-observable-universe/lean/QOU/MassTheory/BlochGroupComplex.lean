import QOU.MassTheory.ThreeSubstantiveMathlibFillers
import QOU.MassTheory.BlochWignerFiveTermInstance
import Mathlib.LinearAlgebra.Basis.VectorSpace
import Mathlib.NumberTheory.Padics.PadicVal.Basic

/-!
# The pre-Bloch group of `ℂ` and the Bloch–Wigner regulator

`QOU.Archimedean.SubstantiveFillers` declares the pre-Bloch group
`PreBlochGroup F` (the free abelian group on `F ∖ {0, 1}`) and two classes:

* `HasPentagonRelation F`, whose only field is an `AddSubgroup` of `PreBlochGroup F`;
* `HasBlochGroup F`, with a regulator `PreBlochGroup F ⧸ pentagon_subgroup →+ ℝ` and
  the claim `kernel_torsion` that every element of the regulator's kernel has finite
  order.

The appendix file `bloch-group-quotient-construction.lean` records that a genuine
instance "needs the pentagon-relation generating set and the Bloch–Wigner function
`D(z)`", and leaves it open (bean `qou-eao2`). This file supplies both and settles the
question.

## What is proved

1. `pentagonSubgroup`: the subgroup generated by Suslin's five-term relations
   `[x] − [y] + [y/x] − [(1 − x⁻¹)/(1 − y⁻¹)] + [(1 − x)/(1 − y)]`, `x, y ∉ {0, 1}`,
   `x ≠ y` (the orientation of `FiveTermProof.fiveSum`). The five arguments are
   never `0` or `1` under these hypotheses (`fiveArgs_admissible`), so no relation
   degenerates.
2. `blochWignerRegulator`: the Bloch–Wigner function `FiveTermProof.blochD` induces an
   additive map on `P(ℂ) := PreBlochGroup ℂ ⧸ pentagonSubgroup`, by the proved
   five-term relation `FiveTermProof.fiveSum_eq_zero`.
3. `blochWignerRegulator_ker_not_torsion`: **the kernel of that regulator is not
   torsion.** The class `[3]` has `D(3) = 0` (`D` vanishes on the real line) and
   infinite order in `P(ℂ)`.
4. `not_hasBlochGroup_blochWigner`: consequently no `HasBlochGroup ℂ` instance over
   the genuine five-term subgroup has the Bloch–Wigner regulator. The field
   `kernel_torsion` is false on the pre-Bloch group with this regulator.

## How `[3]` is shown to have infinite order

`D` cannot detect it, so a second five-term solution is used. For an additive map
`ℓ : ℝ →+ ℝ` put
`δℓ(z) = log‖z‖ · ℓ(log‖1 − z‖) − log‖1 − z‖ · ℓ(log‖z‖)`.
This is the composite of Suslin's map `[z] ↦ z ∧ (1 − z)` with the alternating
biadditive form `(a, b) ↦ log‖a‖ ℓ(log‖b‖) − log‖b‖ ℓ(log‖a‖)` on `ℂˣ`, so it kills the
five-term relations (`deltaL_fiveTerm`, a direct expansion). `log 2` and `log 3` are
linearly independent over `ℚ` (unique factorisation), so there is a `ℚ`-linear `ℓ` with
`ℓ(log 2) = 0`, `ℓ(log 3) = 1`, and then `δℓ(3) = −log 2 ≠ 0`. A torsion class would map
to `0` in the torsion-free group `ℝ`.

## Scope

The statement refuted here is the one the class makes: torsion kernel on the pre-Bloch
group `P(ℂ)`, with the Bloch–Wigner regulator. The witness `[3]` is not in the Bloch
group `B(ℂ) = ker(P(ℂ) → Λ²ℂˣ)`, because `3 ∧ (−2)` is not torsion. Whether the
regulator has torsion kernel on `B(ℂ)` is not decided in this file. The class also
admits other regulators; this file says nothing about them.

-- Ref: [suslin1991] Trudy Mat. Inst. Steklova 183
-- Ref: [zagier1986] DOI 10.1007/BFb0084581
-- Ref: [bloch2000] AMS CRM Monograph 11
-/

namespace QOU.Archimedean.BlochGroupComplex

open QOU.Archimedean.SubstantiveFillers QOU.Archimedean.FiveTermProof

noncomputable section

/-! ## Generators and the five-term subgroup -/

/-- The generator `[z]` of the pre-Bloch group, and `0` at the excluded points
`z = 0, 1`. -/
def gen (z : ℂ) : PreBlochGroup ℂ :=
  if h : z ≠ 0 ∧ z ≠ 1 then FreeAbelianGroup.of ⟨z, h.1, h.2⟩ else 0

/-- Suslin's five-term combination, in the orientation of `FiveTermProof.fiveSum`. -/
def fiveRel (x y : ℂ) : PreBlochGroup ℂ :=
  gen x - gen y + gen (y / x) - gen ((1 - x⁻¹) / (1 - y⁻¹)) + gen ((1 - x) / (1 - y))

/-- The admissible pairs `(x, y)`. -/
def Admissible (x y : ℂ) : Prop :=
  x ≠ 0 ∧ x ≠ 1 ∧ y ≠ 0 ∧ y ≠ 1 ∧ x ≠ y

/-- The five-term relations. -/
def fiveRelSet : Set (PreBlochGroup ℂ) :=
  {r | ∃ x y : ℂ, Admissible x y ∧ r = fiveRel x y}

/-- The subgroup generated by the five-term relations. -/
def pentagonSubgroup : AddSubgroup (PreBlochGroup ℂ) :=
  AddSubgroup.closure fiveRelSet

/-- `HasPentagonRelation ℂ` with the genuine five-term subgroup. A `def`, not an
`instance`, so that no `[HasPentagonRelation ℂ]` hypothesis resolves to it silently. -/
def pentagonRelationComplex : HasPentagonRelation ℂ := ⟨pentagonSubgroup⟩

/-- For admissible `(x, y)`, none of the five arguments is `0` or `1`. -/
theorem fiveArgs_admissible {x y : ℂ} (h : Admissible x y) :
    (y / x ≠ 0 ∧ y / x ≠ 1) ∧
      ((1 - x⁻¹) / (1 - y⁻¹) ≠ 0 ∧ (1 - x⁻¹) / (1 - y⁻¹) ≠ 1) ∧
      ((1 - x) / (1 - y) ≠ 0 ∧ (1 - x) / (1 - y) ≠ 1) := by
  obtain ⟨hx0, hx1, hy0, hy1, hxy⟩ := h
  have hx1' : 1 - x ≠ 0 := sub_ne_zero.2 (Ne.symm hx1)
  have hy1' : 1 - y ≠ 0 := sub_ne_zero.2 (Ne.symm hy1)
  have hxi : 1 - x⁻¹ ≠ 0 := sub_ne_zero.2 (fun h => hx1 (inv_eq_one.1 h.symm))
  have hyi : 1 - y⁻¹ ≠ 0 := sub_ne_zero.2 (fun h => hy1 (inv_eq_one.1 h.symm))
  refine ⟨⟨div_ne_zero hy0 hx0, fun h => hxy ?_⟩, ⟨div_ne_zero hxi hyi, fun h => hxy ?_⟩,
    ⟨div_ne_zero hx1' hy1', fun h => hxy ?_⟩⟩
  · exact ((div_eq_one_iff_eq hx0).1 h).symm
  · have := (div_eq_one_iff_eq hyi).1 h
    exact inv_injective (by linear_combination -this)
  · have := (div_eq_one_iff_eq hy1').1 h
    linear_combination -this

/-! ## Five-term solutions induce maps on `P(ℂ)` -/

/-- The additive map `PreBlochGroup ℂ →+ ℝ` with `[z] ↦ f z`. -/
def liftFun (f : ℂ → ℝ) : PreBlochGroup ℂ →+ ℝ :=
  FreeAbelianGroup.lift (fun e => f e.val)

theorem liftFun_gen (f : ℂ → ℝ) {z : ℂ} (h0 : z ≠ 0) (h1 : z ≠ 1) :
    liftFun f (gen z) = f z := by
  simp [liftFun, gen, h0, h1, FreeAbelianGroup.lift_apply_of]

/-- A function satisfying Suslin's five-term relation on admissible pairs. -/
def FiveTermSolution (f : ℂ → ℝ) : Prop :=
  ∀ x y : ℂ, Admissible x y →
    f x - f y + f (y / x) - f ((1 - x⁻¹) / (1 - y⁻¹)) + f ((1 - x) / (1 - y)) = 0

/-- A five-term solution kills the five-term subgroup. -/
theorem pentagonSubgroup_le_ker {f : ℂ → ℝ} (hf : FiveTermSolution f) :
    pentagonSubgroup ≤ (liftFun f).ker := by
  refine (AddSubgroup.closure_le _).2 ?_
  rintro r ⟨x, y, h, rfl⟩
  obtain ⟨⟨a0, a1⟩, ⟨b0, b1⟩, ⟨c0, c1⟩⟩ := fiveArgs_admissible h
  obtain ⟨hx0, hx1, hy0, hy1, -⟩ := id h
  simp only [SetLike.mem_coe, AddMonoidHom.mem_ker, fiveRel, map_add, map_sub,
    liftFun_gen f hx0 hx1, liftFun_gen f hy0 hy1, liftFun_gen f a0 a1,
    liftFun_gen f b0 b1, liftFun_gen f c0 c1]
  exact hf x y h

/-- The map `P(ℂ) →+ ℝ` induced by a five-term solution. -/
def descend {f : ℂ → ℝ} (hf : FiveTermSolution f) :
    PreBlochGroup ℂ ⧸ pentagonSubgroup →+ ℝ :=
  QuotientAddGroup.lift pentagonSubgroup (liftFun f) (pentagonSubgroup_le_ker hf)

theorem descend_mk_gen {f : ℂ → ℝ} (hf : FiveTermSolution f) {z : ℂ} (h0 : z ≠ 0)
    (h1 : z ≠ 1) : descend hf (QuotientAddGroup.mk (gen z)) = f z := by
  simp [descend, liftFun_gen f h0 h1]

/-! ## The Bloch–Wigner regulator -/

theorem blochD_fiveTermSolution : FiveTermSolution blochD := by
  rintro x y ⟨hx0, hx1, hy0, hy1, hxy⟩
  exact fiveSum_eq_zero hx0 hx1 hy0 hy1 hxy

/-- **The Bloch–Wigner regulator** on `P(ℂ)`, induced by `FiveTermProof.blochD`. -/
def blochWignerRegulator : PreBlochGroup ℂ ⧸ pentagonSubgroup →+ ℝ :=
  descend blochD_fiveTermSolution

theorem blochWignerRegulator_mk_gen {z : ℂ} (h0 : z ≠ 0) (h1 : z ≠ 1) :
    blochWignerRegulator (QuotientAddGroup.mk (gen z)) = blochD z :=
  descend_mk_gen _ h0 h1

/-! ## A second five-term solution: Suslin's `δ` paired with `log‖·‖` -/

/-- `δℓ(z) = log‖z‖ · ℓ(log‖1 − z‖) − log‖1 − z‖ · ℓ(log‖z‖)`. -/
def deltaL (ℓ : ℝ →+ ℝ) (z : ℂ) : ℝ :=
  Real.log ‖z‖ * ℓ (Real.log ‖1 - z‖) - Real.log ‖1 - z‖ * ℓ (Real.log ‖z‖)

private theorem log_norm_div {a b : ℂ} (ha : a ≠ 0) (hb : b ≠ 0) :
    Real.log ‖a / b‖ = Real.log ‖a‖ - Real.log ‖b‖ := by
  rw [norm_div, Real.log_div (norm_ne_zero_iff.2 ha) (norm_ne_zero_iff.2 hb)]

/-- `δℓ` satisfies the five-term relation, for every additive `ℓ`. -/
theorem deltaL_fiveTerm (ℓ : ℝ →+ ℝ) : FiveTermSolution (deltaL ℓ) := by
  rintro x y ⟨hx0, hx1, hy0, hy1, hxy⟩
  have hu : 1 - x ≠ 0 := sub_ne_zero.2 (Ne.symm hx1)
  have hv : 1 - y ≠ 0 := sub_ne_zero.2 (Ne.symm hy1)
  have hw : x - y ≠ 0 := sub_ne_zero.2 hxy
  have hyi : 1 - y⁻¹ ≠ 0 := sub_ne_zero.2 (fun h => hy1 (inv_eq_one.1 h.symm))
  have hvx : (1 - y) * x ≠ 0 := mul_ne_zero hv hx0
  -- the ten arguments, as quotients of `x, y, 1 - x, 1 - y, x - y`
  have e3 : 1 - y / x = (x - y) / x := by field_simp
  have e4 : (1 - x⁻¹) / (1 - y⁻¹) = ((1 - x) * y) / ((1 - y) * x) := by
    rw [div_eq_div_iff hyi hvx]; field_simp; ring
  have e4' : 1 - ((1 - x) * y) / ((1 - y) * x) = (x - y) / ((1 - y) * x) := by
    field_simp; ring
  have e5' : 1 - (1 - x) / (1 - y) = (x - y) / (1 - y) := by field_simp; ring
  have l2 : Real.log ‖y / x‖ = Real.log ‖y‖ - Real.log ‖x‖ := log_norm_div hy0 hx0
  have l3 : Real.log ‖(x - y) / x‖ = Real.log ‖x - y‖ - Real.log ‖x‖ := log_norm_div hw hx0
  have l4 : Real.log ‖((1 - x) * y) / ((1 - y) * x)‖ =
      (Real.log ‖1 - x‖ + Real.log ‖y‖) - (Real.log ‖1 - y‖ + Real.log ‖x‖) := by
    rw [log_norm_div (mul_ne_zero hu hy0) hvx, log_norm_mul hu hy0, log_norm_mul hv hx0]
  have l4' : Real.log ‖(x - y) / ((1 - y) * x)‖ =
      Real.log ‖x - y‖ - (Real.log ‖1 - y‖ + Real.log ‖x‖) := by
    rw [log_norm_div hw hvx, log_norm_mul hv hx0]
  have l5 : Real.log ‖(1 - x) / (1 - y)‖ = Real.log ‖1 - x‖ - Real.log ‖1 - y‖ :=
    log_norm_div hu hv
  have l5' : Real.log ‖(x - y) / (1 - y)‖ = Real.log ‖x - y‖ - Real.log ‖1 - y‖ :=
    log_norm_div hw hv
  simp only [deltaL]
  rw [e3, e4, e4', e5', l2, l3, l4, l4', l5, l5']
  simp only [map_add, map_sub]
  ring

/-! ## `log 2` and `log 3` are linearly independent over `ℚ` -/

/-- `2^a 3^b = 2^c 3^d` in `ℕ` forces `a = c` and `b = d`. -/
private theorem two_three_pow_inj {a b c d : ℕ} (h : 2 ^ a * 3 ^ b = 2 ^ c * 3 ^ d) :
    a = c ∧ b = d := by
  have h2 : ∀ m n : ℕ, padicValNat 2 (2 ^ m * 3 ^ n) = m := by
    intro m n
    have : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    rw [padicValNat.mul (by positivity) (by positivity), padicValNat.prime_pow,
      padicValNat.eq_zero_of_not_dvd, add_zero]
    intro hd
    exact absurd ((Nat.Prime.dvd_of_dvd_pow Nat.prime_two hd)) (by norm_num)
  have h3 : ∀ m n : ℕ, padicValNat 3 (2 ^ m * 3 ^ n) = n := by
    intro m n
    have : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
    rw [padicValNat.mul (by positivity) (by positivity), padicValNat.prime_pow,
      padicValNat.eq_zero_of_not_dvd, zero_add]
    intro hd
    exact absurd ((Nat.Prime.dvd_of_dvd_pow Nat.prime_three hd)) (by norm_num)
  exact ⟨by rw [← h2 a b, h, h2], by rw [← h3 a b, h, h3]⟩

/-- An integer relation `m log 2 + n log 3 = 0` is trivial. -/
private theorem int_rel_log_two_three {m n : ℤ}
    (h : (m : ℝ) * Real.log 2 + n * Real.log 3 = 0) : m = 0 ∧ n = 0 := by
  -- move negative coefficients across and exponentiate
  have key : ((2 : ℝ) ^ m.toNat * 3 ^ n.toNat) = 2 ^ (-m).toNat * 3 ^ (-n).toNat := by
    have hlog : Real.log ((2 : ℝ) ^ m.toNat * 3 ^ n.toNat) =
        Real.log ((2 : ℝ) ^ (-m).toNat * 3 ^ (-n).toNat) := by
      rw [Real.log_mul (by positivity) (by positivity),
        Real.log_mul (by positivity) (by positivity),
        Real.log_pow, Real.log_pow, Real.log_pow, Real.log_pow]
      have hm : ((m.toNat : ℤ) : ℝ) - (((-m).toNat : ℤ) : ℝ) = m := by
        rw [← Int.cast_sub, Int.toNat_sub_toNat_neg]
      have hn : ((n.toNat : ℤ) : ℝ) - (((-n).toNat : ℤ) : ℝ) = n := by
        rw [← Int.cast_sub, Int.toNat_sub_toNat_neg]
      push_cast at hm hn
      linear_combination h + Real.log 2 * hm + Real.log 3 * hn
    exact Real.log_injOn_pos (Set.mem_Ioi.2 (by positivity)) (Set.mem_Ioi.2 (by positivity)) hlog
  have keyN : 2 ^ m.toNat * 3 ^ n.toNat = 2 ^ (-m).toNat * 3 ^ (-n).toNat := by
    exact_mod_cast key
  obtain ⟨ha, hb⟩ := two_three_pow_inj keyN
  constructor <;> omega

/-- `log 2` and `log 3` are linearly independent over `ℚ`. -/
theorem linearIndependent_log_two_three :
    LinearIndependent ℚ ![Real.log 2, Real.log 3] := by
  rw [LinearIndependent.pair_iff]
  intro s t hst
  have hst' : ((s.num * t.den : ℤ) : ℝ) * Real.log 2 + ((t.num * s.den : ℤ) : ℝ) * Real.log 3
      = 0 := by
    have hs : (s : ℝ) = s.num / s.den := by exact_mod_cast (Rat.num_div_den s).symm
    have ht : (t : ℝ) = t.num / t.den := by exact_mod_cast (Rat.num_div_den t).symm
    have hsd : (s.den : ℝ) ≠ 0 := by exact_mod_cast s.den_nz
    have htd : (t.den : ℝ) ≠ 0 := by exact_mod_cast t.den_nz
    rw [Rat.smul_def, Rat.smul_def] at hst
    rw [hs, ht] at hst
    push_cast
    field_simp at hst
    linear_combination hst
  obtain ⟨h1, h2⟩ := int_rel_log_two_three hst'
  have hs : s.num = 0 := by
    rcases mul_eq_zero.1 h1 with h | h
    · exact h
    · exact absurd h (by exact_mod_cast t.den_nz)
  have ht : t.num = 0 := by
    rcases mul_eq_zero.1 h2 with h | h
    · exact h
    · exact absurd h (by exact_mod_cast s.den_nz)
  exact ⟨Rat.num_eq_zero.1 hs, Rat.num_eq_zero.1 ht⟩

/-- An additive `ℓ : ℝ →+ ℝ` with `ℓ(log 2) = 0` and `ℓ(log 3) = 1`. -/
theorem exists_separating_additive :
    ∃ ℓ : ℝ →+ ℝ, ℓ (Real.log 2) = 0 ∧ ℓ (Real.log 3) = 1 := by
  set hli := linearIndependent_log_two_three
  set b := Module.Basis.span hli
  obtain ⟨g, hg⟩ := LinearMap.exists_extend (b.constr ℚ (![0, 1] : Fin 2 → ℝ))
  have hgb : ∀ i, g (![Real.log 2, Real.log 3] i) = (![0, 1] : Fin 2 → ℝ) i := by
    intro i
    have := congrArg (fun φ => φ (b i)) hg
    simp only [LinearMap.coe_comp, Function.comp_apply, Submodule.coe_subtype,
      Module.Basis.constr_basis] at this
    rwa [Module.Basis.span_apply] at this
  exact ⟨g.toAddMonoidHom, by simpa using hgb 0, by simpa using hgb 1⟩

/-! ## The kernel of the Bloch–Wigner regulator is not torsion -/

/-- `[3]` lies in the kernel of the Bloch–Wigner regulator and has infinite order in
`P(ℂ)`. -/
theorem blochWignerRegulator_ker_not_torsion :
    ∃ v ∈ blochWignerRegulator.ker, ∀ k : ℕ, 0 < k → k • v ≠ 0 := by
  have h30 : (3 : ℂ) ≠ 0 := by norm_num
  have h31 : (3 : ℂ) ≠ 1 := by norm_num
  refine ⟨QuotientAddGroup.mk (gen 3), ?_, ?_⟩
  · rw [AddMonoidHom.mem_ker, blochWignerRegulator_mk_gen h30 h31,
      show (3 : ℂ) = ((3 : ℝ) : ℂ) by norm_num, blochD_ofReal]
  · intro k hk hv
    obtain ⟨ℓ, h2, h3⟩ := exists_separating_additive
    have hval : descend (deltaL_fiveTerm ℓ) (QuotientAddGroup.mk (gen 3)) = -Real.log 2 := by
      rw [descend_mk_gen _ h30 h31, deltaL]
      have n3 : ‖(3 : ℂ)‖ = 3 := by simp
      have n2 : ‖(1 : ℂ) - 3‖ = 2 := by norm_num
      rw [n3, n2, h2, h3]; ring
    have := congrArg (descend (deltaL_fiveTerm ℓ)) hv
    rw [map_nsmul, hval, map_zero, nsmul_eq_mul] at this
    have hl : Real.log 2 ≠ 0 := by positivity
    have hk' : (k : ℝ) ≠ 0 := by exact_mod_cast hk.ne'
    exact hl (by simpa [hk'] using this)

/-- **No `HasBlochGroup ℂ` over the genuine five-term subgroup has the Bloch–Wigner
regulator**: its `kernel_torsion` field fails at `[3]`. -/
theorem not_hasBlochGroup_blochWigner
    (inst : @HasBlochGroup ℂ _ _ _ pentagonRelationComplex) :
    inst.regulator ≠ blochWignerRegulator := by
  intro heq
  obtain ⟨v, hv, hnt⟩ := blochWignerRegulator_ker_not_torsion
  obtain ⟨k, hk, hkv⟩ := inst.kernel_torsion v (by rw [heq]; exact hv)
  exact hnt k hk hkv

end

end QOU.Archimedean.BlochGroupComplex
