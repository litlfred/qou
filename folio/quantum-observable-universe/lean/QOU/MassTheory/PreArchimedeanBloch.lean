import QOU.MassTheory.ThreeSubstantiveMathlibFillers
import Mathlib.LinearAlgebra.ExteriorAlgebra.Basic
import Mathlib.NumberTheory.Padics.PadicVal.Basic
import Mathlib.RingTheory.RootsOfUnity.PrimitiveRoots

/-!
# The pre-Archimedean Bloch group: Suslin's map `[z] ↦ z ∧ (1 − z)` over any field

`QOU.Archimedean.BlochGroupComplex` builds the pre-Bloch group `P(ℂ)` (the free
abelian group on `ℂ ∖ {0, 1}` modulo Suslin's five-term relations) and the
Bloch–Wigner regulator on it. It does not build the **Bloch group**
`B(F) = ker (δ : P(F) → Λ²F^×)`, and it works only over `ℂ`. This file supplies
both, over an arbitrary field, with no analysis:

1. `fiveRel`, `pentagonSubgroup`, `PreBloch F`: Suslin's five-term relation
   `[x] − [y] + [y/x] − [(1 − x⁻¹)/(1 − y⁻¹)] + [(1 − x)/(1 − y)]` over any field
   (the orientation of `BlochGroupComplex.fiveRel`, which is its `F = ℂ` case).
2. `delta β`: Suslin's symbol `[z] ↦ β(z, 1 − z)` for any **antisymmetric**
   biadditive pairing `β` on `F^×` (`β a b = − β b a`). `delta_fiveRel`: it kills
   every five-term relation. Antisymmetry suffices, not only alternation: the
   diagonal terms `β(a, a)` cancel exactly in the expansion. So the theorem covers
   both conventions in the literature, the exterior square `Λ²_ℤ F^×` (alternating)
   and Suslin's quotient of `F^× ⊗ F^×` by `x ⊗ y + y ⊗ x` (antisymmetric).
3. `BlochGroup F`: the kernel of the induced map `P(F) → ExteriorAlgebra ℤ (F^×)`,
   `[z] ↦ ι z · ι (1 − z)`. The exterior algebra over `ℤ` contains `Λ²_ℤ F^×`, so
   this is `ker (P(F) → Λ²_ℤ F^×)`.
4. **Figure-eight class.** If `ζ² − ζ + 1 = 0` then `1 − ζ = ζ⁻¹`, so
   `δ[ζ] = ζ ∧ ζ⁻¹ = −(ζ ∧ ζ) = 0` **exactly** in `Λ²`: `gen_mem_blochGroup_of_phi6`.
   In Suslin's antisymmetric convention `δ[ζ] = −β(ζ, ζ)` is only 2-torsion, and
   `2[ζ]` is killed: `delta_two_gen_of_phi6`. `fig8Class := 2 • [ζ]` lies in `B(F)`
   in both conventions. For `F = ℚ(ζ₆)` this is `fig8Class_cyclotomic`.
5. **Nahm equation of the Habiro sum.** The summand of the figure-eight cyclotomic
   expansion `T_m(q) = ∏_{j=1}^m (1 − q^j)(1 − q^{−j})` has shift ratio
   `T_{m+1}/T_m = (1 − q·X)(1 − q⁻¹·X⁻¹)` at `X = q^m` (`habiro41_succ`). At `q = 1`
   the ratio is `(1 − X)(1 − X⁻¹)`, and `(1 − X)(1 − X⁻¹) = 1 ↔ X² − X + 1 = 0`
   (`nahm41_iff_phi6`). Every solution is therefore a class in `B(F)`
   (`nahm41_mem_blochGroup`).
6. **A wrong orientation elsewhere in the corpus.** The appendix block
   `bloch-group-quotient-construction.lean` generates its "pentagon subgroup" by
   `[x] − [y] + [y/x] − [(1 − y⁻¹)/(1 − x⁻¹)] + [(1 − y)/(1 − x)]`: the last two
   arguments are the **inverses** of Suslin's. That combination is not a relation of
   `P(F)`: over `ℚ` at `(x, y) = (2, 3)` the pairing `v₂ ∧ v₃` of the 2- and 3-adic
   valuations sends it to `4 ≠ 0` (`appendixRel_two_three`), while it kills every
   Suslin relation. Hence `appendixRel_not_mem_pentagonSubgroup`.

## Scope

Everything here is pre-Archimedean: no `ℝ`, no `ℂ`, no limit. The Archimedean step
(regulator `D`, `Vol(4₁) = 2 D(e^{iπ/3})`) is not in this file and is not assumed.
That `2[ζ₆]` is the class of the geometric ideal triangulation of `S³ ∖ 4₁` (two
regular ideal tetrahedra of shape `e^{iπ/3}`) is Thurston's computation, cited and
not formalised here. That the Nahm solution of the Habiro sum and the Ptolemy class
agree for knots other than `4₁` is open (see
`docs/audits/2026-11-27-dilog-bloch-pre-archimedean.md`).

-- Ref: [suslin1991] Suslin, K_3 of a field, and the Bloch group, Trudy Mat. Inst. Steklova 183 (1991) 217-239.
-- Ref: [zagier2007] Zagier, The dilogarithm function, in Frontiers in Number Theory, Physics and Geometry II (2007), §II.
-- Ref: [habiro2002] Habiro, On the colored Jones polynomials of some simple links, RIMS Kokyuroku 1172 (2000).
-- Ref: [thurston1978] Thurston, The Geometry and Topology of Three-Manifolds, ch. 4.
-/

namespace QOU.Archimedean.PreArchimedeanBloch

open QOU.Archimedean.SubstantiveFillers

set_option linter.unusedSectionVars false

noncomputable section

variable {F : Type*} [Field F] [DecidableEq F]

/-! ## Generators and the five-term subgroup over any field -/

/-- The generator `[z]` of the pre-Bloch group, and `0` at the excluded points. -/
def gen (z : F) : PreBlochGroup F :=
  if h : z ≠ 0 ∧ z ≠ 1 then FreeAbelianGroup.of ⟨z, h.1, h.2⟩ else 0

/-- Suslin's five-term combination. -/
def fiveRel (x y : F) : PreBlochGroup F :=
  gen x - gen y + gen (y / x) - gen ((1 - x⁻¹) / (1 - y⁻¹)) + gen ((1 - x) / (1 - y))

/-- The admissible pairs `(x, y)`. -/
def Admissible (x y : F) : Prop :=
  x ≠ 0 ∧ x ≠ 1 ∧ y ≠ 0 ∧ y ≠ 1 ∧ x ≠ y

/-- The subgroup generated by Suslin's five-term relations. -/
def pentagonSubgroup (F : Type*) [Field F] [DecidableEq F] : AddSubgroup (PreBlochGroup F) :=
  AddSubgroup.closure {r | ∃ x y : F, Admissible x y ∧ r = fiveRel x y}

/-- **The pre-Bloch group** `P(F)`. -/
abbrev PreBloch (F : Type*) [Field F] [DecidableEq F] :=
  PreBlochGroup F ⧸ pentagonSubgroup F

/-! ## Units as an additive group -/

/-- `z ↦ z ∈ (F^×, ·)` written additively, and `0` at `z = 0`. -/
def u (z : F) : Additive Fˣ :=
  if h : z ≠ 0 then Additive.ofMul (Units.mk0 z h) else 0

theorem u_mul {a b : F} (ha : a ≠ 0) (hb : b ≠ 0) : u (a * b) = u a + u b := by
  have hab : a * b ≠ 0 := mul_ne_zero ha hb
  simp only [u, ha, hb, hab, ne_eq, not_false_eq_true, dite_true]
  rw [← ofMul_mul]
  congr 1
  ext
  simp

theorem u_div {a b : F} (ha : a ≠ 0) (hb : b ≠ 0) : u (a / b) = u a - u b := by
  have hab : a / b ≠ 0 := div_ne_zero ha hb
  simp only [u, ha, hb, hab, ne_eq, not_false_eq_true, dite_true]
  rw [← ofMul_div]
  congr 1
  ext
  simp

theorem u_inv {a : F} (ha : a ≠ 0) : u a⁻¹ = - u a := by
  have := u_div (one_ne_zero) ha
  rw [one_div] at this
  rw [this]
  simp [u]

/-! ## Suslin's symbol for an antisymmetric pairing -/

variable {G : Type*} [AddCommGroup G]

/-- Suslin's symbol `[z] ↦ β(z, 1 − z)` on the free group. -/
def delta (β : Additive Fˣ →+ Additive Fˣ →+ G) : PreBlochGroup F →+ G :=
  FreeAbelianGroup.lift (fun e => β (u e.val) (u (1 - e.val)))

theorem delta_gen (β : Additive Fˣ →+ Additive Fˣ →+ G) {z : F} (h0 : z ≠ 0) (h1 : z ≠ 1) :
    delta β (gen z) = β (u z) (u (1 - z)) := by
  simp [delta, gen, h0, h1, FreeAbelianGroup.lift_apply_of]

/-- For admissible `(x, y)`, none of the five arguments is `0` or `1`. -/
theorem fiveArgs_admissible {x y : F} (h : Admissible x y) :
    (y / x ≠ 0 ∧ y / x ≠ 1) ∧
      ((1 - x⁻¹) / (1 - y⁻¹) ≠ 0 ∧ (1 - x⁻¹) / (1 - y⁻¹) ≠ 1) ∧
      ((1 - x) / (1 - y) ≠ 0 ∧ (1 - x) / (1 - y) ≠ 1) := by
  obtain ⟨hx0, hx1, hy0, hy1, hxy⟩ := h
  have hx1' : 1 - x ≠ 0 := sub_ne_zero.2 (Ne.symm hx1)
  have hy1' : 1 - y ≠ 0 := sub_ne_zero.2 (Ne.symm hy1)
  have hxi : 1 - x⁻¹ ≠ 0 := sub_ne_zero.2 (fun h => hx1 (inv_eq_one.1 h.symm))
  have hyi : 1 - y⁻¹ ≠ 0 := sub_ne_zero.2 (fun h => hy1 (inv_eq_one.1 h.symm))
  refine ⟨⟨div_ne_zero hy0 hx0, fun h => hxy ?_⟩, ⟨div_ne_zero hxi hyi, fun h => hxy ?_⟩,
    ⟨div_ne_zero hx1' hy1', fun h => hxy ?_⟩⟩
  · exact ((div_eq_one_iff_eq hx0).1 h).symm
  · have := (div_eq_one_iff_eq hyi).1 h
    exact inv_injective (by linear_combination -this)
  · have := (div_eq_one_iff_eq hy1').1 h
    linear_combination -this

/-- **Suslin's symbol kills the five-term relation**, for every antisymmetric
biadditive pairing. -/
theorem delta_fiveRel (β : Additive Fˣ →+ Additive Fˣ →+ G)
    (hβ : ∀ a b, β b a = - β a b) {x y : F} (h : Admissible x y) :
    delta β (fiveRel x y) = 0 := by
  obtain ⟨⟨a0, a1⟩, ⟨b0, b1⟩, ⟨c0, c1⟩⟩ := fiveArgs_admissible h
  obtain ⟨hx0, hx1, hy0, hy1, hxy⟩ := h
  have hx1' : 1 - x ≠ 0 := sub_ne_zero.2 (Ne.symm hx1)
  have hy1' : 1 - y ≠ 0 := sub_ne_zero.2 (Ne.symm hy1)
  have he : x - y ≠ 0 := sub_ne_zero.2 hxy
  -- The ten arguments, factored through `x, y, 1 − x, 1 − y, x − y`.
  have e3 : u (y / x) = u y - u x := u_div hy0 hx0
  have e3' : u (1 - y / x) = u (x - y) - u x := by
    rw [show 1 - y / x = (x - y) / x by field_simp, u_div he hx0]
  have hyi : 1 - y⁻¹ ≠ 0 := sub_ne_zero.2 (fun h => hy1 (inv_eq_one.1 h.symm))
  have hxy' : x * (1 - y) ≠ 0 := mul_ne_zero hx0 hy1'
  have h4 : (1 - x⁻¹) / (1 - y⁻¹) = (y * (1 - x)) / (x * (1 - y)) := by
    rw [div_eq_div_iff hyi hxy']
    field_simp
    ring
  have h4' : 1 - (1 - x⁻¹) / (1 - y⁻¹) = (x - y) / (x * (1 - y)) := by
    rw [h4, eq_div_iff hxy', sub_mul, one_mul, div_mul_cancel₀ _ hxy']
    ring
  have e4 : u ((1 - x⁻¹) / (1 - y⁻¹)) = u y + u (1 - x) - u x - u (1 - y) := by
    rw [h4, u_div (mul_ne_zero hy0 hx1') hxy', u_mul hy0 hx1', u_mul hx0 hy1']
    abel
  have e4' : u (1 - (1 - x⁻¹) / (1 - y⁻¹)) = u (x - y) - u x - u (1 - y) := by
    rw [h4', u_div he hxy', u_mul hx0 hy1']
    abel
  have e5 : u ((1 - x) / (1 - y)) = u (1 - x) - u (1 - y) := u_div hx1' hy1'
  have e5' : u (1 - (1 - x) / (1 - y)) = u (x - y) - u (1 - y) := by
    rw [show 1 - (1 - x) / (1 - y) = (x - y) / (1 - y) by field_simp; ring,
      u_div he hy1']
  simp only [fiveRel, map_add, map_sub, delta_gen β hx0 hx1, delta_gen β hy0 hy1,
    delta_gen β a0 a1, delta_gen β b0 b1, delta_gen β c0 c1, e3, e3', e4, e4', e5, e5',
    AddMonoidHom.add_apply, AddMonoidHom.sub_apply]
  set A := u x
  set B := u y
  set C := u (1 - x)
  set D := u (1 - y)
  set E := u (x - y)
  simp only [hβ A B, hβ A C, hβ A D]
  abel

/-- Suslin's symbol vanishes on the five-term subgroup. -/
theorem pentagonSubgroup_le_ker (β : Additive Fˣ →+ Additive Fˣ →+ G)
    (hβ : ∀ a b, β b a = - β a b) :
    pentagonSubgroup F ≤ (delta β).ker := by
  refine (AddSubgroup.closure_le _).2 ?_
  rintro r ⟨x, y, h, rfl⟩
  exact delta_fiveRel β hβ h

/-- Suslin's symbol on the pre-Bloch group `P(F)`. -/
def deltaP (β : Additive Fˣ →+ Additive Fˣ →+ G) (hβ : ∀ a b, β b a = - β a b) :
    PreBloch F →+ G :=
  QuotientAddGroup.lift _ (delta β) (pentagonSubgroup_le_ker β hβ)

@[simp] theorem deltaP_mk (β : Additive Fˣ →+ Additive Fˣ →+ G)
    (hβ : ∀ a b, β b a = - β a b) (p : PreBlochGroup F) :
    deltaP β hβ (QuotientAddGroup.mk p) = delta β p := rfl

/-! ## The universal alternating pairing and the Bloch group -/

/-- `(a, b) ↦ ι a · ι b` in the exterior algebra of `F^×` over `ℤ`; its image is
`Λ²_ℤ F^×`. -/
def wedge (F : Type*) [Field F] :
    Additive Fˣ →+ Additive Fˣ →+ ExteriorAlgebra ℤ (Additive Fˣ) :=
  AddMonoidHom.mk'
    (fun a => AddMonoidHom.mk'
      (fun b => ExteriorAlgebra.ι ℤ a * ExteriorAlgebra.ι ℤ b)
      (fun b c => by simp [mul_add]))
    (fun a b => by ext c; simp [add_mul])

@[simp] theorem wedge_apply (a b : Additive Fˣ) :
    wedge F a b = ExteriorAlgebra.ι ℤ a * ExteriorAlgebra.ι ℤ b := rfl

theorem wedge_self (a : Additive Fˣ) : wedge F a a = 0 := by
  simp

theorem wedge_antisymm (a b : Additive Fˣ) : wedge F b a = - wedge F a b := by
  simp only [wedge_apply]
  exact eq_neg_of_add_eq_zero_left (ExteriorAlgebra.ι_add_mul_swap b a)

/-- **The Bloch group** `B(F) = ker (P(F) → Λ²_ℤ F^×)`. -/
def BlochGroup (F : Type*) [Field F] [DecidableEq F] : AddSubgroup (PreBloch F) :=
  (deltaP (wedge F) (wedge_antisymm (F := F))).ker

/-! ## The figure-eight class -/

/-- If `ζ² − ζ + 1 = 0` then `ζ ∉ {0, 1}` and `1 − ζ = ζ⁻¹`. -/
theorem phi6_facts {ζ : F} (h : ζ ^ 2 - ζ + 1 = 0) :
    ζ ≠ 0 ∧ ζ ≠ 1 ∧ 1 - ζ = ζ⁻¹ := by
  have h0 : ζ ≠ 0 := by
    rintro rfl
    norm_num at h
  have h1 : ζ ≠ 1 := by
    rintro rfl
    norm_num at h
  refine ⟨h0, h1, ?_⟩
  field_simp
  linear_combination -h

/-- `δ[ζ] = −β(ζ, ζ)` when `ζ² − ζ + 1 = 0`. -/
theorem delta_gen_of_phi6 (β : Additive Fˣ →+ Additive Fˣ →+ G) {ζ : F}
    (h : ζ ^ 2 - ζ + 1 = 0) : delta β (gen ζ) = - β (u ζ) (u ζ) := by
  obtain ⟨h0, h1, h2⟩ := phi6_facts h
  rw [delta_gen β h0 h1, h2, u_inv h0, map_neg]

/-- Under an antisymmetric pairing, `δ(2[ζ]) = 0` (Suslin's convention). -/
theorem delta_two_gen_of_phi6 (β : Additive Fˣ →+ Additive Fˣ →+ G)
    (hβ : ∀ a b, β b a = - β a b) {ζ : F} (h : ζ ^ 2 - ζ + 1 = 0) :
    delta β (2 • gen ζ) = 0 := by
  rw [map_nsmul, delta_gen_of_phi6 β h]
  have hd : β (u ζ) (u ζ) = - β (u ζ) (u ζ) := hβ _ _
  rw [two_nsmul]
  have : (2 : ℤ) • β (u ζ) (u ζ) = 0 := by
    rw [two_zsmul]
    nth_rewrite 2 [hd]
    abel
  rw [two_zsmul] at this
  rw [← neg_add, this, neg_zero]

/-- **`[ζ] ∈ B(F)` exactly** (no 2-torsion caveat in `Λ²`) when `ζ² − ζ + 1 = 0`. -/
theorem gen_mem_blochGroup_of_phi6 {ζ : F} (h : ζ ^ 2 - ζ + 1 = 0) :
    (QuotientAddGroup.mk (gen ζ) : PreBloch F) ∈ BlochGroup F := by
  simp only [BlochGroup, AddMonoidHom.mem_ker, deltaP_mk]
  rw [delta_gen_of_phi6 _ h, wedge_self, neg_zero]

/-- **The pre-Archimedean figure-eight class** `2[ζ]`. -/
def fig8Class (ζ : F) : PreBloch F := 2 • (QuotientAddGroup.mk (gen ζ) : PreBloch F)

theorem fig8Class_mem_blochGroup {ζ : F} (h : ζ ^ 2 - ζ + 1 = 0) :
    fig8Class ζ ∈ BlochGroup F :=
  AddSubgroup.nsmul_mem _ (gen_mem_blochGroup_of_phi6 h) 2

/-- A primitive sixth root of unity satisfies `ζ² − ζ + 1 = 0`. -/
theorem phi6_of_isPrimitiveRoot {ζ : F} (hζ : IsPrimitiveRoot ζ 6) : ζ ^ 2 - ζ + 1 = 0 := by
  have h6 : ζ ^ 6 = 1 := hζ.pow_eq_one
  have h3 : ζ ^ 3 ≠ 1 := hζ.pow_ne_one_of_pos_of_lt (by norm_num) (by norm_num)
  have h2 : ζ ^ 2 ≠ 1 := hζ.pow_ne_one_of_pos_of_lt (by norm_num) (by norm_num)
  have hm : ζ + 1 ≠ 0 := by
    intro hz
    apply h2
    have : ζ = -1 := by linear_combination hz
    rw [this]; norm_num
  have h3' : ζ ^ 3 - 1 ≠ 0 := sub_ne_zero.2 h3
  have key : (ζ ^ 3 - 1) * ((ζ + 1) * (ζ ^ 2 - ζ + 1)) = 0 := by
    linear_combination h6
  rcases mul_eq_zero.1 key with h | h
  · exact absurd h h3'
  · rcases mul_eq_zero.1 h with h | h
    · exact absurd h hm
    · exact h

/-- **`2[ζ₆] ∈ B(ℚ(ζ₆))`**, sorry-free, for the distinguished primitive sixth root in
`CyclotomicField 6 ℚ = ℚ(√−3)`. -/
theorem fig8Class_cyclotomic [DecidableEq (CyclotomicField 6 ℚ)] :
    fig8Class (IsCyclotomicExtension.zeta 6 ℚ (CyclotomicField 6 ℚ))
      ∈ BlochGroup (CyclotomicField 6 ℚ) :=
  fig8Class_mem_blochGroup
    (phi6_of_isPrimitiveRoot (IsCyclotomicExtension.zeta_spec 6 ℚ (CyclotomicField 6 ℚ)))

/-! ## The Nahm equation of the figure-eight Habiro sum -/

/-- The summand `T_m(q) = ∏_{j=1}^m (1 − q^j)(1 − q^{−j})` of Habiro's cyclotomic
expansion of the coloured Jones polynomial of `4₁`. -/
def habiro41 (q : F) (m : ℕ) : F :=
  ∏ j ∈ Finset.range m, (1 - q ^ (j + 1)) * (1 - (q ^ (j + 1))⁻¹)

/-- The `q`-difference recursion: `T_{m+1} = T_m · (1 − q·X)(1 − q⁻¹X⁻¹)` at
`X = q^m`. -/
theorem habiro41_succ (q : F) (m : ℕ) :
    habiro41 q (m + 1) = habiro41 q m * ((1 - q * q ^ m) * (1 - q⁻¹ * (q ^ m)⁻¹)) := by
  rw [habiro41, Finset.prod_range_succ, ← habiro41]
  congr 1
  rw [pow_succ, mul_comm (q ^ m) q, mul_inv]

/-- **Nahm equation.** The shift ratio at `q = 1`, `(1 − X)(1 − X⁻¹)`, equals `1`
exactly when `X² − X + 1 = 0`. -/
theorem nahm41_iff_phi6 {X : F} (hX : X ≠ 0) :
    (1 - X) * (1 - X⁻¹) = 1 ↔ X ^ 2 - X + 1 = 0 := by
  constructor
  · intro h
    have : X * ((1 - X) * (1 - X⁻¹)) = X * 1 := by rw [h]
    field_simp at this
    linear_combination -this
  · intro h
    field_simp
    linear_combination -h

/-- Every nonzero solution of the Nahm equation of the `4₁` Habiro sum is a
class in `B(F)`. -/
theorem nahm41_mem_blochGroup {X : F} (hX : X ≠ 0) (h : (1 - X) * (1 - X⁻¹) = 1) :
    (QuotientAddGroup.mk (gen X) : PreBloch F) ∈ BlochGroup F :=
  gen_mem_blochGroup_of_phi6 ((nahm41_iff_phi6 hX).1 h)

/-! ## The appendix orientation is not a relation of `P(F)` -/

/-- The combination the appendix block `bloch-group-quotient-construction.lean`
(`QOU.Archimedean.BlochQuotient.rogersGenerator`) quotients by: Suslin's last two
arguments inverted. -/
def appendixRel (x y : F) : PreBlochGroup F :=
  gen x - gen y + gen (y / x) - gen ((1 - y⁻¹) / (1 - x⁻¹)) + gen ((1 - y) / (1 - x))

/-- The `p`-adic valuation `ℚ^× → ℤ`, additively. -/
def vp (p : ℕ) [Fact p.Prime] : Additive ℚˣ →+ ℤ where
  toFun a := padicValRat p ((Additive.toMul a : ℚˣ) : ℚ)
  map_zero' := by simp
  map_add' a b := by
    simp only [toMul_add, Units.val_mul]
    exact padicValRat.mul (Units.ne_zero _) (Units.ne_zero _)

instance fact_prime_two : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
instance fact_prime_three : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩

/-- The pairing `v₂ ∧ v₃ : (a, b) ↦ v₂(a) v₃(b) − v₃(a) v₂(b)`; antisymmetric. -/
def v23 : Additive ℚˣ →+ Additive ℚˣ →+ ℤ :=
  AddMonoidHom.mk'
    (fun a => AddMonoidHom.mk' (fun b => vp 2 a * vp 3 b - vp 3 a * vp 2 b)
      (fun b c => by simp only [map_add]; ring))
    (fun a b => AddMonoidHom.ext fun c => by
      simp only [map_add, AddMonoidHom.mk'_apply, AddMonoidHom.add_apply]; ring)

theorem v23_antisymm (a b : Additive ℚˣ) : v23 b a = - v23 a b := by
  simp only [v23, AddMonoidHom.mk'_apply]
  ring

private theorem v23_u (a b : ℚ) (ha : a ≠ 0) (hb : b ≠ 0) :
    v23 (u a) (u b) =
      padicValRat 2 a * padicValRat 3 b - padicValRat 3 a * padicValRat 2 b := by
  simp [v23, vp, u, ha, hb]

private theorem pvn (p n : ℕ) [Fact p.Prime] (k : ℤ) (h : (padicValNat p n : ℤ) = k) :
    padicValRat p ((n : ℕ) : ℚ) = k := by rw [padicValRat.of_nat, h]

private theorem v2_2 : padicValRat 2 (2 : ℚ) = 1 := by
  have := pvn 2 2 1 (by simp); exact_mod_cast this
private theorem v3_2 : padicValRat 3 (2 : ℚ) = 0 := by
  have := pvn 3 2 0 (by simp [padicValNat.eq_zero_of_not_dvd]); exact_mod_cast this
private theorem v2_3 : padicValRat 2 (3 : ℚ) = 0 := by
  have := pvn 2 3 0 (by simp [padicValNat.eq_zero_of_not_dvd]); exact_mod_cast this
private theorem v3_3 : padicValRat 3 (3 : ℚ) = 1 := by
  have := pvn 3 3 1 (by simp); exact_mod_cast this
private theorem v2_4 : padicValRat 2 (4 : ℚ) = 2 := by
  have := pvn 2 4 2 (by rw [show (4 : ℕ) = 2 ^ 2 by norm_num, padicValNat.prime_pow]; rfl)
  exact_mod_cast this
private theorem v3_4 : padicValRat 3 (4 : ℚ) = 0 := by
  have := pvn 3 4 0 (by simp [padicValNat.eq_zero_of_not_dvd]); exact_mod_cast this

/-- **The appendix relation at `(2, 3)` has `v₂ ∧ v₃`-symbol `4`.** -/
theorem appendixRel_two_three : delta v23 (appendixRel (2 : ℚ) 3) = 4 := by
  have e1 : ((1 : ℚ) - 3⁻¹) / (1 - 2⁻¹) = 4 / 3 := by norm_num
  have e2 : ((1 : ℚ) - 3) / (1 - 2) = 2 := by norm_num
  simp only [appendixRel, e1, e2, map_add, map_sub]
  rw [delta_gen v23 (z := (2 : ℚ)) (by norm_num) (by norm_num),
    delta_gen v23 (z := (3 : ℚ)) (by norm_num) (by norm_num),
    delta_gen v23 (z := (3 / 2 : ℚ)) (by norm_num) (by norm_num),
    delta_gen v23 (z := (4 / 3 : ℚ)) (by norm_num) (by norm_num),
    show (1 : ℚ) - 2 = -1 by norm_num, show (1 : ℚ) - 3 = -2 by norm_num,
    show (1 : ℚ) - 3 / 2 = -(1 / 2) by norm_num, show (1 : ℚ) - 4 / 3 = -(1 / 3) by norm_num,
    v23_u _ _ (by norm_num) (by norm_num), v23_u _ _ (by norm_num) (by norm_num),
    v23_u _ _ (by norm_num) (by norm_num), v23_u _ _ (by norm_num) (by norm_num)]
  simp only [padicValRat.neg, one_div, padicValRat.inv, padicValRat.one,
    padicValRat.div (show (3 : ℚ) ≠ 0 by norm_num) (show (2 : ℚ) ≠ 0 by norm_num),
    padicValRat.div (show (4 : ℚ) ≠ 0 by norm_num) (show (3 : ℚ) ≠ 0 by norm_num),
    v2_2, v3_2, v2_3, v3_3, v2_4, v3_4]
  norm_num

/-- **The appendix relation is not a consequence of Suslin's five-term relations.** -/
theorem appendixRel_not_mem_pentagonSubgroup :
    appendixRel (2 : ℚ) 3 ∉ pentagonSubgroup ℚ := by
  intro hmem
  have := pentagonSubgroup_le_ker v23 v23_antisymm hmem
  rw [AddMonoidHom.mem_ker, appendixRel_two_three] at this
  norm_num at this

end

end QOU.Archimedean.PreArchimedeanBloch
