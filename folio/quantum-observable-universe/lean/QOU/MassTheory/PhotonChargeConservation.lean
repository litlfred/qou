/-
  Photons conserve charge; H₃(q) itself carries no charge grading
  (audit 2026-11-21-proton-q3-kl-coordinate, Round 10).

  Photon (owner ruling 2026-11-20): `γ = 1 + φ₀σ₀ + φ₁σ₁ + φ₀₁·σ₀σ₁⁻¹`.

  §1 (Schur–Weyl, charge conservation). On `(R²)^{⊗3}`, basis `e_i e_j e_k` with `0 = u`,
  `1 = d`, the Jimbo check-R matrix acts on two adjacent strands by
  `ee ↦ q·ee` (equal letters), `ud ↦ du`, `du ↦ ud + h·du`, `h = q - q⁻¹`, which is the
  braiding of `NucleonWeightSpaceTraces` restricted to the `(2,1)` and `(1,2)` weight spaces.
  Every entry of `σ₁`, `σ₂` joins two basis vectors with the same number of `u` letters
  (`sig1_support`, `sig2_support`). Hence `σ₁`, `σ₂` commute with every diagonal operator
  `D_f = diag(f(#u))` (`commute_sig1`, `commute_sig2`), so the whole subalgebra they generate
  does too (`adjoin_commute`). Photons with `σ₁⁻¹` written as `σ₂ - h` (the Hecke relation,
  `hecke_sig2`) lie in that subalgebra, and so do all finite products of photons
  (`photon_prod_commute`). Taking `f` the electric charge `#u·(2/3) - #d·(1/3)`, or the
  indicator of one weight space, this is charge conservation: photon products preserve the
  proton `(2,1)` and neutron `(1,2)` weight spaces (`photon_prod_preserves`).

  §2 (no grading inside the algebra). If `σ² = hσ + 1`, `h ≠ 0`, `{1, σ}` is linearly
  independent and an algebra map scales `σ` by `t`, then `t = 1` (`no_scaling_of_hecke`).
  So no U(1) acts on `H₃(q)` by rescaling the generators: the charge lives on the module.

  §3 (block norm of a word). On a braid word the trivial character is `q^writhe`
  (`trivWord_eq`); if `q` is not a root of unity it equals `1` iff the writhe is `0`
  (`trivWord_eq_one_iff`).

  -- Ref: [kassel1995] (Jimbo R-matrix, Schur–Weyl); [leitner2026] def:photon
-/
import Mathlib.Data.Matrix.Mul
import Mathlib.LinearAlgebra.Matrix.Notation
import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.LinearCombination
import Mathlib.Tactic.Ring
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.Module

namespace QOU.MassTheory.PhotonChargeConservation

open Matrix

variable {R : Type*} [Field R]

/-! ## §1 Charge conservation on `(R²)^{⊗3}` -/

/-- Basis index of `(R²)^{⊗3}`: letter `0 = u`, `1 = d`. -/
abbrev Idx := Fin 2 × Fin 2 × Fin 2

/-- Number of `u` letters. -/
def nu (x : Idx) : ℕ :=
  (if x.1 = 0 then 1 else 0) + (if x.2.1 = 0 then 1 else 0) + (if x.2.2 = 0 then 1 else 0)

/-- Jimbo check-R on two strands: entry (row `(i,j)`, column `(k,l)`). -/
def rc (q : R) (i j k l : Fin 2) : R :=
  if i = k ∧ j = l ∧ k = l then q
  else if k = 0 ∧ l = 1 ∧ i = 1 ∧ j = 0 then 1
  else if k = 1 ∧ l = 0 ∧ i = 0 ∧ j = 1 then 1
  else if k = 1 ∧ l = 0 ∧ i = 1 ∧ j = 0 then q - q⁻¹
  else 0

/-- `σ₁` on strands 1, 2. -/
def sig1 (q : R) : Matrix Idx Idx R :=
  fun x y => rc q x.1 x.2.1 y.1 y.2.1 * (if x.2.2 = y.2.2 then 1 else 0)

/-- `σ₂` on strands 2, 3. -/
def sig2 (q : R) : Matrix Idx Idx R :=
  fun x y => (if x.1 = y.1 then 1 else 0) * rc q x.2.1 x.2.2 y.2.1 y.2.2

theorem sig1_support (q : R) (x y : Idx) (h : nu x ≠ nu y) : sig1 q x y = 0 := by
  obtain ⟨a, b, c⟩ := x; obtain ⟨d, e, f⟩ := y
  fin_cases a <;> fin_cases b <;> fin_cases c <;> fin_cases d <;> fin_cases e <;>
    fin_cases f <;> simp_all [sig1, rc, nu]

theorem sig2_support (q : R) (x y : Idx) (h : nu x ≠ nu y) : sig2 q x y = 0 := by
  obtain ⟨a, b, c⟩ := x; obtain ⟨d, e, f⟩ := y
  fin_cases a <;> fin_cases b <;> fin_cases c <;> fin_cases d <;> fin_cases e <;>
    fin_cases f <;> simp_all [sig2, rc, nu]

/-- The diagonal operator `diag(f(#u))`. -/
def chargeOp (f : ℕ → R) : Matrix Idx Idx R := Matrix.diagonal (fun x => f (nu x))

theorem commute_of_support (f : ℕ → R) (X : Matrix Idx Idx R)
    (hX : ∀ x y, nu x ≠ nu y → X x y = 0) : X * chargeOp f = chargeOp f * X := by
  ext x y
  simp only [chargeOp, Matrix.mul_diagonal, Matrix.diagonal_mul]
  by_cases hxy : nu x = nu y
  · rw [hxy, mul_comm]
  · rw [hX x y hxy]; ring

theorem commute_sig1 (q : R) (f : ℕ → R) : sig1 q * chargeOp f = chargeOp f * sig1 q :=
  commute_of_support f _ (sig1_support q)

theorem commute_sig2 (q : R) (f : ℕ → R) : sig2 q * chargeOp f = chargeOp f * sig2 q :=
  commute_of_support f _ (sig2_support q)

/-- Everything in the algebra generated by `σ₁, σ₂` commutes with every charge operator. -/
theorem adjoin_commute (q : R) (f : ℕ → R) {X : Matrix Idx Idx R}
    (hX : X ∈ Algebra.adjoin R ({sig1 q, sig2 q} : Set (Matrix Idx Idx R))) :
    X * chargeOp f = chargeOp f * X := by
  have hle : Algebra.adjoin R ({sig1 q, sig2 q} : Set (Matrix Idx Idx R)) ≤
      Subalgebra.centralizer R {chargeOp f} := by
    rw [Algebra.adjoin_le_iff]
    rintro Y (rfl | rfl) <;> intro Z hZ <;> rw [Set.mem_singleton_iff] at hZ <;> subst hZ
    · exact (commute_sig1 q f).symm
    · exact (commute_sig2 q f).symm
  exact (hle hX (chargeOp f) (Set.mem_singleton _)).symm

set_option maxHeartbeats 4000000 in
/-- The Hecke relation for `σ₂`; so `σ₂⁻¹ = σ₂ - h`. -/
theorem hecke_sig2 (q : R) (hq : q ≠ 0) :
    sig2 q * (sig2 q - (q - q⁻¹) • (1 : Matrix Idx Idx R)) = 1 := by
  ext ⟨a, b, c⟩ ⟨d, e, f⟩
  fin_cases a <;> fin_cases b <;> fin_cases c <;> fin_cases d <;> fin_cases e <;>
    fin_cases f <;>
    simp [sig2, rc, Matrix.mul_apply, Fintype.sum_prod_type, Fin.sum_univ_two,
      Matrix.one_apply, Matrix.sub_apply] <;> field_simp <;> ring

/-- The photon `1 + a·σ₁ + b·σ₂ + c·σ₁σ₂⁻¹` on `(R²)^{⊗3}`, with `σ₂⁻¹ = σ₂ - h`. -/
def photon (q a b c : R) : Matrix Idx Idx R :=
  1 + a • sig1 q + b • sig2 q + c • (sig1 q * (sig2 q - (q - q⁻¹) • 1))

theorem photon_mem (q a b c : R) :
    photon q a b c ∈ Algebra.adjoin R ({sig1 q, sig2 q} : Set (Matrix Idx Idx R)) := by
  have h1 : sig1 q ∈ Algebra.adjoin R ({sig1 q, sig2 q} : Set (Matrix Idx Idx R)) :=
    Algebra.subset_adjoin (Set.mem_insert _ _)
  have h2 : sig2 q ∈ Algebra.adjoin R ({sig1 q, sig2 q} : Set (Matrix Idx Idx R)) :=
    Algebra.subset_adjoin (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  unfold photon
  refine Subalgebra.add_mem _ (Subalgebra.add_mem _ (Subalgebra.add_mem _
    (Subalgebra.one_mem _) (Subalgebra.smul_mem _ h1 _)) (Subalgebra.smul_mem _ h2 _))
    (Subalgebra.smul_mem _ (Subalgebra.mul_mem _ h1 (Subalgebra.sub_mem _ h2
      (Subalgebra.smul_mem _ (Subalgebra.one_mem _) _))) _)

/-- **Charge conservation.** Every finite product of photons commutes with every charge
operator `diag(f(#u))`. -/
theorem photon_prod_commute (q : R) (f : ℕ → R) (L : List (R × R × R)) :
    (L.map fun φ => photon q φ.1 φ.2.1 φ.2.2).prod * chargeOp f =
      chargeOp f * (L.map fun φ => photon q φ.1 φ.2.1 φ.2.2).prod := by
  apply adjoin_commute q f
  apply Subalgebra.list_prod_mem
  intro X hX
  obtain ⟨φ, -, rfl⟩ := List.mem_map.mp hX
  exact photon_mem q _ _ _

/-- A photon product maps a vector supported on `#u = n` to a vector supported on `#u = n`:
the proton (`n = 2`) and neutron (`n = 1`) weight spaces are preserved. -/
theorem photon_prod_preserves (q : R) (n : ℕ) (L : List (R × R × R)) (v : Idx → R)
    (hv : ∀ x, nu x ≠ n → v x = 0) :
    ∀ x, nu x ≠ n → ((L.map fun φ => photon q φ.1 φ.2.1 φ.2.2).prod *ᵥ v) x = 0 := by
  set X := (L.map fun φ => photon q φ.1 φ.2.1 φ.2.2).prod
  let f : ℕ → R := fun m => if m = n then 1 else 0
  have hDv : chargeOp f *ᵥ v = v := by
    funext x
    simp only [chargeOp, Matrix.mulVec_diagonal, f]
    by_cases h : nu x = n <;> simp [h, hv x]
  have hc := photon_prod_commute q f L
  intro x hx
  have : (chargeOp f *ᵥ (X *ᵥ v)) x = (X *ᵥ v) x := by
    rw [Matrix.mulVec_mulVec, ← hc, ← Matrix.mulVec_mulVec, hDv]
  simp only [chargeOp, Matrix.mulVec_diagonal, f, if_neg hx, zero_mul] at this
  exact this.symm

/-! ## §2 No charge grading inside the algebra -/

/-- If `σ² = hσ + 1` with `h ≠ 0` and `{1, σ}` independent, an algebra map that scales `σ`
by `t` has `t = 1`. -/
theorem no_scaling_of_hecke {A : Type*} [Ring A] [Algebra R A] (σ : A) (h t : R)
    (hh : h ≠ 0) (hrel : σ * σ = h • σ + 1)
    (hind : ∀ a b : R, a • (1 : A) + b • σ = 0 → a = 0 ∧ b = 0)
    (φ : A →ₐ[R] A) (hφ : φ σ = t • σ) : t = 1 := by
  have e1 : φ (σ * σ) = (t * t) • (h • σ + 1) := by
    rw [map_mul, hφ, smul_mul_smul_comm, hrel]
  have e2 : φ (σ * σ) = (h * t) • σ + 1 := by
    rw [hrel, map_add, map_smul, hφ, map_one, smul_smul]
  have key : (t * t - 1) • (1 : A) + (h * (t * t - t)) • σ = 0 := by
    have hh' := e1.symm.trans e2
    rw [show (t * t - 1) • (1 : A) + (h * (t * t - t)) • σ =
        (t * t) • (h • σ + 1) - ((h * t) • σ + 1) by module, hh', sub_self]
  obtain ⟨k1, k2⟩ := hind _ _ key
  have k2' : t * t - t = 0 := (mul_eq_zero.mp k2).resolve_left hh
  linear_combination k1 - k2'

/-! ## §3 Trivial character of a braid word -/

/-- A letter: generator index and sign (`true` = positive crossing). -/
abbrev Letter := Fin 2 × Bool

/-- Writhe: number of positive minus negative crossings. -/
def writhe : List Letter → ℤ
  | [] => 0
  | (_, s) :: w => (if s then 1 else -1) + writhe w

/-- The trivial character `σᵢ^{±1} ↦ q^{±1}` on a word. -/
def trivWord (q : R) : List Letter → R
  | [] => 1
  | (_, s) :: w => (if s then q else q⁻¹) * trivWord q w

theorem trivWord_eq (q : R) (hq : q ≠ 0) (w : List Letter) : trivWord q w = q ^ writhe w := by
  induction w with
  | nil => simp [trivWord, writhe]
  | cons l w ih =>
    obtain ⟨i, s⟩ := l
    cases s <;> simp [trivWord, writhe, ih, zpow_add₀ hq, zpow_neg]

theorem trivWord_eq_one_iff (q : R) (hq : q ≠ 0) (hroot : ∀ n : ℤ, q ^ n = 1 → n = 0)
    (w : List Letter) : trivWord q w = 1 ↔ writhe w = 0 := by
  rw [trivWord_eq q hq]
  exact ⟨hroot _, fun h => by rw [h, zpow_zero]⟩

end QOU.MassTheory.PhotonChargeConservation
