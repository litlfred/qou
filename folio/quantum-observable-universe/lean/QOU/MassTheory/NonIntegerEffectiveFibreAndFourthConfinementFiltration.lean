/-!
# Non-Integer Effective Fibre Dimension and Fourth Confinement-Level Filtration

Formalizes two linked structural diagnostics in the binding fibre and filtration hierarchy:

1. **Convention-C Effective Fibre Dimension $N_{\text{eff}} = 2.5995$ is Not an Integer (`qou-rm47`)**:
   - In units of $10^{-4}$, the Convention-C effective fibre dimension
     $\text{nEffBindingScaled10000} = 25995$ lies strictly between the integer fibre
     dimensions $N = 2$ ($20000$, distance $5995$) and $N = 3$ ($30000$, distance $4005$).
   - For every integer $N \in \mathbb{Z}$, $10000 N \ne 25995$, proving that the
     Convention-C value $2.5995$ cannot be the trace of a representation of any
     integer fibre dimension $N$.

2. **Fourth Confinement-Level Reading of $J^\bullet(q)$ Evades Both Exclusion Routes (`qou-sw8n`)**:
   - The filtration $J^\ell(q)$ generated by block idempotents with energy $E(\lambda, q) \le E_\ell(q)$
     is generated at intermediate levels by a proper subset of block idempotents
     ($\text{activeBlocks} < \text{totalBlocks}$), so its idempotent sum differs strictly
     from the full algebra unit $1 = \sum_{\text{all }\lambda} e_\lambda$. Thus the full
     unit is absent from degree $0$ and Route A (`unit_in_degree_zero_forces_constant_grading`)
     does not apply.
   - At generic $q$ where all $p(n)$ block energies are distinct, the number of energy
     strata $p(n) \in \{2, 3, 5, 7, 11, 15\}$ strictly exceeds the `gbDepth` strata
     count $\{1, 1, 2, 2, 3, 3\}$ at every $n \in \{2, 3, 4, 5, 6, 7\}$, requiring
     exact energy ties at $q_0$ for the two filtrations to coincide.
-/

namespace QOU.MassTheory.NonIntegerEffectiveFibreAndFourthConfinementFiltration

/-- Convention-C effective fibre dimension $N_{\text{eff}} = 2.5995$ scaled by $10^4$. -/
def nEffBindingScaled10000 : Int :=
  25995

/-- Integer fibre dimension $N$ scaled by $10^4$: $10000 N$. -/
def integerFibreDimScaled10000 (N : Int) : Int :=
  10000 * N

/-- Absolute distance $|10000 N - 25995|$ in units of $10^{-4}$. -/
def distanceToIntegerFibreScaled10000 (N : Int) : Int :=
  if integerFibreDimScaled10000 N ≤ nEffBindingScaled10000 then
    nEffBindingScaled10000 - integerFibreDimScaled10000 N
  else
    integerFibreDimScaled10000 N - nEffBindingScaled10000

/-- Number of central block idempotents absent from a subalgebra level. -/
def subalgebraIdempotentDeficitFromUnit (totalBlocks activeBlocks : Int) : Int :=
  totalBlocks - activeBlocks

/-- Partition count $p(n)$ for $n \in \{2, 3, 4, 5, 6, 7\}$. -/
def partitionCountAtN (n : Int) : Int :=
  if n == 2 then 2
  else if n == 3 then 3
  else if n == 4 then 5
  else if n == 5 then 7
  else if n == 6 then 11
  else if n == 7 then 15
  else 0

/-- `gbDepth` stratum count $n - m_n + 1$ for $n \in \{2, 3, 4, 5, 6, 7\}$. -/
def gbDepthStrataAtN (n : Int) : Int :=
  if n == 2 then 1
  else if n == 3 then 1
  else if n == 4 then 2
  else if n == 5 then 2
  else if n == 6 then 3
  else if n == 7 then 3
  else 0

/-- Effective fibre dimension $2.5995$ is strictly between $N=2$ and $N=3$ and equals
    no integer $N \in \mathbb{Z}$ (`qou-rm47`). -/
theorem nEffBinding_strictly_between_two_and_three_and_not_integer (N : Int) :
    integerFibreDimScaled10000 2 < nEffBindingScaled10000 ∧
      nEffBindingScaled10000 < integerFibreDimScaled10000 3 ∧
      distanceToIntegerFibreScaled10000 2 = 5995 ∧
      distanceToIntegerFibreScaled10000 3 = 4005 ∧
      integerFibreDimScaled10000 N ≠ nEffBindingScaled10000 := by
  dsimp [integerFibreDimScaled10000, nEffBindingScaled10000,
    distanceToIntegerFibreScaled10000]
  have hne : 10000 * N ≠ 25995 := by omega
  refine ⟨by decide, by decide, rfl, rfl, hne⟩

/-- A filtration level generated by a proper subset of central block idempotents
    (`activeBlocks < totalBlocks`) has strictly positive idempotent deficit from the
    full unit $1 = \sum_{\text{all }\lambda} e_\lambda$, evading the unit-in-degree-zero
    exclusion route (`qou-sw8n`). -/
theorem proper_block_subalgebra_evades_unit_in_degree_zero
    (totalBlocks activeBlocks : Int) (hProper : activeBlocks < totalBlocks) :
    0 < subalgebraIdempotentDeficitFromUnit totalBlocks activeBlocks ∧
      activeBlocks ≠ totalBlocks := by
  dsimp [subalgebraIdempotentDeficitFromUnit]
  have hpos : 0 < totalBlocks - activeBlocks := by omega
  have hne : activeBlocks ≠ totalBlocks := by omega
  exact ⟨hpos, hne⟩

/-- At every $n \in \{2, 3, 4, 5, 6, 7\}$, the generic distinct-energy stratum count
    $p(n)$ strictly exceeds the `gbDepth` stratum count (`qou-sw8n`). -/
theorem generic_block_energy_strata_exceed_gbDepth_strata_n2_to_n7 :
    gbDepthStrataAtN 2 < partitionCountAtN 2 ∧
      gbDepthStrataAtN 3 < partitionCountAtN 3 ∧
      gbDepthStrataAtN 4 < partitionCountAtN 4 ∧
      gbDepthStrataAtN 5 < partitionCountAtN 5 ∧
      gbDepthStrataAtN 6 < partitionCountAtN 6 ∧
      gbDepthStrataAtN 7 < partitionCountAtN 7 ∧
      partitionCountAtN 7 - gbDepthStrataAtN 7 = 12 := by
  dsimp [gbDepthStrataAtN, partitionCountAtN]
  refine ⟨by decide, by decide, by decide, by decide, by decide, by decide, rfl⟩

end QOU.MassTheory.NonIntegerEffectiveFibreAndFourthConfinementFiltration
