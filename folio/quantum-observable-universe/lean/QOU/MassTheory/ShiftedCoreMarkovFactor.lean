# A shifted three-strand core enters the lower level as its Markov trace

Bean `qou-cds1`, route C step 2 (PRs #9556, #9578). On six strands the γγ survivors
`V₀³·V_j³` project to `H₃` as `tr_M(V³)·V₀³`. This file proves the mechanism from the two
Ocneanu (Markov) properties of the conditional expectations, for **every** element of the
shifted copy, not only `V³`.

## Setting

`A` is an `R`-algebra (think `H₆(q)`), `A₁ ⊆ A` a subalgebra (think `H₅(q)`), `B ⊆ A₁`
a subalgebra (think `H₃(q)`, strands 0–2). The shifted copy of `H₃` is generated by
`s₁ ∈ A₁` and `s₂ ∈ A` (think `σ₃`, `σ₄`). The hypotheses are:

* the Hecke relation `s₁² = h·s₁ + 1`;
* `E₂ : A → A` is the Ocneanu expectation onto `A₁`: `E₂ a = a` on `A₁`,
  `E₂ (a·s₂·b) = z·(a·b)` for `a b ∈ A₁`;
* `E₁ : A → A` is the Ocneanu expectation onto `B` along `s₁`: `E₁ b = b` on `B`,
  `E₁ (a·s₁·b) = z·(a·b)` for `a b ∈ B`.

These are the defining properties of the Markov-trace conditional expectations
(Jones, Ocneanu); they are hypotheses here, not proved for a concrete `H₆(q)`.

## Result

For every `b ∈ B` and every combination `y` of the six Hecke words in `s₁, s₂`,

    E₁ (E₂ (b · y)) = trH3 y · b,

where `trH3` is the Markov trace of `H₃` with parameter `z`:
`1 ↦ 1`, `s₁, s₂ ↦ z`, `s₁s₂, s₂s₁ ↦ z²`, `s₁s₂s₁ ↦ h·z² + z`.
No numerical value of `q` or `z` enters.
-/
import Mathlib.Algebra.Algebra.Subalgebra.Basic
import Mathlib.Algebra.BigOperators.Ring.Finset
import Mathlib.Algebra.Module.BigOperators
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.Ring

namespace QOU.MassTheory.ShiftedCoreMarkovFactor

variable {R A : Type*} [CommRing R] [Ring A] [Algebra R A]

/-- The six Hecke words `1, s₁, s₂, s₁s₂, s₂s₁, s₁s₂s₁` of the shifted copy of `H₃`. -/
def word (s₁ s₂ : A) : Fin 6 → A
  | 0 => 1
  | 1 => s₁
  | 2 => s₂
  | 3 => s₁ * s₂
  | 4 => s₂ * s₁
  | 5 => s₁ * s₂ * s₁

/-- The Markov trace of `H₃` on the word basis, with Markov parameter `z` and `h = q − q⁻¹`. -/
def trWord (h z : R) : Fin 6 → R
  | 0 => 1
  | 1 => z
  | 2 => z
  | 3 => z ^ 2
  | 4 => z ^ 2
  | 5 => h * z ^ 2 + z

/-- The element `∑ cᵢ · wordᵢ` of the shifted copy. -/
def elt (s₁ s₂ : A) (c : Fin 6 → R) : A := ∑ i, c i • word s₁ s₂ i

/-- Its Markov trace `∑ cᵢ · trWordᵢ`. -/
def trH3 (h z : R) (c : Fin 6 → R) : R := ∑ i, c i * trWord h z i

/-- **Per-word factorisation from the Ocneanu properties.** -/
theorem expect_mul_word_of_ocneanu
    (A₁ B : Subalgebra R A) (hBA : B ≤ A₁)
    (s₁ s₂ : A) (h z : R) (hs₁ : s₁ ∈ A₁)
    (hhecke : s₁ * s₁ = h • s₁ + 1)
    (E₁ E₂ : A →ₗ[R] A)
    (hE₂id : ∀ a ∈ A₁, E₂ a = a)
    (hE₂ : ∀ a ∈ A₁, ∀ c ∈ A₁, E₂ (a * s₂ * c) = z • (a * c))
    (hE₁id : ∀ b ∈ B, E₁ b = b)
    (hE₁ : ∀ a ∈ B, ∀ c ∈ B, E₁ (a * s₁ * c) = z • (a * c))
    (b : A) (hb : b ∈ B) (i : Fin 6) :
    E₁ (E₂ (b * word s₁ s₂ i)) = trWord h z i • b := by
  have hbA : b ∈ A₁ := hBA hb
  have h1 : (1 : A) ∈ B := B.one_mem
  have h1A : (1 : A) ∈ A₁ := A₁.one_mem
  have hbs : b * s₁ ∈ A₁ := A₁.mul_mem hbA hs₁
  -- `E₁ (b * s₁) = z • b`
  have e_bs : E₁ (b * s₁) = z • b := by
    have := hE₁ b hb 1 h1
    simpa using this
  -- `E₁ (s₁ * b) = z • b`
  have e_sb : E₁ (s₁ * b) = z • b := by
    have := hE₁ 1 h1 b hb
    simpa using this
  fin_cases i
  · -- 1
    simp only [word, trWord, mul_one, one_smul]
    rw [hE₂id b hbA, hE₁id b hb]
  · -- s₁
    simp only [word, trWord]
    rw [hE₂id _ hbs, e_bs]
  · -- s₂
    simp only [word, trWord]
    have := hE₂ b hbA 1 h1A
    simp only [mul_one] at this
    rw [this, map_smul, hE₁id b hb]
  · -- s₁ s₂
    simp only [word, trWord]
    have := hE₂ (b * s₁) hbs 1 h1A
    simp only [mul_one] at this
    rw [← mul_assoc, this, map_smul, e_bs, smul_smul, pow_two]
  · -- s₂ s₁
    simp only [word, trWord]
    have := hE₂ b hbA s₁ hs₁
    rw [← mul_assoc, this, map_smul, e_bs, smul_smul, pow_two]
  · -- s₁ s₂ s₁
    simp only [word, trWord]
    have := hE₂ (b * s₁) hbs s₁ hs₁
    rw [show b * (s₁ * s₂ * s₁) = b * s₁ * s₂ * s₁ by simp only [mul_assoc], this,
      map_smul, mul_assoc, hhecke, mul_add, mul_one, mul_smul_comm, map_add, map_smul,
      e_bs, hE₁id b hb, smul_add, smul_smul, smul_smul, add_smul]
    congr 1
    ring_nf

/-- **A shifted core enters the lower level as its Markov trace.** For every `b ∈ B` and
every element `y = ∑ cᵢ wordᵢ` of the shifted copy of `H₃`,
`E₁ (E₂ (b · y)) = trH3 y · b`. -/
theorem expect_mul_shifted_of_ocneanu
    (A₁ B : Subalgebra R A) (hBA : B ≤ A₁)
    (s₁ s₂ : A) (h z : R) (hs₁ : s₁ ∈ A₁)
    (hhecke : s₁ * s₁ = h • s₁ + 1)
    (E₁ E₂ : A →ₗ[R] A)
    (hE₂id : ∀ a ∈ A₁, E₂ a = a)
    (hE₂ : ∀ a ∈ A₁, ∀ c ∈ A₁, E₂ (a * s₂ * c) = z • (a * c))
    (hE₁id : ∀ b ∈ B, E₁ b = b)
    (hE₁ : ∀ a ∈ B, ∀ c ∈ B, E₁ (a * s₁ * c) = z • (a * c))
    (b : A) (hb : b ∈ B) (c : Fin 6 → R) :
    E₁ (E₂ (b * elt s₁ s₂ c)) = trH3 h z c • b := by
  simp only [elt, trH3, Finset.mul_sum, mul_smul_comm, map_sum, map_smul, Finset.sum_smul]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [expect_mul_word_of_ocneanu A₁ B hBA s₁ s₂ h z hs₁ hhecke E₁ E₂ hE₂id hE₂ hE₁id
    hE₁ b hb i, smul_smul]

/-- With `b = 1`: the shifted element itself projects to the scalar `trH3 y`. -/
theorem expect_shifted_of_ocneanu
    (A₁ B : Subalgebra R A) (hBA : B ≤ A₁)
    (s₁ s₂ : A) (h z : R) (hs₁ : s₁ ∈ A₁)
    (hhecke : s₁ * s₁ = h • s₁ + 1)
    (E₁ E₂ : A →ₗ[R] A)
    (hE₂id : ∀ a ∈ A₁, E₂ a = a)
    (hE₂ : ∀ a ∈ A₁, ∀ c ∈ A₁, E₂ (a * s₂ * c) = z • (a * c))
    (hE₁id : ∀ b ∈ B, E₁ b = b)
    (hE₁ : ∀ a ∈ B, ∀ c ∈ B, E₁ (a * s₁ * c) = z • (a * c))
    (c : Fin 6 → R) :
    E₁ (E₂ (elt s₁ s₂ c)) = trH3 h z c • (1 : A) := by
  simpa using expect_mul_shifted_of_ocneanu A₁ B hBA s₁ s₂ h z hs₁ hhecke E₁ E₂
    hE₂id hE₂ hE₁id hE₁ 1 B.one_mem c

end QOU.MassTheory.ShiftedCoreMarkovFactor
