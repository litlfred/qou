    (h1 : 96*a^5*b + 24*a^5*d + 120*a^4*b*c + 70*a^4*c*d + 140*a^3*b*c^2 + 150*a^3*c^2*d + 150*a^2*b*c^3 + 140*a^2*c^3*d + 70*a*b*c^4 + 120*a*c^4*d + 24*b*c^5 + 96*c^5*d = 24*k)
    (h2 : 240*a^4*b^2 + 120*a^4*b*d + 35*a^4*d^2 + 240*a^3*b^2*c + 280*a^3*b*c*d + 150*a^3*c*d^2 + 210*a^2*b^2*c^2 + 450*a^2*b*c^2*d + 210*a^2*c^2*d^2 + 150*a*b^2*c^3 + 280*a*b*c^3*d + 240*a*c^3*d^2 + 35*b^2*c^4 + 120*b*c^4*d + 240*c^4*d^2 = 35*k)
    (h3 : 320*a^3*b^3 + 240*a^3*b^2*d + 140*a^3*b*d^2 + 50*a^3*d^3 + 240*a^2*b^3*c + 420*a^2*b^2*c*d + 450*a^2*b*c*d^2 + 140*a^2*c*d^3 + 140*a*b^3*c^2 + 450*a*b^2*c^2*d + 420*a*b*c^2*d^2 + 240*a*c^2*d^3 + 50*b^3*c^3 + 140*b^2*c^3*d + 240*b*c^3*d^2 + 320*c^3*d^3 = 50*k)
    (h4 : 240*a^2*b^4 + 240*a^2*b^3*d + 210*a^2*b^2*d^2 + 150*a^2*b*d^3 + 35*a^2*d^4 + 120*a*b^4*c + 280*a*b^3*c*d + 450*a*b^2*c*d^2 + 280*a*b*c*d^3 + 120*a*c*d^4 + 35*b^4*c^2 + 150*b^3*c^2*d + 210*b^2*c^2*d^2 + 240*b*c^2*d^3 + 240*c^2*d^4 = 35*k)
    (h5 : 96*a*b^5 + 120*a*b^4*d + 140*a*b^3*d^2 + 150*a*b^2*d^3 + 70*a*b*d^4 + 24*a*d^5 + 24*b^5*c + 70*b^4*c*d + 150*b^3*c*d^2 + 140*b^2*c*d^3 + 120*b*c*d^4 + 96*c*d^5 = 24*k)
    (h6 : 16*b^6 + 24*b^5*d + 35*b^4*d^2 + 50*b^3*d^3 + 35*b^2*d^4 + 24*b*d^5 + 16*d^6 = 16*k)
    (hk : k = 0) :
    (a*d - b*c)^6 = 0 := by
  linear_combination (d^6/16)*h0 + (-c*d^5/16)*h1 + (c^2*d^4/16)*h2 + (-c^3*d^3/16)*h3 + (c^4*d^2/16)*h4 + (-c^5*d/16)*h5 + (c^6/16)*h6 + (c^6 - 3*c^5*d/2 + 35*c^4*d^2/16 - 25*c^3*d^3/8 + 35*c^2*d^4/16 - 3*c*d^5/2 + d^6)*hk

/-- **The stabiliser of the branch sextic is `{1, swap}`.** An invertible `2×2` matrix
that carries `D` to a scalar multiple of itself is a scalar matrix or a scalar times
the coordinate swap. -/
theorem sextic_stabiliser {a b c d k : K} (hdet : a*d - b*c ≠ 0)
    (h : ∀ z w : K, sextic (a*z + b*w) (c*z + d*w) = k * sextic z w) :
    (b = 0 ∧ c = 0 ∧ d = a) ∨ (a = 0 ∧ d = 0 ∧ c = b) := by
  obtain ⟨h0, h1, h2, h3, h4, h5, h6⟩ := coeff_eqs h
  have hk : k ≠ 0 := fun hk =>
    hdet (pow_eq_zero_iff (n := 6) (by norm_num) |>.mp
      (det_pow_six_of_k_zero h0 h1 h2 h3 h4 h5 h6 hk))
  have cancel : ∀ {x : K}, k * x = 0 → x = 0 := fun hx => (mul_eq_zero.mp hx).resolve_left hk
  have F1 : c^3*d - c*d^3 = 0 := cancel (by linear_combination fact_cd_c2d2 h0 h1 h2 h3 h4 h5 h6)
  have F2 : 143*c^2*d^2 - 257*c*d^3 = 0 := cancel (by linear_combination fact_cd2_lin h0 h1 h2 h3 h4 h5 h6)
  have F3 : b^4 - c^4 = 0 := cancel (by linear_combination fact_b4 h0 h1 h2 h3 h4 h5 h6)
  have F4 : a^4 - d^4 = 0 := cancel (by linear_combination fact_a4 h0 h1 h2 h3 h4 h5 h6)
  have F5 : 254306338*a^3*d + 336360499*c*d^3 - 254306338*d^4 = 0 := cancel (by linear_combination fact_a3d h0 h1 h2 h3 h4 h5 h6)
  have F6 : 254306338*b*c^3 - 254306338*c^4 + 336360499*c*d^3 = 0 := cancel (by linear_combination fact_bc3 h0 h1 h2 h3 h4 h5 h6)
  -- `cd = 0`
  have hcd : c * d = 0 := by
    by_contra hne
    have hd : d ≠ 0 := right_ne_zero_of_mul hne
    have e1 : c^2 - d^2 = 0 := by
      have : (c*d) * (c^2 - d^2) = 0 := by linear_combination F1
      exact (mul_eq_zero.mp this).resolve_left hne
    have e2 : 143*c - 257*d = 0 := by
      have : (c*d*d) * (143*c - 257*d) = 0 := by linear_combination F2
      exact (mul_eq_zero.mp this).resolve_left (mul_ne_zero hne hd)
    have e3 : (143^2 - 257^2 : K) * d^2 = 0 := by
      linear_combination -(143^2 : K) * e1 + (143*c + 257*d) * e2
    exact hd (pow_eq_zero_iff (n := 2) (by norm_num) |>.mp
      ((mul_eq_zero.mp e3).resolve_left (by norm_num)))
  rcases mul_eq_zero.mp hcd with hc | hd
  · -- `c = 0`: the scalar case
    have hb : b = 0 := pow_eq_zero_iff (n := 4) (by norm_num) |>.mp
      (by linear_combination F3 + c^3 * hc)
    have hd0 : d ≠ 0 := fun hd0 => hdet (by rw [hd0, hc]; ring)
    have ha0 : a ≠ 0 := fun ha0 => hdet (by rw [ha0, hc]; ring)
    have e5 : d * (a^3 - d^3) = 0 := by
      have : (254306338 : K) * (d * (a^3 - d^3)) = 0 := by
        linear_combination F5 - 336360499 * d^3 * hc
      exact (mul_eq_zero.mp this).resolve_left (by norm_num)
    have e5' : a^3 - d^3 = 0 := (mul_eq_zero.mp e5).resolve_left hd0
    have e6 : a^3 * (a - d) = 0 := by linear_combination F4 - d * e5'
    have had : a = d := sub_eq_zero.mp
      ((mul_eq_zero.mp e6).resolve_left (pow_ne_zero 3 ha0))
    exact Or.inl ⟨hb, hc, had.symm⟩
  · -- `d = 0`: the swap case
    have ha : a = 0 := pow_eq_zero_iff (n := 4) (by norm_num) |>.mp
      (by linear_combination F4 + d^3 * hd)
    have hc0 : c ≠ 0 := fun hc0 => hdet (by rw [hc0, hd]; ring)
    have e6 : (254306338 : K) * (c^3 * (b - c)) = 0 := by
      linear_combination F6 - 336360499 * c * d^2 * hd
    have e6' : c^3 * (b - c) = 0 := (mul_eq_zero.mp e6).resolve_left (by norm_num)
    have hbc : b = c := sub_eq_zero.mp
      ((mul_eq_zero.mp e6').resolve_left (pow_ne_zero 3 hc0))
    exact Or.inr ⟨ha, hd, hbc.symm⟩

omit [CharZero K] in
/-- The swap does preserve `D`, so the stabiliser is exactly `{1, swap}`. -/
theorem sextic_swap_mem (z w : K) : sextic (0*z + 1*w) (1*z + 0*w) = 1 * sextic z w := by
  unfold sextic; ring

end Full

end QOU.Mass.BranchLocusStabiliser
