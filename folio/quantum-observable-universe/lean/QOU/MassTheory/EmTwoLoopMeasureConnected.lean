import Mathlib.Algebra.Ring.Subring.Basic
import Mathlib.Tactic.Ring
import Mathlib.Tactic.LinearCombination

/-!
# The two-loop measure: its connected part is the only home of a new period (bean `qou-l4t2`)

PR #9841 (`EmVertexPairScalarChain`) proved that the chirality-summed Hecke skein contributes
only `ℤ[h]·H` at every loop order. The audit left one open place for a weight-3 value such as
`ζ(3)`: the two-loop **measure**. This module says exactly what that place is.

A loop measure on the α_EM ladder assigns a weight `μ₁` to a one-loop vacuum graph and a
weight `μ₂` to a two-loop vacuum graph, in a commutative coefficient ring `K`. The corpus
ladder (θ-graph grammar, audit 2026-07-14) uses the **product** rule `μ₂ = μ₁²`, with
`μ₁ = 1/(π b₁)`.

## Results

1. `connected`: the **connected two-loop period** `κ₂ := μ₂ − μ₁²` (the second cumulant of
   the measure). `two_loop_split`: for every graph value `θ`, `θ μ₂ = θ μ₁² + θ κ₂`.
   `factorizes_iff_connected_eq_zero`: the measure is a product iff `κ₂ = 0`.
2. `factorized_two_loop_mem`, `factorized_ladder_mem`: if the graph values and `μ₁` lie in a
   subring `S` and the measure is a product at every order, then every ladder coefficient
   lies in `S`. Take `S` to be the ring generated by `ℤ[q, q⁻¹]` and `μ₁`: nothing outside
   it can appear.
3. `excess_lies_in_connected`: if a two-loop coefficient `θ μ₂` is **not** in `S` while
   `θ, μ₁ ∈ S`, then `θ κ₂ ∉ S` (so in particular `κ₂ ≠ 0`). Every new period, `ζ(3)` included,
   is carried by the connected part, and by nothing else.
4. `connected_of_target`: a pre-registered two-loop slot `c` with one-loop factor `θ` is
   realized by the measure iff `θ κ₂ = c − θ μ₁²`. For the Bloch-`B₃` arm `C1` this fixes
   the connected period the measure must supply; the corpus defines no such measure.

Reading (prose, not a theorem): with the corpus product rule (`κ₂ = 0`) the two-loop slot is
in `ℤ[q, q⁻¹][μ₁]`. Whether `ζ(3)` lies outside `ℚ[π, π⁻¹]` is an open problem (the
irrationality of `ζ(3)/π³` is not known), so this module does not claim that `ζ(3)` is
excluded; it claims only that the product rule cannot *produce* it except through that ring,
and that any genuine `ζ(3)` term must be a nonzero connected period.

No measured value and no transcendental constant enter this file.
-/

set_option autoImplicit false

namespace QOU.MassTheory
namespace EmTwoLoopMeasureConnected

variable {K : Type*} [CommRing K]

/-- A loop measure up to two loops: the one-loop weight `μ₁` and the two-loop weight `μ₂`. -/
structure LoopMeasure (K : Type*) [CommRing K] where
  μ₁ : K
  μ₂ : K

/-- The **connected two-loop period** `κ₂ = μ₂ − μ₁²` (the second cumulant). -/
def connected (μ : LoopMeasure K) : K := μ.μ₂ - μ.μ₁ ^ 2

/-- A measure **factorizes** when the two-loop weight is the square of the one-loop weight. -/
def Factorizes (μ : LoopMeasure K) : Prop := μ.μ₂ = μ.μ₁ ^ 2

theorem factorizes_iff_connected_eq_zero (μ : LoopMeasure K) :
    Factorizes μ ↔ connected μ = 0 := by
  unfold Factorizes connected
  exact ⟨fun h => by rw [h]; ring, fun h => by linear_combination h⟩

/-- **Two-loop split.** Any two-loop coefficient is its product part plus its connected part. -/
theorem two_loop_split (μ : LoopMeasure K) (θ : K) :
    θ * μ.μ₂ = θ * μ.μ₁ ^ 2 + θ * connected μ := by
  unfold connected; ring

/-- **Product measures stay in the ring.** -/
theorem factorized_two_loop_mem (S : Subring K) (μ : LoopMeasure K) (θ : K)
    (hθ : θ ∈ S) (hμ : μ.μ₁ ∈ S) (hf : Factorizes μ) : θ * μ.μ₂ ∈ S := by
  rw [hf]
  exact S.mul_mem hθ (S.pow_mem hμ 2)

/-- **All orders.** A ladder whose `L`-loop weight is `μ₁ ^ L` and whose graph values lie in `S`
has every coefficient in `S`. -/
theorem factorized_ladder_mem (S : Subring K) (μ₁ : K) (θ : ℕ → K)
    (hθ : ∀ L, θ L ∈ S) (hμ : μ₁ ∈ S) (L : ℕ) : θ L * μ₁ ^ L ∈ S :=
  S.mul_mem (hθ L) (S.pow_mem hμ L)

/-- **A new period lives in the connected part.** If `θ μ₂ ∉ S` while `θ, μ₁ ∈ S`, then
`θ κ₂ ∉ S`. -/
theorem excess_lies_in_connected (S : Subring K) (μ : LoopMeasure K) (θ : K)
    (hθ : θ ∈ S) (hμ : μ.μ₁ ∈ S) (hout : θ * μ.μ₂ ∉ S) : θ * connected μ ∉ S := by
  intro hin
  apply hout
  rw [two_loop_split μ θ]
  exact S.add_mem (S.mul_mem hθ (S.pow_mem hμ 2)) hin

/-- In particular such a measure does not factorize. -/
theorem not_factorizes_of_excess (S : Subring K) (μ : LoopMeasure K) (θ : K)
    (hθ : θ ∈ S) (hμ : μ.μ₁ ∈ S) (hout : θ * μ.μ₂ ∉ S) : ¬ Factorizes μ :=
  fun hf => hout (factorized_two_loop_mem S μ θ hθ hμ hf)

/-- **Target form.** A measure realizes the two-loop slot `c` (one-loop graph value `θ`)
exactly when its connected part supplies `c − θ μ₁²`. -/
theorem connected_of_target (μ : LoopMeasure K) (θ c : K) :
    θ * μ.μ₂ = c ↔ θ * connected μ = c - θ * μ.μ₁ ^ 2 := by
  rw [two_loop_split μ θ]
  constructor
  · intro h; linear_combination h
  · intro h; linear_combination h

/-- With a factorized measure the slot is `θ μ₁²`; the corpus θ-graph slot `−[3]_q μ₁²` and
Form B's `−N₁ h² H` are both of this kind. -/
theorem factorized_slot (μ : LoopMeasure K) (θ : K) (hf : Factorizes μ) :
    θ * μ.μ₂ = θ * μ.μ₁ ^ 2 := by rw [hf]

end EmTwoLoopMeasureConnected
end QOU.MassTheory
