import Mathlib.CategoryTheory.Monoidal.Rigid.Braided
import QOU.MathlibExt.BraidedSlide
import QOU.MathlibExt.BraidedQuantumDimension
import QOU.OrientedSkein.HeckeCrossing

/-!
# `QOU.OrientedSkein.SkeinDatum` — oriented skein data, and their construction from a braiding

Stage 2 of the formalisation of the oriented skein category `OS(z, t)` (issue #7703; Step 3 of
`docs/audits/2026-10-11-drinfeld-kohno-sl2-via-emvz.md`).

Brundan's Theorem 1.1 (arXiv 1712.08953) presents `OS(z, t)` as the strict `k`-linear monoidal
category generated by objects `E, F` and morphisms
`S : E ⊗ E ⟶ E ⊗ E`, `T : F ⊗ E ⟶ E ⊗ F`, `C : 𝟙 ⟶ F ⊗ E`, `D : E ⊗ F ⟶ 𝟙` subject to

1. `S² = z S + 1`;
2. the braid relation for `S`;
3. the two zigzag relations for `C, D`;
4. `T` is invertible, with inverse the "sideways" rotation of `S` by `C` and `D`;
5. `t · D ∘ T ∘ C = ((t - t⁻¹)/z) · 1_𝟙`.

So a `k`-linear monoidal functor `OS(z, t) ⥤ 𝒞` is *exactly* a choice of such data in `𝒞`; that
is the universal property.  This file defines the data (`OrientedSkeinDatum`) in an arbitrary
`R`-linear monoidal category, with associators explicit, and proves that a braided category
supplies it (`ofBraided`): if `F ⊣ E` is an exact pairing and the self-braiding `β_{E,E}` satisfies
the Hecke relation, then `S = β_{E,E}`, `T = β_{F,E}`, `C = η`, `D = ε` satisfy (1)–(4), and (5)
becomes the statement that the braided quantum dimension of `F` (`qDimWith F E`) is the right
scalar.  This is the form in which Step 3 of the audit applies the universal property to the
Drinfeld category, with `E = V = ℂ²`.

## Encoding choices

* Relation (3) is Mathlib's `ExactPairing F E` with `C = η_ F E`, `D = ε_ F E`: its two axioms
  `coevaluation_evaluation` and `evaluation_coevaluation` are Brundan's two zigzags verbatim.
* In (5) the quotient `(t - t⁻¹)/z` is carried as a parameter `δ`, so that the base ring is a bare
  commutative ring; the intended relation `z δ = t - t⁻¹` constrains parameters, not data.

## Main definitions

* `sideways S` — Brundan's rotated crossing `(1_F ⊗ 1_E ⊗ D) ∘ (1_F ⊗ S ⊗ 1_F) ∘ (C ⊗ 1_E ⊗ 1_F)`.
* `OrientedSkeinDatum q qi t δ E F` — relations (1)–(5).
* `OrientedSkeinDatum.heckeAction` — the induced `H_{n+1}(q) →ₐ End (E^{⊗(n+1)})` (Brundan's `ι_r`).
* `OrientedSkeinDatum.ofBraided` — the datum carried by a Hecke braiding.

## Main statements

* `sideways_braiding` — in a braided category, `sideways β_{E,E} = β_{F,E}⁻¹`.
* `braid_braiding` — the self-braiding satisfies relation (2) (Yang–Baxter).

Sorry-free.

## References

* [brundan2017] J. Brundan, *Representations of the oriented skein category*, arXiv 1712.08953,
  Theorem 1.1.
* [turaev1989] V. Turaev, *Operator invariants of tangles and R-matrices*, Lemma I.3.3.
-/

namespace QOU.OrientedSkein

open CategoryTheory MonoidalCategory BraidedCategory

universe v u

set_option linter.unusedSectionVars false

section Datum

variable {R : Type*} [CommRing R]
variable {C : Type u} [Category.{v} C] [Preadditive C] [Linear R C]
  [MonoidalCategory C] [MonoidalPreadditive C] [MonoidalLinear R C]

/-- Brundan's **sideways crossing**: the rotation of `S : E ⊗ E ⟶ E ⊗ E` by the cup
`η : 𝟙 ⟶ F ⊗ E` and the cap `ε : E ⊗ F ⟶ 𝟙`,
`(1_F ⊗ 1_E ⊗ D) ∘ (1_F ⊗ S ⊗ 1_F) ∘ (C ⊗ 1_E ⊗ 1_F) : E ⊗ F ⟶ F ⊗ E`. -/
def sideways {E F : C} [ExactPairing F E] (S : E ⊗ E ⟶ E ⊗ E) : E ⊗ F ⟶ F ⊗ E :=
  𝟙 (E ⊗ F) ⊗≫ η_ F E ▷ E ▷ F ⊗≫ F ◁ S ▷ F ⊗≫ F ◁ E ◁ ε_ F E ⊗≫ 𝟙 (F ⊗ E)

/-- **Oriented skein data** in an `R`-linear monoidal category: the images of Brundan's
generators `E, F, S, T, C = η, D = ε` satisfying his relations (1)–(5).  Here `qi` is the intended
inverse of `q` (so `z = q - qi`) and `δ` the intended value of `(t - t⁻¹)/z`. -/
structure OrientedSkeinDatum (q qi t δ : R) (E F : C) [ExactPairing F E] where
  /-- The crossing `S` with relations (1) and (2). -/
  cross : HeckeCrossing q qi E
  /-- The mixed crossing `T`. -/
  T : F ⊗ E ⟶ E ⊗ F
  /-- Relation (4), first half. -/
  T_sideways : T ≫ sideways cross.S = 𝟙 (F ⊗ E)
  /-- Relation (4), second half. -/
  sideways_T : sideways cross.S ≫ T = 𝟙 (E ⊗ F)
  /-- Relation (5): `t · D ∘ T ∘ C = δ · 1_𝟙`. -/
  dim : t • (η_ F E ≫ T ≫ ε_ F E) = δ • 𝟙 (𝟙_ C)

namespace OrientedSkeinDatum

variable {q qi t δ : R} {E F : C} [ExactPairing F E]

/-- Brundan's `ι_r : H_r → End(E^{⊗ r})`, for oriented skein data in any `R`-linear monoidal
category. -/
noncomputable def heckeAction (D : OrientedSkeinDatum q qi t δ E F) (n : ℕ) :
    QOU.SchurWeyl.Hecke R q qi n →ₐ[R] End (tpow E (n + 1)) :=
  D.cross.heckeAction n

end OrientedSkeinDatum

end Datum

section Braided

variable {C : Type u} [Category.{v} C] [MonoidalCategory C] [BraidedCategory C]

/-- The self-braiding satisfies the braid relation (2): this is the Yang–Baxter equation. -/
theorem braid_braiding (E : C) :
    leftCross (β_ E E).hom E ≫ (E ◁ (β_ E E).hom) ≫ leftCross (β_ E E).hom E =
      (E ◁ (β_ E E).hom) ≫ leftCross (β_ E E).hom E ≫ (E ◁ (β_ E E).hom) := by
  simpa [leftCross, Category.assoc] using yang_baxter E E E

/-- Sliding the cup past the self-braiding: the strand `E` crossing the newly created `E` leg of
the cup `η : 𝟙 ⟶ F ⊗ E` is the same as `E` crossing the `F` leg with the inverse braiding. -/
theorem cup_cross {E F : C} [ExactPairing F E] :
    𝟙 E ⊗≫ η_ F E ▷ E ⊗≫ F ◁ (β_ E E).hom ⊗≫ 𝟙 ((F ⊗ E) ⊗ E) =
      𝟙 E ⊗≫ E ◁ η_ F E ⊗≫ (β_ F E).inv ▷ E ⊗≫ 𝟙 ((F ⊗ E) ⊗ E) := by
  have h := QOU.MathlibExt.braiding_slide_cup_left (W := E) (η_ F E)
  calc _ = 𝟙 E ⊗≫ η_ F E ▷ E ⊗≫ F ◁ (β_ E E).hom ⊗≫ (β_ F E).hom ▷ E ⊗≫ (β_ F E).inv ▷ E
            ⊗≫ 𝟙 ((F ⊗ E) ⊗ E) := by
          simp [monoidalComp]
    _ = (𝟙 E ⊗≫ η_ F E ▷ E ⊗≫ F ◁ (β_ E E).hom ⊗≫ (β_ F E).hom ▷ E ⊗≫ 𝟙 (E ⊗ F ⊗ E))
            ⊗≫ (β_ F E).inv ▷ E ⊗≫ 𝟙 ((F ⊗ E) ⊗ E) := by monoidal
    _ = (𝟙 E ⊗≫ E ◁ η_ F E ⊗≫ 𝟙 (E ⊗ F ⊗ E)) ⊗≫ (β_ F E).inv ▷ E ⊗≫ 𝟙 ((F ⊗ E) ⊗ E) := by
          rw [h]
    _ = _ := by monoidal

/-- **Relation (4) for a braiding.**  The sideways rotation of the self-braiding `β_{E,E}` is the
inverse of the mixed braiding `β_{F,E}`. -/
theorem sideways_braiding {E F : C} [ExactPairing F E] :
    𝟙 (E ⊗ F) ⊗≫ η_ F E ▷ E ▷ F ⊗≫ F ◁ (β_ E E).hom ▷ F ⊗≫ F ◁ E ◁ ε_ F E ⊗≫ 𝟙 (F ⊗ E) =
      (β_ F E).inv := by
  calc _ = 𝟙 (E ⊗ F) ⊗≫ ((𝟙 E ⊗≫ η_ F E ▷ E ⊗≫ F ◁ (β_ E E).hom ⊗≫ 𝟙 ((F ⊗ E) ⊗ E)) ▷ F)
            ⊗≫ F ◁ E ◁ ε_ F E ⊗≫ 𝟙 (F ⊗ E) := by monoidal
    _ = 𝟙 (E ⊗ F) ⊗≫ ((𝟙 E ⊗≫ E ◁ η_ F E ⊗≫ (β_ F E).inv ▷ E ⊗≫ 𝟙 ((F ⊗ E) ⊗ E)) ▷ F)
            ⊗≫ F ◁ E ◁ ε_ F E ⊗≫ 𝟙 (F ⊗ E) := by rw [cup_cross]
    _ = 𝟙 (E ⊗ F) ⊗≫ E ◁ η_ F E ▷ F
            ⊗≫ ((β_ F E).inv ▷ (E ⊗ F) ≫ (F ⊗ E) ◁ ε_ F E) ⊗≫ 𝟙 (F ⊗ E) := by monoidal
    _ = 𝟙 (E ⊗ F) ⊗≫ E ◁ η_ F E ▷ F
            ⊗≫ ((E ⊗ F) ◁ ε_ F E ≫ (β_ F E).inv ▷ 𝟙_ C) ⊗≫ 𝟙 (F ⊗ E) := by
          rw [whisker_exchange]
    _ = 𝟙 (E ⊗ F) ⊗≫ E ◁ (η_ F E ▷ F ⊗≫ F ◁ ε_ F E) ⊗≫ (β_ F E).inv := by monoidal
    _ = _ := by rw [ExactPairing.evaluation_coevaluation'']; monoidal

end Braided

section OfBraided

variable {R : Type*} [CommRing R]
variable {C : Type u} [Category.{v} C] [Preadditive C] [Linear R C]
  [MonoidalCategory C] [MonoidalPreadditive C] [MonoidalLinear R C] [BraidedCategory C]

namespace OrientedSkeinDatum

/-- **A Hecke braiding gives oriented skein data.**  In an `R`-linear braided monoidal category, if
`F ⊣ E` is an exact pairing, the self-braiding `β_{E,E}` satisfies the Hecke relation
`β² = (q - qi) β + (q qi) 1`, and the braided quantum dimension `qDimWith F E = η ≫ β_{F,E} ≫ ε`
satisfies `t · qDimWith F E = δ · 1`, then `S = β_{E,E}`, `T = β_{F,E}`, `C = η`, `D = ε` is
oriented skein data.  Relations (2) and (4) hold in every braided category
(`braid_braiding`, `sideways_braiding`); (1) and (5) are exactly the two hypotheses. -/
def ofBraided {q qi t δ : R} (E F : C) [ExactPairing F E]
    (hquad : IsHeckeQuad q qi (β_ E E).hom)
    (hdim : t • QOU.MathlibExt.qDimWith F E = δ • 𝟙 (𝟙_ C)) :
    OrientedSkeinDatum q qi t δ E F where
  cross := ⟨(β_ E E).hom, hquad, braid_braiding E⟩
  T := (β_ F E).hom
  T_sideways := by
    show (β_ F E).hom ≫ sideways (β_ E E).hom = _
    rw [sideways, sideways_braiding, Iso.hom_inv_id]
  sideways_T := by
    show sideways (β_ E E).hom ≫ (β_ F E).hom = _
    rw [sideways, sideways_braiding, Iso.inv_hom_id]
  dim := hdim

@[simp] theorem ofBraided_S {q qi t δ : R} (E F : C) [ExactPairing F E]
    (hquad : IsHeckeQuad q qi (β_ E E).hom)
    (hdim : t • QOU.MathlibExt.qDimWith F E = δ • 𝟙 (𝟙_ C)) :
    (ofBraided E F hquad hdim).cross.S = (β_ E E).hom := rfl

@[simp] theorem ofBraided_T {q qi t δ : R} (E F : C) [ExactPairing F E]
    (hquad : IsHeckeQuad q qi (β_ E E).hom)
    (hdim : t • QOU.MathlibExt.qDimWith F E = δ • 𝟙 (𝟙_ C)) :
    (ofBraided E F hquad hdim).T = (β_ F E).hom := rfl

end OrientedSkeinDatum

end OfBraided

end QOU.OrientedSkein
