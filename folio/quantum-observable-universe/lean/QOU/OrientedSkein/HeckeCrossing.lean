import Mathlib.CategoryTheory.Monoidal.Linear
import Mathlib.CategoryTheory.Linear.Basic
import Mathlib.Tactic.CategoryTheory.Monoidal.Basic
import QOU.SchurWeyl.HeckeAlgebra

/-!
# `QOU.OrientedSkein.HeckeCrossing` — a Hecke crossing on an object gives an `H_n(q)` action

This is stage 1 of the formalisation of the oriented (HOMFLYPT) skein category `OS(z, t)` and its
universal property (Brundan, *Representations of the oriented skein category*, arXiv 1712.08953,
Theorem 1.1; Etingof–Motorin–Varchenko–Zhu §6), Step 3 of
`docs/audits/2026-10-11-drinfeld-kohno-sl2-via-emvz.md`.

Brundan's Theorem 1.1 presents `OS(z, t)` as the strict `k`-linear monoidal category generated by
objects `E, F` and morphisms `S : E ⊗ E ⟶ E ⊗ E`, `T : F ⊗ E ⟶ E ⊗ F`, `C : 𝟙 ⟶ F ⊗ E`,
`D : E ⊗ F ⟶ 𝟙`, subject to five relations.  The first two relations involve only `S`:

1. `S² = z S + 1`  (the Hecke quadratic relation, with `z = q - q⁻¹`);
2. the braid relation on `E ⊗ E ⊗ E`.

The map `ι_r : H_r → End_{OS(z,t)}(E^{⊗ r})` of Brundan's §1.4, sending the `i`-th Hecke generator
to the crossing of strands `i` and `i+1`, uses only these two relations.  This file proves the
corresponding statement for an object of **any** `R`-linear monoidal category (not assumed strict;
associators are carried explicitly): a morphism `S : X ⊗ X ⟶ X ⊗ X` satisfying (1) and (2) gives an
`R`-algebra homomorphism `H_{n+1}(q) →ₐ[R] End (X^{⊗(n+1)})` sending `σ_i` to `S` inserted on
strands `i, i+1`.  Composed with a monoidal functor out of `OS(z, t)` this is Brundan's `ι_r`; it
is the half of the universal property that Step 4 of the audit consumes.

## Conventions

* Hecke algebra: `QOU.SchurWeyl.Hecke R q qi n`, generators `σ_0, …, σ_{n-1}`, quadratic relation
  `σ² = (q - qi) σ + (q qi) 1` with `qi` the intended inverse of `q` (AGENTS.md §7a, §7c).  No
  inverse is needed anywhere in this file, so `R` is a bare commutative ring.
* Tensor powers are right-nested: `X^{⊗0} = 𝟙`, `X^{⊗(n+1)} = X ⊗ X^{⊗n}`.
* `End Y` multiplies by `f * g = g ≫ f` (Mathlib's convention).

## Main definitions

* `tpow X n` — the right-nested tensor power.
* `HeckeCrossing q qi X` — a morphism `S : X ⊗ X ⟶ X ⊗ X` with the quadratic and braid relations.
* `HeckeCrossing.gen` — `S` inserted on strands `i, i+1` of `X^{⊗(n+1)}`.
* `HeckeCrossing.heckeAction` — the induced `R`-algebra map out of `H`.

## Main statements

* `gen_quad`, `gen_braid`, `gen_comm` — the inserted crossings satisfy the Hecke presentation.
* `heckeAction_σ` — `σ_i ↦ gen i`.
* `HeckeCrossing.scalar` — non-vacuity: `S = q • 𝟙` is a Hecke crossing on every object.

Sorry-free; no axioms beyond Lean/Mathlib's.

## References

* [brundan2017] J. Brundan, *Representations of the oriented skein category*, arXiv 1712.08953,
  Theorem 1.1 and §1.4.
* [turaev1989] V. Turaev, *Operator invariants of tangles and R-matrices*, Lemma I.3.3.
-/

namespace QOU.OrientedSkein

open CategoryTheory MonoidalCategory QOU.SchurWeyl

universe v u

set_option linter.unusedSectionVars false

variable {R : Type*} [CommRing R]
variable {C : Type u} [Category.{v} C] [Preadditive C] [Linear R C]
  [MonoidalCategory C] [MonoidalPreadditive C] [MonoidalLinear R C]

/-- The right-nested tensor power `X^{⊗n}`: `X^{⊗0} = 𝟙`, `X^{⊗(n+1)} = X ⊗ X^{⊗n}`. -/
def tpow (X : C) : ℕ → C
  | 0 => 𝟙_ C
  | n + 1 => X ⊗ tpow X n

@[simp] theorem tpow_zero (X : C) : tpow X 0 = 𝟙_ C := rfl
@[simp] theorem tpow_succ (X : C) (n : ℕ) : tpow X (n + 1) = X ⊗ tpow X n := rfl

/-- An endomorphism satisfies the Hecke quadratic relation `f² = (q - qi) f + (q qi) 1`. -/
def IsHeckeQuad (q qi : R) {Y : C} (f : Y ⟶ Y) : Prop :=
  f ≫ f = (q - qi) • f + (q * qi) • 𝟙 Y

/-- The crossing on the left two strands of `X ⊗ (X ⊗ P)`, conjugated by the associator. -/
def leftCross {X : C} (S : X ⊗ X ⟶ X ⊗ X) (P : C) : X ⊗ (X ⊗ P) ⟶ X ⊗ (X ⊗ P) :=
  (α_ X X P).inv ≫ (S ▷ P) ≫ (α_ X X P).hom

/-- A **Hecke crossing** on `X`: a morphism `S : X ⊗ X ⟶ X ⊗ X` satisfying relations (1) and (2)
of Brundan's presentation of the oriented skein category, the quadratic relation
`S² = (q - qi) S + (q qi) 1` and the braid relation on `X ⊗ (X ⊗ X)`. -/
structure HeckeCrossing (q qi : R) (X : C) where
  /-- The crossing. -/
  S : X ⊗ X ⟶ X ⊗ X
  /-- Relation (1): the Hecke quadratic relation. -/
  quad : IsHeckeQuad q qi S
  /-- Relation (2): the braid relation, on the right-nested `X ⊗ (X ⊗ X)`. -/
  braid : leftCross S X ≫ (X ◁ S) ≫ leftCross S X = (X ◁ S) ≫ leftCross S X ≫ (X ◁ S)

section quadLemmas

variable {q qi : R}

theorem IsHeckeQuad.whiskerRight {Y : C} {f : Y ⟶ Y} (h : IsHeckeQuad q qi f) (P : C) :
    IsHeckeQuad q qi (f ▷ P) := by
  unfold IsHeckeQuad at *
  rw [← comp_whiskerRight, h, MonoidalPreadditive.add_whiskerRight,
    MonoidalLinear.smul_whiskerRight, MonoidalLinear.smul_whiskerRight, id_whiskerRight]

theorem IsHeckeQuad.whiskerLeft {Y : C} {f : Y ⟶ Y} (h : IsHeckeQuad q qi f) (P : C) :
    IsHeckeQuad q qi (P ◁ f) := by
  unfold IsHeckeQuad at *
  rw [← whiskerLeft_comp, h, MonoidalPreadditive.whiskerLeft_add,
    MonoidalLinear.whiskerLeft_smul, MonoidalLinear.whiskerLeft_smul, whiskerLeft_id]

theorem IsHeckeQuad.conj {Y Z : C} {f : Y ⟶ Y} (h : IsHeckeQuad q qi f) (e : Y ≅ Z) :
    IsHeckeQuad q qi (e.inv ≫ f ≫ e.hom) := by
  unfold IsHeckeQuad at *
  calc (e.inv ≫ f ≫ e.hom) ≫ (e.inv ≫ f ≫ e.hom) = e.inv ≫ (f ≫ f) ≫ e.hom := by simp
    _ = _ := by
      rw [h, Preadditive.add_comp, Preadditive.comp_add, Linear.smul_comp, Linear.comp_smul,
        Linear.smul_comp, Linear.comp_smul]
      simp

end quadLemmas

namespace HeckeCrossing

variable {q qi : R} {X : C} (H : HeckeCrossing q qi X)

/-- `S` inserted on strands `i, i+1` of `X^{⊗(n+1)}` (strands numbered from the left, from `0`). -/
def gen : (n : ℕ) → Fin n → (tpow X (n + 1) ⟶ tpow X (n + 1))
  | 0, i => i.elim0
  | n + 1, ⟨0, _⟩ => leftCross H.S (tpow X n)
  | n + 1, ⟨i + 1, h⟩ => X ◁ gen n ⟨i, Nat.lt_of_succ_lt_succ h⟩

@[simp] theorem gen_zero (n : ℕ) (h : 0 < n + 1) :
    H.gen (n + 1) ⟨0, h⟩ = leftCross H.S (tpow X n) := rfl

@[simp] theorem gen_succ (n i : ℕ) (h : i + 1 < n + 1) :
    H.gen (n + 1) ⟨i + 1, h⟩ = X ◁ H.gen n ⟨i, Nat.lt_of_succ_lt_succ h⟩ := rfl

theorem gen_quad : ∀ (n : ℕ) (i : Fin n), IsHeckeQuad q qi (H.gen n i)
  | 0, i => i.elim0
  | n + 1, ⟨0, _⟩ => (H.quad.whiskerRight _).conj (α_ X X (tpow X n))
  | n + 1, ⟨i + 1, h⟩ => (gen_quad n ⟨i, Nat.lt_of_succ_lt_succ h⟩).whiskerLeft X

/-- Far commutation: `S` on strands `0,1` commutes with anything acting on strands `≥ 2`. -/
theorem leftCross_comm_whisker (P P' : C) (τ : P ⟶ P') :
    leftCross H.S P ≫ (X ◁ X ◁ τ) = (X ◁ X ◁ τ) ≫ leftCross H.S P' := by
  unfold leftCross
  rw [Category.assoc, Category.assoc, ← associator_naturality_right, ← whisker_exchange_assoc,
    ← associator_inv_naturality_right_assoc]

theorem gen_comm : ∀ (n : ℕ) (i j : Fin n), (j : ℕ) + 2 ≤ (i : ℕ) →
    H.gen n j ≫ H.gen n i = H.gen n i ≫ H.gen n j
  | 0, i, _, _ => i.elim0
  | n + 1, ⟨0, _⟩, _, h => by simp at h
  | n + 1, ⟨i + 1, hi⟩, ⟨0, _⟩, h => by
      obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
      obtain ⟨k, rfl⟩ : ∃ k, i = k + 1 := ⟨i - 1, by simp at h; omega⟩
      exact H.leftCross_comm_whisker _ _ _
  | n + 1, ⟨i + 1, hi⟩, ⟨j + 1, hj⟩, h => by
      simp only [gen_succ]
      rw [← whiskerLeft_comp, ← whiskerLeft_comp,
        gen_comm n ⟨i, Nat.lt_of_succ_lt_succ hi⟩ ⟨j, Nat.lt_of_succ_lt_succ hj⟩ (by simp at h ⊢; omega)]

/-- The structural map `X ⊗ (X ⊗ (X ⊗ P)) ⟶ (X ⊗ (X ⊗ X)) ⊗ P`. -/
def reassoc3 (P : C) : X ⊗ (X ⊗ (X ⊗ P)) ⟶ (X ⊗ (X ⊗ X)) ⊗ P :=
  (X ◁ (α_ X X P).inv) ≫ (α_ X (X ⊗ X) P).inv

/-- Its inverse. -/
def reassoc3Inv (P : C) : (X ⊗ (X ⊗ X)) ⊗ P ⟶ X ⊗ (X ⊗ (X ⊗ P)) :=
  (α_ X (X ⊗ X) P).hom ≫ (X ◁ (α_ X X P).hom)

@[reassoc]
theorem reassoc3Inv_reassoc3 (P : C) :
    reassoc3Inv (X := X) P ≫ reassoc3 P = 𝟙 _ := by
  unfold reassoc3 reassoc3Inv
  monoidal

theorem leftCross_eq_reassoc3 (P : C) :
    leftCross H.S (X ⊗ P) = reassoc3 P ≫ (leftCross H.S X ▷ P) ≫ reassoc3Inv P := by
  unfold leftCross reassoc3 reassoc3Inv
  monoidal

theorem whisker_leftCross_eq_reassoc3 (P : C) :
    X ◁ leftCross H.S P = reassoc3 P ≫ ((X ◁ H.S) ▷ P) ≫ reassoc3Inv P := by
  unfold leftCross reassoc3 reassoc3Inv
  monoidal

theorem leftCross_braid (P : C) :
    leftCross H.S (X ⊗ P) ≫ (X ◁ leftCross H.S P) ≫ leftCross H.S (X ⊗ P) =
      (X ◁ leftCross H.S P) ≫ leftCross H.S (X ⊗ P) ≫ (X ◁ leftCross H.S P) := by
  rw [H.leftCross_eq_reassoc3, H.whisker_leftCross_eq_reassoc3]
  simp only [Category.assoc, reassoc3Inv_reassoc3_assoc]
  have hb := congrArg (· ▷ P) H.braid
  simp only [comp_whiskerRight] at hb
  simp only [reassoc_of% hb]

theorem gen_braid : ∀ (n : ℕ) (i : Fin n) (hi : (i : ℕ) + 1 < n),
    H.gen n i ≫ H.gen n ⟨(i : ℕ) + 1, hi⟩ ≫ H.gen n i =
      H.gen n ⟨(i : ℕ) + 1, hi⟩ ≫ H.gen n i ≫ H.gen n ⟨(i : ℕ) + 1, hi⟩
  | 0, i, _ => i.elim0
  | n + 1, ⟨0, h0⟩, hi => by
      obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by simp at hi; omega⟩
      exact H.leftCross_braid _
  | n + 1, ⟨i + 1, h⟩, hi => by
      simp only [gen_succ]
      rw [← whiskerLeft_comp, ← whiskerLeft_comp, ← whiskerLeft_comp, ← whiskerLeft_comp,
        gen_braid n ⟨i, Nat.lt_of_succ_lt_succ h⟩ (by simp at hi ⊢; omega)]

/-- **The Hecke action.**  A Hecke crossing on `X` gives an `R`-algebra map
`H_{n+1}(q) →ₐ[R] End (X^{⊗(n+1)})`, `σ_i ↦` the crossing on strands `i, i+1`.  This is Brundan's
`ι_r` (§1.4 of arXiv 1712.08953) for an arbitrary `R`-linear monoidal category. -/
noncomputable def heckeAction (n : ℕ) : Hecke R q qi n →ₐ[R] End (tpow X (n + 1)) :=
  Hecke.lift R q qi n (fun i => H.gen n i)
    (fun i => by
      have := H.gen_quad n i
      unfold IsHeckeQuad at this
      rw [End.mul_def, this, End.one_def])
    (fun i hi => by
      simp only [End.mul_def]
      exact H.gen_braid n i hi)
    (fun i j h => by
      simp only [End.mul_def]
      exact H.gen_comm n i j h)

@[simp] theorem heckeAction_σ (n : ℕ) (i : Fin n) :
    H.heckeAction n (Hecke.σ R q qi n i) = H.gen n i := by
  simp [heckeAction]

/-- **Non-vacuity.** `S = q • 𝟙` is a Hecke crossing on every object (the trivial,
"symmetric-channel" representation `σ_i ↦ q`). -/
def scalar (q qi : R) (X : C) : HeckeCrossing q qi X where
  S := q • 𝟙 (X ⊗ X)
  quad := by
    unfold IsHeckeQuad
    rw [Linear.smul_comp, Category.id_comp, smul_smul, smul_smul, ← add_smul]
    congr 1
    ring
  braid := by
    unfold leftCross
    simp

end HeckeCrossing

end QOU.OrientedSkein
