import Mathlib.GroupTheory.OrderOfElement
import QOU.BringLatticeSpan

/-!
# Bring's lattice spans `M₂(R)`: the `hS` hypothesis from a finite quotient

Bean `qou-pu2x`, item 1; issue #7783. `QOU.BringLatticeSpan` proves `bring_span_eq_top` and
`bring_left_mul_scalar` under the hypothesis

  `hS : ∀ g ∈ Submonoid.closure {s, u}, ∃ n : ℕ, g ^ (n + 1) ∈ S`.

This file replaces `hS` by a weaker-looking and more standard input: **a monoid hom
`ρ : Submonoid.closure {s, u} →* G` to a finite group `G` whose kernel lands in `S`.**

* `exists_pow_succ_mem_of_mker_le` (generic monoid `M`): if `ρ : M →* G`, `G` a finite group,
  and `S` a submonoid with `ρ.mker ≤ S`, then every `g : M` has `g ^ Nat.card G ∈ S`, hence
  a positive power in `S`. Proof: `ρ (g ^ |G|) = (ρ g) ^ |G| = 1` (Mathlib `pow_card_eq_one'`).
* `exists_pow_succ_mem_of_hom`: the same statement for a submonoid `T` of an ambient monoid
  `A`, with `S ⊆ A` and the kernel condition stated on coercions. This is the shape
  `bring_span_eq_top` needs (`T = Submonoid.closure {s, u}`, `A = M₂(R)`).
* `bring_span_eq_top_of_hom`, `bring_left_mul_scalar_of_hom`: the two Bring theorems with
  `hS` replaced by the existence of such a `ρ`.

## Relation to the literature (cited, not formalised)

Kattan–Singerman (`kattan2024`, `library/arxiv-2402.08782v1`, §1) define Bring's surface as
`ℍ/K` with `K = ker(Δ(2,5,4) → S₅)`, of index 120. In the `SL(2)` lift, compose the projection
to `PSL(2)` with that epimorphism: the kernel is the lift `±K` of Bring's group `Γ₄`. So taking
`G = S₅` (or any finite group through which the lifted map factors, e.g. a double cover of
`S₅`) matches their definition, and `S` is the submonoid generated by (or equal to) the lift
of `Γ₄`. Neither the map to `S₅` nor the uniformisation `ℍ/K ≅` Bring's curve is constructed
here.

## What is still assumed

After this file the cited assumption is exactly: *the `SL(2)` lift of `Γ₄` contains the
kernel of a monoid hom from the group generated by `s, u` to a finite group.* That is the
literature's definition of `Γ₄` (as a finite-index normal subgroup cut out by a map to `S₅`),
not a theorem about it. What is still not formalised is that the `s, u` of
`QOU.BringLatticeSpan` (characterised by traces) *are* the lifted generators of `Δ(2,5,4)`
realising Bring's curve, and that the epimorphism to `S₅` exists.
-/

namespace QOU.Tetraplectic.Split

section FiniteQuotient

/-- **Positive powers land in any submonoid containing the kernel of a hom to a finite
group.** For `ρ : M →* G` with `G` a finite group and `ρ.mker ≤ S`, every `g : M` has a
positive power in `S`, namely `g ^ Nat.card G`. -/
theorem exists_pow_succ_mem_of_mker_le {M G : Type*} [Monoid M] [Group G] [Finite G]
    (ρ : M →* G) {S : Submonoid M} (hker : MonoidHom.mker ρ ≤ S) (g : M) :
    ∃ n : ℕ, g ^ (n + 1) ∈ S := by
  have hpos : 0 < Nat.card G := Nat.card_pos
  refine ⟨Nat.card G - 1, ?_⟩
  rw [Nat.sub_add_cancel hpos]
  apply hker
  rw [MonoidHom.mem_mker, map_pow, pow_card_eq_one']

/-- **Submonoid version.** `T` a submonoid of an ambient monoid `A`, `ρ : T →* G` with `G` a
finite group, and every `g ∈ T` with `ρ g = 1` lying in `S ⊆ A`. Then every element of `T`
has a positive power in `S`. -/
theorem exists_pow_succ_mem_of_hom {A G : Type*} [Monoid A] [Group G] [Finite G]
    {T S : Submonoid A} (ρ : T →* G) (hker : ∀ g : T, ρ g = 1 → (g : A) ∈ S) :
    ∀ g ∈ T, ∃ n : ℕ, g ^ (n + 1) ∈ S := by
  intro g hg
  obtain ⟨n, hn⟩ := exists_pow_succ_mem_of_mker_le ρ
    (S := S.comap T.subtype) (fun x hx => hker x hx) ⟨g, hg⟩
  exact ⟨n, hn⟩

end FiniteQuotient

section Bring

variable {R : Type*} [Field R] [LinearOrder R] [IsStrictOrderedRing R]

/-- **Bring's triangle group spans, via a finite quotient.** As `bring_span_eq_top`, with `hS`
replaced by: a monoid hom `ρ` from the monoid generated by `s, u` to a finite group `G`, whose
kernel lies in `S`. Kattan–Singerman's definition of Bring's group (kernel of
`Δ(2,5,4) → S₅`, lifted to `SL(2)`) supplies such a `ρ` with `G = S₅`; that map is cited,
not constructed. -/
theorem bring_span_eq_top_of_hom {s u : SplitBringCone R} {φ r : R}
    (hφ : φ * φ = φ + 1) (hr : r * r = 2) (hφ0 : 0 < φ) (hr0 : 0 < r)
    (hNs : rnorm s = 1) (hNu : rnorm u = 1)
    (hTs : rtr s = 0) (hTu : rtr u = φ) (hTsu : rtr (s * u) = r)
    {S : Submonoid (SplitBringCone R)} {G : Type*} [Group G] [Finite G]
    (ρ : Submonoid.closure ({s, u} : Set (SplitBringCone R)) →* G)
    (hker : ∀ g : Submonoid.closure ({s, u} : Set (SplitBringCone R)),
      ρ g = 1 → (g : SplitBringCone R) ∈ S) :
    Submodule.span R (S : Set (SplitBringCone R)) = ⊤ :=
  bring_span_eq_top hφ hr hφ0 hr0 hNs hNu hTs hTu hTsu (exists_pow_succ_mem_of_hom ρ hker)

/-- **`bring_left_mul_scalar` via a finite quotient.** Under the hypotheses of
`bring_span_eq_top_of_hom`, a left multiplication `L_v` commuting with every element of `S`
is a scalar. -/
theorem bring_left_mul_scalar_of_hom {s u : SplitBringCone R} {φ r : R}
    (hφ : φ * φ = φ + 1) (hr : r * r = 2) (hφ0 : 0 < φ) (hr0 : 0 < r)
    (hNs : rnorm s = 1) (hNu : rnorm u = 1)
    (hTs : rtr s = 0) (hTu : rtr u = φ) (hTsu : rtr (s * u) = r)
    {S : Submonoid (SplitBringCone R)} {G : Type*} [Group G] [Finite G]
    (ρ : Submonoid.closure ({s, u} : Set (SplitBringCone R)) →* G)
    (hker : ∀ g : Submonoid.closure ({s, u} : Set (SplitBringCone R)),
      ρ g = 1 → (g : SplitBringCone R) ∈ S)
    {v : SplitBringCone R} (hv : ∀ γ ∈ S, v * γ = γ * v) :
    v.imI = 0 ∧ v.imJ = 0 ∧ v.imK = 0 :=
  bring_left_mul_scalar hφ hr hφ0 hr0 hNs hNu hTs hTu hTsu
    (exists_pow_succ_mem_of_hom ρ hker) hv

end Bring

end QOU.Tetraplectic.Split
