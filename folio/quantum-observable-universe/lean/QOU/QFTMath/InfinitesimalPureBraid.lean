import Mathlib.Algebra.MonoidAlgebra.Basic
import Mathlib.GroupTheory.Perm.Support

/-!
# The infinitesimal pure-braid (Drinfeld–Kohno) relations, realised by transpositions for all `n`

Bean `qou-bgq9` (QFT-2, math-only core; epic `qou-3fjn`).

The Drinfeld–Kohno Lie algebra `𝔱ₙ` is generated by `t_{ij} = t_{ji}` (`i ≠ j`) subject to

* `[t_{ij}, t_{kl}] = 0` for `{i, j} ∩ {k, l} = ∅`, and
* `[t_{ij}, t_{ik} + t_{jk}] = 0` for distinct `i, j, k`.

It is the associated graded of the pure braid group's lower central series (Kohno), and the
4T relation of chord diagrams is the closure image of the second relation. This file proves that
the **transpositions** `t_{ij} = (i j)` in the group algebra `k[Sₙ]` satisfy all of these
relations, for **every** `n` and every commutative ring `k`: `IsInfPureBraid` (`transposition_isInfPureBraid`).
Any permutation representation (in particular `V^{⊗n}` with the place-permutation action, the
`t_{ij} = P_{ij}` of the KZ connection for `gl_N`) is a quotient of `k[Sₙ]`, so it inherits them.

The group identity doing the work is `swap_conj`: `(i j)(i k)(i j) = (j k)` for distinct `i, j, k`.

## Scope

Proved: the relations, in the group algebra, for all `n`. **Not proved here**: Kohno's theorem
that `𝔱ₙ` is the associated graded of `ℤ[PBₙ]`, and the identification of the 4T relation as the
closure of the second relation in `QOU.KnotTheory.Vassiliev.FourTermRelation`. Those remain the
open part of the bean. The bean's former physics targets (SM β multiplicities, `(g−2)_e`, DIS
moments) were dropped at the 2026-11-21 re-scope.

Standard reference (not yet in the bibliography): Kohno, *Série de Poincaré-Koszul associée aux groupes de tresses pures*,
   Invent. Math. 82 (1985).
-/

namespace QOU.QFTMath.InfPureBraid

open Equiv

variable {n : ℕ}

/-- Conjugating `(i k)` by `(i j)` gives `(j k)` when `i, j, k` are distinct. -/
theorem swap_conj {i j k : Fin n} (_hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k) :
    swap i j * swap i k * swap i j = swap j k := by
  have h := swap_apply_apply (swap i j) i k
  rw [swap_apply_left, swap_apply_of_ne_of_ne hik.symm hjk.symm, swap_inv] at h
  exact h.symm

/-- `(i j)(i k) = (j k)(i j)`. -/
theorem swap_mul_swap_left {i j k : Fin n} (hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k) :
    swap i j * swap i k = swap j k * swap i j := by
  rw [← swap_conj hij hik hjk, mul_assoc, swap_mul_self, mul_one]

/-- `(i j)(j k) = (i k)(i j)`. -/
theorem swap_mul_swap_right {i j k : Fin n} (hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k) :
    swap i j * swap j k = swap i k * swap i j := by
  have h := swap_mul_swap_left hij.symm hjk hik
  rw [swap_comm j i] at h
  exact h

variable (k : Type*) [CommRing k]

/-- `t_{ij} = (i j) ∈ k[Sₙ]`. -/
noncomputable def t (i j : Fin n) : MonoidAlgebra k (Perm (Fin n)) := MonoidAlgebra.of k _ (swap i j)

/-- The infinitesimal pure-braid relations for a family `t : Fin n → Fin n → A`. -/
structure IsInfPureBraid {A : Type*} [Ring A] (t : Fin n → Fin n → A) : Prop where
  symm : ∀ i j, t i j = t j i
  far : ∀ i j a b, i ≠ a → i ≠ b → j ≠ a → j ≠ b → Commute (t i j) (t a b)
  near : ∀ i j l, i ≠ j → i ≠ l → j ≠ l → Commute (t i j) (t i l + t j l)

/-- **Transpositions satisfy the Drinfeld–Kohno relations in `k[Sₙ]`, for every `n`.** -/
theorem transposition_isInfPureBraid : IsInfPureBraid (t (n := n) k) where
  symm i j := by unfold t; rw [swap_comm]
  far i j a b hia hib hja hjb := by
    unfold t
    have hd : Perm.Disjoint (swap i j) (swap a b) := by
      intro x
      by_cases hx1 : x = i
      · subst hx1; right; exact swap_apply_of_ne_of_ne hia hib
      by_cases hx2 : x = j
      · subst hx2; right; exact swap_apply_of_ne_of_ne hja hjb
      left; exact swap_apply_of_ne_of_ne hx1 hx2
    exact (hd.commute.map (MonoidAlgebra.of k _))
  near i j l hij hil hjl := by
    unfold t Commute SemiconjBy
    rw [mul_add, add_mul, ← map_mul, ← map_mul, ← map_mul, ← map_mul,
      swap_mul_swap_left hij hil hjl, swap_mul_swap_right hij hil hjl, add_comm]

end QOU.QFTMath.InfPureBraid
