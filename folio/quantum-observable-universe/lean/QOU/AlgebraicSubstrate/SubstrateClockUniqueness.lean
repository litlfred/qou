import Mathlib.Data.Nat.Factorial.Basic
import Mathlib.Algebra.CharZero.Defs
import Mathlib.Algebra.Group.Prod
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.Ring
import Mathlib.Tactic.NormNum

namespace QOU.AlgebraicSubstrate.SubstrateClock

variable {M : Type*} [AddCommMonoid M] {K : Type*} [Field K]

/-- A **clock** on the substrate's computation monoid `M`: a `K`-valued
step-counter that (i) is additive under composition of computation
segments — the algebraic core of "functorial under the substrate's
composition of computation steps" — and (ii) is not identically zero —
the algebraic shadow of cofinality (a counter that never registers any
computation counts nothing). The order-theoretic clauses (strict
monotonicity for the braiding-induced ordering `≺_∞`, cofinality in the
well-founded computation order of `prop:ordering-jet-compatibility`) are
archimedean-side refinements recorded in the audit; the downstream
algebra uses only (i)+(ii). -/
def IsClock (T : M → K) : Prop :=
  (∀ a b : M, T (a + b) = T a + T b) ∧ ∃ a : M, T a ≠ 0

/-- An additive counter sends the empty computation to zero. -/
theorem map_zero_of_additive (T : M → K)
    (hadd : ∀ a b : M, T (a + b) = T a + T b) : T 0 = 0 := by
  have h : T 0 = T 0 + T 0 := by
    have h0 := hadd 0 0
    rwa [add_zero] at h0
  have h' : T 0 + 0 = T 0 + T 0 := by
    rw [add_zero]
    exact h
  exact (add_left_cancel h').symm

/-- An additive counter on iterates of a single step `g` is linear in the
iterate count: `T (n • g) = n · T g`. This is the entire mathematical
mechanism of the atomic discharge below. -/
theorem map_nsmul_of_additive (T : M → K)
    (hadd : ∀ a b : M, T (a + b) = T a + T b) (g : M) :
    ∀ n : ℕ, T (n • g) = (n : K) * T g := by
  intro n
  induction n with
  | zero =>
    rw [zero_nsmul, map_zero_of_additive T hadd, Nat.cast_zero, zero_mul]
  | succ k ih =>
    rw [succ_nsmul, hadd, ih, Nat.cast_succ]
    ring

/-- **Primary conjecture (open — NO instance; §3b-tax).** THE SUBSTRATE
HAS ONE CLOCK: any two clocks of the substrate's computation monoid
differ by a single nonzero scale — the scale freedom that owner premise
P1 (substrate scale-freedom) already quotients out. The field is
parameter-quantified over all clock pairs; it is a genuine structural
restriction on `M` (rank-one-ness of the computation monoid), FALSE for a
two-generator step monoid (`uniqueness_fails_for_two_generators`) and
discharged by atomicity of the step monoid
(`unique_up_to_scale_of_atomic` — the "no sub-step resolution" of the
Planck step, `rem:discrete-planck-step`, currently prose-only). An
unproved primary conjecture is honestly represented by this
content-bearing class with no instance; creating an instance without
proving the substrate monoid's rank-one structure would be laundering. -/
-- Ref: [leitner2026] docs/audits/2026-07-25-substrate-clock-uniqueness-reduction.md
class SubstrateClockUniqueness (M : Type*) [AddCommMonoid M]
    (K : Type*) [Field K] [CharZero K] : Prop where
  /-- Any two clocks differ by a nonzero scale: the substrate's
  computational time is unique up to the P1-quotiented scale action. -/
  unique_up_to_scale :
    ∀ T T' : M → K, IsClock T → IsClock T' →
      ∃ lam : K, lam ≠ 0 ∧ ∀ a : M, T' a = lam * T a

/-- **Non-tautology witness (proved, unconditional).** The one-clock
statement is FALSE for the rank-two step monoid `ℕ × ℕ`: the two
coordinate counters are both clocks but are not proportional. Hence
`SubstrateClockUniqueness` carries real content — it asserts the
substrate's computation monoid does NOT decompose into independent
parallel step-counting directions. -/
theorem uniqueness_fails_for_two_generators [CharZero K] :
    ¬ (∀ T T' : ℕ × ℕ → K, IsClock T → IsClock T' →
        ∃ lam : K, lam ≠ 0 ∧ ∀ a : ℕ × ℕ, T' a = lam * T a) := by
  intro h
  have hfst : IsClock (fun p : ℕ × ℕ => (p.1 : K)) := by
    refine ⟨fun a b => ?_, ⟨(1, 0), by norm_num⟩⟩
    show (((a + b).1 : ℕ) : K) = ((a.1 : ℕ) : K) + ((b.1 : ℕ) : K)
    rw [Prod.fst_add, Nat.cast_add]
  have hsnd : IsClock (fun p : ℕ × ℕ => (p.2 : K)) := by
    refine ⟨fun a b => ?_, ⟨(0, 1), by norm_num⟩⟩
    show (((a + b).2 : ℕ) : K) = ((a.2 : ℕ) : K) + ((b.2 : ℕ) : K)
    rw [Prod.snd_add, Nat.cast_add]
  obtain ⟨lam, hne, hprop⟩ := h _ _ hfst hsnd
  have h10 : ((0 : ℕ) : K) = lam * ((1 : ℕ) : K) := hprop (1, 0)
  rw [Nat.cast_zero, Nat.cast_one, mul_one] at h10
  exact hne h10.symm

/-- **Discharge map (proved, sorry-free).** The one-clock statement HOLDS
for any step monoid generated by a single atomic step: if every
computation is an iterate of one generator `g` (`∀ a, ∃ n, a = n • g` —
the formal shape of "no sub-step resolution",
`rem:discrete-planck-step`), then any two clocks differ by a nonzero
scale. This is the exact open premise the primary conjecture reduces to:
ATOMICITY of the substrate's computation monoid. Stated as a plain
theorem, NOT an instance — instantiating the class at the substrate's
monoid requires proving that monoid's atomicity, which is open. -/
theorem unique_up_to_scale_of_atomic (g : M)
    (hgen : ∀ a : M, ∃ n : ℕ, a = n • g)
    (T T' : M → K) (hT : IsClock T) (hT' : IsClock T') :
    ∃ lam : K, lam ≠ 0 ∧ ∀ a : M, T' a = lam * T a := by
  obtain ⟨haddT, aT, haT⟩ := hT
  obtain ⟨haddT', aT', haT'⟩ := hT'
  have hTg : T g ≠ 0 := by
    obtain ⟨n, rfl⟩ := hgen aT
    rw [map_nsmul_of_additive T haddT g n] at haT
    intro hzero
    exact haT (by rw [hzero, mul_zero])
  have hT'g : T' g ≠ 0 := by
    obtain ⟨n, rfl⟩ := hgen aT'
    rw [map_nsmul_of_additive T' haddT' g n] at haT'
    intro hzero
    exact haT' (by rw [hzero, mul_zero])
  refine ⟨T' g / T g, div_ne_zero hT'g hTg, fun a => ?_⟩
  obtain ⟨n, rfl⟩ := hgen a
  rw [map_nsmul_of_additive T haddT g n, map_nsmul_of_additive T' haddT' g n]
  field_simp

/-- **Conditional clock-level core (proved, sorry-free).** GIVEN the
one-clock conjecture, the binding side's Borel/jet-level counter `Tb` and
the loop's proper-time counter `Ts` — both clocks of the same
computation monoid under owner premise P2 — agree up to a nonzero scale.
This is the clock-level core of the Borel/proper-time identification:
what separates the two sectors' time variables is at most the single
scale P1 quotients out. -/
theorem clocks_agree_up_to_scale [CharZero K]
    [SubstrateClockUniqueness M K]
    (Tb Ts : M → K) (hb : IsClock Tb) (hs : IsClock Ts) :
    ∃ lam : K, lam ≠ 0 ∧ ∀ a : M, Tb a = lam * Ts a :=
  SubstrateClockUniqueness.unique_up_to_scale Ts Tb hs hb

/-- **Keystone kills both parameters (proved, sorry-free,
unconditional).** If the binding normalizer is the loop-moment sequence
read scale-covariantly at relative clock scale `lam` with measure unit
`ς` — `N(m+1) = lam^{m+1}·ς·m!` — and the Lean-proved keystone identity
`n·N(n) = n!` holds (`KeystoneBridgeC1Binding`, hypothesis `hkey` per the
`_of_` discipline), then the scale AND the unit are both forced:
`lam = 1 ∧ ς = 1`. Two moments decide it: `m = 0` gives `lam·ς = 1`;
`m = 1` gives `lam²·ς = 1`, hence `lam = 1`, hence `ς = 1`. -/
theorem scale_and_unit_pinned_of_keystone [CharZero K]
    (lam ς : K) (N : ℕ → K)
    (hrep : ∀ m : ℕ, N (m + 1) = lam ^ (m + 1) * ς * (m.factorial : K))
    (hkey : ∀ m : ℕ, ((m + 1 : ℕ) : K) * N (m + 1) = ((m + 1).factorial : K)) :
    lam = 1 ∧ ς = 1 := by
  have e0 : ((1 : ℕ) : K) * N 1 = ((Nat.factorial 1 : ℕ) : K) := hkey 0
  have e1 : ((2 : ℕ) : K) * N 2 = ((Nat.factorial 2 : ℕ) : K) := hkey 1
  have r0 : N 1 = lam ^ 1 * ς * ((Nat.factorial 0 : ℕ) : K) := hrep 0
  have r1 : N 2 = lam ^ 2 * ς * ((Nat.factorial 1 : ℕ) : K) := hrep 1
  have hfac0 : ((Nat.factorial 0 : ℕ) : K) = 1 := by norm_num [Nat.factorial]
  have hfac1 : ((Nat.factorial 1 : ℕ) : K) = 1 := by norm_num [Nat.factorial]
  have hfac2 : ((Nat.factorial 2 : ℕ) : K) = 2 := by norm_num [Nat.factorial]
  rw [hfac1, Nat.cast_one, one_mul] at e0
  rw [hfac2] at e1
  push_cast at e1
  rw [hfac0, mul_one, pow_one] at r0
  rw [hfac1, mul_one] at r1
  -- e0 : N 1 = 1;  e1 : 2 * N 2 = 2;  r0 : N 1 = lam * ς;  r1 : N 2 = lam ^ 2 * ς
  have hls : lam * ς = 1 := by rw [← r0]; exact e0
  have h2ne : (2 : K) ≠ 0 := by norm_num
  have hN2 : N 2 = 1 := by
    have h2 : (2 : K) * N 2 = 2 * 1 := by
      rw [mul_one]
      exact e1
    exact mul_left_cancel₀ h2ne h2
  have hlam : lam = 1 := by
    have hsq : lam ^ 2 * ς = 1 := by rw [← r1]; exact hN2
    have hfactor : lam ^ 2 * ς = lam * (lam * ς) := by ring
    rw [hfactor, hls, mul_one] at hsq
    exact hsq
  refine ⟨hlam, ?_⟩
  rw [hlam, one_mul] at hls
  exact hls

/-- **The composed reduction (proved, sorry-free, conditional).** GIVEN
(1) the one-clock conjecture (class hypothesis), (2) that the binding and
loop counters are clocks, (3) the shared-variable representability
premise `hrep` — for whatever scale relates the two clocks, the binding
normalizer is the loop-moment sequence read scale-covariantly in the
binding chart (OPEN; this is the analytic-representability face of the
identification, restricted to its arithmetic shadow) — and (4) the
Lean-proved keystone identity (`hkey`), the binding normalizer IS the
unit factorial sequence: `N(m+1) = m!`. This conclusion is verbatim the
`moment_eq_normalizer` field of `BorelProperTimeIdentification`
(content-block sibling of `conj:schwinger-measure-computational-time`)
at unit `ς = 1` — the conjecture's algebraic core, now a CONSEQUENCE of
one-clock + representability + the proved keystone. What is NOT supplied:
the analytic fields (`positive`, `integrable`) of
`BindingKernelSchwingerRepresentation` — kernel representability stays
open; see the file header's reduction chain. -/
theorem borel_identification_core [CharZero K]
    [SubstrateClockUniqueness M K]
    (Tb Ts : M → K) (hb : IsClock Tb) (hs : IsClock Ts)
    (N : ℕ → K) (ς : K)
    (hrep : ∀ lam : K, (∀ a : M, Tb a = lam * Ts a) →
        ∀ m : ℕ, N (m + 1) = lam ^ (m + 1) * ς * (m.factorial : K))
    (hkey : ∀ m : ℕ, ((m + 1 : ℕ) : K) * N (m + 1) = ((m + 1).factorial : K)) :
    ∀ m : ℕ, N (m + 1) = (m.factorial : K) := by
  obtain ⟨lam, _hne, hprop⟩ := clocks_agree_up_to_scale Tb Ts hb hs
  have hr := hrep lam hprop
  obtain ⟨hl, hσ⟩ := scale_and_unit_pinned_of_keystone lam ς N hr hkey
  intro m
  rw [hr m, hl, hσ, one_pow, one_mul, one_mul]

end QOU.AlgebraicSubstrate.SubstrateClock
