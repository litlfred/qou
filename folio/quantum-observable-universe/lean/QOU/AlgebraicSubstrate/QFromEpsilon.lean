import QOU.AlgebraicSubstrate.ReebEpsilon

/-!
# QOU.AlgebraicSubstrate.QFromEpsilon — `q := 1 + ε`

Fixes the main-text convention that the substrate parameter `q`
is the element `1 + ε` of the ordered field generated by the Reeb
infinitesimal `ε` over `ℝ`, and equivalently the element `1 + 1/ω`
of Conway's surreal field `𝐍𝐨` under the identification of
`QOU.AppendixSurreals.StandardPart`.

Morphisms in a plain category have no additive structure, so the
identity `q = 1 + ε` cannot be stated at the morphism level.  It is
stated here at the surreal-valued level, via an abstract carrier
field that downstream `StandardPart`-based modules will specialise
to `𝐍𝐨` or a Hahn completion.

LaTeX label: `def:q-from-epsilon`.

## References

- [conway1976] Conway, *On Numbers and Games*.
- [gonshor1986] Gonshor, *An Introduction to the Theory of Surreal
  Numbers*.  DOI:10.1017/CBO9780511629143.
- [leitner2026] Chapter 8 §5 (Classical Limit).
-/

namespace QOU.AlgebraicSubstrate

universe u v

/-- **QFromEpsilon**: an ordered-field carrier `F` together with
    distinguished elements `oneValue`, `epsilonValue`, and
    `qSubstrate` satisfying `qSubstrate = oneValue + epsilonValue`.

    The field `F` is abstract.  Canonical instantiations are
    `F = ℝ(ε)` (rational functions of a formal infinitesimal) and
    `F = 𝐍𝐨` (Conway's surreal field); both are available via
    `QOU.AppendixSurreals`.  The carrier is left abstract here so
    the structure stays usable without pulling in the surreal
    formalism.

    LaTeX: `\label{def:q-from-epsilon}` -/
-- Ref: [conway1976] On Numbers and Games §III
-- Ref: [gonshor1986] §4 (sum and product)
structure QFromEpsilon where
  /-- Ordered-field carrier containing both a standard-real subring
      and a positive infinitesimal. -/
  F : Type
  /-- Addition on `F` (left abstract to avoid committing to a
      specific algebraic structure here). -/
  add : F → F → F
  /-- Image of `1 ∈ ℝ` in `F`. -/
  oneValue : F
  /-- Image of the Reeb infinitesimal `ε ∈ Der(A)` in `F` via the
      surreal embedding. -/
  epsilonValue : F
  /-- The substrate parameter `q`. -/
  qSubstrate : F
  /-- Definitional identity `q = 1 + ε`. -/
  q_eq_one_plus_epsilon : qSubstrate = add oneValue epsilonValue

end QOU.AlgebraicSubstrate
