import QOU.RiemannSurface.CycleCountSwap
import Mathlib.Logic.Relation

/-!
# `QOU.RiemannSurface.MapGenusNonneg` — the genus of a connected combinatorial map is `≥ 0`

Bean `qou-m3tr` (Bring milestone M3, step 2), parent `qou-qhcr`.

For permutations `σ, τ` of a finite set `D` let `c(π)` be the number of cycles of `π` (fixed
points included) and `O(σ, τ)` the number of orbits of `⟨σ, τ⟩`, i.e. of classes of the
equivalence relation generated by `x ~ σ x` and `x ~ τ x` (`orbits`).

## What is proved (sorry-free)

* **`ree_inequality`**: `c(σ) + c(τ) + c(σ * τ) ≤ |D| + 2·O(σ, τ)` for all `σ, τ`.
* **`map_euler_le_two`**: for a combinatorial map `(σ, α)` — `α` a fixed-point-free
  involution — that is **connected** (`O(σ, α) = 1`),
  `c(σ) − c(α) + c(σ * α) ≤ 2`.
* **`exists_genus_nonneg`**: hence `χ = 2 − 2g` with `g : ℕ`, which is what the genus-4
  capstone's `g : ℕ` presupposes.

## Proof

Induction on `|D| − c(τ)`. If `τ = 1` both sides are `2·c(σ) + |D|` up to `O(σ, 1) ≥ c(σ)`.
Otherwise pick `a` with `τ a ≠ a`, `b = τ a`, and put `τ' = τ * swap a b`, so `c(τ') = c(τ) + 1`
(`numCycles_mul_swap_of_sameCycle`) and `τ = τ' * swap a b`. Then `σ τ = (σ τ') * swap a b`
changes `c` by `±1` relative to `σ τ'`:

* **split** (`a, b` in one cycle of `σ τ'`): `c(στ) = c(στ') + 1`, and `a, b` are already in one
  orbit of `⟨σ, τ'⟩`, so `O(σ, τ) ≥ O(σ, τ')`;
* **merge**: `c(στ) = c(στ') − 1`, and adding the pair `{a, b}` lowers the orbit count by at
  most one, so `O(σ, τ) ≥ O(σ, τ') − 1`.

Both relations `⟨σ, τ⟩` and `⟨σ, τ'⟩` generate the same equivalence once the pair `(a, b)` is
added (`plus_eq`), which is how the two orbit counts are compared.

Ref: this is Ree's inequality, R. Ree, *A theorem on permutations*, J. Combin. Theory A 10
(1971); the cellular reading is [farkas-kra1992] §I.2.
-/

namespace QOU.RiemannSurface.MapGenusNonneg

open Equiv Equiv.Perm Relation
open QOU.RiemannSurface.CombinatorialMapEuler QOU.RiemannSurface.CycleCountSwap

set_option linter.unusedSectionVars false

variable {D : Type*} [Fintype D] [DecidableEq D]

/-- One step of `σ` or of `τ`. -/
def step (σ τ : Perm D) (u v : D) : Prop := v = σ u ∨ v = τ u

/-- The orbit relation of `⟨σ, τ⟩`. -/
def orbitSetoid (σ τ : Perm D) : Setoid D := EqvGen.setoid (step σ τ)

/-- The number of orbits of `⟨σ, τ⟩`. -/
noncomputable def orbits (σ τ : Perm D) : ℕ := Nat.card (Quotient (orbitSetoid σ τ))

/-- The step relation with the pair `(a, b)` adjoined. -/
def stepPlus (σ τ : Perm D) (a b : D) (u v : D) : Prop := step σ τ u v ∨ (u = a ∧ v = b)

/-! ### Comparing quotients -/

theorem card_quot_le_of_le {r s : Setoid D} (h : ∀ x y, r x y → s x y) :
    Nat.card (Quotient s) ≤ Nat.card (Quotient r) :=
  Nat.card_le_card_of_surjective (Quotient.map' id fun x y hxy => h x y hxy)
    (fun q => by
      induction q using Quotient.inductionOn' with
      | h x => exact ⟨Quotient.mk'' x, rfl⟩)

theorem card_quot_eq_of_iff {r s : Setoid D} (h : ∀ x y, r x y ↔ s x y) :
    Nat.card (Quotient r) = Nat.card (Quotient s) :=
  le_antisymm (card_quot_le_of_le fun x y => (h x y).2)
    (card_quot_le_of_le fun x y => (h x y).1)

/-! ### Adding one pair lowers the class count by at most one -/

section AddPair

variable (r : Setoid D) (a b : D)

/-- The explicit form of the relation generated by `r` and the pair `(a, b)`. -/
def S (x y : D) : Prop := r x y ∨ (r x a ∧ r b y) ∨ (r x b ∧ r a y)

theorem S_equivalence : Equivalence (S r a b) := by
  refine ⟨fun x => Or.inl (r.refl x), ?_, ?_⟩
  · rintro x y (h | ⟨h1, h2⟩ | ⟨h1, h2⟩)
    · exact Or.inl (r.symm h)
    · exact Or.inr (Or.inr ⟨r.symm h2, r.symm h1⟩)
    · exact Or.inr (Or.inl ⟨r.symm h2, r.symm h1⟩)
  · rintro x y z (h | ⟨h1, h2⟩ | ⟨h1, h2⟩) (k | ⟨k1, k2⟩ | ⟨k1, k2⟩)
    · exact Or.inl (r.trans h k)
    · exact Or.inr (Or.inl ⟨r.trans h k1, k2⟩)
    · exact Or.inr (Or.inr ⟨r.trans h k1, k2⟩)
    · exact Or.inr (Or.inl ⟨h1, r.trans h2 k⟩)
    · exact Or.inr (Or.inl ⟨h1, k2⟩)
    · exact Or.inl (r.trans h1 k2)
    · exact Or.inr (Or.inr ⟨h1, r.trans h2 k⟩)
    · exact Or.inl (r.trans h1 k2)
    · exact Or.inr (Or.inr ⟨h1, k2⟩)

/-- `r` with the pair `(a, b)` glued. -/
def glued : Setoid D := ⟨S r a b, S_equivalence r a b⟩

theorem card_le_glued_add_one :
    Nat.card (Quotient r) ≤ Nat.card (Quotient (glued r a b)) + 1 := by
  classical
  let f : Quotient r → Quotient (glued r a b) ⊕ Unit := fun q =>
    if q = Quotient.mk r b then Sum.inr () else
      Sum.inl (Quotient.map' id (fun x y h => Or.inl h) q)
  have hf : Function.Injective f := by
    intro q₁ q₂ hq
    induction q₁ using Quotient.inductionOn' with
    | h x =>
    induction q₂ using Quotient.inductionOn' with
    | h y =>
    simp only [f] at hq
    by_cases hx : (Quotient.mk'' x : Quotient r) = Quotient.mk r b <;>
      by_cases hy : (Quotient.mk'' y : Quotient r) = Quotient.mk r b
    · exact hx.trans hy.symm
    · rw [if_pos hx, if_neg hy] at hq; cases hq
    · rw [if_neg hx, if_pos hy] at hq; cases hq
    · rw [if_neg hx, if_neg hy] at hq
      have hS : S r a b x y := Quotient.exact' (Sum.inl_injective hq)
      rcases hS with h | ⟨_, h2⟩ | ⟨h1, _⟩
      · exact Quotient.sound' h
      · exact absurd (Quotient.sound (r.symm h2)) hy
      · exact absurd (Quotient.sound h1) hx
  have := Nat.card_le_card_of_injective f hf
  rwa [Nat.card_sum, Nat.card_eq_fintype_card (α := Unit), Fintype.card_unit] at this

theorem glued_eq_of_rel (hab : r a b) (x y : D) : S r a b x y ↔ r x y := by
  refine ⟨?_, Or.inl⟩
  rintro (h | ⟨h1, h2⟩ | ⟨h1, h2⟩)
  · exact h
  · exact r.trans h1 (r.trans hab h2)
  · exact r.trans h1 (r.trans (r.symm hab) h2)

end AddPair

/-- The relation generated by `step σ τ` and the pair `(a, b)` is `glued (orbitSetoid σ τ) a b`. -/
theorem eqvGen_plus_iff (σ τ : Perm D) (a b x y : D) :
    EqvGen (stepPlus σ τ a b) x y ↔ S (orbitSetoid σ τ) a b x y := by
  constructor
  · intro h
    induction h with
    | rel u v huv =>
      rcases huv with h | ⟨rfl, rfl⟩
      · exact Or.inl (EqvGen.rel _ _ h)
      · exact Or.inr (Or.inl ⟨EqvGen.refl _, EqvGen.refl _⟩)
    | refl u => exact (S_equivalence _ a b).refl u
    | symm u v _ ih => exact (S_equivalence _ a b).symm ih
    | trans u v w _ _ ih1 ih2 => exact (S_equivalence _ a b).trans ih1 ih2
  · have hmono : ∀ u v, EqvGen (step σ τ) u v → EqvGen (stepPlus σ τ a b) u v := fun u v h =>
      EqvGen.mono (fun _ _ k => Or.inl k) h
    have hab : EqvGen (stepPlus σ τ a b) a b := EqvGen.rel _ _ (Or.inr ⟨rfl, rfl⟩)
    rintro (h | ⟨h1, h2⟩ | ⟨h1, h2⟩)
    · exact hmono _ _ h
    · exact EqvGen.trans _ _ _ (hmono _ _ h1) (EqvGen.trans _ _ _ hab (hmono _ _ h2))
    · exact EqvGen.trans _ _ _ (hmono _ _ h1)
        (EqvGen.trans _ _ _ (EqvGen.symm _ _ hab) (hmono _ _ h2))

/-- Changing `τ` by a transposition does not change the relation once `(a, b)` is adjoined. -/
theorem plus_le (σ τ : Perm D) (a b u v : D)
    (h : stepPlus σ (τ * swap a b) a b u v) : EqvGen (stepPlus σ τ a b) u v := by
  have hab : EqvGen (stepPlus σ τ a b) a b := EqvGen.rel _ _ (Or.inr ⟨rfl, rfl⟩)
  have hτ : ∀ w, EqvGen (stepPlus σ τ a b) w (τ w) :=
    fun w => EqvGen.rel _ _ (Or.inl (Or.inr rfl))
  rcases h with (h | h) | ⟨rfl, rfl⟩
  · exact EqvGen.rel _ _ (Or.inl (Or.inl h))
  · subst h
    simp only [Perm.mul_apply]
    by_cases hua : u = a
    · subst hua; rw [swap_apply_left]; exact EqvGen.trans _ _ _ hab (hτ _)
    by_cases hub : u = b
    · subst hub; rw [swap_apply_right]
      exact EqvGen.trans _ _ _ (EqvGen.symm _ _ hab) (hτ _)
    rw [swap_apply_of_ne_of_ne hua hub]; exact hτ _
  · exact hab

theorem plus_eq (σ τ : Perm D) (a b x y : D) :
    EqvGen (stepPlus σ τ a b) x y ↔ EqvGen (stepPlus σ (τ * swap a b) a b) x y := by
  have hτ : (τ * swap a b) * swap a b = τ := by rw [mul_assoc, swap_mul_self, mul_one]
  constructor
  · intro h
    induction h with
    | rel u v k => exact plus_le σ (τ * swap a b) a b u v (by rwa [hτ])
    | refl u => exact EqvGen.refl _
    | symm u v _ ih => exact EqvGen.symm _ _ ih
    | trans u v w _ _ ih1 ih2 => exact EqvGen.trans _ _ _ ih1 ih2
  · intro h
    induction h with
    | rel u v k => exact plus_le σ τ a b u v k
    | refl u => exact EqvGen.refl _
    | symm u v _ ih => exact EqvGen.symm _ _ ih
    | trans u v w _ _ ih1 ih2 => exact EqvGen.trans _ _ _ ih1 ih2

/-! ### Cycles lie inside orbits -/

theorem orbit_pow_mul (σ τ : Perm D) (x : D) (n : ℕ) :
    orbitSetoid σ τ x (((σ * τ) ^ n) x) := by
  induction n with
  | zero => exact EqvGen.refl _
  | succ n ih =>
    rw [pow_succ', Perm.mul_apply, Perm.mul_apply]
    exact EqvGen.trans _ _ _ ih
      (EqvGen.trans _ _ _ (EqvGen.rel _ _ (Or.inr rfl)) (EqvGen.rel _ _ (Or.inl rfl)))

theorem sameCycle_mul {σ τ : Perm D} {x y : D} (h : (σ * τ).SameCycle x y) :
    orbitSetoid σ τ x y := by
  obtain ⟨n, -, rfl⟩ := h.exists_pow_eq'
  exact orbit_pow_mul σ τ x n

/-! ### The base case `τ = 1` -/

theorem orbits_one_ge (σ : Perm D) : numCycles σ ≤ orbits σ 1 := by
  unfold numCycles orbits
  refine card_quot_le_of_le (r := orbitSetoid σ 1) (s := SameCycle.setoid σ) ?_
  intro x y h
  induction h with
  | rel u v k =>
    rcases k with rfl | rfl
    · exact ⟨1, by simp⟩
    · exact SameCycle.refl _ _
  | refl u => exact SameCycle.refl _ _
  | symm u v _ ih => exact ih.symm
  | trans u v w _ _ ih1 ih2 => exact ih1.trans ih2

theorem numCycles_one : numCycles (1 : Perm D) = Fintype.card D := by
  unfold numCycles
  rw [← Nat.card_eq_fintype_card]
  refine (Nat.card_congr (Equiv.ofBijective (Quotient.mk (SameCycle.setoid 1)) ⟨?_, ?_⟩)).symm
  · intro x y hxy
    obtain ⟨i, hi⟩ := Quotient.exact hxy
    simpa using hi
  · intro q
    induction q using Quotient.inductionOn with
    | h x => exact ⟨x, rfl⟩

theorem numCycles_le (π : Perm D) : numCycles π ≤ Fintype.card D := by
  unfold numCycles
  rw [← Nat.card_eq_fintype_card]
  exact Nat.card_le_card_of_surjective (Quotient.mk _)
    (fun q => by induction q using Quotient.inductionOn with | h x => exact ⟨x, rfl⟩)

/-! ### Ree's inequality -/

theorem ree_inequality (σ τ : Perm D) :
    numCycles σ + numCycles τ + numCycles (σ * τ) ≤ Fintype.card D + 2 * orbits σ τ := by
  induction hk : Fintype.card D - numCycles τ using Nat.strong_induction_on generalizing τ with
  | _ k ih =>
  by_cases hτ : τ = 1
  · subst hτ
    have := orbits_one_ge σ
    rw [numCycles_one, mul_one]
    omega
  · obtain ⟨a, ha⟩ : ∃ a, τ a ≠ a := by
      by_contra hcon
      push_neg at hcon
      exact hτ (Perm.ext hcon)
    set b := τ a with hbdef
    have hab : a ≠ b := fun e => ha e.symm
    have hsame : τ.SameCycle a b := ⟨1, by simp [hbdef]⟩
    set τ' := τ * swap a b with hτ'
    have hc' : numCycles τ' = numCycles τ + 1 := numCycles_mul_swap_of_sameCycle τ hab hsame
    have hle' := numCycles_le τ'
    have hτeq : τ = τ' * swap a b := by rw [hτ', mul_assoc, swap_mul_self, mul_one]
    have ih' := ih (Fintype.card D - numCycles τ') (by omega) τ' rfl
    -- orbit comparison through the glued relation
    have hglue : Nat.card (Quotient (glued (orbitSetoid σ τ) a b)) =
        Nat.card (Quotient (glued (orbitSetoid σ τ') a b)) := by
      apply card_quot_eq_of_iff
      intro x y
      show S _ a b x y ↔ S _ a b x y
      rw [← eqvGen_plus_iff, ← eqvGen_plus_iff, hτ']
      exact plus_eq σ τ a b x y
    have hO_le : Nat.card (Quotient (glued (orbitSetoid σ τ) a b)) ≤ orbits σ τ :=
      card_quot_le_of_le fun x y h => Or.inl h
    have hO'_le := card_le_glued_add_one (orbitSetoid σ τ') a b
    have hst : σ * τ = (σ * τ') * swap a b := by rw [mul_assoc, ← hτeq]
    rw [hst]
    by_cases hsc : (σ * τ').SameCycle a b
    · have hc := numCycles_mul_swap_of_sameCycle (σ * τ') hab hsc
      have hrel : orbitSetoid σ τ' a b := sameCycle_mul hsc
      have hgl : Nat.card (Quotient (glued (orbitSetoid σ τ') a b)) = orbits σ τ' :=
        card_quot_eq_of_iff fun x y => glued_eq_of_rel _ a b hrel x y
      simp only [orbits] at *
      omega
    · have hc := numCycles_mul_swap_of_not_sameCycle (σ * τ') hsc
      simp only [orbits] at *
      omega

/-! ### Connected maps have genus `≥ 0` -/

/-- A combinatorial map `(σ, α)` with `α` a fixed-point-free involution and `⟨σ, α⟩`
transitive has `χ = c(σ) − c(α) + c(σα) ≤ 2`. -/
theorem map_euler_le_two (σ α : Perm D) (hinv : α * α = 1) (hfix : ∀ x, α x ≠ x)
    (hconn : orbits σ α = 1) :
    (numCycles σ : ℤ) - numCycles α + numCycles (σ * α) ≤ 2 := by
  have hree := ree_inequality σ α
  have hD := two_mul_numCycles_of_involution α hinv hfix
  rw [hconn] at hree
  omega

/-- **The genus of a connected map is a natural number.** -/
theorem exists_genus_nonneg (σ α : Perm D) (hinv : α * α = 1) (hfix : ∀ x, α x ≠ x)
    (hconn : orbits σ α = 1) :
    ∃ g : ℕ, (numCycles σ : ℤ) - numCycles α + numCycles (σ * α) = 2 - 2 * g := by
  obtain ⟨g, hg⟩ := exists_genus σ α hinv hfix
  have hle := map_euler_le_two σ α hinv hfix hconn
  refine ⟨g.toNat, ?_⟩
  rw [hg]
  have : 0 ≤ g := by omega
  rw [Int.toNat_of_nonneg this]

end QOU.RiemannSurface.MapGenusNonneg
