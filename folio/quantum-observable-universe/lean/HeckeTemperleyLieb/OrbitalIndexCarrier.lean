import Mathlib.Algebra.Polynomial.AlgebraMap
import Mathlib.Algebra.Module.LinearMap.End

/-!
# QOU.Hecke.OrbitalIndexCarrier — what a single interface letter can and cannot see of `ℓ`

Bean `qou-7zob` asks whether the braid / strand data of the two-nucleon Hecke
interface yields a **derived** orbital angular momentum `ℓ`, so that a
rank-2 spin-space coupling (the tensor operator, which mixes `³S₁` with `³D₁`)
has a carrier.

This file proves the structural half of the answer, over an arbitrary
commutative ring `R` and `R`-module `M` (AGENTS.md §7c — nothing archimedean is
used):

1. **Eigenvector transport** (`aeval_apply_of_eigen`, `aeval_mem_of_eigen`).
   If `v` is an eigenvector of an operator `σ` with eigenvalue `c`, then every
   polynomial `p(σ)` acts on `v` by the scalar `p(c)`, and therefore maps any
   submodule containing `v` into itself.  This is the full image of the
   two-strand Hecke algebra `R[σ]/((σ - q)(σ + q⁻¹))` on any module: it is
   generated by the one letter `σ`, so it is contained in `R[σ]`.

2. **Exchange sees only `ℓ mod 2`** (`exchange_even_same_scalar`).  The
   geometric reading of the transposition of two particles on their relative
   coordinate is inversion `r ↦ -r`, which acts on the orbital sector `ℓ` by
   `(-1)^ℓ`.  So `ℓ = 0` and `ℓ = 2` vectors lie in one eigenspace of the
   exchange, and **no** polynomial in the exchange separates them.

3. **Wigner lock** (`wigner_lock_same_scalar`).  If the combined spin-isospin
   exchange is the product `P_S * P_I` of two exchanges, the `³S₁` vector
   (eigenvalues `(+1, -1)`) and the `¹S₀` vector (`(-1, +1)`) are both
   eigenvectors of the combined exchange with eigenvalue `-1`, so every
   polynomial in the combined exchange acts on both by the same scalar.  This
   is the Wigner-`SU(4)` degeneracy of `qou-7zob`, stated without choosing a
   binding functional.

4. **A mixing operator is outside the single-letter algebra**
   (`OrbitalMixingSpec`, `mixing_not_in_letter_algebra`).  Any operator with a
   nonzero matrix element from an `ℓ = 0` eigenvector of `σ` into a direction
   that annihilates it — the minimal algebraic content of `³S₁ → ³D₁` mixing —
   is **not** a polynomial in `σ`.

`OrbitalMixingSpec` is a *specification*, not a conjecture: abstract
instances exist trivially in any module with two independent vectors.  What is
open is an instance whose mixing operator is **derived from braid data**; Lean
does not encode "derived from braid data", so that statement is not made here,
and this file supplies no instance.  Item 4 proves that such an instance, if
it exists, cannot take its mixing operator from the algebra generated by the
single interface letter.

Scope: these are statements about the algebra generated by **one** operator.
They say nothing about operators built from several letters on more strands,
from a second tensor factor, or from framing data; those remain open.

LaTeX label: none (library file).
-/

-- Ref: [kassel1995] Kassel, "Quantum Groups", GTM 155, Springer 1995, Ch. X (Hecke / braid representations)

namespace QOU.Hecke.OrbitalIndexCarrier

open Polynomial

variable {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]

/-- **Eigenvector transport.**  If `σ v = c • v` then `p(σ) v = p(c) • v` for
every polynomial `p`.  No nonzero or field hypothesis is needed. -/
theorem aeval_apply_of_eigen (σ : Module.End R M) {c : R} {v : M}
    (hv : σ v = c • v) (p : R[X]) :
    (aeval σ p) v = p.eval c • v := by
  induction p using Polynomial.induction_on with
  | C a =>
      simp [Module.algebraMap_end_apply]
  | add p r hp hr =>
      simp only [map_add, LinearMap.add_apply, eval_add, add_smul, hp, hr]
  | monomial n a ih =>
      have hpow : (aeval σ (C a * X ^ (n + 1))) v
          = σ ((aeval σ (C a * X ^ n)) v) := by
        rw [show (C a * X ^ (n + 1) : R[X]) = X * (C a * X ^ n) by ring,
          map_mul, aeval_X, Module.End.mul_apply]
      rw [hpow, ih, LinearMap.map_smul, hv, smul_smul]
      simp only [eval_mul, eval_C, eval_pow, eval_X, pow_succ]
      ring_nf

/-- **No transfer out of a submodule.**  If `v ∈ N` is an eigenvector of `σ`,
every polynomial in `σ` maps `v` back into `N`. -/
theorem aeval_mem_of_eigen (σ : Module.End R M) {c : R} {v : M}
    (hv : σ v = c • v) (N : Submodule R M) (hvN : v ∈ N) (p : R[X]) :
    (aeval σ p) v ∈ N := by
  rw [aeval_apply_of_eigen σ hv p]
  exact N.smul_mem _ hvN

/-- **Exchange parity of the orbital sector.**  The relative-coordinate
exchange acts on sector `ℓ` by `(-1)^ℓ`; sectors `ℓ` and `ℓ + 2` carry the same
sign. -/
theorem exchange_sign_period_two (ℓ : ℕ) :
    ((-1 : R) ^ (ℓ + 2)) = (-1 : R) ^ ℓ := by
  rw [pow_add]; simp

/-- **Exchange sees only `ℓ mod 2`.**  If the exchange `E` acts on a vector
`vS` of sector `ℓ` and a vector `vD` of sector `ℓ + 2` by the inversion signs
`(-1)^ℓ` and `(-1)^(ℓ+2)`, then every polynomial in `E` acts on both by the
same scalar `p((-1)^ℓ)`.  For `ℓ = 0`: no element of the algebra generated by
the exchange distinguishes an S-wave vector from a D-wave vector. -/
theorem exchange_even_same_scalar (E : Module.End R M) (ℓ : ℕ) {vS vD : M}
    (hS : E vS = (-1 : R) ^ ℓ • vS) (hD : E vD = (-1 : R) ^ (ℓ + 2) • vD)
    (p : R[X]) :
    (aeval E p) vS = p.eval ((-1 : R) ^ ℓ) • vS ∧
      (aeval E p) vD = p.eval ((-1 : R) ^ ℓ) • vD := by
  refine ⟨aeval_apply_of_eigen E hS p, ?_⟩
  rw [exchange_sign_period_two] at hD
  exact aeval_apply_of_eigen E hD p

/-- **Wigner lock.**  Let `PS`, `PI` be the spin and isospin exchanges and
`PS * PI` the combined exchange.  A `³S₁` vector (`PS = +1`, `PI = -1`) and a
`¹S₀` vector (`PS = -1`, `PI = +1`) are both `-1` eigenvectors of the combined
exchange, so every polynomial in it acts on both by `p(-1)`. -/
theorem wigner_lock_same_scalar (PS PI : Module.End R M) {vT vS : M}
    (hTs : PS vT = vT) (hTi : PI vT = (-1 : R) • vT)
    (hSs : PS vS = (-1 : R) • vS) (hSi : PI vS = vS) (p : R[X]) :
    (aeval (PS * PI) p) vT = p.eval (-1) • vT ∧
      (aeval (PS * PI) p) vS = p.eval (-1) • vS := by
  have hT : (PS * PI) vT = (-1 : R) • vT := by
    rw [Module.End.mul_apply, hTi, LinearMap.map_smul, hTs]
  have hS : (PS * PI) vS = (-1 : R) • vS := by
    rw [Module.End.mul_apply, hSi, hSs]
  exact ⟨aeval_apply_of_eigen _ hT p, aeval_apply_of_eigen _ hS p⟩

/-- **Specification of an orbital-mixing carrier** on a module `M` with an
interface letter `σ`.

* `vS` — the `ℓ = 0` vector, an eigenvector of the letter (eigenvalue `c`);
* `piD` — a linear functional reading the `ℓ = 2` component, which vanishes on
  `vS` (the S-wave vector has no D-wave component);
* `X` — the coupling, with a nonzero D-wave component of `X vS`.

This is a requirements structure, **not** a conjecture: abstract instances
exist in any module with two independent vectors.  The open question
(`qou-7zob`) is an instance whose `X` is derived from braid data; that is not
encoded here and no instance is provided. -/
structure OrbitalMixingSpec (σ : Module.End R M) where
  /-- The S-wave (`ℓ = 0`) vector. -/
  vS : M
  /-- Its eigenvalue under the interface letter. -/
  c : R
  /-- `vS` is an eigenvector of the letter. -/
  eigen : σ vS = c • vS
  /-- The functional reading the D-wave (`ℓ = 2`) component. -/
  piD : M →ₗ[R] R
  /-- The S-wave vector has no D-wave component. -/
  piD_vS : piD vS = 0
  /-- The coupling operator. -/
  X : Module.End R M
  /-- The coupling has a nonzero D-wave matrix element out of the S-wave. -/
  mixes : piD (X vS) ≠ 0

/-- **A mixing coupling is not in the single-letter algebra.**  For any
`OrbitalMixingSpec` over `σ`, the coupling `X` is not `p(σ)` for any polynomial
`p`.  In particular it is not in the image of the two-strand Hecke algebra
generated by `σ`. -/
theorem mixing_not_in_letter_algebra {σ : Module.End R M}
    (S : OrbitalMixingSpec σ) : ¬ ∃ p : R[X], S.X = aeval σ p := by
  rintro ⟨p, hp⟩
  apply S.mixes
  rw [hp, aeval_apply_of_eigen σ S.eigen p, LinearMap.map_smul, S.piD_vS,
    smul_zero]

end QOU.Hecke.OrbitalIndexCarrier
