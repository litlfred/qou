import HeckeTemperleyLieb.TLSemisimpleQuotient

/-!
# Cup–cap corners: Temperley–Lieb homs between strand numbers, and completeness of the simples

Bean `hkmt`. `TLSemisimpleQuotient` shows the vacuum and `p_0, …, p_{k−1}` survive
semisimplification and are pairwise distinct. This file proves that, on every level where the
trace form is nondegenerate, they are **all** the simple objects.

## Homs between strand numbers, inside one algebra

Let `g = e_{n+1}` be the top generator of `TL_{n+3}` and `E = δ⁻¹ g`. Diagrammatically
`g = cup ∘ cap` on the last two strands, so a morphism `n+1 → n+1` strands becomes, after
composing with the cap on top and the cup below, an element of the corner `E · TL_{n+3} · E`.
That corner therefore plays the role of `Hom(n+1, n+3) ∘ Hom(n+3, n+1)`, and the file works with
it directly instead of building a rectangular diagram category:

* `capEmb a = δ⁻¹ · ι²(a) · g`, a multiplicative map `TL_{n+1} → TL_{n+3}` with `capEmb 1 = E`
  (`capEmb_mul`, `capEmb_one`);
* `corner_surj`: every `E z E` is `capEmb c` (from Jones' lemma, `sup_eq_top`);
* `capEmb_inj`: `capEmb` is injective when the trace form on `TL_{n+1}` is nondegenerate, since
  `τ(capEmb a) = δ⁻¹ ε τ(a)`.

So `capEmb` is an algebra isomorphism `TL_{n+1} ≅ E · TL_{n+3} · E` on nondegenerate levels.

## Isomorphism of objects

An object of the Karoubi envelope is an idempotent; two idempotents `f`, `g` of one algebra are
isomorphic objects iff they are **Murray–von Neumann equivalent**: `f = a b`, `g = b a` with
`a ∈ f A g`, `b ∈ g A f` (`MvN`). A **simple** object is an idempotent `f ≠ 0` with
`f A f = K f` (`IsSimpleIdem`).

## Completeness

`Std N s` is the inductive list of standard objects on `N + 1` strands: `p_N`, the vacuum on two
strands `E = δ⁻¹ e_0`, and `capEmb` of a standard object two strands down.

* `simple_mvn_std`: if `δε = 1`, `p_m` is defined for `m ≤ N`, and the form is nondegenerate on
  every level `m ≤ N`, then **every simple idempotent of `TL_{N+1}` is equivalent to a standard
  one**. The proof: `p_N` is central, so a simple `f` is `p_N` or lies in the ideal of the `e_i`;
  that ideal is the ideal of the top `e`; a simple idempotent in the ideal of `E` is equivalent
  to an idempotent of the corner `E A E` (`exists_mvn_corner`); the corner is `capEmb` of the
  level two down; induct.
* `isSimpleIdem_jw`: `p_N` is simple, so the hypothesis is met.
* `simple_mvn_std_root`: at a primitive `2(k+2)`-th root of unity this holds for every
  `N + 1 ≤ k`. The standard objects there are the vacuum and `p_m` with `m ≤ N < k`, with cups.

Not proved here:

* the same statement on `k + 1` or more strands, where the form is degenerate and the statement
  must be made in the quotient by negligible morphisms;
* the rectangular hom spaces themselves. The corner isomorphism stands in for "`capEmb s` on
  `N + 3` strands is isomorphic to `s` on `N + 1` strands"; stating that as an isomorphism needs
  `Hom(m, n)` for `m ≠ n`.

No empirical input; everything is over an arbitrary field.

-- Ref: [jones1983] Index for subfactors, §4 (the basic construction and `e x e = E(x) e`).
-- Ref: [leitner2026] the Temperley–Lieb chapter (bean `hkmt`).
-/

namespace QOU.HeckeTemperleyLieb.TLCupCap

open QOU.MathlibExt.TemperleyLieb QOU.MathlibExt.TemperleyLiebMarkov
open QOU.HeckeTemperleyLieb.TLCable QOU.HeckeTemperleyLieb.TLSemisimpleQuotient


/-! ## Idempotents in an algebra -/

section Idem

variable (K : Type*) {A : Type*} [Field K] [Ring A] [Algebra K A]

/-- The two-sided ideal generated by `z`, as a `K`-span. -/
def J (z : A) : Submodule K A := Submodule.span K {y | ∃ a b, y = a * z * b}

/-- A **simple object**: a nonzero idempotent whose corner algebra is the scalars. -/
def IsSimpleIdem (f : A) : Prop :=
  f * f = f ∧ f ≠ 0 ∧ ∀ x, ∃ c : K, f * x * f = c • f

variable {K}

theorem J_self (z : A) : z ∈ J K z :=
  Submodule.subset_span ⟨1, 1, by simp⟩

theorem J_mul_left (z c : A) {y : A} (hy : y ∈ J K z) : c * y ∈ J K z := by
  induction hy using Submodule.span_induction with
  | mem w hw =>
    obtain ⟨a, b, rfl⟩ := hw; exact Submodule.subset_span ⟨c * a, b, by simp [mul_assoc]⟩
  | zero => simp
  | add a b _ _ ha hb => rw [mul_add]; exact Submodule.add_mem _ ha hb
  | smul r a _ ha => rw [mul_smul_comm]; exact Submodule.smul_mem _ _ ha

theorem J_mul_right (z c : A) {y : A} (hy : y ∈ J K z) : y * c ∈ J K z := by
  induction hy using Submodule.span_induction with
  | mem w hw =>
    obtain ⟨a, b, rfl⟩ := hw; exact Submodule.subset_span ⟨a, b * c, by simp [mul_assoc]⟩
  | zero => simp
  | add a b _ _ ha hb => rw [add_mul]; exact Submodule.add_mem _ ha hb
  | smul r a _ ha => rw [smul_mul_assoc]; exact Submodule.smul_mem _ _ ha

theorem J_trans {z w y : A} (hw : w ∈ J K z) (hy : y ∈ J K w) : y ∈ J K z := by
  induction hy using Submodule.span_induction with
  | mem u hu => obtain ⟨a, b, rfl⟩ := hu; exact J_mul_right z b (J_mul_left z a hw)
  | zero => simp
  | add a b _ _ ha hb => exact Submodule.add_mem _ ha hb
  | smul r a _ ha => exact Submodule.smul_mem _ _ ha

theorem J_smul {z y : A} {c : K} (hc : c ≠ 0) (hy : y ∈ J K z) : y ∈ J K (c • z) := by
  refine J_trans ?_ hy
  refine Submodule.subset_span ⟨c⁻¹ • 1, 1, ?_⟩
  rw [smul_mul_assoc, one_mul, mul_one, smul_smul, inv_mul_cancel₀ hc, one_smul]

/-- **Isomorphism of objects**: Murray–von Neumann equivalence of idempotents. -/
def MvN (f g : A) : Prop :=
  f * f = f ∧ g * g = g ∧
    ∃ a b : A, f * a * g = a ∧ g * b * f = b ∧ a * b = f ∧ b * a = g

theorem MvN.refl {f : A} (hf : f * f = f) : MvN f f :=
  ⟨hf, hf, f, f, by rw [hf, hf], by rw [hf, hf], hf, hf⟩

theorem MvN.symm {f g : A} (h : MvN f g) : MvN g f := by
  obtain ⟨hf, hg, a, b, ha, hb, hab, hba⟩ := h
  exact ⟨hg, hf, b, a, hb, ha, hba, hab⟩

theorem left_absorb {f a g : A} (hf : f * f = f) (ha : f * a * g = a) : f * a = a := by
  calc f * a = f * (f * a * g) := by rw [ha]
    _ = a := by rw [← mul_assoc, ← mul_assoc, hf, ha]

theorem right_absorb {f a g : A} (hg : g * g = g) (ha : f * a * g = a) : a * g = a := by
  calc a * g = f * a * g * g := by rw [ha]
    _ = a := by rw [mul_assoc, hg, ha]

theorem MvN.trans {f g h : A} (h1 : MvN f g) (h2 : MvN g h) : MvN f h := by
  obtain ⟨hf, hg, a, b, ha, hb, hab, hba⟩ := h1
  obtain ⟨-, hh, c, d, hc, hd, hcd, hdc⟩ := h2
  have fa := left_absorb hf ha
  have ch := right_absorb hh hc
  have hd' := left_absorb hh hd
  have bf := right_absorb hf hb
  have gb := left_absorb hg hb
  have gc := left_absorb hg hc
  refine ⟨hf, hh, a * c, d * b, ?_, ?_, ?_, ?_⟩
  · rw [← mul_assoc, fa, mul_assoc, ch]
  · rw [← mul_assoc, hd', mul_assoc, bf]
  · rw [mul_assoc, ← mul_assoc c, hcd, gb, hab]
  · rw [mul_assoc, ← mul_assoc b, hba, gc, hdc]

theorem eq_of_smul_idem {E g : A} {d : K} (hg : g * g = g) (hg0 : g ≠ 0) (hE : E * E = E)
    (h : g = d • E) : g = E := by
  have hE0 : E ≠ 0 := by rintro rfl; rw [smul_zero] at h; exact hg0 h
  have h2 : (d * d) • E = d • E := by
    have := hg; rw [h, smul_mul_smul_comm, hE] at this; exact this
  have h3 : (d * (d - 1)) • E = 0 := by rw [mul_sub, mul_one, sub_smul, h2, sub_self]
  rcases smul_eq_zero.mp h3 with h4 | h4
  · rcases mul_eq_zero.mp h4 with h5 | h5
    · rw [h5, zero_smul] at h; exact absurd h hg0
    · rw [h, sub_eq_zero.mp h5, one_smul]
  · exact absurd h4 hE0

/-- **A simple idempotent in the ideal of `E` is equivalent to one in the corner `E A E`.** -/
theorem exists_mvn_corner {f E : A} (hf : IsSimpleIdem K f) (hE : E * E = E) (hfE : f ∈ J K E) :
    ∃ g, MvN f g ∧ E * g * E = g := by
  obtain ⟨hf1, hf0, hfc⟩ := hf
  have key : ∃ a b : A, f * (a * E * b) * f ≠ 0 := by
    by_contra hcon
    push_neg at hcon
    have hall : ∀ u ∈ J K E, f * u * f = 0 := by
      intro u hu
      induction hu using Submodule.span_induction with
      | mem w hw => obtain ⟨a, b, rfl⟩ := hw; exact hcon a b
      | zero => simp
      | add a b _ _ ha hb => rw [mul_add, add_mul, ha, hb, add_zero]
      | smul r a _ ha => rw [mul_smul_comm, smul_mul_assoc, ha, smul_zero]
    apply hf0
    have := hall f hfE
    rwa [hf1, hf1] at this
  obtain ⟨a, b, hne⟩ := key
  obtain ⟨c, hc⟩ := hfc (a * E * b)
  have hc0 : c ≠ 0 := by rintro rfl; rw [zero_smul] at hc; exact hne hc
  obtain ⟨x, hx⟩ : ∃ x, x = E * b * f := ⟨_, rfl⟩
  obtain ⟨y, hy⟩ : ∃ y, y = c⁻¹ • (f * a * E) := ⟨_, rfl⟩
  have hyx : y * x = f := by
    rw [hy, hx, smul_mul_assoc]
    have : f * a * E * (E * b * f) = f * (a * E * b) * f := by
      simp only [mul_assoc]; rw [← mul_assoc E E, hE]
    rw [this, hc, smul_smul, inv_mul_cancel₀ hc0, one_smul]
  have fy : f * y = y := by rw [hy, mul_smul_comm]; simp only [← mul_assoc, hf1]
  have xf : x * f = x := by rw [hx, mul_assoc, hf1]
  have Ex : E * x = x := by rw [hx, ← mul_assoc, ← mul_assoc, hE]
  have yE : y * E = y := by rw [hy, smul_mul_assoc, mul_assoc, hE]
  have yxy : y * (x * y) = y := by rw [← mul_assoc, hyx, fy]
  have xyx : x * y * x = x := by rw [mul_assoc, hyx, xf]
  have hgg : x * y * (x * y) = x * y := by rw [← mul_assoc, xyx]
  refine ⟨x * y, ⟨hf1, hgg, y, x, ?_, ?_, hyx, rfl⟩, ?_⟩
  · rw [fy, yxy]
  · rw [xyx, xf]
  · rw [← mul_assoc, Ex, mul_assoc, yE]

/-- Simplicity is invariant under equivalence. -/
theorem IsSimpleIdem.of_mvn {f g : A} (hf : IsSimpleIdem K f) (h : MvN f g) :
    IsSimpleIdem K g := by
  obtain ⟨hf1, hf0, hfc⟩ := hf
  obtain ⟨-, hg, a, b, ha, hb, hab, hba⟩ := h
  refine ⟨hg, ?_, fun z => ?_⟩
  · rintro rfl
    apply hf0
    rw [← hab, ← hb]; simp
  · obtain ⟨c, hc⟩ := hfc (a * z * b)
    refine ⟨c, ?_⟩
    have e1 : a * z * b = f * (a * z * b) * f := by
      rw [show f * (a * z * b) * f = (f * a) * z * (b * f) by simp only [mul_assoc],
        left_absorb hf1 ha, right_absorb hf1 hb]
    calc g * z * g = b * (a * z * b) * a := by rw [← hba]; simp only [mul_assoc]
      _ = b * (c • f) * a := by rw [e1, hc]
      _ = c • g := by rw [mul_smul_comm, smul_mul_assoc, right_absorb hf1 hb, hba]

end Idem

/-! ## The cup–cap corner -/

section Tower

variable {K : Type*} [Field K] (δ : K)

/-- `e_{n+1} ι(b) e_{n+1} = ι²(c) e_{n+1}`: the top generator absorbs one level and lands two
levels down. -/
theorem absorb (n : ℕ) (b : TLFin K δ (n + 1)) : ∃ c : TLFin K δ n,
    e K δ adjFin (Fin.last (n + 1)) * incl δ (n + 1) b * e K δ adjFin (Fin.last (n + 1)) =
      incl δ (n + 1) (incl δ n c) * e K δ adjFin (Fin.last (n + 1)) := by
  have hb : b ∈ LinearMap.range (incl δ n).toLinearMap ⊔ JJ δ n := by
    rw [sup_eq_top δ n (hProp δ n)]; exact Submodule.mem_top
  obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp hb
  obtain ⟨c, rfl⟩ := hy
  clear hb
  set g := e K δ adjFin (Fin.last (n + 1))
  have hJ : ∀ w ∈ JJ δ n, ∃ w' : TLFin K δ n,
      g * incl δ (n + 1) w * g = incl δ (n + 1) (incl δ n w') * g := by
    intro w hw
    induction hw using Submodule.span_induction with
    | mem w hw =>
      obtain ⟨a, b, rfl⟩ := hw
      refine ⟨a * b, ?_⟩
      have ha := (incl_incl_commute δ n a).eq
      have hb := (incl_incl_commute δ n b).eq
      simp only [map_mul, incl_e]
      calc g * (incl δ (n + 1) (incl δ n a) * e K δ adjFin (Fin.castSucc (Fin.last n))
              * incl δ (n + 1) (incl δ n b)) * g
          = incl δ (n + 1) (incl δ n a) * (g * e K δ adjFin (Fin.castSucc (Fin.last n)) * g)
              * incl δ (n + 1) (incl δ n b) := by
            simp only [mul_assoc]; rw [← mul_assoc g, ← ha, mul_assoc, hb]
        _ = incl δ (n + 1) (incl δ n a) * incl δ (n + 1) (incl δ n b) * g := by
            rw [last_adj, mul_assoc, ← hb, ← mul_assoc]
    | zero => exact ⟨0, by simp⟩
    | add a b _ _ ha hb =>
      obtain ⟨a', ha'⟩ := ha; obtain ⟨b', hb'⟩ := hb
      exact ⟨a' + b', by rw [map_add, mul_add, add_mul, ha', hb', map_add, map_add, add_mul]⟩
    | smul r a _ ha =>
      obtain ⟨a', ha'⟩ := ha
      exact ⟨r • a', by rw [map_smul, mul_smul_comm, smul_mul_assoc, ha', map_smul, map_smul,
        smul_mul_assoc]⟩
  obtain ⟨w', hw'⟩ := hJ z hz
  refine ⟨δ • c + w', ?_⟩
  simp only [AlgHom.toLinearMap_apply]
  rw [map_add, mul_add, add_mul, hw', ← (incl_incl_commute δ n c).eq, mul_assoc, e_sq',
    mul_smul_comm, map_add, map_add, add_mul, map_smul, map_smul, smul_mul_assoc]

/-- **Jones' corner lemma.** `e_{n+1} z e_{n+1} = ι²(c) e_{n+1}` for every `z ∈ TL_{n+3}`. -/
theorem corner (n : ℕ) (z : TLFin K δ (n + 1 + 1)) : ∃ c : TLFin K δ n,
    e K δ adjFin (Fin.last (n + 1)) * z * e K δ adjFin (Fin.last (n + 1)) =
      incl δ (n + 1) (incl δ n c) * e K δ adjFin (Fin.last (n + 1)) := by
  have hz : z ∈ LinearMap.range (incl δ (n + 1)).toLinearMap ⊔ JJ δ (n + 1) := by
    rw [sup_eq_top δ (n + 1) (hProp δ (n + 1))]; exact Submodule.mem_top
  obtain ⟨y, hy, w, hw, rfl⟩ := Submodule.mem_sup.mp hz
  obtain ⟨b, rfl⟩ := hy
  clear hz
  have hJ : ∀ w ∈ JJ δ (n + 1), ∃ c : TLFin K δ n,
      e K δ adjFin (Fin.last (n + 1)) * w * e K δ adjFin (Fin.last (n + 1)) =
        incl δ (n + 1) (incl δ n c) * e K δ adjFin (Fin.last (n + 1)) := by
    intro w hw
    induction hw using Submodule.span_induction with
    | mem w hw =>
      obtain ⟨a, b, rfl⟩ := hw
      obtain ⟨ca, hca⟩ := absorb δ n a
      obtain ⟨cb, hcb⟩ := absorb δ n b
      refine ⟨ca * cb, ?_⟩
      calc e K δ adjFin (Fin.last (n + 1)) * (incl δ (n + 1) a * e K δ adjFin (Fin.last (n + 1)) * incl δ (n + 1) b) *
            e K δ adjFin (Fin.last (n + 1))
          = (e K δ adjFin (Fin.last (n + 1)) * incl δ (n + 1) a * e K δ adjFin (Fin.last (n + 1))) *
              (incl δ (n + 1) b * e K δ adjFin (Fin.last (n + 1))) := by simp only [mul_assoc]
        _ = incl δ (n + 1) (incl δ n ca) *
              (e K δ adjFin (Fin.last (n + 1)) * incl δ (n + 1) b * e K δ adjFin (Fin.last (n + 1))) := by
            rw [hca]; simp only [mul_assoc]
        _ = incl δ (n + 1) (incl δ n (ca * cb)) * e K δ adjFin (Fin.last (n + 1)) := by
            rw [hcb, map_mul, map_mul, mul_assoc]
    | zero => exact ⟨0, by simp⟩
    | add a b _ _ ha hb =>
      obtain ⟨a', ha'⟩ := ha; obtain ⟨b', hb'⟩ := hb
      exact ⟨a' + b', by rw [mul_add, add_mul, ha', hb', map_add, map_add, add_mul]⟩
    | smul r a _ ha =>
      obtain ⟨a', ha'⟩ := ha
      exact ⟨r • a', by rw [mul_smul_comm, smul_mul_assoc, ha', map_smul, map_smul,
        smul_mul_assoc]⟩
  obtain ⟨cb, hcb⟩ := absorb δ n b
  obtain ⟨cw, hcw⟩ := hJ w hw
  refine ⟨cb + cw, ?_⟩
  simp only [AlgHom.toLinearMap_apply]
  rw [mul_add, add_mul, hcb, hcw, map_add, map_add, add_mul]

/-- **The cup map** `TL_{n+1} → TL_{n+3}`, `a ↦ δ⁻¹ · ι²(a) · e_{n+1}`. -/
noncomputable def capEmb (n : ℕ) (a : TLFin K δ n) : TLFin K δ (n + 1 + 1) :=
  δ⁻¹ • (incl δ (n + 1) (incl δ n a) * e K δ adjFin (Fin.last (n + 1)))

theorem capEmb_mul (hδ : δ ≠ 0) (n : ℕ) (a b : TLFin K δ n) :
    capEmb δ n (a * b) = capEmb δ n a * capEmb δ n b := by
  set g := e K δ adjFin (Fin.last (n + 1))
  have hc := (incl_incl_commute δ n b).eq
  have hgg : g * g = δ • g := e_sq' δ _
  have h : incl δ (n + 1) (incl δ n a) * g * (incl δ (n + 1) (incl δ n b) * g) =
      δ • (incl δ (n + 1) (incl δ n a) * incl δ (n + 1) (incl δ n b) * g) := by
    rw [hc, ← mul_assoc, mul_assoc _ g g, hgg, mul_smul_comm, smul_mul_assoc, mul_assoc _ g,
      ← hc, ← mul_assoc]
  unfold capEmb
  rw [smul_mul_smul_comm, h, smul_smul, map_mul, map_mul]
  congr 1
  field_simp

theorem capEmb_add (n : ℕ) (a b : TLFin K δ n) :
    capEmb δ n (a + b) = capEmb δ n a + capEmb δ n b := by
  unfold capEmb; rw [map_add, map_add, add_mul, smul_add]

theorem capEmb_smul (n : ℕ) (c : K) (a : TLFin K δ n) :
    capEmb δ n (c • a) = c • capEmb δ n a := by
  unfold capEmb; rw [map_smul, map_smul, smul_mul_assoc, smul_comm]

theorem capEmb_zero (n : ℕ) : capEmb δ n 0 = 0 := by
  simpa using capEmb_smul δ n 0 0

theorem capEmb_one (n : ℕ) :
    capEmb δ n 1 = δ⁻¹ • e K δ adjFin (Fin.last (n + 1)) := by
  unfold capEmb; rw [map_one, map_one, one_mul]

theorem capEmb_one_idem (hδ : δ ≠ 0) (n : ℕ) : capEmb δ n 1 * capEmb δ n 1 = capEmb δ n 1 := by
  rw [← capEmb_mul δ hδ, mul_one]

/-- **The corner is the image of the cup map.** -/
theorem corner_surj (n : ℕ) (z : TLFin K δ (n + 1 + 1)) :
    ∃ c, capEmb δ n 1 * z * capEmb δ n 1 = capEmb δ n c := by
  obtain ⟨c, hc⟩ := corner δ n z
  refine ⟨δ⁻¹ • c, ?_⟩
  rw [capEmb_one, smul_mul_assoc, smul_mul_smul_comm, hc]
  unfold capEmb
  rw [map_smul, map_smul, smul_mul_assoc, smul_smul]

/-- The ideal of the `e_i` is the ideal of the top generator. -/
theorem e_mem_J_last (m : ℕ) (i : Fin (m + 1)) :
    e K δ adjFin i ∈ J K (e K δ adjFin (Fin.last m)) := by
  suffices h : ∀ d (i : Fin (m + 1)), i.val + d = m →
      e K δ adjFin i ∈ J K (e K δ adjFin (Fin.last m)) by
    exact h (m - i.val) i (by omega)
  intro d
  induction d with
  | zero =>
    intro i hi
    have : i = Fin.last m := Fin.ext (by simp; omega)
    rw [this]; exact J_self _
  | succ d ih =>
    intro i hi
    have hj : i.val + 1 < m + 1 := by omega
    refine J_trans (ih ⟨i.val + 1, hj⟩ (by simp; omega)) ?_
    refine Submodule.subset_span ⟨e K δ adjFin i, e K δ adjFin i, ?_⟩
    exact (e_adjacent_fin (Or.inl rfl)).symm

theorem genIdeal_le_J (m : ℕ) {u : TLFin K δ (m + 1)} (hu : u ∈ genIdeal K δ adjFin) :
    u ∈ J K (e K δ adjFin (Fin.last m)) := by
  induction hu using Submodule.span_induction with
  | mem w hw =>
    obtain ⟨a, b, i, rfl⟩ := hw
    exact J_mul_right _ b (J_mul_left _ a (e_mem_J_last δ m i))
  | zero => exact Submodule.zero_mem _
  | add a b _ _ ha hb => exact Submodule.add_mem _ ha hb
  | smul r a _ ha => exact Submodule.smul_mem _ _ ha

/-- Level `0` is the scalars. -/
theorem level_zero (y : TLFin K δ 0) : y = augmentation K δ adjFin y • 1 := by
  simpa using mul_eq_aug_smul (p := (1 : TLFin K δ 0)) (fun i => i.elim0) y

/-- The corner of `e_0` in `TL_2` is the scalars. -/
theorem corner_one (z : TLFin K δ 1) :
    ∃ c : K, e K δ adjFin (Fin.last 0) * z * e K δ adjFin (Fin.last 0) =
      c • e K δ adjFin (Fin.last 0) := by
  obtain ⟨w, hw⟩ := exists_last_mul_eq δ 0 z
  obtain ⟨w', -, hw'⟩ := hProp δ 0 w
  refine ⟨augmentation K δ adjFin w', ?_⟩
  have h1 : incl δ 0 w' = augmentation K δ adjFin w' • 1 := by
    conv_lhs => rw [level_zero δ w']
    rw [map_smul, map_one]
  rw [hw, hw', h1, smul_mul_assoc, one_mul]

/-- `p_N` is a simple object (the hypothesis of `simple_mvn_std` is met). -/
theorem isSimpleIdem_jw {N : ℕ} (hS : JWSpec δ N) : IsSimpleIdem K (jw δ N) :=
  ⟨hS.2.2.1, jw_ne_zero δ N, fun x => ⟨augmentation K δ adjFin x, jw_corner hS x⟩⟩

/-- **The central split.** A simple idempotent is `p_N` or is killed by it. -/
theorem split {N : ℕ} (hS : JWSpec δ N) {f : TLFin K δ N} (hf : IsSimpleIdem K f) :
    f = jw δ N ∨ f * jw δ N = 0 := by
  have hfp : f * jw δ N = augmentation K δ adjFin f • jw δ N := mul_eq_aug_smul_left hS.2.1 f
  have hpf : jw δ N * f = augmentation K δ adjFin f • jw δ N := mul_eq_aug_smul hS.1 f
  have haug : augmentation K δ adjFin f * (augmentation K δ adjFin f - 1) = 0 := by
    rw [mul_sub, ← map_mul, hf.1, mul_one, sub_self]
  rcases mul_eq_zero.mp haug with h0 | h1
  · right; rw [hfp, h0, zero_smul]
  · left
    rw [sub_eq_zero.mp h1, one_smul] at hfp hpf
    obtain ⟨c, hc⟩ := hf.2.2 (jw δ N)
    rw [hfp, hpf] at hc
    exact (eq_of_smul_idem hS.2.2.1 (jw_ne_zero δ N) hf.1 hc).symm

/-- **The standard objects** on `N + 1` strands: `p_N`, the vacuum `δ⁻¹ e_0` on two strands, and
the cup of a standard object two strands down. -/
inductive Std : (N : ℕ) → TLFin K δ N → Prop
  | jw (N : ℕ) : Std N (jw δ N)
  | vac : Std 1 (δ⁻¹ • e K δ adjFin (Fin.last 0))
  | cap {n : ℕ} {s : TLFin K δ n} : Std n s → Std (n + 1 + 1) (capEmb δ n s)

theorem mvn_capEmb (hδ : δ ≠ 0) {n : ℕ} {f s : TLFin K δ n} (h : MvN f s) :
    MvN (capEmb δ n f) (capEmb δ n s) := by
  obtain ⟨hf, hs, a, b, ha, hb, hab, hba⟩ := h
  refine ⟨by rw [← capEmb_mul δ hδ, hf], by rw [← capEmb_mul δ hδ, hs], capEmb δ n a,
    capEmb δ n b, ?_, ?_, ?_, ?_⟩
  · rw [← capEmb_mul δ hδ, ← capEmb_mul δ hδ, ha]
  · rw [← capEmb_mul δ hδ, ← capEmb_mul δ hδ, hb]
  · rw [← capEmb_mul δ hδ, hab]
  · rw [← capEmb_mul δ hδ, hba]

end Tower

/-! ## The trace makes the cup map injective; completeness -/

section Markov

variable {K : Type*} [Field K] {δ ε : K} (T : MarkovTower δ ε)

theorem tau_capEmb (n : ℕ) (a : TLFin K δ n) :
    T.τ (n + 1 + 1) (capEmb δ n a) = δ⁻¹ * (ε * T.τ n a) := by
  unfold capEmb
  rw [map_smul, T.tr_markov, T.tr_incl, smul_eq_mul]

/-- **The cup map is injective on a nondegenerate level.** -/
theorem capEmb_inj (hε : δ * ε = 1) {n : ℕ} (hnd : Nondegenerate T n) {a b : TLFin K δ n}
    (h : capEmb δ n a = capEmb δ n b) : a = b := by
  have hδ : δ ≠ 0 := left_ne_zero_of_mul_eq_one hε
  have hε0 : ε ≠ 0 := right_ne_zero_of_mul_eq_one hε
  rw [← sub_eq_zero]
  apply hnd
  intro y
  have h0 : capEmb δ n ((a - b) * y) = 0 := by
    rw [capEmb_mul δ hδ, sub_eq_add_neg, ← neg_one_smul K b, capEmb_add, capEmb_smul, ← h,
      neg_one_smul, add_neg_cancel, zero_mul]
  have := tau_capEmb T n ((a - b) * y)
  rw [h0, map_zero] at this
  rcases mul_eq_zero.mp this.symm with h1 | h1
  · exact absurd h1 (inv_ne_zero hδ)
  · exact (mul_eq_zero.mp h1).resolve_left hε0

/-- **Completeness of the simples on nondegenerate levels.** If `δε = 1`, the projectors `p_m`
are defined and the trace form is nondegenerate for every `m ≤ N`, then every simple idempotent
of `TL_{N+1}` is equivalent to a standard one. -/
theorem simple_mvn_std (hε : δ * ε = 1) (N : ℕ) (hS : ∀ m ≤ N, JWSpec δ m)
    (hnd : ∀ m ≤ N, Nondegenerate T m) (f : TLFin K δ N) (hf : IsSimpleIdem K f) :
    ∃ s, Std δ N s ∧ MvN f s := by
  have hδ : δ ≠ 0 := left_ne_zero_of_mul_eq_one hε
  induction N using Nat.strong_induction_on with
  | _ N ih =>
  rcases split δ (hS N le_rfl) hf with hfp | hfp
  · exact ⟨_, Std.jw N, hfp ▸ MvN.refl hf.1⟩
  have hf1 : f = f * (1 - jw δ N) := by rw [mul_sub, mul_one, hfp, sub_zero]
  rcases N with _ | _ | n
  · exfalso; apply hf.2.1; rw [hf1]; simp [jw]
  · -- two strands: the vacuum
    have hJ : f ∈ J K (δ⁻¹ • e K δ adjFin (Fin.last 0)) := by
      rw [hf1]
      exact J_smul (inv_ne_zero hδ)
        (J_mul_left _ _ (genIdeal_le_J δ 0 (hS 1 le_rfl).2.2.2.1))
    have hE : (δ⁻¹ • e K δ adjFin (Fin.last 0)) * (δ⁻¹ • e K δ adjFin (Fin.last 0)) =
        δ⁻¹ • e K δ adjFin (Fin.last 0) := by
      rw [smul_mul_smul_comm, e_sq', smul_smul, mul_assoc, inv_mul_cancel₀ hδ, mul_one]
    obtain ⟨g, hfg, hgE⟩ := exists_mvn_corner hf hE hJ
    have hgs := IsSimpleIdem.of_mvn hf hfg
    obtain ⟨c, hc⟩ := corner_one δ g
    have hg : g = (δ⁻¹ * c) • (δ⁻¹ • e K δ adjFin (Fin.last 0)) := by
      rw [← hgE, smul_mul_assoc, smul_mul_smul_comm, hc, smul_smul, smul_smul]
      congr 1; ring
    exact ⟨_, Std.vac, hfg.trans
      (eq_of_smul_idem hgs.1 hgs.2.1 hE hg ▸ MvN.refl hgs.1)⟩
  · -- `n + 3` strands: through the cup–cap corner
    have hJ : f ∈ J K (capEmb δ n 1) := by
      rw [capEmb_one, hf1]
      exact J_smul (inv_ne_zero hδ)
        (J_mul_left _ _ (genIdeal_le_J δ (n + 1) (hS (n + 2) le_rfl).2.2.2.1))
    obtain ⟨g, hfg, hgE⟩ := exists_mvn_corner hf (capEmb_one_idem δ hδ n) hJ
    have hgs := IsSimpleIdem.of_mvn hf hfg
    obtain ⟨h, hh⟩ := corner_surj δ n g
    rw [hgE] at hh
    have hndn := hnd n (by omega)
    have hhs : IsSimpleIdem K h := by
      refine ⟨capEmb_inj T hε hndn ?_, ?_, fun x => ?_⟩
      · rw [capEmb_mul δ hδ, ← hh, hgs.1]
      · rintro rfl; rw [capEmb_zero] at hh; exact hgs.2.1 hh
      · obtain ⟨c, hc⟩ := hgs.2.2 (capEmb δ n x)
        refine ⟨c, capEmb_inj T hε hndn ?_⟩
        rw [capEmb_mul δ hδ, capEmb_mul δ hδ, ← hh, hc, capEmb_smul, ← hh]
    obtain ⟨s, hs, hhs'⟩ := ih n (by omega) (fun m hm => hS m (by omega))
      (fun m hm => hnd m (by omega)) h hhs
    exact ⟨_, Std.cap hs, hfg.trans (hh ▸ mvn_capEmb δ hδ hhs')⟩

/-- **At a root of unity, every simple object on fewer than `k + 1` strands is standard.**
At a primitive `2(k+2)`-th root `ζ`, `δ = ζ + ζ⁻¹`, every simple idempotent of `TL_{N+1}` with
`N + 1 ≤ k` is equivalent to the vacuum or to some `p_m`, `m ≤ N`, with cups. -/
theorem simple_mvn_std_root {ζ : Kˣ} (k : ℕ) (hζ : IsPrimitiveRoot ζ (2 * (k + 2))) {ε : K}
    (T : MarkovTower ((ζ : K) + ((ζ⁻¹ : Kˣ) : K)) ε)
    (hε : ((ζ : K) + ((ζ⁻¹ : Kˣ) : K)) * ε = 1) {N : ℕ} (hN : N + 1 ≤ k)
    (f : TLFin K ((ζ : K) + ((ζ⁻¹ : Kˣ) : K)) N) (hf : IsSimpleIdem K f) :
    ∃ s, Std ((ζ : K) + ((ζ⁻¹ : Kˣ) : K)) N s ∧ MvN f s :=
  simple_mvn_std T hε N (fun m hm => jwSpec_root k hζ (by omega))
    (fun m hm => nondegenerate_root k hζ T hε (by omega)) f hf

end Markov

end QOU.HeckeTemperleyLieb.TLCupCap
