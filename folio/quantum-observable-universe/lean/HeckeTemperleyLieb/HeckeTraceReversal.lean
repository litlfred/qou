import HeckeTemperleyLieb.MarkovTraceSymmetries

/-!
# QOU.IwahoriHecke.HeckeTraceReversal — every trace on `H_n` is invariant under word reversal

`MarkovTraceSymmetries.markov_reverse` proves reversal invariance for **Markov** traces, by
uniqueness. This file proves it for **every** cyclic functional, which is what the class
`QOU.BraidsAndKnots.TFromTraceCyclicity` asks for (it quantifies over representation
characters, which are cyclic but not Markov). Every `N`, any commutative ring, any quadratic
`sᵢ² = a·sᵢ + b`.

## The statement

On the presented algebra `Pres N a b` let `rev` be the anti-automorphism fixing every
generator (it exists: the relations are palindromic, so `op ∘ pgen` is a Hecke family in the
opposite algebra and `lift` gives `Pres → Presᵐᵒᵖ`). Write `H_k` for the subalgebra generated
by `s₀, …, s_{k-1}`. Then (`trace_rev`): for every `R`-linear `φ` that is cyclic on `H_m`,
`φ (rev x) = φ x` for every `x ∈ H_m`.

## The proof: induction along the parabolic chain

The only input from the Hecke relations is the double-coset decomposition
`H_{k+1} = H_k + H_k · s_k · H_k` (`mem_span_succ`, read off the Jones normal form). The
induction carries a "prefix" `c`:

> `Q(k)`: if `c ∈ H_m` commutes with `H_{k-1}`, then `φ (c · rev v) = φ (c · v)` for `v ∈ H_k`.

`Q(0)` is trivial (`H_0` is the scalars). For `Q(k+1)`, split `v`:
* `v ∈ H_k`: the functional `x ↦ φ (c x)` is cyclic on `H_k` because `c` commutes with `H_k`;
  apply the statement for `H_k` (strong induction on `m`).
* `v = x s_k d` with `x, d ∈ H_k`: move `x` past `c` and round the trace,
  `φ (c x s_k d) = φ (c s_k · d x)` and likewise `φ (c · rev v) = φ (c s_k · rev (d x))`.
  Now `c s_k` commutes with `H_{k-1}`, so `Q(k)` applies to `d x`.

`Q(m)` with `c = 1` is the statement. This is the type-`A` case of Geck–Pfeiffer's
`T_w ≡ T_{w⁻¹} mod [H, H]`; along the chain `S₁ ⊂ S₂ ⊂ ⋯` it needs no cyclic-shift theory.

Sorry-free.

-- Ref: [geckpfeiffer2000] Geck–Pfeiffer, *Characters of finite Coxeter groups and
--      Iwahori–Hecke algebras*, §8.2.
-- Ref: [jones1987] Jones, Ann. Math. 126 (1987), §4 (normal form).
-/

namespace QOU.IwahoriHecke.HeckeTraceReversal

open QOU.IwahoriHecke.JonesNormalForm QOU.IwahoriHecke.MarkovTraceSymmetries MulOpposite

variable {R : Type*} [CommRing R] (N : ℕ) (a b : R)

/-- `H_k`: the subalgebra generated by `s₀, …, s_{k-1}`. -/
abbrev Hk (k : ℕ) : Subalgebra R (Pres N a b) := Algebra.adjoin R (pgen N a b '' Set.Iio k)

theorem Hk_mono {j k : ℕ} (h : j ≤ k) : Hk N a b j ≤ Hk N a b k :=
  Algebra.adjoin_mono (Set.image_mono (Set.Iio_subset_Iio h))

theorem pgen_mem_Hk {i k : ℕ} (h : i < k) : pgen N a b i ∈ Hk N a b k :=
  Algebra.subset_adjoin ⟨i, h, rfl⟩

theorem mem_Hk_top (x : Pres N a b) : x ∈ Hk N a b N := by
  rw [Hk, adjoin_pgen_eq_top]; trivial

/-! ### The reversal anti-automorphism -/

/-- The algebra map `Pres → Presᵐᵒᵖ` fixing the generators. -/
noncomputable def revHom : Pres N a b →ₐ[R] (Pres N a b)ᵐᵒᵖ :=
  lift (heckeFamily_op (pres_heckeFamily N a b))

/-- Word reversal on the presented algebra. -/
noncomputable def rev (x : Pres N a b) : Pres N a b := unop (revHom N a b x)

variable {N a b}

theorem rev_mul (x y : Pres N a b) : rev N a b (x * y) = rev N a b y * rev N a b x := by
  simp [rev, map_mul]

theorem rev_add (x y : Pres N a b) : rev N a b (x + y) = rev N a b x + rev N a b y := by
  simp [rev, map_add]

theorem rev_smul (r : R) (x : Pres N a b) : rev N a b (r • x) = r • rev N a b x := by
  simp [rev, map_smul]

@[simp] theorem rev_zero : rev N a b 0 = 0 := by simp [rev]

@[simp] theorem rev_one : rev N a b 1 = 1 := by simp [rev]

theorem rev_algebraMap (r : R) : rev N a b (algebraMap R (Pres N a b) r) = algebraMap R _ r := by
  simp [rev, MulOpposite.algebraMap_apply]

theorem rev_pgen (i : ℕ) : rev N a b (pgen N a b i) = pgen N a b i := by
  by_cases h : i < N
  · simp [rev, revHom, lift_pgen _ h]
  · simp [pgen, h]

theorem rev_mem {k : ℕ} {x : Pres N a b} (hx : x ∈ Hk N a b k) : rev N a b x ∈ Hk N a b k := by
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨i, hi, rfl⟩ := hx
    rw [rev_pgen]; exact Algebra.subset_adjoin ⟨i, hi, rfl⟩
  | algebraMap r => rw [rev_algebraMap]; exact Subalgebra.algebraMap_mem _ r
  | add x y _ _ hx hy => rw [rev_add]; exact add_mem hx hy
  | mul x y _ _ hx hy => rw [rev_mul]; exact mul_mem hy hx

/-- On words, `rev` is list reversal. -/
theorem rev_evalWord (α β : Bool → R) (w : List (Fin N × Bool)) :
    rev N a b (evalWord α β (pgen N a b) w) = evalWord α β (pgen N a b) w.reverse := by
  induction w with
  | nil => simp
  | cons p w ih =>
    rw [evalWord_cons, rev_mul, ih, List.reverse_cons, evalWord_append]
    congr 1
    simp [letter, rev_add, rev_smul, rev_one, rev_pgen]

/-! ### Commutation and the double-coset decomposition -/

/-- `s_i` commutes with `H_j` when every generator of `H_j` is at distance `≥ 2` from `i`. -/
theorem pgen_comm {i j : ℕ} (hij : ∀ l, l < j → l + 2 ≤ i) {y : Pres N a b}
    (hy : y ∈ Hk N a b j) : pgen N a b i * y = y * pgen N a b i := by
  by_cases hi : i < N
  · induction hy using Algebra.adjoin_induction with
    | mem y hy =>
      obtain ⟨l, hl, rfl⟩ := hy
      exact ((pres_heckeFamily N a b).comm l i (hij l hl) hi).symm
    | algebraMap r => exact (Algebra.commutes r _).symm
    | add x y _ _ hx hy => rw [mul_add, add_mul, hx, hy]
    | mul x y _ _ hx hy => rw [← mul_assoc, hx, mul_assoc, hy, mul_assoc]
  · simp [pgen, hi]

theorem Hk_zero : Hk N a b 0 = ⊥ := by
  simp [Hk]

/-- **Double cosets.** `H_{k+1} ⊆ span (H_k ∪ H_k · s_k · H_k)`. -/
theorem mem_span_succ {k : ℕ} (hk : k + 1 ≤ N) {v : Pres N a b} (hv : v ∈ Hk N a b (k + 1)) :
    v ∈ Submodule.span R ((Hk N a b k : Set (Pres N a b)) ∪
      {u | ∃ x ∈ Hk N a b k, ∃ d ∈ Hk N a b k, u = x * pgen N a b k * d}) := by
  have hs := pres_heckeFamily N a b
  rw [← Subalgebra.mem_toSubmodule, adjoin_eq_level hs hk] at hv
  refine (Submodule.span_le.mpr ?_) hv
  intro y hy
  classical
  rw [words] at hy
  obtain ⟨y', hy', d, hd, rfl⟩ := Finset.mem_image₂.mp hy
  obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hd
  have hj' := Finset.mem_range.mp hj
  have hy'k : y' ∈ Hk N a b k := by
    rw [← Subalgebra.mem_toSubmodule, adjoin_eq_level hs (by omega)]
    exact Submodule.subset_span hy'
  rcases Nat.eq_zero_or_pos (k + 1 - j) with h0 | hpos
  · rw [h0, dprod_zero, mul_one]
    exact Submodule.subset_span (Or.inl hy'k)
  · obtain ⟨m', hm'⟩ : ∃ m', k + 1 - j = m' + 1 := ⟨k - j, by omega⟩
    have hjm : j + m' = k := by omega
    have hdk : dprod (pgen N a b) j m' ∈ Hk N a b k := by
      rw [← Subalgebra.mem_toSubmodule, adjoin_eq_level hs (by omega)]
      exact dprod_mem_level _ hjm
    rw [hm', dprod_succ, hjm]
    exact Submodule.subset_span (Or.inr ⟨y', hy'k, _, hdk, by rw [mul_assoc]⟩)

/-! ### The induction -/

/-- The prefixed statement `Q`, proved for every `m ≤ N` by strong induction on `m` and, inside,
induction on `k`. -/
theorem trace_rev_prefixed :
    ∀ m, m ≤ N → ∀ φ : Pres N a b →ₗ[R] R,
      (∀ x ∈ Hk N a b m, ∀ y ∈ Hk N a b m, φ (x * y) = φ (y * x)) →
      ∀ k, k ≤ m → ∀ c ∈ Hk N a b m, (∀ y ∈ Hk N a b (k - 1), c * y = y * c) →
        ∀ v ∈ Hk N a b k, φ (c * rev N a b v) = φ (c * v) := by
  intro m
  induction m using Nat.strong_induction_on with
  | _ m IHm =>
  intro hmN φ hφ k
  induction k with
  | zero =>
    intro _ c _ _ v hv
    rw [Hk_zero, Algebra.mem_bot] at hv
    obtain ⟨r, rfl⟩ := hv
    rw [rev_algebraMap]
  | succ k IHk =>
    intro hkm c hc hcomm v hv
    have hcomm' : ∀ y ∈ Hk N a b k, c * y = y * c := by simpa using hcomm
    have hkm' : Hk N a b k ≤ Hk N a b m := Hk_mono N a b (by omega)
    refine Submodule.span_induction (p := fun v _ => φ (c * rev N a b v) = φ (c * v))
      ?_ ?_ ?_ ?_ (mem_span_succ (by omega) hv)
    · rintro u (hu | ⟨x, hx, d, hd, rfl⟩)
      · -- `u ∈ H_k`: the functional `φ (c ·)` is cyclic on `H_k`
        have h := IHm k (by omega) (by omega) (φ ∘ₗ LinearMap.mulLeft R c)
          (by
            intro x hx y hy
            simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.mulLeft_apply]
            rw [← mul_assoc, hφ _ (mul_mem hc (hkm' hx)) _ (hkm' hy), ← mul_assoc,
              ← hcomm' y hy, mul_assoc])
          k le_rfl 1 (Subalgebra.one_mem _) (by simp) u hu
        simpa using h
      · -- `u = x s_k d`: round the trace and recurse with prefix `c s_k`
        have hs : pgen N a b k ∈ Hk N a b m := pgen_mem_Hk N a b (by omega)
        have hc' : c * pgen N a b k ∈ Hk N a b m := mul_mem hc hs
        have hcomm2 : ∀ y ∈ Hk N a b (k - 1), c * pgen N a b k * y = y * (c * pgen N a b k) := by
          intro y hy
          have hy' : y ∈ Hk N a b k := Hk_mono N a b (by omega) hy
          rw [mul_assoc, pgen_comm (j := k - 1) (fun l hl => by omega) hy, ← mul_assoc,
            hcomm' y hy', mul_assoc]
        have hrec := IHk (by omega) (c * pgen N a b k) hc' hcomm2 (d * x) (mul_mem hd hx)
        set g := pgen N a b k
        have hl : φ (c * (x * g * d)) = φ (c * g * (d * x)) := by
          have e1 : c * (x * g * d) = x * (c * g * d) := by
            calc c * (x * g * d) = (c * x) * (g * d) := by simp only [mul_assoc]
              _ = (x * c) * (g * d) := by rw [hcomm' x hx]
              _ = x * (c * g * d) := by simp only [mul_assoc]
          rw [e1, hφ _ (hkm' hx) _ (mul_mem hc' (hkm' hd))]
          simp only [mul_assoc]
        have hr : φ (c * rev N a b (x * g * d)) = φ (c * g * rev N a b (d * x)) := by
          have hrx := rev_mem (hkm' hx)
          have hrd := rev_mem (k := k) hd
          have e1 : c * rev N a b (x * g * d) = rev N a b d * (c * g * rev N a b x) := by
            rw [rev_mul, rev_mul, rev_pgen]
            calc c * (rev N a b d * (g * rev N a b x))
                = (c * rev N a b d) * (g * rev N a b x) := by simp only [mul_assoc]
              _ = (rev N a b d * c) * (g * rev N a b x) := by rw [hcomm' _ hrd]
              _ = rev N a b d * (c * g * rev N a b x) := by simp only [mul_assoc]
          rw [e1, hφ _ (hkm' hrd) _ (mul_mem hc' hrx), rev_mul]
          simp only [mul_assoc]
        rw [hl, hr, hrec]
    · simp
    · intro x y _ _ hx hy
      rw [rev_add, mul_add, mul_add, map_add, map_add, hx, hy]
    · intro r x _ hx
      rw [rev_smul, mul_smul_comm, mul_smul_comm, map_smul, map_smul, hx]

/-- **Every trace on `H_m` is invariant under word reversal.** -/
theorem trace_rev {m : ℕ} (hm : m ≤ N) (φ : Pres N a b →ₗ[R] R)
    (hφ : ∀ x ∈ Hk N a b m, ∀ y ∈ Hk N a b m, φ (x * y) = φ (y * x))
    {x : Pres N a b} (hx : x ∈ Hk N a b m) : φ (rev N a b x) = φ x := by
  simpa using trace_rev_prefixed m hm φ hφ m le_rfl 1 (Subalgebra.one_mem _) (by simp) x hx

/-! ### In any algebra with a Hecke family -/

/-- **Reversal invariance of every cyclic functional**, in any algebra carrying a Hecke family,
for every `N`. -/
theorem cyclic_reverse {A : Type*} [Ring A] [Algebra R A] {s : ℕ → A}
    (hs : HeckeFamily N a b s) (t : A →ₗ[R] R) (hcyc : ∀ x y : A, t (x * y) = t (y * x))
    (α β : Bool → R) (w : List (Fin N × Bool)) :
    t (evalWord α β s w.reverse) = t (evalWord α β s w) := by
  have h := trace_rev le_rfl (t ∘ₗ (lift hs).toLinearMap)
    (by intro x _ y _; simp [hcyc]) (mem_Hk_top N a b (evalWord α β (pgen N a b) w))
  simp only [LinearMap.coe_comp, Function.comp_apply, AlgHom.toLinearMap_apply,
    rev_evalWord] at h
  rwa [map_evalWord (lift hs) α β _ s (fun i hi => lift_pgen hs hi),
    map_evalWord (lift hs) α β _ s (fun i hi => lift_pgen hs hi)] at h

end QOU.IwahoriHecke.HeckeTraceReversal
