import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
import Mathlib.Tactic

/-!
# Explicit determinant expansions `det_fin_four` / `det_fin_five` / `det_fin_six`

Mathlib ships `Matrix.det_fin_two` and `Matrix.det_fin_three` (the explicit
Leibniz formulae for 2×2 and 3×3 determinants) but stops there.  This module
continues the pattern up to 6×6.

The lemmas are proved **incrementally** — `det_fin_four` from `det_fin_three`,
`det_fin_five` from `det_fin_four`, `det_fin_six` from `det_fin_five` — so each
proof only expands the top row via `Matrix.det_succ_row_zero` and discharges the
remaining minors with the previous lemma.  This keeps every step at the
single-`succAbove`-layer complexity that `simp (decide := true)` can fully
reduce, avoiding the factorial blow-up of a one-shot 6-level cofactor expansion.

The `det_fin_six` RHS has the full 720-term Leibniz sum; it is generated
mechanically.  These are generic `CommRing` identities (no archimedean
hypotheses), reusable for any explicit small-matrix determinant.
-/

namespace Matrix

set_option maxHeartbeats 4000000 in
set_option maxRecDepth 4000 in
/-- Explicit Leibniz formula for the determinant of a `4×4` matrix. -/
theorem det_fin_four {R : Type*} [CommRing R] (A : Matrix (Fin 4) (Fin 4) R) :
    A.det =
      A 0 0*A 1 1*A 2 2*A 3 3-A 0 0*A 1 1*A 2 3*A 3 2-A 0 0*A 1 2*A 2 1*A 3 3+A 0 0*A 1 2*A 2 3*A 3 1+A 0 0*A 1 3*A 2 1*A 3 2-A 0 0*A 1 3*A 2 2*A 3 1-A 0 1*A 1 0*A 2 2*A 3 3+A 0 1*A 1 0*A 2 3*A 3 2+A 0 1*A 1 2*A 2 0*A 3 3-A 0 1*A 1 2*A 2 3*A 3 0-A 0 1*A 1 3*A 2 0*A 3 2+A 0 1*A 1 3*A 2 2*A 3 0+A 0 2*A 1 0*A 2 1*A 3 3-A 0 2*A 1 0*A 2 3*A 3 1-A 0 2*A 1 1*A 2 0*A 3 3+A 0 2*A 1 1*A 2 3*A 3 0+A 0 2*A 1 3*A 2 0*A 3 1-A 0 2*A 1 3*A 2 1*A 3 0-A 0 3*A 1 0*A 2 1*A 3 2+A 0 3*A 1 0*A 2 2*A 3 1+A 0 3*A 1 1*A 2 0*A 3 2-A 0 3*A 1 1*A 2 2*A 3 0-A 0 3*A 1 2*A 2 0*A 3 1+A 0 3*A 1 2*A 2 1*A 3 0 := by
  rw [det_succ_row_zero]
  simp (config := {decide := true}) [Fin.sum_univ_succ, det_fin_three,
    Matrix.submatrix_apply, Fin.succAbove]
  ring

set_option maxHeartbeats 16000000 in
set_option maxRecDepth 8000 in
