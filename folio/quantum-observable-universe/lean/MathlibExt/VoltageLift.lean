import MathlibExt.CombinatorialMapQuotient
import Mathlib.GroupTheory.SpecificGroups.Cyclic

/-!
# `QOU.RiemannSurface.VoltageLift` — the combinatorial half of the equivariant triangulation

Bean `qou-yslf` (Bring milestone M3, step 3), parent `qou-qhcr`.

## Where this sits

The capstones `chi_eq_neg_six_of_equivariant_map` and `chi_le_neg_six_of_A5_map` take a
combinatorial map with a `G`-action. A compact Riemann surface `X` with a holomorphic action of a
finite group `G` gives one in three steps:

1. triangulate the quotient `X/G` with every branch value a vertex (Radó's theorem);
2. record the monodromy of the branched cover `X → X/G` as a *voltage* on the darts of that
   triangulation;
3. lift the triangulation to `X`.

Steps 1 and 2 are analysis and covering-space theory, which Mathlib does not have. **Step 3 is
pure combinatorics and is proved here**, together with one consequence that removes a hypothesis
from the capstones.

## What is proved (sorry-free)

* `cycle_stabilizer_isCyclic`: if `G` acts **freely on darts**, the stabiliser of every cycle of
  an equivariant permutation is cyclic. So for any map with a dart-free action, the hypothesis
  "cyclic vertex stabilisers" (`hcyc`, `hcycA` in the capstones) holds automatically, and also on
  faces.
* The *derived map* (voltage lift). For a permutation `π` of base darts `E` and a voltage
  `ν : E → G`, `liftPerm π ν` permutes `G × E` by `(g, x) ↦ (g · ν x, π x)`. Then:
  - `liftPerm_equivariant`: it commutes with left multiplication by `G`;
  - `lift_free`: `G` acts freely on the lifted darts;
  - `liftPerm_involution`, `liftPerm_fixedPointFree`: if `α` is a fixed-point-free involution and
    `ν (α x) = (ν x)⁻¹`, the lift of `α` is again a fixed-point-free involution, so
    `(liftPerm σ ν_σ, liftPerm α ν_α)` is a combinatorial map;
  - `lift_edges_free`: `G` acts freely on the lifted edges, which is the capstones' `hE`;
  - `liftQuotEquiv`, `liftQuotEquiv_quotPerm`: the dart orbits are the base darts, and the
    quotient permutation is `π`. So the quotient of the lifted map is the base map.

## What stays open (narrowed)

* **Faces free (`hF`).** In the lift, a face is free exactly when the voltage product around the
  base face is `1`. Placing every branch value at a vertex of the base triangulation gives this;
  it is a property of step 1, not of the lift.
* **Connectedness.** The lift is connected exactly when the voltages generate `G` (the cover is
  connected). Not proved here.
* **Steps 1 and 2.** Radó's theorem and the monodromy of a branched cover. Recorded as open in
  `qou-yslf`; no axiom or class stands in for them.

No `sorry`, no axiom, no `native_decide`.

Ref: [farkas-kra1992] Farkas–Kra, *Riemann Surfaces*, §V.1; J. L. Gross and T. W. Tucker,
*Topological Graph Theory*, Wiley 1987, §2.1 and §4.1 (voltage graphs and derived maps) — not
held in the library.
-/

namespace QOU.RiemannSurface.VoltageLift

open MulAction Equiv QOU.RiemannSurface.CombinatorialMapQuotient

/-! ## 1. A dart-free action has cyclic cell stabilisers -/

section CyclicStabiliser

variable {G D : Type*} [Group G] [MulAction G D] {π : Perm D}

/-- An element of the stabiliser of the cycle through `x` moves `x` along that cycle. -/
theorem smul_sameCycle_of_mem_stab (hπ : Equivariant π G) (x : D) (g : G)
    (hg : g ∈ letI := cycleAction hπ; stabilizer G (Quotient.mk'' x : Cycles π)) :
    π.SameCycle x (g • x) := by
  letI := cycleAction hπ
  have h : (Quotient.mk'' (g • x) : Cycles π) = Quotient.mk'' x := hg
  exact (Quotient.exact' h).symm

/-- Such an element acts on every dart of the cycle as one fixed power of `π`. -/
theorem smul_eq_zpow (hπ : Equivariant π G) {x : D} {g : G} {j : ℤ}
    (hj : (π ^ j) x = g • x) {y : D} (hy : π.SameCycle x y) : g • y = (π ^ j) y := by
  obtain ⟨k, rfl⟩ := hy
  rw [← hπ.zpow k g x, ← hj, ← Perm.mul_apply, ← Perm.mul_apply, ← zpow_add, ← zpow_add,
    add_comm]

/-- A stabilising element preserves the cycle as a set. -/
theorem sameCycle_smul_iff (hπ : Equivariant π G) (x : D) (g : G)
    (hg : π.SameCycle x (g • x)) (y : D) : π.SameCycle x y ↔ π.SameCycle x (g • y) := by
  obtain ⟨j, hj⟩ := hg
  constructor
  · intro hy
    rw [smul_eq_zpow hπ hj hy]
    exact hy.trans ⟨j, rfl⟩
  · intro hy
    have hg' : π.SameCycle x (g⁻¹ • x) := by
      have h1 : (π ^ j) (g⁻¹ • x) = x := by rw [hπ.zpow j g⁻¹ x, hj, inv_smul_smul]
      exact Perm.SameCycle.symm (⟨j, h1⟩ : π.SameCycle (g⁻¹ • x) x)
    obtain ⟨j', hj'⟩ := hg'
    have := smul_eq_zpow hπ hj' hy
    rw [inv_smul_smul] at this
    rw [this]
    exact hy.trans ⟨j', rfl⟩

/-- **Free on darts ⇒ every cell stabiliser is cyclic.** If `G` acts freely on the darts and
commutes with `π`, the stabiliser in `G` of each cycle of `π` is a cyclic group. It embeds in the
cyclic group generated by `π` restricted to that cycle. -/
theorem cycle_stabilizer_isCyclic (hπ : Equivariant π G)
    (hfree : ∀ (g : G) (x : D), g • x = x → g = 1) (c : Cycles π) :
    letI := cycleAction hπ
    IsCyclic (stabilizer G c) := by
  letI := cycleAction hπ
  induction c using Quotient.inductionOn' with
  | h x =>
  set S := {y : D // π.SameCycle x y}
  have hS : ∀ y, π.SameCycle x y ↔ π.SameCycle x (π y) := fun y =>
    ⟨fun h => h.trans ⟨1, by simp⟩, fun h => h.trans ⟨-1, by simp⟩⟩
  let πS : Perm S := π.subtypePerm fun y => (hS y).symm
  let r : stabilizer G (Quotient.mk'' x : Cycles π) →* Perm S :=
    { toFun := fun g =>
        (toPerm (g : G) : Perm D).subtypePerm
          fun y => (sameCycle_smul_iff hπ x g (smul_sameCycle_of_mem_stab hπ x g g.2) y).symm
      map_one' := by ext y; simp
      map_mul' := by intro g h; ext y; simp [mul_smul] }
  have hmem : ∀ g, r g ∈ Subgroup.zpowers πS := by
    intro g
    obtain ⟨j, hj⟩ := smul_sameCycle_of_mem_stab hπ x (g : G) g.2
    refine ⟨j, ?_⟩
    ext y
    change (((π.subtypePerm fun y => (hS y).symm) ^ j) y : D) = (g : G) • (y : D)
    rw [Perm.subtypePerm_zpow]
    exact (smul_eq_zpow hπ hj y.2).symm
  let r' := r.codRestrict (Subgroup.zpowers πS) hmem
  have hinj : Function.Injective r' := by
    intro g h hgh
    have hx : (g : G) • x = (h : G) • x := by
      have := congrArg (fun p : Subgroup.zpowers πS => ((p : Perm S) ⟨x, Perm.SameCycle.refl _ _⟩ : D))
        hgh
      simpa [r', r] using this
    have h1 : ((h : G)⁻¹ * g) • x = x := by rw [mul_smul, hx, inv_smul_smul]
    have h2 := hfree _ _ h1
    apply Subtype.ext
    rw [inv_mul_eq_one] at h2
    exact h2.symm
  haveI : IsCyclic (Subgroup.zpowers πS) :=
    (Subgroup.isCyclic_iff_exists_zpowers_eq_top _).2 ⟨πS, rfl⟩
  exact isCyclic_of_injective r' hinj

end CyclicStabiliser

/-! ## 2. The derived map of a voltage assignment -/

section Lift

variable (G E : Type*) [Group G]

/-- Darts of the lifted map: a sheet `g : G` over a base dart. -/
def Lift := G × E

variable {G E}

instance : MulAction G (Lift G E) where
  smul h p := ((h * p.1 : G), (p.2 : E))
  one_smul p := by
    change ((1 * p.1 : G), p.2) = p
    rw [one_mul]; rfl
  mul_smul a b p := by
    change ((a * b * p.1 : G), p.2) = ((a * (b * p.1) : G), p.2)
    rw [mul_assoc]

@[simp] theorem smul_fst (h : G) (p : Lift G E) : (h • p).1 = h * p.1 := rfl
@[simp] theorem smul_snd (h : G) (p : Lift G E) : (h • p).2 = p.2 := rfl

/-- The lift of a base permutation `π` along a voltage `ν`: `(g, x) ↦ (g · ν x, π x)`. -/
def liftPerm (π : Perm E) (ν : E → G) : Perm (Lift G E) where
  toFun p := ((p.1 * ν p.2 : G), π p.2)
  invFun p := ((p.1 * (ν (π.symm p.2))⁻¹ : G), π.symm p.2)
  left_inv p := by
    change ((p.1 * ν p.2 * (ν (π.symm (π p.2)))⁻¹ : G), π.symm (π p.2)) = p
    rw [Equiv.symm_apply_apply, mul_inv_cancel_right]; rfl
  right_inv p := by
    change ((p.1 * (ν (π.symm p.2))⁻¹ * ν (π.symm p.2) : G), π (π.symm p.2)) = p
    rw [Equiv.apply_symm_apply, inv_mul_cancel_right]; rfl

@[simp] theorem liftPerm_fst (π : Perm E) (ν : E → G) (p : Lift G E) :
    (liftPerm π ν p).1 = p.1 * ν p.2 := rfl
@[simp] theorem liftPerm_snd (π : Perm E) (ν : E → G) (p : Lift G E) :
    (liftPerm π ν p).2 = π p.2 := rfl

omit [Group G] in
theorem Lift.ext' {p q : Lift G E} (h1 : p.1 = q.1) (h2 : p.2 = q.2) : p = q :=
  Prod.ext h1 h2

/-- The lift commutes with the sheet action. -/
theorem liftPerm_equivariant (π : Perm E) (ν : E → G) : Equivariant (liftPerm π ν) G := by
  intro h p
  exact Lift.ext' (by simp [mul_assoc]) rfl

/-- `G` acts freely on the lifted darts. -/
theorem lift_free (h : G) (p : Lift G E) (hp : h • p = p) : h = 1 := by
  have := congrArg Prod.fst hp
  simpa using this

/-- The lift of an involution along an inverse-symmetric voltage is an involution. -/
theorem liftPerm_involution (α : Perm E) (ν : E → G) (hinv : α * α = 1)
    (hν : ∀ x, ν (α x) = (ν x)⁻¹) : liftPerm α ν * liftPerm α ν = 1 := by
  ext1 p
  have hx : α (α p.2) = p.2 := by
    simpa [Perm.mul_apply] using congrArg (fun f : Perm E => f p.2) hinv
  exact Lift.ext' (by simp [Perm.mul_apply, hν, mul_assoc]) (by simp [Perm.mul_apply, hx])

/-- The lift of a fixed-point-free permutation is fixed-point-free. -/
theorem liftPerm_fixedPointFree (α : Perm E) (ν : E → G) (hfix : ∀ x, α x ≠ x)
    (p : Lift G E) : liftPerm α ν p ≠ p := fun h => hfix p.2 (congrArg Prod.snd h)

/-- A dart in the same `α`-cycle as `x`, for an involution `α`, is `x` or `α x`. -/
theorem sameCycle_involution {D : Type*} {α : Perm D} (hinv : α * α = 1) {x y : D}
    (h : α.SameCycle x y) : y = x ∨ y = α x := by
  obtain ⟨i, rfl⟩ := h
  have hsq : α ^ (2 : ℤ) = 1 := by rw [zpow_two]; exact hinv
  obtain ⟨k, rfl | rfl⟩ := Int.even_or_odd' i
  · left; rw [zpow_mul, hsq, one_zpow, Perm.one_apply]
  · right; rw [zpow_add, zpow_mul, hsq, one_zpow, one_mul, zpow_one]

/-- **`G` acts freely on the lifted edges.** This is the capstones' hypothesis `hE`. -/
theorem lift_edges_free (α : Perm E) (ν : E → G) (hinv : α * α = 1)
    (hν : ∀ x, ν (α x) = (ν x)⁻¹) (hfix : ∀ x, α x ≠ x) (h : G)
    (e : Cycles (liftPerm α ν)) :
    letI := cycleAction (liftPerm_equivariant α ν)
    h • e = e → h = 1 := by
  letI := cycleAction (liftPerm_equivariant α ν)
  induction e using Quotient.inductionOn' with
  | h p =>
  intro he
  have hc : (liftPerm α ν).SameCycle p (h • p) :=
    (Quotient.exact' (show (Quotient.mk'' (h • p) : Cycles (liftPerm α ν)) = _ from he)).symm
  rcases sameCycle_involution (liftPerm_involution α ν hinv hν) hc with h1 | h1
  · exact lift_free h p h1
  · exact absurd (congrArg Prod.snd h1).symm (by simpa using hfix p.2)

/-! ### The quotient of the lift is the base -/

/-- Dart orbits of the lift are the base darts. -/
def liftQuotEquiv : orbitRel.Quotient G (Lift G E) ≃ E where
  toFun := Quotient.lift (fun p : Lift G E => p.2) (by
    intro p q hpq
    obtain ⟨g, rfl⟩ := hpq
    rfl)
  invFun x := Quotient.mk'' ((1 : G), x)
  left_inv q := by
    induction q using Quotient.inductionOn' with
    | h p =>
    apply Quotient.sound'
    exact ⟨p.1⁻¹, Lift.ext' (by simp) rfl⟩
  right_inv x := rfl

/-- **The quotient map of the lift is the base map**: the induced permutation of dart orbits is
`π` under `liftQuotEquiv`. -/
theorem liftQuotEquiv_quotPerm (π : Perm E) (ν : E → G) (q : orbitRel.Quotient G (Lift G E)) :
    liftQuotEquiv (quotPerm (liftPerm_equivariant π ν) q) = π (liftQuotEquiv q) := by
  induction q using Quotient.inductionOn' with
  | h p => rfl

/-- The lifted rotation has cyclic vertex stabilisers, without any hypothesis. -/
theorem lift_vertex_stabilizer_isCyclic (σ : Perm E) (ν : E → G)
    (v : Cycles (liftPerm σ ν)) :
    letI := cycleAction (liftPerm_equivariant σ ν)
    IsCyclic (stabilizer G v) :=
  cycle_stabilizer_isCyclic (liftPerm_equivariant σ ν) lift_free v

end Lift

end QOU.RiemannSurface.VoltageLift
