import MathlibExt.MatrixCoefficientBialgebra
import Mathlib.Algebra.RingQuot
import Mathlib.Algebra.BigOperators.Fin
import Mathlib.Data.Fin.Tuple.Basic
import Mathlib.Data.Matrix.Mul

/-!
# The one-object Tannaka coend, and its coproduct as a theorem

Fix a commutative ring `R` and a finite index type `n`, the basis of `τ V ≅ Rⁿ`. The tensor
power `τ (V^{⊗m})` then has the basis of words `Fin m → n`, and a morphism
`f : V^{⊗a} ⟶ V^{⊗b}` acts by a matrix `F : Matrix (Fin b → n) (Fin a → n) R`.
`IntertwinerData` records any family of such matrices.

The **coend** `Coend D` is the free algebra on the coefficients `u i j` of a universal
matrix, divided by the relations saying that the tensor powers `u^{⊗a}`, `u^{⊗b}` are
intertwined by every `F` (`u^{⊗b} F = F u^{⊗a}` as matrices over the free algebra). Its
points in an algebra `B` are exactly the matrices over `B` whose tensor powers commute
with every `F` (`pointEquiv`), i.e. the tensor-natural endomorphisms of `τ ⊗ B` on the
monoidal subcategory generated by `V`.

The coproduct is **not** an input here. The key step is `Intertwines.tmul`: if `M` and
`N` intertwine `D`, so does their tensor-matrix product `∑ k, M i k ⊗ N k j`. Hence the
matrix-coefficient coproduct of `MatrixCoefficientBialgebra.lean` kills the relations and
descends (`coendComul`), and `Coend D` is a bialgebra (`instBialgebra`). Over a
commutative `B`, `Δ` is the transpose of composing points: the point
`m ∘ (φ ⊗ ψ) ∘ Δ` has matrix `M_φ * M_ψ` (`pointMatrix_convolution`).

Everything is over a generic commutative ring, with no analysis and no axiom. The
reconstruction axiom `tannaka_krein_reconstruction` is not used. This file proves its
one-object, finite-free case at the level of the bialgebra and its points.

-- Ref: [kassel1995] Kassel, *Quantum Groups*, GTM 155, Ch. XI (reconstruction) and
   §VIII.6 (FRT). https://doi.org/10.1007/978-1-4612-0783-2
-- Ref: [deligne1990] Deligne, "Catégories tannakiennes", §§1–2.
-/

set_option linter.unusedSectionVars false

namespace QOU.Coproduct

open TensorProduct

noncomputable section

/-! ## Words and tensor-power coefficients -/

section TensorPower

variable {R : Type*} [CommRing R] {n : Type*}

/-- The `(v, w)` coefficient of the `m`-th tensor power of a matrix `M`: the ordered
product `M (v 0) (w 0) * ⋯ * M (v (m-1)) (w (m-1))`. -/
def tpow {A : Type*} [Semiring A] (M : Matrix n n A) (m : ℕ) (v w : Fin m → n) : A :=
  (List.ofFn fun t => M (v t) (w t)).prod

variable {A B : Type*} [Semiring A] [Algebra R A] [Semiring B] [Algebra R B]

@[simp] theorem tpow_zero (M : Matrix n n A) (v w : Fin 0 → n) : tpow M 0 v w = 1 := by
  simp [tpow]

theorem tpow_succ (M : Matrix n n A) (m : ℕ) (v w : Fin (m + 1) → n) :
    tpow M (m + 1) v w = M (v 0) (w 0) * tpow M m (Fin.tail v) (Fin.tail w) := by
  simp [tpow, List.ofFn_succ, Fin.tail]

theorem map_tpow (φ : A →ₐ[R] B) (M : Matrix n n A) (m : ℕ) (v w : Fin m → n) :
    φ (tpow M m v w) = tpow (fun i j => φ (M i j)) m v w := by
  simp [tpow, map_list_prod, List.map_ofFn, Function.comp_def]

theorem tpow_one [DecidableEq n] (m : ℕ) (v w : Fin m → n) :
    tpow (fun i j : n => if i = j then (1 : R) else 0) m v w = if v = w then 1 else 0 := by
  simp [tpow, List.prod_ofFn, Finset.prod_boole, funext_iff]

variable [Fintype n] [DecidableEq n]

omit [DecidableEq n] in
/-- Tensor powers are multiplicative: the `m`-th power of the tensor-matrix product
`∑ k, M i k ⊗ N k j` is the tensor-matrix product of the `m`-th powers. -/
theorem tpow_tmul (M : Matrix n n A) (N : Matrix n n B) :
    ∀ (m : ℕ) (v w : Fin m → n),
      tpow (fun i j => ∑ k, M i k ⊗ₜ[R] N k j) m v w =
        ∑ x, tpow M m v x ⊗ₜ[R] tpow N m x w
  | 0, v, w => by simp [Algebra.TensorProduct.one_def]
  | m + 1, v, w => by
    rw [tpow_succ, tpow_tmul M N m, Finset.sum_mul_sum,
      ← (Fin.consEquiv fun _ => n).sum_comp, Fintype.sum_prod_type]
    simp [Fin.consEquiv, tpow_succ, Algebra.TensorProduct.tmul_mul_tmul]

end TensorPower

/-! ## Intertwiner data and the coend -/

universe uι

/-- The data the coend sees: a family of morphisms `f : V^{⊗ src f} ⟶ V^{⊗ tgt f}`, each
given by its matrix `τ f` in the word bases. -/
structure IntertwinerData (R : Type*) [CommRing R] (n : Type*) where
  /-- Index of the morphisms. -/
  ι : Type uι
  /-- Source tensor power. -/
  src : ι → ℕ
  /-- Target tensor power. -/
  tgt : ι → ℕ
  /-- The matrix of `τ f`. -/
  mat : (f : ι) → Matrix (Fin (tgt f) → n) (Fin (src f) → n) R

variable {R : Type*} [CommRing R] {n : Type*} [Fintype n] [DecidableEq n]
variable (D : IntertwinerData.{uι} R n)

/-- `M` **intertwines** `D`: for every `f`, `F · M^{⊗ src} = M^{⊗ tgt} · F`, entrywise. -/
def Intertwines {A : Type*} [Semiring A] [Algebra R A] (M : Matrix n n A) : Prop :=
  ∀ (f : D.ι) (w : Fin (D.tgt f) → n) (w' : Fin (D.src f) → n),
    ∑ v, D.mat f w v • tpow M (D.src f) v w' = ∑ v, D.mat f v w' • tpow M (D.tgt f) w v

variable {D}

omit [DecidableEq n] in
/-- **The key step.** Intertwining matrices are closed under the tensor-matrix product.
This is what makes the coproduct descend; it is the only place `Δ`'s formula enters. -/
theorem Intertwines.tmul {A B : Type*} [Semiring A] [Algebra R A] [Semiring B] [Algebra R B]
    {M : Matrix n n A} {N : Matrix n n B} (hM : Intertwines D M) (hN : Intertwines D N) :
    Intertwines D (fun i j => ∑ k, M i k ⊗ₜ[R] N k j) := by
  intro f w w'
  simp only [tpow_tmul]
  calc ∑ v, D.mat f w v • ∑ x, tpow M (D.src f) v x ⊗ₜ[R] tpow N (D.src f) x w'
      = ∑ x, (∑ v, D.mat f w v • tpow M (D.src f) v x) ⊗ₜ[R] tpow N (D.src f) x w' := by
        simp only [Finset.smul_sum, sum_tmul, smul_tmul']
        exact Finset.sum_comm
    _ = ∑ x, (∑ y, D.mat f y x • tpow M (D.tgt f) w y) ⊗ₜ[R] tpow N (D.src f) x w' := by
        exact Finset.sum_congr rfl fun x _ => by rw [hM f w x]
    _ = ∑ y, tpow M (D.tgt f) w y ⊗ₜ[R] ∑ x, D.mat f y x • tpow N (D.src f) x w' := by
        simp only [sum_tmul, tmul_sum, smul_tmul]
        exact Finset.sum_comm
    _ = ∑ y, tpow M (D.tgt f) w y ⊗ₜ[R] ∑ z, D.mat f z w' • tpow N (D.tgt f) y z := by
        exact Finset.sum_congr rfl fun y _ => by rw [hN f y w']
    _ = ∑ z, D.mat f z w' • ∑ y, tpow M (D.tgt f) w y ⊗ₜ[R] tpow N (D.tgt f) y z := by
        simp only [Finset.smul_sum, tmul_sum, tmul_smul]
        exact Finset.sum_comm

/-- The identity matrix intertwines every `D`. -/
theorem intertwines_one : Intertwines D (fun i j : n => if i = j then (1 : R) else 0) := by
  intro f w w'
  simp [tpow_one, Finset.sum_ite_eq, Finset.sum_ite_eq']

variable (R n)

/-- The universal matrix `(u i j)` over the free algebra. -/
def uMat : Matrix n n (MatCoeff R n) := fun i j => u R i j

variable {R n} (D)

/-- The intertwining relations on the free algebra. -/
inductive CoendRel : MatCoeff R n → MatCoeff R n → Prop
  | intertwine (f : D.ι) (w : Fin (D.tgt f) → n) (w' : Fin (D.src f) → n) :
      CoendRel (∑ v, D.mat f w v • tpow (uMat R n) (D.src f) v w')
        (∑ v, D.mat f v w' • tpow (uMat R n) (D.tgt f) w v)

/-- **The one-object Tannaka coend** of `D`. -/
abbrev Coend : Type _ := RingQuot (CoendRel D)

/-- The quotient map from the free algebra. -/
def coendMk : MatCoeff R n →ₐ[R] Coend D := RingQuot.mkAlgHom R (CoendRel D)

/-- The universal matrix of the coend. -/
def coendMat : Matrix n n (Coend D) := fun i j => coendMk D (u R i j)

omit [DecidableEq n] in
theorem coendMat_intertwines : Intertwines D (coendMat D) := by
  intro f w w'
  have h := RingQuot.mkAlgHom_rel R (CoendRel.intertwine (D := D) f w w')
  simpa [map_sum, map_smul, map_tpow, coendMk, coendMat, uMat] using h

variable {D}

/-! ## Points -/

section Points

variable {B : Type*} [Semiring B] [Algebra R B]

/-- The point of `Coend D` in `B` given by an intertwining matrix. -/
def liftPoint (M : Matrix n n B) (hM : Intertwines D M) : Coend D →ₐ[R] B :=
  RingQuot.liftAlgHom R ⟨FreeAlgebra.lift R fun p => M p.1 p.2, by
    rintro _ _ ⟨f, w, w'⟩
    have h := hM f w w'
    simpa [map_sum, map_smul, map_tpow, uMat] using h⟩

omit [DecidableEq n] in
@[simp] theorem liftPoint_coendMat (M : Matrix n n B) (hM : Intertwines D M) (i j : n) :
    liftPoint M hM (coendMat D i j) = M i j := by
  simp [liftPoint, coendMat, coendMk]

omit [DecidableEq n] in
/-- A point is determined by its matrix. -/
theorem point_ext {φ ψ : Coend D →ₐ[R] B} (h : ∀ i j, φ (coendMat D i j) = ψ (coendMat D i j)) :
    φ = ψ := by
  apply RingQuot.ringQuot_ext'
  apply FreeAlgebra.hom_ext
  funext ⟨i, j⟩
  exact h i j

/-- The matrix of a point. -/
def pointMatrix (φ : Coend D →ₐ[R] B) : Matrix n n B := fun i j => φ (coendMat D i j)

omit [DecidableEq n] in
theorem pointMatrix_intertwines (φ : Coend D →ₐ[R] B) : Intertwines D (pointMatrix φ) := by
  intro f w w'
  have h := congrArg φ (coendMat_intertwines D f w w')
  simpa [map_sum, map_smul, map_tpow, pointMatrix] using h

variable (D B)

/-- **Points of the coend are the intertwining matrices**: algebra maps `Coend D → B`
correspond to matrices over `B` whose tensor powers commute with every `τ f`. -/
def pointEquiv : (Coend D →ₐ[R] B) ≃ {M : Matrix n n B // Intertwines D M} where
  toFun φ := ⟨pointMatrix φ, pointMatrix_intertwines φ⟩
  invFun M := liftPoint M.1 M.2
  left_inv φ := point_ext fun i j => by simp [pointMatrix]
  right_inv M := by ext i j; simp [pointMatrix]

end Points

/-! ## The coproduct and counit, descended -/

variable (D)

/-- The tensor-matrix square `∑ k, u i k ⊗ u k j` of the coend matrix. -/
def coendMatSq : Matrix n n (Coend D ⊗[R] Coend D) :=
  fun i j => ∑ k, coendMat D i k ⊗ₜ[R] coendMat D k j

/-- **The coproduct of the coend**: the point of `Coend D` in `Coend D ⊗ Coend D` given
by `coendMatSq`, which intertwines by `Intertwines.tmul`. -/
def coendComul : Coend D →ₐ[R] Coend D ⊗[R] Coend D :=
  liftPoint (coendMatSq D) ((coendMat_intertwines D).tmul (coendMat_intertwines D))

/-- The counit: the point given by the identity matrix. -/
def coendCounit : Coend D →ₐ[R] R :=
  liftPoint (fun i j : n => if i = j then (1 : R) else 0) intertwines_one

@[simp] theorem coendComul_coendMat (i j : n) :
    coendComul D (coendMat D i j) = ∑ k, coendMat D i k ⊗ₜ[R] coendMat D k j := by
  simp [coendComul, coendMatSq]

@[simp] theorem coendCounit_coendMat (i j : n) :
    coendCounit D (coendMat D i j) = if i = j then 1 else 0 := by
  simp [coendCounit]

theorem coendComul_coassoc :
    (Algebra.TensorProduct.assoc R R (Coend D) (Coend D) (Coend D)).toAlgHom.comp
      ((Algebra.TensorProduct.map (coendComul D) (.id R _)).comp (coendComul D))
      = (Algebra.TensorProduct.map (.id R _) (coendComul D)).comp (coendComul D) := by
  apply point_ext
  intro i j
  simp only [AlgHom.coe_comp, Function.comp_apply, coendComul_coendMat, map_sum,
    Algebra.TensorProduct.map_tmul, AlgHom.id_apply, AlgEquiv.toAlgHom_eq_coe,
    AlgHom.coe_coe, sum_tmul, tmul_sum, Algebra.TensorProduct.assoc_tmul]
  exact Finset.sum_comm

theorem coendCounit_rTensor :
    (Algebra.TensorProduct.map (coendCounit D) (.id R _)).comp (coendComul D)
      = (Algebra.TensorProduct.lid R (Coend D)).symm := by
  apply point_ext
  intro i j
  simp [ite_tmul]

theorem coendCounit_lTensor :
    (Algebra.TensorProduct.map (.id R _) (coendCounit D)).comp (coendComul D)
      = (Algebra.TensorProduct.rid R R (Coend D)).symm := by
  apply point_ext
  intro i j
  simp [tmul_ite]

/-- **The coend is a bialgebra**, with the matrix-coefficient coproduct as a consequence
of the intertwining relations rather than as a definition. -/
instance instBialgebraCoend : Bialgebra R (Coend D) :=
  Bialgebra.ofAlgHom (coendComul D) (coendCounit D)
    (coendComul_coassoc D) (coendCounit_rTensor D) (coendCounit_lTensor D)

/-- The quotient map from the free matrix-coefficient bialgebra is the matrix-coefficient
coproduct in the sense of `IsMatrixCoproduct`. -/
theorem coend_isMatrixCoproduct : IsMatrixCoproduct (coendMat D) (coendComul D) := by
  rw [isMatrixCoproduct_iff]
  exact coendComul_coendMat D

/-- `coendComul` is the only algebra map with the matrix-coefficient formula. -/
theorem coendComul_unique {Δ : Coend D →ₐ[R] Coend D ⊗[R] Coend D}
    (h : ∀ i j, Δ (coendMat D i j) = ∑ k, coendMat D i k ⊗ₜ[R] coendMat D k j) :
    Δ = coendComul D :=
  point_ext fun i j => by rw [h i j, coendComul_coendMat]

/-! ## The coproduct is the transpose of composing points -/

/-- **Convolution of points is matrix multiplication.** Over a commutative `B`, the point
`m ∘ (φ ⊗ ψ) ∘ Δ` has matrix `M_φ * M_ψ`. So `Δ` is the transpose of composing tensor-natural
endomorphisms of the fibre functor, which is how Tannaka duality characterises it. -/
theorem pointMatrix_convolution {B : Type*} [CommRing B] [Algebra R B]
    (φ ψ : Coend D →ₐ[R] B) :
    pointMatrix ((Algebra.TensorProduct.lmul' R).comp
        ((Algebra.TensorProduct.map φ ψ).comp (coendComul D))) =
      pointMatrix φ * pointMatrix ψ := by
  ext i j
  simp [pointMatrix, Matrix.mul_apply]

/-- The counit is the identity point. -/
theorem pointMatrix_counit : pointMatrix (coendCounit D) = (1 : Matrix n n R) := by
  ext i j
  simp [pointMatrix, Matrix.one_apply]

end

end QOU.Coproduct
