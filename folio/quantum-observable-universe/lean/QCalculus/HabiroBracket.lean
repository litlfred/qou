import Mathlib.Algebra.Field.Basic
import Mathlib.Algebra.Ring.Hom.Defs
import Mathlib.Tactic.Ring
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.LinearCombination

/-!
# QCalculus.HabiroBracket — the Habiro element `[2]_q` at roots of unity, algebraically

Bean `qou-gfsr` (item 5 of epic `qou-dk7p`), strangler step for the Habiro
bracket family. Owner ruling 2026-11-27: the algebraic content stays outside
`QOU/Transcendental/`; only the evaluation at a complex number goes behind it.

`bracket z = z + z⁻¹` is the image of the Habiro element `[2]_q = q + q⁻¹` at
`q = z`, in any field. Every fact the corpus used about it at roots of unity
is an identity in the field generated by the root:

* bar invariance `bracket z⁻¹ = bracket z`, the bar edge at every fibre;
* equivariance under any field map, in particular any Galois automorphism;
* at a primitive 4th root (`z² = −1`) the bracket is `0`, the modular zero;
* at a primitive 8th root (`z⁴ = −1`) the bracket squares to `2`.

The last line is the algebraic form of `[2]_{ζ₈} = √2`: the value is a square
root of `2` in `ℚ(ζ₈)`. Which square root, and that it equals the real number
`√2` under `ζ₈ = e^{πi/4}`, is the archimedean comparison, kept in
`QOU.Transcendental.QCalculus.HabiroBracketFamily`.

No empirical value enters this file.
-/

namespace QOU.Machinery.CoxeterParabolic

variable {K L : Type*} [Field K] [Field L]

/-- The Habiro element `[2]_q = q + q⁻¹` at `q = z`. -/
def bracket (z : K) : K := z + z⁻¹

/-- **Bar invariance**: `[2]_{z⁻¹} = [2]_z`. -/
theorem bracket_inv (z : K) : bracket z⁻¹ = bracket z := by
  unfold bracket; rw [inv_inv, add_comm]

/-- **Galois equivariance**: any field map commutes with the bracket. -/
theorem bracket_map (f : K →+* L) (z : K) : bracket (f z) = f (bracket z) := by
  unfold bracket; rw [map_add, map_inv₀]

/-- **ζ₄ fibre**: if `z² = −1` then `[2]_z = 0`. -/
theorem bracket_eq_zero_of_sq_eq_neg_one {z : K} (hz : z ^ 2 = -1) :
    bracket z = 0 := by
  have hz0 : z ≠ 0 := by rintro rfl; norm_num at hz
  unfold bracket
  field_simp
  linear_combination hz

/-- **ζ₈ fibre**: if `z⁴ = −1` then `[2]_z ^ 2 = 2`. -/
theorem bracket_sq_eq_two_of_pow_four_eq_neg_one {z : K} (hz : z ^ 4 = -1) :
    bracket z ^ 2 = 2 := by
  have hz0 : z ≠ 0 := by rintro rfl; norm_num at hz
  unfold bracket
  field_simp
  linear_combination hz

end QOU.Machinery.CoxeterParabolic
