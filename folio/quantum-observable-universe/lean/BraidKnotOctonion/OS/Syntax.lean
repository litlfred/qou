import Mathlib.Algebra.MonoidAlgebra.MapDomain
import Mathlib.Algebra.MonoidAlgebra.Module
import Mathlib.Algebra.FreeMonoid.Basic
import Mathlib.LinearAlgebra.Finsupp.Supported

/-!
# `QOU.OrientedSkein.OS.Syntax` — the generators and relations of the oriented skein category

Stage 3a of the formalisation of the oriented skein category `OS(z, t)` (issue #7703).

Brundan's Theorem 1.1 (arXiv 1712.08953) presents `OS(z, t)` as the strict `k`-linear monoidal
category generated by objects `E = ↑`, `F = ↓` and morphisms
`S : E ⊗ E ⟶ E ⊗ E`, `T : F ⊗ E ⟶ E ⊗ F`, `C : 𝟙 ⟶ F ⊗ E`, `D : E ⊗ F ⟶ 𝟙`.  This file sets up
the *syntax* of that presentation, with no category theory in it, so that both the construction
of `OS` (`QOU.OrientedSkein.OS.Category`) and its interpretation in an arbitrary linear monoidal
category can be built on one shared set of definitions.

## The encoding

* An object is a `Word`: a list of orientations, `true` for `E` and `false` for `F`.  Tensor
  product of objects is concatenation.
* A morphism of the free strict monoidal category on the four generators is a composite of
  *layers*: a `Step` is a generator `g` with a word `l` of strands to its left and a word `r` to
  its right, going from `l ++ (g.src ++ r)` to `l ++ (g.tgt ++ r)`.  A composable string of
  layers is a list `π : List Step` with `Valid x π y`.
* Formal `R`-linear combinations of lists of layers form the monoid algebra
  `PA R = MonoidAlgebra R (FreeMonoid Step)`, whose multiplication is concatenation, i.e.
  composition in diagrammatic order.  The morphisms `x ⟶ y` of the free linear category are the
  elements supported on valid lists (`supp x y`).

Validity is a proposition about plain data, never a type index, so whiskering a layer, which
changes the words `l` and `r`, is just a function on `Step`: no transport along equalities of
words is ever needed.  This is the design point of the file.

## The relations (`Rel`)

Brundan's relations, in the form of `QOU.OrientedSkein.OrientedSkeinDatum`, with parameters
`q qi t δ : R`:

* `quad` — `S S = (q - qi) S + (q qi) 1` on `E E`;
* `braid` — `S₁ S₂ S₁ = S₂ S₁ S₂` on `E E E`;
* `zigE`, `zigF` — the two zigzag (snake) relations for the cup `C` and cap `D`;
* `TS`, `ST` — `T` is inverse to the sideways crossing `(C ▷ E F) (F ◁ S ▷ F) (F E ◁ D)`;
* `dim` — `t · C T D = δ · 1` on the empty word;
* `ichg g g' m` — the interchange law for two generators with the strands `m` between them,
  which is what makes the free *category* on layers into the free *monoidal* category.

Sorry-free.

## References

* [brundan2017] J. Brundan, *Representations of the oriented skein category*, arXiv 1712.08953,
  Theorem 1.1.
-/

namespace QOU.OrientedSkein.OS

/-- An object of the oriented skein category: a word in `E` (`true`) and `F` (`false`). -/
abbrev Word := List Bool

/-- The four generating morphisms of `OS(z, t)`. -/
inductive Gen
  | S
  | T
  | C
  | D
  deriving DecidableEq

namespace Gen

/-- Source of a generator: `S : E E`, `T : F E`, `C : 𝟙`, `D : E F`. -/
def src : Gen → Word
  | S => [true, true]
  | T => [false, true]
  | C => []
  | D => [true, false]

/-- Target of a generator: `S : E E`, `T : E F`, `C : F E`, `D : 𝟙`. -/
def tgt : Gen → Word
  | S => [true, true]
  | T => [true, false]
  | C => [false, true]
  | D => []

end Gen

/-- A **layer**: the generator `g` with the strands `l` to its left and `r` to its right. -/
@[ext]
structure Step where
  /-- Strands to the left of the generator. -/
  l : Word
  /-- The generator. -/
  g : Gen
  /-- Strands to the right of the generator. -/
  r : Word
  deriving DecidableEq

namespace Step

/-- Source of a layer. -/
def src (s : Step) : Word := s.l ++ (s.g.src ++ s.r)

/-- Target of a layer. -/
def tgt (s : Step) : Word := s.l ++ (s.g.tgt ++ s.r)

/-- Whisker a layer by `a` on the left and `b` on the right. -/
def whisk (a b : Word) (s : Step) : Step := ⟨a ++ s.l, s.g, s.r ++ b⟩

@[simp] theorem whisk_l (a b : Word) (s : Step) : (s.whisk a b).l = a ++ s.l := rfl
@[simp] theorem whisk_g (a b : Word) (s : Step) : (s.whisk a b).g = s.g := rfl
@[simp] theorem whisk_r (a b : Word) (s : Step) : (s.whisk a b).r = s.r ++ b := rfl

theorem whisk_src (a b : Word) (s : Step) : (s.whisk a b).src = a ++ (s.src ++ b) := by
  simp [src, whisk]

theorem whisk_tgt (a b : Word) (s : Step) : (s.whisk a b).tgt = a ++ (s.tgt ++ b) := by
  simp [tgt, whisk]

@[simp] theorem whisk_nil (s : Step) : s.whisk [] [] = s := by
  ext <;> simp [whisk]

theorem whisk_whisk (a b c d : Word) (s : Step) :
    (s.whisk a b).whisk c d = s.whisk (c ++ a) (b ++ d) := by
  ext <;> simp [whisk]

theorem whisk_comp (a b c d : Word) :
    Step.whisk c d ∘ Step.whisk a b = Step.whisk (c ++ a) (b ++ d) :=
  funext (whisk_whisk a b c d)

end Step

/-- `Valid x π y`: the list of layers `π` is a composable string from `x` to `y`. -/
def Valid : Word → List Step → Word → Prop
  | x, [], y => x = y
  | x, s :: π, y => x = s.src ∧ Valid s.tgt π y

@[simp] theorem valid_nil (x y : Word) : Valid x [] y ↔ x = y := Iff.rfl

@[simp] theorem valid_cons (x y : Word) (s : Step) (π : List Step) :
    Valid x (s :: π) y ↔ x = s.src ∧ Valid s.tgt π y := Iff.rfl

theorem valid_refl (x : Word) : Valid x [] x := rfl

/-- The target of a valid string is determined by its source. -/
theorem Valid.unique {x y y' : Word} : ∀ {π : List Step}, Valid x π y → Valid x π y' → y = y'
  | [], h, h' => h.symm.trans h'
  | _ :: _, h, h' => Valid.unique h.2 h'.2

/-- The source of a valid string is determined by its target. -/
theorem Valid.unique_left {x x' y : Word} : ∀ {π : List Step}, Valid x π y → Valid x' π y → x = x'
  | [], h, h' => h.trans h'.symm
  | _ :: _, h, h' => h.1.trans h'.1.symm

theorem Valid.append {x y z : Word} :
    ∀ {π π' : List Step}, Valid x π y → Valid y π' z → Valid x (π ++ π') z
  | [], _, h, h' => by subst h; exact h'
  | _ :: _, _, h, h' => ⟨h.1, Valid.append h.2 h'⟩

theorem valid_append {x z : Word} :
    ∀ {π π' : List Step}, Valid x (π ++ π') z ↔ ∃ y, Valid x π y ∧ Valid y π' z
  | [], _ => ⟨fun h => ⟨x, rfl, h⟩, fun ⟨_, h, h'⟩ => by subst h; exact h'⟩
  | s :: π, π' => by
      simp only [List.cons_append, valid_cons]
      rw [valid_append]
      constructor
      · rintro ⟨h1, y, h2, h3⟩; exact ⟨y, ⟨h1, h2⟩, h3⟩
      · rintro ⟨y, ⟨h1, h2⟩, h3⟩; exact ⟨h1, y, h2, h3⟩

/-- Whiskering preserves validity. -/
theorem Valid.whisk (a b : Word) {x y : Word} :
    ∀ {π : List Step}, Valid x π y → Valid (a ++ (x ++ b)) (π.map (Step.whisk a b)) (a ++ (y ++ b))
  | [], h => by subst h; rfl
  | s :: _, h => ⟨by rw [h.1, Step.whisk_src], by
      have := Valid.whisk a b h.2
      rwa [← Step.whisk_tgt] at this⟩

/-! ## The path algebra -/

variable (R : Type*) [CommRing R]

/-- The **path algebra**: formal `R`-linear combinations of lists of layers, multiplied by
concatenation (composition in diagrammatic order). -/
abbrev PA := MonoidAlgebra R (FreeMonoid Step)

variable {R}

/-- The basis element of `PA R` attached to a list of layers. -/
noncomputable def pth (π : List Step) : PA R := Finsupp.single (FreeMonoid.ofList π) 1

theorem pth_mul (π π' : List Step) : (pth π : PA R) * pth π' = pth (π ++ π') := by
  simp [pth, MonoidAlgebra.single_mul_single, FreeMonoid.ofList_append]

theorem pth_nil : (pth [] : PA R) = 1 := rfl

variable (R)

/-- The `R`-submodule of `PA R` supported on valid strings from `x` to `y`: the hom-module
`x ⟶ y` of the free linear monoidal category on the four generators. -/
def supp (x y : Word) : Submodule R (PA R) :=
  Finsupp.supported R R {m : FreeMonoid Step | Valid x (FreeMonoid.toList m) y}

variable {R}

theorem pth_mem_supp {x y : Word} {π : List Step} (h : Valid x π y) : (pth π : PA R) ∈ supp R x y :=
  Finsupp.single_mem_supported R _ h

/-- Whiskering on the path algebra, by `a` on the left and `b` on the right. -/
noncomputable def whiskA (a b : Word) : PA R →ₗ[R] PA R :=
  Finsupp.lmapDomain R R (FreeMonoid.map (Step.whisk a b))

theorem whiskA_single (a b : Word) (m : FreeMonoid Step) (r : R) :
    whiskA a b (Finsupp.single m r : PA R) =
      Finsupp.single (FreeMonoid.ofList (m.toList.map (Step.whisk a b))) r :=
  Finsupp.mapDomain_single

theorem whiskA_pth (a b : Word) (π : List Step) :
    whiskA a b (pth π : PA R) = pth (π.map (Step.whisk a b)) :=
  whiskA_single a b _ 1

theorem whiskA_mul (a b : Word) (f g : PA R) : whiskA a b (f * g) = whiskA a b f * whiskA a b g :=
  MonoidAlgebra.mapDomain_mul (FreeMonoid.map (Step.whisk a b)) f g

theorem whiskA_one (a b : Word) : whiskA a b (1 : PA R) = 1 := by
  rw [← pth_nil, whiskA_pth]; rfl

theorem whiskA_whiskA (a b c d : Word) (f : PA R) :
    whiskA c d (whiskA a b f) = whiskA (c ++ a) (b ++ d) f := by
  induction f using Finsupp.induction_linear with
  | zero => simp
  | add f g hf hg => rw [map_add, map_add, map_add, hf, hg]
  | single m r =>
      rw [whiskA_single, whiskA_single, whiskA_single]
      congr 1
      simp [List.map_map, Step.whisk_comp]

theorem whiskA_nil (f : PA R) : whiskA [] [] f = f := by
  induction f using Finsupp.induction_linear with
  | zero => simp
  | add f g hf hg => rw [map_add, hf, hg]
  | single m r =>
      rw [whiskA_single, show Step.whisk [] [] = id from funext Step.whisk_nil, List.map_id]
      rfl

/-- Whiskering maps `supp x y` into `supp (a ++ (x ++ b)) (a ++ (y ++ b))`. -/
theorem whiskA_mem_supp (a b : Word) {x y : Word} {f : PA R} (hf : f ∈ supp R x y) :
    whiskA a b f ∈ supp R (a ++ (x ++ b)) (a ++ (y ++ b)) := by
  classical
  rw [supp, Finsupp.mem_supported] at hf ⊢
  intro m hm
  obtain ⟨m', hm', rfl⟩ := Finset.mem_image.mp (Finsupp.mapDomain_support hm)
  show Valid _ (FreeMonoid.toList (FreeMonoid.map _ m')) _
  rw [FreeMonoid.toList_map]
  exact Valid.whisk a b (hf hm')

/-! ## The relations -/

/-- Brundan's **sideways crossing** as a string of layers `E F ⟶ F E`:
the cup `C` on the left, then `S` on the middle two strands, then the cap `D` on the right. -/
def sidewaysPath : List Step :=
  [⟨[], .C, [true, false]⟩, ⟨[false], .S, [false]⟩, ⟨[false, true], .D, []⟩]

/-- The defining relations of `OS(z, t)`. -/
inductive Rel
  /-- `S S = (q - qi) S + (q qi) 1`. -/
  | quad
  /-- `S₁ S₂ S₁ = S₂ S₁ S₂`. -/
  | braid
  /-- The zigzag `(E ◁ C) (D ▷ E) = 1_E`. -/
  | zigE
  /-- The zigzag `(C ▷ F) (F ◁ D) = 1_F`. -/
  | zigF
  /-- `T` followed by the sideways crossing is `1_{F E}`. -/
  | TS
  /-- The sideways crossing followed by `T` is `1_{E F}`. -/
  | ST
  /-- `t · C T D = δ · 1_𝟙`. -/
  | dim
  /-- The interchange law for the generators `g` and `g'`, with the strands `m` between them. -/
  | ichg (g g' : Gen) (m : Word)

namespace Rel

/-- The source word of a relation. -/
def src : Rel → Word
  | quad => [true, true]
  | braid => [true, true, true]
  | zigE => [true]
  | zigF => [false]
  | TS => [false, true]
  | ST => [true, false]
  | dim => []
  | ichg g g' m => g.src ++ (m ++ g'.src)

/-- The target word of a relation. -/
def tgt : Rel → Word
  | quad => [true, true]
  | braid => [true, true, true]
  | zigE => [true]
  | zigF => [false]
  | TS => [false, true]
  | ST => [true, false]
  | dim => []
  | ichg g g' m => g.tgt ++ (m ++ g'.tgt)

variable (q qi t δ : R)

/-- The left-hand side of a relation. -/
noncomputable def lhs : Rel → PA R
  | quad => pth [⟨[], .S, []⟩, ⟨[], .S, []⟩]
  | braid => pth [⟨[], .S, [true]⟩, ⟨[true], .S, []⟩, ⟨[], .S, [true]⟩]
  | zigE => pth [⟨[true], .C, []⟩, ⟨[], .D, [true]⟩]
  | zigF => pth [⟨[], .C, [false]⟩, ⟨[false], .D, []⟩]
  | TS => pth (⟨[], .T, []⟩ :: sidewaysPath)
  | ST => pth (sidewaysPath ++ [⟨[], .T, []⟩])
  | dim => t • pth [⟨[], .C, []⟩, ⟨[], .T, []⟩, ⟨[], .D, []⟩]
  | ichg g g' m => pth [⟨[], g, m ++ g'.src⟩, ⟨g.tgt ++ m, g', []⟩]

/-- The right-hand side of a relation. -/
noncomputable def rhs : Rel → PA R
  | quad => (q - qi) • pth [⟨[], .S, []⟩] + (q * qi) • pth []
  | braid => pth [⟨[true], .S, []⟩, ⟨[], .S, [true]⟩, ⟨[true], .S, []⟩]
  | zigE => pth []
  | zigF => pth []
  | TS => pth []
  | ST => pth []
  | dim => δ • pth []
  | ichg g g' m => pth [⟨g.src ++ m, g', []⟩, ⟨[], g, m ++ g'.tgt⟩]

/-- The relator `lhs - rhs`. -/
noncomputable def rel (ρ : Rel) : PA R := ρ.lhs t - ρ.rhs q qi δ

theorem lhs_mem (ρ : Rel) : ρ.lhs t ∈ supp R ρ.src ρ.tgt := by
  cases ρ <;>
    first
    | exact pth_mem_supp (by simp [sidewaysPath, Step.src, Step.tgt, Gen.src, Gen.tgt, src, tgt])
    | exact Submodule.smul_mem _ _
        (pth_mem_supp (by simp [Step.src, Step.tgt, Gen.src, Gen.tgt, src, tgt]))

theorem rhs_mem (ρ : Rel) : ρ.rhs q qi δ ∈ supp R ρ.src ρ.tgt := by
  cases ρ <;>
    first
    | exact pth_mem_supp (by simp [Step.src, Step.tgt, Gen.src, Gen.tgt, src, tgt])
    | exact Submodule.smul_mem _ _
        (pth_mem_supp (by simp [Step.src, Step.tgt, Gen.src, Gen.tgt, src, tgt]))
    | exact Submodule.add_mem _
        (Submodule.smul_mem _ _ (pth_mem_supp (by simp [Step.src, Step.tgt, Gen.src, Gen.tgt, src, tgt])))
        (Submodule.smul_mem _ _ (pth_mem_supp (by simp [Step.src, Step.tgt, Gen.src, Gen.tgt, src, tgt])))

theorem rel_mem (ρ : Rel) : ρ.rel q qi t δ ∈ supp R ρ.src ρ.tgt :=
  Submodule.sub_mem _ (ρ.lhs_mem t) (ρ.rhs_mem q qi δ)

end Rel

end QOU.OrientedSkein.OS
