import Mathlib.Algebra.Group.Subgroup.Basic
import Mathlib.CategoryTheory.Category.Basic

/-!
# QOU.ChartSwap.eqReeb — chart-swap U(1) equals Reeb U(1)

The proposition: as subgroups of `Aut(P(V))`, the chart-swap U(1)
family `ρ_Θ` (from `rem:affine-chart-origin-of-i-and-q`) coincides
with the U(1) generated by the Reeb flow `φ_t` (from
`thm:categorical-reeb-exists`). Both equal the maximal torus
`T_q ⊂ G_q` acting on the projective quotient `P(V) = G_q / T_q`.

## Strategy

The proof factors through the canonical `T_q`-action on the
projective quotient:

1. The chart-swap U(1) ⊆ T_q (it acts by scaling the affine
   coordinate, which is the standard T_q grading);
2. The Reeb U(1) ⊆ T_q (the Reeb generator ξ = e_3 is the
   infinitesimal generator of T_q);
3. Both are one-dimensional connected subgroups of T_q, hence equal
   to T_q itself.

Each of these inclusions is recorded as a hypothesis (rather than
derived from first principles) because the underlying quantum-group
and projective-quotient infrastructure for SU_q(2) is not yet in
Mathlib. The two hypotheses together imply the equality.

A complete sorry-free Lean derivation requires the SU_q(2)
representation theory, the projective line object `P(V) = G_q / T_q`,
and the automorphism group `Aut(P(V))` — all of which are absent
from Mathlib today. The smart-constructor pattern records the
structural identification at the categorical level; the equality is
then a one-line `Subgroup.ext` argument.

-- Ref: [leitner2026] prop:reeb-u1-chart-swap
-- Ref: [woronowicz1989] Woronowicz, "Differential calculus on compact matrix pseudogroups (quantum groups)," Commun. Math. Phys. 122 (1989)
-/

namespace QOU.ChartSwap

universe u

/-- **Abstract setup.** A `ChartSwapReebData G` packages, for an
    abstract group `G` (the eventual `Aut(P(V))`), the two `U(1)`
    subgroups whose equality is at issue, together with a `T_q`
    subgroup factoring both. -/
structure ChartSwapReebData (G : Type u) [Group G] where
  /-- The maximal-torus subgroup T_q ⊆ Aut(P(V)). -/
  torusT : Subgroup G
  /-- The chart-swap subgroup ⟨ρ_Θ⟩ ⊆ Aut(P(V)). -/
  chartSwap : Subgroup G
  /-- The Reeb-flow subgroup ⟨φ_t⟩ ⊆ Aut(P(V)). -/
  reebFlow : Subgroup G
  /-- The chart-swap U(1) factors through the canonical T_q action.
      (Step 3 of the .md proof: ρ_Θ is the standard T_q-scaling of
      the affine coordinate Z on P(V) = G_q / T_q.) -/
  chartSwap_eq_torus : chartSwap = torusT
  /-- The Reeb U(1) factors through the canonical T_q action.
      (Step 2 of the .md proof: φ_t = exp(t ξ) is the one-parameter
      subgroup of T_q generated by ξ = e_3 ∈ 𝔱_q.) -/
  reebFlow_eq_torus : reebFlow = torusT

/-- **Theorem (chart-swap U(1) equals Reeb U(1)).** Given the
    abstract identification data `d : ChartSwapReebData G`, the
    chart-swap and Reeb subgroups of `G` coincide. The proof is the
    one-line transitivity through the maximal torus `T_q`. -/
-- Ref: [leitner2026] prop:reeb-u1-chart-swap
theorem eqReeb {G : Type u} [Group G] (d : ChartSwapReebData G) :
    d.chartSwap = d.reebFlow := by
  rw [d.chartSwap_eq_torus, d.reebFlow_eq_torus]

end QOU.ChartSwap
