import Mathlib.Data.List.Basic
import Mathlib.Data.Nat.Basic

/-!
# QOU.Molecular.ParabolicHecke — parabolic Young Hecke subalgebra

The parabolic subalgebra $H_\lambda(q) = H_{n_1}(q) \otimes \cdots \otimes
H_{n_k}(q) \hookrightarrow H_N(q)$ attached to a molecular
strand-partition $\lambda$.  Combinatorially it is generated by the
intra-block Coxeter/Hecke generators (there are $N - k$ of them); the
$k - 1$ cross-block generators are the bonding degrees of freedom.

This file carries the strand-partition data directly (it does not import
`StrandPartition`) so that it builds standalone, matching the
content-block `.lean` convention.

## References
- [kassel1995] Kassel, "Quantum Groups," GTM 155, §IV (Hecke algebras)
- [leitner2026] Ch. 12, Definition: Parabolic Hecke subalgebra
-/

namespace QOU.Molecular

/-- The parabolic Young Hecke subalgebra `H_λ ↪ H_N`, indexed by the
    per-sub-unit strand counts `(n₁,…,n_k)`. -/
-- Ref: [kassel1995] Kassel, "Quantum Groups," GTM 155
structure ParabolicHecke where
  /-- Per-sub-unit strand counts. -/
  parts : List ℕ
  /-- Every sub-unit carries at least one strand. -/
  parts_pos : ∀ n ∈ parts, 0 < n

namespace ParabolicHecke

/-- Total strand count `N = Σ nᵢ`. -/
def total (H : ParabolicHecke) : ℕ := H.parts.sum

/-- Number of sub-units `k`. -/
def numUnits (H : ParabolicHecke) : ℕ := H.parts.length

/-- Intra-unit generators `Σ (nᵢ - 1) = N - k`. -/
def numGenerators (H : ParabolicHecke) : ℕ := (H.parts.map (· - 1)).sum

/-- Bonding (cross-block) generators `k - 1`, one per join. -/
def numBondingGenerators (H : ParabolicHecke) : ℕ := H.numUnits - 1

/-- The benzene parabolic `(2,2,2)`: three two-strand acetylene units. -/
def benzene : ParabolicHecke := ⟨[2, 2, 2], by decide⟩

/-- Benzene parabolic has `N - k = 3` intra-unit generators. -/
theorem benzene_numGenerators : benzene.numGenerators = 3 := by decide

/-- Benzene parabolic has `k - 1 = 2` bonding generators. -/
theorem benzene_numBondingGenerators : benzene.numBondingGenerators = 2 := by
  decide

end ParabolicHecke
end QOU.Molecular
