/-
  Weak-sector symmetric-channel Plancherel normalization.

  Companion: weak-symmetric-normalization.md
  Path: folio/quantum-observable-universe/mass-theory/

  Defines the closed-form polynomial
    N_sym(q) = q^4 · (1 + q² + q⁴) / 3
             = (q^4 + q^6 + q^8) / 3 ∈ R[1/3]
  and proves its two algebraic forms.  The polynomial and both
  identities are UNCONDITIONAL algebra.

  What is conditional is the *reading* of this polynomial as the EW
  symmetric-channel Plancherel weight.  The premises of that reading are
  bundled, with content, in the class `WeakSymmetricNormalization` below:
    * `conj:weak-spectral-completeness` — the EW-sector content is
      exhausted by the commutative subalgebra `H₂(q)^{⊗3} ⊂ H₆(q)`
      generated by the far-commuting `σ₁, σ₃, σ₅` (three commuting copies
      of the pair `(e⁺, e⁻)`); class
      `QOU.Conjectures.WeakSpectralCompleteness`, no instance;
    * `conj:electroweak-higgs-torus-link-triplet` — the EW carriers are
      exactly `T(2,4), T(2,6), T(2,8)` with `H` the singlet and `W, Z`
      doublets; class `EWLinkTripletIdentified` below, no instance.
  GAP: no Lean theorem derives the Plancherel-weight reading of `N_sym`
  from that bundle.  The bundle records the premises; it does not close
  the derivation.

  Categorical-ring discipline (§7c): `R` is a generic commutative ring;
  positivity claims are deferred to real-closed specializations.

  Ref: [kassel1995] Kassel, "Quantum Groups," Springer
       1995, §VI (Iwahori-Hecke algebra Wedderburn decomposition
       + Frobenius trace).
-/

import Mathlib.Algebra.Algebra.Basic
import Mathlib.Tactic.Ring
import QOU.Conjectures.WeakSpectralCompleteness

namespace QOU.BraidsAndKnots

/--
  Predicate: `q : R` is a root of unity in `R`.
-/
def IsRootOfUnity {R : Type*} [Monoid R] (q : R) : Prop :=
  ∃ n : ℕ, n > 0 ∧ q ^ n = 1

/--
  **Conjecture class: the EW link triplet is identified**
  (`conj:electroweak-higgs-torus-link-triplet`).

  `isCarrier k` is the model's electroweak-carrier predicate on the twist
  `k` of `T(2, 2k)`, and `isSinglet k` the model's spin-sector map
  (`true` = singlet `A₊`, `false` = doublet `A₋`).  Both are parameters,
  so an instance cannot choose them.  The class asserts:
  the carriers are exactly `T(2,4), T(2,6), T(2,8)` (`k ∈ {2,3,4}`),
  `H ↔ T(2,8)` is the singlet, and `W ↔ T(2,4)`, `Z ↔ T(2,6)` are doublets.

  This restates the content of
  `QOU.ParticleInteractions.EWHiggsTorusLinkTriplet` together with its
  enumeration node `EWSectorEnumeration`
  (`knots-particles-confinement/electroweak-higgs-torus-link-triplet.lean`).
  That file is a content-block sibling, not a library module, so it cannot
  be imported here; the restatement is kept field-for-field with it.
  No instance: the identification is open.
-/
-- @conjecture: primary
class EWLinkTripletIdentified (isCarrier : ℕ → Prop) (isSinglet : ℕ → Bool) :
    Prop where
  /-- The carrier set is exactly `{2, 3, 4}`, i.e. `{T(2,4), T(2,6), T(2,8)}`. -/
  carriers_eq : ∀ k, isCarrier k ↔ (k = 2 ∨ k = 3 ∨ k = 4)
  /-- `H` (`k = 4`, `T(2,8)`) is the singlet. -/
  higgs_singlet : isSinglet 4 = true
  /-- `W` (`k = 2`, `T(2,4)`) is a doublet. -/
  w_doublet : isSinglet 2 = false
  /-- `Z` (`k = 3`, `T(2,6)`) is a doublet. -/
  z_doublet : isSinglet 3 = false

/--
  The premise bundle under which `weak_symmetric_normalization q` is read
  as the EW symmetric-channel Plancherel weight.

  Model data, all parameters: an `R`-algebra `A` (the Hecke action on
  `V^{⊗6}`), the three EW generators `s₁, s₃, s₅` (`W ↔ σ₁⁴`, `Z ↔ σ₃⁶`,
  `H ↔ σ₅⁸`), the EW-sector subalgebra `ew`, and the carrier/sector maps.

  Fields:
  - `q` is not a root of unity in `R` (so `q ≠ 1`);
  - each generator satisfies the Hecke quadratic at this `q`, written
    without `q⁻¹` as `q·s² = (q² − 1)·s + q`;
  - the generators pairwise commute (far-commuting strand pairs);
  - `conj:weak-spectral-completeness` holds for this data;
  - `conj:electroweak-higgs-torus-link-triplet` holds for this data.

  No instance: both conjectural fields are open.
-/
class WeakSymmetricNormalization
    (R : Type*) [CommRing R] (q : R)
    (A : Type*) [Ring A] [Algebra R A] (s₁ s₃ s₅ : A) (ew : Subalgebra R A)
    (isCarrier : ℕ → Prop) (isSinglet : ℕ → Bool) : Prop where
  /-- Generic-q hypothesis: q is NOT a root of unity in R. -/
  q_not_root_of_unity : ¬ IsRootOfUnity q
  /-- Hecke quadratic `σ² = (q − q⁻¹)σ + 1`, multiplied through by `q`. -/
  hecke_quadratic : ∀ s ∈ ({s₁, s₃, s₅} : Set A),
    algebraMap R A q * (s * s) = algebraMap R A (q ^ 2 - 1) * s + algebraMap R A q
  /-- `σ₁, σ₃, σ₅` act on disjoint strand pairs and commute. -/
  far_commute : s₁ * s₃ = s₃ * s₁ ∧ s₁ * s₅ = s₅ * s₁ ∧ s₃ * s₅ = s₅ * s₃
  /-- Upstream: `conj:weak-spectral-completeness` (exhaustion by
      `Algebra.adjoin R {s₁, s₃, s₅}`). -/
  spectral_completeness : QOU.Conjectures.WeakSpectralCompleteness R A s₁ s₃ s₅ ew
  /-- Upstream: `conj:electroweak-higgs-torus-link-triplet`. -/
  link_triplet : EWLinkTripletIdentified isCarrier isSinglet

/--
  The symmetric-channel normalization in `R[1/3]`:

    N_sym(q) := (q^4 + q^6 + q^8) / 3
              = q^4 · (1 + q^2 + q^4) / 3
              = q^4 · [3]_{q^2} / 3.

  Requires `R` to contain `1/3` (i.e. `Invertible (3 : R)`); this
  holds for the canonical specializations `R = ℚ(q)` and
  `R = ℚ[q, q⁻¹]`.

  This is unconditional algebra and takes no `WeakSymmetricNormalization`
  hypothesis (an earlier version carried that instance as an unused
  argument whose fields were `True`).  Its reading as the EW
  symmetric-channel weight rests on the premises bundled in
  `WeakSymmetricNormalization`, and is not derived in Lean.
-/
noncomputable def weak_symmetric_normalization
    {R : Type*} [CommRing R] [Invertible (3 : R)]
    (q : R) :
    R :=
  ⅟(3 : R) * (q^4 + q^6 + q^8)

/-- Algebraic-identity form: factor `q^4` out of the expression. -/
theorem weak_symmetric_normalization_factored
    {R : Type*} [CommRing R] [Invertible (3 : R)]
    (q : R) :
    weak_symmetric_normalization q
      = ⅟(3 : R) * q^4 * (1 + q^2 + q^4) := by
  -- Ref: [leitner2026] weak-symmetric-normalization.md §"Statement (formal)"
  unfold weak_symmetric_normalization
  ring

/-- Direct unfold of the definition. -/
theorem weak_symmetric_normalization_eq
    {R : Type*} [CommRing R] [Invertible (3 : R)]
    (q : R) :
    weak_symmetric_normalization q
      = ⅟(3 : R) * (q^4 + q^6 + q^8) := by
  -- Ref: [kassel1995] https://link.springer.com/book/10.1007/978-1-4612-0783-2
  -- Ref: [leitner2026] weak-symmetric-normalization.md §"Statement (formal)"
  rfl

end QOU.BraidsAndKnots
