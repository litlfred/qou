import Mathlib.Algebra.Ring.Basic
import Mathlib.Tactic.Ring
import Mathlib.Tactic.LinearCombination
import Mathlib.Tactic.NoncommRing

/-!
# Flavor-Split Topological Derivation

This file formally derives the exact topological flavor split between
the proton and neutron. Topologically, the proton and neutron are related
by the Hopf antipode (chiral crossing reversal).

In the Hecke algebra H_n(q), the standard generator σ satisfies the quadratic relation:
  σ^2 = h·σ + 1
where h = q - q⁻¹.

This formal proof establishes that the bare algebraic difference between the proton
braid (σ^3) and the neutron braid (σ⁻³) is a pure central scalar equal to h(h^2 + 3).
This analytically eliminates the chiral matrix structure and confirms that the
bare mass difference Δm_pn is strictly driven by the scalar crossing energy h(h^2 + 3),
which is identical to q^3 - q⁻³.

## The commutativity hypothesis was stronger than the setting (2026-09-03)

`topological_flavor_split` was stated over `CommRing R` and scoped in prose to
"a commutative subring generated by a single Hecke generator". **H_n(q) is not
commutative for n ≥ 3**, so applying it needed that scoping argument to be made
by the reader, outside Lean.

It does not need commutativity. Every element in the computation is a
polynomial in σ and h, and `h = q - q⁻¹` is a **scalar**, hence central in
H_n(q). `topological_flavor_split_of_central` below states exactly that, and
is strictly stronger in three ways:

* `Ring R` rather than `CommRing R` — it applies to H_n(q) directly;
* only `h` is required to commute, which is what the physics supplies;
* only a **left** inverse `σ⁻¹σ = 1` is needed. The right inverse was a
  hypothesis of the original and is never used: given the quadratic, a left
  inverse already forces `σ⁻¹ = σ - h`.

The `CommRing` form is retained under its original name, now **derived** from
the general one rather than proved separately, so nothing citing it changes.

The physical identification — that Δm_pn *is* this scalar — is the conjectural
content and is deliberately not in the Lean; the block is a `conjecture` for
that reason, not because the algebra is open.
-/

namespace QOU.FlavorSplit

/-- **The flavour split over an arbitrary ring, with `h` central.**

    In any ring in which the Hecke quadratic `σ² = hσ + 1` holds, `h` is
    central, and `σ` has a **left** inverse, the difference between the proton
    braid `σ³` and the neutron braid `σ⁻³` is the scalar `h(h² + 3)`.

    Commutativity of the ambient ring is not needed — which matters, because
    H_n(q) does not have it for n ≥ 3, while `h = q - q⁻¹` is a scalar and so
    is central there. Nor is a right inverse: given the quadratic, a left
    inverse already forces `σ⁻¹ = σ - h`.

    The proof routes through the *conjugate* quadratic `σ⁻² = 1 - hσ⁻¹`
    satisfied by the mirror generator, then reads each cubic off its own
    quadratic. Centrality is used at exactly one step, squaring `σ - h`. -/
-- Ref: [leitner2026] conj:flavor-split-habiro-derivation
theorem topological_flavor_split_of_central
    {R : Type*} [Ring R]
    (σ σ_inv h : R)
    (hcen : ∀ x : R, h * x = x * h)
    (h_quad : σ ^ 2 = h * σ + 1)
    (h_left : σ_inv * σ = 1) :
    σ ^ 3 - σ_inv ^ 3 = h * (h ^ 2 + 3) := by
  have h1 : σ ^ 2 - h * σ = 1 := by rw [h_quad]; noncomm_ring
  have hσinv : σ_inv = σ - h := by
    calc σ_inv = σ_inv * 1 := by rw [mul_one]
      _ = σ_inv * (σ ^ 2 - h * σ) := by rw [h1]
      _ = (σ_inv * σ) * σ - (σ_inv * h) * σ := by noncomm_ring
      _ = (σ_inv * σ) * σ - (h * σ_inv) * σ := by rw [hcen σ_inv]
      _ = (σ_inv * σ) * σ - h * (σ_inv * σ) := by noncomm_ring
      _ = σ - h := by rw [h_left]; noncomm_ring
  -- the mirror generator satisfies the conjugate quadratic
  have h_quad' : σ_inv ^ 2 = 1 - h * σ_inv := by
    rw [hσinv]
    have hx : (σ - h) ^ 2 = σ ^ 2 - (h * σ + σ * h) + h ^ 2 := by noncomm_ring
    rw [hx, ← hcen σ, h_quad]
    noncomm_ring
  -- each cubic follows from its own quadratic; no commutation needed here
  have hc : σ ^ 3 = h ^ 2 * σ + h + σ := by
    have e : σ ^ 3 = σ ^ 2 * σ := by noncomm_ring
    rw [e, h_quad]
    have e2 : (h * σ + 1) * σ = h * σ ^ 2 + σ := by noncomm_ring
    rw [e2, h_quad]; noncomm_ring
  have hc' : σ_inv ^ 3 = h ^ 2 * σ_inv - h + σ_inv := by
    have e : σ_inv ^ 3 = σ_inv ^ 2 * σ_inv := by noncomm_ring
    rw [e, h_quad']
    have e2 : (1 - h * σ_inv) * σ_inv = σ_inv - h * σ_inv ^ 2 := by noncomm_ring
    rw [e2, h_quad']; noncomm_ring
  have hdiff : σ - σ_inv = h := by rw [hσinv]; noncomm_ring
  rw [hc, hc']
  have e : h ^ 2 * σ + h + σ - (h ^ 2 * σ_inv - h + σ_inv)
       = h ^ 2 * (σ - σ_inv) + (σ - σ_inv) + 2 * h := by noncomm_ring
  rw [e, hdiff]; noncomm_ring

set_option linter.unusedVariables false in
/-- The commutative specialisation, kept under its original name so that
    citations do not move. Now **derived** from
    `topological_flavor_split_of_central` rather than proved separately: in a
    commutative ring every element is central, and the right inverse `h_inv1`
    is retained only for signature compatibility — the proof does not use it.

    The `unusedVariables` linter is silenced on this declaration deliberately:
    the warning it emits IS the finding — `h_inv1` was a hypothesis of the
    original statement and is never needed — so it is recorded here rather
    than removed by dropping the binder, which would move the signature. -/
theorem topological_flavor_split
    {R : Type} [CommRing R]
    (σ σ_inv h : R)
    (h_quad : σ^2 = h * σ + 1)
    (h_inv1 : σ * σ_inv = 1)
    (h_inv2 : σ_inv * σ = 1) :
    σ^3 - σ_inv^3 = h * (h^2 + 3) :=
  topological_flavor_split_of_central σ σ_inv h (fun x => mul_comm h x) h_quad h_inv2

/-- The $H_4$ alternating representation evaluation of the weak vertex insertion.
    In the alternating (sign) channel representing left-handed fermions, the Hecke
    generator evaluates to its alternating eigenvalue: σ = -q⁻¹.
    Thus, the 2-vertex insertion σ⁻² evaluates to q².
    This theorem formalizes that this insertion expands exactly as 1 + h·q. -/
theorem alternating_projection_weak_vertex
    {R : Type} [CommRing R]
    (q q_inv h : R)
    (h_def : h = q - q_inv)
    (h_inv : q * q_inv = 1) :
    q^2 = 1 + h * q := by
  -- Substitute h = q - q_inv and use q · q_inv = 1:
  --   1 + h·q = 1 + (q - q_inv)·q = 1 + q² - q_inv·q = 1 + q² - 1 = q².
  subst h_def
  linear_combination h_inv

/-- **Class-axiomatised bare nucleon flavour-split identification (`conj:flavor-split-habiro-derivation`, §3b-cond).**
    Identifies the bare chiral braid-difference mass functional with `scale * (σ³ - σ⁻³)`. -/
class FlavorSplitHabiroConjecture (R : Type*) [Ring R] (σ σ_inv h : R) where
  h_central : ∀ x : R, h * x = x * h
  hecke_quad : σ ^ 2 = h * σ + 1
  left_inv : σ_inv * σ = 1
  bareMassDiff : R
  massScale : R
  diff_eq_braid_cube : bareMassDiff = massScale * (σ ^ 3 - σ_inv ^ 3)

/-- **Conditional theorem.** Under `[FlavorSplitHabiroConjecture R σ σ_inv h]`,
    `bareMassDiff = massScale * (h * (h ^ 2 + 3))`. -/
theorem bareMassDiff_eq_scalar_crossing {R : Type*} [Ring R] (σ σ_inv h : R)
    [c : FlavorSplitHabiroConjecture R σ σ_inv h] :
    c.bareMassDiff = c.massScale * (h * (h ^ 2 + 3)) := by
  rw [c.diff_eq_braid_cube,
    topological_flavor_split_of_central σ σ_inv h c.h_central c.hecke_quad c.left_inv]

end QOU.FlavorSplit
