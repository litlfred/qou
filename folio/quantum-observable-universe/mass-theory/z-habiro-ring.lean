import Mathlib.Algebra.Polynomial.Basic
import Mathlib.Algebra.Polynomial.Eval.Defs
import Mathlib.Data.Real.Basic


/-!
# z-Habiro Ring (proposed)

The z-Habiro ring is the cyclotomic-in-z completion of Z[q^±1][z]
at the ideal generated by the q-Pochhammer P_n(q,z) = ∏_{k=1}^{n}(1 - q^{-k} z).

Parallel to the q-Habiro ring (which completes in q at (q;q)_n), this
completion encodes brane-tower partial sums as a single algebraic limit
object whose cyclotomic projections recover finite-slice (Yekutieli)
truncations.

This file provides the algebraic skeleton; the conjecture that the
brane tower lives in this ring as a Cauchy limit is stated separately.

-- Ref: [habiro2004cyclotomic] Habiro, "Cyclotomic completions of polynomial rings," arXiv:math/0209324
-- Ref: [manuscript] Chapter 3, def:z-habiro-ring
-/

open Polynomial

namespace QOU.HabiroRing

/-- The z-Pochhammer polynomial P_n(q, z) = ∏_{k=1}^{n}(1 - q^{-k} z),
    viewed as a polynomial in z whose coefficients are functions of q.
    Using `Polynomial ℝ` (with q as a parameter) preserves degree and
    unique-representative structure that the inverse-limit Habiro
    construction depends on. -/
noncomputable def zPochhammer (q : ℝ) : ℕ → Polynomial ℝ
  | 0 => 1
  | n + 1 => zPochhammer q n * (Polynomial.C 1 - Polynomial.C (q ^ (-(n + 1 : ℤ))) * Polynomial.X)

/-- Equivalence relation on polynomials in z (with q as a parameter):
    f ≡ g (mod P_n(q, z)) iff (f - g) lies in the ideal generated by
    P_n(q, ·). The `Polynomial`-based formulation captures the
    polynomial-degree structure required for the Habiro completion. -/
def ZHabiroEquiv (n : ℕ) (f g : ℝ → Polynomial ℝ) : Prop :=
  ∀ q : ℝ, ∃ h : Polynomial ℝ, f q - g q = zPochhammer q n * h

/-- The z-Habiro ring as a compatible family of polynomial representatives
    at each cyclotomic-in-z level. The polynomial structure lets us speak
    of degree, leading coefficient, and unique-representative-of-degree-<n
    inside each quotient. -/
-- Ref: [manuscript] def:z-habiro-ring
structure ZHabiroElement where
  /-- Polynomial representative at each level: a polynomial in z (over ℝ)
      whose coefficients depend on q. -/
  family : ℕ → (ℝ → Polynomial ℝ)
  /-- Compatibility: agrees at level n with level n+1 modulo P_n(q, z). -/
  compatible : ∀ n : ℕ, ZHabiroEquiv n (family n) (family (n + 1))

/-- The constant inclusion ℤ[q^±1] ↪ ZHabiroElement: a function of q
    alone embeds with z-degree 0 (a constant polynomial in z). -/
noncomputable def embedQ (f : ℝ → ℝ) : ZHabiroElement where
  family := fun _ q => Polynomial.C (f q)
  compatible := by
    intro n q
    exact ⟨0, by simp⟩

/-- The cyclotomic projection π_n^{(z)}: ZHabiroElement → Polynomial ℝ /
    (P_n(q, z)) at parameter q. Truncates a Habiro element to its
    representative at level n; together with the compatibility data
    these are the structural truncations replacing Yekutieli's ad-hoc
    cutoff. -/
-- Ref: [manuscript] def:z-habiro-ring (cyclotomic projections)
noncomputable def cyclotomicProjection (n : ℕ) (h : ZHabiroElement)
    (q : ℝ) : Polynomial ℝ :=
  h.family n q

end QOU.HabiroRing
