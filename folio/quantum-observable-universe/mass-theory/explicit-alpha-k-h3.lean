import Mathlib.Algebra.Ring.Basic
import Mathlib.Algebra.Group.Units.Defs
import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.Tactic.Ring


/-!
# QOU.BraidsAndKnots.explicit_alpha_k_h3

The four curvature-rank prefactors `α_0, α_1, α_2, α_3` at `H_3(R, q)`
in closed `q`-algebraic form:

  α_0 = 1
  α_1 = 0  (vanishes structurally)
  α_2 = z²
  α_3 = h · z² + z = z · (1 + h·z)

where `z` is the Markov parameter and `h = q - q⁻¹`.

**MIGRATED TO CONVENTION D (2026-08-24).**  The 2026-08-15 owner ruling
makes `z_D = q³/(q²+1)` canonical and excises `z_C = √q/(q+1)`.  This
file was convention C, and the tell was the formal square root: the
relation `z · (v + v⁻¹) = 1` with `v² = q` *is* `z_C`.  Under D the
defining relation is

  z · (q + q⁻¹) = q²,

which needs **no square root at all** — `v` is gone, and with it the
`v_sq` field and the `ℤ[v, v⁻¹]` framing.  Evaluated:

  1 + h·z = (q⁴ + 1)/(q² + 1)          [C gave 1 + √q − 1/√q]
  α_2     = q⁶/(q² + 1)²
  α_3     = q³(q⁴ + 1)/(q² + 1)²

The numerator `q⁴ + 1 = Φ₈(q)` is cyclotomic, as under C it was not.

This is a migration of the *definition* of `z`, not a `z`-swap into a
C-derived conclusion — the move bean `qou-cds1` forbids.  The α_k are
stated in terms of an abstract `z` and are unchanged in form; only the
relation pinning `z`, and the closed-form gloss of `1 + h·z`, are
convention-dependent.

**2026-11-20: the vacuous existential is replaced by a derivation (W8b,
owner-approved "fill the gaps").** Until this date the theorem was
`∃ a₀ a₁ a₂ a₃, a₀ = 1 ∧ … ∧ a₃ = …`, discharged by four `rfl`s, which is
true of any four expressions. It now derives the four values as Markov
traces of the representatives `r₀ = 1`, `r₁ = σ₁ − σ₂`, `r₂ = σ₁σ₂`,
`r₃ = σ₁σ₂σ₁` that the proof sketch takes from the `H₃` spectral sequence:

* `tr 1 = 1` (normalisation);
* `tr(σ₁ − σ₂) = z − z = 0` (both by the Markov property);
* `tr(σ₁σ₂) = z · tr σ₁ = z²` (Markov property);
* `tr(σ₁σ₂σ₁) = tr(σ₁²σ₂) = z · tr(σ₁²) = z · tr(hσ₁ + 1) = hz² + z`
  (cyclicity, Markov property, Hecke relation `σ₁² = hσ₁ + 1`).

The hypotheses are the Markov-trace axioms on the subalgebra generated by
`σ₁` and the Hecke relation; nothing is assumed about the values.

**What stays conjectural.** That these four traces ARE the curvature-rank
prefactors `α_k` — i.e. that the `r_k` represent the `E_∞` classes — is the
content of `conj:spectral-sequence-h3-explicit`, whose carrier does not yet
encode the pages. So the block remains a conjecture: the values are now
derived, the identification is not. Two consistency questions about the
sketch are open and not settled here: `σ₁ − σ₂` is not central, and the
sketch lists four surviving classes while `HH⁰(H₃) = Z(H₃)` has dimension 3.

**Pre-Archimedean stub.** Polymorphic in the ground **ring** `R`
(AGENTS.md §7c).  An older version forced `q : ℝ`, `z : ℝ`, `h : ℝ`
and used `q ^ (1/2 : ℝ)` (a real power); a later one used an abstract
`v : R` with `v² = q` over a field.  Here `q` is carried as a **unit**
`Rˣ`, so `q⁻¹` is a units inverse and no field structure is needed; the
Markov parameter `z` is pinned by its defining *multiplicative* relation
`z · (q + q⁻¹) = q²` rather than by a division.  Under convention D the
pre-Archimedean home is `ℤ[q, q⁻¹]` — no square root is adjoined.  The
Archimedean evaluation `R = ℝ`, `q = q₀` is the post-τ realisation.

LaTeX label: `conj:explicit-alpha-k-h3`

## References

- [leitner2026] Ch. Braids and Knots, §α_k at H_3
- [jones1987] https://doi.org/10.2307/1971403
-/

namespace QOU.BraidsAndKnots

universe u

/-- Markov parameter `z` and amplitude `h` at substrate `q`,
    polymorphic in the ground ring `R`.

    `z` is the convention-D Markov parameter `q³/(q² + 1)`, pinned by
    the division-free relation `z · (q + q⁻¹) = q²`; and `h = q - q⁻¹`
    with the units inverse.  No square root is needed. -/
structure HeckeQ (R : Type u) [CommRing R] where
  /-- The substrate parameter `q`, a unit of `R`. -/
  q : Rˣ
  /-- The convention-D Markov parameter `z = q³/(q² + 1)`, pinned by the
      division-free relation `z · (q + q⁻¹) = q²`. -/
  z : R
  z_def : z * ((q : R) + (↑q⁻¹ : R)) = (q : R) ^ 2
  /-- The amplitude `h = q - q⁻¹`. -/
  h : R
  h_def : h = (q : R) - (↑q⁻¹ : R)

/-- **Explicit α_k at `H_3`, derived as Markov traces.**

    Let `A` be an `R`-algebra containing `σ₁, σ₂` with the Hecke relation
    `σ₁² = h·σ₁ + 1`, and `tr : A →ₗ[R] R` a Markov trace: `tr 1 = 1`,
    cyclic, and `tr (x * σ₁) = z · tr x`, `tr (x * σ₂) = z · tr x` for `x` in
    the subalgebra generated by the strands below (`1` for `σ₁`, `σ₁` for
    `σ₂`). Then on the representatives `1, σ₁ − σ₂, σ₁σ₂, σ₁σ₂σ₁`:
    `α_0 = 1`, `α_1 = 0`, `α_2 = z²`, `α_3 = h · z² + z`. -/
-- Ref: [leitner2026] Ch. Braids and Knots, §α_k at H_3
-- Ref: [jones1987] §3 (The Markov trace) + §4 (Link polynomials)
--      — Jones, "Hecke algebra representations of braid groups and link
--      polynomials," Ann. Math. 126 (1987). Verified against the
--      published version.
theorem explicit_alpha_k_h3 {R : Type u} [CommRing R] (Q : HeckeQ R)
    {A : Type u} [Ring A] [Algebra R A] (σ₁ σ₂ : A) (tr : A →ₗ[R] R)
    (hecke : σ₁ * σ₁ = Q.h • σ₁ + 1)
    (tr_one : tr 1 = 1)
    (tr_cyc : ∀ x y : A, tr (x * y) = tr (y * x))
    (markov₁ : tr σ₁ = Q.z)
    (markov₂ : ∀ x ∈ Algebra.adjoin R {σ₁}, tr (x * σ₂) = Q.z * tr x) :
    tr 1 = 1 ∧ tr (σ₁ - σ₂) = 0 ∧ tr (σ₁ * σ₂) = Q.z ^ 2 ∧
      tr (σ₁ * σ₂ * σ₁) = Q.h * Q.z ^ 2 + Q.z := by
  have h1 : (1 : A) ∈ Algebra.adjoin R {σ₁} := Subalgebra.one_mem _
  have hs : σ₁ ∈ Algebra.adjoin R {σ₁} := Algebra.subset_adjoin rfl
  have hss : σ₁ * σ₁ ∈ Algebra.adjoin R {σ₁} := Subalgebra.mul_mem _ hs hs
  have tr_s2 : tr σ₂ = Q.z := by
    have := markov₂ 1 h1
    rw [one_mul, tr_one, mul_one] at this
    exact this
  have tr_s1s1 : tr (σ₁ * σ₁) = Q.h * Q.z + 1 := by
    rw [hecke, map_add, map_smul, markov₁, tr_one, smul_eq_mul]
  refine ⟨tr_one, ?_, ?_, ?_⟩
  · rw [map_sub, markov₁, tr_s2, sub_self]
  · rw [markov₂ σ₁ hs, markov₁]; ring
  · have hcyc : tr (σ₁ * σ₂ * σ₁) = tr (σ₁ * σ₁ * σ₂) := by
      rw [tr_cyc (σ₁ * σ₂) σ₁, ← mul_assoc]
    rw [hcyc, markov₂ _ hss, tr_s1s1]; ring

end QOU.BraidsAndKnots
