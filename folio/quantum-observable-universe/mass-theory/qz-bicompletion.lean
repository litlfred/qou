import Mathlib.Algebra.Polynomial.Basic
import Mathlib.Algebra.Polynomial.Eval.Defs
import Mathlib.Data.Real.Basic


/-!
# (q, z)-Bicompletion

The (q, z)-bicompletion is the inverse limit of Z[q^±1, z] / I_{m,n}
where I_{m,n} = ((q;q)_m · P_n(q, z)). It sits at the apex of the
cyclotomic-completion diagram, carrying both the colored-Jones
universality (in q) of the Habiro ring and the brane-tower
universality (in z) of the z-Habiro ring.

This file defines the algebraic skeleton; the conjecture that the
mass element lifts to this bicompletion is stated separately in
conj:mass-endomorphism.

-- Ref: [leitner2026] def:qz-bicompletion
-- Ref: [habiro2004cyclotomic] Habiro, "Cyclotomic completions of polynomial rings," arXiv:math/0209324
-/

open Polynomial

namespace QOU.HabiroRing

/-- The q-Pochhammer (q;q)_m = ∏_{k=1}^{m}(1 - q^k), reused from
    `habiro-ring.lean`. -/
noncomputable def qPochhammerProduct (q : ℝ) : ℕ → ℝ
  | 0 => 1
  | m + 1 => qPochhammerProduct q m * (1 - q ^ (m + 1))

/-- The z-Pochhammer polynomial P_n(q, z) = ∏_{k=1}^{n}(1 - q^{-k} z), as a
    polynomial in z with real coefficients depending on q.  Identical to the
    canonical definition in the sibling `z-habiro-ring.lean` (same namespace);
    redeclared here because content-block siblings cannot import one another
    (the same reason `qPochhammerProduct` above is a local copy).  Added
    2026-09-05: the file referred to `zPochhammer` without any definition in
    tracked history, and did not compile. -/
noncomputable def zPochhammer (q : ℝ) : ℕ → Polynomial ℝ
  | 0 => 1
  | n + 1 => zPochhammer q n * (Polynomial.C 1 - Polynomial.C (q ^ (-(n + 1 : ℤ))) * Polynomial.X)

/-- The bigraded ideal generator I_{m,n}(q, z) = (q;q)_m · P_n(q, z).
    Returned as a polynomial in z whose coefficients depend on q. -/
noncomputable def qzBigradedIdealGen (q : ℝ) (m n : ℕ) : Polynomial ℝ :=
  Polynomial.C (qPochhammerProduct q m) * zPochhammer q n

/-- Equivalence relation at level (m, n): f ≡ g (mod I_{m,n}) iff
    (f - g) lies in the ideal generated by I_{m,n}(q, ·). -/
def QZBicompletionEquiv (m n : ℕ) (f g : ℝ → Polynomial ℝ) : Prop :=
  ∀ q : ℝ, ∃ h : Polynomial ℝ,
    f q - g q = qzBigradedIdealGen q m n * h

/-- The (q, z)-bicompletion as a doubly-indexed compatible family of
    polynomial representatives. Mirrors `ZHabiroElement` but with two
    cyclotomic levels (m for q, n for z) instead of one. -/
-- Ref: [leitner2026] def:qz-bicompletion
structure QZBicompletionElement where
  /-- Polynomial representative at each (m, n) level. -/
  family : ℕ → ℕ → (ℝ → Polynomial ℝ)
  /-- Compatibility under increment of m (cyclotomic step in q). -/
  compatible_m : ∀ m n : ℕ,
    QZBicompletionEquiv m n (family m n) (family (m + 1) n)
  /-- Compatibility under increment of n (cyclotomic step in z). -/
  compatible_n : ∀ m n : ℕ,
    QZBicompletionEquiv m n (family m n) (family m (n + 1))

/-- Projection to the q-only Habiro ring by setting z ↦ 0 and
    forgetting the n-grading. The resulting element is determined by
    its m-family of constant polynomials in z. -/
-- Ref: [leitner2026] def:qz-bicompletion §"sits at the apex"
noncomputable def projectToQHabiro (M : QZBicompletionElement) :
    ℕ → (ℝ → ℝ) :=
  fun m q => (M.family m 0 q).eval 0

/-- Projection to the z-only Habiro ring by specialising q ↦ q_0 and
    forgetting the m-grading. The resulting element is determined by
    its n-family of polynomials evaluated at q = q_0. -/
-- Ref: [leitner2026] def:qz-bicompletion §"sits at the apex"
noncomputable def projectToZHabiro (q_0 : ℝ) (M : QZBicompletionElement) :
    ℕ → (ℝ → Polynomial ℝ) :=
  fun n _ => M.family 0 n q_0

end QOU.HabiroRing
