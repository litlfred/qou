import Mathlib.Tactic
import Mathlib.GroupTheory.Submonoid.Centralizer

/-!
# QOU.ParticleInteractions.su2L_nonabelianness_not_in_slots — `prop:ew-slot-far-commutation-obstruction`

**The far-commutation obstruction.** The three disjoint-strand-pair Hoefsmit
slots that host the electroweak carriers — `W ↔ σ₁⁴` (strands 1–2),
`Z ↔ σ₃⁶` (strands 3–4), `H ↔ σ₅⁸` (strands 5–6), per
`thm:hoefsmit-ew-cell-content` — are built from the braid generators
`σ₁, σ₃, σ₅` whose indices are pairwise **far apart** (`|i − j| ≥ 2`). The
braid far-commutation relation `σ_i σ_j = σ_j σ_i` for `|i − j| ≥ 2` therefore
makes the whole subalgebra they generate **commutative** (mutually abelian).

`SU(2)_L` is **non-abelian**: its adjoint triplet `W¹, W², W³` carries a nonzero
Lie bracket `⁅W^a, W^b⁆ = ε^{abc} W^c ≠ 0`. A nonzero bracket cannot be realised
by commuting operators. Consequently the non-abelian `SU(2)_L` structure
**cannot** be carried purely among the far-commuting slots: it must come from the
**inter-slot linking** — the adjacent generators `σ₂, σ₄` (which do *not*
far-commute with the slots) and the categorical linking operation
`Lk_R^{(k)}` of `conj:categorical-linking-operation`, which braids *between*
slots.

This is a proved *structural exclusion* (AGENTS.md §"Before declaring refuted",
case (b)): the invariant forbidding it is the vanishing of the commutator on a
commutative subalgebra — a Lean-proved impossibility, not a numerical near-miss.
It **narrows**, not closes, the group-assignment postulate `EWGroupAssignment`
of `thm:ew-triplet-charge-spin-from-involution`: the residual `su(2)_L × u(1)_Y`
input is now *localised* to the inter-slot linking data, not the slots.

Purely algebraic — stated over a generic ring, no archimedean structure
(AGENTS.md §7c).

LaTeX label: `prop:ew-slot-far-commutation-obstruction`.

## References

- [leitner2026] particle-interactions/ew-slot-far-commutation-obstruction
- `thm:hoefsmit-ew-cell-content` (the disjoint-pair `n = 6` construction; the
  far-commutation `σ_i σ_j = σ_j σ_i`, `|i − j| ≥ 2`)
- `conj:categorical-linking-operation` (`Lk_R^{(k)}` — the inter-slot braiding
  where the non-abelianness must instead live)
- `thm:ew-triplet-charge-spin-from-involution` (`EWGroupAssignment`, the
  relocated postulate this result narrows)
-/

namespace QOU.ParticleInteractions

section Bracket

variable {A : Type*}

/-- The ring commutator `⁅x, y⁆ = x·y − y·x`. Its vanishing is the algebraic
content of "`x` and `y` commute". -/
def bracket [Ring A] (x y : A) : A := x * y - y * x

/-- **Commuting operators have zero bracket.** The defining fact of the
obstruction: on a commutative subalgebra every commutator vanishes. -/
theorem bracket_eq_zero_of_commute [Ring A] {x y : A} (h : Commute x y) :
    bracket x y = 0 := by
  rw [bracket, h.eq, sub_self]

/-- **A nonzero bracket forbids commutation (the crux).** If the `su(2)_L`
structure relation `⁅x, y⁆ = z` holds with `z ≠ 0` (a genuinely non-abelian
bracket), then `x` and `y` do **not** commute. Contrapositive: commuting
generators cannot realise a nonzero adjoint bracket. Not vacuous — it runs
`bracket_eq_zero_of_commute` against `z ≠ 0`. -/
theorem nonabelian_bracket_forbids_commute [Ring A] {x y z : A}
    (hbr : bracket x y = z) (hz : z ≠ 0) : ¬ Commute x y := fun hc =>
  hz (by rw [← hbr, bracket_eq_zero_of_commute hc])

end Bracket

section CommutativeClosure

variable {M : Type*} [Monoid M]

/-- **The submonoid generated by a pairwise-commuting set is commutative.** Any
two elements of `Submonoid.closure S` commute, provided every pair drawn from `S`
commutes. Proved through the centralizer submonoid (`closure S ≤ centralizer S`,
then `closure S ≤ centralizer ↑(closure S)`), no induction bookkeeping. This is
the "the whole slot subalgebra is abelian, not just the generators" statement. -/
theorem commute_of_mem_closure {S : Set M}
    (hS : ∀ a ∈ S, ∀ b ∈ S, Commute a b)
    {x y : M} (hx : x ∈ Submonoid.closure S) (hy : y ∈ Submonoid.closure S) :
    Commute x y := by
  -- Step 1: closure S ≤ centralizer S — every element of the closure commutes
  -- with every generator.
  have h1 : Submonoid.closure S ≤ Submonoid.centralizer S := by
    rw [Submonoid.closure_le]
    intro a ha
    rw [SetLike.mem_coe, Submonoid.mem_centralizer_iff]
    intro b hb
    exact (hS b hb a ha).eq
  -- Step 2: closure S ≤ centralizer ↑(closure S) — using Step 1, every generator
  -- commutes with every element of the closure, so the closure centralises itself.
  have h2 : Submonoid.closure S ≤ Submonoid.centralizer (Submonoid.closure S : Set M) := by
    rw [Submonoid.closure_le]
    intro a ha
    rw [SetLike.mem_coe, Submonoid.mem_centralizer_iff]
    intro m hm
    have hmc : m ∈ Submonoid.centralizer S := h1 hm
    rw [Submonoid.mem_centralizer_iff] at hmc
    exact (hmc a ha).symm
  -- Conclude: x centralises the closure, y is in the closure.
  have hxc : x ∈ Submonoid.centralizer (Submonoid.closure S : Set M) := h2 hx
  rw [Submonoid.mem_centralizer_iff] at hxc
  exact (hxc y hy).symm

end CommutativeClosure

/-! ## The slot generators and their far-commutation

The EW carriers sit on strand-pairs `1–2, 3–4, 5–6`, acting via the braid
generators `σ₁, σ₃, σ₅`. Their indices `1, 3, 5` are pairwise far apart, so the
braid far-commutation relation applies to every pair. -/

section Slots

/-- Two braid-generator indices are **far apart** when they differ by at least
`2` — exactly the regime `|i − j| ≥ 2` of the braid far-commutation relation
`σ_i σ_j = σ_j σ_i`. (Over `ℕ` the truncated subtraction makes this the honest
symmetric gap condition.) -/
def farApart (i j : ℕ) : Prop := 2 ≤ i - j ∨ 2 ≤ j - i

/-- The three slot indices are pairwise far apart (`|1−3| = 2`, `|1−5| = 4`,
`|3−5| = 2`), a decidable combinatorial fact about the positions `1, 3, 5`. -/
theorem slot_indices_farApart :
    farApart 1 3 ∧ farApart 1 5 ∧ farApart 3 5 := by
  refine ⟨?_, ?_, ?_⟩ <;> unfold farApart <;> decide

/-- The adjacent (inter-slot) generators `σ₂, σ₄` are **not** far apart from the
slots they bridge: `|2−1| = |2−3| = |4−3| = |4−5| = 1 < 2`. These are precisely
the generators the braid far-commutation relation does *not* cover — the seat of
the non-abelian structure (the categorical linking `Lk_R` acts here). -/
theorem interSlot_not_farApart :
    ¬ farApart 2 1 ∧ ¬ farApart 2 3 ∧ ¬ farApart 4 3 ∧ ¬ farApart 4 5 := by
  refine ⟨?_, ?_, ?_, ?_⟩ <;> unfold farApart <;> decide

variable {A : Type*} [Monoid A]

/-- Braid generators in a monoid `A`, carrying the **far-commutation relation**
`σ_i σ_j = σ_j σ_i` for `|i − j| ≥ 2` as its defining field (a presentation
relation of the braid group `B_n` and its Hecke quotient `H_n(q)`). -/
structure BraidGenerators (A : Type*) [Monoid A] where
  /-- The generator `σ_i`. -/
  gen : ℕ → A
  /-- Far-commutation: generators with indices `≥ 2` apart commute. -/
  farCommute : ∀ i j, farApart i j → Commute (gen i) (gen j)

/-- The submonoid generated by the three slot generators `σ₁, σ₃, σ₅` — the
"slot subalgebra" that hosts the EW carriers. -/
def slotSubmonoid (bg : BraidGenerators A) : Submonoid A :=
  Submonoid.closure {bg.gen 1, bg.gen 3, bg.gen 5}

/-- The three slot generators pairwise commute (from far-commutation +
`slot_indices_farApart`). -/
theorem slot_generators_commute (bg : BraidGenerators A) :
    ∀ a ∈ ({bg.gen 1, bg.gen 3, bg.gen 5} : Set A),
      ∀ b ∈ ({bg.gen 1, bg.gen 3, bg.gen 5} : Set A), Commute a b := by
  obtain ⟨h13, h15, h35⟩ := slot_indices_farApart
  -- every pair of the three generators commutes; the diagonal is `Commute.refl`
  have c13 : Commute (bg.gen 1) (bg.gen 3) := bg.farCommute 1 3 h13
  have c15 : Commute (bg.gen 1) (bg.gen 5) := bg.farCommute 1 5 h15
  have c35 : Commute (bg.gen 3) (bg.gen 5) := bg.farCommute 3 5 h35
  intro a ha b hb
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha hb
  rcases ha with rfl | rfl | rfl <;> rcases hb with rfl | rfl | rfl <;>
    first
      | exact Commute.refl _
      | exact c13 | exact c13.symm
      | exact c15 | exact c15.symm
      | exact c35 | exact c35.symm

/-- **The slot subalgebra is mutually abelian.** Any two elements of the slot
submonoid commute — the concrete "far-commuting slots generate a commutative
subalgebra" claim, sorry-free. -/
theorem slotSubmonoid_commutative (bg : BraidGenerators A)
    {x y : A} (hx : x ∈ slotSubmonoid bg) (hy : y ∈ slotSubmonoid bg) :
    Commute x y :=
  commute_of_mem_closure (slot_generators_commute bg) hx hy

/-- The actual EW carriers `W ↔ σ₁⁴`, `Z ↔ σ₃⁶`, `H ↔ σ₅⁸` are members of the
slot submonoid (powers of the generators). -/
theorem carriers_mem_slotSubmonoid (bg : BraidGenerators A) :
    bg.gen 1 ^ 4 ∈ slotSubmonoid bg ∧
    bg.gen 3 ^ 6 ∈ slotSubmonoid bg ∧
    bg.gen 5 ^ 8 ∈ slotSubmonoid bg := by
  refine ⟨?_, ?_, ?_⟩ <;> apply Submonoid.pow_mem <;>
    apply Submonoid.subset_closure
  · exact Set.mem_insert _ _
  · exact Set.mem_insert_of_mem _ (Set.mem_insert _ _)
  · exact Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl)

/-- **The EW carriers pairwise commute** (abelian) — `W·Z = Z·W`, `W·H = H·W`,
`Z·H = H·Z` for `W = σ₁⁴, Z = σ₃⁶, H = σ₅⁸`. The disjoint-pair construction is
an *abelian* subalgebra; this is the positive, non-vacuous content grounding the
obstruction. -/
theorem carriers_commute (bg : BraidGenerators A) :
    Commute (bg.gen 1 ^ 4) (bg.gen 3 ^ 6) ∧
    Commute (bg.gen 1 ^ 4) (bg.gen 5 ^ 8) ∧
    Commute (bg.gen 3 ^ 6) (bg.gen 5 ^ 8) := by
  obtain ⟨hW, hZ, hH⟩ := carriers_mem_slotSubmonoid bg
  exact ⟨slotSubmonoid_commutative bg hW hZ,
         slotSubmonoid_commutative bg hW hH,
         slotSubmonoid_commutative bg hZ hH⟩

end Slots

/-! ## The obstruction: `su(2)_L` non-abelianness cannot live among the slots -/

section Obstruction

variable {A : Type*} [Ring A]

/-- **The far-commutation obstruction (capstone).** Suppose two `su(2)_L` adjoint
generators `J₁, J₂` obey the structure relation `⁅J₁, J₂⁆ = J₃` with `J₃ ≠ 0`
(the gauge algebra is genuinely non-abelian), and suppose *both* are realised
inside the slot subalgebra generated by the far-commuting slots `σ₁, σ₃, σ₅`.
This is **impossible**.

The proof: the slot subalgebra is mutually abelian
(`slotSubmonoid_commutative`), so `J₁` and `J₂` commute; but a nonzero bracket
forbids commutation (`nonabelian_bracket_forbids_commute`). Hence the non-abelian
`su(2)_L` structure **cannot** be carried purely among the far-commuting slots —
it must arise from the inter-slot linking (`σ₂, σ₄` / `Lk_R`,
`interSlot_not_farApart`). A genuine structural exclusion, not a numerical
near-miss. -/
theorem su2L_nonabelianness_not_in_slots
    (bg : BraidGenerators A) {J₁ J₂ J₃ : A}
    (su2 : bracket J₁ J₂ = J₃) (nonabelian : J₃ ≠ 0)
    (slot1 : J₁ ∈ slotSubmonoid bg) (slot2 : J₂ ∈ slotSubmonoid bg) :
    False :=
  nonabelian_bracket_forbids_commute su2 nonabelian
    (slotSubmonoid_commutative bg slot1 slot2)

/-- **Equivalent positive form.** Given the non-abelian `su(2)_L` structure
relation `⁅J₁, J₂⁆ = J₃ ≠ 0`, at least one of the two adjoint generators is
**not** in the slot subalgebra: the non-abelian pair cannot both be slot-built.
The escape is the inter-slot linking. -/
theorem su2L_generator_escapes_slots
    (bg : BraidGenerators A) {J₁ J₂ J₃ : A}
    (su2 : bracket J₁ J₂ = J₃) (nonabelian : J₃ ≠ 0) :
    J₁ ∉ slotSubmonoid bg ∨ J₂ ∉ slotSubmonoid bg := by
  by_contra h
  push_neg at h
  exact su2L_nonabelianness_not_in_slots bg su2 nonabelian h.1 h.2

end Obstruction

end QOU.ParticleInteractions
