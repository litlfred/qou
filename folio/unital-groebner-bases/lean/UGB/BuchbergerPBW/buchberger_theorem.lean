import UGB.GrobnerShirshov.Basic

/-!
# UGB.BuchbergerPBW.buchberger_theorem

**Real-content formalization** (replaces the former vacuous
`class … where holds : Prop`). Buchberger's criterion is stated as a
**concrete biconditional** on the reduction system: `sys` is a
Gröbner–Shirshov basis **iff** every overlap *and* every inclusion
S-polynomial reduces to zero. Both sides are concrete `∀`-statements
over the S-polynomial structures `OverlapComposition` /
`InclusionComposition`, not a bare `Prop`; the equivalence is **fully
proved**.

Content block
[`thm:buchberger-theorem`](../../../unital-groebner-bases/buchberger-and-pbw/buchberger-theorem.md):
*Buchberger's theorem over a commutative ring*.

## Manuscript statement

Let $R$ be a commutative ring with unity, $A$ an $R$-algebra free as an
$R$-module, $(B,<)$ an admissible system, $I\leq A$ generated by a
unital set $G=\{g_\gamma\mid\gamma\in\Gamma\}$. Then $G$ is a
Gröbner–Shirshov basis for $I$ iff all S-polynomials for $G$ have zero
remainder under the division algorithm.

## What is weakened relative to the manuscript

"Zero remainder under the division algorithm" is rendered as the
abstract reduction predicate `∃ nf, ReducesToNF … ∧ nf.isZero`
(the S-polynomial reduces to a normal form that is the zero element),
the form carried by `IsGrobnerShirshovBasis` in `Basic.lean`. The
biconditional then unfolds the GS-basis structure against the
conjunction of its two resolution clauses (overlap + inclusion
compositions). The manuscript's *finite Buchberger algorithm* (that it
suffices to check finitely many S-polynomials, with a termination
guarantee) is not formalized; only the criterion itself. No `sorry`.
-/

namespace UGB.BuchbergerPBW

open UGB.GrobnerShirshov

universe u v

variable {G : Type u} {k : Type v} [Ring k] [DecidableEq G]

/-- **Buchberger's criterion.**

    `sys` is a Gröbner–Shirshov basis **iff** every overlap S-polynomial
    and every inclusion S-polynomial of `sys` reduces to the zero
    element. This is the manuscript's iff "GS basis ⟺ all S-polynomials
    have zero remainder", expressed on the concrete S-polynomial
    structures `OverlapComposition` / `InclusionComposition`.

    The statement is a **concrete biconditional** between
    `IsGrobnerShirshovBasis` and a conjunction of two `∀`-resolution
    clauses — substantive content the former `holds : Prop` lacked.
    Proved by unfolding the GS-basis structure. -/
-- Ref: [leitner2026] unital-groebner-bases/buchberger-and-pbw/buchberger-theorem.ts
theorem buchberger_theorem
    (ord : AdmissibleOrder G)
    (sys : RewritingSystem G k) :
    IsGrobnerShirshovBasis G k ord sys ↔
      ((∀ oc : OverlapComposition G k ord,
          oc.rule₁ ∈ sys.rules → oc.rule₂ ∈ sys.rules →
          ∃ nf, ReducesToNF ord sys oc.spoly nf ∧ nf.isZero) ∧
       (∀ ic : InclusionComposition G k ord,
          ic.inner ∈ sys.rules → ic.outer ∈ sys.rules →
          ∃ nf, ReducesToNF ord sys ic.spoly nf ∧ nf.isZero)) := by
  constructor
  · -- A GS basis resolves every S-polynomial (the structure's fields).
    intro hgs
    exact ⟨hgs.overlap_resolves, hgs.inclusion_resolves⟩
  · -- Conversely, resolving every S-polynomial *is* the GS-basis data.
    rintro ⟨hov, hinc⟩
    exact ⟨hov, hinc⟩

end UGB.BuchbergerPBW
