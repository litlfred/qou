import UGB.GrobnerShirshov.Basic

/-!
# UGB.UnitalGroebner.lemma_generator_choice

**Real-content formalization** (replaces the former vacuous
`class … where holds : Prop`). The generator-choice lemma in its
**multi-step** form: any division-algorithm run `f →* g` either took no
steps (`f = g`) or its final step is realised by an actual basis
generator `r ∈ sys.rules`. The conclusion is a concrete disjunction /
nested existential over the reduction relation, not a bare `Prop`, and
it is **fully proved** by case analysis on `MultiStepReduction`.

Content block
[`lem:lemma-generator-choice`](../../../unital-groebner-bases/unital-groebner-bases-chapter/lemma-generator-choice.md):
*Generator choice in division*.

## Manuscript statement

Let $R$ be a commutative ring with unity, $A$ an $R$-algebra free as an
$R$-module, $(B,<)$ an admissible system, and $I \trianglelefteq A$
generated by a unital Gröbner–Shirshov basis
$G=\{g_\gamma\mid\gamma\in\Gamma\}$. Then in the division algorithm we
may choose $h_i\in I$ with $h_i = g_{\gamma_i}$ for some
$\gamma_i\in\Gamma$.

## What is weakened relative to the manuscript

The division algorithm is the `MultiStepReduction` (reflexive–transitive
closure of `SingleStepReduction`) of `Basic.lean`. We state the
generator-choice property at the level of *every reduction run*: either
it is the empty run or its terminal step picks a rule of the system (a
generator `g_γ ∈ G`). This is the multi-step companion of
`generator_choice` (the single-step version). The full statement that
the chosen generators reconstruct the dividend (`f = Σ hᵢ qᵢ + r`) is
the freeness/Buchberger content, formalized separately
(`unital_groebner_decomposition`, `buchberger`). No `sorry`.
-/

namespace UGB.UnitalGroebner

open UGB.GrobnerShirshov

universe u v

variable {G : Type u} {k : Type v} [Ring k] [DecidableEq G]

/-- **Generator choice — multi-step division run.**

    For any division run `f →* g` (`MultiStepReduction`): either no step
    was taken (`f = g`), or there is an intermediate element `g'` with
    `f →* g'`, a final single step `g' → g`, and that step is realised by
    a genuine basis generator `r ∈ sys.rules`. So every nontrivial run
    uses a member of `G` — the manuscript's "we may take `hᵢ = g_{γᵢ}`".

    The conclusion is a **concrete disjunction over the reduction
    relation** (an equality on `AlgElement`, or an existential producing
    `r ∈ sys.rules` and the witnessing subword occurrence), not a bare
    `Prop`. Proved by `cases` on the reduction derivation. -/
-- Ref: [leitner2026] unital-groebner-bases/unital-groebner-bases-chapter/lemma-generator-choice.ts
theorem lemma_generator_choice
    (ord : AdmissibleOrder G)
    (sys : RewritingSystem G k)
    (f g : AlgElement G k)
    (hred : MultiStepReduction ord sys f g) :
    f = g ∨
    ∃ g' : AlgElement G k, MultiStepReduction ord sys f g' ∧
      ∃ r : ReductionRule G k, r ∈ sys.rules ∧
        ∃ m : Monomial G, m ∈ g'.support ∧
          (leadingMonomial ord r.relation r.nonzero) <:+: m := by
  cases hred with
  | refl =>
    -- Empty run: f = g.
    left; rfl
  | step h_prefix h_last =>
    -- A final single step occurred: extract its generator witness.
    rename_i g'
    right
    obtain ⟨r, hr_mem, a, b, _, hne, -, -⟩ := h_last.exists_witness
    exact ⟨g', h_prefix, r, hr_mem,
      a ++ leadingMonomial ord r.relation r.nonzero ++ b,
      AlgElement.mem_support_of_coeff_ne_zero hne, ⟨a, b, rfl⟩⟩

end UGB.UnitalGroebner
