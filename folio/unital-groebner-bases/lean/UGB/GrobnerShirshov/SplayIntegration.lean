import UGB.GrobnerShirshov.FilteredSplayPBW
import UGB.GrobnerShirshov.QSerreStandard
import Mathlib.Algebra.RingQuot
import Mathlib.LinearAlgebra.Isomorphisms

/-!
# Thm. 3.7 of [leitner2006]: the basis of the integration quotient `U = T / J`

`FilteredSplayPBW.lean` proves `Model.normalFormBasis`: the ordered monomials are a
basis of `QuotAlg F.quad.sys`, the free algebra modulo the full block-splay
presentation. That quotient is the repo's own module quotient. This file states the
same basis for the algebra the theorem is about: the splay algebra `A` (the target
of the model map `q`) modulo the two-sided ideal `J` generated by

    x y − y x − br(x, y),      x, y ∈ A.

Results:

* `Model.br_lift`: for **all** `X, Y` in the free algebra, `X Y − Y X − Z` lies in
  the presentation ideal `K` whenever `q Z = br (q X) (q Y)`. On letters this is a
  rule of the presentation; it extends to all words by the Leibniz rule.
* `Model.Q_eq_zero_iff`: the composite `MA G k → A → A / J` has kernel exactly `K`.
* `Model.integrationBasis`: if `q` is surjective, the images of the ordered
  monomials are a `k`-basis of `A / J`.

The relation `IntRel br` is written to match `QOU.FormalGroups.IntegrationRel`, so
that `A / J` here is `IntegrationQuotient π` there.

No `sorry`, no axiom beyond Lean's three.
-/

set_option linter.unusedSectionVars false

namespace UGB.GrobnerShirshov.BlockSplay

open UGB.GrobnerShirshov UGB.GrobnerShirshov.Diamond UGB.GrobnerShirshov.Quadratic AlgElement

universe u v w

variable {G : Type u} [DecidableEq G] {k : Type v} [CommRing k]
  {ord : AdmissibleOrder G} {ι : Type w} [LinearOrder ι] [Nontrivial k]
  {F : FilteredData G k ord ι} {A : Type*} [Ring A] [Algebra k A]

/-- The relation `x y ~ y x + br(x, y)`. The two-sided ideal it generates is the
    ideal `J = (x y − y x − br(x, y))` of Thm. 3.7 of [leitner2006]. -/
inductive IntRel (br : A →ₗ[k] A →ₗ[k] A) : A → A → Prop
  | of (x y : A) : IntRel br (x * y) (y * x + br x y)

namespace Model

variable (M : Model F A)

/-- The presentation ideal `K`: the span of all rules of the full splay system in
    all word contexts. -/
local notation "𝒦" => ctxSpan (sysRels F.quad.sys)

theorem K_mul_left {Y : MA G k} (h : Y ∈ 𝒦) (X : MA G k) : X * Y ∈ 𝒦 :=
  ctxSpan_mul_left _ h X

theorem K_mul_right {Y : MA G k} (h : Y ∈ 𝒦) (X : MA G k) : Y * X ∈ 𝒦 :=
  ctxSpan_mul_right _ h X

theorem relMA_mem_K (p : F.quad.pairs) : F.quad.relMA p.1.1 p.1.2 ∈ 𝒦 :=
  Submodule.subset_span ⟨_, ⟨F.quad.rule p, F.quad.rule_mem p, (F.quad.toMA_rule p).symm⟩,
    [], [], by rw [ofW_nil, one_mul, mul_one]⟩

theorem inId_K {X : MA G k} (h : InId F.same.sys X) : X ∈ ctxSpan (sysRels F.quad.sys) := by
  induction h with
  | gen a b r hr => exact Submodule.subset_span ⟨_, ⟨r, F.same_sub r hr, rfl⟩, a, b, rfl⟩
  | zero => exact zero_mem _
  | add _ _ h1 h2 => exact add_mem h1 h2
  | smul c _ h => exact Submodule.smul_mem _ c h

/-- Two preimages of one element differ by an element of `K`. -/
theorem sub_mem_K {X Y : MA G k} (h : M.q X = M.q Y) : X - Y ∈ 𝒦 :=
  inId_K (M.ker _ (by rw [map_sub, h, sub_self]))

/-- `X` and `Y` bracket correctly modulo `K`. -/
def Br (X Y : MA G k) : Prop :=
  ∀ Z, M.q Z = M.br (M.q X) (M.q Y) → X * Y - Y * X - Z ∈ 𝒦

theorem br_of_exists {X Y Z : MA G k} (hZ : M.q Z = M.br (M.q X) (M.q Y))
    (h : X * Y - Y * X - Z ∈ 𝒦) : M.Br X Y := by
  intro Z' hZ'
  have := add_mem h (M.sub_mem_K (hZ.trans hZ'.symm))
  rwa [sub_add_sub_cancel] at this

variable (hs : Function.Surjective M.q)
include hs

theorem br_letter (a b : G) : M.Br (ofW [a]) (ofW [b]) := by
  have e : ∀ x y : G, (ofW [x, y] : MA G k) = ofW [x] * ofW [y] := fun x y => ofW_append [x] [y]
  rcases lt_trichotomy (F.blk a) (F.blk b) with h | h | h
  · -- `blk a < blk b`: the rule of `(b, a)`, negated.
    refine M.br_of_exists (Z := -F.π b a) ?_ ?_
    · rw [map_neg, M.qπ b a h, M.skew, neg_neg]
    · have := neg_mem (relMA_mem_K (F := F) ⟨(b, a), le_of_lt h⟩)
      convert this using 1
      simp only [QuadData.relMA, BlockData.quad, F.toBlockData.R_cross h, e]; abel
  · -- same block: commutativity, and the bracket vanishes.
    refine M.br_of_exists (Z := 0) (by rw [map_zero, M.same a b h]) ?_
    have h1 := relMA_mem_K (F := F) ⟨(a, b), le_of_eq h.symm⟩
    have h2 := relMA_mem_K (F := F) ⟨(b, a), le_of_eq h⟩
    convert sub_mem h1 h2 using 1
    simp only [QuadData.relMA, BlockData.quad, F.toBlockData.R_same h,
      F.toBlockData.R_same h.symm, F.comm a b h, e]; abel
  · -- `blk b < blk a`: the rule of `(a, b)`.
    refine M.br_of_exists (Z := F.π a b) (M.qπ a b h) ?_
    convert relMA_mem_K (F := F) ⟨(a, b), le_of_lt h⟩ using 1
    simp only [QuadData.relMA, BlockData.quad, F.toBlockData.R_cross h, e]; abel

theorem br_one (X : MA G k) : M.Br X 1 :=
  M.br_of_exists (Z := 0) (by rw [map_zero, map_one, M.br_one_right]) (by simp)

theorem br_add {X Y₁ Y₂ : MA G k} (h₁ : M.Br X Y₁) (h₂ : M.Br X Y₂) : M.Br X (Y₁ + Y₂) := by
  obtain ⟨Z₁, hZ₁⟩ := hs (M.br (M.q X) (M.q Y₁))
  obtain ⟨Z₂, hZ₂⟩ := hs (M.br (M.q X) (M.q Y₂))
  refine M.br_of_exists (Z := Z₁ + Z₂) (by rw [map_add, map_add, map_add, hZ₁, hZ₂]) ?_
  convert add_mem (h₁ Z₁ hZ₁) (h₂ Z₂ hZ₂) using 1; noncomm_ring

theorem br_smul (c : k) {X Y : MA G k} (h : M.Br X Y) : M.Br X (c • Y) := by
  obtain ⟨Z, hZ⟩ := hs (M.br (M.q X) (M.q Y))
  refine M.br_of_exists (Z := c • Z) (by rw [map_smul, map_smul, map_smul, hZ]) ?_
  convert Submodule.smul_mem _ c (h Z hZ) using 1
  rw [smul_sub, smul_sub, mul_smul_comm, smul_mul_assoc]

theorem br_mul {X Y W : MA G k} (h₁ : M.Br X Y) (h₂ : M.Br X W) : M.Br X (Y * W) := by
  obtain ⟨Z₁, hZ₁⟩ := hs (M.br (M.q X) (M.q Y))
  obtain ⟨Z₂, hZ₂⟩ := hs (M.br (M.q X) (M.q W))
  refine M.br_of_exists (Z := Z₁ * W + Y * Z₂) ?_ ?_
  · rw [map_add, map_mul, map_mul, hZ₁, hZ₂, map_mul, M.leib]
  · convert add_mem (K_mul_right (h₁ Z₁ hZ₁) W) (K_mul_left (h₂ Z₂ hZ₂) Y) using 1
    noncomm_ring

theorem br_symm {X Y : MA G k} (h : M.Br X Y) : M.Br Y X := by
  obtain ⟨Z, hZ⟩ := hs (M.br (M.q X) (M.q Y))
  refine M.br_of_exists (Z := -Z) (by rw [map_neg, hZ, M.skew, neg_neg]) ?_
  convert neg_mem (h Z hZ) using 1; noncomm_ring

/-- If `X` brackets correctly with every letter, it brackets correctly with
    everything. -/
theorem br_all {X : MA G k} (h : ∀ b, M.Br X (ofW [b])) (Y : MA G k) : M.Br X Y := by
  have hw : ∀ w : List G, M.Br X (ofW w) := by
    intro w
    induction w with
    | nil => rw [ofW_nil]; exact M.br_one hs X
    | cons b w ih =>
      rw [show b :: w = [b] ++ w from rfl, ofW_append]
      exact M.br_mul hs (h b) ih
  induction Y using MonoidAlgebra.induction_linear with
  | zero =>
    have := M.br_smul hs 0 (hw [])
    rwa [zero_smul] at this
  | add Y₁ Y₂ h₁ h₂ => exact M.br_add hs h₁ h₂
  | single p c =>
    rw [single_eq_smul_ofW]
    exact M.br_smul hs c (hw _)

/-- **The bracket lifts**: every pair of elements of the free algebra brackets
    correctly modulo the presentation ideal. -/
theorem br_lift (X Y : MA G k) : M.Br X Y := by
  have hl : ∀ a, ∀ Y, M.Br (ofW [a]) Y := fun a => M.br_all hs (M.br_letter hs a)
  exact M.br_all hs (fun b => M.br_symm hs (hl b X)) Y

omit hs in
/-- The composite `MA G k → A → A / J`. -/
noncomputable def Q : MA G k →ₐ[k] RingQuot (IntRel M.br) :=
  (RingQuot.mkAlgHom k (IntRel M.br)).comp M.q

theorem Q_surjective : Function.Surjective M.Q :=
  (RingQuot.mkAlgHom_surjective k _).comp hs

/-- Equality in `A / J` lifts to congruence modulo `K`. -/
theorem sub_mem_K_of_eqvGen {a b : A}
    (h : Relation.EqvGen (RingQuot.Rel (IntRel M.br)) a b) :
    ∀ X Y, M.q X = a → M.q Y = b → X - Y ∈ 𝒦 := by
  induction h with
  | rel a b h =>
    induction h with
    | of h =>
      obtain ⟨x, y⟩ := h
      intro X Y hX hY
      obtain ⟨X₀, rfl⟩ := hs x
      obtain ⟨Y₀, rfl⟩ := hs y
      obtain ⟨Z, hZ⟩ := hs (M.br (M.q X₀) (M.q Y₀))
      have h1 := M.sub_mem_K (hX.trans (map_mul _ _ _).symm)
      have h2 := M.sub_mem_K (Y := Y₀ * X₀ + Z) (hY.trans (by rw [map_add, map_mul, hZ]))
      have h3 := M.br_lift hs X₀ Y₀ Z hZ
      convert sub_mem (add_mem h1 h3) h2 using 1
      noncomm_ring
    | add_left _ ih =>
      intro X Y hX hY
      rename_i a b c _
      obtain ⟨C, rfl⟩ := hs c
      have := ih (X - C) (Y - C) (by rw [map_sub, hX, add_sub_cancel_right])
        (by rw [map_sub, hY, add_sub_cancel_right])
      rwa [sub_sub_sub_cancel_right] at this
    | mul_left _ ih =>
      intro X Y hX hY
      rename_i a b c _
      obtain ⟨A₀, rfl⟩ := hs a
      obtain ⟨B₀, rfl⟩ := hs b
      obtain ⟨C, rfl⟩ := hs c
      have h1 := M.sub_mem_K (hX.trans (map_mul _ _ _).symm)
      have h2 := M.sub_mem_K (hY.trans (map_mul _ _ _).symm)
      have h3 := K_mul_right (ih A₀ B₀ rfl rfl) C
      convert add_mem (sub_mem h1 h2) h3 using 1
      noncomm_ring
    | mul_right _ ih =>
      intro X Y hX hY
      rename_i a b c _
      obtain ⟨A₀, rfl⟩ := hs a
      obtain ⟨B₀, rfl⟩ := hs b
      obtain ⟨C, rfl⟩ := hs c
      have h1 := M.sub_mem_K (hX.trans (map_mul _ _ _).symm)
      have h2 := M.sub_mem_K (hY.trans (map_mul _ _ _).symm)
      have h3 := K_mul_left (ih B₀ C rfl rfl) A₀
      convert add_mem (sub_mem h1 h2) h3 using 1
      noncomm_ring
  | refl a =>
    intro X Y hX hY
    exact M.sub_mem_K (hX.trans hY.symm)
  | symm a b _ ih =>
    intro X Y hX hY
    have := neg_mem (ih Y X hY hX)
    rwa [neg_sub] at this
  | trans a b c _ _ ih₁ ih₂ =>
    intro X Y hX hY
    obtain ⟨B₀, rfl⟩ := hs b
    have := add_mem (ih₁ X B₀ hX rfl) (ih₂ B₀ Y rfl hY)
    rwa [sub_add_sub_cancel] at this

omit hs in
theorem Q_rel (p : F.quad.pairs) : M.Q (F.quad.relMA p.1.1 p.1.2) = 0 := by
  obtain ⟨⟨a, b⟩, hp⟩ := p
  change F.blk b ≤ F.blk a at hp
  have e : (ofW [a, b] : MA G k) = ofW [a] * ofW [b] := ofW_append [a] [b]
  simp only [Q, AlgHom.comp_apply, QuadData.relMA, BlockData.quad]
  rcases lt_or_eq_of_le hp with h | h
  · have e' : (ofW [b, a] : MA G k) = ofW [b] * ofW [a] := ofW_append [b] [a]
    rw [F.toBlockData.R_cross h, map_sub, map_add, M.qπ a b h, e, e',
      map_mul, map_mul, map_sub, sub_eq_zero]
    exact RingQuot.mkAlgHom_rel k (IntRel.of (br := M.br) _ _)
  · rw [F.toBlockData.R_same h.symm, map_sub, e, map_mul, ← M.qμ a b h.symm, sub_self, map_zero]

/-- **The kernel of `MA G k → A / J` is the presentation ideal.** -/
theorem Q_eq_zero_iff (X : MA G k) : M.Q X = 0 ↔ X ∈ 𝒦 := by
  constructor
  · intro h
    have key : ∀ x : A, RingQuot.mkAlgHom k (IntRel M.br) x = ⟨Quot.mk _ x⟩ := by
      intro x; simp [RingQuot.mkAlgHom_def, RingQuot.mkRingHom_def]
    have h' : RingQuot.mkAlgHom k (IntRel M.br) (M.q X) = RingQuot.mkAlgHom k (IntRel M.br) 0 := by
      rw [map_zero]; exact h
    rw [key, key] at h'
    have hq : Quot.mk (RingQuot.Rel (IntRel M.br)) (M.q X) = Quot.mk _ 0 := RingQuot.mk.inj h'
    have := M.sub_mem_K_of_eqvGen hs (Quot.eqvGen_exact hq) X 0 rfl (map_zero _)
    rwa [sub_zero] at this
  · intro h
    induction h using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨x, ⟨r, ⟨p, rfl⟩, rfl⟩, a, b, rfl⟩ := hy
      rw [F.quad.toMA_rule, map_mul, map_mul, M.Q_rel p, mul_zero, zero_mul]
    | zero => exact map_zero _
    | add _ _ _ _ h₁ h₂ => rw [map_add, h₁, h₂, add_zero]
    | smul c _ _ h => rw [map_smul, h, smul_zero]

/-- **Thm. 3.7 of [leitner2006], PBW half.** If the model map `q` onto the splay
    algebra `A` is surjective, the images of the ordered monomials are a `k`-basis of
    `U = A / J`, `J = (x y − y x − br(x, y))`. -/
theorem integrationBasis [DecidableEq k] :
    ∃ B : Module.Basis {m : Monomial G // NormalFormMonomial ord F.quad.sys m} k
        (RingQuot (IntRel M.br)),
      ∀ m, B m = RingQuot.mkAlgHom k (IntRel M.br) (M.q (ofW m.val)) := by
  obtain ⟨B₀, hB₀⟩ := M.normalFormBasis
  have hker : 𝒦 = LinearMap.ker M.Q.toLinearMap := by
    ext X; rw [LinearMap.mem_ker]; exact (M.Q_eq_zero_iff hs X).symm
  let e₁ : QuotAlg F.quad.sys ≃ₗ[k] MA G k ⧸ 𝒦 :=
    Submodule.Quotient.equiv _ _ freeAlgEquivMA (systemIdeal_map _)
  let e₂ : (MA G k ⧸ 𝒦) ≃ₗ[k] RingQuot (IntRel M.br) :=
    (Submodule.quotEquivOfEq _ _ hker).trans
      (LinearMap.quotKerEquivOfSurjective M.Q.toLinearMap (M.Q_surjective hs))
  refine ⟨B₀.map (e₁.trans e₂), fun m => ?_⟩
  rw [Module.Basis.map_apply, hB₀, LinearEquiv.trans_apply]
  simp only [e₁, e₂, toQuot, Submodule.mkQ_apply, Submodule.Quotient.equiv_apply,
    Submodule.mapQ_apply, LinearEquiv.trans_apply, Submodule.quotEquivOfEq_mk,
    LinearMap.quotKerEquivOfSurjective_apply_mk, AlgHom.toLinearMap_apply]
  rw [LinearEquiv.coe_coe, freeAlgEquivMA_mk, toMA_single]
  rfl

end Model

end UGB.GrobnerShirshov.BlockSplay

/-! ### Presentations by a quadratic system

`QRel d` is the relation `a b ~ R(a, b)` of a quadratic data `d`. The kernel of the
quotient map `MA G k → RingQuot (QRel d)` lies in the ideal of `d.sys`. This is what
identifies an algebra given by generators and a multiplication table (such as a free
product of algebras with chosen bases) with the free algebra modulo `d.sys`. -/

namespace UGB.GrobnerShirshov.Quadratic

open UGB.GrobnerShirshov UGB.GrobnerShirshov.Diamond

variable {G : Type*} [DecidableEq G] {k : Type*} [CommRing k] {ord : AdmissibleOrder G}

/-- The relation `a b ~ R(a, b)` of a quadratic data. -/
inductive QRel (d : QuadData G k ord) : MA G k → MA G k → Prop
  | of (p : d.pairs) : QRel d (ofW [p.1.1, p.1.2]) (d.R p.1.1 p.1.2)

/-- Two algebra maps out of the free algebra agree when they agree on letters. -/
theorem MA_algHom_ext {B : Type*} [Semiring B] [Algebra k B] {f g : MA G k →ₐ[k] B}
    (h : ∀ a, f (ofW [a]) = g (ofW [a])) : f = g :=
  MonoidAlgebra.algHom_ext' (FreeMonoid.hom_eq fun a => h a)

/-- The span of the rules in context lies in the ideal predicate `InId`. -/
theorem inId_of_mem_ctxSpan (sys : RewritingSystem G k) {X : MA G k}
    (h : X ∈ ctxSpan (sysRels sys)) : InId sys X := by
  induction h using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨x, ⟨r, hr, rfl⟩, a, b, rfl⟩ := hy
    exact InId.gen a b r hr
  | zero => exact InId.zero
  | add _ _ _ _ h₁ h₂ => exact h₁.add h₂
  | smul c _ _ h => exact h.smul c

variable [Nontrivial k] (d : QuadData G k ord)

theorem QuadData.relMA_mem_ctxSpan (p : d.pairs) :
    d.relMA p.1.1 p.1.2 ∈ ctxSpan (sysRels d.sys) :=
  Submodule.subset_span ⟨_, ⟨d.rule p, d.rule_mem p, (d.toMA_rule p).symm⟩,
    [], [], by rw [ofW_nil, one_mul, mul_one]⟩

theorem QuadData.sub_mem_ctxSpan_of_eqvGen {X Y : MA G k}
    (h : Relation.EqvGen (RingQuot.Rel (QRel d)) X Y) :
    X - Y ∈ ctxSpan (sysRels d.sys) := by
  induction h with
  | rel a b h =>
    induction h with
    | of h => cases h with | of p => exact d.relMA_mem_ctxSpan p
    | add_left _ ih => rwa [add_sub_add_right_eq_sub]
    | mul_left _ ih => rw [← sub_mul]; exact ctxSpan_mul_right _ ih _
    | mul_right _ ih => rw [← mul_sub]; exact ctxSpan_mul_left _ ih _
  | refl a => rw [sub_self]; exact zero_mem _
  | symm a b _ ih => rw [← neg_sub]; exact neg_mem ih
  | trans a b c _ _ ih₁ ih₂ => rw [← sub_add_sub_cancel a b c]; exact add_mem ih₁ ih₂

/-- **The kernel of `MA G k → RingQuot (QRel d)` lies in the ideal of `d.sys`.** -/
theorem QuadData.inId_of_mk_eq_zero {X : MA G k}
    (h : RingQuot.mkAlgHom k (QRel d) X = 0) : InId d.sys X := by
  have key : ∀ x : MA G k, RingQuot.mkAlgHom k (QRel d) x = ⟨Quot.mk _ x⟩ := by
    intro x; simp [RingQuot.mkAlgHom_def, RingQuot.mkRingHom_def]
  have h' : RingQuot.mkAlgHom k (QRel d) X = RingQuot.mkAlgHom k (QRel d) 0 := by
    rw [map_zero]; exact h
  rw [key, key] at h'
  have := d.sub_mem_ctxSpan_of_eqvGen (Quot.eqvGen_exact (RingQuot.mk.inj h'))
  rw [sub_zero] at this
  exact inId_of_mem_ctxSpan _ this

end UGB.GrobnerShirshov.Quadratic

/-! ## Weighted orders with a rank in any well-founded linear order

`weightedOrder` takes an injective rank `G → ℕ`, and `swap_lt` needs that rank to
increase with the block. With two or more blocks each holding infinitely many
letters (the divided-power coordinates of `Dist(Hᵢ)`) no such `ℕ`-valued rank
exists. The versions below take the rank in any linear order with well-founded
`<`, for example the lexicographic order on `(block, index in block)`. The proofs
are the ones of `mkDegLexOrder` and `weightedOrder`, with `ℕ` replaced by `β`. -/

namespace UGB.GrobnerShirshov.BlockSplay

open UGB.GrobnerShirshov

variable {G : Type*} [DecidableEq G] {β : Type*} [LinearOrder β] [WellFoundedLT β]

/-- Deg-lex order on words with the letters compared through an injective rank in
a well-founded linear order. -/
noncomputable def degLexOrderWF (rank : G → β) (rank_inj : Function.Injective rank) :
    AdmissibleOrder G where
  lt := fun a b =>
    a.length < b.length ∨
    (a.length = b.length ∧ List.Lex (fun x y => rank x < rank y) a b)
  trichotomy := by
    intro a b
    by_cases h1 : a.length < b.length
    · left; left; exact h1
    · by_cases h2 : b.length < a.length
      · right; right; left; exact h2
      · have heq : a.length = b.length := by omega
        have : ∀ (x y : List G), x.length = y.length →
            List.Lex (fun a b => rank a < rank b) x y ∨
            x = y ∨
            List.Lex (fun a b => rank a < rank b) y x := by
          intro x
          induction x with
          | nil => intro y hy; cases y with
            | nil => right; left; rfl
            | cons _ _ => simp at hy
          | cons g gs ih => intro y hy; cases y with
            | nil => simp at hy
            | cons h hs =>
              simp [List.length_cons] at hy
              rcases lt_trichotomy (rank g) (rank h) with hr1 | hge | hr2
              · left; exact List.Lex.rel hr1
              · have hgh : g = h := rank_inj hge
                subst hgh
                rcases ih hs hy with hlx | heq | hrx
                · left; exact List.Lex.cons hlx
                · right; left; rw [heq]
                · right; right; exact List.Lex.cons hrx
              · right; right; exact List.Lex.rel hr2
        rcases this a b heq with hlx | heq' | hrx
        · left; right; exact ⟨heq, hlx⟩
        · right; left; exact heq'
        · right; right; right; exact ⟨heq.symm, hrx⟩
  wf := shortLex_wellFounded (InvImage.wf rank wellFounded_lt)
  left_compat := by
    intro a b c h
    rcases h with hlen | ⟨heq, hlex⟩
    · left; simp; omega
    · right; refine ⟨?_, ?_⟩
      · simp; omega
      · induction c with
        | nil => simpa
        | cons x xs ih =>
          simp only [List.cons_append]
          exact List.Lex.cons ih
  right_compat := by
    intro a b d h
    rcases h with hlen | ⟨heq, hlex⟩
    · left; simp; omega
    · right; refine ⟨by simp; omega, ?_⟩
      induction a generalizing b with
      | nil =>
        cases b with
        | nil => cases hlex
        | cons _ _ => simp at heq
      | cons x xs ih =>
        cases b with
        | nil => simp at heq
        | cons y ys =>
          simp only [List.cons_append]
          cases hlex with
          | cons h =>
            have heq' : xs.length = ys.length := by
              simp [List.length_cons] at heq; exact heq
            exact List.Lex.cons (ih ys heq' h)
          | rel h => exact List.Lex.rel h

/-- Weight first, then `degLexOrderWF`. -/
noncomputable def weightedOrderWF (wt : G → ℕ) (rank : G → β)
    (rank_inj : Function.Injective rank) : AdmissibleOrder G where
  lt a b := wsum wt a < wsum wt b ∨
    (wsum wt a = wsum wt b ∧ (degLexOrderWF rank rank_inj).lt a b)
  trichotomy a b := by
    rcases lt_trichotomy (wsum wt a) (wsum wt b) with h | h | h
    · exact Or.inl (Or.inl h)
    · rcases (degLexOrderWF rank rank_inj).trichotomy a b with h' | h' | h'
      · exact Or.inl (Or.inr ⟨h, h'⟩)
      · exact Or.inr (Or.inl h')
      · exact Or.inr (Or.inr (Or.inr ⟨h.symm, h'⟩))
    · exact Or.inr (Or.inr (Or.inl h))
  wf := by
    refine Subrelation.wf (r := InvImage (Prod.Lex (· < ·) (degLexOrderWF rank rank_inj).lt)
      (fun a => (wsum wt a, a))) (fun {a b} h => ?_)
      (InvImage.wf _ (WellFounded.prod_lex wellFounded_lt (degLexOrderWF rank rank_inj).wf))
    simp only [InvImage, Prod.lex_def]
    exact h
  left_compat a b c h := by
    rcases h with h | ⟨h, h'⟩
    · exact Or.inl (by simp; omega)
    · exact Or.inr ⟨by simp; omega, (degLexOrderWF rank rank_inj).left_compat a b c h'⟩
  right_compat a b d h := by
    rcases h with h | ⟨h, h'⟩
    · exact Or.inl (by simp; omega)
    · exact Or.inr ⟨by simp; omega, (degLexOrderWF rank rank_inj).right_compat a b d h'⟩

section WeightedOrderWF

variable (wt : G → ℕ) (rank : G → β) (rank_inj : Function.Injective rank)

theorem weightedOrderWF_lt_of_wsum_lt (x y : List G) (h : wsum wt x < wsum wt y) :
    (weightedOrderWF wt rank rank_inj).lt x y := Or.inl h

theorem weightedOrderWF_lt_of_wt (x y : List G) (h : (x.map wt).sum ≤ (y.map wt).sum)
    (hl : x.length < y.length) : (weightedOrderWF wt rank rank_inj).lt x y := by
  change wsum wt x ≤ wsum wt y at h
  rcases lt_or_eq_of_le h with h | h
  · exact Or.inl h
  · exact Or.inr ⟨h, Or.inl hl⟩

theorem weightedOrderWF_swap_lt {a b : G} (h : rank b < rank a) :
    (weightedOrderWF wt rank rank_inj).lt [b, a] [a, b] :=
  Or.inr ⟨by simp; omega, Or.inr ⟨rfl, List.Lex.rel h⟩⟩

end WeightedOrderWF

end UGB.GrobnerShirshov.BlockSplay

/-! ## Normal monomials of a quadratic system

A monomial is in normal form exactly when no two adjacent letters form a pair that
carries a rule. For a block splay (rules on every pair `a b` with `blk b ≤ blk a`)
this says: the blocks increase strictly along the word. -/

namespace UGB.GrobnerShirshov.Quadratic

open UGB.GrobnerShirshov UGB.GrobnerShirshov.Diamond

variable {G : Type*} [DecidableEq G] {k : Type*} [CommRing k] {ord : AdmissibleOrder G}
  [Nontrivial k] (d : QuadData G k ord)

theorem infix_pair_cons_cons {a b x y : G} {t : List G} :
    [a, b] <:+: x :: y :: t ↔ (a = x ∧ b = y) ∨ [a, b] <:+: y :: t := by
  rw [List.infix_cons_iff]
  constructor
  · rintro (h | h)
    · left
      obtain ⟨u, hu⟩ := h
      simp only [List.cons_append, List.nil_append, List.cons.injEq] at hu
      exact ⟨hu.1, hu.2.1⟩
    · exact Or.inr h
  · rintro (⟨rfl, rfl⟩ | h)
    · exact Or.inl ⟨t, rfl⟩
    · exact Or.inr h

theorem not_pair_infix_iff_chain (P : G → G → Prop) : ∀ m : List G,
    (∀ a b, P a b → ¬ [a, b] <:+: m) ↔ m.IsChain fun a b => ¬ P a b
  | [] => by
    simp only [List.isChain_nil, iff_true]
    intro a b _ h
    exact absurd h.length_le (by simp)
  | [x] => by
    simp only [List.isChain_singleton, iff_true]
    intro a b _ h
    exact absurd h.length_le (by simp)
  | x :: y :: t => by
    rw [List.isChain_cons_cons, ← not_pair_infix_iff_chain P (y :: t)]
    constructor
    · intro h
      exact ⟨fun hp => h x y hp (infix_pair_cons_cons.2 (Or.inl ⟨rfl, rfl⟩)),
        fun a b hp hi => h a b hp (infix_pair_cons_cons.2 (Or.inr hi))⟩
    · rintro ⟨h1, h2⟩ a b hp hi
      rcases infix_pair_cons_cons.1 hi with ⟨rfl, rfl⟩ | hi
      · exact h1 hp
      · exact h2 a b hp hi

/-- **Normal monomials of a quadratic system**: no adjacent pair carries a rule. -/
theorem normalFormMonomial_iff_isChain (m : Monomial G) :
    NormalFormMonomial ord d.sys m ↔ m.IsChain fun a b => (a, b) ∉ d.pairs := by
  rw [← not_pair_infix_iff_chain (fun a b => (a, b) ∈ d.pairs)]
  constructor
  · intro h a b hp
    have := h _ (d.rule_mem ⟨(a, b), hp⟩)
    rwa [d.rule_lm] at this
  · rintro h r ⟨p, rfl⟩
    rw [d.rule_lm]
    exact h _ _ p.2

end UGB.GrobnerShirshov.Quadratic

namespace UGB.GrobnerShirshov.BlockSplay

open UGB.GrobnerShirshov UGB.GrobnerShirshov.Diamond

variable {G : Type*} [DecidableEq G] {k : Type*} [CommRing k] [Nontrivial k]
  {ord : AdmissibleOrder G} {ι : Type*} [LinearOrder ι]

/-- **Normal monomials of a block splay**: the blocks increase strictly along the
    word, so each block contributes at most one letter. -/
theorem BlockData.normalFormMonomial_iff_isChain (D : BlockData G k ord ι) (m : Monomial G) :
    NormalFormMonomial ord D.quad.sys m ↔ m.IsChain fun a b => D.blk a < D.blk b := by
  rw [Quadratic.normalFormMonomial_iff_isChain]
  simp only [BlockData.quad, Set.mem_setOf_eq, not_le]

end UGB.GrobnerShirshov.BlockSplay
