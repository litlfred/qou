import UGB.GrobnerShirshov.QSerrePBW
import Mathlib.RingTheory.TwoSidedIdeal.Operations

set_option linter.unusedSectionVars false

/-!
# The standard presentation of `U_q(sl₂)` and its PBW basis

`QSerrePBW.lean` gives a basis of the quotient of the repo's free algebra
`FreeAlg SU2Gen k` by the span of the seven oriented q-Serre rules. This file
states the same result for the textbook presentation, inside Mathlib's free
algebra `MA SU2Gen k = MonoidAlgebra k (FreeMonoid SU2Gen)`.

Writing `E = E_+`, `F = E_-`, the **standard relations** (Jantzen, *Lectures on
Quantum Groups*, §1.1; Kassel, *Quantum Groups*, §VI.1) are

    K K⁻¹ = 1,   K⁻¹ K = 1,   K E K⁻¹ = q² E,   K F K⁻¹ = q⁻² F,
    E F − F E = (K − K⁻¹)/(q − q⁻¹).

Results:

* `freeAlgEquivMA`: the repo's `FreeAlg G k` is `k`-linearly Mathlib's free
  algebra.
* `ctxSpan_eq_span`: the `k`-span of the words-in-context `a · x · b` (`x ∈ R`)
  is exactly the two-sided ideal generated by `R`. So `systemIdeal` is the
  two-sided ideal generated by the rules, transported (`systemIdeal_map`).
* `uq_ideal_eq`: the q-Serre rules and the standard relations generate the
  **same** two-sided ideal. The two `K⁻¹` rules the original presentation lacked
  are consequences of the standard relations; conversely `K E K⁻¹ = q² E` follows
  from `K E = q² E K` and `K K⁻¹ = 1`.
* `uq_pbw_basis`: the classes of `F^c E^a K^n`, `(c, a, n) ∈ ℕ × ℕ × ℤ`, are a
  `k`-basis of `MA SU2Gen k` modulo the two-sided ideal of the standard
  relations.
-/

namespace UGB.GrobnerShirshov

open Diamond AlgElement SU2Gen

universe u v

section Generic

variable {G : Type u} [DecidableEq G] {k : Type v} [CommRing k]

/-- The repo's free algebra is `k`-linearly Mathlib's monoid algebra on the free
monoid. -/
noncomputable def freeAlgEquivMA : FreeAlg G k ≃ₗ[k] MA G k where
  toFun x := Quotient.liftOn x toMA (fun _ _ h => toMA_eq_of_ceq h)
  map_add' x y := by
    induction x using Quotient.inductionOn with
    | h f => induction y using Quotient.inductionOn with
      | h g => exact toMA_add f g
  map_smul' c x := by
    induction x using Quotient.inductionOn with
    | h f => exact toMA_smul c f
  invFun F := FreeAlg.mk (ofMA F)
  left_inv x := by
    induction x using Quotient.inductionOn with
    | h f => exact (FreeAlg.mk_eq_mk).2 (coeffEq_symm (ceq_ofMA_toMA f))
  right_inv F := toMA_ofMA F

theorem freeAlgEquivMA_mk (f : AlgElement G k) :
    freeAlgEquivMA (FreeAlg.mk f) = toMA f := rfl

theorem toMA_single [DecidableEq k] (w : Monomial G) :
    toMA (AlgElement.single w (1 : k)) = ofW w := by
  refine toMA_ext fun m => ?_
  rw [toMA_apply, ofW_apply]
  by_cases h : m = w
  · subst h; simp
  · rw [single_coeff_of_ne _ h, if_neg (Ne.symm h)]

/-- The `k`-span of the words-in-context `a · x · b`, `x ∈ R`. -/
def ctxSpan (R : Set (MA G k)) : Submodule k (MA G k) :=
  Submodule.span k {y | ∃ x ∈ R, ∃ a b : Monomial G, y = ofW a * x * ofW b}

theorem single_eq_smul_ofW (w : FreeMonoid G) (c : k) :
    (MonoidAlgebra.single w c : MA G k) = c • ofW (FreeMonoid.toList w) := by
  rw [ofW, FreeMonoid.ofList_toList, MonoidAlgebra.smul_single', mul_one]

theorem ctxSpan_ofW_mul (R : Set (MA G k)) {y : MA G k} (hy : y ∈ ctxSpan R)
    (w : Monomial G) : ofW w * y ∈ ctxSpan R := by
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨x, hx, a, b, rfl⟩ := hy
    refine Submodule.subset_span ⟨x, hx, w ++ a, b, ?_⟩
    rw [ofW_append, mul_assoc, mul_assoc, mul_assoc]
  | zero => simp
  | add y z _ _ hy hz => rw [mul_add]; exact add_mem hy hz
  | smul c y _ hy => rw [mul_smul_comm]; exact Submodule.smul_mem _ c hy

theorem ctxSpan_mul_ofW (R : Set (MA G k)) {y : MA G k} (hy : y ∈ ctxSpan R)
    (w : Monomial G) : y * ofW w ∈ ctxSpan R := by
  induction hy using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨x, hx, a, b, rfl⟩ := hy
    refine Submodule.subset_span ⟨x, hx, a, b ++ w, ?_⟩
    rw [ofW_append, mul_assoc]
  | zero => simp
  | add y z _ _ hy hz => rw [add_mul]; exact add_mem hy hz
  | smul c y _ hy => rw [smul_mul_assoc]; exact Submodule.smul_mem _ c hy

theorem ctxSpan_mul_left (R : Set (MA G k)) {y : MA G k} (hy : y ∈ ctxSpan R)
    (z : MA G k) : z * y ∈ ctxSpan R := by
  induction z using MonoidAlgebra.induction_linear with
  | zero => simp
  | add z₁ z₂ h₁ h₂ => rw [add_mul]; exact add_mem h₁ h₂
  | single w c =>
    rw [single_eq_smul_ofW, smul_mul_assoc]
    exact Submodule.smul_mem _ c (ctxSpan_ofW_mul R hy _)

theorem ctxSpan_mul_right (R : Set (MA G k)) {y : MA G k} (hy : y ∈ ctxSpan R)
    (z : MA G k) : y * z ∈ ctxSpan R := by
  induction z using MonoidAlgebra.induction_linear with
  | zero => simp
  | add z₁ z₂ h₁ h₂ => rw [mul_add]; exact add_mem h₁ h₂
  | single w c =>
    rw [single_eq_smul_ofW, mul_smul_comm]
    exact Submodule.smul_mem _ c (ctxSpan_mul_ofW R hy _)

/-- `ctxSpan R`, as a two-sided ideal. -/
def ctxIdeal (R : Set (MA G k)) : TwoSidedIdeal (MA G k) :=
  TwoSidedIdeal.mk' (ctxSpan R) (zero_mem _) add_mem neg_mem
    (fun hy => ctxSpan_mul_left R hy _) (fun hx => ctxSpan_mul_right R hx _)

/-- **`ctxSpan R` is the two-sided ideal generated by `R`.** -/
theorem ctxSpan_eq_span (R : Set (MA G k)) :
    (ctxSpan R : Set (MA G k)) = TwoSidedIdeal.span R := by
  apply Set.Subset.antisymm
  · intro y hy
    induction hy using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨x, hx, a, b, rfl⟩ := hy
      exact TwoSidedIdeal.mul_mem_right _ _ _
        (TwoSidedIdeal.mul_mem_left _ _ _ (TwoSidedIdeal.subset_span hx))
    | zero => exact zero_mem _
    | add y z _ _ hy hz => exact add_mem hy hz
    | smul c y _ hy =>
      rw [Algebra.smul_def]; exact TwoSidedIdeal.mul_mem_left _ _ _ hy
  · intro y hy
    have hle : TwoSidedIdeal.span R ≤ ctxIdeal R := by
      rw [TwoSidedIdeal.span_le]
      intro x hx
      show x ∈ ctxIdeal R
      rw [ctxIdeal, TwoSidedIdeal.mem_mk']
      exact Submodule.subset_span ⟨x, hx, [], [], by rw [ofW_nil, one_mul, mul_one]⟩
    have := hle hy
    rw [ctxIdeal, TwoSidedIdeal.mem_mk'] at this
    exact this

/-- The relations of a rewriting system, in `MA`. -/
def sysRels (sys : RewritingSystem G k) : Set (MA G k) :=
  {x | ∃ r ∈ sys.rules, x = toMA r.relation}

/-- **`systemIdeal` is the two-sided ideal generated by the rules**, transported
to Mathlib's free algebra. -/
theorem systemIdeal_map (sys : RewritingSystem G k) :
    (systemIdeal sys).map (freeAlgEquivMA (G := G) (k := k)).toLinearMap =
      ctxSpan (sysRels sys) := by
  rw [systemIdeal, Submodule.map_span, ctxSpan]
  congr 1
  ext y
  simp only [relationContexts, sysRels, Set.mem_image, Set.mem_setOf_eq]
  constructor
  · rintro ⟨_, ⟨r, hr, a, b, rfl⟩, rfl⟩
    exact ⟨_, ⟨r, hr, rfl⟩, a, b, toMA_contextMul a b r.relation⟩
  · rintro ⟨_, ⟨r, hr, rfl⟩, a, b, rfl⟩
    exact ⟨_, ⟨r, hr, a, b, rfl⟩, toMA_contextMul a b r.relation⟩

end Generic

section Uq

variable {k : Type v} [Field k] (qs : QSerreRelations k)

/-- The generators, as elements of the free algebra. -/
noncomputable def gE : MA SU2Gen k := ofW [E_plus]
noncomputable def gF : MA SU2Gen k := ofW [E_minus]
noncomputable def gK : MA SU2Gen k := ofW [K]
noncomputable def gKi : MA SU2Gen k := ofW [K_inv]

/-- **The standard relations of `U_q(sl₂)`** (Jantzen §1.1, Kassel §VI.1). -/
def uqStdRels : Set (MA SU2Gen k) :=
  {gK * gKi - 1, gKi * gK - 1,
   gK * gE * gKi - qs.q ^ 2 • gE,
   gK * gF * gKi - (qs.q ^ 2)⁻¹ • gF,
   gE * gF - gF * gE - (qs.q - qs.q⁻¹)⁻¹ • (gK - gKi)}

/-- **The q-Serre rules and the standard relations generate the same two-sided
ideal.** -/
theorem uq_ideal_eq :
    TwoSidedIdeal.span (sysRels (qSerreRewritingSystem k qs)) =
      TwoSidedIdeal.span (uqStdRels qs) := by
  have hq := qs.q_ne_zero
  set I := TwoSidedIdeal.span (uqStdRels qs)
  set J := TwoSidedIdeal.span (sysRels (qSerreRewritingSystem k qs))
  have s1 : gK * gKi - 1 ∈ I := TwoSidedIdeal.subset_span (by simp [uqStdRels])
  have s2 : gKi * gK - 1 ∈ I := TwoSidedIdeal.subset_span (by simp [uqStdRels])
  have s3 : gK * gE * gKi - qs.q ^ 2 • gE ∈ I :=
    TwoSidedIdeal.subset_span (by simp [uqStdRels])
  have s4 : gK * gF * gKi - (qs.q ^ 2)⁻¹ • gF ∈ I :=
    TwoSidedIdeal.subset_span (by simp [uqStdRels])
  have s5 : gE * gF - gF * gE - (qs.q - qs.q⁻¹)⁻¹ • (gK - gKi) ∈ I :=
    TwoSidedIdeal.subset_span (by simp [uqStdRels])
  have mem : ∀ r ∈ (qSerreRewritingSystem k qs).rules, toMA r.relation ∈ J :=
    fun r hr => TwoSidedIdeal.subset_span ⟨r, hr, rfl⟩
  have t1 := mem _ (QSerreGS.mem1 qs)
  have t2 := mem _ (QSerreGS.mem2 qs)
  have t3 := mem _ (QSerreGS.mem3 qs)
  have t4 := mem _ (QSerreGS.mem4 qs)
  have t5 := mem _ (QSerreGS.mem5 qs)
  rw [QSerreGS.r1] at t1
  rw [QSerreGS.r2] at t2
  rw [QSerreGS.r3] at t3
  rw [QSerreGS.r4] at t4
  rw [QSerreGS.r5] at t5
  -- expand everything into words
  simp only [gE, gF, gK, gKi, ← ofW_append, List.cons_append, List.nil_append,
    ofW_nil] at s1 s2 s3 s4 s5 ⊢
  apply le_antisymm
  · rw [TwoSidedIdeal.span_le]
    rintro x ⟨r, hr, rfl⟩
    simp only [qSerreRewritingSystem, qSerreRules, List.mem_cons, List.not_mem_nil,
      or_false] at hr
    rcases hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · rw [QSerreGS.r1]; convert s1 using 1; simp only [ofW_nil]; module
    · rw [QSerreGS.r2]; convert s2 using 1; simp only [ofW_nil]; module
    · -- K E − q² E K = s₃ K − (K E) s₂
      rw [QSerreGS.r3]
      have h := sub_mem (TwoSidedIdeal.mul_mem_right _ _ (ofW [K]) s3)
        (TwoSidedIdeal.mul_mem_left _ (ofW [K, E_plus]) _ s2)
      convert h using 1
      simp only [mul_sub, sub_mul, smul_mul_assoc, ← ofW_append, List.cons_append,
        List.nil_append, ofW_nil, mul_one]
      module
    · rw [QSerreGS.r4]
      have h := sub_mem (TwoSidedIdeal.mul_mem_right _ _ (ofW [K]) s4)
        (TwoSidedIdeal.mul_mem_left _ (ofW [K, E_minus]) _ s2)
      convert h using 1
      simp only [mul_sub, sub_mul, smul_mul_assoc, ← ofW_append, List.cons_append,
        List.nil_append, ofW_nil, mul_one]
      module
    · rw [QSerreGS.r5]; convert s5 using 1; module
    · -- K⁻¹ E − q⁻² E K⁻¹ = −q⁻² K⁻¹ s₃ + q⁻² s₂ E K⁻¹
      rw [QSerreGS.r6]
      have h := add_mem
        (TwoSidedIdeal.mul_mem_left _ ((-(qs.q ^ 2)⁻¹) • ofW [K_inv]) _ s3)
        (TwoSidedIdeal.mul_mem_right _ _ ((qs.q ^ 2)⁻¹ • ofW [E_plus, K_inv]) s2)
      convert h using 1
      simp only [mul_sub, sub_mul, smul_mul_assoc, mul_smul_comm, ← ofW_append,
        List.cons_append, List.nil_append, ofW_nil, mul_one, one_mul, smul_sub, smul_smul]
      match_scalars <;> field_simp <;> ring
    · rw [QSerreGS.r7]
      have h := add_mem
        (TwoSidedIdeal.mul_mem_left _ ((-(qs.q ^ 2)) • ofW [K_inv]) _ s4)
        (TwoSidedIdeal.mul_mem_right _ _ (qs.q ^ 2 • ofW [E_minus, K_inv]) s2)
      convert h using 1
      simp only [mul_sub, sub_mul, smul_mul_assoc, mul_smul_comm, ← ofW_append,
        List.cons_append, List.nil_append, ofW_nil, mul_one, one_mul, smul_sub, smul_smul]
      match_scalars <;> field_simp <;> ring
  · rw [TwoSidedIdeal.span_le]
    intro x hx
    simp only [uqStdRels, gE, gF, gK, gKi, ← ofW_append, List.cons_append, List.nil_append,
      ofW_nil, Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl | rfl | rfl
    · convert t1 using 1; simp only [ofW_nil]; module
    · convert t2 using 1; simp only [ofW_nil]; module
    · -- K E K⁻¹ − q² E = r₃ K⁻¹ + q² E r₁
      have h := add_mem (TwoSidedIdeal.mul_mem_right _ _ (ofW [K_inv]) t3)
        (TwoSidedIdeal.mul_mem_left _ (qs.q ^ 2 • ofW [E_plus]) _ t1)
      convert h using 1
      simp only [add_mul, mul_add, smul_mul_assoc, mul_smul_comm, ← ofW_append,
        List.cons_append, List.nil_append, ofW_nil, mul_one, smul_add, smul_smul]
      module
    · have h := add_mem (TwoSidedIdeal.mul_mem_right _ _ (ofW [K_inv]) t4)
        (TwoSidedIdeal.mul_mem_left _ ((qs.q ^ 2)⁻¹ • ofW [E_minus]) _ t1)
      convert h using 1
      simp only [add_mul, mul_add, smul_mul_assoc, mul_smul_comm, ← ofW_append,
        List.cons_append, List.nil_append, ofW_nil, mul_one, smul_add, smul_smul]
      module
    · convert t5 using 1; module

theorem ofW_replicate (n : ℕ) (x : SU2Gen) :
    (ofW (List.replicate n x) : MA SU2Gen k) = (ofW [x]) ^ n := by
  induction n with
  | zero => simp [ofW_nil]
  | succ n ih => rw [List.replicate_succ', ofW_append, ih, pow_succ]

/-- `ofW (pbwWord c a n)` is `F^c E^a K^n` in the free algebra. -/
theorem ofW_pbwWord (c a : ℕ) (n : ℤ) :
    (ofW (pbwWord c a n) : MA SU2Gen k) = gF ^ c * gE ^ a *
      (match n with
       | Int.ofNat j => gK ^ j
       | Int.negSucc j => gKi ^ (j + 1)) := by
  cases n <;> simp [pbwWord, kPow, ofW_append, ofW_replicate, gF, gE, gK, gKi, mul_assoc]

/-- **PBW theorem for the standard presentation of `U_q(sl₂)`.** Modulo the
two-sided ideal generated by the standard relations (`ctxSpan_eq_span`), the
words `F^c E^a K^n` (`ofW_pbwWord`), `(c, a, n) ∈ ℕ × ℕ × ℤ`, form a `k`-basis. -/
theorem uq_pbw_basis [DecidableEq k] :
    ∃ B : Module.Basis (ℕ × ℕ × ℤ) k (MA SU2Gen k ⧸ ctxSpan (uqStdRels qs)),
      ∀ p : ℕ × ℕ × ℤ, B p = Submodule.Quotient.mk (ofW (pbwWord p.1 p.2.1 p.2.2)) := by
  obtain ⟨B₀, hB₀⟩ := qSerre_pbw_basis k qs
  have hsp : ctxSpan (sysRels (qSerreRewritingSystem k qs)) = ctxSpan (uqStdRels qs) :=
    SetLike.coe_injective (by rw [ctxSpan_eq_span, ctxSpan_eq_span, uq_ideal_eq])
  let e := Submodule.Quotient.equiv _ _ (freeAlgEquivMA (G := SU2Gen) (k := k))
    ((systemIdeal_map _).trans hsp)
  refine ⟨B₀.map e, fun p => ?_⟩
  rw [Module.Basis.map_apply, hB₀]
  show Submodule.Quotient.mk (freeAlgEquivMA (FreeAlg.mk _)) = _
  rw [freeAlgEquivMA_mk, toMA_single]

end Uq

end UGB.GrobnerShirshov
