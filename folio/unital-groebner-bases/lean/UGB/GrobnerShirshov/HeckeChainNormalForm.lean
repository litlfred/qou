import UGB.GrobnerShirshov.DiamondLemma
import UGB.GrobnerShirshov.HeckeCompletion
import Mathlib.Algebra.MonoidAlgebra.Support
import Mathlib.Data.List.FinRange
import Mathlib.Tactic.Module

/-!
# The Hecke-only reduction of the block-ordered chain element

`prop:tm-gs-normal-form` (appendix-transfer-matrices) claims that the block-ordered
element

    Ξ = ∏ᵢ ∏_{(c,d) ∈ Lᵢ} (c σᵢ + d)        (blocks in increasing i)

reduces, using the Hecke rule `σᵢ² → (q − q⁻¹)σᵢ + 1` alone, to the chain form
`∏ᵢ (aᵢ σᵢ + bᵢ)` whose pairs `(aᵢ, bᵢ)` follow the transfer-matrix recurrence,
and that the chain form is the Gröbner–Shirshov normal form of `Ξ`.

This file proves that, for the completed Hecke system
`heckeCompletedRewritingSystem` (Hecke, Yang–Baxter, far-commutativity and the
Bokut–Shiao family), in the following precise form.

* `chainXi_sub_chainForm_mem` — `Ξ − ∏ᵢ (aᵢσᵢ + bᵢ)` lies in the two-sided ideal
  generated by the **Hecke relations alone**. This is what "uses only the Hecke
  rule" means algebraically: no Yang–Baxter, far-commutativity or Bokut–Shiao
  relation is needed to pass from `Ξ` to the chain form.
* `chainForm_isNormalForm` — the chain form is irreducible for the whole completed
  system: every word in its support has strictly increasing generator indices, and
  no leading word of the four rule families does.
* `chainXi_normalForm`, `chainXi_normalForm_exists` — hence every normal form of
  `Ξ` is the chain form, up to `CoeffEq`. Uniqueness comes from the Diamond Lemma
  (`DiamondLemma.lean`), through `nf_eq_of_twoIdeal` (§1), which says an element
  of the ideal of a Gröbner–Shirshov system with unit leading coefficients reduces
  to zero.

## What this does not say

It does not say that *every* reduction path from `Ξ` avoids the other rules.
A path may apply a far-commutativity rule and undo its effect later; the
statement here is about where reduction ends and which relations the
difference needs, not about each path. The step count `C(A−1, 2)` of the
proposition is not formalised here either.

The coefficient ring is `ℝ` because the Hecke system is defined over `ℝ`
(`HeckeParams`). §1, the ideal-to-normal-form part, is generic over a `CommRing`.

-- Ref: [bergman1978] https://doi.org/10.1016/0001-8708(78)90010-5
-- Ref: [leitner2026] folio/quantum-observable-universe/appendix-transfer-matrices/tm-gs-normal-form.md
-/

set_option linter.unusedSectionVars false

namespace UGB.GrobnerShirshov.Diamond

open UGB.GrobnerShirshov AlgElement

universe u v

variable {G : Type u} [DecidableEq G] {k : Type v} [CommRing k]

/-! ## §1  The two-sided ideal generated by a set, and normal forms modulo it -/

/-- The two-sided ideal of the free algebra generated by `S`. -/
inductive TwoIdeal (S : Set (MA G k)) : MA G k → Prop
  | gen (X g Y : MA G k) (hg : g ∈ S) : TwoIdeal S (X * g * Y)
  | zero : TwoIdeal S 0
  | add {F H : MA G k} : TwoIdeal S F → TwoIdeal S H → TwoIdeal S (F + H)
  | smul (c : k) {F : MA G k} : TwoIdeal S F → TwoIdeal S (c • F)

namespace TwoIdeal

variable {S : Set (MA G k)}

theorem neg {F : MA G k} (h : TwoIdeal S F) : TwoIdeal S (-F) := by
  have := TwoIdeal.smul (-1 : k) h; rwa [neg_one_smul] at this

theorem sub {F H : MA G k} (hF : TwoIdeal S F) (hH : TwoIdeal S H) : TwoIdeal S (F - H) := by
  rw [sub_eq_add_neg]; exact hF.add hH.neg

theorem mul_left (Z : MA G k) {F : MA G k} (h : TwoIdeal S F) : TwoIdeal S (Z * F) := by
  induction h with
  | gen X g Y hg => rw [← mul_assoc, ← mul_assoc]; exact gen (Z * X) g Y hg
  | zero => rw [mul_zero]; exact zero
  | add _ _ ihF ihH => rw [mul_add]; exact ihF.add ihH
  | smul c _ ih => rw [mul_smul_comm]; exact ih.smul c

theorem mul_right (Z : MA G k) {F : MA G k} (h : TwoIdeal S F) : TwoIdeal S (F * Z) := by
  induction h with
  | gen X g Y hg => rw [mul_assoc]; exact gen X g (Y * Z) hg
  | zero => rw [zero_mul]; exact zero
  | add _ _ ihF ihH => rw [add_mul]; exact ihF.add ihH
  | smul c _ ih => rw [smul_mul_assoc]; exact ih.smul c

theorem mono {S T : Set (MA G k)} (hST : S ⊆ T) {F : MA G k} (h : TwoIdeal S F) :
    TwoIdeal T F := by
  induction h with
  | gen X g Y hg => exact gen X g Y (hST hg)
  | zero => exact zero
  | add _ _ ihF ihH => exact ihF.add ihH
  | smul c _ ih => exact ih.smul c

/-- `∏ Xᵢ − ∏ Yᵢ` lies in the ideal when every `Xᵢ − Yᵢ` does. -/
theorem prod_sub_prod {ι : Type*} (l : List ι) (X Y : ι → MA G k)
    (h : ∀ i ∈ l, TwoIdeal S (X i - Y i)) :
    TwoIdeal S ((l.map X).prod - (l.map Y).prod) := by
  induction l with
  | nil => simp only [List.map_nil, List.prod_nil, sub_self]; exact zero
  | cons i l ih =>
    simp only [List.map_cons, List.prod_cons]
    have e : X i * (l.map X).prod - Y i * (l.map Y).prod =
        (X i - Y i) * (l.map X).prod + Y i * ((l.map X).prod - (l.map Y).prod) := by
      noncomm_ring
    rw [e]
    exact ((h i (by simp)).mul_right _).add
      ((ih (fun j hj => h j (by simp [hj]))).mul_left _)

end TwoIdeal

variable {ord : AdmissibleOrder G} {sys : RewritingSystem G k}

variable (ord sys) in
/-- The relations of a rewriting system, in the free algebra. -/
def relSet : Set (MA G k) := {F | ∃ r ∈ sys.rules, F = toMA r.relation}

theorem zeroNF_sum (hgs : IsGrobnerShirshovBasis G k ord sys)
    (hlc : ∀ r ∈ sys.rules, IsUnit (r.lc ord)) {ι : Type*} (s : Finset ι) (F : ι → MA G k)
    (h : ∀ i ∈ s, ZeroNF ord sys (ofMA (F i))) : ZeroNF ord sys (ofMA (∑ i ∈ s, F i)) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using zeroNF_of_isZero (ord := ord) (sys := sys) (ofMA_zero (G := G) (k := k))
  | insert i s hi ih =>
    rw [Finset.sum_insert hi]
    exact zeroNF_congr hlc (ofMA_add _ _)
      (zeroNF_add hlc (reductionUnique ord sys hgs hlc _) (reductionUnique ord sys hgs hlc _)
        (h i (Finset.mem_insert_self _ _)) (ih (fun j hj => h j (Finset.mem_insert_of_mem hj))))

/-- Every element of the ideal of the relations reduces to zero. -/
theorem zeroNF_of_twoIdeal (hgs : IsGrobnerShirshovBasis G k ord sys)
    (hlc : ∀ r ∈ sys.rules, IsUnit (r.lc ord)) {F : MA G k}
    (h : TwoIdeal (relSet sys) F) : ZeroNF ord sys (ofMA F) := by
  induction h with
  | gen X g Y hg =>
    obtain ⟨r, hr, rfl⟩ := hg
    have e : X * toMA r.relation * Y = ∑ p ∈ X.support, ∑ q ∈ Y.support,
        (X p * Y q) • (ofW (FreeMonoid.toList p) * toMA r.relation *
          ofW (FreeMonoid.toList q)) := by
      conv_lhs => rw [ma_eq_sum X, ma_eq_sum Y]
      rw [Finset.sum_mul, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun p _ => ?_)
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun q _ => ?_)
      simp only [smul_mul_assoc, mul_smul_comm, smul_smul]
      rw [mul_comm (Y q)]
    rw [e]
    refine zeroNF_sum hgs hlc _ _ (fun p _ => zeroNF_sum hgs hlc _ _ (fun q _ => ?_))
    exact zeroNF_congr hlc (ofMA_smul _ _)
      (zeroNF_smul hlc _ (reductionUnique ord sys hgs hlc _)
        (zeroNF_congr hlc (ofMA_ctx _ _ _)
          (zeroNF_ctx hlc ⟨r, FreeMonoid.toList p, FreeMonoid.toList q⟩ hr)))
  | zero => exact zeroNF_of_isZero ofMA_zero
  | add _ _ ihF ihH =>
    exact zeroNF_congr hlc (ofMA_add _ _)
      (zeroNF_add hlc (reductionUnique ord sys hgs hlc _) (reductionUnique ord sys hgs hlc _)
        ihF ihH)
  | smul c _ ih =>
    exact zeroNF_congr hlc (ofMA_smul _ _)
      (zeroNF_smul hlc c (reductionUnique ord sys hgs hlc _) ih)

/-- **Normal forms modulo the ideal.** If `f − n` lies in the ideal of the
    relations and `n` is normal, every normal form of `f` is `n`, up to `CoeffEq`. -/
theorem nf_eq_of_twoIdeal (hgs : IsGrobnerShirshovBasis G k ord sys)
    (hlc : ∀ r ∈ sys.rules, IsUnit (r.lc ord)) {f n nf : AlgElement G k}
    (hn : isNormalForm ord sys n) (hI : TwoIdeal (relSet sys) (toMA f - toMA n))
    (hnf : ReducesToNF ord sys f nf) : CoeffEq nf n := by
  obtain ⟨z, hz, hz0⟩ := zeroNF_of_twoIdeal hgs hlc hI
  have hsum : CoeffEq (add n (ofMA (toMA f - toMA n))) f :=
    ceq_of_toMA_eq (by rw [toMA_add, toMA_ofMA]; abel)
  obtain ⟨nf', hnf', e⟩ := nf_of_congr hlc hsum hnf
  have := nf_add hlc (reductionUnique ord sys hgs hlc n) (reductionUnique ord sys hgs hlc _)
    hnf' ⟨MultiStepReduction.refl n, hn⟩ hz
  intro m
  rw [← e m, this m, add_coeff, hz0 m, add_zero]



/-! ## §2  The Hecke chain -/

section HeckeChain

open UGB.GrobnerShirshov.Hecke

variable {n : ℕ} (hp : HeckeParams)

/-- The generator `σᵢ` in the free algebra. -/
noncomputable def sg (i : Fin n) : MA (HeckeGen n) ℝ := ofW [⟨i⟩]

/-- The Hecke scalar `q − q⁻¹`. -/
noncomputable def hq : ℝ := hp.q - hp.q⁻¹

theorem toMA_heckeRelation (i : Fin n) :
    toMA (heckeRelation i hp).relation = sg i * sg i - hq hp • sg i - 1 := by
  apply toMA_ext
  intro m
  rw [toMA_apply]
  have e1 : sg i * sg i = (ofW [⟨i⟩, ⟨i⟩] : MA (HeckeGen n) ℝ) := by
    rw [sg, ← ofW_append]; rfl
  have e0 : (1 : MA (HeckeGen n) ℝ) = ofW [] := rfl
  rw [e1, e0, Finsupp.sub_apply, Finsupp.sub_apply, Finsupp.smul_apply, smul_eq_mul, sg,
    ofW_apply, ofW_apply, ofW_apply]
  simp only [heckeRelation, AlgElement.ofTerms, hq]
  by_cases h2 : [(⟨i⟩ : HeckeGen n), ⟨i⟩] = m
  · subst h2; simp
  · by_cases h1 : [(⟨i⟩ : HeckeGen n)] = m
    · subst h1; simp
    · by_cases h0 : ([] : Monomial (HeckeGen n)) = m
      · subst h0; simp
      · simp [List.filter, h2, h1, h0]

/-- A linear form `c σᵢ + d`. -/
noncomputable def lin (i : Fin n) (p : ℝ × ℝ) : MA (HeckeGen n) ℝ :=
  p.1 • sg i + p.2 • (1 : MA (HeckeGen n) ℝ)

/-- The coefficient pair of a block `∏ (cⱼ σᵢ + dⱼ)` after Hecke reduction: the
    transfer-matrix recurrence `(a, b) ↦ (c a h + c b + d a, c a + d b)`, from `(0, 1)`. -/
noncomputable def blockCoeff (h : ℝ) : List (ℝ × ℝ) → ℝ × ℝ :=
  List.foldr (fun cd ab => (cd.1 * ab.1 * h + cd.1 * ab.2 + cd.2 * ab.1,
    cd.1 * ab.1 + cd.2 * ab.2)) (0, 1)

/-- The relations of the Hecke family alone (no Yang–Baxter, far-commutativity
    or Bokut–Shiao rule). -/
def heckeOnlySet : Set (MA (HeckeGen n) ℝ) :=
  {F | ∃ i : Fin n, F = toMA (heckeRelation i hp).relation}

theorem lin_mul_lin (i : Fin n) (p r : ℝ × ℝ) :
    lin i p * lin i r - lin i (p.1 * r.1 * hq hp + p.1 * r.2 + p.2 * r.1,
      p.1 * r.1 + p.2 * r.2) = (p.1 * r.1) • toMA (heckeRelation i hp).relation := by
  rw [toMA_heckeRelation]
  simp only [lin, add_mul, mul_add, smul_mul_assoc, mul_smul_comm, smul_smul, one_mul,
    mul_one, smul_sub, add_smul]
  module

/-- **One block reduces using the Hecke rule of its own generator only.** -/
theorem block_mem (i : Fin n) (L : List (ℝ × ℝ)) :
    TwoIdeal (heckeOnlySet hp)
      ((L.map (lin i)).prod - lin i (blockCoeff (hq hp) L)) := by
  induction L with
  | nil =>
    have : lin i (blockCoeff (hq hp) []) = 1 := by
      simp [lin, blockCoeff]
    rw [List.map_nil, List.prod_nil, this, sub_self]; exact TwoIdeal.zero
  | cons p L ih =>
    rw [List.map_cons, List.prod_cons]
    have e : lin i p * (L.map (lin i)).prod - lin i (blockCoeff (hq hp) (p :: L)) =
        lin i p * ((L.map (lin i)).prod - lin i (blockCoeff (hq hp) L)) +
        (lin i p * lin i (blockCoeff (hq hp) L) - lin i (blockCoeff (hq hp) (p :: L))) := by
      noncomm_ring
    rw [e]
    refine (ih.mul_left _).add ?_
    have hc : blockCoeff (hq hp) (p :: L) =
        (p.1 * (blockCoeff (hq hp) L).1 * hq hp + p.1 * (blockCoeff (hq hp) L).2 +
          p.2 * (blockCoeff (hq hp) L).1,
          p.1 * (blockCoeff (hq hp) L).1 + p.2 * (blockCoeff (hq hp) L).2) := rfl
    rw [hc, lin_mul_lin]
    have g := TwoIdeal.gen (S := heckeOnlySet hp) 1 _ 1 ⟨i, rfl⟩
    rw [one_mul, mul_one] at g
    exact g.smul _

/-- The block-ordered element `Ξ = ∏ᵢ ∏_{(c,d) ∈ Lᵢ} (c σᵢ + d)`, blocks in increasing `i`. -/
noncomputable def chainXi (L : Fin n → List (ℝ × ℝ)) : MA (HeckeGen n) ℝ :=
  ((List.finRange n).map (fun i => ((L i).map (lin i)).prod)).prod

/-- The chain form `∏ᵢ (aᵢ σᵢ + bᵢ)`, `(aᵢ, bᵢ)` given by the transfer-matrix recurrence. -/
noncomputable def chainForm (L : Fin n → List (ℝ × ℝ)) : MA (HeckeGen n) ℝ :=
  ((List.finRange n).map (fun i => lin i (blockCoeff (hq hp) (L i)))).prod

/-- **`Ξ` and the chain form differ by an element of the ideal of the Hecke
    relations alone.** -/
theorem chainXi_sub_chainForm_mem (L : Fin n → List (ℝ × ℝ)) :
    TwoIdeal (heckeOnlySet hp) (chainXi L - chainForm hp L) :=
  TwoIdeal.prod_sub_prod _ _ _ (fun i _ => block_mem hp i (L i))

/-! ### Normality of the chain form -/

/-- The support of `∏_{i ∈ l} (aᵢ σᵢ + bᵢ)` consists of subwords of `l`. -/
theorem support_prod_lin (ab : Fin n → ℝ × ℝ) (l : List (Fin n)) :
    ∀ x ∈ ((l.map (fun i => lin i (ab i))).prod).support,
      (FreeMonoid.toList x).Sublist (l.map (fun i => (⟨i⟩ : HeckeGen n))) := by
  classical
  induction l with
  | nil =>
    intro x hx
    rw [List.map_nil, List.prod_nil, MonoidAlgebra.one_def] at hx
    rw [Finset.mem_singleton.mp (Finsupp.support_single_subset hx)]
    simp
  | cons i l ih =>
    intro x hx
    rw [List.map_cons, List.prod_cons] at hx
    obtain ⟨y, hy, z, hz, rfl⟩ := Finset.mem_mul.mp (MonoidAlgebra.support_mul _ _ hx)
    have hz' := ih z hz
    rw [FreeMonoid.toList_mul, List.map_cons]
    have hy' : y = FreeMonoid.ofList [⟨i⟩] ∨ y = 1 := by
      have h1 := Finsupp.support_add hy
      rcases Finset.mem_union.mp h1 with h | h
      · have := Finsupp.support_smul h
        have := Finsupp.support_single_subset this
        exact Or.inl (Finset.mem_singleton.mp this)
      · have := Finsupp.support_smul h
        rw [MonoidAlgebra.one_def] at this
        exact Or.inr (Finset.mem_singleton.mp (Finsupp.support_single_subset this))
    rcases hy' with rfl | rfl
    · exact hz'.cons₂ _
    · simpa using hz'.cons _

theorem gens_pairwise :
    ((List.finRange n).map (fun i => (⟨i⟩ : HeckeGen n))).Pairwise
      (fun a b => a.index < b.index) := by
  rw [List.pairwise_map]
  exact List.pairwise_lt_finRange n

theorem mem_descWord {i j : Fin n} (h : j.val ≤ i.val) : (⟨i⟩ : HeckeGen n) ∈ descWord i j := by
  simp only [descWord, List.mem_map, List.mem_reverse, List.mem_filter, List.mem_finRange,
    true_and, decide_eq_true_eq, HeckeGen.mk.injEq]
  exact ⟨i, ⟨h, le_refl _⟩, rfl⟩

/-- **The chain form is irreducible for the completed system**: every word in
    its support has strictly increasing generator indices, and no leading word of
    the four rule families does. -/
theorem chainForm_isNormalForm (hn : 0 < n) (L : Fin n → List (ℝ × ℝ)) :
    isNormalForm (heckeOrder n) (heckeCompletedRewritingSystem n hn hp)
      (ofMA (chainForm hp L)) := by
  intro r hr m hm hinf
  have hx : FreeMonoid.ofList m ∈ (chainForm hp L).support := Finsupp.mem_support_iff.mpr hm
  have hsub := support_prod_lin (fun i => blockCoeff (hq hp) (L i)) _ _ hx
  rw [FreeMonoid.toList_ofList] at hsub
  have hpw : (r.lm (heckeOrder n)).Pairwise (fun a b : HeckeGen n => a.index < b.index) :=
    (gens_pairwise.sublist hsub).sublist hinf.sublist
  rcases heckeCompletedRewritingSystem_lm_cases hn hp r hr with
    ⟨i, he⟩ | ⟨i, j, _, he⟩ | ⟨i, j, hij, he⟩ | ⟨i', i, j, hi, hj, he⟩ <;> rw [he] at hpw
  · simp at hpw
  · simp at hpw
  · have := (List.pairwise_cons.mp hpw).1 _ (List.mem_singleton_self _)
    simp only [Fin.lt_def] at this; omega
  · rw [bsWord₁, List.pairwise_append] at hpw
    have := hpw.2.2 _ (mem_descWord (by omega)) _ (List.mem_singleton_self _)
    exact lt_irrefl _ this

/-- **The Hecke-only Gröbner–Shirshov reduction of the block-ordered element.**
    Every normal form of `Ξ = ∏ᵢ ∏_{(c,d) ∈ Lᵢ} (c σᵢ + d)` under the completed
    Hecke system is the chain form `∏ᵢ (aᵢ σᵢ + bᵢ)`, whose pairs `(aᵢ, bᵢ)` come
    from the transfer-matrix recurrence — up to `CoeffEq`. -/
theorem chainXi_normalForm (hn : 0 < n) (L : Fin n → List (ℝ × ℝ))
    {nf : AlgElement (HeckeGen n) ℝ}
    (h : ReducesToNF (heckeOrder n) (heckeCompletedRewritingSystem n hn hp)
      (ofMA (chainXi L)) nf) :
    CoeffEq nf (ofMA (chainForm hp L)) := by
  refine nf_eq_of_twoIdeal (heckeCompleted_isGrobnerShirshovBasis hn hp)
    (heckeCompleted_rules_lc_isUnit hn hp) (chainForm_isNormalForm hp hn L) ?_ h
  rw [toMA_ofMA, toMA_ofMA]
  exact (chainXi_sub_chainForm_mem hp L).mono
    (fun F hF => by
      obtain ⟨i, hF⟩ := hF
      exact ⟨_, heckeRelation_mem hn hp i, hF⟩)

/-- Existence and uniqueness together: `Ξ` has a normal form, and every one is the chain form. -/
theorem chainXi_normalForm_exists (hn : 0 < n) (L : Fin n → List (ℝ × ℝ)) :
    ∃ nf, ReducesToNF (heckeOrder n) (heckeCompletedRewritingSystem n hn hp)
      (ofMA (chainXi L)) nf ∧ CoeffEq nf (ofMA (chainForm hp L)) := by
  obtain ⟨nf, h⟩ := normal_form_exists (heckeOrder n) (heckeCompletedRewritingSystem n hn hp)
    (heckeCompleted_rules_lc_isUnit hn hp) (ofMA (chainXi L))
  exact ⟨nf, h, chainXi_normalForm hp hn L h⟩

end HeckeChain

end UGB.GrobnerShirshov.Diamond
