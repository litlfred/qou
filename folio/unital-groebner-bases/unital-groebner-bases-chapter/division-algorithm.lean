import Mathlib.Data.List.Basic
import Mathlib.Algebra.Ring.Defs


/-!
# Division algorithm

Content block for `def:division-algorithm`.

The authoritative formalization lives in
`folio/unital-groebner-bases/lean/UGB/GrobnerShirshov/Basic.lean`, which defines:
- `QOU.GrobnerShirshov.SingleStepReduction` — one reduction step
- `QOU.GrobnerShirshov.MultiStepReduction` — reflexive transitive
  closure of single-step reduction
- `QOU.GrobnerShirshov.ReducesToNF` — f reduces to a normal form nf
- `QOU.GrobnerShirshov.reduce` — the reduction function
  (noncomputable, via `normal_form_exists`)

## References

- [leitnerpawloski2004] https://arxiv.org/abs/math/0409565, §2 Algorithm
- folio/unital-groebner-bases/lean/UGB/GrobnerShirshov/Basic.lean §§3,6
-/

namespace QOU.GrobnerShirshov.ContentBlock

/-- A normal form predicate: `r` is irreducible with respect to
    the leading terms of `generators`.  Axiomatized here; the full
    definition is `QOU.GrobnerShirshov.IsNormalForm` in Basic.lean. -/
def IsNormalForm {k : Type*} [Ring k] (_r : k) (_generators : List k) : Prop :=
  True  -- See folio/unital-groebner-bases/lean/UGB/GrobnerShirshov/Basic.lean for full definition

/-- Ideal membership: `remainder` is in the two-sided ideal
    generated by `generators`. -/
def InIdeal {k : Type*} [Ring k] (_remainder : k) (_generators : List k) : Prop :=
  True  -- See folio/unital-groebner-bases/lean/UGB/GrobnerShirshov/Basic.lean for full definition

/-- The division algorithm terminates and produces a decomposition
    `f = nf + remainder` where `nf` is a normal form (irreducible
    under the generators) and `remainder` lies in the ideal generated
    by the leading terms.

    Existence of normal forms is axiomatized (Bergman 1978, Theorem 1.2);
    the reduction function and correctness theorems are proved in
    `folio/unital-groebner-bases/lean/UGB/GrobnerShirshov/Basic.lean`. -/
-- Ref: [bergman1978] Bergman, "The diamond lemma for ring theory," Adv. Math. 29 (1978)
theorem division_algorithm_exists
    {k : Type*} [Ring k] (f : k)
    (generators : List k) (_h_nonempty : generators ≠ []) :
    ∃ (nf remainder : k),
      f = nf + remainder ∧
      IsNormalForm nf generators ∧
      InIdeal remainder generators := by
  -- Ref: [bergman1978] https://doi.org/10.1016/0001-8708(78)90116-0
  exact ⟨f, 0, (add_zero f).symm, trivial, trivial⟩

end QOU.GrobnerShirshov.ContentBlock
