ub.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/measurement-observation/bundle-isotopy-equivalence.lean#L17-L29","doc":"Isotopy equivalence of bundle initial conditions.\nTwo configurations {(pᵢ, Hᵢ)} and {(p_{σ(i)}, H'_{σ(i)})} are\nequivalent if related by a permutation σ and ambient isotopy.\n\nLaTeX: `\\label{def:bundle-isotopy-equivalence}` ","formalizes":[{"@id":"block:def:bundle-isotopy-equivalence","label":"def:bundle-isotopy-equivalence","md":"quantum-observable-universe/measurement-observation/bundle-isotopy-equivalence.md"}],"signatureChunk":0}]}