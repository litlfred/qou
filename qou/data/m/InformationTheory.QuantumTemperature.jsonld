{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:InformationTheory.QuantumTemperature","@type":"LeanModule","name":"InformationTheory.QuantumTemperature","imports":["lean:module:Init","lean:module:QOU.QuantumObservableUniverse","lean:module:QOU.MathConstants","lean:module:Mathlib.Algebra.Order.Field.Basic","lean:module:Mathlib.Tactic.Ring","lean:module:Mathlib.Tactic.Linarith","lean:module:Mathlib.Tactic.NormNum","lean:module:Mathlib.Tactic.Positivity","lean:module:Mathlib.Tactic.FieldSimp"],"declarations":9,"chunks":1},{"@id":"lean:QOU.Information.quantumTemperature_eq","@type":"LeanDeclaration","name":"QOU.Information.quantumTemperature_eq","kind":"theorem","line":82,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/quantum-temperature.lean#L82-L87","doc":"The quantum temperature equals (q - 1) / q. ","signatureChunk":0},{"@id":"lean:QOU.Information.quantumTemperature_classical","@type":"LeanDeclaration","name":"QOU.Information.quantumTemperature_classical","kind":"theorem","line":75,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/quantum-temperature.lean#L75-L80","doc":"At classicality (q = 1), temperature vanishes. ","signatureChunk":0},{"@id":"lean:QOU.Information.beta_times_temperature","@type":"LeanDeclaration","name":"QOU.Information.beta_times_temperature","kind":"theorem","line":66,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/quantum-temperature.lean#L66-L73","doc":"β_q · T_q = 1: the product of inverse temperature and temperature is unity. ","signatureChunk":0},{"@id":"lean:QOU.Information.inverseTemperature_eq_inv","@type":"LeanDeclaration","name":"QOU.Information.inverseTemperature_eq_inv","kind":"theorem","line":57,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/quantum-temperature.lean#L57-L64","doc":"Inverse temperature equals the reciprocal of temperature when q > 1. ","signatureChunk":0},{"@id":"lean:QOU.Information.quantumTemperature_lt_one","@type":"LeanDeclaration","name":"QOU.Information.quantumTemperature_lt_one","kind":"theorem","line":52,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/quantum-temperature.lean#L52-L55","doc":"The quantum temperature is bounded above by 1. ","signatureChunk":0},{"@id":"lean:QOU.Information.quantumTemperature_pos","@type":"LeanDeclaration","name":"QOU.Information.quantumTemperature_pos","kind":"theorem","line":43,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/quantum-temperature.lean#L43-L50","doc":"The quantum temperature is strictly positive when q > 1. ","signatureChunk":0},{"@id":"lean:QOU.Information.quantumTemperature_nonneg","@type":"LeanDeclaration","name":"QOU.Information.quantumTemperature_nonneg","kind":"theorem","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/quantum-temperature.lean#L38-L41","doc":"The quantum temperature is non-negative. ","signatureChunk":0},{"@id":"lean:QOU.Information.inverseTemperature","@type":"LeanDeclaration","name":"QOU.Information.inverseTemperature","kind":"def","line":31,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/quantum-temperature.lean#L31-L36","doc":"**Inverse temperature** (Planck time).\nβ_q(p) = 1 / T_q(p) = q(p) / (q(p) - 1).\nLabel: def:quantum-temperature ","signatureChunk":0},{"@id":"lean:QOU.Information.quantumTemperature","@type":"LeanDeclaration","name":"QOU.Information.quantumTemperature","kind":"def","line":24,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/quantum-temperature.lean#L24-L29","doc":"**Quantum temperature** at a point p ∈ M.\nT_q(p) = ℏ_q(p) = (q(p) - 1) / q(p).\nLabel: def:quantum-temperature ","formalizes":[{"@id":"block:def:quantum-temperature","label":"def:quantum-temperature","md":"quantum-observable-universe/information-theory/quantum-temperature.md"}],"signatureChunk":0}]}