.fl_fl","@type":"LeanDeclaration","name":"QOU.Archimedean.SchurWeylTrace.fl_fl","kind":"theorem","line":713,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/SchurWeylTrace.lean#L713-L714","signatureChunk":0},{"@id":"lean:QOU.Archimedean.SchurWeylTrace.fl","@type":"LeanDeclaration","name":"QOU.Archimedean.SchurWeylTrace.fl","kind":"def","line":710,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/SchurWeylTrace.lean#L710-L711","doc":"Exchange the two letters. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.SchurWeylTrace.Em_inj","@type":"LeanDeclaration","name":"QOU.Archimedean.SchurWeylTrace.Em_inj","kind":"theorem","line":646,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/SchurWeylTrace.lean#L646-L706","doc":"**`E` is injective on the lower half**: a weight-`m` vector with `2m < r` killed by `E`\nis zero (`r = n + 1`, `[k] ≠ 0` for `k ≤ r`). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.SchurWeylTrace.QIntNonzero","@type":"LeanDeclaration","name":"QOU.Archimedean.SchurWeylTrace.QIntNonzero","kind":"def","line":643,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/SchurWeylTrace.lean#L643-L644","doc":"The hypothesis replacing \"`q` is not a root of unity\": `[k] ≠ 0` for `1 ≤ k ≤ r`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.SchurWeylTrace.Em_Fm_mulVec","@type":"LeanDeclaration","name":"QOU.Archimedean.SchurWeylTrace.Em_Fm_mulVec","kind":"theorem","line":638,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/SchurWeylTrace.lean#L638-L641","signatureChunk":0},{"@id":"lean:QOU.Archimedean.SchurWeylTrace.Dg_mulVec","@type":"LeanDeclaration","name":"QOU.Archimedean.SchurWeylTrace.Dg_mulVec","kind":"theorem","line":630,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/SchurWeylTrace.lean#L630-L636","signatureChunk":0},{"@id":"lean:QOU.Archimedean.SchurWeylTrace.Fm_supp_zero","@type":"LeanDeclaration","name":"QOU.Archimedean.SchurWeylTrace.Fm_supp_zero","kind":"theorem","line":620,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/SchurWeylTrace.lean#L620-L628","signatureChunk":0},{"@id":"lean:QOU.Archimedean.SchurWeylTrace.supp_Fm","@type":"LeanDeclaration","name":"QOU.Archimedean.SchurWeylTrace.supp_Fm","kind":"theorem","line":609,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/SchurWeylTrace.lean#L609-L618","signatureChunk":0},{"@id":"lean:QOU.Archimedean.SchurWeylTrace.supp_Em","@type":"LeanDeclaration","name":"QOU.Archimedean.SchurWeylTrace.supp_Em","kind":"theorem","line":598,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/SchurWeylTrace.lean#L598-L607","signatureChunk":0},{"@id":"lean:QOU.Archimedean.SchurWeylTrace.Supp","@type":"LeanDeclaration","name":"QOU.Archimedean.SchurWeylTrace.Supp","kind":"def","line":595,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/SchurWeylTrace.lean#L595-L596","doc":"A vector supported on the weight-`m` states. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.SchurWeylTrace.Fm_weight","@type":"LeanDeclaration","name":"QOU.Archimedean.SchurWeylTrace.Fm_weight","kind":"theorem","line":579,"sourceLink":"https://github.c