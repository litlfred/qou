{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:PredictedSpectra.ShellStructureEigenvalues","@type":"LeanModule","name":"PredictedSpectra.ShellStructureEigenvalues","imports":["lean:module:Init","lean:module:Mathlib.Data.Real.Basic","lean:module:Mathlib.Analysis.SpecialFunctions.Pow.Real"],"declarations":20,"chunks":1},{"@id":"lean:QOU.Archimedean.ShellEigenvalues.ConditionalAudit.shell_eigenvalues_conditional","@type":"LeanDeclaration","name":"QOU.Archimedean.ShellEigenvalues.ConditionalAudit.shell_eigenvalues_conditional","kind":"theorem","line":165,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/shell-structure-eigenvalues.lean#L165-L180","doc":"**Shell-energy Chebyshev recurrence (conditional on\n`BorromeanQuark`).** Given the Borromean-quark shell-energy\ncalibration, the shell energies satisfy the same three-term\nrecurrence as the traced volumes:\n`Eₙ₊₂ = (q − q⁻¹)·Eₙ₊₁ + Eₙ`.\n\nDerived from `energy_law` (the class field) and the unconditional\n`chebyshev_recurrence` — a real equation, not `True`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.ShellEigenvalues.ConditionalAudit.BorromeanQuark.energy_law","@type":"LeanDeclaration","name":"QOU.Archimedean.ShellEigenvalues.ConditionalAudit.BorromeanQuark.energy_law","kind":"theorem","line":163,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/shell-structure-eigenvalues.lean#L163-L163","doc":"The shell energy is the ground-state scale times the traced\nshell volume at every `q` and shell index `n`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.ShellEigenvalues.ConditionalAudit.BorromeanQuark.shellEnergy","@type":"LeanDeclaration","name":"QOU.Archimedean.ShellEigenvalues.ConditionalAudit.BorromeanQuark.shellEnergy","kind":"def","line":160,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/shell-structure-eigenvalues.lean#L160-L160","doc":"The shell-energy functional, `Eₙ(q)`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.ShellEigenvalues.ConditionalAudit.BorromeanQuark.E0","@type":"LeanDeclaration","name":"QOU.Archimedean.ShellEigenvalues.ConditionalAudit.BorromeanQuark.E0","kind":"def","line":158,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/shell-structure-eigenvalues.lean#L158-L158","doc":"The ground-state energy scale, a function of `q`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.ShellEigenvalues.ConditionalAudit.BorromeanQuark.mk","@type":"LeanDeclaration","name":"QOU.Archimedean.ShellEigenvalues.ConditionalAudit.BorromeanQuark.mk","kind":"ctor","line":156,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/shell-structure-eigenvalues.lean#L156-L156","signatureChunk":0},{"@id":"lean:QOU.Archimedean.ShellEigenvalues.ConditionalAudit.BorromeanQuark","@type":"LeanDeclaration","name":"QOU.Archimedean.ShellEigenvalues.ConditionalAudit.BorromeanQuark","kind":"class","line":150,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/shell-structure-eigenvalues.lean#L150-L163","doc":"**Borromean-quark shell-energy class** (conditional input for\n`prop:shell-structure-eigenvalues`). The conjectural content is the\nground-state energy scale `E₀ q` and the shell-energy law\n`Eₙ(q) = E₀(q) · V̂(n, q)` at every `q`, where `V̂` is the\nMarkov-traced shell volume `shellVolume`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.hecke_classical","@type":"LeanDeclaration","name":"QOU.Archimedean.hecke_classical","kind":"theorem","line":124,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/shell-structure-eigenvalues.lean#L124-L129","doc":"At q = 1, the Hecke coefficient vanishes: h = 0.\nThe recurrence degenerates: V̂(n+1) = V̂(n-1) (period 2).\nNo shell structure in the classical limit. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.shell_capacity","@type":"LeanDeclaration","name":"QOU.Archimedean.shell_capacity","kind":"theorem","line":113,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/shell-structure-eigenvalues.lean#L113-L122","doc":"Shell capacity: Σ_{ℓ=0}^{n-1} 2(2ℓ+1) = 2n². ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.subshellCapacity","@type":"LeanDeclaration","name":"QOU.Archimedean.subshellCapacity","kind":"def","line":109,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/shell-structure-eigenvalues.lean#L109-L111","doc":"Sub-shell capacity: 2(2ℓ+1) for angular momentum ℓ. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.transitionEnergy","@type":"LeanDeclaration","name":"QOU.Archimedean.transitionEnergy","kind":"def","line":102,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/shell-structure-eigenvalues.lean#L102-L107","doc":"Transition energy between adjacent shells:\nΔE(n→n+1) = V̂(n+1) - V̂(n) = (h - 1)·V̂(n) + V̂(n-1)\nwhere h = q - q⁻¹. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.chebyshev_recurrence","@type":"LeanDeclaration","name":"QOU.Archimedean.chebyshev_recurrence","kind":"theorem","line":97,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/shell-structure-eigenvalues.lean#L97-L100","doc":"The Chebyshev recurrence holds by construction. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.shell_zero","@type":"LeanDeclaration","name":"QOU.Archimedean.shell_zero","kind":"theorem","line":93,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/shell-structure-eigenvalues.lean#L93-L95","doc":"Shell 0 is the ground state: V̂(0) = 1. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.shellVolume","@type":"LeanDeclaration","name":"QOU.Archimedean.shellVolume","kind":"def","line":82,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/shell-structure-eigenvalues.lean#L82-L91","doc":"The Chebyshev recurrence for traced volumes.\nV̂(n+1) = (q - q⁻¹) · V̂(n) + V̂(n-1)\n\nThis is the three-term recurrence generated by the\ncharacteristic polynomial λ² - (q-q⁻¹)λ - 1 = 0. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.eigenvalue_plus_gt_one","@type":"LeanDeclaration","name":"QOU.Archimedean.eigenvalue_plus_gt_one","kind":"theorem","line":64,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/shell-structure-eigenvalues.lean#L64-L80","doc":"λ₊ > 1 for q > 1. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.eigenvalue_sum","@type":"LeanDeclaration","name":"QOU.Archimedean.eigenvalue_sum","kind":"theorem","line":57,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/shell-structure-eigenvalues.lean#L57-L62","doc":"λ₊ + λ₋ = tr(T_{γe}) = q - q⁻¹. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.eigenvalue_product","@type":"LeanDeclaration","name":"QOU.Archimedean.eigenvalue_product","kind":"theorem","line":48,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/shell-structure-eigenvalues.lean#L48-L55","doc":"λ₊ · λ₋ = det(T_{γe}) = -1. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.discriminant_pos","@type":"LeanDeclaration","name":"QOU.Archimedean.discriminant_pos","kind":"theorem","line":43,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/shell-structure-eigenvalues.lean#L43-L46","doc":"The discriminant h² + 4 is always positive. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.eigenvalue_minus","@type":"LeanDeclaration","name":"QOU.Archimedean.eigenvalue_minus","kind":"def","line":40,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/shell-structure-eigenvalues.lean#L40-L41","signatureChunk":0},{"@id":"lean:QOU.Archimedean.eigenvalue_plus","@type":"LeanDeclaration","name":"QOU.Archimedean.eigenvalue_plus","kind":"def","line":35,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/shell-structure-eigenvalues.lean#L35-L38","doc":"The eigenvalues of T_{γe}: λ± = ½[h ± √(h² + 4)]. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.hecke","@type":"LeanDeclaration","name":"QOU.Archimedean.hecke","kind":"def","line":31,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/shell-structure-eigenvalues.lean#L31-L33","doc":"The Hecke coefficient h = q - q⁻¹. ","signatureChunk":0}]}