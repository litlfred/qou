{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Archimedean.TypedGarsideElement","@type":"LeanModule","name":"QOU.Archimedean.TypedGarsideElement","imports":["lean:module:Init","lean:module:Mathlib.Tactic"],"declarations":17,"chunks":1},{"@id":"lean:QOU.Archimedean.numFactors_one","@type":"LeanDeclaration","name":"QOU.Archimedean.numFactors_one","kind":"theorem","line":60,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TypedGarsideElement.lean#L60-L64","doc":"A single nucleon carries no crossing factors (`binom(1,2) = 0`). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.d_mixed_symm","@type":"LeanDeclaration","name":"QOU.Archimedean.d_mixed_symm","kind":"theorem","line":54,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TypedGarsideElement.lean#L54-L58","doc":"The typed-crossing coefficient is symmetric on a mixed proton–neutron\npair (manuscript: `d(p,n) = d(n,p)`). ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TypedGarsideElement.numFactors_eq","@type":"LeanDeclaration","name":"QOU.Archimedean.TypedGarsideElement.numFactors_eq","kind":"theorem","line":50,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TypedGarsideElement.lean#L50-L50","doc":"The staircase has one factor per nucleon pair: `binom(A, 2)`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TypedGarsideElement.numFactors","@type":"LeanDeclaration","name":"QOU.Archimedean.TypedGarsideElement.numFactors","kind":"def","line":48,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TypedGarsideElement.lean#L48-L48","doc":"Number of crossing factors in the staircase. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TypedGarsideElement.A","@type":"LeanDeclaration","name":"QOU.Archimedean.TypedGarsideElement.A","kind":"def","line":46,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TypedGarsideElement.lean#L46-L46","doc":"Nucleon count `A = Z + N`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TypedGarsideElement.d_np","@type":"LeanDeclaration","name":"QOU.Archimedean.TypedGarsideElement.d_np","kind":"theorem","line":44,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TypedGarsideElement.lean#L44-L44","doc":"`d(n,p) = -½(q − q⁻¹)`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TypedGarsideElement.d_pn","@type":"LeanDeclaration","name":"QOU.Archimedean.TypedGarsideElement.d_pn","kind":"theorem","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TypedGarsideElement.lean#L42-L42","doc":"`d(p,n) = -½(q − q⁻¹)`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TypedGarsideElement.d_nn","@type":"LeanDeclaration","name":"QOU.Archimedean.TypedGarsideElement.d_nn","kind":"theorem","line":40,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TypedGarsideElement.lean#L40-L40","doc":"`d(n,n) = -(q − q⁻¹)`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TypedGarsideElement.d_pp","@type":"LeanDeclaration","name":"QOU.Archimedean.TypedGarsideElement.d_pp","kind":"theorem","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TypedGarsideElement.lean#L38-L38","doc":"`d(p,p) = 0`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TypedGarsideElement.d","@type":"LeanDeclaration","name":"QOU.Archimedean.TypedGarsideElement.d","kind":"def","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TypedGarsideElement.lean#L36-L36","doc":"Typed-crossing coefficient `d(f_i, f_j)` in `C = σ + d`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TypedGarsideElement.q","@type":"LeanDeclaration","name":"QOU.Archimedean.TypedGarsideElement.q","kind":"def","line":34,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TypedGarsideElement.lean#L34-L34","doc":"Substrate parameter `q`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TypedGarsideElement.mk","@type":"LeanDeclaration","name":"QOU.Archimedean.TypedGarsideElement.mk","kind":"ctor","line":32,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TypedGarsideElement.lean#L32-L32","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TypedGarsideElement","@type":"LeanDeclaration","name":"QOU.Archimedean.TypedGarsideElement","kind":"structure","line":25,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TypedGarsideElement.lean#L25-L50","doc":"Data for the typed Garside element `𝒢(t₀,…,t_{A-1})`.\n\nA `definition` carrier: the substrate parameter `q`, the typed-crossing\ncoefficient table `d`, its four defining values (manuscript\n`d(p,p)=0`, `d(n,n)=-(q-q⁻¹)`, `d(p,n)=d(n,p)=-½(q-q⁻¹)`), the nucleon\ncount `A`, and the crossing-factor count `= binom(A,2)` (one factor per\nnucleon pair). ","formalizes":[{"@id":"block:def:typed-garside-element","label":"def:typed-garside-element","md":"quantum-observable-universe/nuclear-interactions/typed-garside-element.md"}],"signatureChunk":0},{"@id":"lean:QOU.Archimedean.instDecidableEqNucleon","@type":"LeanDeclaration","name":"QOU.Archimedean.instDecidableEqNucleon","kind":"instance","line":23,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TypedGarsideElement.lean#L23-L23","signatureChunk":0},{"@id":"lean:QOU.Archimedean.Nucleon.n","@type":"LeanDeclaration","name":"QOU.Archimedean.Nucleon.n","kind":"ctor","line":22,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TypedGarsideElement.lean#L22-L22","signatureChunk":0},{"@id":"lean:QOU.Archimedean.Nucleon.p","@type":"LeanDeclaration","name":"QOU.Archimedean.Nucleon.p","kind":"ctor","line":21,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TypedGarsideElement.lean#L21-L21","signatureChunk":0},{"@id":"lean:QOU.Archimedean.Nucleon","@type":"LeanDeclaration","name":"QOU.Archimedean.Nucleon","kind":"inductive","line":19,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TypedGarsideElement.lean#L19-L23","doc":"Nucleon type: proton `p` or neutron `n`. ","signatureChunk":0}]}