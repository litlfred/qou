{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:PredictedSpectra.TiltingModuleRigidity","@type":"LeanModule","name":"PredictedSpectra.TiltingModuleRigidity","imports":["lean:module:Init","lean:module:Mathlib.Data.Real.Basic","lean:module:QOU.BraidKnot.CemeteryGroupEmergence"],"declarations":8,"chunks":1},{"@id":"lean:QOU.Archimedean.tilting_module_rigidity","@type":"LeanDeclaration","name":"QOU.Archimedean.tilting_module_rigidity","kind":"theorem","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/tilting-module-rigidity.lean#L30-L43","formalizes":[{"@id":"block:lem:tilting-module-rigidity","label":"lem:tilting-module-rigidity","md":"quantum-observable-universe/predicted-spectra/tilting-module-rigidity.md"}],"signatureChunk":0},{"@id":"lean:QOU.Archimedean.CemeteryGroupRigidity.module_forces_words","@type":"LeanDeclaration","name":"QOU.Archimedean.CemeteryGroupRigidity.module_forces_words","kind":"theorem","line":28,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/tilting-module-rigidity.lean#L28-L28","signatureChunk":0},{"@id":"lean:QOU.Archimedean.CemeteryGroupRigidity.cemeteryModule_inCemetery","@type":"LeanDeclaration","name":"QOU.Archimedean.CemeteryGroupRigidity.cemeteryModule_inCemetery","kind":"theorem","line":27,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/tilting-module-rigidity.lean#L27-L27","doc":"**Bridge.** A cemetery (tilting) module's Gröbner–Shirshov node lies in the\ncemetery group `ker τ`. This is the structural content \"tilting modules\nrestrict the kernel of `G(q)`\": being a cemetery module is exactly carrying\na normal form whose node is τ-annihilated. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.CemeteryGroupRigidity.GeneratesWords","@type":"LeanDeclaration","name":"QOU.Archimedean.CemeteryGroupRigidity.GeneratesWords","kind":"def","line":22,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/tilting-module-rigidity.lean#L22-L22","signatureChunk":0},{"@id":"lean:QOU.Archimedean.CemeteryGroupRigidity.RestrictsKernel","@type":"LeanDeclaration","name":"QOU.Archimedean.CemeteryGroupRigidity.RestrictsKernel","kind":"def","line":21,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/tilting-module-rigidity.lean#L21-L21","signatureChunk":0},{"@id":"lean:QOU.Archimedean.CemeteryGroupRigidity.IsCemeteryModule","@type":"LeanDeclaration","name":"QOU.Archimedean.CemeteryGroupRigidity.IsCemeteryModule","kind":"def","line":20,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/tilting-module-rigidity.lean#L20-L20","signatureChunk":0},{"@id":"lean:QOU.Archimedean.CemeteryGroupRigidity.mk","@type":"LeanDeclaration","name":"QOU.Archimedean.CemeteryGroupRigidity.mk","kind":"ctor","line":19,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/tilting-module-rigidity.lean#L19-L19","signatureChunk":0},{"@id":"lean:QOU.Archimedean.CemeteryGroupRigidity","@type":"LeanDeclaration","name":"QOU.Archimedean.CemeteryGroupRigidity","kind":"class","line":12,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/tilting-module-rigidity.lean#L12-L28","doc":"Rigidity of the Cemetery group tilting modules.\nProves that the extreme vertices of the collapsed spectrahedron are uniquely\ndetermined by the tilting modules of the Cemetery group (ker τ). These modules\nrestrict the kernel of G(q), forcing the observable non-zero eigenvalues to be\ngenerated exclusively by words in q and q⁻¹.\n","signatureChunk":0}]}