{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.OrientedSkein.Model.GLnCrossCheck","@type":"LeanModule","name":"QOU.OrientedSkein.Model.GLnCrossCheck","imports":["lean:module:Init","lean:module:QOU.OrientedSkein.Model.GLnTrace","lean:module:QOU.SchurWeyl.MarkovTraceInstance"],"declarations":3,"chunks":1},{"@id":"lean:QOU.OrientedSkein.GLn.closure_eq_wtrace_two","@type":"LeanDeclaration","name":"QOU.OrientedSkein.GLn.closure_eq_wtrace_two","kind":"theorem","line":54,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/Model/GLnCrossCheck.lean#L54-L76","doc":"**The `n = 2` closure trace is the convention-`D` Markov trace.**  For every level `m` and\nevery `x ∈ H_{m+1}(q)`, `[2]_q^{-(m+1)}` times the closure of `ρ_m(x)` on `(K²)^{⊗(m+1)}` equals\nthe Ocneanu-weighted seminormal trace `wtrace` of `x`. ","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.GLn.sum_wt_two","@type":"LeanDeclaration","name":"QOU.OrientedSkein.GLn.sum_wt_two","kind":"theorem","line":51,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/Model/GLnCrossCheck.lean#L51-L52","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.GLn.castMarkov","@type":"LeanDeclaration","name":"QOU.OrientedSkein.GLn.castMarkov","kind":"def","line":40,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/Model/GLnCrossCheck.lean#L40-L47","doc":"Transport a Markov trace family along an equality of Markov parameters. ","signatureChunk":0}]}