{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Mathlib.SDPDuality","@type":"LeanModule","name":"QOU.Mathlib.SDPDuality","imports":["lean:module:Init","lean:module:Mathlib.Data.Real.Basic","lean:module:Mathlib.Data.Matrix.Basic","lean:module:Mathlib.LinearAlgebra.Matrix.Trace","lean:module:Mathlib.LinearAlgebra.Matrix.PosDef","lean:module:Mathlib.LinearAlgebra.Matrix.Spectrum","lean:module:Mathlib.Algebra.BigOperators.Group.Finset.Basic","lean:module:Mathlib.Algebra.BigOperators.Ring.Finset","lean:module:Mathlib.Tactic.Linarith"],"declarations":8,"chunks":1},{"@id":"lean:QOU.Mathlib.SDPDuality.strong_duality","@type":"LeanDeclaration","name":"QOU.Mathlib.SDPDuality.strong_duality","kind":"theorem","line":112,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SDPDuality.lean#L112-L134","doc":"**Strong SDP duality** (complementary slackness certificate). ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.SDPDuality.weak_duality","@type":"LeanDeclaration","name":"QOU.Mathlib.SDPDuality.weak_duality","kind":"theorem","line":89,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SDPDuality.lean#L89-L110","doc":"**Weak SDP duality.** ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.SDPDuality.traceInner_nonneg_of_posSemidef","@type":"LeanDeclaration","name":"QOU.Mathlib.SDPDuality.traceInner_nonneg_of_posSemidef","kind":"theorem","line":60,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SDPDuality.lean#L60-L87","doc":"**`tr(SX) ≥ 0` for PSD S and X.**\nProof: spectral decomposition `S = U diag(λ) U*` with `λᵢ ≥ 0`,\ntrace cyclicity gives `tr(SX) = tr(diag(λ) · U*XU)`,\n`U*XU` is PSD (by `conjTranspose_mul_mul_same`),\nthen `Σ λᵢ (U*XU)ᵢᵢ ≥ 0` since both factors are nonneg. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.SDPDuality.traceInner_finset_sum_left","@type":"LeanDeclaration","name":"QOU.Mathlib.SDPDuality.traceInner_finset_sum_left","kind":"theorem","line":32,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SDPDuality.lean#L32-L35","signatureChunk":0},{"@id":"lean:QOU.Mathlib.SDPDuality.traceInner_sub_left","@type":"LeanDeclaration","name":"QOU.Mathlib.SDPDuality.traceInner_sub_left","kind":"theorem","line":28,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SDPDuality.lean#L28-L30","signatureChunk":0},{"@id":"lean:QOU.Mathlib.SDPDuality.traceInner_add_left","@type":"LeanDeclaration","name":"QOU.Mathlib.SDPDuality.traceInner_add_left","kind":"theorem","line":24,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SDPDuality.lean#L24-L26","signatureChunk":0},{"@id":"lean:QOU.Mathlib.SDPDuality.traceInner_smul_left","@type":"LeanDeclaration","name":"QOU.Mathlib.SDPDuality.traceInner_smul_left","kind":"theorem","line":20,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SDPDuality.lean#L20-L22","signatureChunk":0},{"@id":"lean:QOU.Mathlib.SDPDuality.traceInner","@type":"LeanDeclaration","name":"QOU.Mathlib.SDPDuality.traceInner","kind":"def","line":16,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SDPDuality.lean#L16-L18","doc":"Standard trace inner product: `⟨X, Y⟩ = tr(XY)`. ","signatureChunk":0}]}