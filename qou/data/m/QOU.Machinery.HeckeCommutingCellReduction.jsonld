u/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/HeckeCommutingCellReduction.lean#L135-L136","doc":"The fibre restriction of a state over a fixed coset. ","signatureChunk":0},{"@id":"lean:QOU.Machinery.HeckeGeneral.CommutingCosetStructure.Dj_len","@type":"LeanDeclaration","name":"QOU.Machinery.HeckeGeneral.CommutingCosetStructure.Dj_len","kind":"theorem","line":133,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/HeckeCommutingCellReduction.lean#L133-L133","signatureChunk":0},{"@id":"lean:QOU.Machinery.HeckeGeneral.CommutingCosetStructure.Dj_t","@type":"LeanDeclaration","name":"QOU.Machinery.HeckeGeneral.CommutingCosetStructure.Dj_t","kind":"theorem","line":132,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/HeckeCommutingCellReduction.lean#L132-L132","signatureChunk":0},{"@id":"lean:QOU.Machinery.HeckeGeneral.CommutingCosetStructure.Di_len","@type":"LeanDeclaration","name":"QOU.Machinery.HeckeGeneral.CommutingCosetStructure.Di_len","kind":"theorem","line":131,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/HeckeCommutingCellReduction.lean#L131-L131","signatureChunk":0},{"@id":"lean:QOU.Machinery.HeckeGeneral.CommutingCosetStructure.Di_t","@type":"LeanDeclaration","name":"QOU.Machinery.HeckeGeneral.CommutingCosetStructure.Di_t","kind":"theorem","line":130,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/HeckeCommutingCellReduction.lean#L130-L130","signatureChunk":0},{"@id":"lean:QOU.Machinery.HeckeGeneral.CommutingCosetStructure.Dj","@type":"LeanDeclaration","name":"QOU.Machinery.HeckeGeneral.CommutingCosetStructure.Dj","kind":"def","li