ansversal.lean#L93-L94","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.cellElem3_4","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.cellElem3_4","kind":"theorem","line":90,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterParabolicTransversal.lean#L90-L91","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.cellElem3_3","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.cellElem3_3","kind":"theorem","line":87,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterParabolicTransversal.lean#L87-L88","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.cellElem3_2","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.cellElem3_2","kind":"theorem","line":84,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterParabolicTransversal.lean#L84-L85","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.cellElem3_1","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.cellElem3_1","kind":"theorem","line":81,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterParabolicTransversal.lean#L81-L82","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.cellElem3_0","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.cellElem3_0","kind":"theorem","line":78,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterParabolicTransversal.lean#L78-L79","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.cellWord3_mem","@type":"LeanDeclaration","name":"QOU.Machinery.Coxe