{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:KnotsParticlesConfinement.Hadron","@type":"LeanModule","name":"KnotsParticlesConfinement.Hadron","imports":["lean:module:Init","lean:module:Mathlib.Algebra.Polynomial.Laurent","lean:module:Mathlib.Data.Int.Basic","lean:module:QOU.KnotTheory"],"declarations":31,"chunks":1},{"@id":"lean:QOU.Hadron.meson_is_minimal","@type":"LeanDeclaration","name":"QOU.Hadron.meson_is_minimal","kind":"theorem","line":146,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L146-L148","doc":"A meson has exactly the minimum number of constituents. ","signatureChunk":0},{"@id":"lean:QOU.Hadron.baryon_ge_two","@type":"LeanDeclaration","name":"QOU.Hadron.baryon_ge_two","kind":"theorem","line":141,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L141-L144","doc":"A baryon has at least 2 constituents (follows from the hadron constraint). ","signatureChunk":0},{"@id":"lean:QOU.Hadron.fromLocalizedKnots","@type":"LeanDeclaration","name":"QOU.Hadron.fromLocalizedKnots","kind":"def","line":130,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L130-L139","doc":"Construct a hadron from a list of co-located localized knots. ","signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot.basePoint","@type":"LeanDeclaration","name":"QOU.LocalizedKnot.basePoint","kind":"def","line":126,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L126-L128","doc":"The base point of a localized knot as a pair `(θ, φ)` on S². ","signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot.knot","@type":"LeanDeclaration","name":"QOU.LocalizedKnot.knot","kind":"def","line":124,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L124-L124","doc":"The knot type at this point (given by its braid word). ","signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot.phi","@type":"LeanDeclaration","name":"QOU.LocalizedKnot.phi","kind":"def","line":122,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L122-L122","doc":"Spherical coordinate φ ∈ [0, 2π) on CP¹ ≅ S². ","signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot.theta","@type":"LeanDeclaration","name":"QOU.LocalizedKnot.theta","kind":"def","line":120,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L120-L120","doc":"Spherical coordinate θ ∈ [0, π] on CP¹ ≅ S². ","signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot.mk","@type":"LeanDeclaration","name":"QOU.LocalizedKnot.mk","kind":"ctor","line":118,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L118-L118","signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot","@type":"LeanDeclaration","name":"QOU.LocalizedKnot","kind":"structure","line":112,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L112-L124","doc":"A localized knot: a knot type placed at a point `(θ, φ)` on the base\nmanifold `CP¹ ≅ S²`.  This mirrors `QOU.LocalizedKnot` (defined in\n`lifting-and-descent/localized-knot.lean`); it is restated locally\nbecause this standalone content sibling imports only `QOU.KnotTheory`\nand the `localized-knot` sibling is not part of that import closure. ","formalizes":[{"@id":"block:def:localized-knot","label":"def:localized-knot","md":"quantum-observable-universe/lifting-and-descent/localized-knot.md"}],"signatureChunk":0},{"@id":"lean:QOU.Hadron.mass","@type":"LeanDeclaration","name":"QOU.Hadron.mass","kind":"def","line":103,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L103-L108","doc":"The total mass of a hadron given a binding structure and constituent volumes.\nm_H = bindingMass + Σᵢ vol(Kᵢ) ","signatureChunk":0},{"@id":"lean:QOU.constituentMass","@type":"LeanDeclaration","name":"QOU.constituentMass","kind":"def","line":97,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L97-L101","doc":"Mass of a single constituent knot, given by its hyperbolic volume\nin the QOU framework.  Returns the volume value. ","signatureChunk":0},{"@id":"lean:QOU.HadronBinding.bindingMass","@type":"LeanDeclaration","name":"QOU.HadronBinding.bindingMass","kind":"def","line":91,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L91-L91","doc":"The Skein polynomial evaluation Q(q) · M(L_Hopf), as an archimedean\nmass value in `ℝ` (post-wall numerical evaluation). ","signatureChunk":0},{"@id":"lean:QOU.HadronBinding.bindingLink","@type":"LeanDeclaration","name":"QOU.HadronBinding.bindingLink","kind":"def","line":88,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L88-L88","doc":"The binding link (Hopf link braid word). ","signatureChunk":0},{"@id":"lean:QOU.HadronBinding.q","@type":"LeanDeclaration","name":"QOU.HadronBinding.q","kind":"def","line":86,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L86-L86","doc":"The q-deformation parameter (formal indeterminate of `R_q`). ","signatureChunk":0},{"@id":"lean:QOU.HadronBinding.mk","@type":"LeanDeclaration","name":"QOU.HadronBinding.mk","kind":"ctor","line":84,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L84-L84","signatureChunk":0},{"@id":"lean:QOU.HadronBinding","@type":"LeanDeclaration","name":"QOU.HadronBinding","kind":"structure","line":82,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L82-L91","doc":"Binding structure: the Hopf link and its Skein polynomial contribution. ","signatureChunk":0},{"@id":"lean:QOU.Hadron.totalCrossings","@type":"LeanDeclaration","name":"QOU.Hadron.totalCrossings","kind":"def","line":73,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L73-L75","doc":"Total crossing number of all constituent knots. ","signatureChunk":0},{"@id":"lean:QOU.Hadron.valence","@type":"LeanDeclaration","name":"QOU.Hadron.valence","kind":"def","line":69,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L69-L71","doc":"Number of constituents (valence quarks). ","signatureChunk":0},{"@id":"lean:QOU.Hadron.basePoint","@type":"LeanDeclaration","name":"QOU.Hadron.basePoint","kind":"def","line":65,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L65-L67","doc":"The base point of a hadron on S². ","signatureChunk":0},{"@id":"lean:QOU.Hadron.meson_or_baryon_or_exotic","@type":"LeanDeclaration","name":"QOU.Hadron.meson_or_baryon_or_exotic","kind":"theorem","line":55,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L55-L61","doc":"Every hadron is either a meson, a baryon, or exotic (≥ 4 constituents). ","signatureChunk":0},{"@id":"lean:QOU.Hadron.isMeson","@type":"LeanDeclaration","name":"QOU.Hadron.isMeson","kind":"def","line":52,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L52-L53","doc":"A meson is a hadron with exactly 2 constituents. ","signatureChunk":0},{"@id":"lean:QOU.Hadron.isBaryon","@type":"LeanDeclaration","name":"QOU.Hadron.isBaryon","kind":"def","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L49-L50","doc":"A baryon is a hadron with exactly 3 constituents. ","signatureChunk":0},{"@id":"lean:QOU.Hadron.constituents_nonempty","@type":"LeanDeclaration","name":"QOU.Hadron.constituents_nonempty","kind":"theorem","line":45,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L45-L45","doc":"A hadron must have at least 2 constituents. ","signatureChunk":0},{"@id":"lean:QOU.Hadron.constituents","@type":"LeanDeclaration","name":"QOU.Hadron.constituents","kind":"def","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L42-L42","doc":"The constituent knot types (valence quarks in the knot picture). ","signatureChunk":0},{"@id":"lean:QOU.Hadron.phi","@type":"LeanDeclaration","name":"QOU.Hadron.phi","kind":"def","line":40,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L40-L40","doc":"Spherical coordinate φ of the common base point. ","signatureChunk":0},{"@id":"lean:QOU.Hadron.theta","@type":"LeanDeclaration","name":"QOU.Hadron.theta","kind":"def","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L38-L38","doc":"Spherical coordinate θ of the common base point. ","signatureChunk":0},{"@id":"lean:QOU.Hadron.mk","@type":"LeanDeclaration","name":"QOU.Hadron.mk","kind":"ctor","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L36-L36","signatureChunk":0},{"@id":"lean:QOU.Hadron","@type":"LeanDeclaration","name":"QOU.Hadron","kind":"structure","line":34,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L34-L45","doc":"A hadron: a composite of knot types at a common point, with\nbinding energy from the Hopf link structure. ","formalizes":[{"@id":"block:def:hadron","label":"def:hadron","md":"quantum-observable-universe/knots-particles-confinement/hadron.md"}],"signatureChunk":0},{"@id":"lean:QOU.q_inv_param","@type":"LeanDeclaration","name":"QOU.q_inv_param","kind":"def","line":32,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L32-L32","signatureChunk":0},{"@id":"lean:QOU.q_param","@type":"LeanDeclaration","name":"QOU.q_param","kind":"def","line":31,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L31-L31","signatureChunk":0},{"@id":"lean:QOU.R_q","@type":"LeanDeclaration","name":"QOU.R_q","kind":"def","line":28,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/hadron.lean#L28-L30","doc":"Ground ring `R_q = ℤ[q, q⁻¹]` (Laurent polynomials over ℤ).\nSee `QOU.Archimedean.GroundRing` for the compiled definition. ","signatureChunk":0}]}