{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QuantumObservableUniverses.CategoricalLaplaceTransform","@type":"LeanModule","name":"QuantumObservableUniverses.CategoricalLaplaceTransform","imports":["lean:module:Init","lean:module:Mathlib.Algebra.Polynomial.Laurent","lean:module:Mathlib.Data.Int.Basic"],"declarations":7,"chunks":1},{"@id":"lean:QOU.CategoricalLaplace.toFourier","@type":"LeanDeclaration","name":"QOU.CategoricalLaplace.toFourier","kind":"def","line":50,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/categorical-laplace-transform.lean#L50-L58","doc":"**Laplace-Fourier Wick rotation**: Fourier at ξ equals Laplace\nat s = iξ (in any base ring containing √(-1)). ","signatureChunk":0},{"@id":"lean:QOU.CategoricalLaplace.monoidal_unit","@type":"LeanDeclaration","name":"QOU.CategoricalLaplace.monoidal_unit","kind":"theorem","line":46,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/categorical-laplace-transform.lean#L46-L46","doc":"Unit preservation: L[𝟙] = 𝟙, with the monoidal unit of `A → A`\nunder composition pinned to `id` (quantifying `one` over all\nfunctions makes the structure uninhabitable for |A| ≥ 2). ","signatureChunk":0},{"@id":"lean:QOU.CategoricalLaplace.monoidal_mul","@type":"LeanDeclaration","name":"QOU.CategoricalLaplace.monoidal_mul","kind":"theorem","line":40,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/categorical-laplace-transform.lean#L40-L40","doc":"Monoidal: L[f ∗_q g] = L[f] · L[g]. ","signatureChunk":0},{"@id":"lean:QOU.CategoricalLaplace.transform","@type":"LeanDeclaration","name":"QOU.CategoricalLaplace.transform","kind":"def","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/categorical-laplace-transform.lean#L38-L38","doc":"Pairing: f ↦ (s ↦ ⟨exp_q(-s·), f⟩). ","signatureChunk":0},{"@id":"lean:QOU.CategoricalLaplace.mk","@type":"LeanDeclaration","name":"QOU.CategoricalLaplace.mk","kind":"ctor","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/categorical-laplace-transform.lean#L36-L36","signatureChunk":0},{"@id":"lean:QOU.CategoricalLaplace","@type":"LeanDeclaration","name":"QOU.CategoricalLaplace","kind":"structure","line":32,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/categorical-laplace-transform.lean#L32-L48","doc":"**Categorical Laplace transform data**: a monoidal functor\nfrom q-convolution to pointwise product, given abstractly\nas the Hopf pairing with the real-exponential grouplike. ","formalizes":[{"@id":"block:def:categorical-laplace","label":"def:categorical-laplace","md":"quantum-observable-universe/quantum-observable-universes/categorical-laplace-transform.md"}],"signatureChunk":0},{"@id":"lean:QOU.R_q","@type":"LeanDeclaration","name":"QOU.R_q","kind":"def","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/quantum-observable-universes/categorical-laplace-transform.lean#L30-L30","signatureChunk":0}]}