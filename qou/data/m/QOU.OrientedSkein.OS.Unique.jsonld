entedSkein/OS/Unique.lean#L183-L192","doc":"`cmp` is natural on every layer. ","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.OS.cmp_gen","@type":"LeanDeclaration","name":"QOU.OrientedSkein.OS.cmp_gen","kind":"theorem","line":171,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/OS/Unique.lean#L171-L181","doc":"`cmp` is natural on every generator. ","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.OS.cmp_pair","@type":"LeanDeclaration","name":"QOU.OrientedSkein.OS.cmp_pair","kind":"theorem","line":166,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/OS/Unique.lean#L166-L169","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.OS.SendsEv","@type":"LeanDeclaration","name":"QOU.OrientedSkein.OS.SendsEv","kind":"def","line":159,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/OS/Unique.lean#L159-L162","doc":"`G` sends the universal evaluation to `ε_ F E`, along `eE` and `eF`. ","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.OS.SendsCoev","@type":"LeanDeclaration","name":"QOU.OrientedSkein.OS.SendsCoev","kind":"def","line":154,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/OS/Unique.lean#L154-L157","doc":"`G` sends the universal coevaluation to `η_ F E`, along `eE` and `eF`. ","signatureChunk":0},{"@id":"lean:QOU.OrientedSkein.OS.SendsT","@type":"LeanDeclaration","name":"QOU.OrientedSkein.OS.SendsT","kind":"def","line":149,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/OrientedSkein/OS/Unique.lean#L149-L152","doc":"`G` sends the universal mixed crossing `T` to `D`'s, along `eE` and 