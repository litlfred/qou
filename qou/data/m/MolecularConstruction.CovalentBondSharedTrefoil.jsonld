{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:MolecularConstruction.CovalentBondSharedTrefoil","@type":"LeanModule","name":"MolecularConstruction.CovalentBondSharedTrefoil","imports":["lean:module:Init"],"declarations":9,"chunks":1},{"@id":"lean:QOU.Molecular.triple_bond_crossings","@type":"LeanDeclaration","name":"QOU.Molecular.triple_bond_crossings","kind":"theorem","line":27,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/covalent-bond-shared-trefoil.lean#L27-L28","doc":"Triple bond has 6 attractive crossings. ","signatureChunk":0},{"@id":"lean:QOU.Molecular.double_bond_crossings","@type":"LeanDeclaration","name":"QOU.Molecular.double_bond_crossings","kind":"theorem","line":24,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/covalent-bond-shared-trefoil.lean#L24-L25","doc":"Double bond has 4 attractive crossings. ","signatureChunk":0},{"@id":"lean:QOU.Molecular.single_bond_crossings","@type":"LeanDeclaration","name":"QOU.Molecular.single_bond_crossings","kind":"theorem","line":21,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/covalent-bond-shared-trefoil.lean#L21-L22","doc":"Single bond has 2 attractive crossings. ","signatureChunk":0},{"@id":"lean:QOU.Molecular.CovalentBond.sharedElectrons","@type":"LeanDeclaration","name":"QOU.Molecular.CovalentBond.sharedElectrons","kind":"def","line":19,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/covalent-bond-shared-trefoil.lean#L19-L19","doc":"Number of shared electrons = order. ","signatureChunk":0},{"@id":"lean:QOU.Molecular.CovalentBond.attractiveCrossings","@type":"LeanDeclaration","name":"QOU.Molecular.CovalentBond.attractiveCrossings","kind":"def","line":17,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/covalent-bond-shared-trefoil.lean#L17-L17","doc":"Number of attractive crossings = 2 × order. ","signatureChunk":0},{"@id":"lean:QOU.Molecular.CovalentBond.order_pos","@type":"LeanDeclaration","name":"QOU.Molecular.CovalentBond.order_pos","kind":"theorem","line":15,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/covalent-bond-shared-trefoil.lean#L15-L15","signatureChunk":0},{"@id":"lean:QOU.Molecular.CovalentBond.order","@type":"LeanDeclaration","name":"QOU.Molecular.CovalentBond.order","kind":"def","line":14,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/covalent-bond-shared-trefoil.lean#L14-L14","doc":"Bond order (1 = single, 2 = double, 3 = triple). ","signatureChunk":0},{"@id":"lean:QOU.Molecular.CovalentBond.mk","@type":"LeanDeclaration","name":"QOU.Molecular.CovalentBond.mk","kind":"ctor","line":12,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/covalent-bond-shared-trefoil.lean#L12-L12","signatureChunk":0},{"@id":"lean:QOU.Molecular.CovalentBond","@type":"LeanDeclaration","name":"QOU.Molecular.CovalentBond","kind":"structure","line":6,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/covalent-bond-shared-trefoil.lean#L6-L19","doc":"A **covalent bond** of order k consists of k electron trefoils\nHopf-linked across two nuclei via 2k attractive σ⁻¹ crossings\n(one pair per nucleus per electron).\n\nLone electrons have only one attractive crossing.\nShared electrons have two (one to each nucleus). ","formalizes":[{"@id":"block:def:covalent-bond-shared-trefoil","label":"def:covalent-bond-shared-trefoil","md":"quantum-observable-universe/molecular-construction/covalent-bond-shared-trefoil.md"}],"signatureChunk":0}]}