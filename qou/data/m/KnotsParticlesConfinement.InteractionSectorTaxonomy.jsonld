{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:KnotsParticlesConfinement.InteractionSectorTaxonomy","@type":"LeanModule","name":"KnotsParticlesConfinement.InteractionSectorTaxonomy","imports":["lean:module:Init"],"declarations":20,"chunks":1},{"@id":"lean:QOU.Interactions.SectorTaxonomy.sectors_distinct","@type":"LeanDeclaration","name":"QOU.Interactions.SectorTaxonomy.sectors_distinct","kind":"theorem","line":83,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/interaction-sector-taxonomy.lean#L83-L87","doc":"The three sectors are pairwise distinct. ","signatureChunk":0},{"@id":"lean:QOU.Interactions.SectorTaxonomy.em_no_pure_parity","@type":"LeanDeclaration","name":"QOU.Interactions.SectorTaxonomy.em_no_pure_parity","kind":"theorem","line":76,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/interaction-sector-taxonomy.lean#L76-L81","doc":"The electromagnetic sector is exactly the one with no pure bar-parity\nassignment (and provably cannot have one — see the library module\n`QOU.Interactions.EmCouplingBarParity`). ","signatureChunk":0},{"@id":"lean:QOU.Interactions.SectorTaxonomy.strong_unique_bar_even","@type":"LeanDeclaration","name":"QOU.Interactions.SectorTaxonomy.strong_unique_bar_even","kind":"theorem","line":71,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/interaction-sector-taxonomy.lean#L71-L74","doc":"Strong is the unique sector whose established parity is bar-even. ","signatureChunk":0},{"@id":"lean:QOU.Interactions.SectorTaxonomy.weak_unique_bar_odd","@type":"LeanDeclaration","name":"QOU.Interactions.SectorTaxonomy.weak_unique_bar_odd","kind":"theorem","line":66,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/interaction-sector-taxonomy.lean#L66-L69","doc":"Weak is the unique sector whose established parity is bar-odd. ","signatureChunk":0},{"@id":"lean:QOU.Interactions.SectorTaxonomy.couplingObject","@type":"LeanDeclaration","name":"QOU.Interactions.SectorTaxonomy.couplingObject","kind":"def","line":58,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/interaction-sector-taxonomy.lean#L58-L64","doc":"The coupling object each sector reads its strength from, named by the\ncorpus construction (documentation-level: the strings name the canonical\ncompute/Lean carriers). ","signatureChunk":0},{"@id":"lean:QOU.Interactions.SectorTaxonomy.parity","@type":"LeanDeclaration","name":"QOU.Interactions.SectorTaxonomy.parity","kind":"def","line":47,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/interaction-sector-taxonomy.lean#L47-L56","doc":"Bar parity of the sector's primary observable, where a PURE channel\nexists (strong: binding, bar-even; weak: Q_β, bar-odd). For the\nelectromagnetic sector `none` is itself a theorem-backed verdict: the EM\ncoupling is provably neither bar-even nor bar-odd under nondegeneracy\n(`QOU.Interactions.EmCouplingBarParity.emCouplingBare_not_bar_even/odd`) —\nthe sector admits no pure-parity assignment. ","signatureChunk":0},{"@id":"lean:QOU.Interactions.SectorTaxonomy.calAnchor","@type":"LeanDeclaration","name":"QOU.Interactions.SectorTaxonomy.calAnchor","kind":"def","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/interaction-sector-taxonomy.lean#L38-L45","doc":"The calibration each sector's scale anchors to (CAL index 1–3):\nstrong binding is priced in `E₀ = m_e/(q₀(q₀−1))` off CAL-1/CAL-2; the\nelectromagnetic Hartree scale is `α_EM²·m_e c²` off CAL-1 with the derived\n`α_EM`; the weak sector is CAL-2 itself (`P_skew^β`, proxy `m_μ/m_e`). ","signatureChunk":0},{"@id":"lean:QOU.Interactions.SectorTaxonomy.instReprSector","@type":"LeanDeclaration","name":"QOU.Interactions.SectorTaxonomy.instReprSector","kind":"instance","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/interaction-sector-taxonomy.lean#L36-L36","signatureChunk":0},{"@id":"lean:QOU.Interactions.SectorTaxonomy.instReprSector.repr","@type":"LeanDeclaration","name":"QOU.Interactions.SectorTaxonomy.instReprSector.repr","kind":"def","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/interaction-sector-taxonomy.lean#L36-L36","signatureChunk":0},{"@id":"lean:QOU.Interactions.SectorTaxonomy.instDecidableEqSector","@type":"LeanDeclaration","name":"QOU.Interactions.SectorTaxonomy.instDecidableEqSector","kind":"instance","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/interaction-sector-taxonomy.lean#L36-L36","signatureChunk":0},{"@id":"lean:QOU.Interactions.SectorTaxonomy.Sector.weak","@type":"LeanDeclaration","name":"QOU.Interactions.SectorTaxonomy.Sector.weak","kind":"ctor","line":35,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/interaction-sector-taxonomy.lean#L35-L35","signatureChunk":0},{"@id":"lean:QOU.Interactions.SectorTaxonomy.Sector.electromagnetic","@type":"LeanDeclaration","name":"QOU.Interactions.SectorTaxonomy.Sector.electromagnetic","kind":"ctor","line":34,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/interaction-sector-taxonomy.lean#L34-L34","signatureChunk":0},{"@id":"lean:QOU.Interactions.SectorTaxonomy.Sector.strong","@type":"LeanDeclaration","name":"QOU.Interactions.SectorTaxonomy.Sector.strong","kind":"ctor","line":33,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/interaction-sector-taxonomy.lean#L33-L33","signatureChunk":0},{"@id":"lean:QOU.Interactions.SectorTaxonomy.Sector","@type":"LeanDeclaration","name":"QOU.Interactions.SectorTaxonomy.Sector","kind":"inductive","line":31,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/interaction-sector-taxonomy.lean#L31-L36","doc":"The three interaction sectors of the framework. ","formalizes":[{"@id":"block:def:interaction-sector-taxonomy","label":"def:interaction-sector-taxonomy","md":"quantum-observable-universe/knots-particles-confinement/interaction-sector-taxonomy.md"}],"signatureChunk":0},{"@id":"lean:QOU.Interactions.SectorTaxonomy.instReprBarParity","@type":"LeanDeclaration","name":"QOU.Interactions.SectorTaxonomy.instReprBarParity","kind":"instance","line":29,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/interaction-sector-taxonomy.lean#L29-L29","signatureChunk":0},{"@id":"lean:QOU.Interactions.SectorTaxonomy.instReprBarParity.repr","@type":"LeanDeclaration","name":"QOU.Interactions.SectorTaxonomy.instReprBarParity.repr","kind":"def","line":29,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/interaction-sector-taxonomy.lean#L29-L29","signatureChunk":0},{"@id":"lean:QOU.Interactions.SectorTaxonomy.instDecidableEqBarParity","@type":"LeanDeclaration","name":"QOU.Interactions.SectorTaxonomy.instDecidableEqBarParity","kind":"instance","line":29,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/interaction-sector-taxonomy.lean#L29-L29","signatureChunk":0},{"@id":"lean:QOU.Interactions.SectorTaxonomy.BarParity.odd","@type":"LeanDeclaration","name":"QOU.Interactions.SectorTaxonomy.BarParity.odd","kind":"ctor","line":28,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/interaction-sector-taxonomy.lean#L28-L28","signatureChunk":0},{"@id":"lean:QOU.Interactions.SectorTaxonomy.BarParity.even","@type":"LeanDeclaration","name":"QOU.Interactions.SectorTaxonomy.BarParity.even","kind":"ctor","line":27,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/interaction-sector-taxonomy.lean#L27-L27","signatureChunk":0},{"@id":"lean:QOU.Interactions.SectorTaxonomy.BarParity","@type":"LeanDeclaration","name":"QOU.Interactions.SectorTaxonomy.BarParity","kind":"inductive","line":25,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/knots-particles-confinement/interaction-sector-taxonomy.lean#L25-L29","doc":"Bar-involution (`q ↦ q⁻¹`) parity channel. ","signatureChunk":0}]}