{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.BraidKnot.IsotopeRecord","@type":"LeanModule","name":"QOU.BraidKnot.IsotopeRecord","imports":["lean:module:Init"],"declarations":67,"chunks":1},{"@id":"lean:QOU.BraidKnot.canonicalIsotopeRecord","@type":"LeanDeclaration","name":"QOU.BraidKnot.canonicalIsotopeRecord","kind":"def","line":123,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/IsotopeRecord.lean#L123-L128","doc":"A canonical IsotopeRecord skeleton for (Z, N) — used as the base\nfor the all-isotopes registry. Computed fields (|tr_M|, B_AME)\nare filled by the runtime pipeline. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.canonicalKnotOperatorList","@type":"LeanDeclaration","name":"QOU.BraidKnot.canonicalKnotOperatorList","kind":"def","line":113,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/IsotopeRecord.lean#L113-L121","doc":"The canonical knot-operator catalogue for atom (Z, N) constructed\nby `build_knot_operator_catalogue(Z, N)` in the Python schema.\n\nThis Lean signature axiomatises the existence of such a builder;\nthe body is computed Python-side and stored on the `IsotopeRecord`\ninstance. For the formal layer this is the canonical recipe input\nto all downstream Lean machinery (mass formula, atlas auto-render). ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.n_strands_eq_three_A","@type":"LeanDeclaration","name":"QOU.BraidKnot.n_strands_eq_three_A","kind":"theorem","line":109,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/IsotopeRecord.lean#L109-L111","doc":"n_strands = 3·A derivation is by `rfl`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.A_eq_Z_plus_N","@type":"LeanDeclaration","name":"QOU.BraidKnot.A_eq_Z_plus_N","kind":"theorem","line":105,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/IsotopeRecord.lean#L105-L107","doc":"A=Z+N derivation is by `rfl`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.IsotopeRecord.n_strands","@type":"LeanDeclaration","name":"QOU.BraidKnot.IsotopeRecord.n_strands","kind":"def","line":102,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/IsotopeRecord.lean#L102-L103","doc":"Strand count `n_strands = 3·A` — derived (computed), not stored. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.IsotopeRecord.A","@type":"LeanDeclaration","name":"QOU.BraidKnot.IsotopeRecord.A","kind":"def","line":98,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/IsotopeRecord.lean#L98-L100","doc":"Mass number `A = Z + N` — derived (computed), not a stored/overridable\nfield, so `A = Z + N` holds definitionally for every record. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.instReprIsotopeRecord","@type":"LeanDeclaration","name":"QOU.BraidKnot.instReprIsotopeRecord","kind":"instance","line":96,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/IsotopeRecord.lean#L96-L96","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.instReprIsotopeRecord.repr","@type":"LeanDeclaration","name":"QOU.BraidKnot.instReprIsotopeRecord.repr","kind":"def","line":96,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/BraidKnot/IsotopeRecord.lean#L96-L96","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.IsotopeRecord.err_ppb","@type":"LeanDeclaration","name":"QOU.BraidKnot.IsotopeRecord.err_ppb","kind":"def","line":