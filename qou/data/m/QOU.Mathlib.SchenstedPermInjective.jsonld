{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Mathlib.SchenstedPermInjective","@type":"LeanModule","name":"QOU.Mathlib.SchenstedPermInjective","imports":["lean:module:Init","lean:module:QOU.Mathlib.SchenstedRSKInjective","lean:module:QOU.Mathlib.SchenstedPairingMap"],"declarations":4,"chunks":1},{"@id":"lean:QOU.Mathlib.Schensted.insertWordRec_wordOfPerm_ne","@type":"LeanDeclaration","name":"QOU.Mathlib.Schensted.insertWordRec_wordOfPerm_ne","kind":"theorem","line":62,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SchenstedPermInjective.lean#L62-L65","doc":"Contrapositive: distinct permutations are told apart by their `(P, Q)` pair. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.Schensted.insertWordRec_wordOfPerm_injective","@type":"LeanDeclaration","name":"QOU.Mathlib.Schensted.insertWordRec_wordOfPerm_injective","kind":"theorem","line":50,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SchenstedPermInjective.lean#L50-L60","doc":"**RSK separates permutations.** Distinct permutations of `Fin n` produce distinct\ninsertion/recording pairs.\n\nBrick 7 needs the two words to have equal length; `wordOfPerm_length` supplies it, both being `n`.\n","signatureChunk":0},{"@id":"lean:QOU.Mathlib.Schensted.wordOfPerm_injective","@type":"LeanDeclaration","name":"QOU.Mathlib.Schensted.wordOfPerm_injective","kind":"theorem","line":40,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SchenstedPermInjective.lean#L40-L48","doc":"**`wordOfPerm` is injective.** The word lists `σ`'s values in index order, shifted by one, so\nreading it back recovers `σ` pointwise. ","signatureChunk":0},{"@id":"lean:QOU.Mathlib.Schensted.wordOfPerm_length","@type":"LeanDeclaration","name":"QOU.Mathlib.Schensted.wordOfPerm_length","kind":"theorem","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Mathlib/SchenstedPermInjective.lean#L36-L38","doc":"`wordOfPerm σ` has one letter per point. ","signatureChunk":0}]}