:"QOU.SchurWeyl.JimboGL.qtr_extLast_mul_last","kind":"theorem","line":268,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/JimboGL.lean#L268-L302","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.JimboGL.partial_last","@type":"LeanDeclaration","name":"QOU.SchurWeyl.JimboGL.partial_last","kind":"theorem","line":231,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/JimboGL.lean#L231-L266","doc":"The partial `K`-trace of `Ř` over the appended last site is `q^{2d−1}` times the identity. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.JimboGL.sum_wt_diag","@type":"LeanDeclaration","name":"QOU.SchurWeyl.JimboGL.sum_wt_diag","kind":"theorem","line":214,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/JimboGL.lean#L214-L229","doc":"The partial `K`-trace of `Ř` over the second factor. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.JimboGL.curl","@type":"LeanDeclaration","name":"QOU.SchurWeyl.JimboGL.curl","kind":"theorem","line":202,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/JimboGL.lean#L202-L212","doc":"The curl identity on `Fin d`. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.JimboGL.curl_nat","@type":"LeanDeclaration","name":"QOU.SchurWeyl.JimboGL.curl_nat","kind":"theorem","line":185,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/JimboGL.lean#L185-L200","doc":"The curl identity over `ℕ`: `q · Σ_{x<D} q^{2x} c(u,x) = q^{2D}` for `u < D`, where\n`c(u,u) = q`, `c(u,x) = q − qi` for `u < x`, and `0` for `x < u`. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.JimboGL.embedPair_castSucc","@type":"LeanDeclaration","name":"QOU.SchurWeyl.JimboGL.embedPair_castSucc","kind":"theorem","line":157,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/JimboGL.lean#L157-L179","doc":"A two-site operator at sites `i, j < N` of `V^{⊗(N+1)}` is the extension of the same\noperator on `V^{⊗N}`. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.JimboGL.qtr_extLast","@type":"LeanDeclaration","name":"QOU.SchurWeyl.JimboGL.qtr_extLast","kind":"theorem","line":149,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/JimboGL.lean#L149-L155","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.JimboGL.extLast_snoc","@type":"LeanDeclaration","name":"QOU.SchurWeyl.JimboGL.extLast_snoc","kind":"theorem","line":143,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/JimboGL.lean#L143-L147","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.JimboGL.extLast_apply","@type":"LeanDeclaration","name":"QOU.SchurWeyl.JimboGL.extLast_apply","kind":"theorem","line":136,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/JimboGL.lean#L136-L141","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.JimboGL.extLast","@type":"LeanDeclaration","name":"QOU.SchurWeyl.JimboGL.extLast","kind":"def","line":129,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/JimboGL.lean#L129-L134","doc":"`X ↦ X ⊗ 1`, the new tensor factor appended last, as an algebra map. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.JimboGL.snocE","@type":"LeanDeclaration","name":"QOU.SchurWeyl.JimboGL.snocE","kind":"def","line":125,"sourceLink":"https://github.com/litlfred/qou/blob/7341d