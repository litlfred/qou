ro","kind":"theorem","line":91,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/JimboGL.lean#L91-L92","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.JimboGL.qtr_smul","@type":"LeanDeclaration","name":"QOU.SchurWeyl.JimboGL.qtr_smul","kind":"theorem","line":86,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/JimboGL.lean#L86-L89","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.JimboGL.qtr_add","@type":"LeanDeclaration","name":"QOU.SchurWeyl.JimboGL.qtr_add","kind":"theorem","line":82,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/JimboGL.lean#L82-L84","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.JimboGL.qtr","@type":"LeanDeclaration","name":"QOU.SchurWeyl.JimboGL.qtr","kind":"def","line":78,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/JimboGL.lean#L78-L80","doc":"The weighted (quantum) trace `Tr(K^{⊗N} X)`. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.JimboGL.dWeight","@type":"LeanDeclaration","name":"QOU.SchurWeyl.JimboGL.dWeight","kind":"def","line":75,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/JimboGL.lean#L75-L76","doc":"The diagonal of `K^{⊗N}` on the monomial basis. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.JimboGL.wt","@type":"LeanDeclaration","name":"QOU.SchurWeyl.JimboGL.wt","kind":"def","line":72,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/JimboGL.lean#L72-L73","doc":"The site weight `K = diag(1, q², …, q^{2(d−1)})`. ","signatureChunk":0},{"@id":"lean:QOU.SchurWey