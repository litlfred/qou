/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/KnotTheory/Vassiliev/FourTermRelation.lean#L60-L61","signatureChunk":0},{"@id":"lean:QOU.KnotTheory.Vassiliev.CDModule.of","@type":"LeanDeclaration","name":"QOU.KnotTheory.Vassiliev.CDModule.of","kind":"def","line":57,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/KnotTheory/Vassiliev/FourTermRelation.lean#L57-L58","doc":"The basis vector of a single chord diagram. ","signatureChunk":0},{"@id":"lean:QOU.KnotTheory.Vassiliev.CDModule","@type":"LeanDeclaration","name":"QOU.KnotTheory.Vassiliev.CDModule","kind":"def","line":50,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/KnotTheory/Vassiliev/FourTermRelation.lean#L50-L51","doc":"The free `R`-module on chord diagrams of degree `n`. ","signatureChunk":0}]}