{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.AppendixSurreals.KComplex","@type":"LeanModule","name":"QOU.AppendixSurreals.KComplex","imports":["lean:module:Init","lean:module:QOU.AppendixSurreals.Basic"],"declarations":17,"chunks":1},{"@id":"lean:QOU.AppendixSurreals.normSq_eq_zero","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.normSq_eq_zero","kind":"theorem","line":136,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/KComplex.lean#L136-L150","doc":"The algebraic norm is faithful: `‖z‖² = 0 ↔ z = 0`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.normSq_nonneg","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.normSq_nonneg","kind":"theorem","line":128,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/KComplex.lean#L128-L134","doc":"`‖z‖² ≥ 0` (always). ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.normSq_mul","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.normSq_mul","kind":"theorem","line":121,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/KComplex.lean#L121-L126","doc":"`‖z · w‖² = ‖z‖² · ‖w‖²` (Brahmagupta–Fibonacci). ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.mul_conj","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.mul_conj","kind":"theorem","line":113,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/KComplex.lean#L113-L117","doc":"`z · conj z = (‖z‖², 0)`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.conj_conj","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.conj_conj","kind":"theorem","line":107,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/KComplex.lean#L107-L111","doc":"Conjugation is involutive. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.I_mul_I","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.I_mul_I","kind":"theorem","line":98,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/KComplex.lean#L98-L103","doc":"The imaginary unit squares to `−1 + 0·i`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.mul_assoc","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.mul_assoc","kind":"theorem","line":89,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/KComplex.lean#L89-L94","doc":"`KComplex.mul` is associative. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.mul_comm","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.mul_comm","kind":"theorem","line":83,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/KComplex.lean#L83-L87","doc":"`KComplex.mul` is commutative. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.mul_one","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.mul_one","kind":"theorem","line":77,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/KComplex.lean#L77-L81","doc":"Right identity for `KComplex.mul`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.one_mul","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.one_mul","kind":"theorem","line":71,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/KComplex.lean#L71-L75","doc":"Left identity for `KComplex.mul`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.KComplex.normSq","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.KComplex.normSq","kind":"def","line":65,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/KComplex.lean#L65-L67","doc":"**Algebraic norm** `‖a + bi‖² := a² + b²` valued in `K`.  Always\nnon-negative. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.KComplex.conj","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.KComplex.conj","kind":"def","line":62,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/KComplex.lean#L62-L63","doc":"**Complex conjugation** `(a, b) ↦ (a, −b)`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.KComplex.mul","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.KComplex.mul","kind":"def","line":57,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/KComplex.lean#L57-L60","doc":"**Complex multiplication** `(a, b) · (c, d) := (ac − bd, ad + bc)`,\nrealising `KComplex K` as `K[X]/(X² + 1)`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.KComplex.I","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.KComplex.I","kind":"def","line":54,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/KComplex.lean#L54-L55","doc":"The **imaginary unit** `i ∈ KComplex K`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.KComplex.one","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.KComplex.one","kind":"def","line":51,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/KComplex.lean#L51-L52","doc":"The **multiplicative unit** in `KComplex K`, i.e. `1 + 0·i`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.KComplex.abs","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.KComplex.abs","kind":"def","line":46,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/KComplex.lean#L46-L49","doc":"The **Manhattan modulus** `|a + bi| := |a| + |b|`.  Placeholder\nfor the Euclidean modulus `√(a²+b²)`. ","signatureChunk":0},{"@id":"lean:QOU.AppendixSurreals.KComplex","@type":"LeanDeclaration","name":"QOU.AppendixSurreals.KComplex","kind":"def","line":41,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/AppendixSurreals/KComplex.lean#L41-L44","doc":"The **complexification of `K`** as the ordered pair\n`(real-part, imaginary-part)`.  Faithful as a set-level\nrepresentation of `K[i]/(i²+1)`. ","signatureChunk":0}]}