{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:LiftingAndDescent.AlgebraicFilterClassification","@type":"LeanModule","name":"LiftingAndDescent.AlgebraicFilterClassification","imports":["lean:module:Init","lean:module:Mathlib.Data.Real.Basic"],"declarations":5,"chunks":1},{"@id":"lean:QOU.Torsion.algebraic_filter_exclusive","@type":"LeanDeclaration","name":"QOU.Torsion.algebraic_filter_exclusive","kind":"theorem","line":31,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/algebraic-filter-classification.lean#L31-L34","doc":"The classification is exclusive: no form is both fermionic and bosonic. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.algebraic_filter_exhaustive","@type":"LeanDeclaration","name":"QOU.Torsion.algebraic_filter_exhaustive","kind":"theorem","line":26,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/algebraic-filter-classification.lean#L26-L29","doc":"The classification is exhaustive: every form is either fermionic or bosonic. ","signatureChunk":0},{"@id":"lean:QOU.Torsion.AlgebraicFilterClass.bosonic","@type":"LeanDeclaration","name":"QOU.Torsion.AlgebraicFilterClass.bosonic","kind":"ctor","line":24,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/algebraic-filter-classification.lean#L24-L24","signatureChunk":0},{"@id":"lean:QOU.Torsion.AlgebraicFilterClass.fermionic","@type":"LeanDeclaration","name":"QOU.Torsion.AlgebraicFilterClass.fermionic","kind":"ctor","line":23,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/algebraic-filter-classification.lean#L23-L23","signatureChunk":0},{"@id":"lean:QOU.Torsion.AlgebraicFilterClass","@type":"LeanDeclaration","name":"QOU.Torsion.AlgebraicFilterClass","kind":"inductive","line":18,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/algebraic-filter-classification.lean#L18-L24","doc":"Classification of a harmonic form by its commutator with the curvature.\nA form is either fermionic (nonzero commutator) or bosonic (zero commutator).\nThis is an exhaustive dichotomy by the law of excluded middle. ","signatureChunk":0}]}