{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Archimedean.TauFunctorTargetSpec","@type":"LeanModule","name":"QOU.Archimedean.TauFunctorTargetSpec","imports":["lean:module:Init","lean:module:Mathlib.Data.Matrix.Block","lean:module:QOU.Archimedean.TauRhoHodgeLiftInterface","lean:module:QOU.Archimedean.LiftFromReality"],"declarations":9,"chunks":1},{"@id":"lean:QOU.Archimedean.TauFunctorTargetSpec.interface_alone_is_trivially_inhabitable","@type":"LeanDeclaration","name":"QOU.Archimedean.TauFunctorTargetSpec.interface_alone_is_trivially_inhabitable","kind":"theorem","line":74,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TauFunctorTargetSpec.lean#L74-L89","doc":"**The interface alone is trivially inhabitable** — machine-checking why\nthe wall is EXCLUSIVELY the functorial provenance: for any REAL prescribed\nweight, a bare diagonal matrix satisfies every interface field. (Labeled\nnon-sufficiency demonstration; NOT progress on the wall.) ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TauFunctorTargetSpec.discharge_equal_split","@type":"LeanDeclaration","name":"QOU.Archimedean.TauFunctorTargetSpec.discharge_equal_split","kind":"theorem","line":66,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TauFunctorTargetSpec.lean#L66-L72","doc":"The equal-split consequence, end to end: any realization's conjugate\nblock carries the same weight — the ½ of `½·a₀` for the realized operator. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TauFunctorTargetSpec.discharge","@type":"LeanDeclaration","name":"QOU.Archimedean.TauFunctorTargetSpec.discharge","kind":"theorem","line":59,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TauFunctorTargetSpec.lean#L59-L64","doc":"**Discharge.** Any realization induces the `TauRhoHodgeLift` on its\ndiagonal blocks (via the #3999 constructor) — with functorial provenance for\n`w`, inhabiting `ArchimedeanTauRealization` closes the wall. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TauFunctorTargetSpec.ArchimedeanTauRealization.channelTrace","@type":"LeanDeclaration","name":"QOU.Archimedean.TauFunctorTargetSpec.ArchimedeanTauRealization.channelTrace","kind":"theorem","line":57,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TauFunctorTargetSpec.lean#L57-L57","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TauFunctorTargetSpec.ArchimedeanTauRealization.herm","@type":"LeanDeclaration","name":"QOU.Archimedean.TauFunctorTargetSpec.ArchimedeanTauRealization.herm","kind":"theorem","line":56,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TauFunctorTargetSpec.lean#L56-L56","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TauFunctorTargetSpec.ArchimedeanTauRealization.real","@type":"LeanDeclaration","name":"QOU.Archimedean.TauFunctorTargetSpec.ArchimedeanTauRealization.real","kind":"theorem","line":55,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TauFunctorTargetSpec.lean#L55-L55","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TauFunctorTargetSpec.ArchimedeanTauRealization.loopWeight","@type":"LeanDeclaration","name":"QOU.Archimedean.TauFunctorTargetSpec.ArchimedeanTauRealization.loopWeight","kind":"def","line":54,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TauFunctorTargetSpec.lean#L54-L54","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TauFunctorTargetSpec.ArchimedeanTauRealization.mk","@type":"LeanDeclaration","name":"QOU.Archimedean.TauFunctorTargetSpec.ArchimedeanTauRealization.mk","kind":"ctor","line":53,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TauFunctorTargetSpec.lean#L53-L53","signatureChunk":0},{"@id":"lean:QOU.Archimedean.TauFunctorTargetSpec.ArchimedeanTauRealization","@type":"LeanDeclaration","name":"QOU.Archimedean.TauFunctorTargetSpec.ArchimedeanTauRealization","kind":"structure","line":49,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Archimedean/TauFunctorTargetSpec.lean#L49-L57","doc":"The interface data the measure derivation needs from the archimedean\nτ-functor. `w` is the prescribed `H^{1,0}` channel-weight trace (the τ-image\nof the canonical Markov weight — the functorial provenance requirement lives\nOUTSIDE this type, in the category; see the module docstring). ","signatureChunk":0}]}