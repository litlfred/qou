rimental.TerminalResolution.predictions","@type":"LeanDeclaration","name":"QOU.Experimental.TerminalResolution.predictions","kind":"def","line":164,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/terminal-resolution.lean#L164-L164","doc":"The mass predictions (derived from q via topological mass formula). ","signatureChunk":0},{"@id":"lean:QOU.Experimental.TerminalResolution.planck_eq","@type":"LeanDeclaration","name":"QOU.Experimental.TerminalResolution.planck_eq","kind":"theorem","line":162,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/terminal-resolution.lean#L162-L162","doc":"ℏ_q is correctly derived from q. ","signatureChunk":0},{"@id":"lean:QOU.Experimental.TerminalResolution.planck","@type":"LeanDeclaration","name":"QOU.Experimental.TerminalResolution.planck","kind":"def","line":160,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/terminal-resolution.lean#L160-L160","doc":"The quantum Planck constant ℏ_q = 1 - q⁻¹. ","signatureChunk":0},{"@id":"lean:QOU.Experimental.TerminalResolution.q_val","@type":"LeanDeclaration","name":"QOU.Experimental.TerminalResolution.q_val","kind":"theorem","line":158,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/terminal-resolution.lean#L158-L158","doc":"q ≈ 1.1097. ","signatureChunk":0},{"@id":"lean:QOU.Experimental.TerminalResolution.q","@type":"LeanDeclaration","name":"QOU.Experimental.TerminalResolution.q","kind":"def","line":156,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/terminal-resolution.lean#L156-L156","doc":"The substrate parameter used. ","signatureChunk":0},{"@id":"lean: