b.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/OcneanuWeightBranching.lean#L261-L275","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.card_twoRow","@type":"LeanDeclaration","name":"QOU.SchurWeyl.card_twoRow","kind":"theorem","line":255,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/OcneanuWeightBranching.lean#L255-L259","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.qBracket_pieri","@type":"LeanDeclaration","name":"QOU.SchurWeyl.qBracket_pieri","kind":"theorem","line":241,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/OcneanuWeightBranching.lean#L241-L253","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.schurPrincipal_twoRow","@type":"LeanDeclaration","name":"QOU.SchurWeyl.schurPrincipal_twoRow","kind":"theorem","line":164,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/OcneanuWeightBranching.lean#L164-L239","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.geom_oneSub","@type":"LeanDeclaration","name":"QOU.SchurWeyl.geom_oneSub","kind":"theorem","line":157,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/OcneanuWeightBranching.lean#L157-L162","doc":"`(1 + Q + ⋯ + Q^{n−1})(1 − Q) = 1 − Q^n`.  Proved here rather than imported: the Mathlib\nmodule carrying `geom_sum_mul` is deprecated, and this is four lines. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.mul_geom_succ","@type":"LeanDeclaration","name":"QOU.SchurWeyl.mul_geom_succ","kind":"theorem","line":148,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/OcneanuWeightBranching.lean#L148-L155","doc":"`Q·(1 + ⋯ + Q^{n−1}) + 1 = 1 + ⋯ + Q^n`.  The companion of `geom_oneSub`, and the whole\narithmetic content of the row-0 Markov corner identity in `OcneanuWeightMarkovCorner`. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.prod_oneSub_telescope","@type":"LeanDeclaration","name":"QOU.SchurWeyl.prod_oneSub_telescope","kind":"theorem","line":134,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/OcneanuWeightBranching.lean#L134-L146","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.nPart_twoRow","@type":"LeanDeclaration","name":"QOU.SchurWeyl.nPart_twoRow","kind":"theorem","line":128,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/OcneanuWeightBranching.lean#L128-L131","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.hook_twoRow_row1","@type":"LeanDeclaration","name":"QOU.SchurWeyl.hook_twoRow_row1","kind":"theorem","line":121,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/OcneanuWeightBranching.lean#L121-L126","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.hook_twoRow_row0","@type":"LeanDeclaration","name":"QOU.SchurWeyl.hook_twoRow_row0","kind":"theorem","line":113,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/OcneanuWeightBranching.lean#L113-L119","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.cells_twoRow","@type":"LeanDeclaration","name":"QOU.SchurWeyl.cells_twoRow","kind":"theorem","line":98,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/OcneanuWeightBranching.lean#L98-L111","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.colLen_twoRow","@type":"LeanDeclaration"