{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:PredictedSpectra.GoldenSkewDualNode","@type":"LeanModule","name":"PredictedSpectra.GoldenSkewDualNode","imports":["lean:module:Init","lean:module:Mathlib.Data.Real.Basic","lean:module:Mathlib.Analysis.SpecialFunctions.Pow.Real","lean:module:Mathlib.Tactic.Ring","lean:module:Mathlib.Tactic.Linarith"],"declarations":12,"chunks":1},{"@id":"lean:QOU.Archimedean.q_in_classical_band","@type":"LeanDeclaration","name":"QOU.Archimedean.q_in_classical_band","kind":"theorem","line":97,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/golden-skew-dual-node.lean#L97-L103","doc":"The substrate parameter q₀ ≈ 1.1097 lies strictly between 1 and φ².\nWe use the rational lower bound 1.1097 ≤ q₀ ≤ 1.1098 for the\nfalsifiability witness. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.golden_skew_dual_node","@type":"LeanDeclaration","name":"QOU.Archimedean.golden_skew_dual_node","kind":"theorem","line":85,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/golden-skew-dual-node.lean#L85-L95","doc":"**Skew-dual golden node** (Proposition):\n\nUnder the bar involution q ↔ q⁻¹, the sub-classical node\nq_gold = 1/φ² is paired with the super-classical node q* = φ².\nThe pairing is witnessed by q_gold · q* = 1. ","formalizes":[{"@id":"block:prop:golden-skew-dual-node","label":"prop:golden-skew-dual-node","md":"quantum-observable-universe/predicted-spectra/golden-skew-dual-node.md"}],"signatureChunk":0},{"@id":"lean:QOU.Archimedean.qGold_mul_qGoldDual","@type":"LeanDeclaration","name":"QOU.Archimedean.qGold_mul_qGoldDual","kind":"theorem","line":78,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/golden-skew-dual-node.lean#L78-L83","doc":"The two nodes are reciprocals: q_gold · q* = 1. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.phi_mul_phiInv","@type":"LeanDeclaration","name":"QOU.Archimedean.phi_mul_phiInv","kind":"theorem","line":70,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/golden-skew-dual-node.lean#L70-L76","doc":"Bar duality: φ · (1/φ) = 1. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.phiInv_pos","@type":"LeanDeclaration","name":"QOU.Archimedean.phiInv_pos","kind":"theorem","line":60,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/golden-skew-dual-node.lean#L60-L68","doc":"1/φ is positive. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.phi_pos","@type":"LeanDeclaration","name":"QOU.Archimedean.phi_pos","kind":"theorem","line":53,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/golden-skew-dual-node.lean#L53-L58","doc":"φ is positive. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.phi_min_poly","@type":"LeanDeclaration","name":"QOU.Archimedean.phi_min_poly","kind":"theorem","line":45,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/golden-skew-dual-node.lean#L45-L51","doc":"φ satisfies s² − s − 1 = 0. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.phiInv_min_poly","@type":"LeanDeclaration","name":"QOU.Archimedean.phiInv_min_poly","kind":"theorem","line":37,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/golden-skew-dual-node.lean#L37-L43","doc":"1/φ satisfies s² + s − 1 = 0. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.qGoldDual","@type":"LeanDeclaration","name":"QOU.Archimedean.qGoldDual","kind":"def","line":34,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/golden-skew-dual-node.lean#L34-L35","doc":"The skew-dual golden node q* = φ². ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.qGold","@type":"LeanDeclaration","name":"QOU.Archimedean.qGold","kind":"def","line":31,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/golden-skew-dual-node.lean#L31-L32","doc":"The sub-classical golden node q_gold = 1/φ². ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.phiInv","@type":"LeanDeclaration","name":"QOU.Archimedean.phiInv","kind":"def","line":28,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/golden-skew-dual-node.lean#L28-L29","doc":"The reciprocal of the golden ratio, 1/φ = (√5 − 1)/2. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.phi","@type":"LeanDeclaration","name":"QOU.Archimedean.phi","kind":"def","line":25,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/golden-skew-dual-node.lean#L25-L26","doc":"The golden ratio φ = (1 + √5)/2. ","signatureChunk":0}]}