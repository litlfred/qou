{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:PredictedSpectra.GaugeCouplingUniqueness","@type":"LeanModule","name":"PredictedSpectra.GaugeCouplingUniqueness","imports":["lean:module:Init","lean:module:QOU.Archimedean.EmSpectralCompleteness"],"declarations":8,"chunks":1},{"@id":"lean:QOU.Archimedean.gauge_coupling_uniqueness","@type":"LeanDeclaration","name":"QOU.Archimedean.gauge_coupling_uniqueness","kind":"theorem","line":74,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/gauge-coupling-uniqueness.lean#L74-L91","doc":"**Corollary (gauge coupling uniqueness)** — a genuine corollary of\n`em_spectral_completeness` at the categorical level, and, at the\nlevel formalised here, of one-dimensionality of `Hom_R(R, R)`.\n\nAny `R`-linear scalar coupling is a global-normalisation multiple of\nthe non-degenerate reference coupling. The witness is\n`lam = phi 1 · (psi 1)⁻¹`, derived from the hypotheses. ","formalizes":[{"@id":"block:cor:gauge-coupling-uniqueness","label":"cor:gauge-coupling-uniqueness","md":"quantum-observable-universe/predicted-spectra/gauge-coupling-uniqueness.md"}],"signatureChunk":0},{"@id":"lean:QOU.Archimedean.GaugeCouplingUniquenessData.psi_one_unit","@type":"LeanDeclaration","name":"QOU.Archimedean.GaugeCouplingUniquenessData.psi_one_unit","kind":"theorem","line":72,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/gauge-coupling-uniqueness.lean#L72-L72","doc":"The reference coupling is non-degenerate — `psi 1` is a unit.\nThis is what makes `psi` a basis of the coupling space rather than\nmerely an element of it. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.GaugeCouplingUniquenessData.psi_linear","@type":"LeanDeclaration","name":"QOU.Archimedean.GaugeCouplingUniquenessData.psi_linear","kind":"theorem","line":68,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/gauge-coupling-uniqueness.lean#L68-L68","doc":"`psi` is `R`-linear. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.GaugeCouplingUniquenessData.phi_linear","@type":"LeanDeclaration","name":"QOU.Archimedean.GaugeCouplingUniquenessData.phi_linear","kind":"theorem","line":66,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/gauge-coupling-uniqueness.lean#L66-L66","doc":"`phi` is `R`-linear: multiplicative against ring scalars. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.GaugeCouplingUniquenessData.psi","@type":"LeanDeclaration","name":"QOU.Archimedean.GaugeCouplingUniquenessData.psi","kind":"def","line":64,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/gauge-coupling-uniqueness.lean#L64-L64","doc":"The reference coupling `tr_τ(e₋)·e₋`. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.GaugeCouplingUniquenessData.phi","@type":"LeanDeclaration","name":"QOU.Archimedean.GaugeCouplingUniquenessData.phi","kind":"def","line":62,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/gauge-coupling-uniqueness.lean#L62-L62","doc":"The coupling under consideration. ","signatureChunk":0},{"@id":"lean:QOU.Archimedean.GaugeCouplingUniquenessData.mk","@type":"LeanDeclaration","name":"QOU.Archimedean.GaugeCouplingUniquenessData.mk","kind":"ctor","line":60,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/gauge-coupling-uniqueness.lean#L60-L60","signatureChunk":0},{"@id":"lean:QOU.Archimedean.GaugeCouplingUniquenessData","@type":"LeanDeclaration","name":"QOU.Archimedean.GaugeCouplingUniquenessData","kind":"structure","line":54,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/gauge-coupling-uniqueness.lean#L54-L72","doc":"Data for the uniqueness statement: two scalar couplings on the\ntwo-strand sector, presented as maps of the base ring, together with\nthe hypotheses the `.md` states — `R`-linearity of each, and\nnon-degeneracy of the reference coupling `psi`.\n\nEvery field is a **hypothesis**. None of them is the conclusion. ","signatureChunk":0}]}