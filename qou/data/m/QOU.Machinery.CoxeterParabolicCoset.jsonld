{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.Machinery.CoxeterParabolicCoset","@type":"LeanModule","name":"QOU.Machinery.CoxeterParabolicCoset","imports":["lean:module:Init","lean:module:Mathlib.GroupTheory.Coxeter.Length","lean:module:Mathlib.Tactic.Group"],"declarations":12,"chunks":1},{"@id":"lean:QOU.Machinery.CoxeterParabolic.length_minRep_mul_wordProd","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.length_minRep_mul_wordProd","kind":"theorem","line":159,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterParabolicCoset.lean#L159-L242","doc":"**THE LIFTING LEMMA** (Bourbaki Lie IV §1 / BB Prop 2.4.4, core form),\nconditional on the exchange property: a minimal coset representative `u`\ncomposes length-additively with every reduced `J`-word,\n`ℓ(u · π p) = ℓ(u) + |p|`. A failed ascent triggers exchange on the\nconcatenated reduced word; deletion in the `u`-part contradicts the\nminimality of `u`, deletion in the `p`-part contradicts the reducedness of\n`p`. This is the fact the merged coset structures' `len_add` fields\nencode. ","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.isReduced_of_isReduced_concat","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.isReduced_of_isReduced_concat","kind":"theorem","line":140,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterParabolicCoset.lean#L140-L157","doc":"A word stays reduced after dropping its last letter. ","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.minRep_not_isRightDescent","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.minRep_not_isRightDescent","kind":"theorem","line":128,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterParabolicCoset.lean#L128-L138","doc":"A minimal representative has no right descent in `J` (unconditional —\nthe length toggle plus coset closure). ","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.exists_minRep","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.exists_minRep","kind":"theorem","line":116,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterParabolicCoset.lean#L116-L126","doc":"**Every coset has a minimal-length representative** (unconditional —\nwell-ordering of the lengths). ","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.IsMinRep","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.IsMinRep","kind":"def","line":112,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterParabolicCoset.lean#L112-L114","doc":"`u` is a minimal-length representative of its left `W_J`-coset. ","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.wordProd_mem_parabolic","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.wordProd_mem_parabolic","kind":"theorem","line":102,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterParabolicCoset.lean#L102-L110","doc":"A word with letters in `J` has product in `W_J`. ","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.sameCosetJ_trans","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.sameCosetJ_trans","kind":"theorem","line":97,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterParabolicCoset.lean#L97-L100","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.sameCosetJ_symm","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.sameCosetJ_symm","kind":"theorem","line":92,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterParabolicCoset.lean#L92-L95","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.sameCosetJ_refl","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.sameCosetJ_refl","kind":"theorem","line":89,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterParabolicCoset.lean#L89-L90","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.SameCosetJ","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.SameCosetJ","kind":"def","line":86,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterParabolicCoset.lean#L86-L87","doc":"Two elements lie in the same left coset of `W_J`. ","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.parabolic","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.parabolic","kind":"def","line":83,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterParabolicCoset.lean#L83-L84","doc":"The standard parabolic subgroup `W_J = ⟨s_l : l ∈ J⟩`. ","signatureChunk":0},{"@id":"lean:QOU.Machinery.CoxeterParabolic.RightExchangeProp","@type":"LeanDeclaration","name":"QOU.Machinery.CoxeterParabolic.RightExchangeProp","kind":"def","line":72,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Machinery/CoxeterParabolicCoset.lean#L72-L79","doc":"**The right exchange property** (Bjorner–Brenti Thm 1.4.3, simple\nform; Bourbaki Lie IV §1): a right descent of a reduced word's product is\nrealized by deleting a single letter. Textbook-true; not derivable from\nMathlib's current Coxeter primitives (the audited upstream gap) — used\nbelow only as an explicit hypothesis. ","signatureChunk":0}]}