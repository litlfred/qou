hub.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L129-L129","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.ImplementationStep.h3GroundTruth","@type":"LeanDeclaration","name":"QOU.BraidKnot.ImplementationStep.h3GroundTruth","kind":"ctor","line":128,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L128-L128","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.ImplementationStep","@type":"LeanDeclaration","name":"QOU.BraidKnot.ImplementationStep","kind":"inductive","line":126,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L126-L132","doc":"Implementation roadmap status (per the .md design spec). ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.JointTowerSdpCertificate.rho_per_atom","@type":"LeanDeclaration","name":"QOU.BraidKnot.JointTowerSdpCertificate.rho_per_atom","kind":"def","line":124,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L124-L124","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.JointTowerSdpCertificate.jet_log_per_atom","@type":"LeanDeclaration","name":"QOU.BraidKnot.JointTowerSdpCertificate.jet_log_per_atom","kind":"def","line":123,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L123-L123","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.JointTowerSdpCertificate.filtration_per_atom","@type":"LeanDeclaration","name":"QOU.BraidKnot.JointTowerSdpCertificate.filtration_per_atom","kind":"def","line":122,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L122-L122","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.JointTowerSdpCertificate.T_w_per_atom","@type":"LeanDeclaration","name":"QOU.BraidKnot.JointTowerSdpCertificate.T_w_per_atom","kind":"def","line":121,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L121-L121","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.JointTowerSdpCertificate.mk","@type":"LeanDeclaration","name":"QOU.BraidKnot.JointTowerSdpCertificate.mk","kind":"ctor","line":120,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L120-L120","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.JointTowerSdpCertificate","@type":"LeanDeclaration","name":"QOU.BraidKnot.JointTowerSdpCertificate","kind":"structure","line":117,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L117-L124","doc":"Output: structured certificate Φ(q_0) per atom.  Combined with\nthe Wedderburn-multiplicity ρ(𝔥), this is consumed by\nprop:atom-knot-mass-derivation. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.joint_tower_sdp_feasible","@type":"LeanDeclaration","name":"QOU.BraidKnot.joint_tower_sdp_feasible","kind":"theorem","line":106,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L106-L115","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.JointTowerSdpFeasible","@type":"LeanDeclaration","name":"QOU.BraidKnot.JointTowerSdpFeasible","kind":"def","line":88,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L88-L104","doc":"Existence of a solution to the joint-tower SDP at q_0.\n\nBy prop:confinement-sdp the per-atom SDP is feasible for every 𝔥.\nThe joint SDP is feasible iff the cross-level constraints are\nsimultaneously satisfiable, which holds because the canonical\nembeddings H_m(q_0) ↪ H_n(q_0) preserve Wedderburn-block\npositivity (each block of H_m embeds into a sum of compatible\nblocks of H_n).  Combined with GB-filtration sparsity (finite\nby SS collapse at E_2) and jet-order indexing, the SDP is\nwell-posed.\n\nConcrete predicate: the registry is non-empty (at least one\nparticle's SDP variables are present), the minimal \"data is\nactually being tracked\" sanity check.  The genuine\nfeasibility-of-system claim requires the SDP solver. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.JointTowerSdp.cross_level_holds","@type":"LeanDeclaration","name":"QOU.BraidKnot.JointTowerSdp.cross_level_holds","kind":"theorem","line":86,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L86-L86","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.JointTowerSdp.jet_order_holds","@type":"LeanDeclaration","name":"QOU.BraidKnot.JointTowerSdp.jet_order_holds","kind":"theorem","line":85,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L85-L85","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.JointTowerSdp.gb_filtration_holds","@type":"LeanDeclaration","name":"QOU.BraidKnot.JointTowerSdp.gb_filtration_holds","kind":"theorem","line":84,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L84-L84","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.JointTowerSdp.wedderburn_positivity_holds","@type":"LeanDeclaration","name":"QOU.BraidKnot.JointTowerSdp.wedderburn_positivity_holds","kind":"theorem","line":83,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L83-L83","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.JointTowerSdp.tower_edges","@type":"LeanDeclaration","name":"QOU.BraidKnot.JointTowerSdp.tower_edges","kind":"def","line":81,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L81-L81","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.JointTowerSdp.registry","@type":"LeanDeclaration","name":"QOU.BraidKnot.JointTowerSdp.registry","kind":"def","line":80,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L80-L80","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.JointTowerSdp.mk","@type":"LeanDeclaration","name":"QOU.BraidKnot.JointTowerSdp.mk","kind":"ctor","line":79,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L79-L79","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.JointTowerSdp","@type":"LeanDeclaration","name":"QOU.BraidKnot.JointTowerSdp","kind":"structure","line":78,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L78-L86","doc":"The full joint mass-tower SDP. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.CrossLevelConsistency","@type":"LeanDeclaration","name":"QOU.BraidKnot.CrossLevelConsistency","kind":"def","line":70,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L70-L76","doc":"Cross-level consistency: for each tower edge, the embedding\nπ_{𝔥 → 𝔥'} maps T_w(𝔥') to T_w(𝔥) inside the relevant cosets.\nConcrete predicate: the embedding is dimension-non-decreasing\n(`embedding_codomain_n_0 ≥ embedding_domain_n_0`), the minimal\nwell-formedness for an inclusion `H_m ↪ H_n`. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.TowerEdge.embedding_domain_n_0","@type":"LeanDeclaration","name":"QOU.BraidKnot.TowerEdge.embedding_domain_n_0","kind":"def","line":66,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L66-L66","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.TowerEdge.embedding_codomain_n_0","@type":"LeanDeclaration","name":"QOU.BraidKnot.TowerEdge.embedding_codomain_n_0","kind":"def","line":65,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L65-L65","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.TowerEdge.constituent","@type":"LeanDeclaration","name":"QOU.BraidKnot.TowerEdge.constituent","kind":"def","line":64,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L64-L64","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.TowerEdge.parent","@type":"LeanDeclaration","name":"QOU.BraidKnot.TowerEdge.parent","kind":"def","line":63,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L63-L63","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.TowerEdge.mk","@type":"LeanDeclaration","name":"QOU.BraidKnot.TowerEdge.mk","kind":"ctor","line":62,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L62-L62","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.TowerEdge","@type":"LeanDeclaration","name":"QOU.BraidKnot.TowerEdge","kind":"structure","line":60,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L60-L66","doc":"Tower edge: a confinement-level consistency constraint between\na parent particle 𝔥 and a constituent 𝔥' embedded into 𝔥. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.JetOrderOrdering","@type":"LeanDeclaration","name":"QOU.BraidKnot.JetOrderOrdering","kind":"def","line":53,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L53-L58","doc":"Jet-order ordering constraint.  Concrete predicate: the\n`jet_order` list is non-empty (i.e. at least one σ-word is\nindexed).  The genuine well-orderedness check belongs to the\nSDP solver. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.GbFiltrationGrading","@type":"LeanDeclaration","name":"QOU.BraidKnot.GbFiltrationGrading","kind":"def","line":45,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L45-L51","doc":"GB-filtration grading constraint: the support of c_w lives in a\nfixed Coxeter-length-graded subspace.  Concrete predicate: the\nfiltration cutoff is bounded by `2 · n_0` (a Coxeter-length\nsanity bound; tighter bounds belong to the genuine SDP\nderivation). ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.WedderburnBlockPositivity","@type":"LeanDeclaration","name":"QOU.BraidKnot.WedderburnBlockPositivity","kind":"def","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L36-L43","doc":"Wedderburn-block positivity constraint: ρ_λ(T_w) ⪰ 0 for every\nblock λ ⊢ n_0.  Concrete predicate: the strand count is positive\n(`vars.n_0 ≥ 1`), the minimal well-formedness for any partition\nblock to exist.  The genuine block-positivity check is handled\nby the SDP solver downstream. ","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.PerParticleSdpVariables.jet_order","@type":"LeanDeclaration","name":"QOU.BraidKnot.PerParticleSdpVariables.jet_order","kind":"def","line":34,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L34-L34","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.PerParticleSdpVariables.filtration_cutoff","@type":"LeanDeclaration","name":"QOU.BraidKnot.PerParticleSdpVariables.filtration_cutoff","kind":"def","line":32,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L32-L32","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.PerParticleSdpVariables.n_0","@type":"LeanDeclaration","name":"QOU.BraidKnot.PerParticleSdpVariables.n_0","kind":"def","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L30-L30","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.PerParticleSdpVariables.particle_name","@type":"LeanDeclaration","name":"QOU.BraidKnot.PerParticleSdpVariables.particle_name","kind":"def","line":29,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L29-L29","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.PerParticleSdpVariables.mk","@type":"LeanDeclaration","name":"QOU.BraidKnot.PerParticleSdpVariables.mk","kind":"ctor","line":28,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L28-L28","signatureChunk":0},{"@id":"lean:QOU.BraidKnot.PerParticleSdpVariables","@type":"LeanDeclaration","name":"QOU.BraidKnot.PerParticleSdpVariables","kind":"structure","line":26,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/mass-theory/joint-tower-sdp-confinement.lean#L26-L34","doc":"Per-particle SDP variables: coefficients c_w(q_0) ∈ ℚ for\nw ∈ S_{n_0} indexing the GB-NF basis {T_w} of H_{n_0}(q_0). ","signatureChunk":0}]}