{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:MolecularConstruction.AtomicValenceOpenSites","@type":"LeanModule","name":"MolecularConstruction.AtomicValenceOpenSites","imports":["lean:module:Init"],"declarations":6,"chunks":1},{"@id":"lean:QOU.Molecular.valence_le_zVal","@type":"LeanDeclaration","name":"QOU.Molecular.valence_le_zVal","kind":"theorem","line":29,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/atomic-valence-open-sites.lean#L29-L32","doc":"The valence never exceeds the count of valence electrons. ","signatureChunk":0},{"@id":"lean:QOU.Molecular.valence_oxygen","@type":"LeanDeclaration","name":"QOU.Molecular.valence_oxygen","kind":"theorem","line":25,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/atomic-valence-open-sites.lean#L25-L27","doc":"Oxygen (Z_val = 6, n_val = 2): valence 2 (plus two lone pairs). ","signatureChunk":0},{"@id":"lean:QOU.Molecular.valence_nitrogen","@type":"LeanDeclaration","name":"QOU.Molecular.valence_nitrogen","kind":"theorem","line":21,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/atomic-valence-open-sites.lean#L21-L23","doc":"Nitrogen (Z_val = 5, n_val = 2): valence 3 (plus one lone pair). ","signatureChunk":0},{"@id":"lean:QOU.Molecular.valence_carbon","@type":"LeanDeclaration","name":"QOU.Molecular.valence_carbon","kind":"theorem","line":17,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/atomic-valence-open-sites.lean#L17-L19","doc":"Carbon (Z_val = 4, n_val = 2): valence 4 — the half-filled L shell. ","signatureChunk":0},{"@id":"lean:QOU.Molecular.valence_hydrogen","@type":"LeanDeclaration","name":"QOU.Molecular.valence_hydrogen","kind":"theorem","line":13,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/atomic-valence-open-sites.lean#L13-L15","doc":"Hydrogen (Z_val = 1, n_val = 1): valence 1. ","signatureChunk":0},{"@id":"lean:QOU.Molecular.atomicValence","@type":"LeanDeclaration","name":"QOU.Molecular.atomicValence","kind":"def","line":6,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/molecular-construction/atomic-valence-open-sites.lean#L6-L11","doc":"The **valence** of an atom: the number of open bonding sites available\nfor covalent bonds, `v(Z) = min(Z_val, 2·n_val² − Z_val)`, where `Z_val`\nis the number of valence electrons and `n_val` the outermost shell level. ","formalizes":[{"@id":"block:def:atomic-valence-open-sites","label":"def:atomic-valence-open-sites","md":"quantum-observable-universe/molecular-construction/atomic-valence-open-sites.md"}],"signatureChunk":0}]}