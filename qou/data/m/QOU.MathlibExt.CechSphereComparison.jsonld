atureChunk":0},{"@id":"lean:QOU.CentralExtension.Cech.sphereEquiv","@type":"LeanDeclaration","name":"QOU.CentralExtension.Cech.sphereEquiv","kind":"def","line":105,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/CechSphereComparison.lean#L105-L108","doc":"Conditional on C2: `Ȟ²(S², G) ≃ G`. ","signatureChunk":0},{"@id":"lean:QOU.CentralExtension.Cech.hemiComputesCech_of_good","@type":"LeanDeclaration","name":"QOU.CentralExtension.Cech.hemiComputesCech_of_good","kind":"theorem","line":91,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/CechSphereComparison.lean#L91-L99","doc":"**C2 reduced to one cover at a time.** If every open cover of `S²` has a\ngood refinement relative to the hemisphere cover, then C2 holds. ","signatureChunk":0},{"@id":"lean:QOU.CentralExtension.Cech.isCoverDirected_isOpenCover","@type":"LeanDeclaration","name":"QOU.CentralExtension.Cech.isCoverDirected_isOpenCover","kind":"theorem","line":86,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/CechSphereComparison.lean#L86-L89","doc":"Open covers of `⊤ : Opens X` form a directed system. ","signatureChunk":0},{"@id":"lean:QOU.CentralExtension.Cech.HemiComputesCech.bijective","@type":"LeanDeclaration","name":"QOU.CentralExtension.Cech.HemiComputesCech.bijective","kind":"theorem","line":82,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/MathlibExt/CechSphereComparison.lean#L82-L82","signatureChunk":0},{"@id":"lean:QOU.CentralExtension.Cech.HemiComputesCech.mk","@type":"LeanDeclaration","name":"QOU.CentralExtension.Cech.HemiComputesCech.mk","kind":"ctor","line":80,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103