{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:PredictedSpectra.CategoricalNeutronExists","@type":"LeanModule","name":"PredictedSpectra.CategoricalNeutronExists","imports":["lean:module:Init","lean:module:Mathlib.Data.Real.Basic"],"declarations":7,"chunks":1},{"@id":"lean:QOU.CategoricalNeutron.exists","@type":"LeanDeclaration","name":"QOU.CategoricalNeutron.exists","kind":"theorem","line":34,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/categorical-neutron-exists.lean#L34-L44","doc":"**Existence of the categorical neutron.**\n\nB₃(u,d,d) + two-Hopf-link gluon stabiliser yields a\n`CategoricalNeutron` term with negative crossing energy. ","formalizes":[{"@id":"block:prop:categorical-neutron-exists","label":"prop:categorical-neutron-exists","md":"quantum-observable-universe/predicted-spectra/categorical-neutron-exists.md"}],"signatureChunk":0},{"@id":"lean:QOU.CategoricalNeutron.chirality","@type":"LeanDeclaration","name":"QOU.CategoricalNeutron.chirality","kind":"def","line":32,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/categorical-neutron-exists.lean#L32-L32","doc":"Zero crossing chirality (electric charge `0`). ","signatureChunk":0},{"@id":"lean:QOU.CategoricalNeutron.mass","@type":"LeanDeclaration","name":"QOU.CategoricalNeutron.mass","kind":"def","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/categorical-neutron-exists.lean#L30-L30","doc":"Mass `= 2·S_ud + S_dd`. ","signatureChunk":0},{"@id":"lean:QOU.CategoricalNeutron.skein_dd","@type":"LeanDeclaration","name":"QOU.CategoricalNeutron.skein_dd","kind":"def","line":28,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/categorical-neutron-exists.lean#L28-L28","doc":"Pair Skein mass `S_dd`. ","signatureChunk":0},{"@id":"lean:QOU.CategoricalNeutron.skein_ud","@type":"LeanDeclaration","name":"QOU.CategoricalNeutron.skein_ud","kind":"def","line":26,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/categorical-neutron-exists.lean#L26-L26","doc":"Pair Skein mass `S_ud`. ","signatureChunk":0},{"@id":"lean:QOU.CategoricalNeutron.mk","@type":"LeanDeclaration","name":"QOU.CategoricalNeutron.mk","kind":"ctor","line":24,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/categorical-neutron-exists.lean#L24-L24","signatureChunk":0},{"@id":"lean:QOU.CategoricalNeutron","@type":"LeanDeclaration","name":"QOU.CategoricalNeutron","kind":"structure","line":20,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/predicted-spectra/categorical-neutron-exists.lean#L20-L32","doc":"Defining data of the categorical neutron (mirror of\n[`def:categorical-neutron`], shared with `categorical-neutron-unique.lean`):\nthe colour-linked triple `[u, d, d]_c ⋈ L_H` is determined by its pair-Skein\nmasses `(S_ud, S_dd)`, with derived mass `2·S_ud + S_dd` and zero chirality. ","signatureChunk":0}]}