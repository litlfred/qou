{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.QuarkState.WeakVertexInverseLetter","@type":"LeanModule","name":"QOU.QuarkState.WeakVertexInverseLetter","imports":["lean:module:Init","lean:module:QOU.QuarkState.WeakVertexLeftProjector"],"declarations":4,"chunks":1},{"@id":"lean:QOU.QuarkState.WeakVertexInverseLetter.insertion_sign_difference","@type":"LeanDeclaration","name":"QOU.QuarkState.WeakVertexInverseLetter.insertion_sign_difference","kind":"theorem","line":87,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuarkState/WeakVertexInverseLetter.lean#L87-L95","doc":"The two insertions (positive and inverse letter) differ by `h • 1`. ","signatureChunk":0},{"@id":"lean:QOU.QuarkState.WeakVertexInverseLetter.inverse_insertion","@type":"LeanDeclaration","name":"QOU.QuarkState.WeakVertexInverseLetter.inverse_insertion","kind":"theorem","line":75,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuarkState/WeakVertexInverseLetter.lean#L75-L85","doc":"**The insertion on an inverse letter is `h` times the right line of the letter.** ","signatureChunk":0},{"@id":"lean:QOU.QuarkState.WeakVertexInverseLetter.weakVertex_inverse_letter","@type":"LeanDeclaration","name":"QOU.QuarkState.WeakVertexInverseLetter.weakVertex_inverse_letter","kind":"theorem","line":52,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuarkState/WeakVertexInverseLetter.lean#L52-L73","doc":"**The vertex does not depend on the sign of the letter.** ","signatureChunk":0},{"@id":"lean:QOU.QuarkState.WeakVertexInverseLetter.rightLine_mirror","@type":"LeanDeclaration","name":"QOU.QuarkState.WeakVertexInverseLetter.rightLine_mirror","kind":"theorem","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/QuarkState/WeakVertexInverseLetter.lean#L42-L50","doc":"The right line of `σ⁻¹` (at `q⁻¹`) is the left line of `σ`. ","signatureChunk":0}]}