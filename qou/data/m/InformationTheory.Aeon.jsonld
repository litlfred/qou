{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:InformationTheory.Aeon","@type":"LeanModule","name":"InformationTheory.Aeon","imports":["lean:module:Init","lean:module:Mathlib.Data.List.Basic","lean:module:Mathlib.Tactic.Basic"],"declarations":15,"chunks":1},{"@id":"lean:QOU.Aeon.adjacent","@type":"LeanDeclaration","name":"QOU.Aeon.adjacent","kind":"def","line":69,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/aeon.lean#L69-L72","doc":"Two aeons are adjacent if their boundaries share a common\njet horizon: ∂𝒜₁ ∩ ∂𝒜₂ ≠ ∅. ","signatureChunk":0},{"@id":"lean:QOU.Aeon.boundary","@type":"LeanDeclaration","name":"QOU.Aeon.boundary","kind":"def","line":67,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/aeon.lean#L67-L67","doc":"Boundary: jet horizons reachable as limits of directed\ndiagrams in the aeon. ","signatureChunk":0},{"@id":"lean:QOU.Aeon.connected","@type":"LeanDeclaration","name":"QOU.Aeon.connected","kind":"theorem","line":60,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/aeon.lean#L60-L60","doc":"Connectedness: any two configs are related by a chain of\nflow steps. ","signatureChunk":0},{"@id":"lean:QOU.Aeon.flow_symm","@type":"LeanDeclaration","name":"QOU.Aeon.flow_symm","kind":"theorem","line":57,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/aeon.lean#L57-L57","doc":"The flow relation is symmetric (reversible computation). ","signatureChunk":0},{"@id":"lean:QOU.Aeon.flow_step","@type":"LeanDeclaration","name":"QOU.Aeon.flow_step","kind":"def","line":55,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/aeon.lean#L55-L55","doc":"A relation witnessing that two configs are connected by a\nflow map (one Planck step) within Bun°. ","signatureChunk":0},{"@id":"lean:QOU.Aeon.observable","@type":"LeanDeclaration","name":"QOU.Aeon.observable","kind":"def","line":52,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/aeon.lean#L52-L52","doc":"Each configuration is observable. ","signatureChunk":0},{"@id":"lean:QOU.Aeon.configs","@type":"LeanDeclaration","name":"QOU.Aeon.configs","kind":"def","line":50,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/aeon.lean#L50-L50","doc":"The observable configurations in this aeon. ","signatureChunk":0},{"@id":"lean:QOU.Aeon.mk","@type":"LeanDeclaration","name":"QOU.Aeon.mk","kind":"ctor","line":48,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/aeon.lean#L48-L48","signatureChunk":0},{"@id":"lean:QOU.Aeon","@type":"LeanDeclaration","name":"QOU.Aeon","kind":"structure","line":43,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/aeon.lean#L43-L67","doc":"An aeon: a connected component of the observable subcategory\nBun°(P(V)).  Maximal collection of observable configurations\nconnected by flow maps without crossing a jet horizon. ","formalizes":[{"@id":"block:def:aeon","label":"def:aeon","md":"quantum-observable-universe/information-theory/aeon.md"}],"signatureChunk":0},{"@id":"lean:QOU.ObservableConfig.carrier","@type":"LeanDeclaration","name":"QOU.ObservableConfig.carrier","kind":"def","line":41,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/aeon.lean#L41-L41","doc":"Opaque carrier of the observable configuration. ","signatureChunk":0},{"@id":"lean:QOU.ObservableConfig.mk","@type":"LeanDeclaration","name":"QOU.ObservableConfig.mk","kind":"ctor","line":39,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/aeon.lean#L39-L39","signatureChunk":0},{"@id":"lean:QOU.ObservableConfig","@type":"LeanDeclaration","name":"QOU.ObservableConfig","kind":"structure","line":34,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/aeon.lean#L34-L41","doc":"Prerequisite type — the canonical declaration is\n`QOU.ObservableConfig` in `QOU/JetHorizon.lean`.  Re-declared\nhere as an opaque carrier for the same co-location reason as\n`JetHorizon` above. ","signatureChunk":0},{"@id":"lean:QOU.JetHorizon.carrier","@type":"LeanDeclaration","name":"QOU.JetHorizon.carrier","kind":"def","line":32,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/aeon.lean#L32-L32","doc":"Opaque carrier of the jet-horizon datum. ","signatureChunk":0},{"@id":"lean:QOU.JetHorizon.mk","@type":"LeanDeclaration","name":"QOU.JetHorizon.mk","kind":"ctor","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/aeon.lean#L30-L30","signatureChunk":0},{"@id":"lean:QOU.JetHorizon","@type":"LeanDeclaration","name":"QOU.JetHorizon","kind":"structure","line":23,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/information-theory/aeon.lean#L23-L32","doc":"Prerequisite type — the canonical declaration is `QOU.JetHorizon`\nin `folio/quantum-observable-universe/lean/QOU/JetHorizon.lean`\n(Lake-built under the `qou` package).  Re-declared here as an\nopaque carrier so this co-located content-block sibling is\nindependently checkable by `lean`-direct without importing the\nfull `qou` library cone. ","formalizes":[{"@id":"block:def:jet-horizon","label":"def:jet-horizon","md":"quantum-observable-universe/information-theory/jet-horizon.md"}],"signatureChunk":0}]}