{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:LiftingAndDescent.LocalizedKnot","@type":"LeanModule","name":"LiftingAndDescent.LocalizedKnot","imports":["lean:module:Init","lean:module:Mathlib.Algebra.Polynomial.Laurent","lean:module:Mathlib.Data.Int.Basic","lean:module:QOU.KnotTheory"],"declarations":23,"chunks":1},{"@id":"lean:QOU.LocalizedKnot.angularMomentum_nonneg","@type":"LeanDeclaration","name":"QOU.LocalizedKnot.angularMomentum_nonneg","kind":"theorem","line":146,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/localized-knot.lean#L146-L151","doc":"Angular momentum is non-negative. ","signatureChunk":0},{"@id":"lean:QOU.unknot_spin_zero","@type":"LeanDeclaration","name":"QOU.unknot_spin_zero","kind":"theorem","line":137,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/localized-knot.lean#L137-L144","doc":"The unknot (0 crossings) has spin 0 — a scalar. ","signatureChunk":0},{"@id":"lean:QOU.trefoil_spin_three_halves","@type":"LeanDeclaration","name":"QOU.trefoil_spin_three_halves","kind":"theorem","line":128,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/localized-knot.lean#L128-L135","doc":"The trefoil (3 crossings) has spin 3/2 — a fermion (baryon constituent). ","signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot.intrinsicAngularMomentum","@type":"LeanDeclaration","name":"QOU.LocalizedKnot.intrinsicAngularMomentum","kind":"def","line":119,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/localized-knot.lean#L119-L126","doc":"Intrinsic angular momentum of a localized knot, proportional to\ncrossing number: J = c(K) / 2 (in natural units).  Rational-valued\n(half-integer spin); the division and ordering below are the\narchimedean half-integer arithmetic, kept over `ℚ` rather than the\nLaurent ground ring `R_q`, which has no division. ","signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot.colocated_trans","@type":"LeanDeclaration","name":"QOU.LocalizedKnot.colocated_trans","kind":"theorem","line":107,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/localized-knot.lean#L107-L111","doc":"`colocated` is transitive. ","signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot.colocated_symm","@type":"LeanDeclaration","name":"QOU.LocalizedKnot.colocated_symm","kind":"theorem","line":102,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/localized-knot.lean#L102-L105","doc":"`colocated` is symmetric. ","signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot.colocated_refl","@type":"LeanDeclaration","name":"QOU.LocalizedKnot.colocated_refl","kind":"theorem","line":98,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/localized-knot.lean#L98-L100","doc":"`colocated` is reflexive. ","signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot.colocated","@type":"LeanDeclaration","name":"QOU.LocalizedKnot.colocated","kind":"def","line":94,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/localized-knot.lean#L94-L96","doc":"Two localized knots share the same base point on S². ","signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot.sameKnotType_trans","@type":"LeanDeclaration","name":"QOU.LocalizedKnot.sameKnotType_trans","kind":"theorem","line":83,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/localized-knot.lean#L83-L87","doc":"`sameKnotType` is transitive. ","signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot.sameKnotType_symm","@type":"LeanDeclaration","name":"QOU.LocalizedKnot.sameKnotType_symm","kind":"theorem","line":78,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/localized-knot.lean#L78-L81","doc":"`sameKnotType` is symmetric. ","signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot.sameKnotType_refl","@type":"LeanDeclaration","name":"QOU.LocalizedKnot.sameKnotType_refl","kind":"theorem","line":74,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/localized-knot.lean#L74-L76","doc":"`sameKnotType` is reflexive. ","signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot.sameKnotType","@type":"LeanDeclaration","name":"QOU.LocalizedKnot.sameKnotType","kind":"def","line":70,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/localized-knot.lean#L70-L72","doc":"Two localized knots carry the same knot type (same braid name). ","signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot.writhe","@type":"LeanDeclaration","name":"QOU.LocalizedKnot.writhe","kind":"def","line":60,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/localized-knot.lean#L60-L62","doc":"The writhe of a localized knot. ","signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot.crossingNumber","@type":"LeanDeclaration","name":"QOU.LocalizedKnot.crossingNumber","kind":"def","line":55,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/localized-knot.lean#L55-L58","doc":"The crossing number of a localized knot is the crossing count of\nits underlying braid word. ","signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot.basePoint","@type":"LeanDeclaration","name":"QOU.LocalizedKnot.basePoint","kind":"def","line":51,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/localized-knot.lean#L51-L53","doc":"The base point of a localized knot as a pair (θ, φ) on S². ","signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot.knot","@type":"LeanDeclaration","name":"QOU.LocalizedKnot.knot","kind":"def","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/localized-knot.lean#L42-L42","doc":"The knot type at this point (given by its braid word). ","signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot.phi","@type":"LeanDeclaration","name":"QOU.LocalizedKnot.phi","kind":"def","line":40,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/localized-knot.lean#L40-L40","doc":"Spherical coordinate φ ∈ [0, 2π) on CP¹ ≅ S². ","signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot.theta","@type":"LeanDeclaration","name":"QOU.LocalizedKnot.theta","kind":"def","line":38,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/localized-knot.lean#L38-L38","doc":"Spherical coordinate θ ∈ [0, π] on CP¹ ≅ S². ","signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot.mk","@type":"LeanDeclaration","name":"QOU.LocalizedKnot.mk","kind":"ctor","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/localized-knot.lean#L36-L36","signatureChunk":0},{"@id":"lean:QOU.LocalizedKnot","@type":"LeanDeclaration","name":"QOU.LocalizedKnot","kind":"structure","line":33,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/localized-knot.lean#L33-L42","doc":"A localized knot: a knot type placed at a point on the base manifold.\nThe point is represented abstractly as an element of the projective line\n(in the archimedean case, a point on CP¹ ≅ S²). ","formalizes":[{"@id":"block:def:localized-knot","label":"def:localized-knot","md":"quantum-observable-universe/lifting-and-descent/localized-knot.md"}],"signatureChunk":0},{"@id":"lean:QOU.q_inv_param","@type":"LeanDeclaration","name":"QOU.q_inv_param","kind":"def","line":31,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/localized-knot.lean#L31-L31","signatureChunk":0},{"@id":"lean:QOU.q_param","@type":"LeanDeclaration","name":"QOU.q_param","kind":"def","line":30,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/localized-knot.lean#L30-L30","signatureChunk":0},{"@id":"lean:QOU.R_q","@type":"LeanDeclaration","name":"QOU.R_q","kind":"def","line":29,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lifting-and-descent/localized-knot.lean#L29-L29","signatureChunk":0}]}