,"signatureChunk":0},{"@id":"lean:QOU.HookSumIdentity.hookSumId_hook_3_1","@type":"LeanDeclaration","name":"QOU.HookSumIdentity.hookSumId_hook_3_1","kind":"theorem","line":67,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Common/HookSumIdentity.lean#L67-L67","signatureChunk":0},{"@id":"lean:QOU.HookSumIdentity.hookSumId_hook_2_1","@type":"LeanDeclaration","name":"QOU.HookSumIdentity.hookSumId_hook_2_1","kind":"theorem","line":66,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Common/HookSumIdentity.lean#L66-L66","signatureChunk":0},{"@id":"lean:QOU.HookSumIdentity.hookShape","@type":"LeanDeclaration","name":"QOU.HookSumIdentity.hookShape","kind":"def","line":61,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Common/HookSumIdentity.lean#L61-L62","doc":"The hook shape `(a, 1^b)` = one row of length `a` on top of `b` unit rows. ","signatureChunk":0},{"@id":"lean:QOU.HookSumIdentity.staircase","@type":"LeanDeclaration","name":"QOU.HookSumIdentity.staircase","kind":"def","line":56,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Common/HookSumIdentity.lean#L56-L59","doc":"The staircase `(k, k−1, …, 1)` as a row-length list. ","signatureChunk":0},{"@id":"lean:QOU.HookSumIdentity.HookSumId","@type":"LeanDeclaration","name":"QOU.HookSumIdentity.HookSumId","kind":"def","line":50,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Common/HookSumIdentity.lean#L50-L54","doc":"The identity to be discharged for each concrete shape:\n`Σ h(c) = b(λ) + b(λ') + n`. `abbrev` (reducible) so `decide` sees the underlying\n`ℕ` equality and its `DecidableEq` instance. ","signatureChunk":0},{"@id":"lean:QOU.HookSumIdentity.hookSum","@type":"LeanDeclaration","name":"QOU.HookSumIdentity.hookSum","kind":"def","line":43,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Common/HookSumIdentity.lean#L43-L48","doc":"Sum of all hook lengths of `λ`. Cell `(i, j)` (`i < λ.length`, `j < λ_i`) has\nhook `arm + leg + 1 = (λ_i − 1 − j) + (λ'_j − 1 − i) + 1`. ","signatureChunk":0},{"@id":"lean:QOU.HookSumIdentity.conj","@type":"LeanDeclaration","name":"QOU.HookSumIdentity.conj","kind":"def","line":40,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Common/HookSumIdentity.lean#L40-L41","doc":"The conjugate partition `λ'` as its list of column lengths. ","signatureChunk":0},{"@id":"lean:QOU.HookSumIdentity.colLen","@type":"LeanDeclaration","name":"QOU.HookSumIdentity.colLen","kind":"def","line":37,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Common/HookSumIdentity.lean#L37-L38","doc":"Length of the `j`-th column: `#{ i : λ_i > j }`. ","signatureChunk":0},{"@id":"lean:QOU.HookSumIdentity.bStat","@type":"LeanDeclaration","name":"QOU.HookSumIdentity.bStat","kind":"def","line":33,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/Common/HookSumIdentity.lean#L33-L35","doc":"`b(λ) = Σ_i i·λ_i` (0-indexed rows) — the partition statistic `n(λ)`. ","signatureChunk":0}]}