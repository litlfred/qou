{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.SchurWeyl.HookLengthAddCell","@type":"LeanModule","name":"QOU.SchurWeyl.HookLengthAddCell","imports":["lean:module:Init","lean:module:QOU.SchurWeyl.OcneanuWeight","lean:module:QOU.Mathlib.YoungDiagramAddCell"],"declarations":5,"chunks":1},{"@id":"lean:QOU.SchurWeyl.hookLength_addCell_of_mem","@type":"LeanDeclaration","name":"QOU.SchurWeyl.hookLength_addCell_of_mem","kind":"theorem","line":101,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/HookLengthAddCell.lean#L101-L143","doc":"**Hook lengths under `addCell`.**  A cell of `ν` gains exactly one on its hook when the new\ncell shares its row or its column, and nothing otherwise. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.colLen_of_isAddableCell","@type":"LeanDeclaration","name":"QOU.SchurWeyl.colLen_of_isAddableCell","kind":"theorem","line":87,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/HookLengthAddCell.lean#L87-L99","doc":"An addable cell sits exactly at the bottom of its column. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.rowLen_of_isAddableCell","@type":"LeanDeclaration","name":"QOU.SchurWeyl.rowLen_of_isAddableCell","kind":"theorem","line":73,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/HookLengthAddCell.lean#L73-L85","doc":"An addable cell sits exactly at the end of its row. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.hookLength_addCell_self","@type":"LeanDeclaration","name":"QOU.SchurWeyl.hookLength_addCell_self","kind":"theorem","line":55,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/HookLengthAddCell.lean#L55-L71","doc":"**The added cell's own hook is 1.**  It is the last cell of its row and of its column. ","signatureChunk":0},{"@id":"lean:QOU.SchurWeyl.not_mem_of_isAddableCell_le","@type":"LeanDeclaration","name":"QOU.SchurWeyl.not_mem_of_isAddableCell_le","kind":"theorem","line":50,"sourceLink":"https://github.com/litlfred/qou/blob/7341d18daa5d103cc9fa41bebdf054eda96ad3d7/folio/quantum-observable-universe/lean/QOU/SchurWeyl/HookLengthAddCell.lean#L50-L53","doc":"No cell of `ν` lies weakly below-right of an addable cell — it would drag `s` into `ν`. ","signatureChunk":0}]}