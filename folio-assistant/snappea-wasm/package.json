{
  "name": "@snappea/kernel",
  "version": "0.1.0",
  "description": "SnapPea hyperbolic 3-manifold kernel compiled to WebAssembly. Computation only — no UI.",
  "license": "GPL-2.0-or-later",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build:gmp": "bash scripts/build-gmp.sh",
    "build:pari": "bash scripts/build-pari.sh",
    "build:snappea": "bash scripts/build-snappea.sh",
    "build:link": "bash scripts/link.sh",
    "build:deps": "npm run build:gmp && npm run build:pari",
    "build:wasm": "npm run build:snappea && npm run build:link",
    "build": "npm run build:deps && npm run build:wasm && npm run build:dist",
    "build:dist": "cp src/index.js dist/ && cp src/index.d.ts dist/",
    "test": "npx vitest run",
    "test:watch": "npx vitest",
    "lint": "echo 'TODO: eslint + prettier'"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  },
  "keywords": [
    "topology",
    "3-manifold",
    "hyperbolic",
    "knot-theory",
    "snappea",
    "webassembly",
    "wasm",
    "mathematics"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/litlfred/qou",
    "directory": "snappea-wasm"
  }
}
