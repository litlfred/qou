for (j = conv+1; j <= aa; j++)
{
    number cc; number dd;
    if (ord_d[conv]==1 && ord_d[j]==1) { cc=1; dd=0; }
    else { if (ord_d[conv]==0 && ord_d[j]==0) { cc=1; dd=-han; }
           else { cc=1; dd=-han/2; } }
    number na = ad*cc*han + ad*dd + bd*cc;
