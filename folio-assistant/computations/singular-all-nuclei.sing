int aa = 60;

// Just compute e(I)/e(R) at converting gen (skip full trace for speed)
int conv = 0;
for (k = 1; k <= aa; k++) { if (ord[k]==0 && ord_d[k]==1) { conv=k; break; } }
"Converting at: " + string(conv);

number ap = 0; number bp = 1;
for (j = conv+1; j <= aa; j++)
{
    number cc; number dd;
    if (ord[conv]==1 && ord[j]==1) { cc=1; dd=0; }
