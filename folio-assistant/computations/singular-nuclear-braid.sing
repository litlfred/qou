// Nuclear braid Gröbner reduction in Singular (letterplace).
//
// Run: Singular folio-assistant/computations/singular-nuclear-braid.sing
//
// Letterplace variable convention for ngens=2, degbound=3:
//   var(1)=x(1)@pos1, var(2)=x(2)@pos1,
//   var(3)=x(1)@pos2, var(4)=x(2)@pos2,
//   var(5)=x(1)@pos3, var(6)=x(2)@pos3
// General: var((j-1)*ngens + i) = x(i) at position j

LIB "freegb.lib";

// ── Configuration ───────────────────────────────────────────────
int AA = 3;           // mass number (start with tritium)
int ngens = AA - 1;   // number of Hecke generators
int degbd = AA;       // max word length in normal form

// ── Create rings ────────────────────────────────────────────────
ring r0 = (0,q), (x(1..ngens)), dp;
def R = makeLetterplaceRing(degbd);
setring R;

"Letterplace ring:"; R;

// ── Hecke ideal ─────────────────────────────────────────────────
poly ha = q - 1/q;  // q - q^{-1}

ideal I;
int idx = 0;
int ii;

// Hecke: x(i)^2 = (q-q^{-1})x(i) + 1
// var((0)*ngens+i) * var((1)*ngens+i) = ha * var((0)*ngens+i) + 1
for (ii = 1; ii <= ngens; ii++)
{
    idx++;
    I[idx] = var(ii) * var(ngens + ii) - ha * var(ii) - 1;
}

// Yang-Baxter: x(i)*x(i+1)*x(i) = x(i+1)*x(i)*x(i+1)
for (ii = 1; ii <= ngens - 1; ii++)
{
    idx++;
    I[idx] = var(ii) * var(ngens + ii + 1) * var(2*ngens + ii)
           - var(ii + 1) * var(ngens + ii) * var(2*ngens + ii + 1);
}

// Far commutativity (none for ngens=2, |i-j| >= 2 impossible)
int jj;
for (ii = 1; ii <= ngens; ii++)
{
    for (jj = ii + 2; jj <= ngens; jj++)
    {
        idx++;
        I[idx] = var(ii) * var(ngens + jj) - var(jj) * var(ngens + ii);
    }
}

"Relations:"; idx;
"Ideal:"; I;

// ── Gröbner basis ───────────────────────────────────────────────
"Computing two-sided Gröbner basis...";
ideal G = twostd(I);
"Gröbner basis:"; G;

// ── Inverse in Hecke algebra ────────────────────────────────────
// From T^2 = (q-q^{-1})T + 1:
//   T * (T - (q-q^{-1})) = 1
//   T^{-1} = T - (q - q^{-1})

// ── Build N(1,2) = tritium ──────────────────────────────────────
// Block ordering: [p, n, n]
// Crossing (1,2): p-n mixed at generator x(1)
//   = x(1) - ha/2  [= (T + T^{-1})/2 = T - ha/2]
// Crossing (1,3): p-n mixed at generator x(1)
//   = x(1) - ha/2
// Crossing (2,3): n-n at generator x(2)
//   = x(2) - ha  [= T^{-1} = T - ha]

"";
"=== N(1,2) = tritium [p, n, n] ===";

// Build step by step using lpMult for proper non-comm multiplication.
// lpMult(f, g) multiplies in the letterplace ring with position shifting.

// Crossing 1: mixed at x(1)
poly c1 = var(1) - ha/2;
"Crossing 1 (p-n at x1):"; c1;

// Crossing 2: mixed at x(1) — multiply c1 * (x(1) - ha/2)
// Use lpMult for correct letterplace multiplication
poly c2_factor = var(1) - ha/2;
poly braid12 = lpMult(c1, c2_factor);
"After crossing 2 (raw):"; braid12;

// Reduce
braid12 = reduce(braid12, G);
"After crossing 2 (reduced):"; braid12;

// Crossing 3: n-n at x(2) — multiply by (x(2) - ha)
poly c3_factor = var(2) - ha;
poly braid123 = lpMult(braid12, c3_factor);
"After crossing 3 (raw):"; braid123;

// Reduce
braid123 = reduce(braid123, G);
"N(1,2) REDUCED:"; braid123;

// ── Build N(2,1) = 3He (daughter) ───────────────────────────────
// Block ordering: [p, p, n]
// Crossing (1,2): p-p positive at x(1) = x(1)
// Crossing (1,3): p-n mixed at x(1) = x(1) - ha/2
// Crossing (2,3): p-n mixed at x(2) = x(2) - ha/2

"";
"=== N(2,1) = 3He [p, p, n] ===";

poly d1 = var(1);  // p-p
poly d12 = lpMult(d1, var(1) - ha/2);  // * mixed
d12 = reduce(d12, G);
"After 2 crossings (reduced):"; d12;

poly d123 = lpMult(d12, var(2) - ha/2);  // * mixed at x(2)
d123 = reduce(d123, G);
"N(2,1) REDUCED:"; d123;

// ── Difference ──────────────────────────────────────────────────
"";
"=== DIFFERENCE N(1,2) - N(2,1) ===";
poly delta = braid123 - d123;
"Delta:"; delta;

// ── Evaluate at q = 11/10 ───────────────────────────────────────
"";
"=== NUMERICAL EVALUATION at q = 11/10 ===";
map ev = R, 11/10;
"N(1,2) at q=1.1:"; ev(braid123);
"N(2,1) at q=1.1:"; ev(d123);
"Delta at q=1.1:"; ev(delta);

// ── Markov trace ────────────────────────────────────────────────
// For the reduced form f = a1*x(1) + a2*x(2) + a12*x(1)*x(2) + ... + c
// The Markov trace is computed by:
//   tr(x(i)) = z (Markov parameter)
//   tr(x(i)*x(j)) = z^2 if i >= j (after cyclic permutation)
//   tr(1) = 1
// where z = 1/(q^{1/2} + q^{-1/2})
//
// For A=3: z ≈ 0.4993 at q=1.110
// The trace of the reduced form gives the Jones polynomial
// of the nuclear link.

"";
"=== The reduced forms above are the Gröbner normal forms ===";
"The Markov trace extracts the link invariant from these.";
"For A=3: the reduced form should be a linear combination of";
"  1, x(1), x(2), x(1)*x(2), x(2)*x(1)";
"and the Markov trace maps each to a power of z.";

exit;
