  | ⟨19, _⟩ => (q ^ 4 + q ^ 2 + 1 + (q ^ 2)⁻¹ + (q ^ 4)⁻¹) * (q ^ 6 + q ^ 2 + (q ^ 2)⁻¹ + (q ^ 6)⁻¹)
  | ⟨20, _⟩ => (q ^ 6 + q ^ 4 + q ^ 2 + 1 + (q ^ 2)⁻¹ + (q ^ 4)⁻¹ + (q ^ 6)⁻¹)
  | ⟨21, _⟩ => 1
  | ⟨_+22, h⟩ => absurd h (by omega)

