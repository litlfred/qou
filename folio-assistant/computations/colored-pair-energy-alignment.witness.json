{
  "name": "colored-pair-energy-alignment",
  "description": "Energy alignment analysis for colored photon pair production \u03b3\u2081\u00b7\u03b3\u2082 \u2192 e\u207be\u207a. Photons \u03b3 = \ud835\udfd9 + \u03c6\u2080\u03c3\u2080 + \u03c6\u2081\u03c3\u2081 with independent formal color weights. Checks whether energy budget \u0394(pair)\u00d7E\u2080 = 2m\u2091 is achievable.",
  "symbolic_q_form": {
    "engine": "sympy",
    "q_symbol": "q (sp.Symbol('q', positive=True))",
    "h_symbol_definition": "h = q - 1/q  (HA = [2]_q in Kashiwara normalisation)",
    "color_parametrization": "symmetric one-parameter family \u03c6\u2080 = \u03c6\u2081 = \u03c8\u2080 = \u03c8\u2081 = t (smallest non-trivial colored case)",
    "nf_coefficients_polynomial_q": {
      "c_identity": "2*t**2 + 1",
      "c_sigma0": "t*(2*q + t*(q**2 - 1))/q",
      "c_sigma1": "t*(2*q + t*(q**2 - 1))/q",
      "C_plus": "t**2",
      "C_minus": "t**2",
      "net": "(q*(4*t**2 + 4*t + 1) + 2*t**2*(q**2 - 1))/q"
    },
    "nf_coefficients_general_symbolic": {
      "c_identity": "1 + \u03c6\u2080\u03c8\u2080 + \u03c6\u2081\u03c8\u2081",
      "c_sigma0": "\u03c6\u2080 + \u03c8\u2080 + \u03c6\u2080\u03c8\u2080\u00b7h",
      "c_sigma1": "\u03c6\u2081 + \u03c8\u2081 + \u03c6\u2081\u03c8\u2081\u00b7h",
      "C_plus": "\u03c6\u2080\u00b7\u03c8\u2081",
      "C_minus": "\u03c6\u2081\u00b7\u03c8\u2080",
      "net": "(1 + \u03c6\u2080 + \u03c6\u2081)(1 + \u03c8\u2080 + \u03c8\u2081) + (\u03c6\u2080\u03c8\u2080 + \u03c6\u2081\u03c8\u2081)\u00b7h"
    },
    "note": "NF(\u03b3\u2081\u00b7\u03b3\u2082) coefficients in the symmetric symbolic family, expressed as Laurent polynomials in q \u2208 \u211a(q).  The specialisation h \u21a6 q\u2080 - 1/q\u2080 recovers the numerical HA used in the energy budget; this section exposes the algebraic form that lives upstream of the q = q\u2080 specialisation."
  },
