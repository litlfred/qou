{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/"}],"@id":"papers/quantum-observable-universe/blocks/tbl-chain-ring-comparison-table2-data","@type":["folio-assistant-core:Table","doco:Table"],"label":"tbl:chain-ring-comparison-table2-data","kind":"table","title":"Table 2 from prop:chain-ring-comparison","uses":["papers/quantum-observable-universe/blocks/prop-chain-ring-comparison"],"tags":["extracted-table"],"text":"chain-ring-comparison-table2-data.md","provenance":"authored","html":"<a id=\"tbl:chain-ring-comparison-table2-data\"></a><p><em>QOU threading predictions for the <code class=\"language-math math-inline\">T(2,6)</code> ring, compared against experiment across six observables.</em></p>\n<table>\n<thead>\n<tr>\n<th>Prediction</th>\n<th align=\"right\">QOU (threading)</th>\n<th align=\"right\">Experiment</th>\n<th align=\"center\">Match</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Ring-closure barrier</td>\n<td align=\"right\">193–386 kJ/mol</td>\n<td align=\"right\">200–400 kJ/mol</td>\n<td align=\"center\">yes</td>\n</tr>\n<tr>\n<td>Barrier origin</td>\n<td align=\"right\">topological (Alexander weight)</td>\n<td align=\"right\">kinetic</td>\n<td align=\"center\">yes</td>\n</tr>\n<tr>\n<td>Ring super-stability</td>\n<td align=\"right\">threading lock</td>\n<td align=\"right\">observed</td>\n<td align=\"center\">yes</td>\n</tr>\n<tr>\n<td>Bond order equalisation</td>\n<td align=\"right\">automatic (<code class=\"language-math math-inline\">T(2,6)</code> symmetry)</td>\n<td align=\"right\">equal C–C bonds</td>\n<td align=\"center\">yes</td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">\\pi</code> electrons = 2</td>\n<td align=\"right\"><code class=\"language-math math-inline\">\\gcd(2,6) = 2</code> components</td>\n<td align=\"right\">2 delocalised <code class=\"language-math math-inline\">\\pi</code> <code class=\"language-math math-inline\">e^-</code></td>\n<td align=\"center\">yes</td>\n</tr>\n<tr>\n<td>Resonance energy</td>\n<td align=\"right\"><code class=\"language-math math-inline\">\\propto 6 - \\Delta_{T(2,6)} \\approx 3</code> units</td>\n<td align=\"right\">150 kJ/mol</td>\n<td align=\"center\">yes (order)</td>\n</tr>\n</tbody>\n</table>\n","source":"folio/quantum-observable-universe/organic-chemistry/chain-ring-comparison-table2-data.md","heading":"Table"}
