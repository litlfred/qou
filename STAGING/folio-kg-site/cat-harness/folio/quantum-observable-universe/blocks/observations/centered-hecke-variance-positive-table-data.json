{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/"}],"@id":"papers/quantum-observable-universe/blocks/tbl-centered-hecke-variance-positive-table-data","@type":["folio-assistant-core:Table","doco:Table"],"label":"tbl:centered-hecke-variance-positive-table-data","kind":"table","title":"Centred Hecke variance numerical verification at $q_0$","uses":["papers/quantum-observable-universe/blocks/prop-centered-hecke-variance-positive"],"tags":["hecke-variance","numerical-verification"],"text":"centered-hecke-variance-positive-table-data.md","provenance":"authored","html":"<a id=\"tbl:centered-hecke-variance-positive-table-data\"></a><table>\n<thead>\n<tr>\n<th>Quantity</th>\n<th>Value</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code class=\"language-math math-inline\">q_0^2</code></td>\n<td><code class=\"language-math math-inline\">\\approx 1.2320525</code></td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">z = q^3/(q^2+1)</code> (convention D)</td>\n<td><code class=\"language-math math-inline\">\\approx 0.6126880</code></td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">z^2</code></td>\n<td><code class=\"language-math math-inline\">\\approx 0.3753866</code></td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">q_0 - q_0^{-1}</code></td>\n<td><code class=\"language-math math-inline\">\\approx 0.2090603</code></td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">(q - q^{-1}) z</code></td>\n<td><code class=\"language-math math-inline\">\\approx 0.1280887</code></td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">\\mathrm{Var}(\\sigma_i) = (q-q^{-1})z + 1 - z^2 = \\dfrac{q^4+q^2+1}{(q^2+1)^2}</code></td>\n<td><code class=\"language-math math-inline\">\\approx 0.7527021</code></td>\n</tr>\n<tr>\n<td>lower bound <code class=\"language-math math-inline\">\\min_{q>0} \\mathrm{Var}(\\sigma_i)</code>, attained at <code class=\"language-math math-inline\">q = 1</code></td>\n<td><code class=\"language-math math-inline\">3/4</code> exactly</td>\n</tr>\n</tbody>\n</table>\n","source":"folio/quantum-observable-universe/observations/centered-hecke-variance-positive-table-data.md","heading":"Table"}
