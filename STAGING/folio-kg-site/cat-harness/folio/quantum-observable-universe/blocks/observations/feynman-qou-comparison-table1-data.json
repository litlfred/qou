{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/"}],"@id":"papers/quantum-observable-universe/blocks/tbl-feynman-qou-comparison-table1-data","@type":["folio-assistant-core:Table","doco:Table"],"label":"tbl:feynman-qou-comparison-table1-data","kind":"table","title":"Table 1 from rem:feynman-qou-comparison","uses":["papers/quantum-observable-universe/blocks/rem-feynman-qou-comparison"],"tags":["extracted-table"],"text":"feynman-qou-comparison-table1-data.md","provenance":"authored","html":"<p><a id=\"tbl:feynman-qou-comparison-table1-data\"></a>\n<strong>Table.</strong> <em>Table 1 from rem:feynman-qou-comparison</em></p>\n<table>\n<thead>\n<tr>\n<th align=\"left\">SEMF term</th>\n<th align=\"left\">Formula</th>\n<th align=\"left\">Scaling</th>\n<th align=\"left\">QOU channel</th>\n<th align=\"left\">Formula</th>\n<th align=\"left\">Scaling</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"left\">Volume</td>\n<td align=\"left\"><code class=\"language-math math-inline\">a_V A</code></td>\n<td align=\"left\"><code class=\"language-math math-inline\">\\propto A</code></td>\n<td align=\"left\"><code class=\"language-math math-inline\">\\Phi_1</code> (trace)</td>\n<td align=\"left\"><code class=\"language-math math-inline\">\\sum \\ln\\lvert\\hat{V}_i\\rvert</code></td>\n<td align=\"left\"><code class=\"language-math math-inline\">\\sim A</code> for small <code class=\"language-math math-inline\">A</code></td>\n</tr>\n<tr>\n<td align=\"left\">Surface</td>\n<td align=\"left\"><code class=\"language-math math-inline\">-a_S A^{2/3}</code></td>\n<td align=\"left\"><code class=\"language-math math-inline\">\\propto A^{2/3}</code></td>\n<td align=\"left\">(in <code class=\"language-math math-inline\">\\Phi_1</code>)</td>\n<td align=\"left\">Chain boundary</td>\n<td align=\"left\">Implicit</td>\n</tr>\n<tr>\n<td align=\"left\">Coulomb</td>\n<td align=\"left\"><code class=\"language-math math-inline\">-a_C Z(Z{-}1)/A^{1/3}</code></td>\n<td align=\"left\"><code class=\"language-math math-inline\">\\propto Z^2/A^{1/3}</code></td>\n<td align=\"left\"><code class=\"language-math math-inline\">\\Phi_2</code> (det)</td>\n<td align=\"left\"><code class=\"language-math math-inline\">\\sum \\ln\\lvert\\det M_i\\rvert</code></td>\n<td align=\"left\">pp det <code class=\"language-math math-inline\">= -q</code></td>\n</tr>\n<tr>\n<td align=\"left\">Asymmetry</td>\n<td align=\"left\"><code class=\"language-math math-inline\">-a_A (N{-}Z)^2/(4A)</code></td>\n<td align=\"left\"><code class=\"language-math math-inline\">\\propto (N{-}Z)^2/A</code></td>\n<td align=\"left\"><code class=\"language-math math-inline\">\\Phi_2 + \\Phi_3</code></td>\n<td align=\"left\">nn/pp imbalance</td>\n<td align=\"left\">Ordering-dependent</td>\n</tr>\n<tr>\n<td align=\"left\">Pairing</td>\n<td align=\"left\"><code class=\"language-math math-inline\">\\pm\\delta/\\sqrt{A}</code></td>\n<td align=\"left\"><code class=\"language-math math-inline\">\\propto 1/\\sqrt{A}</code></td>\n<td align=\"left\"><code class=\"language-math math-inline\">\\Phi_3</code> (ratio)</td>\n<td align=\"left\"><code class=\"language-math math-inline\">\\ln\\lvert\\lambda^{\\mathrm{sym}}/\\lambda^{\\mathrm{alt}}\\rvert</code></td>\n<td align=\"left\"><code class=\"language-math math-inline\">Z\\!\\!\\mod 2</code>, <code class=\"language-math math-inline\">N\\!\\!\\mod 2</code></td>\n</tr>\n</tbody>\n</table>\n"}
