{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/"}],"@id":"papers/quantum-observable-universe/blocks/tbl-frobenius-s-classification-table2-data","@type":["folio-assistant-core:Table","doco:Table"],"label":"tbl:frobenius-s-classification-table2-data","kind":"table","title":"Table 2 from prop:frobenius-s-classification","uses":["papers/quantum-observable-universe/blocks/prop-frobenius-s-classification"],"tags":["extracted-table"],"text":"frobenius-s-classification-table2-data.md","provenance":"authored","html":"<a id=\"tbl:frobenius-s-classification-table2-data\"></a><table>\n<thead>\n<tr>\n<th align=\"center\">Symbol</th>\n<th align=\"center\">Definition</th>\n<th align=\"center\"><code class=\"language-math math-inline\">S</code>-eigenvalue</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"center\"><code class=\"language-math math-inline\">W_{\\mathrm{sym}} = W_{\\mathrm{alt}} = q^2/D</code></td>\n<td align=\"center\">Wedderburn weight</td>\n<td align=\"center\"><code class=\"language-math math-inline\">+1</code></td>\n</tr>\n<tr>\n<td align=\"center\"><code class=\"language-math math-inline\">W_{\\mathrm{std}} = (q^2{+}1)^2/D</code></td>\n<td align=\"center\">Wedderburn weight</td>\n<td align=\"center\"><code class=\"language-math math-inline\">+1</code></td>\n</tr>\n<tr>\n<td align=\"center\"><code class=\"language-math math-inline\">D = q^4 + 4q^2 + 1</code></td>\n<td align=\"center\">denominator (palindromic in <code class=\"language-math math-inline\">q^2</code>)</td>\n<td align=\"center\"><code class=\"language-math math-inline\">+1</code></td>\n</tr>\n<tr>\n<td align=\"center\"><code class=\"language-math math-inline\">[3]_q = q^2 + 1 + q^{-2}</code></td>\n<td align=\"center\">quantum 3-integer</td>\n<td align=\"center\"><code class=\"language-math math-inline\">+1</code></td>\n</tr>\n<tr>\n<td align=\"center\"><code class=\"language-math math-inline\">h_{\\mathrm{A}} = q - q^{-1}</code></td>\n<td align=\"center\">Hecke parameter</td>\n<td align=\"center\"><code class=\"language-math math-inline\">-1</code></td>\n</tr>\n<tr>\n<td align=\"center\"><code class=\"language-math math-inline\">h_{\\mathrm{A}}^2</code></td>\n<td align=\"center\">even power</td>\n<td align=\"center\"><code class=\"language-math math-inline\">+1</code></td>\n</tr>\n<tr>\n<td align=\"center\"><code class=\"language-math math-inline\">z = (q^{1/2} + q^{-1/2})^{-1}</code></td>\n<td align=\"center\">std normalisation</td>\n<td align=\"center\"><code class=\"language-math math-inline\">+1</code></td>\n</tr>\n<tr>\n<td align=\"center\"><code class=\"language-math math-inline\">G</code>, <code class=\"language-math math-inline\">\\mathrm{Vol}(\\mathcal{B}_3) = 8G</code>, <code class=\"language-math math-inline\">m_e</code>, <code class=\"language-math math-inline\">\\alpha = m_e \\cdot 8G</code></td>\n<td align=\"center\">scalars and volumes</td>\n<td align=\"center\"><code class=\"language-math math-inline\">+1</code></td>\n</tr>\n</tbody>\n</table>\n","source":"folio/quantum-observable-universe/mass-theory/frobenius-s-classification-table2-data.md","heading":"Table"}
