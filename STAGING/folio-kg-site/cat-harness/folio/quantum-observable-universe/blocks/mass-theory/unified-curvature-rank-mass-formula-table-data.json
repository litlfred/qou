{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/"}],"@id":"papers/quantum-observable-universe/blocks/tbl-unified-curvature-rank-mass-formula-table-data","@type":["folio-assistant-core:Table","doco:Table"],"label":"tbl:unified-curvature-rank-mass-formula-table-data","kind":"table","title":"Data table from prop:unified-curvature-rank-mass-formula","uses":["papers/quantum-observable-universe/blocks/prop-unified-curvature-rank-mass-formula"],"tags":["extracted-table"],"text":"unified-curvature-rank-mass-formula-table-data.md","provenance":"authored","html":"<p><a id=\"tbl:unified-curvature-rank-mass-formula-table-data\"></a>\n<strong>Table.</strong> <em>Data table from prop:unified-curvature-rank-mass-formula</em></p>\n<table>\n<thead>\n<tr>\n<th align=\"center\">Stratum</th>\n<th>Legacy name</th>\n<th>Identification</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"center\"><code class=\"language-math math-inline\">k = 0</code></td>\n<td>Term 1</td>\n<td>descended Frobenius integral <code class=\"language-math math-inline\">\\bigl\\lvert\\!\\int_A \\rho(\\beta_\\mathcal{K})\\bigr\\rvert</code></td>\n</tr>\n<tr>\n<td align=\"center\"><code class=\"language-math math-inline\">k = 1</code></td>\n<td>Term 2</td>\n<td>single-row hook strata</td>\n</tr>\n<tr>\n<td align=\"center\"><code class=\"language-math math-inline\">k = 2</code></td>\n<td>Term 3</td>\n<td>double-row hook strata</td>\n</tr>\n<tr>\n<td align=\"center\">all <code class=\"language-math math-inline\">k</code></td>\n<td>Term 4</td>\n<td>universal Frobenius co-Casimir, <code class=\"language-math math-inline\">\\sum_\\lambda w_\\lambda(1) = 1</code> (classical Plancherel)</td>\n</tr>\n<tr>\n<td align=\"center\"><code class=\"language-math math-inline\">k \\geq 2</code></td>\n<td>Term 5</td>\n<td>chirality projection (S-anti-invariant)</td>\n</tr>\n<tr>\n<td align=\"center\"><code class=\"language-math math-inline\">k = 3</code></td>\n<td>Term 6</td>\n<td><code class=\"language-math math-inline\">\\mathfrak{m}^{(3)}</code> (chirality knots, e.g. <code class=\"language-math math-inline\">6_1</code>)</td>\n</tr>\n<tr>\n<td align=\"center\"><code class=\"language-math math-inline\">k \\geq 4</code></td>\n<td>Term 7</td>\n<td><code class=\"language-math math-inline\">\\mathfrak{m}^{\\geq 4}</code> (<a href=\"#prop:plancherel-term-7-formulation\">universal residue</a>)</td>\n</tr>\n</tbody>\n</table>\n"}
