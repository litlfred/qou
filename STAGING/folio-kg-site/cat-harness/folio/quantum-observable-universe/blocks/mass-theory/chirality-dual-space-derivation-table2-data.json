{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/"}],"@id":"papers/quantum-observable-universe/blocks/tbl-chirality-dual-space-derivation-table2-data","@type":["folio-assistant-core:Table","doco:Table"],"label":"tbl:chirality-dual-space-derivation-table2-data","kind":"table","title":"Table 2 from prop:chirality-dual-space-derivation","uses":["papers/quantum-observable-universe/blocks/prop-chirality-dual-space-derivation"],"tags":["extracted-table"],"text":"chirality-dual-space-derivation-table2-data.md","provenance":"authored","html":"<p><a id=\"tbl:chirality-dual-space-derivation-table2-data\"></a>\n<strong>Table.</strong> <em>Table 2 from prop:chirality-dual-space-derivation</em></p>\n<table>\n<thead>\n<tr>\n<th>isotope</th>\n<th>pn crossing pattern</th>\n<th><code class=\"language-math math-inline\">a_K</code> derivation</th>\n<th>result</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>D</td>\n<td><code class=\"language-math math-inline\">1</code> positive</td>\n<td><code class=\"language-math math-inline\">(1 + h)^1</code></td>\n<td><code class=\"language-math math-inline\">1 + h \\approx 1.209</code> (best)</td>\n</tr>\n<tr>\n<td>T, <code class=\"language-math math-inline\">^3</code>He</td>\n<td><code class=\"language-math math-inline\">1+, 1-</code> (amphichiral)</td>\n<td><code class=\"language-math math-inline\">(1+h)(1-h)</code></td>\n<td><code class=\"language-math math-inline\">1 - h^2 \\approx 0.956</code> (best)</td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">^4</code>He</td>\n<td><code class=\"language-math math-inline\">2+, 2-</code> (Borromean<code class=\"language-math math-inline\">{}^2</code>)</td>\n<td><code class=\"language-math math-inline\">(1+h)^2(1-h)^2</code></td>\n<td><code class=\"language-math math-inline\">(1 - h^2)^2 \\approx 0.914</code> (best)</td>\n</tr>\n</tbody>\n</table>\n"}
