{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/"}],"@id":"papers/quantum-observable-universe/blocks/tbl-cyclotomic-trilog-imaginary-closed-form-table-data","@type":["folio-assistant-core:Table","doco:Table"],"label":"tbl:cyclotomic-trilog-imaginary-closed-form-table-data","kind":"table","title":"Data table from prop:cyclotomic-trilog-imaginary-closed-form","uses":["papers/quantum-observable-universe/blocks/prop-cyclotomic-trilog-imaginary-closed-form"],"tags":["extracted-table"],"text":"cyclotomic-trilog-imaginary-closed-form-table-data.md","provenance":"authored","html":"<p><a id=\"tbl:cyclotomic-trilog-imaginary-closed-form-table-data\"></a>\n<strong>Table.</strong> <em>Data table from prop:cyclotomic-trilog-imaginary-closed-form</em></p>\n<table>\n<thead>\n<tr>\n<th><code class=\"language-math math-inline\">n</code></th>\n<th><code class=\"language-math math-inline\">\\mathrm{Im}\\,\\mathrm{Li}_3(\\zeta_n) = \\dfrac{(n-1)(n-2)\\pi^3}{3 n^3}</code></th>\n<th><code class=\"language-math math-inline\">\\approx</code></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td><code class=\"language-math math-inline\">0</code></td>\n<td><code class=\"language-math math-inline\">0</code></td>\n</tr>\n<tr>\n<td>2</td>\n<td><code class=\"language-math math-inline\">0</code> (<code class=\"language-math math-inline\">\\zeta_2 = -1</code>, <code class=\"language-math math-inline\">\\mathrm{Li}_3(-1)</code> real)</td>\n<td><code class=\"language-math math-inline\">0</code></td>\n</tr>\n<tr>\n<td>3</td>\n<td><code class=\"language-math math-inline\">\\dfrac{2 \\pi^3}{81}</code></td>\n<td><code class=\"language-math math-inline\">0.76558\\ldots</code></td>\n</tr>\n<tr>\n<td>4</td>\n<td><code class=\"language-math math-inline\">\\dfrac{6 \\pi^3}{192} = \\dfrac{\\pi^3}{32}</code></td>\n<td><code class=\"language-math math-inline\">0.96894\\ldots</code></td>\n</tr>\n<tr>\n<td><strong>5</strong></td>\n<td><code class=\"language-math math-inline\">\\dfrac{12 \\pi^3}{375} = \\dfrac{4\\pi^3}{125}</code></td>\n<td><code class=\"language-math math-inline\">0.99220\\ldots</code></td>\n</tr>\n<tr>\n<td>6</td>\n<td><code class=\"language-math math-inline\">\\dfrac{20 \\pi^3}{648} = \\dfrac{5\\pi^3}{162}</code></td>\n<td><code class=\"language-math math-inline\">0.95672\\ldots</code></td>\n</tr>\n<tr>\n<td>7</td>\n<td><code class=\"language-math math-inline\">\\dfrac{30 \\pi^3}{1029} = \\dfrac{10\\pi^3}{343}</code></td>\n<td><code class=\"language-math math-inline\">0.90369\\ldots</code></td>\n</tr>\n<tr>\n<td>10</td>\n<td><code class=\"language-math math-inline\">\\dfrac{72 \\pi^3}{3000} = \\dfrac{3\\pi^3}{125}</code></td>\n<td><code class=\"language-math math-inline\">0.74415\\ldots</code></td>\n</tr>\n<tr>\n<td>12</td>\n<td><code class=\"language-math math-inline\">\\dfrac{110 \\pi^3}{5184} = \\dfrac{55\\pi^3}{2592}</code></td>\n<td><code class=\"language-math math-inline\">0.65779\\ldots</code></td>\n</tr>\n</tbody>\n</table>\n"}
