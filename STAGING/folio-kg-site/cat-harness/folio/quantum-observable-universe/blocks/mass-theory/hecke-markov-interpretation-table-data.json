{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/"}],"@id":"papers/quantum-observable-universe/blocks/tbl-hecke-markov-interpretation-table-data","@type":["folio-assistant-core:Table","doco:Table"],"label":"tbl:hecke-markov-interpretation-table-data","kind":"table","title":"Data table from rem:hecke-markov-interpretation","uses":["papers/quantum-observable-universe/blocks/rem-hecke-markov-interpretation"],"tags":["extracted-table"],"text":"hecke-markov-interpretation-table-data.md","provenance":"authored","html":"<a id=\"tbl:hecke-markov-interpretation-table-data\"></a><table>\n<thead>\n<tr>\n<th align=\"left\">Algebraic object</th>\n<th align=\"left\">Markov chain reading</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"left\">Hecke generator <code class=\"language-math math-inline\">\\sigma_i</code></td>\n<td align=\"left\">One-step transition operator at crossing <code class=\"language-math math-inline\">i</code></td>\n</tr>\n<tr>\n<td align=\"left\">Eigenvalues <code class=\"language-math math-inline\">q</code>, <code class=\"language-math math-inline\">-q^{-1}</code></td>\n<td align=\"left\">Boltzmann weights of symmetric / antisymmetric channels</td>\n</tr>\n<tr>\n<td align=\"left\">Idempotents <code class=\"language-math math-inline\">e_+^{(i)}</code>, <code class=\"language-math math-inline\">e_-^{(i)}</code></td>\n<td align=\"left\">Projectors onto the two outcomes</td>\n</tr>\n<tr>\n<td align=\"left\">Markov property <code class=\"language-math math-inline\">\\mathrm{tr}(x\\sigma_n) = z\\mathrm{tr}(x)</code></td>\n<td align=\"left\">Memorylessness: step <code class=\"language-math math-inline\">n</code> independent of history <code class=\"language-math math-inline\">x</code></td>\n</tr>\n<tr>\n<td align=\"left\">Vertex volume <code class=\"language-math math-inline\">\\hat{V}_i = z a_i + b_i</code></td>\n<td align=\"left\">One-step conditional expectation</td>\n</tr>\n<tr>\n<td align=\"left\">Product <code class=\"language-math math-inline\">\\prod_i \\hat{V}_i</code></td>\n<td align=\"left\">Product of independent random variables</td>\n</tr>\n<tr>\n<td align=\"left\">Jones polynomial <code class=\"language-math math-inline\">J_L(q)</code></td>\n<td align=\"left\">Partition function of the chain</td>\n</tr>\n<tr>\n<td align=\"left\">Log-partition function <code class=\"language-math math-inline\">\\log J_L = \\sum_i \\log\\lvert\\hat{V}_i\\rvert</code></td>\n<td align=\"left\">Free energy of the path</td>\n</tr>\n<tr>\n<td align=\"left\">Transfer matrix eigenvalues <code class=\"language-math math-inline\">q</code>, <code class=\"language-math math-inline\">-q^{-1}</code></td>\n<td align=\"left\">Boltzmann weights at each lattice site</td>\n</tr>\n<tr>\n<td align=\"left\">Markov trace weights <code class=\"language-math math-inline\">w_\\lambda</code></td>\n<td align=\"left\">Probability measure on irreducible representations</td>\n</tr>\n</tbody>\n</table>\n","source":"folio/quantum-observable-universe/mass-theory/hecke-markov-interpretation-table-data.md","heading":"Table"}
