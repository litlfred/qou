{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/"}],"@id":"papers/quantum-observable-universe/blocks/tbl-feynman-qou-dictionary-table-data","@type":["folio-assistant-core:Table","doco:Table"],"label":"tbl:feynman-qou-dictionary-table-data","kind":"table","title":"Data table from rem:feynman-qou-dictionary","uses":["papers/quantum-observable-universe/blocks/rem-feynman-qou-dictionary"],"tags":["extracted-table"],"text":"feynman-qou-dictionary-table-data.md","provenance":"authored","html":"<p><a id=\"tbl:feynman-qou-dictionary-table-data\"></a>\n<strong>Table.</strong> <em>Data table from rem:feynman-qou-dictionary</em></p>\n<table>\n<thead>\n<tr>\n<th align=\"left\">Feynman formalism</th>\n<th align=\"left\">QOU categorical trace</th>\n<th align=\"left\">Reference</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"left\">Configuration space of paths</td>\n<td align=\"left\">Braid group <code class=\"language-math math-inline\">B_n</code> acting on <code class=\"language-math math-inline\">V^{\\otimes n}</code></td>\n<td align=\"left\"><a href=\"#prop:braid-action-tensor\">braid action</a></td>\n</tr>\n<tr>\n<td align=\"left\">Path measure <code class=\"language-math math-inline\">\\mathcal{D}\\phi</code></td>\n<td align=\"left\">Markov trace <code class=\"language-math math-inline\">\\mathrm{tr}_M</code> on <code class=\"language-math math-inline\">H_n(R, q)</code></td>\n<td align=\"left\"><a href=\"#thm:jones-markov-trace\">Jones--Markov trace</a></td>\n</tr>\n<tr>\n<td align=\"left\">Action functional <code class=\"language-math math-inline\">S[\\phi]</code></td>\n<td align=\"left\"><code class=\"language-math math-inline\">q</code>-energy <code class=\"language-math math-inline\">\\mathfrak{E}_q(\\varrho) = \\mathrm{tr}_M(\\rho(\\beta))</code></td>\n<td align=\"left\"><a href=\"#def:q-energy\"><code class=\"language-math math-inline\">q</code>-energy</a></td>\n</tr>\n<tr>\n<td align=\"left\">Transition amplitude $\\langle\\psi_f</td>\n<td align=\"left\">\\psi_i\\rangle$</td>\n<td align=\"left\">Markov trace <code class=\"language-math math-inline\">\\mathrm{tr}_M(\\rho(\\beta))</code></td>\n</tr>\n<tr>\n<td align=\"left\">Amplitude phase <code class=\"language-math math-inline\">e^{iS[\\phi]/\\hbar}</code></td>\n<td align=\"left\"><code class=\"language-math math-inline\">R</code>-matrix eigenvalues <code class=\"language-math math-inline\">q</code>, <code class=\"language-math math-inline\">-q^{-1}</code> of <code class=\"language-math math-inline\">c_{V,V}</code></td>\n<td align=\"left\"><a href=\"#rem:r-matrix-braiding\"><code class=\"language-math math-inline\">R</code>-matrix braiding</a></td>\n</tr>\n<tr>\n<td align=\"left\">Propagator <code class=\"language-math math-inline\">K(x,y;t)</code></td>\n<td align=\"left\">Categorical transfer matrix <code class=\"language-math math-inline\">\\mathcal{T}(\\mathfrak{H})</code></td>\n<td align=\"left\"><a href=\"#def:categorical-transfer-matrix\">transfer matrix</a></td>\n</tr>\n<tr>\n<td align=\"left\">Hilbert space <code class=\"language-math math-inline\">\\mathcal{H}</code></td>\n<td align=\"left\">Algebraic direct limit <code class=\"language-math math-inline\">V_{\\mathrm{phys}} = \\varinjlim V^{\\otimes n}</code> (no metric completion)</td>\n<td align=\"left\"><a href=\"#prop:knot-eigenbasis-complete\">knot eigenbasis</a></td>\n</tr>\n<tr>\n<td align=\"left\">Basis states $</td>\n<td align=\"left\">n\\rangle$</td>\n<td align=\"left\">Irreducible summands <code class=\"language-math math-inline\">V_\\lambda \\otimes S_\\lambda</code></td>\n</tr>\n<tr>\n<td align=\"left\">Planck constant <code class=\"language-math math-inline\">\\hbar</code></td>\n<td align=\"left\">Quantum Planck constant <code class=\"language-math math-inline\">\\hbar_q = 1 - q^{-1}</code></td>\n<td align=\"left\"><a href=\"#def:q-energy\"><code class=\"language-math math-inline\">q</code>-energy</a></td>\n</tr>\n<tr>\n<td align=\"left\">Classical limit <code class=\"language-math math-inline\">\\hbar \\to 0</code></td>\n<td align=\"left\"><code class=\"language-math math-inline\">q \\to 1</code> limit</td>\n<td align=\"left\"><a href=\"#prop:feynman-classical-limit\">classical limit</a></td>\n</tr>\n<tr>\n<td align=\"left\">Partition function <code class=\"language-math math-inline\">Z</code></td>\n<td align=\"left\"><code class=\"language-math math-inline\">\\dim_q(V^{\\otimes n}) = \\sum_\\lambda \\dim_q(V_\\lambda)\\dim(S_\\lambda)</code></td>\n<td align=\"left\"><a href=\"#prop:knot-eigenbasis-complete\">knot eigenbasis</a></td>\n</tr>\n<tr>\n<td align=\"left\">Regularisation / renormalisation</td>\n<td align=\"left\">Absent (finite sum, no divergences)</td>\n<td align=\"left\">—</td>\n</tr>\n</tbody>\n</table>\n"}
