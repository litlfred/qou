{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/"}],"@id":"papers/quantum-observable-universe/blocks/tbl-crossing-graded-mass-expansion-table-data","@type":["folio-assistant-core:Table","doco:Table"],"label":"tbl:crossing-graded-mass-expansion-table-data","kind":"table","title":"Crossing-graded mass expansion: first three orders","uses":["papers/quantum-observable-universe/blocks/conj-crossing-graded-mass-expansion"],"tags":["crossing-graded","mass-expansion","groebner"],"text":"crossing-graded-mass-expansion-table-data.md","provenance":"authored","html":"<p><a id=\"tbl:crossing-graded-mass-expansion-table-data\"></a>\n<strong>Table.</strong> <em>Crossing-graded mass expansion: first three orders</em></p>\n<table>\n<thead>\n<tr>\n<th align=\"left\">Order</th>\n<th align=\"left\">Term</th>\n<th align=\"left\">Interpretation</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"left\"><code class=\"language-math math-inline\">n = 0</code></td>\n<td align=\"left\"><code class=\"language-math math-inline\">\\mathfrak{m}^{(0)}_{\\mathrm{GB}}</code></td>\n<td align=\"left\">standard Gröbner-Shirshov NF — all crossings skein-resolved</td>\n</tr>\n<tr>\n<td align=\"left\"><code class=\"language-math math-inline\">n = 1</code></td>\n<td align=\"left\"><code class=\"language-math math-inline\">c \\cdot \\xi \\cdot \\overline{\\mathfrak{m}^{(1)}}</code></td>\n<td align=\"left\">linear correction; one crossing lifts into 3D</td>\n</tr>\n<tr>\n<td align=\"left\"><code class=\"language-math math-inline\">n = 2</code></td>\n<td align=\"left\"><code class=\"language-math math-inline\">\\binom{c}{2} \\xi^2 \\cdot \\overline{\\mathfrak{m}^{(2)}}</code></td>\n<td align=\"left\">pair-correction, tetrahedron-pair interactions</td>\n</tr>\n<tr>\n<td align=\"left\"><code class=\"language-math math-inline\">\\vdots</code></td>\n<td align=\"left\"><code class=\"language-math math-inline\">\\vdots</code></td>\n<td align=\"left\"><code class=\"language-math math-inline\">\\vdots</code></td>\n</tr>\n<tr>\n<td align=\"left\"><code class=\"language-math math-inline\">n = c</code></td>\n<td align=\"left\"><code class=\"language-math math-inline\">\\xi^c \\cdot \\mathfrak{m}^{(c)}_{\\mathrm{GB}}</code></td>\n<td align=\"left\">full Thurston volume — all crossings lifted</td>\n</tr>\n</tbody>\n</table>\n"}
