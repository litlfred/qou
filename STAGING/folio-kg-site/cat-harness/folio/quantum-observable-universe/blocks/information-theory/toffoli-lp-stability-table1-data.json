{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/"}],"@id":"papers/quantum-observable-universe/blocks/tbl-toffoli-lp-stability-table1-data","@type":["folio-assistant-core:Table","doco:Table"],"label":"tbl:toffoli-lp-stability-table1-data","kind":"table","title":"Table 1 from prop:toffoli-lp-stability","uses":["papers/quantum-observable-universe/blocks/prop-toffoli-lp-stability"],"tags":["extracted-table"],"text":"toffoli-lp-stability-table1-data.md","provenance":"authored","html":"<p><a id=\"tbl:toffoli-lp-stability-table1-data\"></a>\n<strong>Table.</strong> <em>Table 1 from prop:toffoli-lp-stability</em></p>\n<table>\n<thead>\n<tr>\n<th align=\"center\"><code class=\"language-math math-inline\">q</code></th>\n<th align=\"left\">Operator</th>\n<th align=\"left\">Zero mechanism</th>\n<th align=\"left\">Status</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"center\"><code class=\"language-math math-inline\">q = 1</code></td>\n<td align=\"left\"><code class=\"language-math math-inline\">P_{7,6}</code>, <code class=\"language-math math-inline\">P_{6,7}</code> — factor <code class=\"language-math math-inline\">(q-1)</code></td>\n<td align=\"left\">Classical limit; both off-diagonal amplitudes vanish</td>\n<td align=\"left\">live (convention <code class=\"language-math math-inline\">D</code>)</td>\n</tr>\n<tr>\n<td align=\"center\">none on <code class=\"language-math math-inline\">(0,\\infty)</code></td>\n<td align=\"left\"><code class=\"language-math math-inline\">P_{6,6}</code>, <code class=\"language-math math-inline\">P_{7,7}</code></td>\n<td align=\"left\">Numerators <code class=\"language-math math-inline\">(q^4+1)(q^4+q^2+2)</code> and <code class=\"language-math math-inline\">q^3(q^4+1)</code> have no positive real root</td>\n<td align=\"left\">live (convention <code class=\"language-math math-inline\">D</code>)</td>\n</tr>\n<tr>\n<td align=\"center\">none on <code class=\"language-math math-inline\">(0,\\infty)</code></td>\n<td align=\"left\">sextic factors of <code class=\"language-math math-inline\">P_{7,6}</code>, <code class=\"language-math math-inline\">P_{6,7}</code></td>\n<td align=\"left\"><code class=\"language-math math-inline\">q^6+q^4+2q^2+1</code> and <code class=\"language-math math-inline\">2q^6+q^4+q^2+1</code> are positive for every real <code class=\"language-math math-inline\">q</code></td>\n<td align=\"left\">live (convention <code class=\"language-math math-inline\">D</code>)</td>\n</tr>\n<tr>\n<td align=\"center\"><code class=\"language-math math-inline\">q_\\star = 1/\\varphi^2 \\approx 0.382</code></td>\n<td align=\"left\"><code class=\"language-math math-inline\">(q + q^{1/2} - 1)/(q + 1)</code></td>\n<td align=\"left\">Golden-ratio zero of the <strong>convention-<code class=\"language-math math-inline\">C</code></strong> diagonal</td>\n<td align=\"left\">retired frame</td>\n</tr>\n<tr>\n<td align=\"center\"><code class=\"language-math math-inline\">q_\\Phi \\approx 0.466</code></td>\n<td align=\"left\"><code class=\"language-math math-inline\">\\Phi(q) = (q-1)(q^{3/2} + q^{1/2} - 1)(q^{3/2} + q + 1) / 2(q+1)^2</code></td>\n<td align=\"left\">Cubic root of <code class=\"language-math math-inline\">(q^{3/2} + q^{1/2} - 1)</code></td>\n<td align=\"left\">retired object — <code class=\"language-math math-inline\">\\Phi</code> is not in the image of the construction</td>\n</tr>\n</tbody>\n</table>\n"}
