{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/"}],"@id":"papers/quantum-observable-universe/blocks/tbl-bar-involution-table8-data","@type":["folio-assistant-core:Table","doco:Table"],"label":"tbl:bar-involution-table8-data","kind":"table","title":"Data table 8 from def:bar-involution","uses":["papers/quantum-observable-universe/blocks/def-bar-involution"],"tags":["extracted-table"],"text":"bar-involution-table8-data.md","provenance":"authored","html":"<a id=\"tbl:bar-involution-table8-data\"></a><table>\n<thead>\n<tr>\n<th>Notation</th>\n<th>Meaning</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code class=\"language-math math-inline\">\\overline{x}</code></td>\n<td>bar-involution of <code class=\"language-math math-inline\">x</code></td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">P_{\\mathrm{avg}}(x) = (x + \\overline x)/2</code></td>\n<td>bar-symmetric projection of <code class=\"language-math math-inline\">x</code></td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">P_{\\mathrm{skew}}(x) = (x - \\overline x)/2</code></td>\n<td>bar-anti-symmetric projection of <code class=\"language-math math-inline\">x</code></td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">\\sigma_{\\mathrm{avg}} = P_{\\mathrm{avg}}(\\sigma) = \\sigma - h/2</code></td>\n<td>averaged crossing operator</td>\n</tr>\n<tr>\n<td><code>IsBarSymmetric x</code></td>\n<td>Lean predicate <code class=\"language-math math-inline\">\\overline x = x</code></td>\n</tr>\n<tr>\n<td><code>IsBarAntiSymmetric x</code></td>\n<td>Lean predicate <code class=\"language-math math-inline\">\\overline x = -x</code></td>\n</tr>\n</tbody>\n</table>\n","source":"folio/quantum-observable-universe/stochastic-mechanics/bar-involution-table8-data.md","heading":"Table"}
