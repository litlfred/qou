{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/"}],"@id":"papers/quantum-observable-universe/blocks/tbl-polynomial-bar-involution-table-data","@type":["folio-assistant-core:Table","doco:Table"],"label":"tbl:polynomial-bar-involution-table-data","kind":"table","title":"Data table from prop:polynomial-bar-involution","uses":["papers/quantum-observable-universe/blocks/prop-polynomial-bar-involution"],"tags":["extracted-table"],"text":"polynomial-bar-involution-table-data.md","provenance":"authored","html":"<a id=\"tbl:polynomial-bar-involution-table-data\"></a><table>\n<thead>\n<tr>\n<th>Theorem</th>\n<th>Statement</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code>barPoly_X</code></td>\n<td><code class=\"language-math math-inline\">\\overline X = -X</code></td>\n</tr>\n<tr>\n<td><code>barPoly_neg_X</code></td>\n<td><code class=\"language-math math-inline\">\\overline{(-X)} = X</code></td>\n</tr>\n<tr>\n<td><code>barPoly_C c</code></td>\n<td><code class=\"language-math math-inline\">\\overline{c} = c</code> for <code class=\"language-math math-inline\">c \\in R</code></td>\n</tr>\n<tr>\n<td><code>barPoly_add</code></td>\n<td><code class=\"language-math math-inline\">\\overline{p+q} = \\overline p + \\overline q</code></td>\n</tr>\n<tr>\n<td><code>barPoly_mul</code></td>\n<td><code class=\"language-math math-inline\">\\overline{p\\cdot q} = \\overline p \\cdot \\overline q</code></td>\n</tr>\n<tr>\n<td><code>barPoly_one</code></td>\n<td><code class=\"language-math math-inline\">\\overline 1 = 1</code></td>\n</tr>\n<tr>\n<td><code>barPoly_zero</code></td>\n<td><code class=\"language-math math-inline\">\\overline 0 = 0</code></td>\n</tr>\n<tr>\n<td><code>barPoly_involutive</code></td>\n<td><code class=\"language-math math-inline\">\\overline{\\overline p} = p</code></td>\n</tr>\n<tr>\n<td><code>barPoly_X_pow_two</code></td>\n<td><code class=\"language-math math-inline\">\\overline{X^2} = X^2</code> (concrete bar-symmetry)</td>\n</tr>\n<tr>\n<td><code>barPoly_X_pow n</code></td>\n<td><code class=\"language-math math-inline\">\\overline{X^n} = (-1)^n \\cdot X^n</code></td>\n</tr>\n</tbody>\n</table>\n","source":"folio/quantum-observable-universe/stochastic-mechanics/polynomial-bar-involution-table-data.md","heading":"Table"}
