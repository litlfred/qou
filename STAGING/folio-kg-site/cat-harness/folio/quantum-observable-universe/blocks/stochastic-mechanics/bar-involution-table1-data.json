{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/"}],"@id":"papers/quantum-observable-universe/blocks/tbl-bar-involution-table1-data","@type":["folio-assistant-core:Table","doco:Table"],"label":"tbl:bar-involution-table1-data","kind":"table","title":"Data table 1 from def:bar-involution","uses":["papers/quantum-observable-universe/blocks/def-bar-involution"],"tags":["extracted-table"],"text":"bar-involution-table1-data.md","provenance":"authored","html":"<p><a id=\"tbl:bar-involution-table1-data\"></a>\n<strong>Table.</strong> <em>Data table 1 from def:bar-involution</em></p>\n<table>\n<thead>\n<tr>\n<th>Projection</th>\n<th>Formula</th>\n<th>Image</th>\n<th>Idempotent?</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code class=\"language-math math-inline\">P_{\\mathrm{avg}}</code></td>\n<td><code class=\"language-math math-inline\">\\frac{1}{2}(1 + \\overline{(\\cdot)})</code></td>\n<td><strong>bar-symmetric</strong> (<code class=\"language-math math-inline\">\\overline x = x</code>)</td>\n<td>yes (<code class=\"language-math math-inline\">P_{\\mathrm{avg}}^2 = P_{\\mathrm{avg}}</code>)</td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">P_{\\mathrm{skew}}</code></td>\n<td><code class=\"language-math math-inline\">\\frac{1}{2}(1 - \\overline{(\\cdot)})</code></td>\n<td><strong>bar-anti-symmetric</strong> (<code class=\"language-math math-inline\">\\overline x = -x</code>)</td>\n<td>yes (<code class=\"language-math math-inline\">P_{\\mathrm{skew}}^2 = P_{\\mathrm{skew}}</code>)</td>\n</tr>\n</tbody>\n</table>\n"}
