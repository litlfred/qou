{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/"}],"@id":"papers/quantum-observable-universe/blocks/tbl-notation-register-table8-data","@type":["folio-assistant-core:Table","doco:Table"],"label":"tbl:notation-register-table8-data","kind":"table","title":"Data table 8 from ","tags":["extracted-table"],"text":"notation-register-table8-data.md","provenance":"authored","html":"<p><a id=\"tbl:notation-register-table8-data\"></a>\n<strong>Table.</strong> *Data table 8 from *</p>\n<table>\n<thead>\n<tr>\n<th>Concept</th>\n<th>Font</th>\n<th>Symbols</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Derived constants</td>\n<td>plain italic</td>\n<td><code class=\"language-math math-inline\">c_q = 1/(q - 1)</code> (speed of light), <code class=\"language-math math-inline\">\\hbar_q = (q - 1)/q</code> (Planck), <code class=\"language-math math-inline\">d_H(q) = (2q - 1)^2/q^3</code> (Hausdorff dimension)</td>\n</tr>\n<tr>\n<td>Mass number</td>\n<td>Latin cap</td>\n<td><code class=\"language-math math-inline\">A = Z + N</code></td>\n</tr>\n<tr>\n<td>Neutron number</td>\n<td>Latin cap</td>\n<td><code class=\"language-math math-inline\">N</code></td>\n</tr>\n<tr>\n<td>Particles</td>\n<td>fraktur</td>\n<td><code class=\"language-math math-inline\">\\mathfrak{u}</code>, <code class=\"language-math math-inline\">\\mathfrak{d}</code>, <code class=\"language-math math-inline\">\\mathfrak{s}</code>, <code class=\"language-math math-inline\">\\mathfrak{c}</code>, <code class=\"language-math math-inline\">\\mathfrak{b}</code>, <code class=\"language-math math-inline\">\\mathfrak{t}</code> (quarks); <code class=\"language-math math-inline\">\\mathfrak{p}</code>, <code class=\"language-math math-inline\">\\mathfrak{n}</code> (proton, neutron); <code class=\"language-math math-inline\">\\mathfrak{H}</code>, <code class=\"language-math math-inline\">\\mathfrak{H}_p</code> (hadron, localised)</td>\n</tr>\n<tr>\n<td>Proton number</td>\n<td>Latin cap</td>\n<td><code class=\"language-math math-inline\">Z</code> — atomic number. Never use <code class=\"language-math math-inline\">p</code> for proton count; <code class=\"language-math math-inline\">p</code> is reserved for brane points.</td>\n</tr>\n</tbody>\n</table>\n"}
