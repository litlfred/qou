inline\">0.811</code></td>\n<td>—</td>\n<td><code class=\"language-math math-inline\">\\checkmark</code></td>\n</tr>\n<tr>\n<td>Protium</td>\n<td>1</td>\n<td><code class=\"language-math math-inline\">0.3104</code></td>\n<td><code class=\"language-math math-inline\">1.025</code></td>\n<td><code class=\"language-math math-inline\">0</code></td>\n<td><code class=\"language-math math-inline\">\\checkmark</code></td>\n</tr>\n<tr>\n<td>Deuterium</td>\n<td>2</td>\n<td><code class=\"language-math math-inline\">0.7645</code></td>\n<td><code class=\"language-math math-inline\">1.827</code></td>\n<td><code class=\"language-math math-inline\">2.84</code></td>\n<td><code class=\"language-math math-inline\">\\checkmark</code></td>\n</tr>\n<tr>\n<td>Tritium</td>\n<td>3</td>\n<td><code class=\"language-math math-inline\">1.0301</code></td>\n<td><code class=\"language-math math-inline\">2.979</code></td>\n<td><code class=\"language-math math-inline\">8.48</code></td>\n<td><code class=\"language-math math-inline\">\\checkmark</code></td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">{}^3</code>He</td>\n<td>3</td>\n<td><code class=\"language-math math-inline\">0.2081</code></td>\n<td><code class=\"language-math math-inline\">1.973</code></td>\n<td><code class=\"language-math math-inline\">7.72</code></td>\n<td><code class=\"language-math math-inline\">\\checkmark</code></td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">{}^4</code>He</td>\n<td>4</td>\n<td><code class=\"language-math math-inline\">2.7489</code></td>\n<td><code class=\"language-math math-inline\">4.150</code></td>\n<td><code class=\"language-math math-inline\">29.46</code></td>\n<td><code class=\"language-math math-inline\">\\checkmark</code></td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">{}^6</code>Li</td>\n<td>6</td>\n<td><code class=\"language-math math-inline\">3.022</code></td>\n<td><code class=\"language-math math-inline\">7.996</code></td>\n<td><code class=\"language-