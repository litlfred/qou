{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/"}],"@id":"papers/quantum-observable-universe/blocks/tbl-knot-formula-table-table1-data","@type":["folio-assistant-core:Table","doco:Table"],"label":"tbl:knot-formula-table-table1-data","kind":"table","title":"Data table 1 from rem:knot-formula-table","uses":["papers/quantum-observable-universe/blocks/rem-knot-formula-table"],"tags":["extracted-table"],"text":"knot-formula-table-table1-data.md","provenance":"authored","html":"<p><a id=\"tbl:knot-formula-table-table1-data\"></a>\n<strong>Table.</strong> <em>Data table 1 from rem:knot-formula-table</em></p>\n<table>\n<thead>\n<tr>\n<th>Symbol</th>\n<th>Meaning</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code class=\"language-math math-inline\">T_{m,n}</code></td>\n<td>Torus knot generator (winding numbers <code class=\"language-math math-inline\">m, n</code>)</td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">T(2,n)</code></td>\n<td>Torus link (<code class=\"language-math math-inline\">n</code> even) or knot (<code class=\"language-math math-inline\">n</code> odd)</td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">\\oplus</code></td>\n<td>Hopf linking on exceptional divisor <code class=\"language-math math-inline\">\\mathcal{S}_c</code></td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">[\\cdot,\\cdot,\\cdot]_p</code></td>\n<td>Color-tube linking through <code class=\"language-math math-inline\">(r,g,b)</code> fibers</td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">\\sigma</code></td>\n<td>Skein crossing change (transmutation)</td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">K^{\\sigma}</code></td>\n<td>Mirror (antiparticle) of knot <code class=\"language-math math-inline\">K</code></td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">N \\cdot K</code></td>\n<td><code class=\"language-math math-inline\">N</code> copies of knot <code class=\"language-math math-inline\">K</code> in a multi-component link</td>\n</tr>\n</tbody>\n</table>\n"}
