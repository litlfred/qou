{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/"}],"@id":"papers/quantum-observable-universe/blocks/tbl-groebner-nf-computation-table2-data","@type":["folio-assistant-core:Table","doco:Table"],"label":"tbl:groebner-nf-computation-table2-data","kind":"table","title":"Table 2 from rem:groebner-nf-computation","uses":["papers/quantum-observable-universe/blocks/rem-groebner-nf-computation"],"tags":["extracted-table"],"text":"groebner-nf-computation-table2-data.md","provenance":"authored","html":"<p><a id=\"tbl:groebner-nf-computation-table2-data\"></a>\n<strong>Table.</strong> <em>Table 2 from rem:groebner-nf-computation</em></p>\n<table>\n<thead>\n<tr>\n<th align=\"center\"><code class=\"language-math math-inline\">A</code></th>\n<th>Histogram polynomial <code class=\"language-math math-inline\">\\sum_\\ell h(\\ell)  r^\\ell</code></th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td align=\"center\"><code class=\"language-math math-inline\">2</code></td>\n<td><code class=\"language-math math-inline\">[2]_r = 1 + r</code></td>\n</tr>\n<tr>\n<td align=\"center\"><code class=\"language-math math-inline\">3</code></td>\n<td><code class=\"language-math math-inline\">[2]_r^2 = (1+r)^2</code></td>\n</tr>\n<tr>\n<td align=\"center\"><code class=\"language-math math-inline\">4</code></td>\n<td><code class=\"language-math math-inline\">[2]_r^2 \\cdot [3]_r = (1+r)^2(1+r+r^2)</code></td>\n</tr>\n<tr>\n<td align=\"center\"><code class=\"language-math math-inline\">5</code></td>\n<td><code class=\"language-math math-inline\">[2]_r^2 \\cdot [3]_r^2</code></td>\n</tr>\n<tr>\n<td align=\"center\"><code class=\"language-math math-inline\">6</code></td>\n<td><code class=\"language-math math-inline\">[2]_r^2 \\cdot [3]_r^2 \\cdot [5]_r</code></td>\n</tr>\n</tbody>\n</table>\n"}
