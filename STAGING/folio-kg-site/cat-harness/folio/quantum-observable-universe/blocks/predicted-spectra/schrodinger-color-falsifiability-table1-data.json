{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/"}],"@id":"papers/quantum-observable-universe/blocks/tbl-schrodinger-color-falsifiability-table1-data","@type":["folio-assistant-core:Table","doco:Table"],"label":"tbl:schrodinger-color-falsifiability-table1-data","kind":"table","title":"Table 1 from rem:schrodinger-color-falsifiability","uses":["papers/quantum-observable-universe/blocks/rem-schrodinger-color-falsifiability"],"tags":["extracted-table"],"text":"schrodinger-color-falsifiability-table1-data.md","provenance":"authored","html":"<p><a id=\"tbl:schrodinger-color-falsifiability-table1-data\"></a>\n<strong>Table.</strong> <em>Table 1 from rem:schrodinger-color-falsifiability</em></p>\n<table>\n<thead>\n<tr>\n<th>Regime</th>\n<th><code class=\"language-math math-inline\">\\Delta E_{\\mathrm{perc}}</code></th>\n<th>Comment</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code class=\"language-math math-inline\">\\eta d \\ll 1</code></td>\n<td><code class=\"language-math math-inline\">d - \\tfrac{\\eta^2}{6} d^3 + O(\\eta^4 d^5)</code></td>\n<td>Riemannian + cubic sub-additive correction</td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">\\eta d \\sim 1</code></td>\n<td><code class=\"language-math math-inline\">\\mathrm{arsinh}(\\eta d)/\\eta</code></td>\n<td>Crossover regime</td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">\\eta d \\gg 1</code></td>\n<td><code class=\"language-math math-inline\">\\log(2\\eta d)/\\eta + O(1/d^2)</code></td>\n<td><strong>Second-order Weber–Fechner</strong></td>\n</tr>\n</tbody>\n</table>\n"}
