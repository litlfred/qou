{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.BringsSurface","@type":"LeanModule","name":"QOU.BringsSurface","imports":["lean:module:Init","lean:module:QOU.Basic","lean:module:QOU.QuantumObservableUniverse","lean:module:QOU.Glossary","lean:module:Mathlib.Data.Real.Basic","lean:module:Mathlib.Data.Complex.Basic","lean:module:Mathlib.Data.Fin.Basic"],"declarations":81,"chunks":1},{"@id":"lean:QOU.BringsSurface.ViewportState.camera","@type":"LeanDeclaration","name":"QOU.BringsSurface.ViewportState.camera","kind":"def","line":362,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L362-L362","doc":"Spherical camera state. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.ViewportState.mode","@type":"LeanDeclaration","name":"QOU.BringsSurface.ViewportState.mode","kind":"def","line":360,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L360-L360","doc":"Render mode (CP¹ vs. cone). ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.ViewportState.q","@type":"LeanDeclaration","name":"QOU.BringsSurface.ViewportState.q","kind":"def","line":358,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L358-L358","doc":"Torsion / chirality parameter `q`.  `q = 0` is the classical\nlimit; `q > 0` introduces chiral twist. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.ViewportState.mk","@type":"LeanDeclaration","name":"QOU.BringsSurface.ViewportState.mk","kind":"ctor","line":355,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L355-L355","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.ViewportState","@type":"LeanDeclaration","name":"QOU.BringsSurface.ViewportState","kind":"structure","line":346,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L346-L362","doc":"**Bring's-surface visualiser viewport state.**\n\nSerialisable configuration consumed by the interactive 3D\nrenderer; reproducing a view from a URL or markdown embed\nrequires precisely these fields.\n\nLaTeX label: `def:viz-brings-surface` (chapter-dir sibling\n`folio/visualizer/overview/viz-brings-surface.lean`). ","formalizes":[{"@id":"block:def:viz-brings-surface","label":"def:viz-brings-surface","md":"visualizer/overview/viz-brings-surface.md"}],"signatureChunk":0},{"@id":"lean:QOU.BringsSurface.CameraState.lookAt","@type":"LeanDeclaration","name":"QOU.BringsSurface.CameraState.lookAt","kind":"def","line":344,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L344-L344","doc":"Look-at target in `(𝔯, 𝔤, 𝔟)` colour-sector coordinates. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.CameraState.radius","@type":"LeanDeclaration","name":"QOU.BringsSurface.CameraState.radius","kind":"def","line":342,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L342-L342","doc":"Radius from look-at target. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.CameraState.phi","@type":"LeanDeclaration","name":"QOU.BringsSurface.CameraState.phi","kind":"def","line":340,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L340-L340","doc":"Polar angle ϕ. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.CameraState.theta","@type":"LeanDeclaration","name":"QOU.BringsSurface.CameraState.theta","kind":"def","line":338,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L338-L338","doc":"Azimuthal angle θ. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.CameraState.mk","@type":"LeanDeclaration","name":"QOU.BringsSurface.CameraState.mk","kind":"ctor","line":336,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L336-L336","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.CameraState","@type":"LeanDeclaration","name":"QOU.BringsSurface.CameraState","kind":"structure","line":332,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L332-L344","doc":"Spherical camera state for the visualiser viewport.  The\nconvention is the standard `(θ, ϕ, r)` with `θ ∈ [0, 2π)`\nazimuth, `ϕ ∈ [0, π]` polar, `r ≥ 0` radius; the look-at target\nis an explicit `ℝ³` point in colour-sector coordinates. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.instReprViewportMode","@type":"LeanDeclaration","name":"QOU.BringsSurface.instReprViewportMode","kind":"instance","line":330,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L330-L330","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.instReprViewportMode.repr","@type":"LeanDeclaration","name":"QOU.BringsSurface.instReprViewportMode.repr","kind":"def","line":330,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L330-L330","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.instDecidableEqViewportMode","@type":"LeanDeclaration","name":"QOU.BringsSurface.instDecidableEqViewportMode","kind":"instance","line":330,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L330-L330","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.ViewportMode.cone","@type":"LeanDeclaration","name":"QOU.BringsSurface.ViewportMode.cone","kind":"ctor","line":329,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L329-L329","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.ViewportMode.cp1","@type":"LeanDeclaration","name":"QOU.BringsSurface.ViewportMode.cp1","kind":"ctor","line":328,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L328-L328","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.ViewportMode","@type":"LeanDeclaration","name":"QOU.BringsSurface.ViewportMode","kind":"inductive","line":321,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L321-L330","doc":"Render mode for the Bring's-surface visualiser.\n\n* `cp1`  — show the `ℂP¹` exceptional fibre of the chiral elliptic\n  curve at the cone-point.\n* `cone` — show the outgoing chiral tube cones in colour-sector\n  coordinates `(𝔯, 𝔤, 𝔟)`. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.yekutieli_lifting","@type":"LeanDeclaration","name":"QOU.BringsSurface.yekutieli_lifting","kind":"theorem","line":302,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L302-L317","doc":"**Yekutieli lifting**: the brane tower over Bring's surface satisfies\nthe nonabelian multiplicative integration lifting condition of\nYekutieli (2015).\n\nProof: The obstruction to lifting lies in `H²(Σ₄, centre(SU_q(2)))`.\nSince `centre(SU_q(2)) = {±1} ≅ ℤ/2` and `H²(Σ₄, ℤ/2) = 0`\n(the genus-4 surface with S₅ symmetry has vanishing second cohomology\nwith ℤ/2 coefficients), the lifting obstruction vanishes at every level.\n\nLaTeX: `\\label{prop:brings-is-qou}` (item 3) ","formalizes":[{"@id":"block:prop:yekutieli-lifting","label":"prop:yekutieli-lifting","md":"quantum-observable-universe/lifting-and-descent/yekutieli-lifting.md"}],"signatureChunk":0},{"@id":"lean:QOU.BringsSurface.YekutieliLiftingData.obstruction_vanishes","@type":"LeanDeclaration","name":"QOU.BringsSurface.YekutieliLiftingData.obstruction_vanishes","kind":"theorem","line":300,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L300-L300","doc":"The obstruction class in `H²(M, centre(G))` vanishes because\n`centre(SU_q(2)) = {±1}` and `H²(Σ₄, ℤ/2) = 0` by homological\ncomputation (genus 4 surface with S₅ symmetry). ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.YekutieliLiftingData.num_patches","@type":"LeanDeclaration","name":"QOU.BringsSurface.YekutieliLiftingData.num_patches","kind":"def","line":296,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L296-L296","doc":"The number of good-cover patches needed (genus 4 ⟹ ≤ 9 patches). ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.YekutieliLiftingData.level","@type":"LeanDeclaration","name":"QOU.BringsSurface.YekutieliLiftingData.level","kind":"def","line":294,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L294-L294","doc":"The brane tower level `n`. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.YekutieliLiftingData.mk","@type":"LeanDeclaration","name":"QOU.BringsSurface.YekutieliLiftingData.mk","kind":"ctor","line":292,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L292-L292","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.YekutieliLiftingData","@type":"LeanDeclaration","name":"QOU.BringsSurface.YekutieliLiftingData","kind":"structure","line":290,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L290-L300","doc":"**Yekutieli lifting data** for the brane tower.\nPackages the Čech-cocycle condition and the lifting obstruction class. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.observability","@type":"LeanDeclaration","name":"QOU.BringsSurface.observability","kind":"theorem","line":275,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L275-L288","doc":"**Observability**: `Hom(𝟙, Ad(A)) = 0` by the quantum Schur lemma.\nThe adjoint representation `Ad(A)` of `O_q(SU(2))` has no trivial\nsub-objects, so every observable is detected by `C = Rep(SU_q(2))`.\n\nProof: For `SU_q(2)` at generic `q`, `Ad(A) ≅ V_2` (the spin-1 irreducible\nof dimension 3).  By the quantum Schur lemma, `Hom(𝟙, V_j) = 0` for\n`j ≥ 1`, so `Hom(𝟙, Ad(A)) = 0`.  Equivalently, `dim(Ad) = 3 ≠ 1`.\n\nLaTeX: `\\label{prop:brings-is-qou}` (item 2) ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.instNonemptySchurObservability","@type":"LeanDeclaration","name":"QOU.BringsSurface.instNonemptySchurObservability","kind":"instance","line":271,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L271-L273","doc":"Default observability: `dim(Ad) = 3 ≠ 1`. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.SchurObservability.trivial_multiplicity_zero","@type":"LeanDeclaration","name":"QOU.BringsSurface.SchurObservability.trivial_multiplicity_zero","kind":"theorem","line":269,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L269-L269","doc":"The trivial multiplicity in the decomposition of `Ad(A)` is zero:\n`[Ad(A) : 𝟙] = 0`.  This is the quantum Schur lemma for `SU_q(2)`. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.SchurObservability.adj_irrep_dim","@type":"LeanDeclaration","name":"QOU.BringsSurface.SchurObservability.adj_irrep_dim","kind":"def","line":266,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L266-L266","doc":"The number of irreducible summands of `Ad(A)` as a `Rep(SU_q(2))`\nmodule.  For `SU_q(2)` at generic `q`, `Ad(A) ≅ V_2` (the 3-dimensional\nirreducible), which has no trivial summand. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.SchurObservability.mk","@type":"LeanDeclaration","name":"QOU.BringsSurface.SchurObservability.mk","kind":"ctor","line":262,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L262-L262","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.SchurObservability","@type":"LeanDeclaration","name":"QOU.BringsSurface.SchurObservability","kind":"structure","line":259,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L259-L269","doc":"**Observability data** for the quantum Schur lemma argument.\nPackages the hypothesis that the adjoint representation of `O_q(SU(2))`\nat generic `q` has no trivial sub-objects. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.is_qou","@type":"LeanDeclaration","name":"QOU.BringsSurface.is_qou","kind":"theorem","line":254,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L254-L257","doc":"The Riemann–Hurwitz relation holds for the Bring's QOU data:\n`χ(S) = deg · χ(CP¹) − (total ramification)`. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.BringsQOU.total_ramification","@type":"LeanDeclaration","name":"QOU.BringsSurface.BringsQOU.total_ramification","kind":"theorem","line":251,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L251-L251","doc":"Total ramification of the covering equals 14. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.BringsQOU.branch_points_eq","@type":"LeanDeclaration","name":"QOU.BringsSurface.BringsQOU.branch_points_eq","kind":"theorem","line":249,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L249-L249","doc":"Number of branch points of the covering `S → CP¹`. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.BringsQOU.aut_order_eq","@type":"LeanDeclaration","name":"QOU.BringsSurface.BringsQOU.aut_order_eq","kind":"theorem","line":247,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L247-L247","doc":"Automorphism group order equals 120 (= S₅). ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.BringsQOU.eulerChar_eq","@type":"LeanDeclaration","name":"QOU.BringsSurface.BringsQOU.eulerChar_eq","kind":"theorem","line":245,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L245-L245","doc":"Euler characteristic equals −6. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.BringsQOU.genus_eq","@type":"LeanDeclaration","name":"QOU.BringsSurface.BringsQOU.genus_eq","kind":"theorem","line":243,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L243-L243","doc":"Genus equals 4. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.BringsQOU.surface","@type":"LeanDeclaration","name":"QOU.BringsSurface.BringsQOU.surface","kind":"def","line":241,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L241-L241","doc":"The underlying Bring's surface. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.BringsQOU.mk","@type":"LeanDeclaration","name":"QOU.BringsSurface.BringsQOU.mk","kind":"ctor","line":239,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L239-L239","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.BringsQOU","@type":"LeanDeclaration","name":"QOU.BringsSurface.BringsQOU","kind":"structure","line":227,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L227-L252","doc":"**Bring's QOU**: packaging Bring's surface data into a quantum\nobservable universe.  The five items of the proof:\n\n1. **Quantum universe data**: `C = Rep(SU_q(2))`, `A = O_q(SU(2))`\n   with Haar state as Frobenius form.\n2. **Observability**: `Hom(1, Ad(A)) = 0` by the quantum Schur lemma.\n3. **Yekutieli lifting**: brane tower satisfies the lifting condition.\n4. **Euler characteristic**: `χ(A) = tr(id_A) = 2 − 2g = −6`.\n5. **Geometric descent**: `M_S → Σ₄ → P(V) → {6 points}`.\n\nLaTeX: `\\label{prop:brings-is-qou}` ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.mi_sw_abelianisation","@type":"LeanDeclaration","name":"QOU.BringsSurface.mi_sw_abelianisation","kind":"theorem","line":216,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L216-L223","formalizes":[{"@id":"block:prop:mi-sw-abelianisation","label":"prop:mi-sw-abelianisation","md":"quantum-observable-universe/brings-surface/mi-sw-abelianisation.md"}],"signatureChunk":0},{"@id":"lean:QOU.BringsSurface.MISWAbelianisation.abelianises","@type":"LeanDeclaration","name":"QOU.BringsSurface.MISWAbelianisation.abelianises","kind":"theorem","line":214,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L214-L214","doc":"Fake-flatness `F_A = B` forces the 2-form datum into the Cartan\nsubalgebra on the exceptional divisor, so the nonabelian MI integral reduces\nto the classical contour integral of `λ_SW^(n)`. **No instance is provided**;\nsee the note above. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.MISWAbelianisation.mk","@type":"LeanDeclaration","name":"QOU.BringsSurface.MISWAbelianisation.mk","kind":"ctor","line":209,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L209-L209","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.MISWAbelianisation","@type":"LeanDeclaration","name":"QOU.BringsSurface.MISWAbelianisation","kind":"class","line":174,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L174-L214","doc":"**Abelianisation of the MI integral on exceptional divisors.**\nOn each exceptional divisor `E_c ≅ CP¹`, the SU(2) bundle trivialises\n(since `π₁(SU(2)) = 0`), so the nonabelian MI integral of the\nconnection–curvature pair abelianises.  The Cartan component of the\nrestricted connection equals the Seiberg–Witten differential `lam_SW = X dz`,\nand the MI integral at jet level `n` equals the `n`-th prolonged SW period.\n\n`‖MI∫_{E_c} (∇_A q, L ∧ F⁺)‖_{Jⁿ} = |a_D^(n)| = |∮_{E_c} lam_SW^(n)|`\n\nProof outline:\n(1) SU(2) bundle over S² is trivial → connection abelianises to U(1)\n(2) Fake-flatness F_A = B forces 2-form datum into Cartan subalgebra on E_c\n(3) MI integral reduces to classical contour integral of lam_SW^(n)\n\n**RESTATED 2026-08-08 (bean `qou-kyst`) — was vacuous.** The previous form\ntook `fake_flat_abelian : ∀ k, mi_integral k = sw_period k` as a hypothesis\nand returned `fake_flat_abelian n`: the hypothesis WAS the conclusion, so\nsteps (1)-(3) were assumed, not derived, and a reader could discharge it by\nsupplying the very statement it claimed to prove.\n\nIt is now carried the way this corpus carries its other open content-bearing\nclaims (§3b-tax, as for `QDifferenceKernelIsProlongationSymbol`): a **class\nwith no instance**. `MISWAbelianisation` names the abelianisation as a\ntypeclass field; `mi_sw_abelianisation` derives the conclusion from it. The\nopen state is now visible in the *type* rather than hidden in a hypothesis\nthat happens to be the goal, and it can no longer be discharged by\nrestatement — an instance must exhibit the abelianisation.\n\nMathlib cannot support a real instance: (1) needs principal bundles and\nclassifying spaces over `S²`, (2) nonabelian gauge theory and Lie-algebra\nvalued 2-forms, (3) Yekutieli's nonabelian multiplicative integration. None\nexists. So the honest state is \"no instance\", and that is what this is.\n\nLaTeX: `\\label{prop:mi-sw-abelianisation}` ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.riemann_hurwitz_check","@type":"LeanDeclaration","name":"QOU.BringsSurface.riemann_hurwitz_check","kind":"theorem","line":164,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L164-L170","doc":"Branch points, covering degree, genus, and Euler characteristic\nare related by Riemann–Hurwitz:\n`χ(S) = deg · χ(CP¹) − (number of ramification points)`.\nHere: `−6 = 4 · 2 − 14`, using total ramification 14. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.covering_degree","@type":"LeanDeclaration","name":"QOU.BringsSurface.covering_degree","kind":"def","line":161,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L161-L162","doc":"The covering degree of the projection `S → CP¹` is 4. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.num_branch_points","@type":"LeanDeclaration","name":"QOU.BringsSurface.num_branch_points","kind":"def","line":155,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L155-L159","doc":"The number of branch points of Bring's surface as a covering of CP¹\nequals 6, matching the Euler characteristic magnitude |χ| = 6.\n\nLaTeX: `\\label{rem:brings-qou-4tuple}` ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.QuaternionicResolvents.omega","@type":"LeanDeclaration","name":"QOU.BringsSurface.QuaternionicResolvents.omega","kind":"def","line":151,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L151-L151","doc":"The three quaternionic resolvent components. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.QuaternionicResolvents.mk","@type":"LeanDeclaration","name":"QOU.BringsSurface.QuaternionicResolvents.mk","kind":"ctor","line":149,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L149-L149","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.QuaternionicResolvents","@type":"LeanDeclaration","name":"QOU.BringsSurface.QuaternionicResolvents","kind":"structure","line":143,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L143-L151","doc":"**Quaternionic spectral resolvents**: the spectral data rewritten\nin a quaternionic basis `(ω₁, ω₂, ω₃)` on which `Sp(1) ≅ SU(2)`\nacts naturally.\n\nLaTeX: `\\label{def:quaternionic-spectral-resolvents}` ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.BriggsKleinChart.coords","@type":"LeanDeclaration","name":"QOU.BringsSurface.BriggsKleinChart.coords","kind":"def","line":139,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L139-L139","doc":"The affine coordinates (4 of the 5 homogeneous coordinates). ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.BriggsKleinChart.mk","@type":"LeanDeclaration","name":"QOU.BringsSurface.BriggsKleinChart.mk","kind":"ctor","line":137,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L137-L137","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.BriggsKleinChart","@type":"LeanDeclaration","name":"QOU.BringsSurface.BriggsKleinChart","kind":"structure","line":133,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L133-L139","doc":"**Briggs–Klein affine chart**: an affine coordinate system on\nBring's surface obtained by setting one coordinate to 1.\n\nLaTeX: `\\label{def:briggs-klein-chart}` ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.ChiralEllipticCurve.j_invariant","@type":"LeanDeclaration","name":"QOU.BringsSurface.ChiralEllipticCurve.j_invariant","kind":"def","line":129,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L129-L129","doc":"The j-invariant of the elliptic curve. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.ChiralEllipticCurve.genus","@type":"LeanDeclaration","name":"QOU.BringsSurface.ChiralEllipticCurve.genus","kind":"def","line":127,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L127-L127","doc":"The elliptic curve has genus 1. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.ChiralEllipticCurve.carrier","@type":"LeanDeclaration","name":"QOU.BringsSurface.ChiralEllipticCurve.carrier","kind":"def","line":125,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L125-L125","doc":"The chiral fibre carrier. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.ChiralEllipticCurve.mk","@type":"LeanDeclaration","name":"QOU.BringsSurface.ChiralEllipticCurve.mk","kind":"ctor","line":123,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L123-L123","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.ChiralEllipticCurve","@type":"LeanDeclaration","name":"QOU.BringsSurface.ChiralEllipticCurve","kind":"structure","line":118,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L118-L129","doc":"**Proposition**: the chiral fibre of Bring's surface is an elliptic\ncurve (genus 1).\n\nLaTeX: `\\label{prop:chiral-elliptic}` ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.observedValue","@type":"LeanDeclaration","name":"QOU.BringsSurface.observedValue","kind":"def","line":110,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L110-L114","doc":"**Observed spacetime value**: the projection from the full Bring's\nsurface data to the spacetime base CP¹.\n\nLaTeX: `\\label{def:observed-value}` ","formalizes":[{"@id":"block:rem:glossary-observed-value","label":"rem:glossary-observed-value","md":"quantum-observable-universe/glossary/glossary-observed-value.md"}],"signatureChunk":0},{"@id":"lean:QOU.BringsSurface.ColorTubeFiber.roots","@type":"LeanDeclaration","name":"QOU.BringsSurface.ColorTubeFiber.roots","kind":"def","line":108,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L108-L108","doc":"The three chiral roots at this point. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.ColorTubeFiber.base","@type":"LeanDeclaration","name":"QOU.BringsSurface.ColorTubeFiber.base","kind":"def","line":106,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L106-L106","doc":"The spacetime base point. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.ColorTubeFiber.mk","@type":"LeanDeclaration","name":"QOU.BringsSurface.ColorTubeFiber.mk","kind":"ctor","line":104,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L104-L104","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.ColorTubeFiber","@type":"LeanDeclaration","name":"QOU.BringsSurface.ColorTubeFiber","kind":"structure","line":100,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L100-L108","doc":"**Color tube fibers**: the chiral fiber at a given spacetime point,\nconsisting of the three roots of the chiral cubic constraint.\n\nLaTeX: `\\label{def:color-tube-fibers}` ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.ColorTubeCoordinates.chiral","@type":"LeanDeclaration","name":"QOU.BringsSurface.ColorTubeCoordinates.chiral","kind":"def","line":98,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L98-L98","doc":"Chiral coordinates `(x₂, x₃, x₄)`. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.ColorTubeCoordinates.z","@type":"LeanDeclaration","name":"QOU.BringsSurface.ColorTubeCoordinates.z","kind":"def","line":96,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L96-L96","doc":"Spacetime coordinate `z = x₀/x₁`. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.ColorTubeCoordinates.mk","@type":"LeanDeclaration","name":"QOU.BringsSurface.ColorTubeCoordinates.mk","kind":"ctor","line":94,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L94-L94","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.ColorTubeCoordinates","@type":"LeanDeclaration","name":"QOU.BringsSurface.ColorTubeCoordinates","kind":"structure","line":87,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L87-L98","doc":"**Color tube coordinates**: the decomposition of Bring's surface\ncoordinates into spacetime `(x₀, x₁)` and chiral `(x₂, x₃, x₄)`\ndegrees of freedom.\n\nThe projective ratio `z = x₀/x₁ ∈ CP¹` parametrises the spacetime base.\n\nLaTeX: `\\label{def:color-tube-coordinates}` ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.LagrangeResolvents.symmetric_cubic","@type":"LeanDeclaration","name":"QOU.BringsSurface.LagrangeResolvents.symmetric_cubic","kind":"theorem","line":82,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L82-L82","doc":"Symmetric cubic: `w₁²w₃ + w₄²w₂ + w₂²w₁ + w₃²w₄ = 0`. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.LagrangeResolvents.hermitian_quadric","@type":"LeanDeclaration","name":"QOU.BringsSurface.LagrangeResolvents.hermitian_quadric","kind":"theorem","line":80,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L80-L80","doc":"Hermitian quadric: `w₁w₄ + w₂w₃ = 0`. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.LagrangeResolvents.w0_zero","@type":"LeanDeclaration","name":"QOU.BringsSurface.LagrangeResolvents.w0_zero","kind":"theorem","line":78,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L78-L78","doc":"`w₀ = 0` (linear projection constraint). ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.LagrangeResolvents.w","@type":"LeanDeclaration","name":"QOU.BringsSurface.LagrangeResolvents.w","kind":"def","line":76,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L76-L76","doc":"The resolvent coordinates `w₀, …, w₄`. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.LagrangeResolvents.mk","@type":"LeanDeclaration","name":"QOU.BringsSurface.LagrangeResolvents.mk","kind":"ctor","line":74,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L74-L74","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.LagrangeResolvents","@type":"LeanDeclaration","name":"QOU.BringsSurface.LagrangeResolvents","kind":"structure","line":67,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L67-L83","doc":"**Lagrange resolvent**: the discrete Fourier transform of the\ncoordinates `xⱼ` with respect to `ζ = e^{2πi/5}`.\n\n`wₖ = (1/√5) Σⱼ ζ^{kj} xⱼ`, for `k ∈ {0, 1, 2, 3, 4}`.\n\nLaTeX: `\\label{rem:lagrange-resolvents}` ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.automorphism_order","@type":"LeanDeclaration","name":"QOU.BringsSurface.automorphism_order","kind":"def","line":62,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L62-L63","doc":"The automorphism group of Bring's surface has order 120 (= S₅). ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.euler_genus_relation","@type":"LeanDeclaration","name":"QOU.BringsSurface.euler_genus_relation","kind":"theorem","line":58,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L58-L60","doc":"The Euler characteristic and genus are related by `χ = 2 − 2g`. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.eulerChar","@type":"LeanDeclaration","name":"QOU.BringsSurface.eulerChar","kind":"def","line":55,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L55-L56","doc":"The Euler characteristic of Bring's surface is −6. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.genus","@type":"LeanDeclaration","name":"QOU.BringsSurface.genus","kind":"def","line":52,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L52-L53","doc":"The genus of Bring's surface is 4. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.BringsSurface.power_sum_3","@type":"LeanDeclaration","name":"QOU.BringsSurface.BringsSurface.power_sum_3","kind":"theorem","line":50,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L50-L50","doc":"Third power sum vanishes: `Σ xⱼ³ = 0`. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.BringsSurface.power_sum_2","@type":"LeanDeclaration","name":"QOU.BringsSurface.BringsSurface.power_sum_2","kind":"theorem","line":48,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L48-L48","doc":"Second power sum vanishes: `Σ xⱼ² = 0`. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.BringsSurface.power_sum_1","@type":"LeanDeclaration","name":"QOU.BringsSurface.BringsSurface.power_sum_1","kind":"theorem","line":46,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L46-L46","doc":"First power sum vanishes: `Σ xⱼ = 0`. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.BringsSurface.coords","@type":"LeanDeclaration","name":"QOU.BringsSurface.BringsSurface.coords","kind":"def","line":44,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L44-L44","doc":"Homogeneous coordinates `x₀, …, x₄` as a function on the surface. ","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.BringsSurface.mk","@type":"LeanDeclaration","name":"QOU.BringsSurface.BringsSurface.mk","kind":"ctor","line":42,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L42-L42","signatureChunk":0},{"@id":"lean:QOU.BringsSurface.BringsSurface","@type":"LeanDeclaration","name":"QOU.BringsSurface.BringsSurface","kind":"structure","line":36,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/BringsSurface.lean#L36-L50","doc":"**Bring's surface**: the maximally symmetric Riemann surface of genus 4\nand Euler characteristic χ = −6, defined in CP⁴ by the vanishing of\nthe first three power sums: `Σ xⱼᵏ = 0` for `k = 1, 2, 3`.\n\nLaTeX: `\\label{def:brings-surface}` ","signatureChunk":0}]}