{"@context":{"lean":"lean:","block":"block:","imports":{"@type":"@id"}},"@graph":[{"@id":"lean:module:QOU.SchurWeyl.HeckeTowerStrict","@type":"LeanModule","name":"QOU.SchurWeyl.HeckeTowerStrict","imports":["lean:module:Init","lean:module:QOU.SchurWeyl.HeckeWedderburnGeneral","lean:module:QOU.SchurWeyl.HeckeInclusion"],"declarations":1,"chunks":1},{"@id":"lean:QOU.SchurWeyl.heckeIncl_range_lt_top","@type":"LeanDeclaration","name":"QOU.SchurWeyl.heckeIncl_range_lt_top","kind":"theorem","line":73,"sourceLink":"https://github.com/litlfred/qou/blob/5697c3130d79ead793a58c1a0a984a2e49b1365f/folio/quantum-observable-universe/lean/QOU/SchurWeyl/HeckeTowerStrict.lean#L73-L90","doc":"**The tower inclusion is never onto**, so the Hecke filtration grows strictly. Needs only the\ndimension count `(m+1)! < (m+2)!` — *not* injectivity; see the module docstring. ","signatureChunk":0}]}