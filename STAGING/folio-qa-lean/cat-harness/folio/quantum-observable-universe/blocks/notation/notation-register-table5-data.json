{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/"}],"@id":"papers/quantum-observable-universe/blocks/tbl-notation-register-table5-data","@type":["folio-assistant-core:Table","doco:Table"],"label":"tbl:notation-register-table5-data","kind":"table","title":"Data table 5 from ","tags":["extracted-table"],"text":"notation-register-table5-data.md","provenance":"authored","html":"<a id=\"tbl:notation-register-table5-data\"></a><table>\n<thead>\n<tr>\n<th>Concept</th>\n<th>Font</th>\n<th>Symbols</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Entropy (operational)</td>\n<td>Greek</td>\n<td><code class=\"language-math math-inline\">\\eta_q = (2q - 1)/q^3</code></td>\n</tr>\n<tr>\n<td>Information bandwidth</td>\n<td>fraktur</td>\n<td><code class=\"language-math math-inline\">\\mathfrak{B}(q)</code> — information bandwidth per Planck time, a scalar function of <code class=\"language-math math-inline\">q</code>; not a sheaf, hence relocated from <code class=\"language-math math-inline\">\\mathcal{B}(q)</code> to fraktur.</td>\n</tr>\n<tr>\n<td>Lyapunov exponent</td>\n<td>Greek</td>\n<td><code class=\"language-math math-inline\">\\chi_q = 1/(2q - 1)</code>. Distinct from <code class=\"language-math math-inline\">\\chi_\\zeta(c)</code> (character).</td>\n</tr>\n</tbody>\n</table>\n","source":"folio/quantum-observable-universe/notation/notation-register-table5-data.md","heading":"Table"}
