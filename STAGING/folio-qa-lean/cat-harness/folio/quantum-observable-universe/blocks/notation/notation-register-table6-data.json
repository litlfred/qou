{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/"}],"@id":"papers/quantum-observable-universe/blocks/tbl-notation-register-table6-data","@type":["folio-assistant-core:Table","doco:Table"],"label":"tbl:notation-register-table6-data","kind":"table","title":"Data table 6 from ","tags":["extracted-table"],"text":"notation-register-table6-data.md","provenance":"authored","html":"<a id=\"tbl:notation-register-table6-data\"></a><table>\n<thead>\n<tr>\n<th>Concept</th>\n<th>Font</th>\n<th>Symbols</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Elliptic curve</td>\n<td>calligraphic</td>\n<td><code class=\"language-math math-inline\">\\mathcal{E}_q</code> — Descartes elliptic curve. Never <code class=\"language-math math-inline\">E_q</code> for a curve.</td>\n</tr>\n<tr>\n<td>Gravitational constant</td>\n<td>Latin cap</td>\n<td><code class=\"language-math math-inline\">G_q</code> — gravitational constant; <code class=\"language-math math-inline\">G_{\\mathrm{Planck}} = 1</code> (exact).</td>\n</tr>\n<tr>\n<td>Julia-set measure</td>\n<td>Greek</td>\n<td><code class=\"language-math math-inline\">\\mu_J</code> — measure on Julia set</td>\n</tr>\n<tr>\n<td>Weierstrass</td>\n<td>script</td>\n<td><code class=\"language-math math-inline\">\\wp(z)</code> — Weierstrass elliptic function on <code class=\"language-math math-inline\">\\mathcal{E}_q</code>. Reserved.</td>\n</tr>\n</tbody>\n</table>\n","source":"folio/quantum-observable-universe/notation/notation-register-table6-data.md","heading":"Table"}
