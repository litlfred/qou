{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/"}],"@id":"papers/quantum-observable-universe/blocks/tbl-alpha-em-categorical-trace-ratio-table-data","@type":["folio-assistant-core:Table","doco:Table"],"label":"tbl:alpha-em-categorical-trace-ratio-table-data","kind":"table","title":"Numerical verification of $\\alpha_{EM} = h^{2} / [q \\cdot \\delta_q(T_{2,9}) \\cdot \\delta_q(T_{3,5})]$ at $q_0 \\approx 1.1099786$","uses":["papers/quantum-observable-universe/blocks/prop-alpha-em-categorical-trace-ratio"],"tags":["alpha-em","categorical-trace-ratio","numerical-verification","torus-knot"],"text":"alpha-em-categorical-trace-ratio-table-data.md","provenance":"authored","html":"<a id=\"tbl:alpha-em-categorical-trace-ratio-table-data\"></a><table>\n<thead>\n<tr>\n<th>Quantity</th>\n<th align=\"right\">Value</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code class=\"language-math math-inline\">h = q_0 - q_0^{-1}</code></td>\n<td align=\"right\"><code class=\"language-math math-inline\">0.20906032</code></td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">\\delta_q(T_{2,9}) = q_0^{9} - q_0^{-9}</code></td>\n<td align=\"right\"><code class=\"language-math math-inline\">2.16660039</code></td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">\\delta_q(T_{3,5}) = q_0^{10} - q_0^{-10}</code></td>\n<td align=\"right\"><code class=\"language-math math-inline\">2.48662110</code></td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">h^{2} / [q \\cdot \\delta_q(T_{2,9}) \\cdot \\delta_q(T_{3,5})]</code></td>\n<td align=\"right\"><code class=\"language-math math-inline\">7.30870098 \\times 10^{-3}</code></td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">\\alpha_{EM}</code> (definition)</td>\n<td align=\"right\"><code class=\"language-math math-inline\">7.30870098 \\times 10^{-3}</code></td>\n</tr>\n<tr>\n<td>Match</td>\n<td align=\"right\">exact (within <code class=\"language-math math-inline\">10^{-12}</code>)</td>\n</tr>\n</tbody>\n</table>\n","source":"folio/quantum-observable-universe/predicted-spectra/alpha-em-categorical-trace-ratio-table-data.md","heading":"Table"}
