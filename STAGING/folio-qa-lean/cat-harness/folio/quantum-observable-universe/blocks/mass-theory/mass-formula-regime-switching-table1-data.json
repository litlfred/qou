{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/"}],"@id":"papers/quantum-observable-universe/blocks/tbl-mass-formula-regime-switching-table1-data","@type":["folio-assistant-core:Table","doco:Table"],"label":"tbl:mass-formula-regime-switching-table1-data","kind":"table","title":"Table 1 from prop:mass-formula-regime-switching","uses":["papers/quantum-observable-universe/blocks/prop-mass-formula-regime-switching"],"tags":["extracted-table"],"text":"mass-formula-regime-switching-table1-data.md","provenance":"authored","html":"<a id=\"tbl:mass-formula-regime-switching-table1-data\"></a><table>\n<thead>\n<tr>\n<th>coefficient</th>\n<th><code class=\"language-math math-inline\">q</code>-integer form</th>\n<th>crossing interpretation</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><code class=\"language-math math-inline\">\\lambda_V</code> (volume)</td>\n<td><code class=\"language-math math-inline\">2[2]_q[7]_q \\cdot m_e</code></td>\n<td><code class=\"language-math math-inline\">[7]_q</code> = 7 crossings on gen 0 per proton</td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">\\lambda_S</code> (surface)</td>\n<td><code class=\"language-math math-inline\">2[4]_q^2 \\cdot m_e</code></td>\n<td><code class=\"language-math math-inline\">[4]_q</code> = 4 crossings on gen 1 per proton</td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">\\lambda_C</code> (Coulomb)</td>\n<td><code class=\"language-math math-inline\">h[6]_q \\cdot m_e</code></td>\n<td><code class=\"language-math math-inline\">[6]_q</code> = 6 crossings in Borromean link <code class=\"language-math math-inline\">B_3</code></td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">a_{\\mathrm{asym}}</code></td>\n<td><code class=\"language-math math-inline\">3[2]_q[7]_q \\cdot m_e</code></td>\n<td>same as <code class=\"language-math math-inline\">\\lambda_V</code> with prefactor <code class=\"language-math math-inline\">3</code></td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">\\delta_P</code> (pairing)</td>\n<td><code class=\"language-math math-inline\">[3]_q[7]_q \\cdot m_e</code></td>\n<td><code class=\"language-math math-inline\">[3]_q</code> = 3-strand nucleon structure</td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">\\lambda_{\\mathrm{ex}}</code></td>\n<td><code class=\"language-math math-inline\">[3]_q/[2]_q \\cdot m_e</code></td>\n<td>nucleon screening ratio</td>\n</tr>\n<tr>\n<td><code class=\"language-math math-inline\">\\delta_S</code> (shell)</td>\n<td><code class=\"language-math math-inline\">[2]_q^2[3]_q \\cdot m_e</code></td>\n<td>torus-knot coherence</td>\n</tr>\n</tbody>\n</table>\n","source":"folio/quantum-observable-universe/mass-theory/mass-formula-regime-switching-table1-data.md","heading":"Table"}
