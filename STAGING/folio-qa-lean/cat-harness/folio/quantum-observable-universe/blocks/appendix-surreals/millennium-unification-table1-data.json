{"@context":["https://litlfred.github.io/folio-assistant/ns/content/v1.jsonld",{"@base":"https://litlfred.github.io/folio/"}],"@id":"papers/quantum-observable-universe/blocks/tbl-millennium-unification-table1-data","@type":["folio-assistant-core:Table","doco:Table"],"label":"tbl:millennium-unification-table1-data","kind":"table","title":"Table 1 from rem:millennium-unification","uses":["papers/quantum-observable-universe/blocks/rem-millennium-unification"],"tags":["extracted-table"],"text":"millennium-unification-table1-data.md","provenance":"authored","html":"<a id=\"tbl:millennium-unification-table1-data\"></a><table>\n<thead>\n<tr>\n<th>Problem</th>\n<th>Drift <code class=\"language-math math-inline\">\\delta</code></th>\n<th>Cost <code class=\"language-math math-inline\">\\delta^2 \\cdot \\Omega_q</code></th>\n<th>Budget <code class=\"language-math math-inline\">\\Delta_q</code></th>\n<th><code class=\"language-math math-inline\">\\ordw</code>-verdict</th>\n<th>Conclusion</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><a href=\"#rem:rh-surreal-bound\">RH</a></td>\n<td><code class=\"language-math math-inline\">\\mathrm{Re}(\\rho) - 1/2</code></td>\n<td><code class=\"language-math math-inline\">\\asymp \\delta^2 \\varepsilon^{-1}</code></td>\n<td><code class=\"language-math math-inline\">\\asymp \\varepsilon^3</code></td>\n<td><code class=\"language-math math-inline\">\\ordw(\\text{cost}) = 1 > -3 = \\ordw(\\text{budget})</code></td>\n<td><code class=\"language-math math-inline\">\\delta = 0</code> (zeros on critical line)</td>\n</tr>\n<tr>\n<td><a href=\"#rem:ns-surreal-bound\">Navier--Stokes</a></td>\n<td>enstrophy spike</td>\n<td><code class=\"language-math math-inline\">\\asymp \\varepsilon^{-4/3}</code></td>\n<td><code class=\"language-math math-inline\">\\asymp \\varepsilon^3</code></td>\n<td><code class=\"language-math math-inline\">\\ordw(\\text{cost}) = 4/3 > -3</code></td>\n<td>finite-time blow-up in classical limit</td>\n</tr>\n<tr>\n<td><a href=\"#rem:collatz-surreal-bound\">Collatz</a></td>\n<td>contact-volume drift per step</td>\n<td><code class=\"language-math math-inline\">\\asymp \\delta^2 \\varepsilon^{-1}</code></td>\n<td><code class=\"language-math math-inline\">\\asymp \\varepsilon^3</code></td>\n<td><code class=\"language-math math-inline\">\\ordw(\\text{cost}) = 1 > -3</code></td>\n<td><code class=\"language-math math-inline\">\\delta = 0</code> (all orbits terminate at <code class=\"language-math math-inline\">1</code>)</td>\n</tr>\n<tr>\n<td><a href=\"#rem:p-vs-np-surreal-bound\">P vs NP</a></td>\n<td>per-step <code class=\"language-math math-inline\">q</code>-efficiency <code class=\"language-math math-inline\">\\delta_n</code></td>\n<td><code class=\"language-math math-inline\">\\asymp 2^n \\delta_n^2 \\varepsilon^{-1}</code></td>\n<td><code class=\"language-math math-inline\">\\asymp 2^n \\varepsilon^3</code></td>\n<td><code class=\"language-math math-inline\">\\ordw(\\text{cost}) = 1 > -3</code></td>\n<td><code class=\"language-math math-inline\">\\mathbf{P} \\neq \\mathbf{NP}</code> under std-part of <code class=\"language-math math-inline\">\\mathrm{BQP}_q \\supsetneq \\mathbf{P}</code></td>\n</tr>\n<tr>\n<td><a href=\"#rem:bsd-surreal-bound\">BSD</a></td>\n<td>rank-defect beyond <code class=\"language-math math-inline\">r</code></td>\n<td><code class=\"language-math math-inline\">\\asymp \\delta^2 \\varepsilon^{-1}</code></td>\n<td><code class=\"language-math math-inline\">\\asymp \\varepsilon^3</code></td>\n<td><code class=\"language-math math-inline\">\\ordw(\\text{cost}) = 1 > -3</code></td>\n<td><code class=\"language-math math-inline\">\\mathrm{ord}_{s=1} L(\\mathcal{E}_q) = r</code> (rank matches)</td>\n</tr>\n<tr>\n<td><a href=\"#rem:yang-mills-surreal-bound\">Yang--Mills</a></td>\n<td>massless glueball <code class=\"language-math math-inline\">\\delta = 0</code></td>\n<td>degenerate</td>\n<td><code class=\"language-math math-inline\">\\asymp \\varepsilon^3 > 0</code></td>\n<td><code class=\"language-math math-inline\">\\ordw(\\Delta_q) = -3 > -\\infty</code> (strictly finite)</td>\n<td>mass gap exists: <code class=\"language-math math-inline\">\\Delta_{\\mathrm{YM}} > 0</code></td>\n</tr>\n</tbody>\n</table>\n","source":"folio/quantum-observable-universe/appendix-surreals/millennium-unification-table1-data.md","heading":"Table"}
