{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "python",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "separate-pull-requests": true,
  "changelog-sections": [
    {"type": "feat",     "section": "Features"},
    {"type": "fix",      "section": "Bug Fixes"},
    {"type": "perf",     "section": "Performance"},
    {"type": "deps",     "section": "Dependencies"},
    {"type": "revert",   "section": "Reverts"},
    {"type": "docs",     "section": "Documentation"},
    {"type": "refactor", "section": "Refactors"},
    {"type": "test",     "section": "Tests"},
    {"type": "build",    "section": "Build System"},
    {"type": "ci",       "section": "CI / Workflows"},
    {"type": "chore",    "hidden": true}
  ],
  "packages": {
    "tools/pyhecke": {
      "release-type": "python",
      "package-name": "pyhecke",
      "component": "pyhecke",
      "extra-files": [
        {
          "type": "toml",
          "path": "pyproject.toml",
          "jsonpath": "$.project.version"
        }
      ]
    },
    "tools/qou-substrate": {
      "release-type": "python",
      "package-name": "qou-substrate",
      "component": "qou-substrate",
      "extra-files": [
        {
          "type": "toml",
          "path": "pyproject.toml",
          "jsonpath": "$.project.version"
        }
      ]
    },
    "tools/witness-schema": {
      "release-type": "python",
      "package-name": "witness-schema",
      "component": "witness-schema",
      "extra-files": [
        {
          "type": "toml",
          "path": "pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "tools/pyhecke-native": {
      "release-type": "python",
      "package-name": "pyhecke-native",
      "component": "pyhecke-native",
      "extra-files": [
        {
          "type": "toml",
          "path": "pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.package.version"
        }
      ]
    },
    "tools/hecke-engine": {
      "release-type": "rust",
      "package-name": "hecke-engine",
      "component": "hecke-engine"
    },
    "tools/hecke-engine-wasm": {
      "release-type": "rust",
      "package-name": "hecke-engine-wasm",
      "component": "hecke-engine-wasm",
      "extra-files": [
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "tools/hecke-engine-node": {
      "release-type": "rust",
      "package-name": "hecke-engine-node",
      "component": "hecke-engine-node",
      "extra-files": [
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
