{
  "name": "qou",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "cd content && bun run --preload ../scripts/preload-registry.ts ../../FolioAssistant/content/pipeline/validate.ts quantum-observable-universe/",
    "build:content": "cd content && bun run --preload ../scripts/preload-registry.ts ../../FolioAssistant/content/pipeline/build.ts quantum-observable-universe/quantum-observable-universe.ts --out-dir ../chapters/",
    "build:docs": "typedoc",
    "export-json": "cd content && bun run --preload ../scripts/preload-registry.ts ../../FolioAssistant/content/pipeline/export-json.ts",
    "generate-readme": "./scripts/generate-readme.sh",
    "test:e2e": "cd ../FolioAssistant && bun run test:e2e",
    "test": "cd ../FolioAssistant && bun run test",
    "lint": "cd ../FolioAssistant && bun run lint"
  },
  "devDependencies": {
    "typedoc": "^0.28.17",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@unified-latex/unified-latex-util-parse": "^1.8.3",
    "glob": "^11.0.0",
    "mdast-util-directive": "^3.1.0",
    "mdast-util-gfm-strikethrough": "^2.0.0",
    "mdast-util-gfm-table": "^2.0.0",
    "micromark-extension-directive": "^4.0.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "remark": "^15.0.1",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "zod": "^4.3.6"
  }
