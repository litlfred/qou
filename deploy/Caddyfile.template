# Caddy reverse proxy for Lean MCP server.
# Auto-generates TLS certificates via Let's Encrypt.
#
# Generated by generate-config.sh from lean-mcp.config.json.
# Do not edit directly — edit lean-mcp.config.json and regenerate.

${LEAN_MCP_DOMAIN} {
    # Browser/OAuth flow → oauth2-proxy → lean-mcp
    route /oauth2/* {
        reverse_proxy oauth2-proxy:4180
    }

    # MCP endpoint: check for bearer token first (API/CLI access),
    # fall through to oauth2-proxy for browser access
    route /mcp {
        @has_token header Authorization Bearer*
        reverse_proxy @has_token lean-mcp:${LEAN_MCP_INTERNAL_PORT}

        # No token → OAuth flow
        reverse_proxy oauth2-proxy:4180
    }

    # Health check (no auth)
    route /health {
        reverse_proxy lean-mcp:${LEAN_MCP_INTERNAL_PORT}
    }

    # Everything else → oauth2-proxy
    route /* {
        reverse_proxy oauth2-proxy:4180
    }
}
