# Lean MCP Server — Remote Deployment Environment Variables
#
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.

# ── Lean MCP Server ──────────────────────────────────────────────
# Bearer token for direct API/CLI access (bypassing OAuth).
# Generate with: openssl rand -hex 32
LEAN_LSP_MCP_TOKEN=changeme-generate-with-openssl-rand-hex-32

# ── Google OAuth (for browser-based access) ──────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
# OAuth 2.0 Client ID → Web application
# Authorized redirect URI: https://your-domain/oauth2/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Cookie encryption secret (must be 16, 24, or 32 bytes, base64-encoded)
# Generate with: openssl rand -base64 32 | head -c 32
COOKIE_SECRET=changeme-generate-with-openssl

# ── Proxy ────────────────────────────────────────────────────────
# Port for oauth2-proxy (external-facing)
PROXY_PORT=4180

# ── Auto-update ──────────────────────────────────────────────────
# Token for Watchtower HTTP API (optional, for manual trigger)
WATCHTOWER_TOKEN=changeme
