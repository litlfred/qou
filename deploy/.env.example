# QOU Deployment — Environment Variables
#
# DO NOT edit this file manually. Instead:
#   1. Edit lean-mcp.config.json at the repo root
#   2. Run ./deploy/generate-config.sh [--folio] to regenerate .env
#
# NEVER commit .env to git.

# ── Deployment mode ──────────────────────────────────────────────
# "mcp" = MCP-only (lean.litlfred.org)
# "folio" = viewer + MCP (folio.litlfred.org)
DEPLOY_MODE=folio
COMPOSE_FILE=docker-compose.folio.yml

# ── Domain & Image (from lean-mcp.config.json) ───────────────────
LEAN_MCP_DOMAIN=folio.litlfred.org
FOLIO_DOMAIN=folio.litlfred.org
LEAN_MCP_IMAGE=ghcr.io/litlfred/qou/lean-mcp
LEAN_MCP_INTERNAL_PORT=8080

# ── Lean MCP Server ──────────────────────────────────────────────
# Bearer token for direct API/CLI access (bypassing OAuth).
LEAN_LSP_MCP_TOKEN=<auto-generated>

# ── Google OAuth (the ONLY manual secrets) ───────────────────────
# One-time setup — see GOOGLE_OAUTH_SETUP.md for step-by-step.
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://folio.litlfred.org/oauth2/callback
OAUTH2_PROXY_PROVIDER=google
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-client-secret>
COOKIE_SECRET=<auto-generated>
