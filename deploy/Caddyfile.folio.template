# Caddy config for the QOU Folio deployment.
# Serves the viewer UI + MCP API behind Google OAuth.
# Auto-generates TLS certificates via Let's Encrypt.
#
# Generated by generate-config.sh --folio from lean-mcp.config.json.
# Do not edit directly — edit lean-mcp.config.json and regenerate.

${FOLIO_DOMAIN} {
    # OAuth endpoints → oauth2-proxy
    route /oauth2/* {
        reverse_proxy oauth2-proxy:4180
    }

    # MCP endpoint: bearer token → direct, otherwise → OAuth
    route /mcp {
        @has_token header Authorization Bearer*
        reverse_proxy @has_token lean-mcp:${LEAN_MCP_INTERNAL_PORT}

        # No token → OAuth flow
        reverse_proxy oauth2-proxy:4180
    }

    # Health check (no auth)
    route /health {
        reverse_proxy lean-mcp:${LEAN_MCP_INTERNAL_PORT}
    }

    # Static viewer files (served by oauth2-proxy for auth gating)
    route /* {
        reverse_proxy oauth2-proxy:4180
    }
}
